+#[cfg(feature = "threading")]
+#[test]
+fn cached_large_shared_hits_do_not_retain_a_reader_group() {
+    for has_hashes in [false, true] {
+        let cache = preloader();
+        cache.cached_test_insert(group(has_hashes, 1));
+        let mut r = reader(cache, has_hashes);
+        let data_size = if has_hashes { SECTOR_DATA_SIZE } else { SECTOR_SIZE };
+        let start = 65 * data_size - 1;
+        let mut output = vec![0xFD; LARGE_CACHED_LIMIT];
+        assert!(r.try_read_cached_at(start as u64, &mut output));
+        expect_bytes(&output, start);
+        assert_eq!(r.pos, (start + output.len()) as u64);
+        assert!(r.sector_group.is_none());
+        let mut next = [0; 17];
+        r.read_exact(&mut next).unwrap();
+        expect_bytes(&next, start + output.len());
+    }
+}
