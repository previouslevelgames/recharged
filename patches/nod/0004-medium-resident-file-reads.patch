+#[test]
+fn cached_large_preflight_rejects_late_invalid_sectors_transactionally() {
+    for has_hashes in [false, true] {
+        let data_size = if has_hashes { SECTOR_DATA_SIZE } else { SECTOR_SIZE };
+        let start = data_size - 3;
+        let last = (start + LARGE_CACHED_LIMIT - 1) / data_size;
+        assert!(last >= 8); // Failure must occur after multiple valid sectors.
+        let intact = group(has_hashes, 0);
+        let mut r = reader(preloader(), has_hashes);
+        let mut output = vec![0xFD; LARGE_CACHED_LIMIT + 1];
+        for defect in 0..4 {
+            r.sector_group = Some(intact.clone());
+            r.partition = partition(has_hashes);
+            let begin = match defect {
+                0 => {
+                    r.sector_group.as_mut().unwrap().sector_bitmap &= !(1u64 << last);
+                    start
+                }
+                1 => {
+                    let g = r.sector_group.as_mut().unwrap();
+                    g.data = g.data.slice(..(last + 1) * SECTOR_SIZE - 1);
+                    start
+                }
+                2 => {
+                    r.partition.data_end_sector = r.partition.data_start_sector + last as u32;
+                    start
+                }
+                _ => 64 * data_size - LARGE_CACHED_LIMIT + 1,
+            };
+            assert!(!r.try_read_cached_at(begin as u64, &mut output[..LARGE_CACHED_LIMIT]),
+                "layout {has_hashes}, defect {defect}");
+            assert_eq!(r.pos, 73);
+            assert!(output.iter().all(|b| *b == 0xFD));
+        }
+    }
+}
