+#[test]
+fn cached_c_api_large_exact_hit_miss_and_diagnostics() {
+    const CAP:usize=256*1024;
+    let mut f=Fixture::with_length(true,CAP+73);
+    let mut out=vec![0xFD;CAP+1];
+    for length in [65537,CAP] {
+        set_last_error("large probe preserves diagnostic");
+        let error=unsafe{nod_error_message()};
+        let cached_before=f.cached.load(Ordering::Relaxed);
+        let ordinary_before=f.ordinary.load(Ordering::Relaxed);
+        out.fill(0xFD);
+        assert_eq!(unsafe{nod_try_read_cached_at(f.handle,19,out.as_mut_ptr(),length)},length as i64);
+        assert_eq!(f.position(),(37+19+length) as u64);
+        assert_eq!(unsafe{nod_error_message()},error);
+        assert_eq!(f.cached.load(Ordering::Relaxed),cached_before+1);
+        assert_eq!(f.ordinary.load(Ordering::Relaxed),ordinary_before);
+        for i in 0..length {assert_eq!(out[i],expected(37+19+i));}
+        assert!(out[length..].iter().all(|b|*b==0xFD));
+        // Do not seek first: it could repair a wrong partition position.
+        let mut next=[0;17];
+        assert_eq!(unsafe{nod_read(f.handle,next.as_mut_ptr(),next.len())},next.len() as i64);
+        for i in 0..next.len() {assert_eq!(next[i],expected(37+19+length+i));}
+    }
+    let before=f.position();
+    let cached_before=f.cached.load(Ordering::Relaxed);
+    set_last_error("oversized large EOF preserves diagnostic");
+    let error=unsafe{nod_error_message()};
+    out.fill(0xFD);
+    // A cap+1 request must not delegate even when the file window clips to5.
+    assert_eq!(unsafe{nod_try_read_cached_at(f.handle,(CAP+68) as u64,out.as_mut_ptr(),out.len())},-2);
+    assert_eq!(f.position(),before);
+    assert_eq!(f.cached.load(Ordering::Relaxed),cached_before);
+    assert_eq!(unsafe{nod_error_message()},error);
+    assert!(out.iter().all(|b|*b==0xFD));
+}
