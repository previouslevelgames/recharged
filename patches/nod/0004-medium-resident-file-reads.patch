+#[test]
+fn cached_c_api_large_eof_copies_body_without_tail_or_ordinary_io() {
+    const CAP:usize=256*1024;
+    let mut f=Fixture::with_length(true,CAP+73);
+    let mut out=vec![0xFD;CAP+1];
+    assert_eq!(unsafe{nod_try_read_cached_at(f.handle,96,out.as_mut_ptr(),CAP)},(CAP-23) as i64);
+    for i in 0..CAP-23 {assert_eq!(out[i],expected(37+96+i));}
+    assert!(out[CAP-23..].iter().all(|b|*b==0xFD));
+    assert_eq!(f.cached.load(Ordering::Relaxed),1);
+    assert_eq!(f.ordinary.load(Ordering::Relaxed),0);
+    assert_eq!(f.position(),(37+CAP+73) as u64);
+    let mut tail=[0xFC;17];
+    assert_eq!(unsafe{nod_read(f.handle,tail.as_mut_ptr(),tail.len())},0);
+    assert_eq!(tail,[0xFC;17]);
+}
