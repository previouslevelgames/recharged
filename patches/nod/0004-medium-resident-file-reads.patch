+#[test]
+fn cached_large_file_eof_tail_and_oversize_before_clipping() {
+    for has_hashes in [false, true] {
+        let mut r = reader(preloader(), has_hashes);
+        r.sector_group = Some(group(has_hashes, 0));
+        let data_size = if has_hashes { SECTOR_DATA_SIZE } else { SECTOR_SIZE };
+        let start = (data_size - 9) as u64;
+        let length = LARGE_CACHED_LIMIT - 11;
+        let mut file = OwnedFileReader::new(Box::new(r), start, length as u64).unwrap();
+        let mut output = vec![0xFD; LARGE_CACHED_LIMIT + 1];
+        // EOF could clip this to 17 bytes, but the requested cap must be checked
+        // first. Both file and partition cursors remain at the initial position.
+        assert_eq!(file.try_read_cached_at((length - 17) as u64, &mut output), None);
+        assert_eq!(file.stream_position().unwrap(), start);
+        assert!(output.iter().all(|b| *b == 0xFD));
+        let mut first = [0; 19];
+        file.read_exact(&mut first).unwrap();
+        expect_bytes(&first, start as usize);
+        // A legal maximum request produces a genuinely >64 KiB short read.
+        assert_eq!(file.try_read_cached_at(1, &mut output[..LARGE_CACHED_LIMIT]), Some(length - 1));
+        expect_bytes(&output[..length - 1], start as usize + 1);
+        assert!(output[length - 1..].iter().all(|b| *b == 0xFD));
+        assert_eq!(file.stream_position().unwrap(), start + length as u64);
+        file.seek(SeekFrom::Current(-23)).unwrap();
+        let mut tail = [0; 23];
+        file.read_exact(&mut tail).unwrap();
+        expect_bytes(&tail, start as usize + length - tail.len());
+    }
+}
+
+#[test]
+fn cached_large_limit_misses_preserve_output_and_real_cursor() {
+    for has_hashes in [false, true] {
+        let mut r = reader(preloader(), has_hashes);
+        r.sector_group = Some(group(has_hashes, 0));
+        let mut output = vec![0xFD; LARGE_CACHED_LIMIT + 1];
+        assert!(!r.try_read_cached_at(123, &mut output));
+        assert!(!r.try_read_cached_at(u64::MAX - 7, &mut output[..LARGE_CACHED_LIMIT]));
+        r.options.validate_hashes = true;
+        assert!(!r.try_read_cached_at(123, &mut output[..LARGE_CACHED_LIMIT]));
+        r.options.validate_hashes = false;
+        assert_eq!(r.pos, 73);
+        assert!(output.iter().all(|b| *b == 0xFD));
+        let mut next = [0; 17];
+        r.read_exact(&mut next).unwrap();
+        expect_bytes(&next, 73);
+    }
+}
