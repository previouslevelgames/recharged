+#[test]
+fn cached_large_hit_miss_and_contended_probe_allocate_no_host_memory() {
+    let cache = preloader();
+    cache.cached_test_insert(group(true, 0));
+    let mut shared = reader(cache.clone(), true);
+    let mut local = reader(preloader(), true);
+    local.sector_group = Some(group(true, 0));
+    let mut output = vec![0; LARGE_CACHED_LIMIT];
+    let before = ALLOCATIONS.with(|v| v.get());
+    WATCH_ALLOC.with(|v| v.set(true));
+    let shared_hit = shared.try_read_cached_at(51, &mut output);
+    let local_hit = local.try_read_cached_at(51, &mut output);
+    let group_miss = shared.try_read_cached_at((64 * SECTOR_DATA_SIZE) as u64, &mut output);
+    let mut contended_hit = true;
+    cache.cached_test_lock(|| contended_hit = shared.try_read_cached_at(51, &mut output));
+    WATCH_ALLOC.with(|v| v.set(false));
+    assert_eq!(shared_hit, cfg!(feature = "threading"));
+    assert!(local_hit && !group_miss && !contended_hit);
+    assert_eq!(ALLOCATIONS.with(|v| v.get()), before);
+    expect_bytes(&output, 51);
+}
