+// Keep a literal oracle and the original small-read cases. These tests require
+// real copies above the former limit, not a large request clipped to a tiny EOF.
+const LARGE_CACHED_LIMIT: usize = 256 * 1024;
+
+#[test]
+fn cached_large_local_hits_preserve_both_sector_layouts_and_following_reads() {
+    for has_hashes in [false, true] {
+        let data_size = if has_hashes { SECTOR_DATA_SIZE } else { SECTOR_SIZE };
+        let mut r = reader(preloader(), has_hashes);
+        r.sector_group = Some(group(has_hashes, 1));
+        let start = 64 * data_size + data_size - 7;
+        for size in [65536, 65537, 65568, 131104, 174784, 262143, LARGE_CACHED_LIMIT] {
+            let mut output = vec![0xFD; size];
+            assert!(r.try_read_cached_at(start as u64, &mut output), "size {size}");
+            expect_bytes(&output, start);
+            assert_eq!(r.pos, (start + size) as u64);
+            let mut next = [0; 19];
+            r.read_exact(&mut next).unwrap();
+            expect_bytes(&next, start + size);
+        }
+        // The inclusive last sector is valid when the range ends at group end.
+        let end = 128 * data_size;
+        let mut output = vec![0xFD; LARGE_CACHED_LIMIT];
+        assert!(r.try_read_cached_at((end - output.len()) as u64, &mut output));
+        expect_bytes(&output, end - output.len());
+        assert_eq!(r.pos, end as u64);
+    }
+}
