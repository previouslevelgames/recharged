+
+// The final reader must release every cloned stream before its owner's host
+// I/O services can shut down. Dropping JoinHandles would detach these workers.
+#[cfg(feature = "threading")]
+impl Drop for Preloader {
+    fn drop(&mut self) {
+        // Disconnect first: idle workers are waiting in recv(), and queued work
+        // must finish before joining. Never hold a cache lock across the joins.
+        drop(self.request_tx.take());
+        let threads = self.threads.get_mut().unwrap_or_else(|error| error.into_inner());
+        for handle in threads.join_handles.drain(..) {
+            // A panicked worker has already unwound its stream. Cleanup must not
+            // panic again, including when the thread metadata lock is poisoned.
+            let _ = handle.join();
         }
     }
 }
