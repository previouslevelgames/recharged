+#[test]
+fn cached_misses_preflight_all_bytes_and_keep_position() {
+    let cache=preloader(); let mut r=reader(cache,true);
+    let mut output=vec![0xFD;65537]; let before=r.pos;
+    assert!(!r.try_read_cached_at(1,&mut output[..32]));
+    r.sector_group=Some(group(true,0));
+    assert!(!r.try_read_cached_at(1,&mut output));
+    assert!(!r.try_read_cached_at(u64::MAX-7,&mut output[..32]));
+    assert!(!r.try_read_cached_at((64*SECTOR_DATA_SIZE-7) as u64,&mut output[..32]));
+    assert!(!r.try_read_cached_at(0,&mut output[..0]));
+    r.options.validate_hashes=true;
+    assert!(!r.try_read_cached_at(0,&mut output[..32])); r.options.validate_hashes=false;
+    // Missing SECOND sector must not expose even the valid first seven bytes.
+    r.sector_group.as_mut().unwrap().sector_bitmap &= !(1<<1);
+    assert!(!r.try_read_cached_at((SECTOR_DATA_SIZE-7) as u64,&mut output[..32]));
+    // A present bitmap cannot authorize bytes beyond the immutable group buffer.
+    let g=r.sector_group.as_mut().unwrap(); g.sector_bitmap=u64::MAX;
+    g.data=g.data.slice(..SECTOR_SIZE+1);
+    assert!(!r.try_read_cached_at((SECTOR_DATA_SIZE-7) as u64,&mut output[..32]));
+    assert_eq!(r.pos,before); assert!(output.iter().all(|b|*b==0xFD));
