+// Separate preflight/copy makes cache misses transactional across sector edges.
+fn copy_cached_wii_group(
+    group: &SectorGroup, request: SectorGroupRequest, offset: u64, out: &mut [u8], has_hashes: bool,
+) -> bool {
+    let data_size = if has_hashes { SECTOR_DATA_SIZE } else { SECTOR_SIZE };
+    if group.request != request || out.is_empty() || out.len() > 64 * 1024 {
+        return false;
+    }
+    let Some(end) = offset.checked_add(out.len() as u64) else { return false; };
+    let first = offset / data_size as u64;
+    let last = (end - 1) / data_size as u64;
+    if first / 64 != request.group_idx as u64 || last / 64 != request.group_idx as u64 {
+        return false;
+    }
+    for sector in first..=last {
+        let local = (sector % 64) as usize;
+        if group.sector_bitmap & (1u64 << local) == 0 || (local + 1) * SECTOR_SIZE > group.data.len() {
+            return false;
+        }
+    }
+    let mut position = offset;
+    let mut written = 0;
+    while written < out.len() {
+        let sector = (position / data_size as u64 % 64) as usize;
+        let within = (position % data_size as u64) as usize;
+        let count = (data_size - within).min(out.len() - written);
+        let source = sector * SECTOR_SIZE + if has_hashes { HASHES_SIZE } else { 0 } + within;
+        out[written..written + count].copy_from_slice(&group.data[source..source + count]);
+        written += count;
+        position += count as u64;
+    }
+    true
+}
