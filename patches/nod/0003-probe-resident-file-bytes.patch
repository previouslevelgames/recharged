 impl Preloader {
+    /// Borrow a current cache entry without waiting, cloning or scheduling work.
+    /// Preserve fetch's poison checks; reader-local groups bypass these in both
+    /// paths. The callback holds the cache borrow for its bounded memory copy.
+    pub(super) fn try_with_cached_group(
+        &self, request: &SectorGroupRequest, use_group: impl FnOnce(&SectorGroup) -> bool,
+    ) -> bool {
+        #[cfg(feature = "threading")]
+        {
+            let Ok(threads) = self.threads.try_lock() else { return false; };
+            drop(threads);
+            let Ok(cache) = self.cache.try_lock() else { return false; };
+            match cache.lru_cache.peek(request) {
+                Some(group) => use_group(group),
+                None => false,
+            }
+        }
+        #[cfg(not(feature = "threading"))]
+        {
+            // Ordinary non-threaded fetch always reloads through the loader.
+            // Keep that path and its errors; only reader-local cache hits qualify.
+            let _ = (request, use_group);
+            false
+        }
+    }
