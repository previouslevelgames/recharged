+
+impl WindowedReader<Box<dyn crate::read::PartitionReader>> {
+    /// Nonblocking bounded file-relative cache probe. EOF clips the successful
+    /// count, but not the caller's destination. A miss changes neither cursor.
+    pub fn try_read_cached_at(&mut self, offset: u64, out: &mut [u8]) -> Option<usize> {
+        if out.is_empty() || out.len() > 64 * 1024 || offset >= self.len() {
+            return None;
+        }
+        let count = out.len().min(usize::try_from(self.len() - offset).unwrap_or(usize::MAX));
+        let absolute = self.begin.checked_add(offset)?;
+        let end = absolute.checked_add(count as u64)?;
+        if !self.base.try_read_cached_at(absolute, &mut out[..count]) {
+            return None;
+        }
+        self.pos = end;
+        Some(count)
+    }
 }
 
