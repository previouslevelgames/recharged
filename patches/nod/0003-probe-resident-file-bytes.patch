+use super::*;
+use std::{io::{self, Cursor, BufRead, Read, Seek, SeekFrom}, sync::{Arc, atomic::{AtomicUsize, Ordering}}};
+use nod::read::{OwnedFileReader, PartitionReader, PartitionMeta};
+
+#[derive(Clone)]
+struct Resident {
+    inner: Cursor<Vec<u8>>, enabled: bool, cached: Arc<AtomicUsize>, ordinary: Arc<AtomicUsize>,
+}
+impl Read for Resident {
+    fn read(&mut self,out:&mut[u8])->io::Result<usize> { self.ordinary.fetch_add(1,Ordering::Relaxed); self.inner.read(out) }
+}
+impl BufRead for Resident {
+    fn fill_buf(&mut self)->io::Result<&[u8]> { self.ordinary.fetch_add(1,Ordering::Relaxed); self.inner.fill_buf() }
+    fn consume(&mut self,n:usize) { self.inner.consume(n); }
+}
+impl Seek for Resident { fn seek(&mut self,pos:SeekFrom)->io::Result<u64> { self.inner.seek(pos) } }
+impl PartitionReader for Resident {
+    fn is_wii(&self)->bool { true }
+    fn meta(&mut self)->nod::Result<PartitionMeta> { panic!("Cache API attempted metadata I/O") }
+    fn try_read_cached_at(&mut self,offset:u64,out:&mut[u8])->bool {
+        self.cached.fetch_add(1,Ordering::Relaxed);
+        if !self.enabled { return false; }
+        let Ok(offset)=usize::try_from(offset) else {return false;};
+        let Some(end)=offset.checked_add(out.len()) else {return false;};
+        let Some(bytes)=self.inner.get_ref().get(offset..end) else {return false;};
+        out.copy_from_slice(bytes);self.inner.set_position(end as u64);true
+    }
+}
+struct Fixture {handle:*mut NodHandle,cached:Arc<AtomicUsize>,ordinary:Arc<AtomicUsize>}
+impl Fixture {
+    fn new(enabled:bool)->Self {
+        let cached=Arc::new(AtomicUsize::new(0));let ordinary=Arc::new(AtomicUsize::new(0));
+        let bytes=(0..70000).map(|i|((i*29+i/113)%251) as u8).collect();
+        let base:Box<dyn PartitionReader>=Box::new(Resident {inner:Cursor::new(bytes),enabled,cached:cached.clone(),ordinary:ordinary.clone()});
+        let reader=OwnedFileReader::new(base,37,65520).unwrap();
+        let handle=Box::into_raw(Box::new(NodHandle::new(NodHandleInner::File(reader))));
+        Self{handle,cached,ordinary}
+    }
+    fn position(&mut self)->u64 { unsafe { match &mut (*self.handle).inner { NodHandleInner::File(reader) => reader.stream_position().unwrap(), _ => unreachable!() } } }
+}
+impl Drop for Fixture {fn drop(&mut self){unsafe{nod_free(self.handle);}}}
+fn expected(position:usize)->u8 {((position*29+position/113)%251) as u8}
+#[test]
+fn cached_c_api_file_relative_read_and_short_eof_tail() {
+    let mut f=Fixture::new(true);let mut out=vec![0xFD;65536];
+    let got=unsafe{nod_try_read_cached_at(f.handle,0,out.as_mut_ptr(),out.len())};
+    assert_eq!(got,65520);assert_eq!(f.position(),37+65520);
+    for i in 0..65520 {assert_eq!(out[i],expected(37+i));}
+    assert!(out[65520..].iter().all(|b|*b==0xFD));
+    assert_eq!(f.cached.load(Ordering::Relaxed),1);assert_eq!(f.ordinary.load(Ordering::Relaxed),0);
+    // A subsequent ordinary read sees exactly the position produced by the hit.
+    let mut tail=[0xFC;32];assert_eq!(unsafe{nod_read(f.handle,tail.as_mut_ptr(),tail.len())},0);
+    assert_eq!(tail,[0xFC;32]);
+    assert_eq!(unsafe{nod_seek(f.handle,-12,1)},65508);
+    assert_eq!(unsafe{nod_read(f.handle,tail.as_mut_ptr(),12)},12);
+    for i in 0..12 {assert_eq!(tail[i],expected(37+65508+i));}
+}
+#[test]
+fn cached_c_api_miss_is_transactional_including_diagnostics() {
+    let mut f=Fixture::new(false);let mut out=[0xFD;64];let before=f.position();
+    set_last_error("prior diagnostic stays owned");let error=unsafe{nod_error_message()};
+    assert_eq!(unsafe{nod_try_read_cached_at(f.handle,5,out.as_mut_ptr(),out.len())},-2);
+    assert_eq!(f.position(),before);assert_eq!(out,[0xFD;64]);assert_eq!(unsafe{nod_error_message()},error);
+    assert_eq!(f.cached.load(Ordering::Relaxed),1);assert_eq!(f.ordinary.load(Ordering::Relaxed),0);
+    assert_eq!(unsafe{nod_read(f.handle,out.as_mut_ptr(),out.len())},64);
+    for i in 0..out.len(){assert_eq!(out[i],expected(37+i));}
+}
+#[test]
+fn cached_c_api_guards_do_not_delegate_or_mutate() {
+    let mut f=Fixture::new(true);let mut out=vec![0xFD;65537];let before=f.position();
+    set_last_error("unchanged guard diagnostic");let error=unsafe{nod_error_message()};
+    for (offset,len) in [(0,0),(0,65537),(u64::MAX,32),(65520,32),(65521,1)] {
+        assert_eq!(unsafe{nod_try_read_cached_at(f.handle,offset,out.as_mut_ptr(),len)},-2);
+    }
+    assert_eq!(unsafe{nod_try_read_cached_at(std::ptr::null_mut(),0,out.as_mut_ptr(),32)},-2);
+    assert_eq!(unsafe{nod_try_read_cached_at(f.handle,0,std::ptr::null_mut(),32)},-2);
+    let unaligned=unsafe{(f.handle as *mut u8).add(1)} as *mut NodHandle;
+    assert_eq!(unsafe{nod_try_read_cached_at(unaligned,0,out.as_mut_ptr(),32)},-2);
+    assert_eq!(f.position(),before);assert!(out.iter().all(|b|*b==0xFD));
+    assert_eq!(f.cached.load(Ordering::Relaxed),0);assert_eq!(f.ordinary.load(Ordering::Relaxed),0);
+    assert_eq!(unsafe{nod_error_message()},error);
+}
