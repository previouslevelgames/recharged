+    let mut out=[0;128];let before=ALLOCATIONS.with(|v|v.get());
+    WATCH_ALLOC.with(|v|v.set(true));
+    let a=shared.try_read_cached_at(51,&mut out);
+    let b=local.try_read_cached_at(51,&mut out);
+    let c=shared.try_read_cached_at((64*SECTOR_DATA_SIZE) as u64,&mut out);
+    WATCH_ALLOC.with(|v|v.set(false));
+    assert_eq!(a,cfg!(feature="threading"));assert!(b&&!c);assert_eq!(ALLOCATIONS.with(|v|v.get()),before);
+}
