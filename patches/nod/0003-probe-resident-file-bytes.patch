+// Count allocations only on this test's thread and only inside the actual probe.
+// Fixture creation, assertion diagnostics and other parallel tests are excluded.
+struct AllocationObserver;
+thread_local! {
+    static WATCH_ALLOC: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    static ALLOCATIONS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+fn note_allocation() {
+    if WATCH_ALLOC.try_with(|v|v.get()).unwrap_or(false) {
+        let _=ALLOCATIONS.try_with(|v|v.set(v.get()+1));
+    }
+}
+unsafe impl std::alloc::GlobalAlloc for AllocationObserver {
+    unsafe fn alloc(&self,layout:std::alloc::Layout)->*mut u8 {
+        note_allocation();unsafe{std::alloc::System.alloc(layout)}
+    }
+    unsafe fn alloc_zeroed(&self,layout:std::alloc::Layout)->*mut u8 {
+        note_allocation();unsafe{std::alloc::System.alloc_zeroed(layout)}
+    }
+    unsafe fn realloc(&self,p:*mut u8,layout:std::alloc::Layout,size:usize)->*mut u8 {
+        note_allocation();unsafe{std::alloc::System.realloc(p,layout,size)}
+    }
+    unsafe fn dealloc(&self,p:*mut u8,layout:std::alloc::Layout) {
+        unsafe{std::alloc::System.dealloc(p,layout)}
+    }
+}
+#[global_allocator]
+static CACHED_PROBE_ALLOCATOR:AllocationObserver=AllocationObserver;
