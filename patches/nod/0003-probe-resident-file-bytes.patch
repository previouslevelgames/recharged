+/// Try a bounded file read using only resident Wii partition bytes.
+///
+/// Returns -2 for cache miss, unsupported reader, invalid arguments, zero-sized
+/// request, or requested length above 64 KiB. A miss changes neither the cursor,
+/// destination nor thread-local diagnostic state. It performs no I/O, allocation,
+/// decompression, callback or blocking lock acquisition.
+///
+/// On a hit, returns the requested count clipped only to the actual file EOF,
+/// advances both file and partition positions as a seek followed by reads, and
+/// leaves any destination tail beyond EOF untouched. Validation-enabled readers
+/// always miss. Zero bytes available at EOF also miss.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nod_try_read_cached_at(
+    handle: *mut NodHandle, offset: u64, buf: *mut u8, len: usize,
+) -> i64 {
+    if handle.is_null() || !handle.is_aligned() || buf.is_null() || len == 0 || len > 64 * 1024 {
+        return -2;
+    }
+    let handle = unsafe { &mut *handle };
+    if !handle.is_valid() { return -2; }
+    let NodHandleInner::File(file) = &mut handle.inner else { return -2; };
+    let destination = unsafe { std::slice::from_raw_parts_mut(buf, len) };
+    file.try_read_cached_at(offset, destination).map_or(-2, |count| count as i64)
+}
