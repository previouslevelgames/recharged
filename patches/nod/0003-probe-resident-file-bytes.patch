+use super::*;
+use bytes::Bytes;
+use std::io::{Read, Seek, SeekFrom};
+use crate::{
+    common::{PartitionKind, Format},
+    disc::{BOOT_SIZE, DiscHeader, preloader::SectorGroupLoader},
+    io::block::{Block, BlockReader},
+    read::{DiscMeta, OwnedFileReader},
+};
+use zerocopy::FromZeros;
+
+#[derive(Clone)]
+struct ForbiddenIo;
+impl BlockReader for ForbiddenIo {
+    fn read_block(&mut self, _: &mut [u8], _: u32) -> io::Result<Block> {
+        panic!("Cached read attempted physical I/O");
+    }
+    fn block_size(&self) -> u32 { SECTOR_SIZE as u32 }
+    fn meta(&self) -> DiscMeta { DiscMeta { format: Format::Iso, ..Default::default() } }
+}
+fn preloader() -> Arc<Preloader> {
+    let loader = SectorGroupLoader::new(Box::new(ForbiddenIo),
+        Arc::new(DiscHeader::new_zeroed()), Arc::from([]));
+    #[cfg(feature = "threading")]
+    { Preloader::new(loader, 0) }
+    #[cfg(not(feature = "threading"))]
+    { Preloader::new(loader) }
+}
+fn partition(has_hashes: bool) -> PartitionInfo {
+    PartitionInfo {
+        index: 3, kind: PartitionKind::Data, start_sector: 0,
+        data_start_sector: 100, data_end_sector: 228, key: [0;16],
+        header: Arc::new(WiiPartitionHeader::new_zeroed()),
+        has_encryption: false, has_hashes,
+        raw_boot: Arc::new([0;BOOT_SIZE]), raw_fst: None,
+    }
+}
+fn reader(cache: Arc<Preloader>, has_hashes: bool) -> PartitionReaderWii {
+    PartitionReaderWii { preloader: cache, partition: partition(has_hashes), pos: 73,
+        options: PartitionOptions::default(), sector_group: None, meta: None }
+}
+fn key(group_idx: u32) -> SectorGroupRequest {
+    SectorGroupRequest { group_idx, partition_idx: Some(3),
+        mode: PartitionEncryption::ForceDecryptedNoHashes, force_rehash: false }
+}
+// Literal byte oracle: hash areas are distinct and must never appear in output.
+fn pattern(logical: usize) -> u8 { ((logical * 37 + logical / 251 + 11) % 251) as u8 }
+fn group(has_hashes: bool, group_idx: u32) -> SectorGroup {
+    let mut data = vec![0xFE; SECTOR_GROUP_SIZE];
+    let sector_data = if has_hashes { SECTOR_DATA_SIZE } else { SECTOR_SIZE };
+    for sector in 0..64 {
+        let begin = sector * SECTOR_SIZE + if has_hashes { HASHES_SIZE } else { 0 };
+        for byte in 0..sector_data {
+            data[begin+byte] = pattern((group_idx as usize * 64 + sector) * sector_data + byte);
+        }
+    }
+    SectorGroup { request: key(group_idx), start_sector: 100 + 64 * group_idx,
+        data: Bytes::from(data), sector_bitmap: u64::MAX, io_duration: None, group_hashes: None }
+}
+fn expect_bytes(bytes: &[u8], offset: usize) {
+    for (i,byte) in bytes.iter().enumerate() { assert_eq!(*byte,pattern(offset+i),"byte {i}"); }
+}
+#[test]
+fn cached_local_crosses_hash_blocks_and_advances_real_reader() {
+    let mut r = reader(preloader(),true); r.sector_group=Some(group(true,0));
+    let begin=SECTOR_DATA_SIZE-7; let mut output=vec![0xFD;65536];
+    assert!(r.try_read_cached_at(begin as u64,&mut output)); expect_bytes(&output,begin);
+    assert_eq!(r.pos,(begin+output.len()) as u64);
+    let mut following=[0;19]; r.read_exact(&mut following).unwrap();
+    expect_bytes(&following,begin+output.len());
+}
+#[test]
