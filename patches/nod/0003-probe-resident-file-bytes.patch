 /**
+ * Nonblocking resident Wii-file read. Returns -2 on miss/unsupported/invalid input.
+ * Maximum requested len: 64 KiB. Zero len/zero available bytes miss. Miss preserves
+ * output, file/partition cursors and diagnostics. Hit returns exact bytes clipped
+ * to file EOF, preserves the output tail and updates both cursors like seek+read.
+ * No I/O, decompression, allocation, callback or blocking lock; validation-enabled
+ * readers always miss. Handle/buffer lifetime and aliasing follow nod_read.
+ */
+int64_t nod_try_read_cached_at(struct NodHandle *handle, uint64_t offset, uint8_t *buf, size_t len);
+
+/**
