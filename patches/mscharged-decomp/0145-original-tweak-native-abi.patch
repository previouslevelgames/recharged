 #include "Game/TweakValueBase.h"
 #include "Game/TweakRegistry.h"
@@ -68,8 +72,16 @@
 #else
 int IsTweakNameOnStack(const char* name)
 {
+#ifdef MSCHARGED_NATIVE
+    const auto limits = mscharged::CurrentThreadStackLimits();
+    const auto stackBegin = limits.high;
+    const auto stackEnd = limits.low;
+    const auto address = reinterpret_cast<std::uintptr_t>(name);
+    return stackEnd <= address && stackBegin >= address;
+#else
     const char* stackBegin = (const char*)OSGetCurrentThread()->stackBegin;
     const char* stackEnd = (const char*)OSGetCurrentThread()->stackEnd;
     return stackEnd <= name && stackBegin >= name;
+#endif
 }
 #endif
