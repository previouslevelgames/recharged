From: mscharged-port
Subject: Preserve fixed Wii16 RFL name cells without changing host wchar
Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090

diff --git a/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h b/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h
--- a/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h
+++ b/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h
@@ -22,6 +22,13 @@
 #define RFL_NAME_LEN 10
 #define RFL_CREATOR_LEN 10
 #define RFL_CREATEID_LEN 8
+
+#if defined(MSCHARGED_NATIVE)
+// RFL name cells are Wii16; the host wchar_t and CRT remain unchanged.
+#define RFL_WCHAR u16
+#else
+#define RFL_WCHAR wchar_t
+#endif
 
 #define RFL_DB_CHAR_MAX 100
 #define RFL_CTRL_CHAR_MAX 10
diff --git a/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h b/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h
--- a/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h
+++ b/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h
@@ -252,8 +252,8 @@
     } body; // at 0x16
 
     struct {
-        wchar_t name[RFL_NAME_LEN + 1];       // at 0x18
-        wchar_t creator[RFL_CREATOR_LEN + 1]; // at 0x2E
+        RFL_WCHAR name[RFL_NAME_LEN + 1];       // at 0x18
+        RFL_WCHAR creator[RFL_CREATOR_LEN + 1]; // at 0x2E
 
         // at 0x44
         u16 sex : 1;
@@ -276,7 +276,7 @@
     u16 favoriteColor : 4;
     u16 favorite : 1;
 
-    wchar_t name[RFL_NAME_LEN]; // at 0x2
+    RFL_WCHAR name[RFL_NAME_LEN]; // at 0x2
     u8 height;                  // at 0x16
     u8 build;                   // at 0x17
     RFLCreateID createID;       // at 0x18
@@ -349,7 +349,7 @@
     u16 moleX : 5;
     u16 padding8 : 1;
 
-    wchar_t creatorName[RFL_CREATOR_LEN]; // at 0x36
+    RFL_WCHAR creatorName[RFL_CREATOR_LEN]; // at 0x36
 } RFLiCharData;
 
 typedef struct RFLiStoreData {
@@ -365,7 +365,7 @@
     u16 favoriteColor : 4;
     u16 favorite : 1;
 
-    wchar_t name[RFL_NAME_LEN]; // at 0x2
+    RFL_WCHAR name[RFL_NAME_LEN]; // at 0x2
     u8 height;                  // at 0x16
     u8 build;                   // at 0x17
     RFLCreateID createID;       // at 0x18
