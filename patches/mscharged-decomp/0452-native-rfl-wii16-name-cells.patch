From: mscharged-port
Subject: Preserve fixed Wii16 RFL name cells without changing host wchar
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

diff --git a/libs/RVL_SDK/include/RVLFaceLib/RFL_DataUtility.h b/libs/RVL_SDK/include/RVLFaceLib/RFL_DataUtility.h
index ec533ff..bc7e540 100644
--- a/libs/RVL_SDK/include/RVLFaceLib/RFL_DataUtility.h
+++ b/libs/RVL_SDK/include/RVLFaceLib/RFL_DataUtility.h
@@ -17,8 +17,8 @@ extern "C" {
 typedef struct RFLMiddleDB;
 
 typedef struct RFLAdditionalInfo {
-    wchar_t name[RFL_NAME_LEN + 1];       // at 0x0
-    wchar_t creator[RFL_CREATOR_LEN + 1]; // at 0x16
+    RFL_WCHAR name[RFL_NAME_LEN + 1];       // at 0x0
+    RFL_WCHAR creator[RFL_CREATOR_LEN + 1]; // at 0x16
     RFLCreateID createID;                 // at 0x2C
 
     // at 0x34
diff --git a/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h b/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h
index 442d2cd..9ed759c 100644
--- a/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h
+++ b/libs/RVL_SDK/include/RVLFaceLib/RFL_Types.h
@@ -23,6 +23,13 @@ extern "C" {
 #define RFL_CREATOR_LEN 10
 #define RFL_CREATEID_LEN 8
 
+#if defined(MSCHARGED_NATIVE)
+// RFL name cells are Wii16; the host wchar_t and CRT remain unchanged.
+#define RFL_WCHAR u16
+#else
+#define RFL_WCHAR wchar_t
+#endif
+
 #define RFL_DB_CHAR_MAX 100
 #define RFL_CTRL_CHAR_MAX 10
 #define RFL_DEFAULT_CHAR_MAX 6
