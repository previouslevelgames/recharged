@@ -421,7 +421,7 @@ void RFLiConvertInfo2HRaw(const RFLiCharInfo* info, RFLiHiddenCharData* out) {
 void RFLiConvertRaw2HRaw(const RFLiCharData* data, RFLiHiddenCharData* out) {
