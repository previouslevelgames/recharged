+#if defined(MSCHARGED_NATIVE)
+// Byte buffers retain the original PowerPC word order and need no host alignment.
+void CBlowFish::Blowfish_encipher_bytes(BYTE* xl, BYTE* xr)
+{
+    DWORD left = (DWORD(xl[0]) << 24) | (DWORD(xl[1]) << 16) | (DWORD(xl[2]) << 8) | DWORD(xl[3]);
+    DWORD right = (DWORD(xr[0]) << 24) | (DWORD(xr[1]) << 16) | (DWORD(xr[2]) << 8) | DWORD(xr[3]);
+    Blowfish_encipher(&left, &right);
+    xr[0] = static_cast<BYTE>(right >> 24);
+    xr[1] = static_cast<BYTE>(right >> 16);
+    xr[2] = static_cast<BYTE>(right >> 8);
+    xr[3] = static_cast<BYTE>(right);
+    xl[0] = static_cast<BYTE>(left >> 24);
+    xl[1] = static_cast<BYTE>(left >> 16);
+    xl[2] = static_cast<BYTE>(left >> 8);
+    xl[3] = static_cast<BYTE>(left);
+}
+#endif
