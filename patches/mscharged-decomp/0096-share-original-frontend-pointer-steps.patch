--- /dev/null
+++ b/include/Game/FE/FrontendPointerSteps.h
@@ -0,0 +1,124 @@
+#ifndef GAME_FE_FRONTEND_POINTER_STEPS_H
+#define GAME_FE_FRONTEND_POINTER_STEPS_H
+#include "Game/MathHelpers.h"
+
+// Shared original listener ordering. Native callers validate event index/lifetime.
+template<class Listener, class Event, class Input>
+void FrontendPointerProcess(Listener& listener, const Event* event, const Input* input)
+{
+    if (listener.mDisabled || (input->m_InputLockDepth != 0 && !listener.mIgnoreInputLock))
+    {
+        return;
+    }
+
+    if (listener.ContainsPoint(event->mPosition))
+    {
+        if (!listener.ContainsPoint(listener.mPreviousEvents[event->mIndex].mPosition))
+        {
+            listener.OnPointerEnter(event->mIndex, listener.mContext);
+        }
+
+        listener.OnPointerUpdate(event->mIndex, listener.mContext);
+        listener.OnPointerInside(event->mIndex, listener.mContext);
+
+        if (event->mPressed)
+        {
+            listener.OnPointerPress(event->mIndex, listener.mContext);
+        }
+
+        if (event->mUnidentified0E)
+        {
+            listener.UnidentifiedVirtual24(event->mIndex, listener.mContext);
+        }
+    }
+    else if (listener.ContainsPoint(listener.mPreviousEvents[event->mIndex].mPosition))
+    {
+        listener.OnPointerLeave(event->mIndex, listener.mContext);
+    }
+
+    if (event->mReleased)
+    {
+        listener.OnPointerRelease(event->mIndex, listener.mContext);
+    }
+
+    listener.mPreviousEvents[event->mIndex] = *event;
+}
+
+template<class Listener, class Event>
+void FrontendPointerDisable(Listener& listener)
+{
+    listener.mDisabled = true;
+    Event event;
+    for (int i = 0; i < 4; ++i)
+        listener.mPreviousEvents[i] = event;
+}
+
+inline bool FrontendPointerContainsPoint(nlVector2 position,
+    float mMinX, float mMaxX, float mMaxY, float mMinY,
+    float mRotation, nlVector2 mPivot)
+{
+    if (mRotation == 0.0f)
+    {
+        return position.x >= mMinX && position.x <= mMaxX && position.y >= mMinY && position.y <= mMaxY;
+    }
+
+    nlVector3 local;
+    nlVec3Set(local, position.x - mPivot.x, position.y - mPivot.y, 0.0f);
+
+    float cosine = nlSin((unsigned short)(RadToAng16(mRotation) + 0x4000));
+    float sineForY = nlSin(RadToAng16(mRotation));
+    float rotatedY = local.x * -sineForY + local.y * cosine;
+    float sine = nlSin(RadToAng16(mRotation));
+    cosine = nlSin((unsigned short)(RadToAng16(mRotation) + 0x4000));
+    float rotatedX = local.x * cosine + local.y * sine;
+    nlVec3Set(local, rotatedX, rotatedY, 0.0f);
+    nlVec3Set(local, local.x + mPivot.x, local.y + mPivot.y, 0.0f);
+
+    return local.x >= mMinX && local.x <= mMaxX && local.y >= mMinY && local.y <= mMaxY;
+}
+
+template<class Instance, class Position>
+void FrontendPointerSetInstanceBounds(Instance* instance, nlVector2 measuredSize,
+    bool useRotation, float offsetX, float offsetY, float scaleX, float scaleY,
+    float& mMinX, float& mMaxX, float& mMaxY, float& mMinY,
+    float& mRotation, nlVector2& mPivot)
+{
+    nlVector2 size;
+    size.x = measuredSize.x * scaleX;
+    size.y = measuredSize.y * scaleY;
+
+    Position position = instance->GetAssetPosition();
+    float x = position.f.x + offsetX;
+    float y = position.f.y + offsetY;
+    mMinX = x - size.x / 2.0f;
+    mMaxX = x + size.x / 2.0f;
+    mMaxY = y + size.y / 2.0f;
+    mMinY = y - size.y / 2.0f;
+
+    if (useRotation)
+    {
+        mRotation = instance->GetAssetRotation().f.z;
+        nlVec2Set(mPivot, position.f.x, position.f.y);
+    }
+    else
+    {
+        mRotation = 0.0f;
+    }
+}
+
+// Original list loop invokes this for each ring child in stored order.
+template<class Position>
+void FrontendPointerExpand(nlVector2 size, Position position,
+    float& minX, float& minY, float& maxX, float& maxY)
+{
+        float left = position.f.x - size.x / 2.0f;
+        float bottom = position.f.y - size.y / 2.0f;
+        float right = position.f.x + size.x / 2.0f;
+        float top = position.f.y + size.y / 2.0f;
+
+        minX = left < minX ? left : minX;
+        minY = bottom < minY ? bottom : minY;
+        maxX = right > maxX ? right : maxX;
+        maxY = top > maxY ? top : maxY;
+}
+#endif
