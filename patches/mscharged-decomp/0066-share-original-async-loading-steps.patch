+#ifndef GAME_ASYNC_LOADING_SHARED_H
+#define GAME_ASYNC_LOADING_SHARED_H
+#include "Game/AsyncLoading.h"
+#include "NL/gl/glMemory.h"
+#include "NL/nlString.h"
+
+struct PersistentResourceRequirements
+{
+    GLMemoryRequirement entries[2];
+};
+extern PersistentResourceRequirements gPersistentResourceRequirements;
+void fn_80111654(int);
+void fn_8011165C(int);
+
+// Shared original stage yield/readiness comparison. The caller supplies the
+// original ticker difference; separating acquisition permits deterministic
+// qualification without replacing the runtime clock.
+template<class Manager>
+inline void FinishAsyncLoadingStep(Manager* manager, float elapsed, float threshold)
+{
+    if (elapsed > threshold)
+    {
+        manager->StopWithoutUndo();
+    }
+}
+template<class Manager>
+inline void FinishAsyncLoadingStepOrUndo(Manager* manager, bool finished, float elapsed, float threshold)
+{
+    if (finished)
+    {
+        FinishAsyncLoadingStep(manager, elapsed, threshold);
+    }
+    else
+    {
+        manager->StopWithUndo();
+    }
+}
+template<class Manager>
+inline void AdvanceAsyncLoadingSequence(Manager* manager, int& result, bool& completed)
+{
+    switch (manager->mSequenceState)
+    {
+#include "Game/AsyncLoadingSequence.inc"
+    }
+}
+#endif
