+#else
     GXSetArray(GX_VA_POS, streams[0].address, 12);
+#endif
+#if defined(MSCHARGED_NATIVE)
+    mscharged::platform::SetGameGraphicsArray(GX_VA_TEX0, streams[1].address, 8);
+#else
     GXSetArray(GX_VA_TEX0, streams[1].address, 8);
+#endif
