diff --git a/src/Game/Render/RenderShadowNative.cpp b/src/Game/Render/RenderShadowNative.cpp
new file mode 100644
index 0000000..96095b3
--- /dev/null
+++ b/src/Game/Render/RenderShadowNative.cpp
@@ -0,0 +1,90 @@
+// Original shadow update selection and projection setup; model conversion/submission remains separate.
+#include "Game/Render/RenderShadow.h"
+#include "Game/Render/RLViewLayers.h"
+#include "Game/Render/Frustum.h"
+#include "NL/gl/glMatrix.h"
+#include <cmath>
+#include <stdexcept>
+int GetShadowPartitionCount();
+void SetShadowPartitionEnabled(int, bool);
+void SetShadowPartitionCamera(int, const nlMatrix4&, const nlMatrix4&);
+static void ValidateNativeShadowParams(const ProjectedShadowParams& p)
+{
+    if (p.nPartitionIndex < 0 || p.nPartitionIndex >= 11 || p.nVisibleInterval <= 0 || p.nInvisibleInterval <= 0
+        || !std::isfinite(p.fRadius) || p.fRadius <= 0 || p.fRadius > 1e4f
+        || !std::isfinite(p.fHeight) || p.fHeight < 0 || p.fHeight > 1e4f)
+        throw std::invalid_argument("Invalid shadow dimensions, partition or update interval");
+    for (float v : {p.vPosition.x, p.vPosition.y, p.vPosition.z, p.vLight.x, p.vLight.y, p.vLight.z})
+        if (!std::isfinite(v) || std::abs(v) > 1e6f) throw std::invalid_argument("Invalid shadow vector");
+    if (p.vLight.x*p.vLight.x + p.vLight.y*p.vLight.y < 1e-10f || std::abs(p.vLight.z) < 1e-5f)
+        throw std::invalid_argument("Shadow light is parallel to the ground or camera up vector");
+}
+bool ShouldShadowBeUpdated(const ProjectedShadowParams& params, const GLViewInterface& camera, u32 currentFrame)
+{
+    ValidateNativeShadowParams(params);
+    if (!camera.GetShadowMatrix()) throw std::invalid_argument("Shadow visibility camera has no frustum");
+    nlVector3 position = params.vPosition;
+    position.z += 0.625f * params.fHeight;
+
+    float radius = 2.0f * params.fRadius;
+    bool visible
+        = ClassifySphereInFrustum(camera.GetShadowMatrix(), &position, radius);
+    u32 interval;
+    if (visible)
+    {
+        interval = params.nVisibleInterval;
+    }
+    else
+    {
+        interval = params.nInvisibleInterval;
+    }
+
+    u32 frame = u32(params.nPartitionIndex) + currentFrame;
+    if (frame % interval != 0)
+    {
+        return 0;
+    }
+    return 1;
+}
+
+void PrepareNativeShadowPartition(const ProjectedShadowParams& params)
+{
+    ValidateNativeShadowParams(params);
+    nlVector3 up = { 0.0f, 0.0f, 1.0f };
+    nlVector3 targetPos;
+    nlVector3 viewDir;
+    nlVector3 eyePos;
+    nlVector3 vTemp;
+    nlVector3 vDir;
+    nlVector3 shadowPos;
+    nlVector3 vLight;
+
+    targetPos = params.vPosition;
+    targetPos.z += 0.5f * params.fHeight;
+
+    nlVec3Set(shadowPos, params.vLight.x, params.vLight.y, params.vLight.z);
+
+    nlVec3Set(viewDir, -shadowPos.x, -shadowPos.y, -shadowPos.z);
+    nlVec3Scale(viewDir, nlRecipSqrt(viewDir.GetLengthSq3D(), false));
+    nlVec3Neg(viewDir, viewDir);
+
+    nlVec3ScaleAdd(eyePos, 8.0f, viewDir, targetPos);
+
+    nlMatrix4 view;
+    glMatrixLookAt(view, eyePos, targetPos, up);
+
+    nlMatrix4 projection;
+    float radius = 2.0f * params.fRadius;
+    glMatrixOrthographicCentered(projection, radius, radius, 4.0f, 12.0f);
+
+    SetShadowPartitionCamera(params.nPartitionIndex, view, projection);
+    SetShadowPartitionEnabled(params.nPartitionIndex, true);
+}
+void ClearCharacterShadowsUpdated()
+{
+    int shadowIndex;
+    for (shadowIndex = 0; shadowIndex < GetShadowPartitionCount(); shadowIndex++)
+    {
+        SetShadowPartitionEnabled(shadowIndex, false);
+    }
+}
diff --git a/src/Game/Render/ShadowLayersNative.cpp b/src/Game/Render/ShadowLayersNative.cpp
