 struct FuzzyRuntimeList
@@ -448,7 +454,15 @@ FuzzyRuntimeBase::EndActionQueue()
     }
     else if (entry->mQuestionHash != 0)
     {
+#if defined(MSCHARGED_NATIVE)
+        // mQuestionHash is an int. Widened as the 32-bit word it holds, the
