+#endif
         if (g_bScriptQuestionCachingOn)
         {
             g_FuzzyQuestionCache.mQuestionCacheMap.Add(hash, *selected);
@@ -478,11 +492,57 @@ static inline float GetActionFloatParameter(
     return defaultValue;
 }
 
+#if defined(MSCHARGED_NATIVE)
+// The question cache keys a question by its script offset plus its argument,
+// and an object argument hashes as its address. On the Wii every console
+// places the players, teams, ball and game alike, so two questions that
+// happen to share a key share it on every machine of a match. Native hosts
+// place them differently (and unsigned long is 64 bits on Linux), so one
+// machine took another question's cached answer where the other did not, and
+// the AI scripts and then the match went apart. Natively an object stands in
+// as a fixed Wii-like address of its own, and the key is a Wii-width word.
+static u32 StrategicQuestionArgument(const Variant& argument)
+{
+    const void* object = argument.mData.pointer;
+    switch (argument.GetType())
+    {
+    case FT_PLAYER:
+        for (int i = 0; i < 10; i++)
+        {
+            if (static_cast<const void*>(g_pCharacters[i]) == object)
+                return 0x81000000u + (u32)i * 0x10000u;
+        }
+        return 0x810F0000u;
+    case FT_TEAM:
+        for (int i = 0; i < 2; i++)
+        {
+            if (static_cast<const void*>(g_pTeams[i]) == object)
+                return 0x81100000u + (u32)i * 0x10000u;
+        }
+        return 0x811F0000u;
+    case FT_BALL:
+        return object == static_cast<const void*>(g_pBall) ? 0x81200000u : 0x812F0000u;
+    case FT_GAME:
+        return object == static_cast<const void*>(g_pGame) ? 0x81300000u : 0x813F0000u;
+    case FT_POINTER:
+        return object != 0 ? 0x814F0000u : 0;
+    default:
+        return (u32)argument.GetHash();
+    }
+}
+
+static inline unsigned long StrategicQuestionHash(
+    unsigned long functionAddress, const Variant& argument)
+{
+    return (u32)((u32)functionAddress + StrategicQuestionArgument(argument));
+}
+#else
 static inline unsigned long StrategicQuestionHash(
     unsigned long functionAddress, const Variant& argument)
 {
     return functionAddress + argument.GetHash();
 }
+#endif
 
 extern "C" bool FuzzyTryCachedQuestion(
     FuzzyRuntimeBase* runtime, const Variant& value)
