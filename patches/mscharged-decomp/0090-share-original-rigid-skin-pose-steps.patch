diff --git a/include/Game/GL/SkinPoseSteps.h b/include/Game/GL/SkinPoseSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/GL/SkinPoseSteps.h
@@ -0,0 +1,59 @@
+#ifndef GAME_GL_SKIN_POSE_STEPS_H
+#define GAME_GL_SKIN_POSE_STEPS_H
+#include "NL/nlMath.h"
+#include "NL/platvmath.h"
+#include "NL/glx/glxMatrix.h"
+
+// Shared original preparation, matrix product and packet conversion. Native
+// callers qualify storage, indices and matrix domains before these operations.
+inline void SkinMoveLargestWeightFirst(unsigned char* boneIndices, float* boneWeights)
+{
+    float largestWeight = 0.0f;
+    int largestIndex = 0;
+    if (boneWeights[0] > largestWeight)
+    {
+        largestIndex = 0;
+        largestWeight = boneWeights[0];
+    }
+    if (boneWeights[1] > largestWeight)
+    {
+        largestIndex = 1;
+        largestWeight = boneWeights[1];
+    }
+    if (boneWeights[2] > largestWeight)
+    {
+        largestIndex = 2;
+        largestWeight = boneWeights[2];
+    }
+    if (boneWeights[3] > largestWeight)
+    {
+        largestIndex = 3;
+    }
+
+    if (largestIndex != 0)
+    {
+        unsigned char firstIndex = boneIndices[0];
+        float firstWeight = boneWeights[0];
+        boneIndices[0] = boneIndices[largestIndex];
+        boneWeights[0] = boneWeights[largestIndex];
+        boneIndices[largestIndex] = firstIndex;
+        boneWeights[largestIndex] = firstWeight;
+    }
+}
+inline void SkinInverseBind(nlMatrix4& inverse, const nlMatrix4& authored)
+{
+    nlInvertMatrix(inverse, authored);
+}
+template <typename Pose>
+inline void SkinBuildPoseMatrices(nlMatrix4* poseMatrices, const nlMatrix4* boneMatrices, const Pose& pose)
+{
+    for (int i = 0; i < pose.GetNumNodes(); i++)
+    {
+        nlMultMatrices(poseMatrices[i], boneMatrices[i], pose.GetNodeMatrix(i));
+    }
+}
+inline void SkinCopyPoseMatrix(float (&destination)[3][4], const nlMatrix4& pose)
+{
+    glxCopyMatrix(destination, pose);
+}
+#endif
