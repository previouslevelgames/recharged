+// AI script VM stack words are Wii 32-bit. Address-bearing words use the
+// cached SDK word transport; numeric/float words and all control stay 32-bit.
+#if defined(MSCHARGED_NATIVE)
+#include "platform/vm_address_abi.h"
+#define MSCHARGED_FUZZY_VM_POINTER(Type, word) static_cast<Type*>(mscharged::platform::DecodeVMAddress(word))
+#define MSCHARGED_FUZZY_VM_WORD(pointer) mscharged::platform::EncodeVMAddress(pointer)
+// The retail no-op and identity natives never dereference their pointer-typed
+// parameter and scripts pass arbitrary words through them: carry the word.
+#define MSCHARGED_FUZZY_VM_OPAQUE(Type, word) reinterpret_cast<Type*>(static_cast<std::uintptr_t>(word))
+#define MSCHARGED_FUZZY_VM_OPAQUE_WORD(pointer) static_cast<u32>(reinterpret_cast<std::uintptr_t>(pointer))
+#else
+#define MSCHARGED_FUZZY_VM_POINTER(Type, word) (Type*)(word)
+#define MSCHARGED_FUZZY_VM_WORD(pointer) (u32)(pointer)
+#define MSCHARGED_FUZZY_VM_OPAQUE(Type, word) (Type*)(word)
+#define MSCHARGED_FUZZY_VM_OPAQUE_WORD(pointer) (u32)(pointer)
+#endif
 extern "C" unsigned long FuzzyAIStringHash(const char* value)
 {
     return nlStringHash(value);
