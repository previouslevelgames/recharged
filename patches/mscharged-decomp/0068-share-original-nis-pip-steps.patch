Subject: Share original NIS picture-in-picture rectangles, timing and target settings

Upstream-base: 9f985f9aca654d7ec13ff894830f19aeb3f7aefd

Share the original fixed/expanding rectangles, strict expansion completion and
camera-swap decisions without selecting Holotron or full NisPlayer dependencies.
The selected native owner applies checked finite deltas and retained camera swaps.
Keep the original RGB565 target descriptor and viewport dimensions source-shared.
Console callers retain the same equations, callback order and target settings.

diff --git a/include/Game/Render/NisPipSteps.h b/include/Game/Render/NisPipSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/Render/NisPipSteps.h
@@ -0,0 +1,48 @@
+#ifndef GAME_RENDER_NIS_PIP_STEPS_H
+#define GAME_RENDER_NIS_PIP_STEPS_H
+
+struct NisPipRectData
+{
+    float x, y, width, height;
+};
+
+inline NisPipRectData NisPipFixedRectangle()
+{
+    NisPipRectData rectangle = { 360.0f, 270.0f, 240.0f, 150.0f };
+    return rectangle;
+}
+
+inline NisPipRectData NisPipExpandedRectangle(float time, float duration)
+{
+    float u;
+    float t = time / duration;
+    u = 1.0f - t;
+    NisPipRectData rectangle = { 360.0f * u, 270.0f * u,
+        640.0f * t + 240.0f * u, 480.0f * t + 150.0f * u };
+    return rectangle;
+}
+
+template <class Player>
+int AdvanceNisPipSwap(Player* player)
+{
+    player->SwapCameras();
+    return 1;
+}
+
+template <class Player>
+int AdvanceNisPipExpansion(Player* player, float& time, float duration, float dt)
+{
+    time += dt;
+    if (time <= duration)
+    {
+        return 3;
+    }
+
+    player->SwapCameras();
+    return 0;
+}
+
+const unsigned NisPipViewportWidth = 0x200;
+const unsigned NisPipViewportHeight = 0x100;
+
+#endif // GAME_RENDER_NIS_PIP_STEPS_H
