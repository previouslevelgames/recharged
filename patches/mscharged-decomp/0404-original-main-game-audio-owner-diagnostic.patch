From: mscharged-port
Subject: [PATCH] original main GameAudio owner diagnostic admission
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Admit only the original placement-new owner request at its original main
Initialize position under an explicit selected-source macro. Initialization,
bundle loading, audio tasks and playback remain outside this owner-only gate.
Console, ordinary native and prior diagnostics keep identical tokens.

diff --git a/src/Game/main.cpp b/src/Game/main.cpp
index 276aa9b..93dcb02 100644
--- a/src/Game/main.cpp
+++ b/src/Game/main.cpp
@@ -626,9 +626,11 @@ static void Initialize()
 #if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP) || defined(MSCHARGED_DIAGNOSTIC_MAIN_INPUT)
     InitPlatPad();
 #endif
-#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP)
+#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP) || defined(MSCHARGED_DIAGNOSTIC_GAME_AUDIO_OWNER)
     g_pGameAudio = new (nlMalloc(sizeof(GameAudio), 8, false))
         GameAudio;
+#endif
+#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP)
     g_pGameAudio->Initialize();
     gSwappablePadChanged.Add(Function<void(int)>(ConfigureTweakerButtons), 0, -1);
     g_pPadManager->Update(0.0f);
