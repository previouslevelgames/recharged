+#ifndef GAME_FE_FRONTEND_MAIN_DEPARTURE_STEPS_H
+#define GAME_FE_FRONTEND_MAIN_DEPARTURE_STEPS_H
+// Original SHMainMenu::ApplyItem case6, in source service order. Other menu
+// selections and complete game/save readiness remain separate services.
+template<class Pop, class Hide, class Audio, class Next, class Call>
+void FrontendMainApplyOptions(Pop pop, Hide hide, Audio play, Next next, Call call)
+{
+    pop();
+    hide();
+    play(0xB19DBC20, 0, 0, true);
+    next("TransitionMainMenuToOptions");
+    call("TransitionFromMainMenu");
+}
+#endif
