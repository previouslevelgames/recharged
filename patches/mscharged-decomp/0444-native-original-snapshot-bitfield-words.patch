Subject: [PATCH] Preserve original snapshot and ball packed-word bit positions natively
Upstream-base: 2c5c51e483b652d178ef06a44b83b07a0f97d2a6

Reverse only little-endian native bitfield declaration order. Retain original
32-bit raw masks, field widths, methods, replay word and unused bits. Console
and big-endian declarations stay unchanged. No missing source is supplied.

diff --git a/include/Game/RenderSnapshot.h b/include/Game/RenderSnapshot.h
--- a/include/Game/RenderSnapshot.h
+++ b/include/Game/RenderSnapshot.h
@@ -23,6 +23,19 @@
     u32 raw;
     struct
     {
+#if defined(MSCHARGED_NATIVE) && (defined(_WIN32) || (defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__))
+        u32 reserved : 22;
+        u32 thwomps : 1;
+        u32 windDebris : 1;
+        u32 diddyBanana : 1;
+        u32 daisyFists : 1;
+        u32 birdoEgg : 1;
+        u32 koopaShell : 1;
+        u32 bulletBills : 1;
+        u32 hammers : 1;
+        u32 flyingCameras : 1;
+        u32 yoshiEgg : 1;
+#else
         u32 yoshiEgg : 1;
         u32 flyingCameras : 1;
         u32 hammers : 1;
@@ -34,6 +47,7 @@
         u32 windDebris : 1;
         u32 thwomps : 1;
         u32 reserved : 22;
+#endif
     } bits;
 };
 
diff --git a/include/Game/Drawable/DrawableBall.h b/include/Game/Drawable/DrawableBall.h
--- a/include/Game/Drawable/DrawableBall.h
+++ b/include/Game/Drawable/DrawableBall.h
@@ -38,6 +38,16 @@
     unsigned int value;
     struct
     {
+#if defined(MSCHARGED_NATIVE) && (defined(_WIN32) || (defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__))
+        // Retain the original packed replay word, including unused bits.
+        u32 unused : 7;
+        u32 passTargetIndex : 5;
+        u32 previousOwnerIndex : 5;
+        u32 ownerIndex : 5;
+        u32 lastTouchIndex : 5;
+        u32 transient : 4;
+        u32 visible : 1;
+#else
         u32 visible : 1;
         u32 transient : 4;
         u32 lastTouchIndex : 5;
@@ -45,6 +55,7 @@
         u32 previousOwnerIndex : 5;
         u32 passTargetIndex : 5;
         u32 unused : 7;
+#endif
     } bits;
 };
 
