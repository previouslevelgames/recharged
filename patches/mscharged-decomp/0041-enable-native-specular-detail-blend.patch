 {
+static const GXLightID sSpecularLightIDs[2] = { GX_LIGHT6, GX_LIGHT7 };
+
 static const GXLightID sGameObjectLightIDs[6] = {
     GX_LIGHT0, GX_LIGHT1, GX_LIGHT2, GX_LIGHT3, GX_LIGHT4, GX_LIGHT5,
 };
