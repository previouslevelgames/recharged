From: mscharged-port
Subject: [PATCH] Preserve native FlyingCamera event owner pointer width
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Classification: permanent native pointer ABI.
Three original event registration owners are addresses of the genuine
source connections. Carry them through the already qualified native
EventOwnerHandle rather than narrowing to the Wii32 unsigned type.
Original branch order, event functions, owner identities, reset and
cleanup decisions are untouched. Console source tokens are identical.

diff --git a/src/Game/Render/FlyingCamera.cpp b/src/Game/Render/FlyingCamera.cpp
index f278b5a..22a0a1a 100644
--- a/src/Game/Render/FlyingCamera.cpp
+++ b/src/Game/Render/FlyingCamera.cpp
@@ -304,15 +304,27 @@ void SetFlyingCameraCount(int count, cFielder* fielder, float orbitRadius)
     {
         if (gPeachCameraFlashConnection.mOwner == 0)
         {
+#if defined(MSCHARGED_NATIVE)
+            FindEvent<void>(sPeachCameraFlashEventName, -1)->Add(Function<void*>(OnPeachCameraFlash), (EventOwnerHandle)&gPeachCameraFlashConnection, -1);
+#else
             FindEvent<void>(sPeachCameraFlashEventName, -1)->Add(Function<void*>(OnPeachCameraFlash), (unsigned int)&gPeachCameraFlashConnection, -1);
+#endif
         }
         if (gResetEffectsConnection.mOwner == 0)
         {
+#if defined(MSCHARGED_NATIVE)
+            FindEvent<void>(sResetEffectsEventName, -1)->Add(Function<void*>(OnResetFlyingCameras), (EventOwnerHandle)&gResetEffectsConnection, -1);
+#else
             FindEvent<void>(sResetEffectsEventName, -1)->Add(Function<void*>(OnResetFlyingCameras), (unsigned int)&gResetEffectsConnection, -1);
+#endif
         }
         if (gMegaStrikeMeterEndConnection.mOwner == 0)
         {
+#if defined(MSCHARGED_NATIVE)
+            FindEvent<void>(sMegaStrikeMeterEndEventName, -1)->Add(Function<void*>(OnResetFlyingCameras), (EventOwnerHandle)&gMegaStrikeMeterEndConnection, -1);
+#else
             FindEvent<void>(sMegaStrikeMeterEndEventName, -1)->Add(Function<void*>(OnResetFlyingCameras), (unsigned int)&gMegaStrikeMeterEndConnection, -1);
+#endif
         }
     }
 }
