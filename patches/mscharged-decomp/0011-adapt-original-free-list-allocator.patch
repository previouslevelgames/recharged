+static void ValidateNativeRequest(unsigned long size, unsigned int alignment)
+{
+    if (alignment == 0 || (alignment & (alignment - 1)) != 0)
+        throw std::invalid_argument("Game allocation alignment must be a nonzero power of two");
+    if (size > 0x3FFFFFFFu)
+        throw std::bad_alloc();
+}
+#else
+static const u32 kBlockAlignment = 4;
+static const u32 kAllocationPrefix = 4;
+#endif
