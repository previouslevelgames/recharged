From: mscharged-port
Subject: Narrow online player count button contexts natively
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84
Classification: native compiler/ABI compatibility

SHOnlinePlayerCount stores each button's index in its void* context and
reads it back with (unsigned int)context. A 64-bit host rejects that cast
from a pointer to a smaller integer. Natively the index goes through
std::uintptr_t; the values are unchanged.

diff --git a/src/Game/SH/SHOnlinePlayerCount.cpp b/src/Game/SH/SHOnlinePlayerCount.cpp
index 2ed46a1..dc73b23 100644
--- a/src/Game/SH/SHOnlinePlayerCount.cpp
+++ b/src/Game/SH/SHOnlinePlayerCount.cpp
@@ -1,3 +1,6 @@
+#if defined(MSCHARGED_NATIVE)
+#include <cstdint>
+#endif
 #include "NL/nlSingleton.inl"
 #include "NL/nlFunction.inl"
 #include "Game/SH/SHOnlinePlayerCount.h"
@@ -41,7 +44,11 @@ SHOnlinePlayerCount::SHOnlinePlayerCount(int mode)
     mButtonCount = 2;
     for (int i = 0; i < mButtonCount; ++i)
     {
+#if defined(MSCHARGED_NATIVE)
+        mButtons[i].mContext = reinterpret_cast<void*>(static_cast<std::uintptr_t>(i));
+#else
         mButtons[i].mContext = (void*)i;
+#endif
     }
 
     mPointerInsideCount[0] = 0;
@@ -217,7 +224,11 @@ void SHOnlinePlayerCount::InitializeButtons()
 
