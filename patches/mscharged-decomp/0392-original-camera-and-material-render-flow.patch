Subject: [PATCH] Restore original game camera and material view decisions
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Use the original view and active game camera in game-module rendering. Restore
source light-texture requests and specular cache values; restrict standalone
preview validation/helpers to their existing diagnostics. Preserve original
matrix, lighting, visibility and draw decisions and native SDK/ABI transport.

diff --git a/src/NL/glx/GXCameraScrolledOverlayMaterialProgramRender.cpp b/src/NL/glx/GXCameraScrolledOverlayMaterialProgramRender.cpp
index c3c97a8..0dd8485 100644
--- a/src/NL/glx/GXCameraScrolledOverlayMaterialProgramRender.cpp
+++ b/src/NL/glx/GXCameraScrolledOverlayMaterialProgramRender.cpp
@@ -1,7 +1,9 @@
 #if defined(MSCHARGED_NATIVE)
 #include <dolphin/gx.h>
 #include <dolphin/mtx.h>
+#if !defined(MSCHARGED_GAME_MODULE)
 #include "runtime/material_environment.h"
+#endif
 #include <cmath>
 #include <stdexcept>
 #else
@@ -10,7 +12,7 @@
 #include "Game/GameObjectLighting.h"
 #include "NL/gl/glMaterialParameters.h"
 
-#if !defined(MSCHARGED_NATIVE)
+#if !defined(MSCHARGED_NATIVE) || defined(MSCHARGED_GAME_MODULE)
 #include "Game/Camera/CameraMan.h"
 #endif
 #include "NL/gl/glView.h"
@@ -61,7 +63,7 @@ void GXMaterialProgramImpl<GXCameraScrolledOverlayMaterialProgram>::Activate(GLV
 {
     static_cast<GXCameraScrolledOverlayMaterialProgram*>(this)->ConfigureVertexFormat(true);
     glxConfigureCameraScrolledOverlay();
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     sCameraOverlayViewMatrix = mscharged::MaterialPreviewView();
 #else
     view->m_Interface->GetViewMatrix(sCameraOverlayViewMatrix);
@@ -110,7 +112,7 @@ void GXMaterialProgramImpl<GXCameraScrolledOverlayMaterialProgram>::Draw(
     static_cast<GXCameraScrolledOverlayMaterialProgram*>(this)->BindVertexArrays(packet);
     static_cast<GXCameraScrolledOverlayMaterialProgram*>(this)->BindParameters(packet);
 
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     const nlVector3& cameraPosition = mscharged::MaterialPreviewCameraPosition();
 #else
     const nlVector3& cameraPosition = cCameraManager::PeekCamera()->GetCameraPosition();
@@ -130,7 +132,7 @@ void GXMaterialProgramImpl<GXCameraScrolledOverlayMaterialProgram>::Draw(
     textureMatrix[2][2] = 1.0f;
     textureMatrix[0][3] += 0.5f - cameraScroll * (cameraPosition.x * inverseScale);
     textureMatrix[1][3] += 0.5f - cameraScroll * (cameraPosition.y * inverseScale);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     for (const auto& row : textureMatrix)
         for (float value : row)
             if (!std::isfinite(value))
