-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     sMaskedDetailBlendViewMatrix = mscharged::MaterialPreviewView();
 #else
     view->m_Interface->GetViewMatrix(sMaskedDetailBlendViewMatrix);
@@ -111,7 +113,7 @@ void GXMaterialProgramImpl<GXMaskedDetailBlendMaterialProgram>::Activate(GLView*
     LoadGameObjectLights(sMaskedDetailBlendLightCount, view, 0);
     gxSetNumChans(1);
 
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     if (ShouldUseGameObjectLightTexture(0))
     {
 #endif
@@ -126,7 +128,7 @@ void GXMaterialProgramImpl<GXMaskedDetailBlendMaterialProgram>::Activate(GLView*
     texture.SetWrapT(true);
     texture.unknown07 = 0;
     glx_BindTexture(3, &texture);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
