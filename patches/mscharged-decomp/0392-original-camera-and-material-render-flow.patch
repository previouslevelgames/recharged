Subject: [PATCH] Restore original game camera and material view decisions
Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090

Use the original view and active game camera in game-module rendering. Restore
source light-texture requests and specular cache values; restrict standalone
preview validation/helpers to their existing diagnostics. Preserve original
matrix, lighting, visibility and draw decisions and native SDK/ABI transport.

--- a/src/NL/glx/GXSpecularDetailBlendMaterialProgramRender.cpp
+++ b/src/NL/glx/GXSpecularDetailBlendMaterialProgramRender.cpp
@@ -1,6 +1,8 @@
 #if defined(MSCHARGED_NATIVE)
 #include <dolphin/gx.h>
+#if !defined(MSCHARGED_GAME_MODULE)
 #include "runtime/material_environment.h"
+#endif
 #else
 #include <revolution/gx.h>
 #endif
@@ -85,14 +87,14 @@
 {
     sSpecularDetailBlendLightingMode = LIGHTING_UNCONFIGURED;
     static_cast<GXSpecularDetailBlendMaterialProgram*>(this)->ConfigureVertexFormat(true);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     sSpecularDetailBlendViewMatrix = mscharged::MaterialPreviewView();
 #else
     view->m_Interface->GetViewMatrix(sSpecularDetailBlendViewMatrix);
 #endif
     sSpecularDetailBlendLightCount = GetGameObjectLightCount(0, 1);
     LoadGameObjectLights(sSpecularDetailBlendLightCount, view, 0);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     // A new view may have different lights even when the exponent is zero.
     sSpecularDetailBlendSpecularExponent = -1.0f;
 #else
