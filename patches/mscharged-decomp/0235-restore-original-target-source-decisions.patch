     if (!nativeTargetsLive || !name || !*name || !targetInfo || strlen(name) > 120 || !strcmp(name, "backbuffer"))
         throw std::invalid_argument("Invalid GL target name, description or lifetime");
 #else
@@ -105,15 +105,15 @@
 
     GLRenderPair result = FindOrCreateTarget(hash, targetInfo);
 
-#if !defined(MSCHARGED_NATIVE)
-    glEndResource(); // Native targets own independent resource pools.
