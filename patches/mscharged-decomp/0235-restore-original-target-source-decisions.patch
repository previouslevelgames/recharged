From: mscharged-port native source preparation
Subject: [PATCH] Restore original target source decisions outside diagnostics
Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090
Classification: original-source fidelity correction; legacy checks diagnostic-only.

diff --git a/include/NL/gl/glTarget.h b/include/NL/gl/glTarget.h
--- a/include/NL/gl/glTarget.h
+++ b/include/NL/gl/glTarget.h
@@ -4,7 +4,7 @@
 #include "types.h"
 
 class GLXTarget;
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_DIAGNOSTIC_VIEWS)
 #include <stdint.h>
 uint64_t glNativeTargetGeneration(const GLXTarget* target);
 #endif
@@ -30,7 +30,7 @@
         : unknown08(0)
         , unknown0C(0)
     {
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_DIAGNOSTIC_VIEWS)
         height = width = clearFlags = clearDepthSetting = unknown20 = 0;
         unknown10 = GLTargetInfoMode10_0;
         format = GLTargetFormat_RGB5A3;
@@ -55,7 +55,7 @@
     u32 hash;
     GLXTarget* target;
 
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_DIAGNOSTIC_VIEWS)
     uint64_t nativeGeneration = 0;
 #endif
     GLRenderPair()
@@ -67,7 +67,7 @@
     GLRenderPair(u32 targetHash, GLXTarget* platformTarget)
         : hash(targetHash)
         , target(platformTarget)
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_DIAGNOSTIC_VIEWS)
         , nativeGeneration(platformTarget ? glNativeTargetGeneration(platformTarget) : 0)
 #endif
     {
@@ -80,7 +80,7 @@
 };
 
 void gl_TargetStartup();
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_DIAGNOSTIC_VIEWS)
 void gl_TargetShutdown();
 void glValidateTarget(GLRenderPair target);
 #endif
