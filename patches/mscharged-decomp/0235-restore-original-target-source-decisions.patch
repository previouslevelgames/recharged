             throw std::invalid_argument("Existing GL target has a different size or format");
@@ -50,13 +50,13 @@
     GLXTarget* platformTarget = glplatCreateTarget(targetInfo);
     if (platformTarget != 0)
     {
-#if defined(MSCHARGED_NATIVE)
