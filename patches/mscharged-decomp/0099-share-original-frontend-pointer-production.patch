diff --git a/include/Game/FE/FrontendPointerHostSteps.h b/include/Game/FE/FrontendPointerHostSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendPointerHostSteps.h
@@ -0,0 +1,40 @@
+#ifndef FRONTEND_POINTER_HOST_STEPS_H
+#define FRONTEND_POINTER_HOST_STEPS_H
+#include "NL/nlMath.h"
+
+// Original feDPD arithmetic. The desktop adapter supplies an explicit absolute
+// mouse policy, never a fabricated Wii DPDData/backend class.
+inline nlVector2 FrontendClampPointerPosition(nlVector2 position, int width, int height)
+{
+    nlVector2 result;
+    int maxX = width / 2 - 20;
+    int minX = -width / 2 + 20;
+    int maxY = height / 2 - 5;
+    int minY = -height / 2 + 5;
+
+    if (position.x <= maxX && position.x >= minX)
+        result.x = position.x;
+    else
+        result.x = (float)(position.x > maxX ? maxX : minX);
+
+    if (position.y <= maxY && position.y >= minY)
+        result.y = position.y;
+    else
+        result.y = (float)(position.y > maxY ? maxY : minY);
+    return result;
+}
+inline void FrontendDPDToAssetPosition(nlVector2& position, int width, int height)
+{
+    position.x = -1.0f * (position.x * (float)width / 2.0f);
+    position.y = position.y * (float)height / 2.0f;
+}
+// Source ordering is observable: position first, action30 JustPressed second.
+// Constructor defaults for Released/Unidentified remain untouched.
+template<class Event, class Source>
+void FrontendOptionsPointerEvent(Event& event, int index, Source& source)
+{
+    event.mIndex = index;
+    event.mPosition = source.Position(index);
+    event.mPressed = source.JustPressed(index);
+}
+#endif
