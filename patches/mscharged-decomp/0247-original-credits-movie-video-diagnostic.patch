Subject: [PATCH] Enable named original Credits movie/video diagnostic
Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a
Classification: temporary owner-authorized diagnostic flow scope only

The selected scene diagnostic retains actual phase2 parent MoviePlayer Update,
original movie requests/Config/FE image handling, and the fifth genuine movie
material constructor. Named diagnostic THPSimple mode0 uses native AI while
the normal original mode1/AX predecessor remains held and unchanged. Existing
unrelated E3/GameInfo/HBM/world/phase3 transition omissions remain explicit.
No extra assets, fabricated readiness, clock or game algorithm is supplied.

diff --git a/src/Game/SH/SHCredits.cpp b/src/Game/SH/SHCredits.cpp
--- a/src/Game/SH/SHCredits.cpp
+++ b/src/Game/SH/SHCredits.cpp
@@ -278,7 +278,7 @@
 
 void CreditScene::UpdateForCredits(float fDeltaT)
 {
-#if !defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE)
+#if !defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE) || defined(MSCHARGED_DIAGNOSTIC_CREDITS_MOVIE)
     MoviePlayerScene::Update(fDeltaT);
 #endif
 
diff --git a/src/Game/SH/SHMoviePlayer.cpp b/src/Game/SH/SHMoviePlayer.cpp
--- a/src/Game/SH/SHMoviePlayer.cpp
+++ b/src/Game/SH/SHMoviePlayer.cpp
@@ -26,7 +26,7 @@
 #include "Game/Task/GameRenderTask.h"
 #include "Game/main.h"
 
-#if !defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE)
+#if !defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE) || defined(MSCHARGED_DIAGNOSTIC_CREDITS_MOVIE)
 Config gMovieConfig(Config::ALLOCATE_HIGH, 0x2800, 0x400);
 #endif
 
@@ -85,15 +85,17 @@
 
 void MoviePlayerScene::Update(float fDeltaT)
 {
-#if defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE)
+#if defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE) && !defined(MSCHARGED_DIAGNOSTIC_CREDITS_MOVIE)
     throw std::logic_error("Credits diagnostic attempted excluded movie/transition flow");
 #else
     BaseSceneHandler::Update(fDeltaT);
+#if !defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE)
     if (g_e3_Build)
     {
         OnMoviePlaybackEnded();
         return;
     }
+#endif
     if (!mMovieStarted)
     {
         mMovieStarted = MovieStart(mMovieFilename, false, mLoopMovie, SCGetSoundMode() == 0);
@@ -115,10 +117,12 @@
         int fadeIn = GetConfigInt(gMovieConfig, configKey, 500);
         THPSimpleSetVolume(0, 0);
         THPSimpleSetVolume((int)(127.0f * volume), fadeIn);
+#if !defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE)
         if (GameInfoManager::Instance()->mIsInStrikers101Mode)
         {
             g_bRenderWorld = false;
         }
+#endif
     }
     if (!mMovieStarted || CheckMoviePlayerAbort())
     {
@@ -147,7 +151,7 @@
 
 bool MoviePlayerScene::CheckMoviePlayerAbort()
 {
-#if defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE)
+#if defined(MSCHARGED_DIAGNOSTIC_CREDITS_SCENE) && !defined(MSCHARGED_DIAGNOSTIC_CREDITS_MOVIE)
     throw std::logic_error("Credits diagnostic attempted excluded input/movie flow");
 #else
     return g_pFEInput->JustPressed(FE_ALL_PADS, 0x1E, true, 0);
diff --git a/src/Game/Sys/movie.cpp b/src/Game/Sys/movie.cpp
--- a/src/Game/Sys/movie.cpp
+++ b/src/Game/Sys/movie.cpp
@@ -65,7 +65,12 @@
         return true;
     }
 
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_CREDITS_MOVIE)
+    // Named source movie diagnostic while the genuine AX predecessor is held.
+    THPSimpleInit(0);
+#else
     THPSimpleInit(1);
+#endif
     g_bTHPInitialized = true;
     return true;
 #endif
