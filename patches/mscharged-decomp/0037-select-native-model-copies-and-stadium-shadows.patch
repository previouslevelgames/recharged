+// Original StadiumShadowVolumeDrawable model duplication and Draw body.
+// WorldDrawable initialization / world object deserialization are not selected.
+#include "Game/Render/ShadowVolume.h"
+#include "Game/Render/RLViewLayers.h"
+#include "NL/gl/glModel.h"
+#include "NL/gl/glMemory.h"
+
+void InitializeNativeStadiumShadowModels(glModel* model, glModel** m_pShadowModels, GLResourcePool* pool)
+{
+    for (int modelIndex = 0; modelIndex < 2; modelIndex++)
+    {
+        m_pShadowModels[modelIndex]
+            = glModelDupNoStreams(model, true, pool);
+    }
+}
+
+void DrawNativeStadiumShadowModels(glModel* const* m_pShadowModels)
+{
+    AttachShadowVolumeModels(m_pShadowModels[0], m_pShadowModels[1],
+        (GLView*)GetLayerView(eCLV_ShadowVolume), (GLView*)GetLayerView(eCLV_ShadowVolume));
+    ShowLayerView(eCLV_ShadowVolume);
+    ShowLayerView(eCLV_ShadowVolumeBlend);
+}
