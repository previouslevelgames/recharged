new file mode 100644
--- /dev/null
+++ b/src/Game/Render/StadiumShadowNative.cpp
@@ -0,0 +1,23 @@
+// Original StadiumShadowVolumeDrawable model duplication and Draw body.
+// WorldDrawable initialization / world object deserialization are not selected.
+#include "Game/Render/ShadowVolume.h"
+#include "Game/Render/RLViewLayers.h"
+#include "NL/gl/glModel.h"
+#include "NL/gl/glMemory.h"
+
+void InitializeNativeStadiumShadowModels(glModel* model, glModel** m_pShadowModels, GLResourcePool* pool)
+{
+    for (int modelIndex = 0; modelIndex < 2; modelIndex++)
+    {
+        m_pShadowModels[modelIndex]
+            = glModelDupNoStreams(model, true, pool);
+    }
+}
+
+void DrawNativeStadiumShadowModels(glModel* const* m_pShadowModels)
+{
+    AttachShadowVolumeModels(m_pShadowModels[0], m_pShadowModels[1],
+        (GLView*)GetLayerView(eCLV_ShadowVolume), (GLView*)GetLayerView(eCLV_ShadowVolume));
+    ShowLayerView(eCLV_ShadowVolume);
+    ShowLayerView(eCLV_ShadowVolumeBlend);
+}
diff --git a/src/NL/gl/glModelCopies.cpp b/src/NL/gl/glModelCopies.cpp
new file mode 100644
--- /dev/null
+++ b/src/NL/gl/glModelCopies.cpp
@@ -0,0 +1,142 @@
+// Transitional ScenePreview-only copy of the original glModel duplication bodies.
+// Production builds select whole glModel.cpp, which retains these bodies directly.
+#include "NL/gl/glModel.h"
+#include "NL/gl/gl.h"
+#include "NL/gl/glMaterialProgram.h"
+#include "NL/gl/glMemory.h"
+#include <string.h>
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_MODELS)
+#include <stdexcept>
+#endif
+
+glModel* glModelDupArrayNoStreams(
+    const glModel* pModelArray, unsigned long nModels, bool bPermanent,
+    void* pAllocator)
+{
+    glModel* result;
+    glModelPacket* new_packets;
+    void* data;
+    void* source;
+    unsigned long dataSize;
+    glModelPacket* sourcePackets;
+    glModel* dst_model;
+    unsigned long packetOffset;
+    unsigned long size;
+    unsigned long packetSize;
+    unsigned long j;
+    glModelPacket* packet;
+    GLMaterialProgram* materialProgram;
+    unsigned long numPackets;
+    int i;
+
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_MODELS)
+    // Validate before allocating. The caller owns the destination pool/marker;
+    // streams and indices remain borrowed from the source resource.
+    if (!pModelArray || !nModels || nModels > 4096 || (!bPermanent && pAllocator))
+        throw std::invalid_argument("Invalid native model clone array/allocator");
+    if (bPermanent)
+    {
+        GLResourcePool* selected = pAllocator ? static_cast<GLResourcePool*>(pAllocator) : glGetCurrentResourcePool();
+        GLResourcePool* pool = glGetResourcePools();
+        while (pool && pool != selected) pool = pool->m_next;
+        if (!pool) throw std::invalid_argument("Native model clone needs a live resource pool");
+    }
+    unsigned long totalPackets = 0;
+    for (unsigned long m = 0; m < nModels; ++m)
+    {
+        const glModel& model = pModelArray[m];
+        if (!model.numPackets || model.numPackets > 4096 - totalPackets || !model.packets)
+            throw std::invalid_argument("Invalid native model clone packet count");
+        totalPackets += model.numPackets;
+        for (unsigned long p = 0; p < model.numPackets; ++p)
+        {
+            const glModelPacket& packet = model.packets[p];
+            const GLMaterialProgram* program = static_cast<const GLMaterialProgram*>(packet.materialProgram);
+            if (!program || glGetMaterialProgram(program->programHash) != program || !packet.materialParameters
+                || !program->parameterDataSize || program->parameterDataSize > 4096
+                || packet.displayList || packet.skinnedVertices || packet.skinnedNormals)
+                throw std::invalid_argument("Native clone requires a registered static material without Wii display lists");
+        }
+    }
+#endif
+#if !defined(MSCHARGED_NATIVE) || defined(MSCHARGED_GAME_MODULE)
+    glBeginResource(pModelArray->id);
+#endif
+
+    if (bPermanent)
+    {
+        size = nModels * sizeof(glModel);
+        result = (glModel*)glResourceAlloc(size, GLM_Header, pAllocator);
+    }
+    else
+    {
+        size = nModels * sizeof(glModel);
+        result = (glModel*)glFrameAlloc(size, GLM_Header);
+    }
+
+    memcpy(result, pModelArray, size);
+
+    dst_model = result;
+    i = 0;
+    while (i < (int)nModels)
+    {
+        numPackets = dst_model->numPackets;
+        sourcePackets = dst_model->packets;
+        if (bPermanent)
+        {
+            packetSize = numPackets * sizeof(glModelPacket);
+            new_packets = (glModelPacket*)glResourceAlloc(
+                packetSize, GLM_Header, pAllocator);
+        }
+        else
+        {
+            packetSize = numPackets * sizeof(glModelPacket);
+            new_packets = (glModelPacket*)glFrameAlloc(
+                packetSize, GLM_Header);
+        }
+
+        memcpy(new_packets, sourcePackets, packetSize);
+        dst_model->packets = new_packets;
+
+        j = 0;
+        packetOffset = 0;
+        while (j < dst_model->numPackets)
+        {
+            packet = (glModelPacket*)((u8*)dst_model->packets + packetOffset);
+            materialProgram = static_cast<GLMaterialProgram*>(packet->materialProgram);
+            source = packet->materialParameters;
+            dataSize = materialProgram->parameterDataSize;
+            if (bPermanent)
+            {
+                data = glResourceAlloc(dataSize, GLM_Header, pAllocator);
+            }
+            else
+            {
+                data = glFrameAlloc(dataSize, GLM_Header);
+            }
+
+            memcpy(data, source, dataSize);
+            packet->materialParameters = data;
+            glplatOnPacketCloned(
+                (glModelPacket*)((u8*)dst_model->packets + packetOffset),
+                pAllocator);
+
+            packetOffset += sizeof(glModelPacket);
+            ++j;
+        }
+
+        ++dst_model;
+        ++i;
+    }
+
+#if !defined(MSCHARGED_NATIVE) || defined(MSCHARGED_GAME_MODULE)
+    glEndResource();
+#endif
+    return result;
+}
+
+glModel* glModelDupNoStreams(
+    const glModel* pModel, bool bPermanent, void* pAllocator)
+{
+    return glModelDupArrayNoStreams(pModel, 1, bPermanent, pAllocator);
+}
