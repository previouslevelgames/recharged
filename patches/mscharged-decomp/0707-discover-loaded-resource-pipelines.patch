+void EnumerateAutomaticTemplate(const EffectsTemplate* effect,
+                                const EffectsSpec* spec, bool requireModels)
+{
+    if (effect == nullptr)
+        throw std::runtime_error("Missing authored effect template during graphics preparation");
+    const glModel* model = nullptr;
+    if (effect->m_uModelID != 0xFFFFFFFFu && !(spec && spec->m_bLight)) {
+        if (gEffectsModelInventory != nullptr) {
+            GLVertexAnim* animation = gEffectsModelInventory->GetVertexAnim(effect->m_uModelID);
+            model = animation ? animation->m_pModel
+                              : gEffectsModelInventory->GetModel(effect->m_uModelID);
+        }
+        if (model == nullptr) {
+            if (requireModels)
+                throw std::runtime_error("Authored effect model is absent from completed graphics resources");
+            return; // Geometry may finish after its effects bundle.
+        }
+    }
+    EnumerateAutomaticParticlePipelines(*effect, spec, model);
+}
+
+void EnumerateAutomaticEffectRing(EffectsBundle* bundles, bool requireModels)
+{
+    if (bundles == nullptr) return;
+    EffectsBundle* bundle = nlDLRingGetStart(bundles);
+    for (;; bundle = bundle->m_next) {
+        for (nlListIterator<EffectsBundleData*> it = bundle->mInventory.Begin();
+             it.IsValid(); it.Next()) {
+            const EffectsBundleData* data = it.Current();
+            // Child/death-code-only templates are included even when no
+            // controller has instantiated them in this or any previous match.
+            for (unsigned i = 0; i != data->mNumTemplates; ++i)
+                EnumerateAutomaticTemplate(data->mTemplates[i], nullptr, requireModels);
+            for (int i = 0; i != data->mNumGroups; ++i) {
+                const EffectsGroup* group = data->mGroups[i];
+                for (unsigned j = 0; j != group->m_numSpecs; ++j) {
+                    const EffectsSpec* spec = &group->m_specs[j];
+                    EnumerateAutomaticTemplate(spec->m_pTemplate, spec, requireModels);
+                }
+                // The retail parser stores null for unregistered factories;
+                // those render nothing. A real custom rendering implementation
+                // must expose its own descriptor before claiming coverage.
+                for (unsigned j = 0; j != group->m_userSpecs; ++j)
+                    if (group->m_userSpecsPtr != nullptr && group->m_userSpecsPtr[j] != nullptr)
+                        throw std::runtime_error("Custom effect renderer lacks graphics preparation metadata");
+            }
+        }
+        if (nlDLRingIsEnd(bundles, bundle)) break;
+    }
+}
+} // namespace
+
+void EnumerateAutomaticEffectResources(bool requireModels)
+{
+    EnumerateAutomaticEffectRing(gEffectsBundleManager.mDefaultBundles, requireModels);
+    EnumerateAutomaticEffectRing(gEffectsBundleManager.mAdditionalBundles, requireModels);
+}
+} // namespace mscharged::platform
+#endif
