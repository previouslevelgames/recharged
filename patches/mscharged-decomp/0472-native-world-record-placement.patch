diff --git a/src/Game/BasicStadium.cpp b/src/Game/BasicStadium.cpp
--- a/src/Game/BasicStadium.cpp
+++ b/src/Game/BasicStadium.cpp
@@ -1,5 +1,8 @@
 #include "Game/Task/GameTaskState.h"
 #include "NL/nlDLListContainer.inl"
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/world_record_storage.h"
+#endif
 #include "Game/BasicStadium.h"
 #include "Game/Render/StadiumWorldObjects.h"
 #include "Game/Render/StadiumPhysicsObject.h"
@@ -39,7 +42,11 @@
 static inline DrawableObject* LoadStadiumObject(WorldObjectLoadContext* context,
     unsigned long recordSize)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    T* object = mscharged::platform::PrepareWorldRecord<T>(context->m_pObject);
+#else
     T* object = (T*)context->m_pObject;
+#endif
     new (object) T;
     object->Initialize(context);
     context->m_pObject += recordSize;
