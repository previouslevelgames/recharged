 void RLGReader::LoadStreams(void* data, unsigned long size)
 {
     m_numStreamEntries = size >> 3;
+#if defined(MSCHARGED_NATIVE)
+    m_pStreamData = glResourceAlloc(mscharged::platform::RLGNativeRecordBytes(
+        size, mscharged::platform::RLGStreamBytes, sizeof(glModelStream)), GLM_Header, m_pResource);
+    mscharged::platform::DecodeRLGStreams(static_cast<glModelStream*>(m_pStreamData),
+        data, m_numStreamEntries);
+#else
     m_pStreamData = glResourceAlloc(size, GLM_Header, m_pResource);
     memcpy(m_pStreamData, data, m_numStreamEntries << 3);
+#endif
 }
 
 void RLGReader::LoadPackets(void* data, unsigned long size)
 {
+#if defined(MSCHARGED_NATIVE)
+    m_numPacketEntries = size / mscharged::platform::RLGPacketBytes;
+    m_pPackets = glResourceAlloc(mscharged::platform::RLGNativeRecordBytes(
+        size, mscharged::platform::RLGPacketBytes, sizeof(glModelPacket)), GLM_Header, m_pResource);
+    mscharged::platform::DecodeRLGPackets(static_cast<glModelPacket*>(m_pPackets), data, size);
+#else
     m_numPacketEntries = size / sizeof(glModelPacket);
     m_pPackets = glResourceAlloc(size, GLM_Header, m_pResource);
     memcpy(m_pPackets, data, size);
+#endif
 }
 
 void RLGReader::LoadModels(void* data, unsigned long size)
 {
+#if defined(MSCHARGED_NATIVE)
+    m_nModels = size / mscharged::platform::RLGModelBytes;
+    glBeginResource(mscharged::platform::ReadRLGWord(data));
+    m_pModels = (glModel*)glResourceAlloc(mscharged::platform::RLGNativeRecordBytes(
+        size, mscharged::platform::RLGModelBytes, sizeof(glModel)), GLM_Header, m_pResource);
+    glEndResource();
+    mscharged::platform::DecodeRLGModels(m_pModels, data, m_nModels);
+#else
     m_nModels = size / sizeof(glModel);
     glBeginResource(*(unsigned long*)data);
     m_pModels = (glModel*)glResourceAlloc(size, GLM_Header, m_pResource);
     glEndResource();
     memcpy(m_pModels, data, m_nModels * sizeof(glModel));
+#endif
 }
 
