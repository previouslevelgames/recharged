From: mscharged native port
Subject: [PATCH] Preserve native retrace callback and screenshot scalar widths
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Use four-byte native retrace callback arguments and GXPeekARGB output cells.
Use the native SDK GXBool output type for hardware status cells.
Upstream now uses shared SDK declarations and clock macros, retiring the old
local colour/compare guards and hardware-clock hunk. Native clock transport
remains in0244. Preserve source callbacks, screenshot and swap decisions.

diff --git a/src/NL/glx/glxSwap.cpp b/src/NL/glx/glxSwap.cpp
index 9727a85..557a128 100644
--- a/src/NL/glx/glxSwap.cpp
+++ b/src/NL/glx/glxSwap.cpp
@@ -42,8 +42,16 @@ static void HandleSoftReset();
 static void glx_ScreenCapture(bool isMovie);
 static void PutPixel(u8* dst, u32 argbColor);
 static void loading_indicator();
+#if defined(MSCHARGED_NATIVE)
+static void vi_pre_cb(u32);
+#else
 static void vi_pre_cb(unsigned long);
+#endif
+#if defined(MSCHARGED_NATIVE)
+static void vi_post_cb(u32);
+#else
 static void vi_post_cb(unsigned long);
+#endif
 static void draw_done_cb();
 static void AdvanceFrame();
 static void ReportGPStatus();
@@ -116,7 +124,11 @@ static void glx_ScreenCapture(bool isMovie)
     char filename[0x40];
     FILE* file;
     TargaHeader header;
+#if defined(MSCHARGED_NATIVE)
+    u32 argbColor;
+#else
     unsigned long argbColor;
+#endif
     s32 pixelOffset;
     s32 y, x;
     u8* imageData;
@@ -220,12 +232,20 @@ static void loading_indicator()
     }
 }
 
+#if defined(MSCHARGED_NATIVE)
+static void vi_pre_cb(u32)
+#else
 static void vi_pre_cb(unsigned long)
+#endif
 {
     bInRetrace = 1;
 }
 
+#if defined(MSCHARGED_NATIVE)
+static void vi_post_cb(u32)
+#else
 static void vi_post_cb(unsigned long)
+#endif
 {
     HandleSoftReset();
     if (glx_bLoadingIndicator != 0)
@@ -310,11 +330,19 @@ void glxSetDrawSyncTimeout(f32 seconds)
 
 static void ReportGPStatus()
 {
+#if defined(MSCHARGED_NATIVE)
+    GXBool overhi;
+    GXBool underlow;
+    GXBool readIdle;
+    GXBool cmdIdle;
+    GXBool brkpt;
+#else
     u8 overhi;
     u8 underlow;
     u8 readIdle;
     u8 cmdIdle;
     u8 brkpt;
+#endif
 
     GXGetGPStatus(&overhi, &underlow, &readIdle, &cmdIdle, &brkpt);
     OSReport("overhi = %s\n", overhi ? "true" : "false");
