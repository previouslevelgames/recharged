Subject: [PATCH] Adapt original procedural mesh colour and coherent stream transport
Upstream-base: 11c0bc65ad2ec21431c5d74f1ac4cbc1e3e2e2c3

Keep original mesh layout, allocation, cursor stores and packet finalization.
Copy exact four-byte colours on native hosts, retain Wii numeric RGBA order,
and publish actual native-written stream extents at the hardware boundary.
Native coherent host storage uses a fence in place of Wii cache writeback.

diff --git a/src/Game/GL/MeshWriter.cpp b/src/Game/GL/MeshWriter.cpp
--- a/src/Game/GL/MeshWriter.cpp
+++ b/src/Game/GL/MeshWriter.cpp
@@ -1,5 +1,9 @@
+#ifndef MSCHARGED_NATIVE
 #include <revolution/base/PPCArch.h>
 #include <revolution/os/OSCache.h>
+#else
+#include <atomic>
+#endif
 
 #include "Game/GL/MeshWriter.h"
 
@@ -7,6 +11,9 @@
 #include "NL/gl/glMemory.h"
 #include "NL/gl/glPlat.h"
 #include "Game/UnidentifiedStaticStorage.h"
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/game_allocation_ownership.h"
+#endif
 
 MeshWriter::MeshWriter()
     : count(0)
@@ -85,15 +92,24 @@
 
 bool MeshWriter::End()
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mscharged::platform::PublishGameGraphicsNativeBytes(model->packets->streams[0].address, position);
+    mscharged::platform::PublishGameGraphicsNativeBytes(model->packets->streams[1].address, texcoord);
+#endif
     for (int i = 0; i < model->numPackets; ++i)
     {
         glplatFinalizePacket(&model->packets[i], resource != 0, resource);
     }
+#ifndef MSCHARGED_NATIVE
     for (int i = 0; i < model->packets->numStreams; ++i)
     {
         glModelStream* stream = &model->packets->streams[i];
         DCStoreRangeNoSync(stream->address, count * stream->stride);
     }
     PPCSync();
+#else
+    // Host arrays are coherent; publish their stores before native SDK transport.
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+#endif
     return true;
 }
diff --git a/include/Game/GL/GLColourMeshWriter.h b/include/Game/GL/GLColourMeshWriter.h
--- a/include/Game/GL/GLColourMeshWriter.h
+++ b/include/Game/GL/GLColourMeshWriter.h
@@ -3,6 +3,9 @@
 
 #include "NL/gl/glModel.h"
 #include "NL/nlColour.h"
+#ifdef MSCHARGED_NATIVE
+#include <cstring>
+#endif
 #include "NL/nlMath.h"
 
 class GLColourMeshWriter
@@ -20,12 +23,25 @@
 
     void Colour(const nlColour& c)
     {
+#ifdef MSCHARGED_NATIVE
+        std::memcpy(colour++, &c, sizeof(c));
+#else
         ColourPlat(*(const unsigned long*)&c);
+#endif
     }
 
     void ColourPlat(unsigned long nColourPlat)
     {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+        // A numeric Wii RGBA word keeps its original channel byte order.
+        const u32 word = static_cast<u32>(nColourPlat);
+        const unsigned char rgba[4] = { static_cast<unsigned char>(word >> 24),
+            static_cast<unsigned char>(word >> 16), static_cast<unsigned char>(word >> 8),
+            static_cast<unsigned char>(word) };
+        std::memcpy(colour++, rgba, sizeof(rgba));
+#else
         *colour++ = nColourPlat;
+#endif
     }
 
     void Colour(unsigned char r, unsigned char g, unsigned char b, unsigned char a)
