From: mscharged-port
Subject: Share original audio stream control states through typed platform operations
Upstream-base: 443164c91fded218656a8443432e642fdad57838

Keep present original Play/Stop/Pause/Resume branches shared with the native
bounded stereo stream owner. Console AX/interrupt/cancellation work remains
in delegates. Missing Prepare/Update bodies are not replaced or stubbed.

diff --git a/include/Game/Audio/AudioStreamControlSteps.h b/include/Game/Audio/AudioStreamControlSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/Audio/AudioStreamControlSteps.h
@@ -0,0 +1,63 @@
+#ifndef GAME_AUDIO_STREAM_CONTROL_STEPS_H
+#define GAME_AUDIO_STREAM_CONTROL_STEPS_H
+// Original present AudioReadState state branches; platform work stays typed.
+template<class Source,class Prepare,class Start>
+bool AudioStreamPlaySteps(Source& source,unsigned int value,Prepare prepare,Start start)
+{
+    source.m_PlayCount = value;
+    switch (source.m_Unknown10)
+    {
+    case 1:
+        prepare();
+    case 2:
+        source.m_Unknown28 = 5;
+        break;
+    case 3:
+        start();
+        source.m_Unknown10 = 4;
+        break;
+    default:
+        return false;
+    }
+    return true;
+}
+template<class Source,class Stop,class Pending,class Cancel>
+void AudioStreamStopSteps(Source& source,Stop stop,Pending pending,Cancel cancel)
+{
+    switch (source.m_Unknown10)
+    {
+    case 4:
+        stop();
+    case 2:
+        source.m_Unknown28 = 6;
+        if (pending())
+            cancel();
+        source.m_Unknown10 = 6;
+        break;
+    case 3:
+    case 7:
+        source.m_Unknown10 = 6;
+        break;
+    case 5:
+        break;
+    }
+}
+template<class Source,class Pause>
+bool AudioStreamPauseSteps(Source& source,Pause pause)
+{
+    if (source.m_Unknown10 != 4)
+        return false;
+    pause();
+    source.m_Unknown10 = 7;
+    return true;
+}
+template<class Source,class Resume>
+bool AudioStreamResumeSteps(Source& source,Resume resume)
+{
+    if (source.m_Unknown10 != 7)
+        return false;
+    resume();
+    source.m_Unknown10 = 4;
+    return true;
+}
+#endif
