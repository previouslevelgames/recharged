Subject: Preserve native impostor marker field widths
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Read the original two usage fields from the actual native GLResourceMarker.
The capture/cache/resource order and two-zero condition are unchanged.
Console source is byte-identical. No pool initialization or readiness is added.

diff --git a/src/Game/Render/ImpostorManager.cpp b/src/Game/Render/ImpostorManager.cpp
index df42382..8400ec3 100644
--- a/src/Game/Render/ImpostorManager.cpp
+++ b/src/Game/Render/ImpostorManager.cpp
@@ -242,8 +242,13 @@ void ImpostorManager::Render(GLView* target, bool skipCapture)
         instance->mCaptured = true;
         instance->mResourceMarkers[instance->mCurrentResource] =
             instance->mResources[instance->mCurrentResource]->MarkResource();
+#if defined(MSCHARGED_NATIVE)
+        const GLResourceMarker* marker = (const GLResourceMarker*)instance->mResourceMarkers[instance->mCurrentResource];
+        if (marker->mUsedMemory[0] != 0 || marker->mUsedMemory[1] != 0)
+#else
         u32* marker = (u32*)instance->mResourceMarkers[instance->mCurrentResource];
         if (marker[0] != 0 || marker[1] != 0)
+#endif
         {
             nlBreak();
         }
