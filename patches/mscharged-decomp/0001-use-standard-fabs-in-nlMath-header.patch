Subject: Use the host standard absolute-value overload in nlMath
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Clang cannot compile nlRandom.cpp because the shared math header uses the
CodeWarrior __fabs intrinsic without a host declaration. Use the float
overload of std::fabs. This does not adapt the separate nlMath.cpp reciprocal
square-root implementation or establish floating-point gameplay parity.

diff --git a/include/NL/nlMath.h b/include/NL/nlMath.h
index ca81723..0201982 100644
--- a/include/NL/nlMath.h
+++ b/include/NL/nlMath.h
@@ -3,6 +3,8 @@
 
 #include "types.h"
 
+#include <cmath>
+
 float nlBezier(float* fControlPoints, int nNumPoints, float fMu);
 float nlATan(float x);
 float nlATan2f(float y, float x);
@@ -41,7 +43,7 @@ inline unsigned int nlAlignUp(unsigned int value, unsigned int alignment)
 
 inline float nlAbs(float value)
 {
-    return __fabs(value);
+    return std::fabs(value);
 }
 
 inline float AngUnitsToRad_fromUnsignedShort(unsigned short sUnits)
