diff --git a/src/Game/Camera/CameraData.cpp b/src/Game/Camera/CameraData.cpp
new file mode 100644
--- /dev/null
+++ b/src/Game/Camera/CameraData.cpp
@@ -0,0 +1,30 @@
+#include "Game/Camera/animcam.h"
+#include "NL/nlMemory.h"
+
+// Original data initialization with native allocation/free pairing.
+cCameraData::cCameraData()
+{
+    ownsKeyData = false;
+    next = NULL;
+    m_uHashID = 0;
+    m_uKeyCount = 0;
+    m_szName = NULL;
+    cameraPos = NULL;
+    targetPos = NULL;
+    cameraRot = NULL;
+    fFOV = NULL;
+    fFocalLength = NULL;
+}
+
+cCameraData::~cCameraData()
+{
+    if (ownsKeyData)
+    {
+        nlFree(cameraPos);
+        nlFree(targetPos);
+        nlFree(cameraRot);
+        nlFree(fFOV);
+        nlFree(fFocalLength);
+        nlFree(m_szName);
+    }
+}
