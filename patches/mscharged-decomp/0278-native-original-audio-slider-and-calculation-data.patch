From: mscharged-port
Subject: [PATCH] Adapt original audio control data and saved word offsets to native ABI
Upstream-base: 0f5a757947b8778b680d4d1ae7e6df1792a514f2

Original chunk selection, constructor requests, list order, transitions and
numeric behavior remain authoritative. Native endian/record views are attached
to the actual completed NL allocation. Calculation s32 offsets retain authored
word identity and32-bit wrapping without treating saved words as live addresses.
Source updates and all original headers remain unchanged. RPC/factory/AX/full
resource loading remains separate.

diff --git a/src/Game/Audio/AudioSlider.cpp b/src/Game/Audio/AudioSlider.cpp
--- a/src/Game/Audio/AudioSlider.cpp
+++ b/src/Game/Audio/AudioSlider.cpp
@@ -5,19 +5,37 @@
 #include "NL/nlChunk.h"
 #include "NL/nlDebugString.h"
 #include "types.h"
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/native_audio_controls.h"
+#endif
 
 AudioSliderTable* ParseAudioSliderTable(nlChunk* outer)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    const auto nativeView = mscharged::platform::PrepareNativeAudioSliderChunk(outer);
+#endif
     nlChunk* header = (nlChunk*)outer->GetData();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    AudioSliderTable* table = (AudioSliderTable*)mscharged::platform::NativeAudioControlData(nativeView, header);
+#else
     AudioSliderTable* table = (AudioSliderTable*)header->GetData();
+#endif
 
     nlChunk* definitions = header->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    table->globalDefinitions = (AudioSliderDefinition*)mscharged::platform::NativeAudioControlData(nativeView, definitions);
+#else
     table->globalDefinitions = (AudioSliderDefinition*)definitions->GetData();
+#endif
     table->globalDefinitionsCopy = table->globalDefinitions;
     table->localDefinitions = table->globalDefinitions + table->globalCount;
 
     nlChunk* indices = definitions->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    table->localToGlobal = (u32*)mscharged::platform::NativeAudioControlData(nativeView, indices);
+#else
     table->localToGlobal = (u32*)indices->GetData();
+#endif
 
     table->CreateGlobalSliders();
     table->CreateLocalSets();
diff --git a/src/Game/Audio/AudioCalculation.cpp b/src/Game/Audio/AudioCalculation.cpp
--- a/src/Game/Audio/AudioCalculation.cpp
+++ b/src/Game/Audio/AudioCalculation.cpp
@@ -1,16 +1,38 @@
 #include "Game/Audio/AudioCalculation.h"
 #include "NL/nlChunk.h"
 #include "types.h"
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/native_audio_controls.h"
+#endif
 
 AudioCalculationTable* ParseAudioCalculationTable(nlChunk* outer)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    const auto nativeView = mscharged::platform::PrepareNativeAudioCalculationChunk(outer);
+#endif
     nlChunk* header = (nlChunk*)outer->GetData();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    AudioCalculationTable* table = (AudioCalculationTable*)mscharged::platform::NativeAudioControlData(nativeView, header);
+#else
     AudioCalculationTable* table = (AudioCalculationTable*)header->GetData();
+#endif
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    AudioCalculationDefinition* originalDefinitions = table->definitions;
+#else
     u32 relocationDelta = (u32)table->definitions;
+#endif
 
     nlChunk* definitions = header->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    table->definitions = (AudioCalculationDefinition*)mscharged::platform::NativeAudioControlData(nativeView, definitions);
+#else
     table->definitions = (AudioCalculationDefinition*)definitions->GetData();
+#endif
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    const auto relocationDelta = mscharged::platform::NativeAudioCalculationDelta(nativeView, originalDefinitions, table->definitions, table->count);
+#else
     relocationDelta -= (u32)table->definitions;
+#endif
     u32 relocationOffset;
     u32 relocationIndex;
     relocationIndex = 0;
@@ -22,13 +44,25 @@
                 + relocationOffset);
         if (definition->field_0C != 0)
             definition->field_0C
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+                = mscharged::platform::RelocateNativeAudioCalculationWord(definition->field_0C, relocationDelta);
+#else
                 = (s32*)((u8*)definition->field_0C - relocationDelta);
+#endif
         if (definition->field_10 != 0)
             definition->field_10
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+                = mscharged::platform::RelocateNativeAudioCalculationWord(definition->field_10, relocationDelta);
+#else
                 = (s32*)((u8*)definition->field_10 - relocationDelta);
+#endif
         if (definition->field_14 != 0)
             definition->field_14
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+                = mscharged::platform::RelocateNativeAudioCalculationWord(definition->field_14, relocationDelta);
+#else
                 = (s32*)((u8*)definition->field_14 - relocationDelta);
+#endif
         relocationOffset += sizeof(AudioCalculationDefinition);
         relocationIndex++;
     }
