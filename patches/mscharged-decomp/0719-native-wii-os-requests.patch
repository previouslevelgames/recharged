From: mscharged-port
Subject: Declare the Wii OS requests the online SDK sources use natively
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84
Classification: native compiler/ABI compatibility

DWC sleeps through OSSleepTicks but includes only OSThread.h, whose
native branch forwards to Aurora's thread header, which lacks it; the
host provides it in src/platform/alarms.cpp. GameSpy's Revolution assert
calls OSHalt, an SDK macro over OSPanic that the native OS umbrella
did not define.

diff --git a/libs/RVL_SDK/include/revolution/os.h b/libs/RVL_SDK/include/revolution/os.h
index a73eb86..88ecf7a 100644
--- a/libs/RVL_SDK/include/revolution/os.h
+++ b/libs/RVL_SDK/include/revolution/os.h
@@ -17,6 +17,7 @@ void OSSleepTicks(OSTime ticks);
 }
 #endif
 #define OS_BUS_CLOCK_SPEED __OSBusClock
+#define OSHalt(msg) OSPanic(__FILE__, __LINE__, msg)
 #else
 
 #include <revolution/types.h>
diff --git a/libs/RVL_SDK/include/revolution/os/OSThread.h b/libs/RVL_SDK/include/revolution/os/OSThread.h
index d55c26d..18f22e4 100644
--- a/libs/RVL_SDK/include/revolution/os/OSThread.h
+++ b/libs/RVL_SDK/include/revolution/os/OSThread.h
@@ -14,6 +14,8 @@ extern "C" {
 #endif
 s32 __OSGetEffectivePriority(OSThread* thread);
 void __OSPromoteThread(OSThread* thread, s32 priority);
+// A Wii request absent from the native thread header; the host provides it.
+void OSSleepTicks(s64 ticks);
 #ifdef __cplusplus
 }
 #endif
