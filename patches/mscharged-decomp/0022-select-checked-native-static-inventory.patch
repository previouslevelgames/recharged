Subject: Select checked native static inventory

Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090

Select checked native static inventory
Select original model/texture insertion, layered lookup and resource-level
rollback in a separate native entry unit. Initialize every array, reclaim
partial construction and make deletion repeatable. Native static inventory
owns file buffers, nodes and trees in the game arenas; pool-owned models and
textures are released before arena rewinds. Check duplicate keys and level
bounds. The empty global resource ring returns no texture safely.
Animation, skin and chunk-loader methods are not compiled or stubbed. Their
container pointers remain null; this is not the full game inventory. Build
GLInventoryStatic.cpp alone for this subset, never alongside GLInventory.cpp.

diff --git a/include/Game/GL/GLInventory.h b/include/Game/GL/GLInventory.h
--- a/include/Game/GL/GLInventory.h
+++ b/include/Game/GL/GLInventory.h
@@ -164,6 +164,9 @@
     Tree* m_pItems;
 };
 
+// The initial native target selects file/model/texture inventory only.
+// Animation, skin and chunk-loader methods require the full implementation;
+// they remain unresolved if a caller attempts to enable them prematurely.
 class GLInventory
 {
 public:
diff --git a/src/Game/GL/GLInventoryStatic.cpp b/src/Game/GL/GLInventoryStatic.cpp
new file mode 100644
--- /dev/null
+++ b/src/Game/GL/GLInventoryStatic.cpp
@@ -0,0 +1,174 @@
+// Selected native static inventory. The original full unit retains animation,
+// skin and chunk-loader code; those methods are deliberately not linked here.
+#include "Game/GL/GLInventory.h"
+#include "NL/gl/glMemory.h"
+#include "NL/gl/glModel.h"
+#include "NL/gl/glTexture.h"
+#include "NL/glx/glxTexture.h"
+#include "NL/nlDLRing.h"
+#include <cstdint>
+#include <stdexcept>
+#include <string.h>
+
+#if !defined(MSCHARGED_NATIVE)
+#error Select GLInventory.cpp for the console build
+#endif
+
+GLInventory::GLInventory()
+{
+    m_bCreated = false;
+    for (int i = 0; i < 16; i++)
+    {
+        m_pModels[i] = 0;
+        m_pTextures[i] = 0;
+        m_pFileData[i] = 0;
+        m_pSkinData[i] = 0;
+        m_pTextureAnims[i] = 0;
+        m_pVertexAnims[i] = 0;
+    }
+    m_nLevel = 0;
+    memset(&mModelReleaseCallback, 0, sizeof(mModelReleaseCallback));
+}
+
+GLInventory::~GLInventory() { Delete(); }
+
+void GLInventory::Create()
+{
+    if (m_bCreated) throw std::logic_error("GL inventory is already initialized");
+    try
+    {
+        for (int i = 0; i < 16; ++i)
+        {
+            m_pFileData[i] = new (8, false) nlListContainer<void*>();
+            m_pModels[i] = new (8, false) clearing_GLInventory<glModel>();
+            m_pTextures[i] = new (8, false) clearing_GLInventory<PlatTexture>();
+        }
+        m_bCreated = true;
+    }
+    catch (...) { Delete(); throw; }
+}
+
+void GLInventory::Delete()
+{
+    for (int i = 15; i >= 0; --i)
+    {
+        ReleaseLevel(i);
+        nlDeleteGameObject(m_pFileData[i]); m_pFileData[i] = 0;
+        nlDeleteGameObject(m_pModels[i]); m_pModels[i] = 0;
+        nlDeleteGameObject(m_pTextures[i]); m_pTextures[i] = 0;
+    }
+    m_bCreated = false;
+    m_nLevel = 0;
+}
+
+void GLInventory::ReleaseLevel(int nLevel)
+{
+    if (nLevel < 0 || nLevel >= 16) throw std::out_of_range("Invalid GL inventory level");
+    if (m_pFileData[nLevel])
+    {
+        for (ListEntry<void*>* item = m_pFileData[nLevel]->m_Head; item; item = item->next)
+            nlFree(item->entry);
+        m_pFileData[nLevel]->Clear();
+    }
+    if (m_pModels[nLevel]) m_pModels[nLevel]->Release(mModelReleaseCallback);
+    if (m_pTextures[nLevel]) m_pTextures[nLevel]->Release(glReleaseTexture);
+}
+PlatTexture* glx_GetTex(unsigned long handle)
+{
+    GLResourcePool* pResource = nlDLRingGetStart(glGetResourcePools());
+    if (pResource == 0) return 0;
+    for (;; pResource = pResource->m_next)
+    {
+        PlatTexture* pTex = pResource->m_inventory->GetTexture(handle);
+        if (pTex != 0)
+            return pTex;
+        if (nlDLRingIsEnd(glGetResourcePools(), pResource))
+            break;
+    }
+    return 0;
+}
+
+void GLInventory::SetModelReleaseCallback(const ModelReleaseCallback& callback)
+{
+    if (!m_bCreated) throw std::logic_error("GL inventory is not initialized");
+    mModelReleaseCallback = callback;
+}
+
+void GLInventory::ResourceMark()
+{
+    if (!m_bCreated) throw std::logic_error("GL inventory is not initialized");
+    if (m_nLevel >= 15) throw std::length_error("GL inventory marker depth exceeds 16 levels");
+    m_nLevel++;
+}
+
+void GLInventory::ResourceRelease(int nLevel)
+{
+    if (!m_bCreated) throw std::logic_error("GL inventory is not initialized");
+    if (nLevel < 0 || nLevel > m_nLevel) throw std::out_of_range("Invalid GL inventory release level");
+    while (m_nLevel != nLevel)
+    {
+        ReleaseLevel(m_nLevel);
+        m_nLevel--;
+    }
+}
+
+void GLInventory::AddModel(
+    unsigned long key, glModel* model)
+{
+    if (!m_bCreated) throw std::logic_error("GL inventory is not initialized");
+    if (!model || key > UINT32_MAX) throw std::invalid_argument("Invalid static inventory entry");
+    if (m_pModels[m_nLevel]->m_pItems->FindGet(key, 0)) throw std::invalid_argument("Duplicate static inventory key at the current level");
+    unsigned long k = key;
+    glModel* value = model;
+    clearing_GLInventory<glModel>::Tree* pTree = m_pModels[m_nLevel]->m_pItems;
+    pTree->Add(k, value);
+}
+
+glModel* GLInventory::GetModel(unsigned long id)
+{
+    if (!m_bCreated) throw std::logic_error("GL inventory is not initialized");
+    for (int i = m_nLevel; i >= 0; i--)
+    {
+        unsigned long key = id;
+        glModel** pResult;
+        bool found = m_pModels[i]->m_pItems->FindGet(key, &pResult);
+        glModel* result;
+        if (found)
+            result = *pResult;
+        else
+            result = 0;
+        if (result != 0)
+            return result;
+    }
+    return 0;
+}
+
+void GLInventory::AddTexture(unsigned long key, PlatTexture* texture)
+{
+    if (!m_bCreated) throw std::logic_error("GL inventory is not initialized");
+    if (!texture || key > UINT32_MAX) throw std::invalid_argument("Invalid static inventory entry");
+    if (m_pTextures[m_nLevel]->m_pItems->FindGet(key, 0)) throw std::invalid_argument("Duplicate static inventory key at the current level");
+    unsigned long k = key;
+    PlatTexture* value = texture;
+    clearing_GLInventory<PlatTexture>::Tree* pTree = m_pTextures[m_nLevel]->m_pItems;
+    pTree->Add(k, value);
+}
+
+PlatTexture* GLInventory::GetTexture(unsigned long id)
+{
+    if (!m_bCreated) throw std::logic_error("GL inventory is not initialized");
+    for (int i = m_nLevel; i >= 0; i--)
+    {
+        unsigned long key = id;
+        PlatTexture** pResult;
+        bool found = m_pTextures[i]->m_pItems->FindGet(key, &pResult);
+        PlatTexture* result;
+        if (found)
+            result = *pResult;
+        else
+            result = 0;
+        if (result != 0)
+            return result;
+    }
+    return 0;
+}
