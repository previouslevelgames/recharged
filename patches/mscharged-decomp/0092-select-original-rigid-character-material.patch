diff --git a/src/NL/gl/GLFontAtlas.cpp b/src/NL/gl/GLFontAtlas.cpp
new file mode 100644
--- /dev/null
+++ b/src/NL/gl/GLFontAtlas.cpp
@@ -0,0 +1,97 @@
+#include "NL/gl/GLFontAtlas.h"
+#include "NL/gl/font_data.h"
+#if defined(MSCHARGED_NATIVE)
+#include <stdexcept>
+#endif
+
+int sFontCharacterWidth[3] = { 8, 9, 11 };
+int sFontCharacterHeight[3] = { 12, 15, 18 };
+int sFontCellWidth[3] = { 9, 10, 12 };
+int sFontCellHeight[3] = { 13, 16, 20 };
+int sFontTextureWidth[3] = { 128, 128, 128 };
+int sFontTextureHeight[3] = { 256, 256, 256 };
+int sFontCharactersPerRow[4] = { 14, 12, 10, 0 };
+
+
+void glFontBlitCharacter(int x, int y, char character, unsigned short* image, int imageWidth, int font)
+{
+#if defined(MSCHARGED_NATIVE)
+    if (font < 0 || font >= GLFONT_Count || !image || character < 0x20 || character > 0x7D
+        || imageWidth != sFontTextureWidth[font] || x < 0 || y < 0
+        || sFontCharacterWidth[font] < 1 || sFontCharacterWidth[font] > 128
+        || sFontCharacterHeight[font] < 1 || sFontCharacterHeight[font] > 256
+        || x > imageWidth - sFontCharacterWidth[font]
+        || y > sFontTextureHeight[font] - sFontCharacterHeight[font])
+        throw std::invalid_argument("Invalid fixed font atlas character bounds");
+#endif
+    unsigned short* characterData;
+
+    switch (font)
+    {
+    case 0:
+        characterData = (unsigned short*)((unsigned char*)sSmallFontData + (character - 0x20) * 0x18);
+        break;
+    case 1:
+        characterData = (unsigned short*)((unsigned char*)sMediumFontData + (character - 0x20) * 0x1E);
+        break;
+    case 2:
+        characterData = (unsigned short*)((unsigned char*)sLargeFontData + (character - 0x20) * 0x24);
+        break;
+    default:
+        characterData = 0;
+        break;
+    }
+
+    const int endX = x + sFontCharacterWidth[font];
+    const int endY = y + sFontCharacterHeight[font];
+
+    for (int imageY = y; imageY < endY; ++imageY)
+    {
+#if defined(MSCHARGED_NATIVE)
+        const unsigned short bits = characterData[imageY - y];
+        const unsigned char row[2] = { (unsigned char)(bits >> 8), (unsigned char)bits };
+#else
+        unsigned char* row = (unsigned char*)(characterData + (imageY - y));
+#endif
+
+        for (int imageX = x; imageX < endX; ++imageX)
+        {
+            const int bit = imageX - x;
+            bool set;
+            if (bit < 8)
+            {
+                set = ((row[0] << bit) >> 7) & 1;
+            }
+            else
+            {
+                set = ((row[1] << (bit - 8)) >> 7) & 1;
+            }
+
+            if (set)
+            {
+                image[imageY * imageWidth + imageX] = 0xFFFF;
+            }
+        }
+    }
+}
+
+void glBuildFixedFontImage(int font, unsigned short* image)
+{
+#if defined(MSCHARGED_NATIVE)
+    if (font < 0 || font >= GLFONT_Count || !image)
+        throw std::invalid_argument("Invalid fixed font atlas input");
+#endif
+    const int width = sFontTextureWidth[font];
+    int x = 0;
+    int y = 0;
+    for (int character = 0; character < 0x5E; ++character)
+    {
+        glFontBlitCharacter(x, y, character + 0x20, image, width, font);
+        x += sFontCellWidth[font];
+        if (x + sFontCellWidth[font] >= width)
+        {
+            x = 0;
+            y += sFontCellHeight[font];
+        }
+    }
+}
diff --git a/include/NL/gl/GLFontAtlas.h b/include/NL/gl/GLFontAtlas.h
new file mode 100644
