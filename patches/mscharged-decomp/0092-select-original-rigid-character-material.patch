+++ b/include/NL/gl/GLFontAtlas.h
@@ -0,0 +1,18 @@
+#ifndef NL_GL_FONT_ATLAS_H
+#define NL_GL_FONT_ATLAS_H
+enum eGLFont
+{
+    GLFONT_Small,
+    GLFONT_Medium,
+    GLFONT_Large,
+    GLFONT_Count,
+};
+
+extern int sFontCharacterWidth[3], sFontCharacterHeight[3];
+extern int sFontCellWidth[3], sFontCellHeight[3];
+extern int sFontTextureWidth[3], sFontTextureHeight[3];
+extern int sFontCharactersPerRow[4];
+void glFontBlitCharacter(int x, int y, char character, unsigned short* image, int imageWidth, int font);
+// Caller supplies a zeroed width*height image. Original placement and glyph bits.
+void glBuildFixedFontImage(int font, unsigned short* image);
+#endif
