+#ifdef MSCHARGED_NATIVE
+#include <limits>
+#include <stddef.h>
+#include <stdexcept>
+
+static_assert(sizeof(BundleFileHeader) == 16, "Wii bundle header has four words");
+static_assert(sizeof(BundleFileDirectoryEntry) == 12, "Wii bundle entries have three words");
+static_assert(offsetof(BundleFile, m_pFile) == 16, "Original raw read targets only the four header words");
+
+struct NativeBundleHeaderBuffer
+{
+    void* pointer;
+    explicit NativeBundleHeaderBuffer(void* buffer) : pointer(buffer) {}
+    ~NativeBundleHeaderBuffer() { if (pointer) nlFree(pointer); }
+    void Free() { nlFree(pointer); pointer = 0; }
+};
+
+static u32 NativeBundleWord(const void* source)
+{
+    const u8* bytes = static_cast<const u8*>(source);
+    return (u32(bytes[0]) << 24) | (u32(bytes[1]) << 16)
+        | (u32(bytes[2]) << 8) | u32(bytes[3]);
+}
+
+static void NativeDecodeBundleHeader(BundleFile* bundle)
+{
+    const u8* bytes = reinterpret_cast<const u8*>(bundle);
+    const u32 sector = NativeBundleWord(bytes);
+    const u32 files = NativeBundleWord(bytes + 4);
+    const u32 directory = NativeBundleWord(bytes + 8);
+    const u32 data = NativeBundleWord(bytes + 12);
+    const uint64_t size = nlFileSize(bundle->m_pFile, 0);
+    const uint64_t offset = uint64_t(directory) * sector;
+    const uint64_t length = uint64_t(files) * sizeof(BundleFileDirectoryEntry);
+    if (sector == 0 || offset > size || length > size - offset
+        || length > 0x3FFFFFFFu)
+        throw std::runtime_error("Wii bundle directory exceeds its native file/allocation range");
+    bundle->nSectorSize = sector;
+    bundle->nNumFiles = files;
+    bundle->nDirectoryOffsetInSectors = directory;
+    bundle->nDataOffsetInSectors = data;
+}
+
+static void NativeDecodeBundleDirectory(BundleFile* bundle)
+{
+    const uint64_t size = nlFileSize(bundle->m_pFile, 0);
+    for (u32 i = 0; i < bundle->nNumFiles; ++i)
+    {
+        BundleFileDirectoryEntry& entry = bundle->m_pDirectory[i];
+        const u8* bytes = reinterpret_cast<const u8*>(&entry);
+        const u32 hash = NativeBundleWord(bytes);
+        const u32 block = NativeBundleWord(bytes + 4);
+        const u32 length = NativeBundleWord(bytes + 8);
+        const uint64_t offset = uint64_t(block) * bundle->nSectorSize;
+        if (offset > size || length > size - offset)
+            throw std::runtime_error("Wii bundle entry exceeds its native file range");
+        entry.m_hash = hash;
+        entry.m_blockNumber = block;
+        entry.m_length = length;
+    }
+}
+
+static void NativeRegisterBundleRead(BundleFile* bundle, AsyncReadCallbackData* data)
+{
+    data->owner = bundle;
+    data->next = bundle->m_nativeReadContexts;
+    data->previous = &bundle->m_nativeReadContexts;
+    if (data->next) data->next->previous = &data->next;
+    bundle->m_nativeReadContexts = data;
+}
+
+static void NativeDetachBundleRead(AsyncReadCallbackData* data)
+{
+    *data->previous = data->next;
+    if (data->next) data->next->previous = data->previous;
+    data->owner = 0;
+}
+
+static void NativeReleaseBundleReads(BundleFile* bundle)
+{
+    // Original nlClose has already joined/cancelled every worker using these
+    // contexts. No completion callback is fabricated for a cancelled read.
+    while (bundle->m_nativeReadContexts)
+    {
+        AsyncReadCallbackData* data = bundle->m_nativeReadContexts;
+        NativeDetachBundleRead(data);
+        nlFree(data);
+    }
+}
+
+static void NativeSubmitBundleRead(BundleFile* bundle, void* buffer,
+    unsigned long size, AsyncReadCallbackData* data)
+{
+    // A zero-byte NL request completes inline. Its original user callback may
+    // destroy the bundle or throw, so submission must not reuse freed metadata.
+    bool completed = false;
+    data->completionDuringSubmission = &completed;
+    NativeRegisterBundleRead(bundle, data);
+    try
+    {
+        if (size > std::numeric_limits<u32>::max())
+            throw std::length_error("Native bundle read exceeds a Wii byte count");
+        nlReadAsync(bundle->m_pFile, buffer, size, cbFileReadAsyncCallback,
+            (BundleAsyncParam)data, 0);
+    }
+    catch (...)
+    {
+        if (!completed)
+        {
+            NativeDetachBundleRead(data);
+            nlFree(data);
+        }
+        throw;
+    }
+    if (!completed) data->completionDuringSubmission = 0;
+}
