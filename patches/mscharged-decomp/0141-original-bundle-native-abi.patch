-static void cbFileReadAsyncCallback(nlFile*, void* buffer, unsigned int size, unsigned long userParam)
+static void cbFileReadAsyncCallback(nlFile*, void* buffer, unsigned int size, BundleAsyncParam userParam)
 {
     AsyncReadCallbackData* data = (AsyncReadCallbackData*)userParam;
+#ifdef MSCHARGED_NATIVE
+    // Detach before the original callback: FontManager's last texture callback
+    // closes and destroys this BundleFile. Keep the current context alive until
+    // that callback returns, including an exception from a native service.
+    if (data->completionDuringSubmission) *data->completionDuringSubmission = true;
+    NativeDetachBundleRead(data);
+    try { data->callback(buffer, size, data->userParam); }
+    catch (...) { nlFree(data); throw; }
+    nlFree(data);
+#else
     data->callback(buffer, size, data->userParam);
     delete data;
+#endif
 }
 
