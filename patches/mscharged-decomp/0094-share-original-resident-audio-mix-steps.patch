Subject: Retain legacy diagnostic audio helpers without rewriting original source

Upstream-base: dc238202b310059d80791d0140dee37f27b9a3bf

The existing diagnostic helper snapshots remain for explicitly selected preview
consumers. Complete original game/SDK methods, headers, enum definitions and
retail state transitions are no longer delegated to these copies. No AX/DSP
readiness, native game audio manager or new source behavior is provided.

diff --git a/include/Game/Audio/AudioCalculationSteps.h b/include/Game/Audio/AudioCalculationSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/Audio/AudioCalculationSteps.h
@@ -0,0 +1,20 @@
+#ifndef GAME_AUDIO_CALCULATION_STEPS_H
+#define GAME_AUDIO_CALCULATION_STEPS_H
+#include "Game/Audio/AudioCalculation.h"
+template <class Table>
+inline void AudioUpdateCalculationTable(Table& table, float dt)
+{
+    AudioCalculationSlider* slider = table.sliders;
+    AudioCalculationDefinition* definition = table.definitions;
+    for (u32 i = 0; i < table.count;)
+    {
+        float multiplier = definition->field_0C != 0
+                             ? table.sliders[*definition->field_0C].value
+                             : 1.0f;
+        slider->Update(dt, multiplier);
+        i++;
+        slider++;
+        definition++;
+    }
+}
+#endif
diff --git a/include/Game/Audio/AudioResidentSteps.h b/include/Game/Audio/AudioResidentSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/Audio/AudioResidentSteps.h
@@ -0,0 +1,29 @@
+#ifndef GAME_AUDIO_RESIDENT_STEPS_H
+#define GAME_AUDIO_RESIDENT_STEPS_H
+inline int AudioResidentInputTenths(float value)
+{
+    return (int)(10.0f * value);
+}
+inline int AudioResidentPan(float value)
+{
+    return ((int)(127.0f * value) - 1) / 2 + 64;
+}
+inline float AudioResidentInstanceVolume(float volumeOffset, float sliderValue, float currentVolume)
+{
+    return volumeOffset + (sliderValue + currentVolume);
+}
+inline float AudioResidentPlaybackVolume(float volume, float instanceVolume,
+    float volumeModifier, float volumeOffset)
+{
+    float playbackVolume = volumeModifier + volumeOffset;
+    float currentVolume = volume + (instanceVolume + playbackVolume);
+    currentVolume = currentVolume >= -96.0f ? currentVolume : -96.0f;
+    currentVolume = currentVolume <= 6.0f ? currentVolume : 6.0f;
+    return currentVolume;
+}
+template <class Function, class Voice>
+inline void AudioResidentInitializeMix(Function initialize, Voice voice)
+{
+    initialize(voice, 0, 0, -960, -960, -960, 64, 127, 0);
+}
+#endif
