diff --git a/libs/RVL_SDK/include/revolution/mix/MIXTableSteps.h b/libs/RVL_SDK/include/revolution/mix/MIXTableSteps.h
new file mode 100644
--- /dev/null
+++ b/libs/RVL_SDK/include/revolution/mix/MIXTableSteps.h
@@ -0,0 +1,19 @@
+#ifndef REVOLUTION_MIX_TABLE_STEPS_H
+#define REVOLUTION_MIX_TABLE_STEPS_H
+#include <revolution/types.h>
+static inline u16 MIXTableVolume(int db_, const u16* table)
+{
+    int db = db_;
+
+    if (db <= -0x388)
+    {
+        return 0;
+    }
+    if (db >= 0x3C)
+    {
+        return 0xFF64;
+    }
+    return table[db + 0x388];
+}
+
+#endif
