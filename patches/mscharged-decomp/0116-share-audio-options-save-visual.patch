Subject: Share original Audio options save visual ordering

Upstream-base: a353c8f2dfb34eb08fecd725965a46ea629428e3

Keep original SaveLoad::StartSave(false) outside the shared visual prefix.
Native preferences are a separately named real host service, not original
GameInfo/save readiness. Original navigation, slide and cue order is retained.

Refreshed for decomp 9046e67a: feOptionsSubMenus.cpp keep their upstream text
(the series' later restore patches made these edits net zero).

diff --git a/include/Game/FE/FrontendAudioOptionsSteps.h b/include/Game/FE/FrontendAudioOptionsSteps.h
index feac26c..18706c7 100644
--- a/include/Game/FE/FrontendAudioOptionsSteps.h
+++ b/include/Game/FE/FrontendAudioOptionsSteps.h
@@ -320,4 +320,19 @@ void FrontendAudioOptionsBack(Scene& scene,Settings getSettings,Play play,Naviga
                 navigation->SetButtons(0, true);
             scene.mPresentation->SetActiveSlide("OPTIONS_OUT", true);
 }
+template<class Scene,class Navigation,class Play>
+void FrontendAudioOptionsSaveVisual(Scene& scene,Navigation getNavigation,Play play)
+{
+    scene.mState = 3;
+    auto* navigation = getNavigation();
+    if (navigation != 0)
+    {
+        navigation->SetButtons(0, true);
+    }
+    scene.mPresentation->SetActiveSlide("OPTIONS_OUT", true);
+    scene.mSaveStarted = true;
+    scene.mSaveButton->SetActiveSlide("down", true, false);
+    play(0xF0AFD586, 0, 0, 1);
+    play(0x304FDD1E, 0, 0, 1);
+}
 #endif
