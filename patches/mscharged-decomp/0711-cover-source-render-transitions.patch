 extern "C"
 {
     extern bool lbl_806DEE60;
@@ -148,6 +151,21 @@ DrawableObject** GetNumberRenderObjects()
     return gStadiumNumberInstances;
 }
 
+#if defined(MSCHARGED_AUTOMATIC_PREWARM)
+void mscharged::platform::EnumerateAutomaticNumberResources()
+{
+    // Invoked only by the completed match-resource census, before gameplay.
+    // Skipped gameplay models may leave old slots behind after stadium teardown.
+    if (pBasicStadiumInstance == 0 || gSkipGameplayModels) return;
+    for (unsigned i = 0; i != sizeof(gStadiumNumberInstances) / sizeof(gStadiumNumberInstances[0]); ++i)
+    {
+        const DrawableObject* glyph = gStadiumNumberInstances[i];
+        if (glyph != 0 && glyph->m_pModel != 0)
+            EnumerateAutomaticNumberModelPipelines(*glyph->m_pModel);
+    }
+}
+#endif
