 {
     return gStadiumModelEntries[0].mInstances[index];
diff --git a/src/NL/glx/GXCharacterDamageMaterialProgramRender.cpp b/src/NL/glx/GXCharacterDamageMaterialProgramRender.cpp
index 85d0cc3..d05630b 100644
--- a/src/NL/glx/GXCharacterDamageMaterialProgramRender.cpp
+++ b/src/NL/glx/GXCharacterDamageMaterialProgramRender.cpp
@@ -348,10 +348,19 @@ void glxCollectCharacterDamagePipelineVariants(const glModelPacket& packet)
          surface <= (match ? 8 : (params.blackOnly ? 8 : currentDamage + 4 * currentMega)); ++surface)
     for (int shadow = 0; shadow < (match && sCharacterDamageShadowLightingEnabled ? 4 : 1); ++shadow)
     for (int inheritedAlpha = 0; inheritedAlpha < (surface == 8 ? 3 : 1); ++inheritedAlpha)
+    for (int inheritedTexgen = 0; inheritedTexgen != 2; ++inheritedTexgen)
     {
         BeginAutomaticMaterialVariant(packet);
         program->ConfigureVertexFormat(true);
         program->BindVertexArrays(&packet);
+        // A view switch can enter this program directly after scrolling material
+        // deactivation, which leaves both texture generators at 3x4 identity.
+        // Keep the ordinary reset recipe and this source-defined transition pair.
+        if (inheritedTexgen != 0)
+        {
+            gxSetTexCoordGen(GX_TEXCOORD0, GX_TG_MTX3x4, GX_TG_TEX0, GX_IDENTITY);
+            gxSetTexCoordGen(GX_TEXCOORD2, GX_TG_MTX3x4, GX_TG_TEX2, GX_IDENTITY);
+        }
         ConfigureCharacterDamagePipelineState(enabled != 0, lightCount, doubled,
             stageCount, sCharacterDamageTexGenCount);
         const bool damage[2] = { (surface & 1) != 0, (surface & 2) != 0 };
diff --git a/src/NL/glx/GXCompactColourMaterialProgramRender.cpp b/src/NL/glx/GXCompactColourMaterialProgramRender.cpp
index 6fe6446..7b9d432 100644
--- a/src/NL/glx/GXCompactColourMaterialProgramRender.cpp
+++ b/src/NL/glx/GXCompactColourMaterialProgramRender.cpp
@@ -66,5 +66,10 @@ void glxPrepareCompactColourPipeline(const glModelPacket& packet)
     ConfigureCompactColourPipelineState(program);
     program->BindVertexArrays(&packet);
     EmitAutomaticMaterialPipeline(packet);
+    // A new view deactivates the preceding material without resetting state.
+    // Scrolling detail Deactivate leaves TEX0 as an identity 3x4 generator;
+    // an ordinary material switch resets it to the 2x4 variant emitted above.
+    gxSetTexCoordGen(GX_TEXCOORD0, GX_TG_MTX3x4, GX_TG_TEX0, GX_IDENTITY);
+    EmitAutomaticMaterialPipeline(packet);
 }
 #endif
