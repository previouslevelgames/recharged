+#ifndef GAME_FE_FRONTEND_MAIN_MENU_STEPS_H
+#define GAME_FE_FRONTEND_MAIN_MENU_STEPS_H
+#include "Game/FE/FrontendSelectionSteps.h"
+
+// Selected original Main Menu visual and callback bodies. Host services and
+// resource/lifetime validation belong to callers; this is not scene readiness.
+template<class TLComponentInstance, class TLInstance, class TLImageInstance,
+         class TLTextInstance, template<class, int> class FEFinder, class Menu>
+void FrontendMainMenuVisualCreated(Menu& menu, bool japanese)
+{
+    const auto GetPresentation = [&]() { return menu.GetPresentation(); };
+    auto& mMenuItemInstances=menu.mMenuItemInstances;
+    auto& mMenuHighlights=menu.mMenuHighlights;
+    auto& mMenuGroups=menu.mMenuGroups;
+    auto& mMenuHitImages=menu.mMenuHitImages;
+    auto& mItemDescription=menu.mItemDescription;
+    GetPresentation()->SetActiveSlide("MAIN", true);
+    TLComponentInstance* hiddenItem;
+    if (japanese)
+    {
+        hiddenItem = FEFinder<TLComponentInstance, 4>::template Find<>(GetPresentation()->GetActiveSlide(), "Layer", "101_Menu_Item");
+        mMenuItemInstances[4] = FEFinder<TLComponentInstance, 4>::template Find<>(GetPresentation()->GetActiveSlide(), "Layer", "101_Menu_Item_jp");
+    }
+    else
+    {
+        hiddenItem = FEFinder<TLComponentInstance, 4>::template Find<>(GetPresentation()->GetActiveSlide(), "Layer", "101_Menu_Item_jp");
+        mMenuItemInstances[4] = FEFinder<TLComponentInstance, 4>::template Find<>(GetPresentation()->GetActiveSlide(), "Layer", "101_Menu_Item");
+    }
+
+    hiddenItem->SetVisible(false);
+
+    mMenuItemInstances[0] = FEFinder<TLComponentInstance, 4>::FindOrDefault(GetPresentation()->GetActiveSlide(), "Layer", "Domination_Menu_Item");
+    mMenuItemInstances[1] = FEFinder<TLComponentInstance, 4>::FindOrDefault(GetPresentation()->GetActiveSlide(), "Layer", "Online _Menu_Item");
+    mMenuItemInstances[2] = FEFinder<TLComponentInstance, 4>::FindOrDefault(GetPresentation()->GetActiveSlide(), "Layer", "RTSC_Menu_Item");
+    mMenuItemInstances[3] = FEFinder<TLComponentInstance, 4>::FindOrDefault(GetPresentation()->GetActiveSlide(), "Layer", "Challenges_Menu_Item");
+    mMenuItemInstances[6] = FEFinder<TLComponentInstance, 4>::FindOrDefault(GetPresentation()->GetActiveSlide(), "Layer", "Options_Menu_Item");
+    mMenuItemInstances[5] = FEFinder<TLComponentInstance, 4>::FindOrDefault(GetPresentation()->GetActiveSlide(), "Layer", "HOF_Menu_Item");
+
+    mMenuHighlights[0] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[0]->GetActiveSlide(), "GRUDGE");
+    mMenuHighlights[1] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[1]->GetActiveSlide(), "online");
+    mMenuHighlights[2] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[2]->GetActiveSlide(), "quest");
+    mMenuHighlights[3] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[3]->GetActiveSlide(), "scenario");
+    mMenuHighlights[6] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[6]->GetActiveSlide(), "HOF");
+    mMenuHighlights[4] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[4]->GetActiveSlide(), "HOF");
+    mMenuHighlights[5] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[5]->GetActiveSlide(), "HOF");
+
+    mMenuGroups[0] = FEFinder<TLInstance, 5>::template Find<>(mMenuHighlights[0], "off", "group");
+    mMenuGroups[1] = FEFinder<TLInstance, 5>::template Find<>(mMenuHighlights[1], "off", "group");
+    mMenuGroups[2] = FEFinder<TLInstance, 5>::template Find<>(mMenuHighlights[2], "off", "group");
+    mMenuGroups[3] = FEFinder<TLInstance, 5>::template Find<>(mMenuHighlights[3], "off", "group");
+    mMenuGroups[6] = FEFinder<TLInstance, 5>::template Find<>(mMenuHighlights[6], "off", "group");
+    mMenuGroups[4] = FEFinder<TLInstance, 5>::template Find<>(mMenuHighlights[4], "off", "group");
+    mMenuGroups[5] = FEFinder<TLInstance, 5>::template Find<>(mMenuHighlights[5], "off", "group");
+
+    mMenuHitImages[0] = FEFinder<TLImageInstance, 2>::FindOrDefault(mMenuGroups[0], "btn_main_domination");
+    mMenuHitImages[1] = FEFinder<TLImageInstance, 2>::FindOrDefault(mMenuGroups[1], "btn_main_online");
+    mMenuHitImages[2] = FEFinder<TLImageInstance, 2>::FindOrDefault(mMenuGroups[2], "btn_main_RTSC");
+    mMenuHitImages[3] = FEFinder<TLImageInstance, 2>::FindOrDefault(mMenuGroups[3], "btn_main_challenges");
+    mMenuHitImages[6] = FEFinder<TLImageInstance, 2>::FindOrDefault(mMenuGroups[6], "btn_main_OPTIONS");
+    mMenuHitImages[4] = FEFinder<TLImageInstance, 2>::FindOrDefault(mMenuGroups[4], "btn_main_101");
+    mMenuHitImages[5] = FEFinder<TLImageInstance, 2>::FindOrDefault(mMenuGroups[5], "btn_main_HOF");
+
+    mItemDescription = FEFinder<TLTextInstance, 3>::FindOrDefault(GetPresentation()->GetActiveSlide(), "Layer", "Text");
+}
+template<class TLComponentInstance, template<class, int> class FEFinder, class Menu>
+void FrontendMainMenuFindArrows(Menu& menu)
+{
+    const int NUM_ITEMS=Menu::NUM_ITEMS;
+    auto& mMenuArrows=menu.mMenuArrows;
+    auto& mMenuItemInstances=menu.mMenuItemInstances;
+    for (int i = 0; i < NUM_ITEMS; ++i)
+    {
+        mMenuArrows[i] = FEFinder<TLComponentInstance, 4>::FindOrDefault(mMenuItemInstances[i]->GetActiveSlide(), "arrows");
+    }
+}
+template<class Menu, class Audio>
+void FrontendMainMenuOpen(Menu& menu, unsigned int index, unsigned int item, Audio play_audio)
+{
+    auto& mHighlightedItemCounts=menu.mHighlightedItemCounts;
+    auto& mMenuItems=menu.mMenuItems;
+    auto& mMenuHighlights=menu.mMenuHighlights;
+    auto& mMenuArrows=menu.mMenuArrows;
+    ++mHighlightedItemCounts[index];
+    if (!mMenuItems[item].HasOtherPointerState(1, index))
+    {
+        mMenuHighlights[item]->SetActiveSlide("over", true, false);
+        mMenuArrows[item]->SetActiveSlide("over", true, false);
+        mMenuItems[item].SetPointerState(1, index);
+        play_audio(0x6B0689D4, 0, 0, true);
+    }
+}
+template<class Menu>
+void FrontendMainMenuClose(Menu& menu, unsigned int index, unsigned int item)
+{
+    auto& mHighlightedItemCounts=menu.mHighlightedItemCounts;
+    auto& mMenuItems=menu.mMenuItems;
+    auto& mMenuHighlights=menu.mMenuHighlights;
+    auto& mMenuArrows=menu.mMenuArrows;
+    --mHighlightedItemCounts[index];
+    if (!mMenuItems[item].HasOtherPointerState(1, index))
+    {
+        mMenuHighlights[item]->SetActiveSlide("off", true, false);
+        mMenuArrows[item]->SetActiveSlide("off", true, false);
+        mMenuItems[item].SetPointerState(0, index);
+    }
+}
+template<class MediaBuild, class Audio, class Online, class Apply>
+void FrontendMainMenuSelect(unsigned int item, MediaBuild media_build, Audio play_audio,
+                           Online select_online, Apply apply_item)
+{
+    if (media_build() && (item == 3 || item == 5 || item == 6))
+    {
+        play_audio(0x7326DD54, 0, 0, true);
+        return;
+    }
+
+    play_audio(0x0A93E9A0, 0, 0, true);
+    if (item == 1)
+    {
+        select_online();
+    }
+    else
+    {
+        apply_item(item);
+    }
+}
+template<class States>
+bool FrontendPointerHasOtherState(const States& mPointerStates, int value, unsigned int which)
+{
+    for (unsigned int i = 0; i < 4; i++)
+    {
+        if (i != which && value == mPointerStates[i])
+        {
+            return true;
+        }
+    }
+    return false;
+}
+template<class feVector3, class Menu>
+void FrontendMainMenuBind(Menu& menu, int i)
+{
+    auto& mMenuItemInstances=menu.mMenuItemInstances;
+    auto& mMenuGroups=menu.mMenuGroups;
+    auto& mMenuHitImages=menu.mMenuHitImages;
+    auto& mMenuItems=menu.mMenuItems;
+        feVector3 position = mMenuItemInstances[i]->GetAssetPosition();
+        feVector3 groupPosition = mMenuGroups[i]->GetAssetPosition();
+        float offsetX = position.f.x + groupPosition.f.x;
+        float offsetY = position.f.y + groupPosition.f.y;
+        mMenuItems[i].SetInstanceBounds(mMenuHitImages[i], true, offsetX, offsetY, 1.0f, 1.0f);
+}
+template<class TLSlide, class Component, class Finder>
+void FrontendMainComponentSelect(Component& component, unsigned long hash, bool arg2, bool arg3, Finder find_slide)
+{
+    auto& pChildren=component.pChildren;
+    auto& m_pActiveSlide=component.m_pActiveSlide;
+
+    TLSlide* slide = find_slide(pChildren, hash);
+    if (slide != 0)
+    {
+        FrontendSelectComponentTime(slide->m_time, arg2, slide != m_pActiveSlide, arg3);
+    }
+
+    m_pActiveSlide = slide;
+    if (slide != 0)
+    {
+        slide->Update(0.0f);
+    }
+
+}
+template<class SetVisible>
+void FrontendMainMenuDescription(bool mItemSelected, int highlighted_count, SetVisible set_visible)
+{
+    if (!mItemSelected)
+    {
+        if (highlighted_count > 0)
+        {
+            set_visible(false);
+        }
+        else
+        {
+            set_visible(true);
+        }
+    }
+}
+#endif
