+#ifdef MSCHARGED_NATIVE
+static void nlReleaseCompressedFileState(CompressedFileLoad* state)
+{
+    // Closing the original file joins/cancels every actual raw worker before
+    // its source read buffers and context can return to the original arena.
+    delete state->file;
+    if (state->ownsReadBuffers) nlFree(state->readBuffers[0]);
+    delete state;
+}
+
+static void nlAbortCompressedFileLoad(void* context)
+{
+    CompressedFileLoad* state = (CompressedFileLoad*)context;
+    state->nativeOutputWrite.Reset();
+    state->inflateState.Finish();
+    nlFree(state->output);
+    nlReleaseCompressedFileState(state);
+}
+
+static void nlDecodeCompressedFileSize(CompressedFileLoad* state)
+{
+    using namespace mscharged::platform;
+    GameCompletedSpan span{};
+    if (!FindGameCompletedSpan(&state->uncompressedSize, 4, span)
+        || FindGameByteDomain(&state->uncompressedSize, 4) != GameByteDomain::WiiSerialized)
+        throw std::runtime_error("Original compressed header has no completed Wii bytes");
+    GameByteWriteReservation nativeHeader(&state->uncompressedSize, 4);
+    const unsigned char* bytes = (const unsigned char*)&state->uncompressedSize;
+    unsigned int size = (unsigned int)bytes[0] << 24 | (unsigned int)bytes[1] << 16
+        | (unsigned int)bytes[2] << 8 | (unsigned int)bytes[3];
+    state->uncompressedSize = size;
+    nativeHeader.Complete(GameByteDomain::NativeHeader);
+}
+#endif
