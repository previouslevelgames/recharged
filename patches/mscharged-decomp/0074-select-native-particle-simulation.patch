 public:
     ParticleSystem(EffectsTemplate* pTemplate,
         nlDLListSlotPool<Particle*>* pFreeParticles, EffectsSpec* spec,
+        unsigned long resourceID)
+#ifdef MSCHARGED_NATIVE
+        = delete
+#endif
+        ;
+#ifdef MSCHARGED_NATIVE
+    // Explicit CPU-only construction; m_uTextureIndex stays invalid. The full
+    // constructor still requires an actual GL inventory on console.
+    struct NativeSimulation {};
+    ParticleSystem(NativeSimulation, EffectsTemplate* pTemplate,
+        nlDLListSlotPool<Particle*>* pFreeParticles, EffectsSpec* spec,
         unsigned long resourceID);
+#endif
     ~ParticleSystem();
 
     void UpdateCoordSys();
@@ -58,13 +70,21 @@
     void UpdateAllParticles(float dt, const nlMatrix4* pCoordSys);
     void UpdateLight(EffectsLight* pLight, Particle* pPart,
