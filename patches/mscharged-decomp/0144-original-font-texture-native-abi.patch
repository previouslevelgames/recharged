+#if defined(MSCHARGED_NATIVE)
+// Serialized Wii texture words stay big-endian and at their authored widths.
+// Decode only when the original platform code reads a field; pixel and palette
+// data following these records remain byte-identical to the disc payload.
+template <typename T>
+struct glTextureData
+{
+    static_assert(sizeof(T) == 2 || sizeof(T) == 4, "Wii texture scalar width");
+    u8 bytes[sizeof(T)];
+
+    operator T() const
+    {
+        u32 value = 0;
+        for (size_t i = 0; i < sizeof(T); ++i)
+            value = (value << 8) | bytes[i];
+        return static_cast<T>(value);
+    }
+
+    glTextureData& operator=(T value)
+    {
+        u32 word = static_cast<u32>(value);
+        for (size_t i = sizeof(T); i != 0; --i)
+        {
+            bytes[i - 1] = static_cast<u8>(word);
+            word >>= 8;
+        }
+        return *this;
+    }
+};
+typedef glTextureData<u32> glTextureDataWord;
+typedef glTextureData<u16> glTextureDataHalf;
+typedef glTextureData<eGXTextureFormat> glTextureDataFormat;
+#else
+typedef unsigned long glTextureDataWord;
+typedef unsigned short glTextureDataHalf;
+typedef eGXTextureFormat glTextureDataFormat;
+#endif
