From: mscharged-port native adaptation
Subject: [PATCH] Restore original ConstantColour and authored native RLG parameter fields
Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090

Preserve original source initialization, lookup, allocation, parameter selection
and Configure/Prepare order. Adapt only the two owned qualified scalar layouts;
retain historical material behavior only under an explicit legacy flag.

--- a/src/NL/gl/glLoadModel.cpp
+++ b/src/NL/gl/glLoadModel.cpp
@@ -13,6 +13,7 @@
 #include <string.h>
 #if defined(MSCHARGED_NATIVE)
 #include "platform/rlg_record_abi.h"
+#include "platform/rlg_material_parameters.h"
 #include "platform/game_allocation_ownership.h"
 #include <stdint.h>
 #endif
@@ -85,7 +86,11 @@
 void RLGReader::LoadPacketData(void* data, unsigned long size)
 {
     m_pParameterData = glResourceAlloc(size, GLM_Header, m_pResource);
+#if defined(MSCHARGED_NATIVE)
+    mscharged::platform::CopyRLGMaterialParameterBytes(m_pParameterData, data, size);
+#else
     memcpy(m_pParameterData, data, size);
+#endif
 }
 
 void RLGReader::LoadStreams(void* data, unsigned long size)
