diff --git a/include/Game/FE/FrontendImageSteps.h b/include/Game/FE/FrontendImageSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendImageSteps.h
@@ -0,0 +1,36 @@
+#ifndef GAME_FE_FRONTEND_IMAGE_STEPS_H
+#define GAME_FE_FRONTEND_IMAGE_STEPS_H
+#include "NL/nlMath.h"
+
+static const nlVector3 FrontendImageQuadPositions[4] = {
+    { -50.0f, 50.0f, 0.0f },
+    { -50.0f, -50.0f, 0.0f },
+    { 50.0f, -50.0f, 0.0f },
+    { 50.0f, 50.0f, 0.0f },
+};
+
+// Original ordinary image/callback UVs. Native callers validate positive
+// dimensions and bounded finite effective UV attributes before entering.
+template <class Image>
+void FrontendImageUV(const Image* pTLImageInstance, unsigned short width,
+                     unsigned short height, nlVector2 (&uv)[4])
+{
+    float halfPixelU = 0.5f / (float)(s32)width;
+    float halfPixelV = 0.5f / (float)(s32)height;
+    float left = pTLImageInstance->GetUVX();
+    float uvY = pTLImageInstance->GetUVY();
+    float uvH = pTLImageInstance->GetUVHeight();
+    float bottom = 1.0f - (uvH + uvY);
+    float right = left + pTLImageInstance->GetUVWidth();
+    float top = 1.0f - pTLImageInstance->GetUVY();
+
+    uv[0].x = left + halfPixelU;
+    uv[0].y = bottom + halfPixelV;
+    uv[1].x = left + halfPixelU;
+    uv[1].y = top - halfPixelV;
+    uv[2].x = right - halfPixelU;
+    uv[2].y = top - halfPixelV;
+    uv[3].x = right - halfPixelU;
+    uv[3].y = bottom + halfPixelV;
+}
+#endif
