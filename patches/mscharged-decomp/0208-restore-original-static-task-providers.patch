Subject: [PATCH] restore original frontend pointer task and native static providers

Upstream-base: 2c5c51e483b652d178ef06a44b83b07a0f97d2a6

Restore literal feDPD source and isolate pointer/timing extracts from the original
module. Use one native SDK GX/VI/DVD declaration ABI, retain genuine Wii
power/reset requests, and declare unavailable IPC MMIO instead of allocating
fake registers. Keep Wii class-size assertions on the console ABI and transport
the original BeginFrameTask view pointer through its existing native enum carrier.
No task/game decisions, initialization requests, visibility or behavior changes.

The new owning vi_fwd.h uses the same canonical native VI service as vi.h.
Original console enum prototypes remain literal; no Title method or SDK body changes.

diff --git a/src/Game/FE/feDPD.cpp b/src/Game/FE/feDPD.cpp
--- a/src/Game/FE/feDPD.cpp
+++ b/src/Game/FE/feDPD.cpp
@@ -6,7 +6,6 @@
 #include "NL/plat/WiiFreestylePad.h"
 
 #include "Game/FE/feDPD.h"
-#include "Game/FE/FrontendPointerHostSteps.h"
 
 #include "Game/FE/feInput.h"
 #include "Game/PadActions.h"
@@ -28,7 +27,20 @@
 
 static inline void ClampPointerPosition(int pad, nlVector2 position, int width, int height)
 {
-    gFEPointerPositions[pad] = FrontendClampPointerPosition(position, width, height);
+    int maxX = width / 2 - 20;
+    int minX = -width / 2 + 20;
+    int maxY = height / 2 - 5;
+    int minY = -height / 2 + 5;
+
+    if (position.x <= maxX && position.x >= minX)
+        gFEPointerPositions[pad].x = position.x;
+    else
+        gFEPointerPositions[pad].x = (float)(position.x > maxX ? maxX : minX);
+
+    if (position.y <= maxY && position.y >= minY)
+        gFEPointerPositions[pad].y = position.y;
+    else
+        gFEPointerPositions[pad].y = (float)(position.y > maxY ? maxY : minY);
 }
 
 FEDPDTask::FEDPDTask()
@@ -109,7 +121,8 @@
         if (data->mValidFlag > 0)
         {
             data->GetPosition(&position, angle);
-            FrontendDPDToAssetPosition(position, width, height);
+            position.x = -1.0f * (position.x * (float)width / 2.0f);
+            position.y = position.y * (float)height / 2.0f;
             *valid = true;
 
             ClampPointerPosition(pad, position, width, height);
