Subject: Match native ODE allocation handler size types
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Native ODE uses size_t. Keep console declarations and allocator bodies unchanged.
The native host preflights allocation/copy operands against the actual unsigned-long NL carrier
before any request. Requires src/platform/native_ode_allocation_size.h from this proposal.

diff --git a/include/Game/Physics/Physics.h b/include/Game/Physics/Physics.h
index 68b8292..5365c3c 100644
--- a/include/Game/Physics/Physics.h
+++ b/include/Game/Physics/Physics.h
@@ -1,6 +1,9 @@
 #ifndef GAME_PHYSICS_PHYSICS_H
 #define GAME_PHYSICS_PHYSICS_H
 
+#if defined(MSCHARGED_NATIVE)
+#include <stddef.h>
+#endif
 #include "Game/Physics/PhysicsWorld.h"
 #include "NL/nlListContainer.h"
 
@@ -16,9 +19,15 @@ void CreateStaticPhysicsPrimitives();
 void DestroyStaticPhysicsPrimitives();
 void DestroyPhysicsWorld();
 void PhysicsUpdate(PhysicsWorld*, float);
+#if defined(MSCHARGED_NATIVE)
+void ODEFree(void*, size_t);
+void* ODERealloc(void*, size_t, size_t);
+void* ODEAlloc(size_t);
+#else
 void ODEFree(void*, unsigned long);
 void* ODERealloc(void*, unsigned long, unsigned long);
 void* ODEAlloc(unsigned long);
+#endif
 
 extern PhysicsMesh* g_TerrainMesh;
 extern PhysicsWorld* g_PhysicsWorld;
diff --git a/src/Game/Physics.cpp b/src/Game/Physics.cpp
index 8650fbb..221c17c 100644
--- a/src/Game/Physics.cpp
+++ b/src/Game/Physics.cpp
@@ -1,4 +1,7 @@
 #include "Game/Physics/Physics.h"
+#if defined(MSCHARGED_NATIVE)
+#include "platform/native_ode_allocation_size.h"
+#endif
 #include <cstring>
 #include "Game/Physics/PhysicsEventQueue.h"
 
@@ -32,13 +35,28 @@ nlListContainer<PhysicsObject*> g_NetPhysicsObjects;
 static cInventory<LoadablePhysicsMesh> s_PhysicsMeshes;
 static PhysicsRoundedCorner* corners[4];
 
+#if defined(MSCHARGED_NATIVE)
+void* ODEAlloc(size_t size)
+#else
 void* ODEAlloc(unsigned long size)
+#endif
 {
+#if defined(MSCHARGED_NATIVE)
+    size = mscharged::platform::NativeODEAllocationSize(size);
+#endif
     return nlMalloc(size, 8, false);
 }
 
+#if defined(MSCHARGED_NATIVE)
+void* ODERealloc(void* oldPtr, size_t oldSize, size_t newSize)
+#else
 void* ODERealloc(void* oldPtr, unsigned long oldSize, unsigned long newSize)
+#endif
 {
+#if defined(MSCHARGED_NATIVE)
+    oldSize = mscharged::platform::NativeODEAllocationSize(oldSize);
+    newSize = mscharged::platform::NativeODEAllocationSize(newSize);
+#endif
     void* newPtr = nlMalloc(newSize, 8, false);
     if (oldSize != 0)
     {
@@ -48,7 +66,11 @@ void* ODERealloc(void* oldPtr, unsigned long oldSize, unsigned long newSize)
     return newPtr;
 }
 
+#if defined(MSCHARGED_NATIVE)
+void ODEFree(void* ptr, size_t)
+#else
 void ODEFree(void* ptr, unsigned long)
+#endif
 {
     nlFree(ptr);
 }
