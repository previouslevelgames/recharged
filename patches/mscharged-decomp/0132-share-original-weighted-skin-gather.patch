Subject: Share original per-bone weighted skin pair gathering
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Preserve bone/vertex/lane order, first-zero termination, exact authored weights
and original rigidSkin updates. Native callers validate scratch capacity and
retained input storage. This does not select software deformation or rendering.

diff --git a/include/Game/GL/SkinPoseSteps.h b/include/Game/GL/SkinPoseSteps.h
index c4afe3f..edbb852 100644
--- a/include/Game/GL/SkinPoseSteps.h
+++ b/include/Game/GL/SkinPoseSteps.h
@@ -56,4 +56,41 @@ inline void SkinCopyPoseMatrix(float (&destination)[3][4], const nlMatrix4& pose
 {
     glxCopyMatrix(destination, pose);
 }
+// Exact per-bone loop from ShaderSkinMesh::BuildPacketSkinData. The caller
+// must validate indices and the original 2*numVertices scratch capacity first.
+template <class Pair, class IndexRow, class WeightRow>
+inline int SkinGatherBoneWeights(Pair* pairs, unsigned long bone,
+    unsigned long numVertices, const IndexRow* indices,
+    const WeightRow* weights, bool& rigidSkin)
+{
+    const IndexRow* pIndices = indices;
+    const WeightRow* pWeights = weights;
+    Pair* pPair = pairs;
+    int numPairs = 0;
+    for (unsigned long j = 0; j < numVertices; j++)
+    {
+        if (0.0f != (*pWeights)[1])
+        {
+            rigidSkin = false;
+        }
+        for (unsigned long k = 0; k < 4; k++)
+        {
+            float weight = (*pWeights)[k];
+            if (0.0f == weight)
+            {
+                break;
+            }
+            if (bone == (*pIndices)[k])
+            {
+                pPair->vertexIndex = j;
+                pPair->vertexWeight = weight;
+                pPair++;
+                numPairs++;
+            }
+        }
+        pIndices++;
+        pWeights++;
+    }
+    return numPairs;
+}
 #endif
