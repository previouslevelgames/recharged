 }
+#endif
 
 static int fn_801BF4EC()
 {
@@ -2159,7 +2166,12 @@
     UncompressLidMessage(datastart, datasize, expanded, expandedSize);
 
     GXPokeColorUpdate(1);
+#if defined(MSCHARGED_NATIVE)
+    GXPokeBlendMode(static_cast<GXBlendMode>(0), static_cast<GXBlendFactor>(1),
