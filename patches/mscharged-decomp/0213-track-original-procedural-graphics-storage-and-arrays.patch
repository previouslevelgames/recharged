diff --git a/include/Game/GL/GLTexturedColourMeshWriter.h b/include/Game/GL/GLTexturedColourMeshWriter.h
index 4c63ded..b4b68dd 100644
--- a/include/Game/GL/GLTexturedColourMeshWriter.h
+++ b/include/Game/GL/GLTexturedColourMeshWriter.h
@@ -45,7 +45,17 @@ public:
 #ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
         NativeCheckWrite(writtenColour);
 #endif
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+        // This source argument is a numeric Wii RGBA word, whose four bytes
+        // must retain the original big-endian channel order on the host.
+        const u32 word = static_cast<u32>(nColourPlat);
+        const unsigned char rgba[4] = { static_cast<unsigned char>(word >> 24),
+            static_cast<unsigned char>(word >> 16), static_cast<unsigned char>(word >> 8),
+            static_cast<unsigned char>(word) };
+        std::memcpy(colour++, rgba, sizeof(rgba));
+#else
         *colour++ = nColourPlat;
+#endif
     }
 
     void Texcoord(const nlVector2& uv)
