+#ifndef GAME_FE_FRONTEND_VISUAL_OPTIONS_STEPS_H
+#define GAME_FE_FRONTEND_VISUAL_OPTIONS_STEPS_H
+// Selected original mode0 scene15 kernels; game/save/camera services stay explicit.
+template<class Scene,class Settings>
+void FrontendVisualOptionsInitialize(Scene& scene,const Settings& settings)
+{
+    scene.mSettings[0] = !settings.mIsAutoZoomCamera;
+    scene.mSettings[1] = (int)(4.0f * settings.mCameraZoomLevel);
+    scene.mNavigation.SetPopScene(false);
+    scene.mBackupSettings[0] = scene.mSettings[0];
+    scene.mBackupSettings[1] = scene.mSettings[1];
+}
+template<class TLInstance,class TLComponentInstance,class TLTextInstance,template<class,int>class FEFinder,class Scene,class Wait,class Name,class Text>
+void FrontendVisualOptionsCreated(Scene& scene,Wait waitPointer,Name nameButton,Text formatText)
+{
+    auto* presentation = scene.mPresentation;
+    if (scene.mOverlayMode == 0)
+    {
+        FEFinder<TLInstance, 2>::template Find<>(presentation,
+            "OPTIONS_IN", "Layer", "blackbox")->m_bVisible = false;
+        FEFinder<TLInstance, 2>::template Find<>(presentation,
+            "OPTIONS_OUT", "Layer", "blackbox")->m_bVisible = false;
+    }
+
+    for (int i = 0; i < 4; ++i)
+        waitPointer(i);
+
+    for (int i = 0; i < 5; ++i)
+    {
+        char name[12];
+        nameButton(name, 12, i);
+        scene.mButtons[i] = FEFinder<TLComponentInstance, 4>::template Find<>(presentation,
+            "OPTIONS_IN", "Layer", "visual_options", "ZOOM LEVELS", name);
+    }
+    scene.mZoomButtons[0] = FEFinder<TLComponentInstance, 4>::template Find<>(presentation,
+        "OPTIONS_IN", "Layer", "visual_options", "BTN_AUTOZOOM");
+    scene.mZoomButtons[1] = FEFinder<TLComponentInstance, 4>::template Find<>(presentation,
+        "OPTIONS_IN", "Layer", "visual_options", "MANUAL_ZOOM");
+
+    scene.mZoomButtons[scene.mSettings[0]]->SetActiveSlide("down", true, false);
+    auto& zoomButton = scene.mZoomButtonComponents[scene.mSettings[0]];
+    for (int i = 0; i < 4; ++i)
+        zoomButton.SetPointerState(2, i);
+    scene.mButtons[scene.mSettings[1]]->SetActiveSlide("down", true, false);
+    auto& button = scene.mButtonComponents[scene.mSettings[1]];
+    for (int i = 0; i < 4; ++i)
+        button.SetPointerState(2, i);
+
+    TLTextInstance* text = FEFinder<TLTextInstance, 4>::Find(
+        scene.mPresentation->m_currentSlide, "Layer", "visual_options", "SERIES SETTING");
+    formatText(text,scene.mSettings[1] + 1);
+}
+template<class Button,class Instance,class Position>
+void FrontendVisualOptionsLevelBounds(Button& button,Instance* instance,const Position& position)
+{button.SetInstanceBounds(instance,true,position.f.x,position.f.y,1.0f,1.0f);}
+template<class Button,class Instance>
+void FrontendVisualOptionsModeBounds(Button& button,Instance* instance)
+{button.SetInstanceBounds(instance,true,0.0f,0.0f,1.0f,1.0f);}
+template<class TLInstance,class feVector3,template<class,int>class FEFinder,class Scene>
+void FrontendVisualOptionsBind(Scene& scene)
+{    TLInstance* levels = FEFinder<TLInstance, 2>::template Find<>(scene.mPresentation,
+        "OPTIONS_IN", "Layer", "visual_options", "ZOOM LEVELS");
+    feVector3 position = levels->GetAssetPosition();
+    for (int i=0;i<5;++i)
+        FrontendVisualOptionsLevelBounds(scene.mButtonComponents[i],scene.mButtons[i],position);
+    for (int i=0;i<2;++i)
+        FrontendVisualOptionsModeBounds(scene.mZoomButtonComponents[i],scene.mZoomButtons[i]);
+}
+template<class Scene,class Play>
+void FrontendVisualOptionsLevelEnter(Scene& scene,int index,unsigned int item,Play play)
+{
+    if (!scene.mButtonComponents[item].HasOtherPointerState(2, -1))
+    {
+        scene.mButtonComponents[item].PlayHoverFeedback(index);
+        if (!scene.mButtonComponents[item].HasOtherPointerState(1, index))
+        {
+            scene.mButtons[item]->SetActiveSlide("over", true, false);
+            play(0x96DEB5C3, 0, 0, 1);
+        }
+        scene.mButtonComponents[item].SetPointerState(1, index);
+    }
+}
+template<class Scene>
+void FrontendVisualOptionsLevelLeave(Scene& scene,int index,unsigned int item)
+{
+    if (!scene.mButtonComponents[item].HasOtherPointerState(2, -1))
+    {
+        if (!scene.mButtonComponents[item].HasOtherPointerState(1, index))
+        {
+            scene.mButtons[item]->SetActiveSlide("off", true, false);
+        }
+        scene.mButtonComponents[item].SetPointerState(0, index);
+    }
+}
+template<class Scene,class Visual,class Play,class Text>
+void FrontendVisualOptionsLevelPress(Scene& scene,int index,unsigned int item,Visual visual,Play play,Text formatText)
+{
+    if (scene.mButtonComponents[item].HasOtherPointerState(2, -1))
+        return;
+
+    play(0x3021A1EE, 0, 0, 1);
+    scene.mButtons[scene.mSettings[1]]->SetActiveSlide("off", true, false);
+    scene.mButtonComponents[scene.mSettings[1]].ResetPointerStates();
+    scene.mButtons[item]->SetActiveSlide("down", true, false);
+    for (int i = 0; i < 4; ++i)
+        scene.mButtonComponents[item].SetPointerState(2, i);
+    scene.mSettings[1] = item;
+    visual().mCameraZoomLevel = item / 4.0;
+
+    formatText(scene.mSettings[1] + 1);
+}
+template<class Scene,class Play>
+void FrontendVisualOptionsModeEnter(Scene& scene,int index,unsigned int item,Play play)
+{
+    if ((unsigned int)scene.mSettings[0] == item
+        || scene.mZoomButtonComponents[item].HasOtherPointerState(2, -1))
+    {
+        return;
+    }
+
+    scene.mZoomButtonComponents[item].PlayHoverFeedback(index);
+    if (!scene.mZoomButtonComponents[item].HasOtherPointerState(1, index))
+    {
+        scene.mZoomButtons[item]->SetActiveSlide("over", true, false);
+        play(0xF6EB899E, 0, 0, 1);
+    }
+    scene.mZoomButtonComponents[item].SetPointerState(1, index);
+}
+template<class Scene>
+void FrontendVisualOptionsModeLeave(Scene& scene,int index,unsigned int item)
+{
+    if ((unsigned int)scene.mSettings[0] == item
+        || scene.mZoomButtonComponents[item].HasOtherPointerState(2, -1))
+    {
+        return;
+    }
+    if (!scene.mZoomButtonComponents[item].HasOtherPointerState(1, index))
+    {
+        scene.mZoomButtons[item]->SetActiveSlide("off", true, false);
+    }
+    scene.mZoomButtonComponents[item].SetPointerState(0, index);
+}
+template<class Scene,class Visual,class Play,class Text>
+void FrontendVisualOptionsModePress(Scene& scene,int index,unsigned int item,Visual visual,Play play,Text formatText)
+{
+    if ((unsigned int)scene.mSettings[0] == item
+        || scene.mZoomButtonComponents[item].HasOtherPointerState(2, -1))
+        return;
+
+    scene.mZoomButtons[scene.mSettings[0]]->SetActiveSlide("off", true, false);
+    scene.mZoomButtonComponents[scene.mSettings[0]].ResetPointerStates();
+    scene.mZoomButtons[item]->SetActiveSlide("down", true, false);
+    for (int i = 0; i < 4; ++i)
+        scene.mZoomButtonComponents[item].SetPointerState(2, i);
+    play(0x362F2841, 0, 0, 1);
+    scene.mSettings[0] = item;
+    visual().mIsAutoZoomCamera = item == 0;
+
+    formatText(scene.mSettings[1] + 1);
+}
+template<class Scene,class Navigation,class Wait,class Push,class Overlay>
+bool FrontendVisualOptionsGate(Scene& scene,Navigation getNavigation,Wait waitPointer,Push push,Overlay pushOverlay)
+{    if (scene.mState == 0 || scene.mState == 2 || scene.mState == 3)
+    {
+        auto* slide = scene.mPresentation->m_currentSlide;
+        if (slide->GetCurrentTime() < slide->GetStartTime() + slide->GetDuration())
+        {
+            for (int i = 0; i < 4; ++i)
+                waitPointer(i);
+            return false;
+        }
+
+        if (scene.mState == 0)
+        {
+            auto* navigation = getNavigation();
+            if (navigation != 0)
+            {
+                navigation->SetButtons(0x24, true);
+                navigation->SetDoneButtonText(1);
+            }
+            scene.mState = 1;
+        }
+        else if (scene.mState == 2)
+        {
+            return false;
+        }
+        else if (scene.mState == 3)
+        {
+            if (scene.mOverlayMode == 0)
+                push(13);
+            else
+                pushOverlay(0x50);
+            return false;
+        }
+    }
+
+    return true;
+}
+template<class Scene,class Visual,class Play,class Navigation>
+void FrontendVisualOptionsBack(Scene& scene,Visual visual,Play play,Navigation getNavigation)
+{            visual().mCameraZoomLevel = scene.mBackupSettings[1] / 4.0;
+            visual().mIsAutoZoomCamera = scene.mBackupSettings[0] == 0;
+            play(0x304FDD1E, 0, 0, 1);
+            scene.mState = 3;
+            auto* navigation = getNavigation();
+            if (navigation != 0)
+                navigation->SetButtons(0, true);
+            scene.mPresentation->SetActiveSlide("OPTIONS_OUT", true);
+            scene.mPresentation->Update(0.0f);
+}
+template<class Scene,class Navigation,class Play,class Save>
+void FrontendVisualOptionsSave(Scene& scene,Navigation getNavigation,Play play,Save save)
+{
+    scene.mState = 3;
+    auto* navigation = getNavigation();
+    if (navigation != 0)
+    {
+        navigation->SetButtons(0, true);
+    }
+    scene.mPresentation->SetActiveSlide("OPTIONS_OUT", true);
+    scene.mPresentation->Update(0.0f);
+    scene.mSaveButton->SetActiveSlide("down", true, false);
+    play(0xF0AFD586, 0, 0, 1);
+    play(0x304FDD1E, 0, 0, 1);
+    scene.mSaveStarted = true;
+    save(false);
+}
+#endif
