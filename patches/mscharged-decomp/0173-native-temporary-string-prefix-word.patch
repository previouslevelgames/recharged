Subject: Preserve native four-byte temporary-string size prefixes
Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a

The original prefix geometry and retail memcpy/lwz transport are four bytes.
Use a native fixed-width word for New and the ReadSize compiler scratch value,
retaining the original count, +4 payload offset, pool/free thresholds and console
projection. This does not qualify native BasicString Data alignment or teardown.

diff --git a/include/NL/nlString.h b/include/NL/nlString.h
--- a/include/NL/nlString.h
+++ b/include/NL/nlString.h
@@ -156,7 +156,11 @@
     static T* New(int count, const char*)
     {
         void* ptr = sTempStringAllocatorPool.allocator.pool.Allocate(count * sizeof(T) + 4);
+#if defined(MSCHARGED_NATIVE)
+        u32 size = count * sizeof(T);
+#else
         unsigned long size = count * sizeof(T);
+#endif
         memcpy(ptr, &size, sizeof(size));
         return (T*)((char*)ptr + 4);
     }
@@ -184,10 +188,17 @@
 private:
     static unsigned long ReadSize(const void* ptr)
     {
+#if defined(MSCHARGED_NATIVE)
+        // The original prefix and retail word load are exactly four bytes.
+        u32 size;
+        memcpy(&size, (const char*)ptr - 4, sizeof(size));
+        return size;
+#else
         // The prefix reader uses a byte-sized local for a four-byte copy.
         char size;
         memcpy(&size, (const char*)ptr - 4, 4);
         return *(unsigned long*)&size;
+#endif
     }
 };
 
