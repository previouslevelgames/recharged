Subject: [PATCH] Share original bounded controller time, completion and identity steps
Upstream-base: 2c5c51e483b652d178ef06a44b83b07a0f97d2a6

Retain original console effects/system/manager services. Native port adapters
reuse only these state equations while qualifying retained emitter-only groups.

diff --git a/include/Game/Effects/EmissionControllerSteps.h b/include/Game/Effects/EmissionControllerSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/Effects/EmissionControllerSteps.h
@@ -0,0 +1,74 @@
+#ifndef GAME_EFFECTS_EMISSION_CONTROLLER_STEPS_H
+#define GAME_EFFECTS_EMISSION_CONTROLLER_STEPS_H
+#include "NL/nlMath.h"
+
+// Original controller update prefix. False preserves the original early return
+// before particle/user systems are visited; dt is the scaled/replay step.
+template<class Controller>
+bool fxBeginControllerUpdate(Controller& controller, float& dt)
+{
+    if (controller.m_bDisabled)
+    {
+        return false;
+    }
+
+    dt *= controller.m_TimeScale;
+
+    if (controller.m_Replaying)
+    {
+        dt = controller.m_ReplayDeltaTime;
+    }
+    else
+    {
+        controller.m_Age += dt;
+    }
+
+    bool positionChanged = false;
+    if (controller.mUpdateCallback)
+    {
+        nlVector3 oldPosition = controller.m_vPosition;
+        controller.mUpdateCallback(controller);
+        if (!nlNear(controller.m_vPosition, oldPosition))
+        {
+            positionChanged = true;
+        }
+    }
+
+    if (dt <= 0.0f)
+    {
+        if (positionChanged)
+        {
+            dt = 0.0f;
+        }
+        else
+        {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+template<class Controller>
+bool fxControllerSystemsFinished(Controller& controller, int numSys, int numDel)
+{
+    bool isFinished = numSys == numDel;
+    if (isFinished && controller.mFinishedCallback)
+        controller.mFinishedCallback(controller, 1);
+    return isFinished;
+}
+
+inline bool fxBeginControllerDie(bool& dying)
+{
+    if (dying) return false;
+    dying = true;
+    return true;
+}
+
+inline unsigned short fxNextControllerId(int& next, unsigned short requested)
+{
+    if (requested == 0) requested = next++;
+    if (next > 0x7E16) next = 1;
+    return requested;
+}
+#endif
