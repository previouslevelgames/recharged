 #endif
@@ -265,6 +269,27 @@ void SHOnlineFriendCodeEntry::Update(float fDeltaT)
         return;
     }
 
+#if defined(MSCHARGED_NATIVE)
+    // The keyboard presses the keypad as the pointer would, a key a frame (a
+    // pasted code types itself in).
+    const int key = MSChargedTakeFriendCodeKey();
