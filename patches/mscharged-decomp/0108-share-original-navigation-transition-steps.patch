diff --git a/include/Game/FE/FrontendNavigationTransitionSteps.h b/include/Game/FE/FrontendNavigationTransitionSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendNavigationTransitionSteps.h
@@ -0,0 +1,61 @@
+#ifndef GAME_FE_FRONTEND_NAVIGATION_TRANSITION_STEPS_H
+#define GAME_FE_FRONTEND_NAVIGATION_TRANSITION_STEPS_H
+// Original eight-door reset and transition update fragments. The command call
+// belongs between Show and Finish, exactly as in SHNavigation::Update.
+template<class TLComponentInstance,class TLSlide,template<class,int>class FEFinder,class Scene>
+void FrontendNavigationStartTransition(Scene& scene)
+{
+    scene.mTransition->SetActiveSlide("Slide1", true, false);
+
+    TLComponentInstance* component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_1");
+    component->SetActiveSlide("Slide1", true, false);
+
+    component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_2");
+    component->SetActiveSlide("Slide1", true, false);
+
+    component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_3");
+    component->SetActiveSlide("Slide1", true, false);
+
+    component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_4");
+    component->SetActiveSlide("Slide1", true, false);
+
+    component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_5");
+    component->SetActiveSlide("Slide1", true, false);
+
+    component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_6");
+    component->SetActiveSlide("Slide1", true, false);
+
+    component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_7");
+    component->SetActiveSlide("Slide1", true, false);
+
+    component = FEFinder<TLComponentInstance, 4>::template Find<TLSlide>(
+        scene.mTransition->GetActiveSlide(), "Group", "door_8");
+    component->SetActiveSlide("Slide1", true, false);
+
+    scene.mTransitionPlaying = true;
+    scene.mTransitionPending = true;
+}
+template<class Scene>
+void FrontendNavigationShowTransition(Scene& scene)
+{
+    scene.mTransition->m_bVisible = true;
+    scene.mTransitionPending = false;
+}
+template<class Scene>
+void FrontendNavigationFinishTransition(Scene& scene,bool& sPointerInputEnabled,bool sPointerHidden)
+{
+        if (scene.mTransition->GetActiveSlide()->m_time >= 0.6f)
+        {
+            scene.mTransition->m_bVisible = false;
+            scene.mTransitionPlaying = false;
+            sPointerInputEnabled = !sPointerHidden;
+        }
+}
+#endif
