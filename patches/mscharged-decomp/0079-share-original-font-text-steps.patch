+class OriginalFontPageSink
+{
+public:
+    OriginalFontPageSink(const nlFont& font, GLView* view, glPoly2* quads,
+        glMatrixHandle* matrix, bool effect)
+        : m_Font(font), m_View(view), m_Quads(quads), m_Current(quads), m_Matrix(matrix), m_Effect(effect) {}
+    void BeginPage(unsigned long page)
+    {
+        glSetCurrentTexture((m_Effect ? m_Font.m_EffectTextureHandles : m_Font.m_TextureHandles)[page], GLTT_Diffuse);
+    }
+    void Quad(const FontTextQuad& quad)
+    {
+        for (int i = 0; i < 4; ++i) { m_Current->m_pos[i] = quad.m_pos[i]; m_Current->m_uv[i] = quad.m_uv[i]; }
+        m_Current->depth = 0.0f;
+        m_Current->SetColour(quad.colour);
+        ++m_Current;
+    }
+    void EndPage()
+    {
+        unsigned long count = (unsigned long)(m_Current - m_Quads);
+        if (count != 0)
+        {
+            if (m_Font.m_bScissorBox)
+            {
+                nlVector4 scissor;
+                scissor.x = m_Font.m_scissorBox.X; scissor.y = m_Font.m_scissorBox.Y;
+                scissor.z = m_Font.m_scissorBox.Width; scissor.w = m_Font.m_scissorBox.Height;
+                glAttachPoly2(m_View, 0, count, m_Quads, &scissor, m_Matrix);
+            }
+            else glAttachPoly2(m_View, 0, count, m_Quads, m_Matrix);
+        }
+        m_Current = m_Quads;
+    }
+private:
+    const nlFont& m_Font;
+    GLView* m_View;
+    glPoly2* m_Quads;
+    glPoly2* m_Current;
+    glMatrixHandle* m_Matrix;
+    bool m_Effect;
+};
