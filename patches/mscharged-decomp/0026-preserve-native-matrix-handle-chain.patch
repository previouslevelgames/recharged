@@ -466,3 +466,37 @@
     return glGetCurrentResourcePool()->GetFreeMemory();
 #endif
 }
+
+#if defined(MSCHARGED_NATIVE)
+void glplatValidateMatrix(glMatrixHandle matrix)
+{
+    if (!matrix || matrix == GL_INVALID_MATRIX || (matrix & 31))
+        throw std::invalid_argument("Invalid native matrix address");
+    // Active frame handles expire at FrameNext. Resource handles expire when
+    // their storage is rewound or destroyed. Addresses can be reused later.
+    const unsigned long size = sizeof(nlMatrix4);
+    if (sFrameMemoryInitialized && matrix >= p_frame[i_frame][0])
+    {
+        glMatrixHandle offset = matrix - p_frame[i_frame][0];
+        if (offset <= n_frame[i_frame][0] && size <= n_frame[i_frame][0] - offset)
+            return;
+    }
+    GLResourcePool* first = glGetResourcePools();
+    if (first)
+    {
+        GLResourcePool* item = first;
+        do
+        {
+            GLXResourcePool* pool = dynamic_cast<GLXResourcePool*>(item);
+            if (pool && matrix >= pool->mPoolMemory[0])
+            {
+                glMatrixHandle offset = matrix - pool->mPoolMemory[0];
+                if (offset <= pool->mUsedMemory[0] && size <= pool->mUsedMemory[0] - offset)
+                    return;
+            }
+            item = item->m_next;
+        } while (item != first);
+    }
+    throw std::invalid_argument("Matrix address is outside live GL storage");
+}
+#endif
