+
+float AdjustFOVForWidescreen(float fFOV)
+{
+    if (!std::isfinite(fFOV) || fFOV <= 0 || fFOV >= 180) throw std::invalid_argument("Invalid camera FOV");
+    float fTan = nlTan((u16)(((int)(65536.0f * (0.5f * fFOV))) / 360));
+    float widescreenAspect = GetWidescreenAspectRatio();
+    float standardAspect = GetStandardAspectRatio();
+    float halfFovRadians = nlATan((fTan * standardAspect) / widescreenAspect);
+    return 2.0f * ((180.0f * halfFovRadians) / 3.1415927f);
+}
+
+namespace mscharged {
+void UpdateNativeCameraPose(float fDeltaT, float simulationDelta)
+{
+    if (!cCameraManager::m_cameraStack) return;
+    if (cCameraManager::m_UpVectorStackSize < 0 || cCameraManager::m_UpVectorStackSize > 1)
+        throw std::out_of_range("Camera up-vector index is invalid");
+    nlMatrix4 cameraToWorldMatrix;
+    nlMatrix4 curViewCopy;
+    nlVector3 viewZAxis;
+    cBaseCamera* pCamera = nlDLRingGetStart<cBaseCamera>(cCameraManager::m_cameraStack);
+    if (pCamera->GetType() == eCameraType_Gameplay)
+    {
+        if (cCameraManager::m_transition != eCT_EASE_IN)
+        {
+            pCamera->mUpVector = cCameraManager::m_UpVectorStack[cCameraManager::m_UpVectorStackSize];
+        }
+        else
+        {
+            pCamera->mUpVector.x = 0.0f;
+            pCamera->mUpVector.y = 0.0f;
+            pCamera->mUpVector.z = 1.0f;
+        }
+    }
+
+    pCamera->Update(fDeltaT);
+    mscharged::CheckCameraPose(*pCamera);
+    for (int i = 0; i < 2; i++)
+    {
+        if (pCamera->m_pFilter[i] != 0)
+            pCamera->m_pFilter[i]->Update(fDeltaT);
+    }
+
+    if (cCameraManager::m_transition != eCT_NONE)
+    {
+        switch (cCameraManager::m_transition)
+        {
+        case eCT_EASE_IN:
+            UpdateCameraTransitionImpl(simulationDelta);
+            nlInvertRotTransMatrix(cameraToWorldMatrix, cCameraManager::m_matView);
+            cCameraManager::m_cameraPosition = cameraToWorldMatrix.GetTranslation();
+            break;
+        default:
+            break;
+        }
+    }
+    else
+    {
+        cCameraManager::m_matView = pCamera->GetViewMatrix();
+        cCameraManager::m_cameraPosition = pCamera->GetCameraPosition();
+        cCameraManager::m_fFOV = pCamera->GetFOV();
+        if (cCameraManager::m_fFOV < 1.0f)
+            cCameraManager::m_fFOV = 1.0f;
+
+        curViewCopy = cCameraManager::m_matView;
+        ApplyCameraFilters(curViewCopy);
+        cCameraManager::m_matView = curViewCopy;
+    }
+
+    mscharged::CheckCameraMatrix(cCameraManager::m_matView);
+    mscharged::CheckCameraVector(cCameraManager::m_cameraPosition);
+    if (!std::isfinite(cCameraManager::m_fFOV)) throw std::overflow_error("Camera FOV overflow");
+    nlVec3Set(viewZAxis, cCameraManager::m_matView.m13, cCameraManager::m_matView.m23, cCameraManager::m_matView.m33);
+    cCameraManager::m_aJoystickRemap = (u16)(int)(nlATan2f(viewZAxis.y, viewZAxis.x) * 10430.378f);
+    cCameraManager::m_aJoystickRemap += 0x8000;
+
+}
+}
+void UpdateCameraTransition(float delta)
+{
+    mscharged::CheckCameraDelta(delta);
+    mscharged::NativeCameraCall call;
+    if (cCameraManager::m_transition == eCT_NONE) throw std::logic_error("No active camera transition");
+    UpdateCameraTransitionImpl(delta);
+}
+namespace mscharged {
+void ResetNativeCameraState()
+{
+    cCameraManager::m_cameraStack = nullptr;
+    cCameraManager::m_transition = eCT_NONE;
+    cCameraManager::m_pCallback = nullptr;
+    cCameraManager::m_aJoystickRemap = 0;
+    cCameraManager::m_matView.SetIdentity();
+    cCameraManager::m_matPrevView.SetIdentity();
+    cCameraManager::m_cameraPosition = {};
+    cCameraManager::m_fTransitionSpeed = cCameraManager::m_fPrevFOV = 0;
+    cCameraManager::m_fTransitionTime = 1;
+    cCameraManager::m_fFOV = 50;
+    cCameraManager::m_BeginFrameCameraType = 14;
+    cCameraManager::m_UpVectorStackSize = 0;
+    cCameraManager::m_UpVectorStack[0] = cCameraManager::m_UpVectorStack[1] = {0,0,1};
+    g_CameraWorldUpVector = {0,0,1};
+    g_eCurrentCameraType = eCameraType_Debug;
+    g_LastCameraType = 0;
+    g_nCameraAnimationsRequested = g_nCameraAnimationsCompleted = 0;
+    g_bFrontEndCameras = false;
+}
+}
