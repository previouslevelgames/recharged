From: mscharged-port contributors
Subject: [PATCH] Select original plain font polygons and share text raster setup
Upstream-base: 9f985f9aca654d7ec13ff894830f19aeb3f7aefd

Select original textured short-UV glPoly2 construction and attachment with
native bounds and exception-safe matrix restoration. Float/scissor, untextured
white fallback and utility polygon paths remain unselected on native builds.
Share original DrawString raster setup and the unchanged glHasQuads capability
without linking unrelated full graphics startup. No FontManager publication
or full original font service is supplied by this selection.

diff --git a/src/NL/gl/glDraw2.cpp b/src/NL/gl/glDraw2.cpp
--- a/src/NL/gl/glDraw2.cpp
+++ b/src/NL/gl/glDraw2.cpp
@@ -2,7 +2,12 @@
 #include "NL/gl/glTexture.h"
 
 #include "Game/GL/GLTexturedColourMeshWriter.h"
+#ifndef MSCHARGED_NATIVE
 #include "Game/GL/GLFloatTexturedColourMeshWriter.h"
+#endif
+#ifdef MSCHARGED_NATIVE
+#include <stdexcept>
+#endif
 #include "NL/platvmath.h"
 #include "NL/nlString.h"
 
@@ -44,6 +49,10 @@
 glModel* glBuildPoly2Model(glPoly2* pPolys,
     unsigned long numPolys, glMatrixHandle* pMatrixHandle, bool textured)
 {
+#ifdef MSCHARGED_NATIVE
+    if (!pPolys || numPolys == 0 || numPolys > 65535 / 6 || !textured)
+        throw std::invalid_argument("Native glPoly2 requires bounded textured quads");
+#endif
     GLTexturedColourMeshWriter writer;
 
     glMatrixHandle oldMatrix;
@@ -65,6 +74,13 @@
 
     oldMatrix = glSetCurrentMatrix(
         pMatrixHandle != 0 ? *pMatrixHandle : glGetIdentityMatrix());
+#ifdef MSCHARGED_NATIVE
+    struct MatrixRestore
+    {
+        glMatrixHandle value;
+        ~MatrixRestore() { glSetCurrentMatrix(value); }
+    } restore{oldMatrix};
+#endif
 
     if (textured)
     {
@@ -100,6 +116,7 @@
             state->unknown07 = 0;
         }
     }
+#ifndef MSCHARGED_NATIVE
     else
     {
         if (writer.Begin(numVerts * numPolys, primitive, 0))
@@ -125,6 +142,7 @@
             state->unknown07 = 0;
         }
     }
+#endif
 
     if (!writer.End())
     {
@@ -139,6 +157,10 @@
 bool glAttachPoly2(GLView* view, unsigned long numPolys, glPoly2* pPolys,
     glMatrixHandle* pMatrixHandle)
 {
+#ifdef MSCHARGED_NATIVE
+    if (!view || view->m_NativeIterating || glNativeViewDispatchActive())
+        throw std::logic_error("Native glPoly2 requires a non-dispatching view");
+#endif
     glModel* model = glBuildPoly2Model(pPolys, numPolys, pMatrixHandle, gl_GetCurrentStateBundle()->texconfig == 1);
     if (model == 0)
         return false;
@@ -149,6 +171,10 @@
 bool glAttachPoly2(GLView* view, int layer, unsigned long numPolys,
     glPoly2* pPolys, glMatrixHandle* pMatrixHandle)
 {
+#ifdef MSCHARGED_NATIVE
+    if (!view || view->m_NativeIterating || glNativeViewDispatchActive())
+        throw std::logic_error("Native glPoly2 requires a non-dispatching view");
+#endif
     glModel* model = glBuildPoly2Model(pPolys, numPolys, pMatrixHandle, gl_GetCurrentStateBundle()->texconfig == 1);
     if (model == 0)
         return false;
@@ -156,6 +182,7 @@
     return true;
 }
 
+#ifndef MSCHARGED_NATIVE
 bool glAttachPoly2(GLView* view, int layer, unsigned long numPolys,
     glPoly2* pPolys, const void* pUserData, glMatrixHandle* pMatrixHandle)
 {
@@ -359,6 +386,8 @@
     depth = z;
 }
 
+#endif
+
 void glPoly2::SetColour(const nlColour& col)
 {
     m_colour[0] = col;
