diff --git a/include/NL/nlMemory.h b/include/NL/nlMemory.h
--- a/include/NL/nlMemory.h
+++ b/include/NL/nlMemory.h
@@ -42,6 +42,24 @@
     return nlMalloc(size, alignment, fromEnd);
 }
 
+#if defined(MSCHARGED_NATIVE)
+// Objects made with the aligned game-arena new overloads must never reach the
+// host delete operator. Matching placement deletes also handle constructor failure.
+inline void operator delete(void* ptr, unsigned int, bool) noexcept { nlFree(ptr); }
+inline void operator delete[](void* ptr, unsigned int, bool) noexcept { nlFree(ptr); }
+inline void operator delete[](void* ptr, unsigned int, bool, const char*) noexcept { nlFree(ptr); }
+
+template <typename T>
+inline void nlDeleteGameObject(T* object)
+{
+    if (object != 0)
+    {
+        object->~T();
+        nlFree(object);
+    }
+}
+#endif
+
 void nlInitMemory();
 void* nlAllocateAlignedMemory(unsigned long size, bool atEnd);
 extern u8 gMemoryInitialized;
