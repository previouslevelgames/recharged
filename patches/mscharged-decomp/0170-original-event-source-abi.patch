+    ListenerEntry* GetEntry(Listener* listener)
+    {
+        return mListeners.Begin((ListenerEntry*)((char*)listener - MSCHARGED_EVENT_ENTRY_OFFSET(ListenerEntry))).CurrentEntry();
+    }
+
+    void DeleteListener(Listener* listener)
+    {
