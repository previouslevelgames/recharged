+template <typename P1, typename P2, typename P3, int Count>
+void UnidentifiedStaticEvent3<P1, P2, P3, Count>::Disconnect(void* owner)
+{
+    Listener* listener = (Listener*)FindEventConnection(this, owner);
+    Remove(listener);
