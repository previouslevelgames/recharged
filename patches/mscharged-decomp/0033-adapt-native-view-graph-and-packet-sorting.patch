+// Original view projection and primitive counts, selected independently of startup.
+#include "NL/gl/gl.h"
+#include "NL/gl/glView.h"
+#include "NL/gl/glPlat.h"
+#include "NL/nlMath.h"
+#if !defined(MSCHARGED_NATIVE)
+#error Select gl.cpp/glPlat.cpp for the console build
+#endif
+unsigned long glGetNumTriangles(eGLPrimitive primitive, unsigned long count)
+{
+    switch (primitive)
+    {
+    case GLP_TriList:
+        return count / 3;
+    case GLP_TriStrip:
+        return count >= 2 ? count - 2 : 0;
+    case GLP_TriFan:
+        return count >= 2 ? count - 2 : 0;
+    case GLP_QuadList:
+        return count / 2;
+    case GLP_LineList:
+        return count / 2;
+    case GLP_LineStrip:
+        return count ? count - 1 : 0;
+    default:
+        return 0;
+    }
+}
+
+void glplatViewProjectPoint(GLView* view, const nlVector3& v3world, nlVector3& v3NDC)
+{
+    nlMatrix4 viewMatrix;
+    nlMatrix4 projectionMatrix;
+    nlVector3 v_out;
+
+    view->m_Interface->GetViewMatrix(viewMatrix);
+    view->m_Interface->GetProjectionMatrix(projectionMatrix);
+    nlMultPosVectorMatrix(v_out, v3world, viewMatrix);
+    nlMultPosVectorMatrix(v3NDC, v_out, projectionMatrix);
+
+    const f32 wc = 1.0f / -v_out.z;
+    v3NDC.x *= wc;
+    v3NDC.y = -v3NDC.y * wc;
+    v3NDC.z *= wc;
+}
