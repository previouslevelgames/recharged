--- /dev/null
+++ b/src/Game/Render/LightingLookupNative.cpp
@@ -0,0 +1,175 @@
+// Selected original LightingLookup methods from ImpostorLighting.cpp.
+// Own the CPU lookup separately from the pool-owned native GX texture records.
+#include "Game/Render/LightingLookup.h"
+#include "NL/glx/glxTexture.h"
+#include <algorithm>
+#include <cmath>
+#include <memory>
+#include <stdexcept>
+
+LightingLookup::LightingLookup()
+    : mValues(0)
+    , mWidth(0)
+    , mHeight(0)
+{
+}
+
+LightingLookup::~LightingLookup()
+{
+    if (mValues != 0)
+    {
+        delete[] mValues;
+    }
+}
+
+void LightingLookup::LoadTexture(u32 textureHandle)
+{
+    const PlatTexture* texture = glx_GetTex(textureHandle);
+    if (!texture || texture->m_Format != GXTex_CI8 || !texture->m_Width || !texture->m_Height ||
+        !texture->m_Levels || !texture->m_SwizzledData || !texture->m_PaletteData ||
+        texture->m_nPaletteEntries <= 0 || texture->m_nPaletteEntries > 256 ||
+        texture->m_NativePaletteBytes < size_t(texture->m_nPaletteEntries) * 2)
+        throw std::invalid_argument("Shadow lookup requires a loaded CI8/RGB5A3 texture");
+    const size_t width = texture->m_Width, height = texture->m_Height;
+    const size_t tiledBytes = ((width + 7) / 8) * ((height + 3) / 4) * 32;
+    if (width * height > 16 * 1024 * 1024 || tiledBytes > texture->m_NativeDataBytes)
+        throw std::invalid_argument("Shadow lookup exceeds its retained texture storage");
+    auto values = std::make_unique<u8[]>(width * height);
+    for (size_t y = 0; y < height; ++y)
+        for (size_t x = 0; x < width; ++x)
+            values[y * width + x] = ReadTextureIntensity(texture, int(x), int(y));
+    delete[] mValues;
+    mValues = values.release();
+    mWidth = int(width);
+    mHeight = int(height);
+    m_NativeTexture = textureHandle;
+}
+
+nlColour LightingLookup::SampleColour(
+    int x, int y, bool tint) const
+{
+    if (!mValues || mWidth <= 0 || mHeight <= 0) throw std::logic_error("Shadow lookup has not been loaded");
+    if (x < 0)
+    {
+        x = 0;
+    }
+    if (y < 0)
+    {
+        y = 0;
+    }
+    if (x >= mWidth)
+    {
+        x = mWidth - 1;
+    }
+    if (y >= mHeight)
+    {
+        y = mHeight - 1;
+    }
+
+    u8 value = mValues[y * mWidth + x];
+    nlColour colour;
+    if (tint)
+    {
+        nlColour shadowColour = { { 0, 0, 0, 255 } };
+        nlFloatColour shadow;
+        shadowColour.c[0] = (u8)m_NativeShadowTint.c[0];
+        shadow.c[0] = shadowColour.c[0] * (1.0f / 255.0f);
+        shadowColour.c[1] = (u8)m_NativeShadowTint.c[1];
+        shadow.c[1] = shadowColour.c[1] * (1.0f / 255.0f);
+        shadowColour.c[2] = (u8)m_NativeShadowTint.c[2];
+        shadow.c[2] = shadowColour.c[2] * (1.0f / 255.0f);
+        shadow.c[3] = shadowColour.c[3] * (1.0f / 255.0f);
+        nlColour highlightColour = { { 0, 0, 0, 255 } };
+        nlFloatColour highlight;
+        highlightColour.c[0] = (u8)m_NativeHighlightTint.c[0];
+        highlight.c[0] = highlightColour.c[0] * (1.0f / 255.0f);
+        highlightColour.c[1] = (u8)m_NativeHighlightTint.c[1];
+        highlight.c[1] = highlightColour.c[1] * (1.0f / 255.0f);
+        highlightColour.c[2] = (u8)m_NativeHighlightTint.c[2];
+        highlight.c[2] = highlightColour.c[2] * (1.0f / 255.0f);
+        highlight.c[3] = highlightColour.c[3] * (1.0f / 255.0f);
+        float inverseFactor = 1.0f - value / 255.0f;
+        nlFloatColour result;
+        result.c[0] = inverseFactor * shadow.c[0] + (value / 255.0f) * highlight.c[0];
+        result.c[1] = inverseFactor * shadow.c[1] + (value / 255.0f) * highlight.c[1];
+        result.c[2] = inverseFactor * shadow.c[2] + (value / 255.0f) * highlight.c[2];
+        result.c[3] = inverseFactor * shadow.c[3] + (value / 255.0f) * highlight.c[3];
+        ConvertColour(colour, result);
+    }
+    else
+    {
+        nlColourSet(colour, value, value, value, 255);
+    }
+    return colour;
+}
+
+nlColour LightingLookup::SampleFilteredColour(
+    float x, float y, bool tint) const
+{
+    if (!std::isfinite(x) || !std::isfinite(y)) throw std::invalid_argument("Non-finite shadow sample");
+    x = std::clamp(x, -1.0f, float(mWidth));
+    y = std::clamp(y, -1.0f, float(mHeight));
+    int ix = (int)x;
+    int iy = (int)y;
+    nlColour samples[5];
+    samples[0] = SampleColour(ix, iy, tint);
+    samples[1] = SampleColour(ix, iy - 1, tint);
+    samples[2] = SampleColour(ix, iy + 1, tint);
+    samples[3] = SampleColour(ix - 1, iy, tint);
+    samples[4] = SampleColour(ix + 1, iy, tint);
+    int red = 3 * samples[0][0];
+    int green = 3 * samples[0][1];
+    int blue = 3 * samples[0][2];
+    int alpha = 3 * samples[0][3];
+
+    red += samples[1][0];
+    green += samples[1][1];
+    blue += samples[1][2];
+    alpha += samples[1][3];
+
+    red += samples[2][0];
+    green += samples[2][1];
+    blue += samples[2][2];
+    alpha += samples[2][3];
+
+    red += samples[3][0];
+    green += samples[3][1];
+    blue += samples[3][2];
+    alpha += samples[3][3];
+
+    red += samples[4][0];
+    green += samples[4][1];
+    blue += samples[4][2];
+    alpha += samples[4][3];
+
+    nlColour result;
+    result[0] = red / 7;
+    result[1] = green / 7;
+    result[2] = blue / 7;
+    result[3] = alpha / 7;
+    return result;
+}
+
+u8 LightingLookup::ReadTextureIntensity(
+    const PlatTexture* texture, int x, int y) const
+{
+    if (!texture || x < 0 || y < 0 || x >= texture->m_Width || y >= texture->m_Height ||
+        texture->m_Format != GXTex_CI8 || !texture->m_SwizzledData || !texture->m_PaletteData)
+        throw std::out_of_range("Invalid shadow texture sample");
+    size_t block = size_t(y >> 2) * ((texture->m_Width + 7) >> 3) + (x >> 3);
+    size_t offset = (block << 5) + ((y & 3) << 3) + (x & 7);
+    if (size_t(offset) >= texture->m_NativeDataBytes) throw std::out_of_range("Shadow texel exceeds texture storage");
+    u8 paletteIndex = ((u8*)texture->m_SwizzledData)[offset];
+    if (paletteIndex >= texture->m_nPaletteEntries || size_t(paletteIndex) * 2 + 2 > texture->m_NativePaletteBytes)
+        throw std::out_of_range("Shadow palette index exceeds palette storage");
+    const u8* palette = reinterpret_cast<const u8*>(texture->m_PaletteData);
+    u16 value = u16(palette[paletteIndex * 2]) << 8 | palette[paletteIndex * 2 + 1];
+    if (value & 0x8000)
+    {
+        int component = (value >> 10) & 0x1F;
+        return component * 255 / 31;
+    }
+
+    int component = (value >> 8) & 0x0F;
+    return component * 255 / 15;
+}
