+void SetGameObjectShadowModelMatrix(glMatrixHandle matrix)
+{
+    if (!fn_80183C54())
+        return;
+
+    if (matrix == GL_INVALID_MATRIX)
+    {
+        mscharged::ActiveGameLighting().shadow_matrix = -1;
+    }
+    else if (matrix != mscharged::ActiveGameLighting().shadow_matrix)
+    {
+        mscharged::ActiveGameLighting().shadow_matrix = matrix;
+
+        nlMatrix4 transform;
+        glGetMatrix(matrix, transform);
+
+        Mtx textureMatrix;
+        glxCopyMatrix(textureMatrix, transform);
+        GXLoadTexMtxImm(textureMatrix, 0x36, GX_MTX3x4);
+    }
+}
