+        nlMakeScaleMatrix(transform, mscharged::ActiveGameLighting().inputs.shadow.scale[0],
+            mscharged::ActiveGameLighting().inputs.shadow.scale[1], lbl_806E4CD4);
+        transform.SetRow4_(3, mscharged::ActiveGameLighting().inputs.shadow.translation[0],
+            mscharged::ActiveGameLighting().inputs.shadow.translation[1], lbl_806E4CD8, lbl_806E4CD4);
+
+        Mtx gxTransform;
+        glxCopyMatrix(gxTransform, transform);
+
+        Mtx textureMatrix;
+        mscharged::MaterialConcatMatrices(lbl_80511490, gxTransform, textureMatrix);
+
+        GXLoadTexMtxImm(textureMatrix, 0x76, GX_MTX3x4);
+    }
+}
