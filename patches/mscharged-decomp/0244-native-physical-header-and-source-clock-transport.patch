+MSCHARGED_ADDRESS_STORAGE volatile u16 OS_DVD_DEVICE_CODE AT_ADDRESS(0x800030E6);
+MSCHARGED_ADDRESS_STORAGE u8 OS_BI2_DEBUG_FLAG AT_ADDRESS(0x800030E8);
