Subject: [PATCH] Keep native physical hardware declarations external and route source clock reads

Upstream-base: c7b2e663f878d38dc429ab12ee7db451daf0c217
Prepared-preimage: reviewed strict192 c7b2 export; these SDK headers unchanged

MWCC absolute-address declarations must not become allocated native BSS after
AT_ADDRESS is erased. Keep native references external, and route original
OSTime arithmetic through the existing actual SDK bus-clock getter. Unknown
physical symbols remain genuine unresolved dependencies; no zero providers.
Console declarations and all time conversion expressions are retained.

diff --git a/libs/RVL_SDK/include/revolution/os/OSHardware.h b/libs/RVL_SDK/include/revolution/os/OSHardware.h
--- a/libs/RVL_SDK/include/revolution/os/OSHardware.h
+++ b/libs/RVL_SDK/include/revolution/os/OSHardware.h
@@ -8,6 +8,12 @@
 
 #ifdef __cplusplus
 extern "C" {
+#endif
+
+#if defined(MSCHARGED_NATIVE)
+#define MSCHARGED_ADDRESS_STORAGE extern
+#else
+#define MSCHARGED_ADDRESS_STORAGE
 #endif
 
 #define OS_PHYS_WIFI_AFH_CHANNEL 0x000031A2
@@ -34,28 +40,28 @@
 #define OS_PHYS_CURRENT_APP_NAME 0x3180
 #define OS_PHYS_CURRENT_APP_TYPE 0x3184
 
-OSContext* OS_CURRENT_CONTEXT_PHYS AT_ADDRESS(0x800000C0);
-OSContext* OS_CURRENT_CONTEXT AT_ADDRESS(0x800000D4);
-OSContext* OS_CURRENT_FPU_CONTEXT AT_ADDRESS(0x800000D8);
-OSThreadQueue OS_THREAD_QUEUE AT_ADDRESS(0x800000DC);
-OSThread* OS_CURRENT_THREAD AT_ADDRESS(0x800000E4);
-u32 OS_TV_FORMAT AT_ADDRESS(0x800000CC);
-u32 OS_BUS_CLOCK_SPEED AT_ADDRESS(0x800000F8);
-s64 OS_SYSTEM_TIME AT_ADDRESS(0x800030D8);
+MSCHARGED_ADDRESS_STORAGE OSContext* OS_CURRENT_CONTEXT_PHYS AT_ADDRESS(0x800000C0);
+MSCHARGED_ADDRESS_STORAGE OSContext* OS_CURRENT_CONTEXT AT_ADDRESS(0x800000D4);
+MSCHARGED_ADDRESS_STORAGE OSContext* OS_CURRENT_FPU_CONTEXT AT_ADDRESS(0x800000D8);
+MSCHARGED_ADDRESS_STORAGE OSThreadQueue OS_THREAD_QUEUE AT_ADDRESS(0x800000DC);
+MSCHARGED_ADDRESS_STORAGE OSThread* OS_CURRENT_THREAD AT_ADDRESS(0x800000E4);
+MSCHARGED_ADDRESS_STORAGE u32 OS_TV_FORMAT AT_ADDRESS(0x800000CC);
+MSCHARGED_ADDRESS_STORAGE u32 OS_BUS_CLOCK_SPEED AT_ADDRESS(0x800000F8);
+MSCHARGED_ADDRESS_STORAGE s64 OS_SYSTEM_TIME AT_ADDRESS(0x800030D8);
 extern volatile s32 OS_EXI_LAST_INSERT[2] AT_ADDRESS(0x800030C0);
-u16 OS_GC_PAD_3_BTN AT_ADDRESS(0x800030E4);
-u8 OS_PAD_FLAGS AT_ADDRESS(0x800030E3);
-void* OS_DEBUG_MONITOR AT_ADDRESS(0x800000EC);
