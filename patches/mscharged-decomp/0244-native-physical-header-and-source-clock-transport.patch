+#undef MSCHARGED_ADDRESS_STORAGE
 
 #ifdef __cplusplus
 }
diff --git a/libs/RVL_SDK/include/revolution/os/OSTime.h b/libs/RVL_SDK/include/revolution/os/OSTime.h
--- a/libs/RVL_SDK/include/revolution/os/OSTime.h
+++ b/libs/RVL_SDK/include/revolution/os/OSTime.h
@@ -10,7 +10,12 @@
 #endif
 
 
+#if defined(MSCHARGED_NATIVE)
+u32 ChargedGetBusClock(void);
+#define OS_TIME_SPEED (ChargedGetBusClock() / 4)
+#else
 #define OS_TIME_SPEED (OS_BUS_CLOCK_SPEED / 4)
+#endif
 
 #define OS_TICKS_TO_SEC(x) ((x) / OS_TIME_SPEED)
 #define OS_TICKS_TO_MSEC(x) ((x) / (OS_TIME_SPEED / 1000))
