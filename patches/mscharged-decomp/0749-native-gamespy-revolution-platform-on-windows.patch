--- a/src/RVL_SDK/gamespy/common/gsDebug.c
+++ b/src/RVL_SDK/gamespy/common/gsDebug.c
@@ -71,7 +71,7 @@ static void gsiDebugCallback(GSIDebugCategory category, GSIDebugType type,
