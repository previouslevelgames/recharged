Subject: Use the standard memory/string header in native source

Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

The CodeWarrior MSL mem.h dependency is not supplied by the host toolchain.
Use string.h for its standard memory/string declarations. No MSL compatibility
shim is needed for these include sites.

diff --git a/include/Game/DB/BasicGameInfo.h b/include/Game/DB/BasicGameInfo.h
index d7ec97f..300c575 100644
--- a/include/Game/DB/BasicGameInfo.h
+++ b/include/Game/DB/BasicGameInfo.h
@@ -1,7 +1,7 @@
 #ifndef GAME_DB_BASICGAMEINFO_H
 #define GAME_DB_BASICGAMEINFO_H
 
-#include <mem.h>
+#include <string.h>
 
 #include "Game/DB/StatsTracker.h"
 #include "types.h"
diff --git a/include/Game/DB/StatsTracker.h b/include/Game/DB/StatsTracker.h
