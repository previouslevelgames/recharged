Subject: Restore whole original TPL binding over native header transport
Upstream-base: 2c5c51e483b652d178ef06a44b83b07a0f97d2a6

Retire the port-owned TPLBind loop. The whole original SDK source owns version
panic, descriptor iteration, null/unpacked branches and the original TRUE stores.
Five address-expression seams adapt fixed Wii address cells to real native SDK
backing. Transactional structural publication keeps original byte/domain state
on metadata failure. Pixels and console source remain unchanged. Qualified
formats remain I4/IA4/IA8/RGB5A3 without mip levels or CLUT.

--- a/src/RVL_SDK/tpl/TPL.c
+++ b/src/RVL_SDK/tpl/TPL.c
@@ -3,32 +3,48 @@
 
 #define TPL_VERSION 2142000
 
-// Native fixed32 address cells and serialized endian transport are supplied
-// by the source module's sole platform binder. The original relocation body
-// remains below for the console ABI; TPLGet stays the whole source method.
-#if !defined(MSCHARGED_NATIVE)
 void TPLBind(TPLPalette* pal) {
+#if defined(MSCHARGED_NATIVE)
+    mscharged::platform::NativeTPLBinding binding(pal);
+    pal = static_cast<TPLPalette*>(binding.Palette());
+#endif
     u16 i;
 
     if (pal->versionNumber != TPL_VERSION) {
         OSPanic("TPL.c", 25, "invalid version number for texture palette");
     }
 
+#if defined(MSCHARGED_NATIVE)
+    pal->descriptorArray.word = binding.RelocateDescriptors(
+        pal->descriptorArray.word, pal->numDescriptors);
+#else
     pal->descriptorArray =
         (TPLDescriptor*)((char*)pal->descriptorArray + (u32)pal);
+#endif
 
     for (i = 0; i < pal->numDescriptors; i++) {
         if (pal->descriptorArray[i].textureHeader != NULL) {
             // Convert header offset into pointer
+#if defined(MSCHARGED_NATIVE)
+            pal->descriptorArray[i].textureHeader.word = binding.RelocateTexture(
+                pal->descriptorArray[i].textureHeader.word);
+#else
             pal->descriptorArray[i].textureHeader =
                 (TPLHeader*)((char*)pal +
                              (u32)pal->descriptorArray[i].textureHeader);
+#endif
 
             if (!pal->descriptorArray[i].textureHeader->unpacked) {
                 // Convert data offset into pointer
+#if defined(MSCHARGED_NATIVE)
+                pal->descriptorArray[i].textureHeader->data.word = binding.RelocatePixels(
+                    pal->descriptorArray[i].textureHeader->data.word,
+                    pal->descriptorArray[i].textureHeader.Get());
+#else
                 pal->descriptorArray[i].textureHeader->data =
                     (char*)pal +
                     (u32)pal->descriptorArray[i].textureHeader->data;
+#endif
 
                 pal->descriptorArray[i].textureHeader->unpacked = TRUE;
             }
@@ -36,22 +52,33 @@
 
         if (pal->descriptorArray[i].CLUTHeader != NULL) {
             // Convert header offset into pointer
+#if defined(MSCHARGED_NATIVE)
+            pal->descriptorArray[i].CLUTHeader.word = binding.RelocateClut(
+                pal->descriptorArray[i].CLUTHeader.word);
+#else
             pal->descriptorArray[i].CLUTHeader =
                 (TPLClutHeader*)((char*)pal +
                                  (u32)pal->descriptorArray[i].CLUTHeader);
+#endif
 
             if (!pal->descriptorArray[i].CLUTHeader->unpacked) {
                 // Convert data offset into pointer
+#if defined(MSCHARGED_NATIVE)
+                pal->descriptorArray[i].CLUTHeader->data.word = binding.RelocateClutPixels(
+                    pal->descriptorArray[i].CLUTHeader->data.word);
+#else
                 pal->descriptorArray[i].CLUTHeader->data =
                     (char*)pal + (u32)pal->descriptorArray[i].CLUTHeader->data;
+#endif
 
                 pal->descriptorArray[i].CLUTHeader->unpacked = TRUE;
             }
         }
     }
+#if defined(MSCHARGED_NATIVE)
+    binding.Commit();
+#endif
 }
-
-#endif
 
