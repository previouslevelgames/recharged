diff --git a/include/Game/FE/FrontendDoneButtonSteps.h b/include/Game/FE/FrontendDoneButtonSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendDoneButtonSteps.h
@@ -0,0 +1,39 @@
+#ifndef CHARGED_FRONTEND_DONE_BUTTON_STEPS_H
+#define CHARGED_FRONTEND_DONE_BUTTON_STEPS_H
+static const float sDoneButtonBounds[4] = { -84.0f, 84.0f, -165.0f, -259.0f };
+static const float sPlayButtonBounds[4] = { -84.0f, 84.0f, -165.0f, -259.0f };
+
+template<class Component>
+void FrontendDoneButtonBounds(Component* component,int value)
+{
+    if (value)
+    {
+        component->SetBounds(sPlayButtonBounds[0], sPlayButtonBounds[1],
+            sPlayButtonBounds[2], sPlayButtonBounds[3]);
+    }
+    else
+    {
+        component->SetBounds(sDoneButtonBounds[0], sDoneButtonBounds[1],
+            sDoneButtonBounds[2], sDoneButtonBounds[3]);
+    }
+}
+template<class Scene,class Play>
+void FrontendDoneButtonEnter(Scene& scene,int index,Play play)
+{
+    scene.mSaveButtonComponent.SetPointerState(1, index);
+    if (!scene.mSaveButtonComponent.HasOtherPointerState(1, index))
+    {
+        scene.mSaveButton->SetActiveSlide("over", true, false);
+        play(0xAA73EF33, 0, 0, 1);
+    }
+}
+template<class Scene>
+void FrontendDoneButtonLeave(Scene& scene,int index)
+{
+    scene.mSaveButtonComponent.SetPointerState(0, index);
+    if (!scene.mSaveButtonComponent.HasOtherPointerState(1, index))
+    {
+        scene.mSaveButton->SetActiveSlide("off", true, false);
+    }
+}
+#endif
