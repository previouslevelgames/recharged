From: mscharged-port
Subject: Describe source-retained fixed material state variants
Upstream-base: 7a6bf165d9f1c5914181c079c7d4bfa7204f3509

--- a/src/NL/glx/GXFixedLightMaterialProgramRender.cpp
+++ b/src/NL/glx/GXFixedLightMaterialProgramRender.cpp
@@ -102,6 +102,16 @@
     BeginAutomaticMaterialVariant(packet);
     ConfigureFixedLightPipelineState(program);
     program->BindVertexArrays(&packet);
-    EmitAutomaticMaterialPipeline(packet);
+    // These selectors are retained by the source material switch: GXInit
+    // starts at 1, colour/movie materials leave K0_A, and opacity leaves K1_A.
+    // They are consumed here, so describe each instead of discarding key state.
+    const GXTevKAlphaSel selectors[] = {
+        GX_TEV_KASEL_1, GX_TEV_KASEL_K0_A, GX_TEV_KASEL_K1_A,
+    };
+    for (GXTevKAlphaSel selector : selectors)
+    {
+        GXSetTevKAlphaSel(GX_TEVSTAGE0, selector);
+        EmitAutomaticMaterialPipeline(packet);
+    }
 }
 #endif
