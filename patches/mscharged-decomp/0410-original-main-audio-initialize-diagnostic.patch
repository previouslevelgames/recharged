From: mscharged native integration
Subject: [PATCH] admit original audio initialize in explicit frontend diagnostic
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Only the named default-OFF audio initialization diagnostic admits the existing
source main call and uses THP's real AX predecessor. Normal/console main and
movie bodies are unchanged. No bank/cue/task or successful readiness is added.

diff --git a/src/Game/Sys/movie.cpp b/src/Game/Sys/movie.cpp
index 9da6b5e..2b9d259 100644
--- a/src/Game/Sys/movie.cpp
+++ b/src/Game/Sys/movie.cpp
@@ -65,7 +65,7 @@ bool MovieInit()
         return true;
     }
 
-#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_CREDITS_MOVIE)
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_DIAGNOSTIC_CREDITS_MOVIE) && !defined(MSCHARGED_DIAGNOSTIC_GAME_AUDIO_INITIALIZE)
     // Named source movie diagnostic while the genuine AX predecessor is held.
     THPSimpleInit(0);
 #else
diff --git a/src/Game/main.cpp b/src/Game/main.cpp
index 93dcb02..734332f 100644
--- a/src/Game/main.cpp
+++ b/src/Game/main.cpp
@@ -630,8 +630,10 @@ static void Initialize()
     g_pGameAudio = new (nlMalloc(sizeof(GameAudio), 8, false))
         GameAudio;
 #endif
-#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP)
+#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP) || defined(MSCHARGED_DIAGNOSTIC_GAME_AUDIO_INITIALIZE)
     g_pGameAudio->Initialize();
+#endif
+#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP)
     gSwappablePadChanged.Add(Function<void(int)>(ConfigureTweakerButtons), 0, -1);
     g_pPadManager->Update(0.0f);
 #endif // platform pads/audio omitted; FE input retains its source position
