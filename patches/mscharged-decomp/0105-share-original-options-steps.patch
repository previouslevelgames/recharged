+#ifndef GAME_FE_FRONTEND_OPTIONS_STEPS_H
+#define GAME_FE_FRONTEND_OPTIONS_STEPS_H
+// Selected original OptionsScene bodies. Callers provide actual services or
+// expose the unresolved dependency; this header does not establish readiness.
+template<class TLComponentInstance, template<class,int> class FEFinder, class Scene>
+void FrontendOptionsCreated(Scene& scene)
+{
+    auto* presentation = scene.GetPresentation();
+    scene.mOptionInstances[0] = FEFinder<TLComponentInstance, 4>::Find(
+        presentation, "in", "Layer", "options_list", "BTN_0");
+    scene.mOptionInstances[1] = FEFinder<TLComponentInstance, 4>::Find(
+        presentation, "in", "Layer", "options_list", "BTN_1");
+    scene.mOptionInstances[2] = FEFinder<TLComponentInstance, 4>::Find(
+        presentation, "in", "Layer", "options_list", "BTN_2");
+}
+template<class TLComponentInstance,class feVector3,template<class,int> class FEFinder,class Scene>
+void FrontendOptionsBind(Scene& scene,int i)
+{
+        feVector3 position = scene.mOptionInstances[i]->GetAssetPosition();
+        TLComponentInstance* instance = FEFinder<TLComponentInstance, 3>::Find(
+            scene.mOptionInstances[i], "off", "BUTTON_0", "list_back_480x70 ");
+        scene.mOptionButtons[i].SetInstanceBounds(
+            instance, true, position.f.x, position.f.y, 1.0f, 0.5f);
+}
+template<class Scene,class Waiting,class Hide,class Play>
+void FrontendOptionsPress(Scene& scene,int item,Waiting pointerWaiting,Hide hideNavigation,Play play)
+{
+    for (int i = 0; i < 3; ++i)
+    {
+        scene.mOptionButtons[i].Disable();
+    }
+
+    for (int i = 0; i < 4; ++i)
+    {
+        pointerWaiting(i);
+    }
+
+    play(0xF0AFD586, 0, 0, 1);
+
+    switch (item)
+    {
+    case 1:
+        play(0x304FDD1E, 0, 0, 1);
+        scene.mNextScene = static_cast<decltype(scene.mNextScene)>(14);
+        break;
+    case 0:
+        play(0x304FDD1E, 0, 0, 1);
+        scene.mNextScene = static_cast<decltype(scene.mNextScene)>(15);
+        break;
+    case 2:
+        scene.mNextScene = static_cast<decltype(scene.mNextScene)>(23);
+        break;
+    }
+
+    scene.mState = 2;
+
+    hideNavigation();
+
+    scene.mPresentation->SetActiveSlide("out", true);
+    scene.mPresentation->Update(0.0f);
+}
+template<class Scene,class Play>
+void FrontendOptionsEnter(Scene& scene,int index,unsigned item,Play play)
+{
+    if (!scene.mOptionButtons[item].HasOtherPointerState(1, index))
+    {
+        scene.mOptionInstances[item]->SetActiveSlide("over", true, false);
+        scene.mOptionButtons[item].SetPointerState(1, index);
+        play(0xF6EB899E, 0, 0, 1);
+    }
+}
+template<class Scene>
+void FrontendOptionsLeave(Scene& scene,int index,unsigned item)
+{
+    if (!scene.mOptionButtons[item].HasOtherPointerState(1, index))
+    {
+        scene.mOptionInstances[item]->SetActiveSlide("off", true, false);
+        scene.mOptionButtons[item].SetPointerState(0, index);
+    }
+}
+template<class Scene,class Waiting,class Show,class Push,class Play,class Transition,class Pop>
+bool FrontendOptionsGate(Scene& scene,Waiting pointerWaiting,Show showBack,Push push,Play play,Transition transition,Pop pop)
+{
+    if (scene.mState == 0 || scene.mState == 2 || scene.mState == 3)
+    {
+        auto* slide = scene.mPresentation->m_currentSlide;
+        if (slide->GetCurrentTime() < slide->GetStartTime() + slide->GetDuration())
+        {
+            for (int i = 0; i < 4; ++i)
+            {
+                pointerWaiting(i);
+            }
+            return false;
+        }
+
+        if (scene.mState == 0)
+        {
+            showBack();
+            scene.mState = 1;
+        }
+        else if (scene.mState == 2)
+        {
+            push(scene.mNextScene);
+            return false;
+        }
+        else if (scene.mState == 3)
+        {
+            play(0x4430B152, 0, 0, 1);
+            transition();
+            pop();
+            return false;
+        }
+    }
+
+    return true;
+}
+template<class Scene,class Hide>
+void FrontendOptionsBack(Scene& scene,Hide hideNavigation)
+{
+    scene.mState = 3;
+    hideNavigation();
+    scene.mPresentation->SetActiveSlide("out", true);
+    scene.mPresentation->Update(0.0f);
+}
+#endif
