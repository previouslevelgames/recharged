From: native port compatibility
Subject: [PATCH] Resolve the original NIS whole-file token before raw busy query

Upstream-base: 2c5c51e483b652d178ef06a44b83b07a0f97d2a6

Keep the original 32-bit whole-file handle and both destructor branches.
Only native builds resolve the existing token into the actual raw read entry,
as the original whole-file cancellation API already does. No callback, state,
resource, cancellation, allocation or source timing decision changes.

diff --git a/src/Game/Render/Nis.cpp b/src/Game/Render/Nis.cpp
--- a/src/Game/Render/Nis.cpp
+++ b/src/Game/Render/Nis.cpp
@@ -35,6 +35,9 @@
 #include "NL/nlDebug.h"
 #include "NL/nlFile.h"
 #include "NL/nlFileGC.h"
+#if defined(MSCHARGED_NATIVE)
+#include "platform/file_handle_abi.h"
+#endif
 #include "NL/nlSlotPool.h"
 #include "NL/nlTask.h"
 #include "NL/gl/glState.h"
@@ -247,7 +250,12 @@
     {
         if (mPendingAnimations[i].loadHandle != 0)
         {
+#if defined(MSCHARGED_NATIVE)
+            if (nlAsyncReadBusy(static_cast<AsyncEntry*>(mscharged::platform::ResolveFileReadHandle(
+                    mPendingAnimations[i].loadHandle))))
+#else
             if (nlAsyncReadBusy((AsyncEntry*)mPendingAnimations[i].loadHandle))
+#endif
             {
                 ((PendingAnimationRequest*)mPendingAnimations[i].request)->active = false;
                 ((PendingAnimationRequest*)mPendingAnimations[i].request)->animation = 0;
