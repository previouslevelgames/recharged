     void Texcoord(const nlVector2& uv)
     {
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+        for (float v : {uv.x, uv.y})
+            if (!std::isfinite(v) || v * 1024.0f < -32768.0f || v * 1024.0f >= 32768.0f)
+                throw std::invalid_argument("Particle UV exceeds original signed16 storage");
+        NativeCheckWrite(writtenUV);
+#endif
         short u = (short)(uv.x * 1024.0f);
         short v = (short)(uv.y * 1024.0f);
         *texcoord++ = u;
@@ -39,12 +64,20 @@
 
     void Texcoord(int u, int v)
     {
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+        if (u < -32768 || u > 32767 || v < -32768 || v > 32767)
+            throw std::invalid_argument("Particle UV exceeds original signed16 storage");
+        NativeCheckWrite(writtenUV);
+#endif
         *texcoord++ = u;
         *texcoord++ = v;
     }
 
     void TexcoordZero()
     {
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+        NativeCheckWrite(writtenUV);
+#endif
         *texcoord++ = 0;
         *texcoord++ = 0;
     }
@@ -56,11 +89,32 @@
 
     void Vertex(float x, float y, float z)
     {
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+        if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z))
+            throw std::invalid_argument("Invalid particle vertex");
+        NativeCheckWrite(writtenPosition);
+#endif
         *position++ = x;
         *position++ = y;
         *position++ = z;
     }
 
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+    void NativeCheckLive() const
+    {
+        if (!model || generation != glNativeFrameGeneration())
+            throw std::logic_error("Particle mesh outlived its graphics frame");
+    }
+    void NativeCheckWrite(unsigned& written)
+    {
+        NativeCheckLive();
+        if (finished || written >= unsigned(count)) throw std::out_of_range("Particle mesh stream overflow");
+        ++written;
+    }
+    unsigned writtenPosition = 0, writtenColour = 0, writtenUV = 0;
+    uint64_t generation = 0;
+    bool finished = false;
+#endif
     int count;
     glModel* model;
     void* resource;
diff --git a/src/Game/GL/GLTexturedColourMeshWriter.cpp b/src/Game/GL/GLTexturedColourMeshWriter.cpp
--- a/src/Game/GL/GLTexturedColourMeshWriter.cpp
+++ b/src/Game/GL/GLTexturedColourMeshWriter.cpp
@@ -1,5 +1,7 @@
+#ifndef MSCHARGED_NATIVE
 #include <revolution/base/PPCArch.h>
 #include <revolution/os/OSCache.h>
+#endif
 
 #include "Game/GL/GLTexturedColourMeshWriter.h"
 #include "NL/nlMemory.h"
@@ -26,6 +28,18 @@
 bool GLTexturedColourMeshWriter::Begin(
     int numVerts, int prim, void* pResource)
 {
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+    if (model && !finished && generation == glNativeFrameGeneration())
+        throw std::logic_error("Particle mesh Begin before End");
+    if (pResource || numVerts <= 0 || numVerts > 65535 || prim < 0 || prim >= 6)
+        throw std::invalid_argument("Native particle writer requires a bounded frame mesh");
+    model = nullptr;
+    writtenPosition = writtenColour = writtenUV = 0;
+    finished = false;
+    generation = glNativeFrameGeneration();
+    try
+    {
+#endif
     glModel* newModel;
     resource = pResource;
     count = numVerts;
@@ -106,19 +120,35 @@
     glSetModelStream(streams + 2, 2, colour, sizeof(u32), 3);
 
     return true;
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+    }
+    catch (...) { model = nullptr; position = nullptr; colour = nullptr; texcoord = nullptr; throw; }
+#endif
 }
 
 bool GLTexturedColourMeshWriter::End()
 {
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+    NativeCheckLive();
+    if (finished || writtenPosition != unsigned(count) || writtenColour != unsigned(count) || writtenUV != unsigned(count))
+        throw std::logic_error("Incomplete or already finalized particle mesh");
+#endif
     for (int i = 0; i < model->numPackets; ++i)
     {
         glplatFinalizePacket(&model->packets[i], resource != 0, resource);
     }
+#ifndef MSCHARGED_NATIVE
     for (int i = 0; i < model->packets->numStreams; ++i)
     {
         glModelStream* stream = &model->packets->streams[i];
         DCStoreRangeNoSync(stream->address, count * stream->stride);
     }
     PPCSync();
+#else
+    // Aurora copies host arrays at submission; Wii cache writeback is unnecessary.
+#ifdef MSCHARGED_DIAGNOSTIC_MESH_WRITERS
+    finished = true;
+#endif
+#endif
     return true;
 }
