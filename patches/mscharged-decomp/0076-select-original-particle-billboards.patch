diff --git a/include/Game/Effects/ParticleBillboard.h b/include/Game/Effects/ParticleBillboard.h
new file mode 100644
--- /dev/null
+++ b/include/Game/Effects/ParticleBillboard.h
@@ -0,0 +1,66 @@
+#ifndef GAME_EFFECTS_PARTICLE_BILLBOARD_H
+#define GAME_EFFECTS_PARTICLE_BILLBOARD_H
+
+#include "Game/Effects/ParticleSystem.h"
+#include "Game/GL/GLTexturedColourMeshWriter.h"
+#include "NL/gl/glState.h"
+
+// Shared original RenderAllParticles raster and per-particle stream operations.
+// The callers still own visibility, budget, camera basis, texture and view lifetime.
+inline void fxSetParticleRasterState(bool cullBackFaces, bool disableDepthTest,
+    bool inFront, bool whiteTexture, unsigned char blend)
+{
+    glSetDefaultState(true);
+    glSetRasterState(GLS_DepthWrite, 0);
+    glSetRasterState(GLS_Culling, cullBackFaces ? 1 : 0);
+    if (disableDepthTest)
+        glSetRasterState(GLS_DepthTest, 0);
+    if (inFront)
+    {
+        glSetRasterState(GLS_DepthTest, 0);
+    }
+    if (whiteTexture)
+    {
+        glSetRasterState(GLS_AlphaBlend, 3);
+    }
+    else
+    {
+        switch (blend)
+        {
+        case EfBlend_Normal:
+            glSetRasterState(GLS_AlphaBlend, 1);
+            break;
+        case EfBlend_Additive:
+            glSetRasterState(GLS_AlphaBlend, 3);
+            break;
+        }
+    }
+    glSetRasterState(GLS_AlphaTest, 1);
+    glSetCurrentRasterState(glHandleizeRasterState());
+}
+
+inline void fxWriteParticleQuad(GLTexturedColourMeshWriter& mesh,
+    const ParticleReturn& ret, bool bQuads)
+{
+    static const int _tris[6] = { 0, 1, 2, 0, 2, 3 };
+    int i;
+    if (bQuads)
+    {
+        for (i = 0; i < 4; i++)
+        {
+            mesh.Texcoord(ret.texcoord[i]);
+            mesh.Colour(ret.c);
+            mesh.Vertex(ret.position[i]);
+        }
+    }
+    else
+    {
+        for (i = 0; i < 6; i++)
+        {
+            mesh.Texcoord(ret.texcoord[_tris[i]]);
+            mesh.Colour(ret.c);
+            mesh.Vertex(ret.position[_tris[i]]);
+        }
+    }
+}
+#endif
