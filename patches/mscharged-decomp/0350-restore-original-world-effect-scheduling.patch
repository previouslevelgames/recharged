From: mscharged-port original source restoration
Subject: [PATCH] Restore literal original world-effect scheduling
Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090

Retire the five historical 0109 helper substitutions in the
two original whole TUs. Preserve the previously reviewed
native EmissionAddressWord casts. The entire console token
streams equal the pinned upstream source. This does not
adapt serialized world records or establish world readiness.

--- a/src/Game/World/WorldEffect.cpp
+++ b/src/Game/World/WorldEffect.cpp
@@ -1,6 +1,5 @@
 #include "NL/nlDLListContainer.inl"
 #include "Game/World/WorldEffect.h"
-#include "Game/World/WorldEffectSteps.h"
 
 #include "Game/Debug/ShapeRender.h"
 #include "Game/Effects/EmissionController.h"
@@ -16,7 +15,18 @@
 
 void WorldEffect::Initialize(WorldObjectLoadContext* pContext)
 {
-    WorldEffectInitializeClock(*this);
+    m_bActive = true;
+    if (m_nTimingMode == 0)
+    {
+        float fEmissionInterval = m_fEmissionInterval;
+        m_fEmissionTime = fEmissionInterval + 1.0f;
+    }
+    else
+    {
+        m_fEmissionTime = 0.0f;
+    }
+    m_fPreviousEmissionTime = m_fEmissionTime;
+    m_nRemainingEmissions = m_nEmissionCount;
     pContext->m_pWorld->AddEffect(this);
 }
 
@@ -51,9 +61,44 @@
 
 void WorldEffect::Update(float fDeltaT)
 {
-    if (WorldEffectUpdateClock(*this, fDeltaT, &nlDefaultSeed))
-    {
-        Emit();
+    if (fDeltaT != 0.0f && m_bActive)
+    {
+        bool bEmit = false;
+        if (m_nTimingMode == 0)
+        {
+            if (m_nRemainingEmissions > 0
+                || m_nRemainingEmissions == -1)
+            {
+                float fEmissionTime = m_fEmissionTime;
+                float fEmissionInterval
+                    = m_fEmissionInterval;
+                fEmissionTime += fDeltaT;
+                m_fEmissionTime = fEmissionTime;
+                if (fEmissionInterval <= fEmissionTime
+                    && nlRandom(100, &nlDefaultSeed)
+                        < m_uProbability)
+                {
+                    bEmit = true;
+                }
+            }
+        }
+        else if (m_nRemainingEmissions > 0
+            || m_nRemainingEmissions == -1)
+        {
+            float fEmissionTime = m_fEmissionTime;
+            float fEmissionInterval = m_fEmissionInterval;
+            if (fEmissionInterval <= fEmissionTime
+                && nlRandom(100, &nlDefaultSeed)
+                    < m_uProbability)
+            {
+                bEmit = true;
+            }
+        }
+
+        if (bEmit)
+        {
+            Emit();
+        }
     }
 }
 
@@ -111,7 +156,13 @@
         m_nEmissionID = -1;
     }
 
-    WorldEffectEmitted(*this);
+    m_fPreviousEmissionTime = m_fEmissionTime;
+    m_fEmissionTime = 0.0f;
+    --m_nRemainingEmissions;
+    if (m_nRemainingEmissions < -1)
+    {
+        m_nRemainingEmissions = -1;
+    }
 }
 
