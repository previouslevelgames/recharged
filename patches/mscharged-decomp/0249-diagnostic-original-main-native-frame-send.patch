+#if defined(MSCHARGED_DIAGNOSTIC_MAIN_FRONTEND_SCENE)
+extern "C" __attribute__((visibility("default"))) void charged_original_scene_native_frame(float delta)
+{
+    // Temporary selected original FE frame endpoints. The native FIFO owns
+    // submission, and original glSendFrame owns view traversal/swap/copy/VI.
+    // The complete original task manager remains omitted by the main gate.
+    glBeginFrame();
+    nlServiceFileSystem();
+    FEResourceManager::Instance()->Run(delta);
+    FESceneManager::Instance()->Update(delta);
+    FESceneManager::Instance()->RenderActiveScenes();
+    glEndFrame();
+    glSendFrame();
+}
+#endif
