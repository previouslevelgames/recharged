diff --git a/include/Game/AI/FuzzyAIRuntime.h b/include/Game/AI/FuzzyAIRuntime.h
--- a/include/Game/AI/FuzzyAIRuntime.h
+++ b/include/Game/AI/FuzzyAIRuntime.h
@@ -230,6 +230,17 @@
 
 extern "C" void LoadFuzzyByteCode(const char* filename, bool async);
 
+#if defined(MSCHARGED_NATIVE)
+#include "platform/vm_address_abi.h"
+// Only address arguments use the existing Wii32 VM address transport.
+// Numeric and floating-point arguments retain their original four-byte bits.
+template <typename T>
+inline u32 FuzzyArgumentBits(T* const& value)
+{
+    return mscharged::platform::EncodeOwnedVMAddress(value);
+}
+#endif
+
 // Script arguments occupy one stack word, including the bits of float values.
 template <typename T>
 inline u32 FuzzyArgumentBits(const T& value)
