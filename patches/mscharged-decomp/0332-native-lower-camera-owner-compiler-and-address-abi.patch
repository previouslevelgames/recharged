From: mscharged-port native integration
Subject: [PATCH] Preserve original lower camera-owner native addresses and compiler declarations
Upstream-base: 0f5a757947b8778b680d4d1ae7e6df1792a514f2

Permanent native compiler/address ABI only. Whole source owners retain
their original methods, source globals, allocation requests and algorithms.
Console source conditional projections remain identical. VM pointer
transport requires the separately supplied live-allocation helper;
Fuzzy result/argument consumers and camera runtime remain unqualified.

diff --git a/src/Game/AI/FuzzyRuntimeBase.cpp b/src/Game/AI/FuzzyRuntimeBase.cpp
--- a/src/Game/AI/FuzzyRuntimeBase.cpp
+++ b/src/Game/AI/FuzzyRuntimeBase.cpp
@@ -1,3 +1,6 @@
+#if defined(MSCHARGED_NATIVE)
+#include "platform/vm_address_abi.h"
+#endif
 #include "Game/AI/Scripts/ScriptCaching.h"
 #include "Game/AI/FuzzyAIRuntime.h"
 #include "Game/AI/ScriptMachine.h"
@@ -334,7 +337,11 @@
         FunctionEntryPoint* function = runtime->FindFunctionEntryPoint(localHash);
         runtime->mCaptureReturnValue = true;
         runtime->ExecuteFunction(
+#if defined(MSCHARGED_NATIVE)
+            function, 1, mscharged::platform::EncodeOwnedVMAddress(value), 0, 0, 0);
+#else
             function, 1, (u32)value, 0, 0, 0);
+#endif
 
         UnidentifiedVariant_80054AB8* result =
             *(UnidentifiedVariant_80054AB8**)runtime->m_SP;
