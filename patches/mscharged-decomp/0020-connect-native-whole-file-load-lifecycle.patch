+void nlAbortEntireFileLoad(nlFile* file);
+void nlShutdownEntireFileLoads();
 #endif
 void nlCancelPendingAsyncReads(nlFile* pFile, void (*callback)(nlFile*, void*, unsigned int, nlFileAsyncParam, void (*)(nlFile*, void*, unsigned int, nlFileAsyncParam)));
 bool nlAsyncReadsPending(nlFile* file);
