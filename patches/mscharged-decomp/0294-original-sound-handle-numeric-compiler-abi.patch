From: mscharged-port native source preparation
Subject: [PATCH] Preserve original sound handle numeric carrier and native runtime declarations
Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a
Classification: permanent modern compiler and Wii32 numeric carrier adaptation.

XSoundHandle value2 is the original cueIndex encoded by XSoundCueHandle, never
an address. Keep its exact word and source SetCue/ownership flow. Use the native
standard size declaration and omit only the unsupported MWCC init attribute
on original runtime extern declarations, retaining all declared types/symbols.
No cue/voice, factory, backend or AX initialization decisions change. Static
pool definitions stay in their complete original TUs with original counts/deltas.

diff --git a/src/Game/Audio/XSoundHandle.cpp b/src/Game/Audio/XSoundHandle.cpp
--- a/src/Game/Audio/XSoundHandle.cpp
+++ b/src/Game/Audio/XSoundHandle.cpp
@@ -5,6 +5,10 @@
 
 #include "NL/nlMemory.h"
 #include "NL/nlPrint.h"
+
+#if defined(MSCHARGED_NATIVE)
+#include "platform/native_registry_word.h"
+#endif
 
 static char sHitMarkerWarning[]
     = "Warning: hit marker (%d) with no callback\n";
@@ -26,7 +30,11 @@
     , m_Callback(callback)
     , m_CallbackContext(callbackContext)
 {
+#if defined(MSCHARGED_NATIVE)
+    SetCue((u32**)value1, mscharged::platform::ReadWii32RegistryWord(value2));
+#else
     SetCue((u32**)value1, (u32)value2);
+#endif
     if (m_Owner != 0)
     {
         m_Owner->count.references++;
diff --git a/libs/Runtime/include/NMWException.h b/libs/Runtime/include/NMWException.h
--- a/libs/Runtime/include/NMWException.h
+++ b/libs/Runtime/include/NMWException.h
@@ -2,7 +2,11 @@
 
 #include <cstring>
 #include <__ppc_eabi_linker.h>
+#if defined(MSCHARGED_NATIVE)
+#include <cstddef>
+#else
 #include <size_t.h>
+#endif
 
 typedef void* ctor_dtor_ptr;
 
diff --git a/libs/Runtime/include/__ppc_eabi_linker.h b/libs/Runtime/include/__ppc_eabi_linker.h
--- a/libs/Runtime/include/__ppc_eabi_linker.h
+++ b/libs/Runtime/include/__ppc_eabi_linker.h
@@ -1,11 +1,17 @@
 #ifndef PPC_EABI_LINKER_H
 #define PPC_EABI_LINKER_H
 
-__declspec(section ".init") extern char _stack_addr[];
-__declspec(section ".init") extern char _stack_end[];
+#if defined(MSCHARGED_NATIVE)
+#define CHARGED_RUNTIME_INIT_DECL
+#else
+#define CHARGED_RUNTIME_INIT_DECL __declspec(section ".init")
+#endif
 
-__declspec(section ".init") extern char _SDA_BASE_[];
-__declspec(section ".init") extern char _SDA2_BASE_[];
+CHARGED_RUNTIME_INIT_DECL extern char _stack_addr[];
+CHARGED_RUNTIME_INIT_DECL extern char _stack_end[];
+
+CHARGED_RUNTIME_INIT_DECL extern char _SDA_BASE_[];
+CHARGED_RUNTIME_INIT_DECL extern char _SDA2_BASE_[];
 
 typedef struct __eti_init_info
 {
@@ -15,7 +21,7 @@
     unsigned long code_size;
 } __eti_init_info;
 
-__declspec(section ".init") extern __eti_init_info _eti_init_info[];
+CHARGED_RUNTIME_INIT_DECL extern __eti_init_info _eti_init_info[];
 
 typedef struct __rom_copy_info
 {
@@ -24,7 +30,7 @@
     unsigned int size;
 } __rom_copy_info;
 
-__declspec(section ".init") extern __rom_copy_info _rom_copy_info[];
+CHARGED_RUNTIME_INIT_DECL extern __rom_copy_info _rom_copy_info[];
 
 typedef struct __bss_init_info
 {
@@ -32,6 +38,8 @@
     unsigned int size;
 } __bss_init_info;
 
-__declspec(section ".init") extern __bss_init_info _bss_init_info[];
+CHARGED_RUNTIME_INIT_DECL extern __bss_init_info _bss_init_info[];
+
+#undef CHARGED_RUNTIME_INIT_DECL
 
 #endif // PPC_EABI_LINKER_H
