From: mscharged-port
Subject: Pass the GP buddy and block indices through intptr_t
Upstream-base: a353c8f2dfb34eb08fecd725965a46ea629428e3
Classification: native compiler/ABI compatibility; no game behavior change.

gpiDeleteBuddy hands the removed buddy's index to gpiFixBuddyIndices
through gpiProfileMap's void* argument, converting it through unsigned
long both ways. The Korean build's newer GP code does the same for its
buddy status entries and its block list (gpiAddToBlockedList,
gpiRemoveFromBlockedList, gpiFixBlockIndices). Windows is LLP64, where
long is 32 bits and narrower than a pointer, and the native build rejects
both conversions as errors. Like the DWC callback arguments in 0721, the
index now goes through intptr_t; the value is the same on every target.

diff --git a/src/RVL_SDK/gamespy/GP/gpiBuddy.c b/src/RVL_SDK/gamespy/GP/gpiBuddy.c
index e0e5365..438538f 100644
--- a/src/RVL_SDK/gamespy/GP/gpiBuddy.c
+++ b/src/RVL_SDK/gamespy/GP/gpiBuddy.c
@@ -974,7 +974,7 @@ GPResult gpiAuthBuddyRequest(GPConnection* connection, GPProfile profile) {
 
 GPIBool gpiFixBuddyIndices(GPConnection* connection, GPIProfile* profile,
                            void* data) {
-  int baseIndex = (int)(unsigned long)data;
+  int baseIndex = (int)(intptr_t)data;
 
   GSI_UNUSED(connection);
 
@@ -1035,7 +1035,7 @@ GPResult gpiDeleteBuddy(GPConnection* connection, GPProfile profile,
       gpiRemoveProfile(connection, pProfile);
     iconnection->profileList.numBuddies--;
     assert(iconnection->profileList.numBuddies >= 0);
-    gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(unsigned long)index);
+    gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(intptr_t)index);
   }
 #if defined(VERSION_R4QK01)
   if (pProfile->buddyStatusInfo) {
@@ -1055,7 +1055,7 @@ GPResult gpiDeleteBuddy(GPConnection* connection, GPProfile profile,
       gpiRemoveProfile(connection, pProfile);
     iconnection->profileList.numBuddies--;
     assert(iconnection->profileList.numBuddies >= 0);
-    gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(unsigned long)index);
+    gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(intptr_t)index);
   }
 #endif
   return GP_NO_ERROR;
diff --git a/src/RVL_SDK/gamespy/GP/gpiProfile.c b/src/RVL_SDK/gamespy/GP/gpiProfile.c
index e4cda4a..adb2fdc 100644
--- a/src/RVL_SDK/gamespy/GP/gpiProfile.c
+++ b/src/RVL_SDK/gamespy/GP/gpiProfile.c
@@ -506,7 +506,7 @@ GPResult gpiAddToBlockedList(GPConnection* connection, int profileid) {
       freeclear(profile->buddyStatus);
       iconnection->profileList.numBuddies--;
       assert(iconnection->profileList.numBuddies >= 0);
-      gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(unsigned long)index);
+      gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(intptr_t)index);
     }
     if (profile->buddyStatusInfo) {
       index = profile->buddyStatusInfo->buddyIndex;
@@ -521,7 +521,7 @@ GPResult gpiAddToBlockedList(GPConnection* connection, int profileid) {
       }
       iconnection->profileList.numBuddies--;
       assert(iconnection->profileList.numBuddies >= 0);
-      gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(unsigned long)index);
+      gpiProfileMap(connection, gpiFixBuddyIndices, (void*)(intptr_t)index);
     }
   }
 
@@ -544,7 +544,7 @@ GPResult gpiAddToBlockedList(GPConnection* connection, int profileid) {
 
 static GPIBool gpiFixBlockIndices(GPConnection* connection,
                                   GPIProfile* profile, void* data) {
-  int baseIndex = (int)(unsigned long)data;
+  int baseIndex = (int)(intptr_t)data;
   GSI_UNUSED(connection);
 
   if (profile->blocked && (profile->blockIndex > baseIndex))
@@ -561,7 +561,7 @@ GPResult gpiRemoveFromBlockedList(GPConnection* connection, int profileid) {
     profile->blocked = gsi_false;
     iconnection->profileList.numBlocked--;
     index = profile->blockIndex;
-    gpiProfileMap(connection, gpiFixBlockIndices, (void*)(unsigned long)index);
+    gpiProfileMap(connection, gpiFixBlockIndices, (void*)(intptr_t)index);
   }
 
   gpiAppendStringToBuffer(connection, &iconnection->outputBuffer,
