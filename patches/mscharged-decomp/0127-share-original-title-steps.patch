+#ifndef GAME_FE_FRONTEND_TITLE_STEPS_H
+#define GAME_FE_FRONTEND_TITLE_STEPS_H
+// Selected exact TitleScene fragments. Console delegates retain unselected Wii,
+// icon/banner, smoke/soak and full scene-manager services.
+inline void FrontendTitleGameplaySettingsUpdated() {}
+inline void FrontendTitleCheatSettingsUpdated() {}
+template<class Pointer,class Transition,class Play>
+void FrontendTitleStartMovie(Pointer pointer,Transition transition,Play play)
+{
+    for (int i = 0; i < 4; ++i)
+    {
+        pointer(i,"waiting");
+    }
+    transition();
+    play(0x80060B2D, 0, 0, 1);
+}
+template<class TLComponentInstance,template<class,int>class FEFinder,class TLSlide,class S,class Wide,class Pointer,class Music,class Enable,class Nav,class Play>
+void FrontendTitleCreated(S& s,Wide wide,Pointer pointer,Music music,Enable enable,Nav navigation,Play play)
+{
+    if (wide())
+    {
+        s.mPresentation->SetActiveSlide("widescreen", true);
+    }
+    else
+    {
+        s.mPresentation->SetActiveSlide("regular", true);
+    }
+
+    for (int i = 0; i < 4; ++i)
+    {
+        pointer(i,"waiting");
+    }
+
+    s.mTextPressStart = FEFinder<TLComponentInstance, 2>::template Find<TLSlide>(
+        s.mPresentation->m_currentSlide,
+        "Layer2",
+        "Component2",
+        0,
+        0,
+        0,
+        0);
+
+    music(0);
+    enable(false);
+    navigation();
+
+    if (s.mMovement != 2)
+    {
+        play(0x26894C84, 0, 0, 1);
+    }
+}
+template<class S,class Base,class Initialize,class Pointer>
+bool FrontendTitleBeginUpdate(S& s,float dt,Base baseUpdate,Initialize initialize,Pointer pointer)
+{
+    baseUpdate(dt);
+    s.m_fTimeElapsed += dt;
+    if (s.m_fTimeElapsed < 1.5f)
+        return false;
+
+    if (!s.mInitialized)
+    {
+        initialize();
+
+        for (int i = 0; i < 4; ++i)
+        {
+            pointer(i,"cursor");
+        }
+        s.mInitialized = true;
+    }
+
+    if (s.mStartedDemo)
+        return false;
+
+    return true;
+}
+template<class S,class Stop,class Enable,class Intro>
+bool FrontendTitleIdle(S& s,Stop stopMusic,Enable enable,Intro intro)
+{        if (s.m_fTimeElapsed > 160.0f)
+        {
+            stopMusic();
+            enable(false);
+            intro();
+            s.mStartedDemo = true;
+            s.m_fTimeElapsed = 0.0f;
+            return true;
+        }
+
+    return false;
+}
+template<class S,class Pointer,class Pressed,class Press>
+bool FrontendTitlePadInput(S& s,int pad,Pointer pointerA,Pressed pressed,Press press)
+{        pointerA();
+        if (pressed(pad, 0x1E, true, 0))
+        {
+            press(pad);
+        }
+
+        bool acceptedInput = false;
+        for (int input = 0; input < 6; ++input)
+        {
+            if (!s.mControllerReady[input])
+            {
+                if (pressed(
+                        pad, s.mControllerDefaults[input], true, 0))
+                {
+                    s.mControllerReady[input] = true;
+                    acceptedInput = true;
+                    break;
+                }
+                else if (pressed(pad, 0x1E, true, 0)
+                    || pressed(pad, 0x1F, true, 0)
+                    || pressed(pad, 0x29, true, 0)
+                    || pressed(pad, 0x28, true, 0)
+                    || pressed(pad, 0x2D, true, 0)
+                    || pressed(pad, 0x2C, true, 0)
+                    || pressed(pad, 0x30, true, 0)
+                    || pressed(pad, 0x31, true, 0)
+                    || pressed(pad, 0x0C, true, 0)
+                    || pressed(pad, 0x0B, true, 0)
+                    || pressed(pad, 0x0D, true, 0)
+                    || pressed(pad, 0x0E, true, 0))
+                {
+                    for (int reset = 0; reset < 6; ++reset)
+                    {
+                        s.mControllerReady[reset] = false;
+                    }
+                }
+            }
+        }
+
+        if (!acceptedInput
+            && (pressed(pad, 0x1E, true, 0)
+                || pressed(pad, 0x1F, true, 0)
+                || pressed(pad, 0x29, true, 0)
+                || pressed(pad, 0x28, true, 0)
+                || pressed(pad, 0x2D, true, 0)
+                || pressed(pad, 0x2C, true, 0)
+                || pressed(pad, 0x30, true, 0)
+                || pressed(pad, 0x31, true, 0)
+                || pressed(pad, 0x0C, true, 0)
+                || pressed(pad, 0x0B, true, 0)
+                || pressed(pad, 0x0D, true, 0)
+                || pressed(pad, 0x0E, true, 0)))
+        {
+            for (int reset = 0; reset < 6; ++reset)
+            {
+                s.mControllerReady[reset] = false;
+            }
+        }
+
+        bool sequenceReady = true;
+        for (int input = 0; input < 6; ++input)
+        {
+            sequenceReady = sequenceReady && s.mControllerReady[input];
+        }
+
+        return sequenceReady;
+}
+template<class S,class Play>
+void FrontendTitleEnter(S& s,int index,Play play)
+{
+    s.mTextPressStart->SetActiveSlide("over", true, false);
+    s.mControllerComponent.SetPointerState(1, index);
+    play(0xAA73EF32, 0, 0, 1);
+    s.mUnidentifiedDF = true;
+}
+template<class S>
+void FrontendTitleLeave(S& s,int index)
+{
+    s.mTextPressStart->SetActiveSlide("off", true, false);
+    s.mControllerComponent.SetPointerState(0, index);
+    s.mUnidentifiedDF = false;
+}
+template<class S,class Play,class Enable,class Pop,class Gameplay,class Cheats,class Dimming>
+void FrontendTitlePressPrefix(S& s,int index,Play play,Enable enable,Pop pop,Gameplay gameplay,Cheats cheats,Dimming dimming)
+{
+    s.mTextPressStart->SetActiveSlide("down", true, false);
+    s.mControllerComponent.SetPointerState(2, index);
+    play(0x55C84A9D, 0, 0, 1);
+    enable(true);
+    pop();
+    gameplay();
+    cheats();
+    dimming(0);
+
+}
+template<class S>
+void FrontendTitleBind(S& s)
+{
+    s.mControllerComponent.SetInstanceBounds(s.mTextPressStart, true, 0.0f, 0.0f, 1.0f, 1.0f);
+}
+#endif
