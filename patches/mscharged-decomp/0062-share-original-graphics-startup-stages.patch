Subject: Share original graphics startup stages and task priorities

Upstream-base: 9f985f9aca654d7ec13ff894830f19aeb3f7aefd

Share the original resource callback, state/default/matrix and target/view
stages between glStartup and explicitly selected native services. Keep full
glStartup, its 43-program registry, platform startup and fonts unselected.
Spell the original Wii -1 texture sentinel as 0xFFFFFFFFu so LP64 does not
produce a different unsigned-long value. Console state ordering is unchanged.
Share the four original frame priorities and world state mask from AddTasks;
the native scheduler uses selected callbacks, not full game task substitutes.

diff --git a/include/NL/gl/glStartupStages.h b/include/NL/gl/glStartupStages.h
new file mode 100644
--- /dev/null
+++ b/include/NL/gl/glStartupStages.h
@@ -0,0 +1,36 @@
+// Shared stages from original glStartup; callers supply missing service boundaries.
+#ifndef NL_GL_STARTUP_STAGES_H
+#define NL_GL_STARTUP_STAGES_H
+#include "NL/gl/glMemory.h"
+#include "NL/gl/glMatrix.h"
+#include "NL/gl/glState.h"
+#include "NL/gl/glStat.h"
+#include "NL/gl/glTarget.h"
+#include "NL/gl/glView.h"
+
+inline void gl_StartupMemory(void (*startupCallback)())
+{
+    glInitResourcePools();
+    startupCallback();
+}
+
+inline void gl_StartupState()
+{
+    gl_StatStartup();
+    gl_StateStartup();
+    for (int i = 0; i < GLTT_Num; ++i)
+        glSetCurrentTexture(0xFFFFFFFFu, (eGLTextureType)i);
+
+    glSetRasterStateDefaults();
+    glSetCurrentRasterState(glHandleizeRasterState());
+    glSetTextureStateDefaults();
+    glSetCurrentTextureState(glHandleizeTextureState());
+    gl_MatrixStartup();
+}
+
+inline void gl_StartupViews()
+{
+    gl_TargetStartup();
+    gl_ViewStartup();
+}
+#endif
