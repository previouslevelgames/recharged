+#endif
+
 // clang-format off
 void SAnimInitGQR()
 {
     register unsigned int value = 0x0F070F07;
+#ifdef MSCHARGED_NATIVE
+    // Native quantized loads encode this fixed GQR6 format and scale directly.
+    (void)value;
+#else
     asm {
         mtspr 918, value
     }
+#endif
     value = 0x07060706;
+#ifdef MSCHARGED_NATIVE
+    // Native quantized loads encode this fixed GQR7 format and scale directly.
+    (void)value;
+#else
     asm {
         mtspr 919, value
     }
+#endif
 }
 // clang-format on
 
 // clang-format off
 extern "C" void SAnimDecodeRot16(register nlQuaternion* result, register const void* packed)
 {
+#ifdef MSCHARGED_NATIVE
+    auto f0 = mscharged::platform::LoadSignedQuantizedPair<16, 15>(packed);
+    mscharged::platform::StoreFloatPair(result, f0);
+    f0 = mscharged::platform::LoadSignedQuantizedPair<16, 15>(
+        (const unsigned char*)packed + 4);
+    mscharged::platform::StoreFloatPair((unsigned char*)result + 8, f0);
+#else
     asm {
         psq_l f0, 0(packed), 0, 6
         psq_st f0, 0(result), 0, 0
         psq_l f0, 4(packed), 0, 6
         psq_st f0, 8(result), 0, 0
     }
+#endif
 }
