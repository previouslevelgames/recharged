 #include "NL/gl/glPlat.h"
 #include "Game/SharedStaticStorage.h"
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/game_allocation_ownership.h"
+#endif
 
 GLShadowBlendMeshWriter::GLShadowBlendMeshWriter()
 {
@@ -146,6 +149,11 @@
     if (finished || writtenPosition != unsigned(count) || writtenColour != unsigned(count) || writtenUV != unsigned(count))
         throw std::logic_error("Incomplete or already finalized shadow mesh");
 #endif
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mscharged::platform::PublishGameGraphicsNativeBytes(model->packets->streams[0].address, position);
+    mscharged::platform::PublishGameGraphicsNativeBytes(model->packets->streams[1].address, colour);
+    mscharged::platform::PublishGameGraphicsNativeBytes(model->packets->streams[2].address, texcoord);
+#endif
     for (int i = 0; i < model->numPackets; ++i)
     {
         glModelPacket* packet = &model->packets[i];
