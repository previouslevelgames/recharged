Subject: [PATCH] Share canonical native cache declarations
Upstream-base: 2c5c51e483b652d178ef06a44b83b07a0f97d2a6

Permanent hardware/compiler ABI adaptation: the native C declarations come
from Aurora's canonical cache API with Wii-width byte counts. Const source
views forward by pointer qualification only. Original console declarations
and all original loader/pool bodies remain unchanged.

diff --git a/libs/RVL_SDK/include/revolution/os/OSCache_fwd.h b/libs/RVL_SDK/include/revolution/os/OSCache_fwd.h
--- a/libs/RVL_SDK/include/revolution/os/OSCache_fwd.h
+++ b/libs/RVL_SDK/include/revolution/os/OSCache_fwd.h
@@ -1,6 +1,20 @@
 #ifndef REVOLUTION_OS_CACHE_FWD_H
 #define REVOLUTION_OS_CACHE_FWD_H
 
+#if defined(MSCHARGED_NATIVE)
+#include <dolphin/os/OSCache.h>
+#ifdef __cplusplus
+// The SDK owns the canonical C declarations and Wii-width byte counts.
+// Source const views only adapt the pointer qualification at this boundary.
+inline void DCInvalidateRange(const void* p, u32 n) { DCInvalidateRange(const_cast<void*>(p), n); }
+inline void DCFlushRange(const void* p, u32 n) { DCFlushRange(const_cast<void*>(p), n); }
+inline void DCStoreRange(const void* p, u32 n) { DCStoreRange(const_cast<void*>(p), n); }
+inline void DCFlushRangeNoSync(const void* p, u32 n) { DCFlushRangeNoSync(const_cast<void*>(p), n); }
+inline void DCStoreRangeNoSync(const void* p, u32 n) { DCStoreRangeNoSync(const_cast<void*>(p), n); }
+inline void DCZeroRange(const void* p, u32 n) { DCZeroRange(const_cast<void*>(p), n); }
+inline void ICInvalidateRange(const void* p, u32 n) { ICInvalidateRange(const_cast<void*>(p), n); }
+#endif
+#else
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -17,4 +31,6 @@
 }
 #endif
 
+#endif // MSCHARGED_NATIVE
+
 #endif // REVOLUTION_OS_CACHE_FWD_H
diff --git a/libs/RVL_SDK/include/revolution/os/OSCache.h b/libs/RVL_SDK/include/revolution/os/OSCache.h
--- a/libs/RVL_SDK/include/revolution/os/OSCache.h
+++ b/libs/RVL_SDK/include/revolution/os/OSCache.h
@@ -1,5 +1,14 @@
 #ifndef REVOLUTION_OS_CACHE_H
 #define REVOLUTION_OS_CACHE_H
+
+#if defined(MSCHARGED_NATIVE)
+#include <revolution/os/OSCache_fwd.h>
+#ifdef __cplusplus
+inline void LCLoadBlocks(void* d, const void* s, u32 n) { LCLoadBlocks(d, const_cast<void*>(s), n); }
+inline void LCStoreBlocks(void* d, const void* s, u32 n) { LCStoreBlocks(d, const_cast<void*>(s), n); }
+inline u32 LCStoreData(void* d, const void* s, u32 n) { return LCStoreData(d, const_cast<void*>(s), n); }
+#endif
+#else
 
 #include <revolution/os/OSCache_fwd.h>
 #include <revolution/types.h>
@@ -30,4 +39,6 @@
 }
 #endif
 
+#endif // MSCHARGED_NATIVE
+
 #endif  // REVOLUTION_OS_CACHE_H
