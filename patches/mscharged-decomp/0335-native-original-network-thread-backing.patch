From: mscharged native port
Subject: [PATCH] Back original network SDK descriptors with native size and alignment
Upstream-base: 0f5a757947b8778b680d4d1ae7e6df1792a514f2

Use canonical native OSThread extent/alignment for live embedded descriptors.
Preserve original network methods, constructors, stack requests, packed wire
records and console fields. Keep the source detached-bit name as a native alias.
This does not initialize network readiness or qualify HBM/game/network runtime.

diff --git a/libs/RVL_SDK/include/revolution/os/OSThread.h b/libs/RVL_SDK/include/revolution/os/OSThread.h
--- a/libs/RVL_SDK/include/revolution/os/OSThread.h
+++ b/libs/RVL_SDK/include/revolution/os/OSThread.h
@@ -3,6 +3,7 @@
 
 #if defined(MSCHARGED_NATIVE)
 #include <dolphin/os/OSThread.h>
+#define OS_THREAD_DETACHED OS_THREAD_ATTR_DETACH
 #else
 
 #include <revolution/os/OSContext.h>
diff --git a/include/Game/NetworkSession.h b/include/Game/NetworkSession.h
--- a/include/Game/NetworkSession.h
+++ b/include/Game/NetworkSession.h
@@ -2,6 +2,10 @@
 #define GAME_NETWORK_SESSION_H
 
 #include "Game/NetworkDebug.h"
+
+#if defined(MSCHARGED_NATIVE)
+#include <dolphin/os/OSThread.h>
+#endif
 
 #include "Game/LANLobbyListener.h"
 #include "Game/main.h"
@@ -512,7 +516,11 @@
     /* 0x24A0 */ float mLoginStartTime;
     /* 0x24A4 */ u8 mLoginRequestStarted;
     /* 0x24A5 */ u8 mDWCInitialized;
+#if defined(MSCHARGED_NATIVE)
+    alignas(OSThread) u32 mLoginThread[sizeof(OSThread) / sizeof(u32)];
+#else
     /* 0x24A8 */ u32 mLoginThread[0x318 / 4];
+#endif
     /* 0x27C0 */ u8 mLoginThreadStack[0x4000];
 }; // size: 0x67C0
 
diff --git a/include/Game/NetworkLobby.h b/include/Game/NetworkLobby.h
--- a/include/Game/NetworkLobby.h
+++ b/include/Game/NetworkLobby.h
@@ -109,7 +109,11 @@
     /* 0x00F4 */ NetworkDraftMachineInfo mMachineInfo[4];
     /* 0x02F4 */ volatile bool mMatchmakingThreadRunning;
     /* 0x02F5 */ u8 mPadding2F5[3];
+#if defined(MSCHARGED_NATIVE)
+    alignas(OSThread) u8 mMatchmakingThread[sizeof(OSThread)];
+#else
     /* 0x02F8 */ u8 mMatchmakingThread[0x318];
+#endif
     /* 0x0610 */ u8 mMatchmakingThreadStack[0x4000];
 }; // size: 0x4610
 
