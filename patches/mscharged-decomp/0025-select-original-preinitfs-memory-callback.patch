+#ifndef GAME_GRAPHICS_MEMORY_STARTUP_H
+#define GAME_GRAPHICS_MEMORY_STARTUP_H
+#if defined(MSCHARGED_NATIVE)
+// Runs the original memory callback; this does not call the rest of glStartup.
+void InitializeOriginalGraphicsMemory();
+#endif
+#endif
diff --git a/src/Game/GraphicsMemoryStartup.cpp b/src/Game/GraphicsMemoryStartup.cpp
new file mode 100644
--- /dev/null
+++ b/src/Game/GraphicsMemoryStartup.cpp
@@ -0,0 +1,37 @@
+// The original PreInitFS callback, selected independently of the incomplete main.
+#include "Game/GraphicsMemoryStartup.h"
+#include "NL/gl/glMemoryInit.h"
+#include "NL/gl/glMemory.h"
+#include "NL/nlMemory.h"
+#include "NL/nlDebug.h"
+#if defined(MSCHARGED_NATIVE)
+#include <stdexcept>
+#endif
+
+static GLMemoryRequirement sGlobalResourceRequirements[3] = {
+    { GLM_TextureData, MB(3) },
+    { GLM_VertexData, MB(2) },
+    { GLM_Header, MB(2) + KB(256) },
+};
+
+static void PreInitFS()
+{
+    GLMemoryConfig config;
+    config.mFrameMemSize1 = 0x80000;
+    config.mFrameMemSize2 = 0x233333;
+    config.mResourceRequirements = sGlobalResourceRequirements;
+    config.mNumResourceRequirements = 3;
+    config.mMaxTextures = 1000;
+    if (!glInitMemory(&config))
+    {
+#if defined(MSCHARGED_NATIVE)
+        throw std::runtime_error("Original PreInitFS graphics memory initialization failed");
+#else
+        nlBreak();
+#endif
+    }
+}
+
+#if defined(MSCHARGED_NATIVE)
+void InitializeOriginalGraphicsMemory() { PreInitFS(); }
+#endif
