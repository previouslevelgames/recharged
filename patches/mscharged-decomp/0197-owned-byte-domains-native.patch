@@ -74,32 +77,52 @@
 
 inline unsigned int nlChunk::GetChunkAlignment()
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    unsigned int alignmentBits = mscharged::platform::ReadGameChunkWord(this, 0) & 0x0F000000;
+#else
     unsigned int alignmentBits = m_ID & 0x0F000000;
+#endif
     return alignmentBits != 0 ? 1u << (alignmentBits >> 24) : 0;
 }
 
 inline bool nlChunk::IsAlignedChunk()
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    unsigned int alignmentBits = mscharged::platform::ReadGameChunkWord(this, 0);
+#else
     unsigned int alignmentBits = m_ID;
+#endif
     alignmentBits &= 0x0F000000;
     return alignmentBits != 0;
 }
 
 inline unsigned int nlChunk::GetSize()
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    return mscharged::platform::ReadGameChunkWord(this, 1);
+#else
     return m_Size;
+#endif
 }
 
 inline unsigned long nlChunk::GetDataSize()
 {
     unsigned long size = (u8*)GetAlignedData() - (u8*)GetUnalignedData();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    size = mscharged::platform::ReadGameChunkWord(this, 1) - size;
+#else
     size = m_Size - size;
+#endif
     return size;
 }
 
 inline unsigned long nlChunk::GetID()
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    return mscharged::platform::ReadGameChunkWord(this, 0) & 0x80FFFFFF;
+#else
     return m_ID & 0x80FFFFFF;
+#endif
 }
 
 #endif // NL_CHUNK_H
