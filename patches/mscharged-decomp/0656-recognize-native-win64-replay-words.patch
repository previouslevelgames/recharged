Subject: Recognize existing native Win64 address words as Replay POD
Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a

Win64 uintptr_t is unsigned long long. Preserve the existing native
POD sizeof(T) stream policy and console categories; no field or replay
algorithm changes and no cross-run or Wii replay import claim.

--- a/include/Game/Replay.h
+++ b/include/Game/Replay.h
@@ -72,6 +72,16 @@
 {
     typedef ReplayablePod Type;
 };
+
+// Win64 uintptr_t is unsigned long long; original native address words already
+// use pointer width. Keep the source POD byte count and all console categories.
+#if defined(MSCHARGED_NATIVE) && defined(_WIN64)
+template <>
+struct ReplayableCategory<unsigned long long>
+{
+    typedef ReplayablePod Type;
+};
+#endif
 
 template <>
 struct ReplayableCategory<nlVector3>
