Subject: [PATCH] adapt original NL whole-file pointer handles and native owner cleanup

Upstream-base: c7b2e663f878d38dc429ab12ee7db451daf0c217

Keep source requests/callbacks/cancellation decisions. Represent actual raw
entry addresses across the u32 public API without pointer truncation; wire
actual source owner cleanup to native raw failure and shutdown hooks.

--- a/src/NL/nlFile.cpp
+++ b/src/NL/nlFile.cpp
@@ -5,9 +5,13 @@
 #include "NL/nlCompressedFile.h"
 #include "NL/nlFileGC.h"
 #include "NL/nlMemory.h"
-
-
-void nlCancelEntireFileLoadCallback(nlFile*, void*, unsigned int, unsigned long, ReadAsyncCallback);
+#ifdef MSCHARGED_NATIVE
+#include "platform/file_handle_abi.h"
+#include <new>
+#endif
+
+
+void nlCancelEntireFileLoadCallback(nlFile*, void*, unsigned int, nlFileAsyncParam, ReadAsyncCallback);
 void (*sCancelFileLoadCallback)(void*, unsigned long, void*, LoadAsyncCallback);
 
 struct AsyncFileLoadData
@@ -30,9 +34,34 @@
 
 #include "nlFileBasic.cpp"
 
-static void nlLoadEntireFileAsyncCallback(nlFile*, void*, unsigned int, unsigned long userParam)
+#ifdef MSCHARGED_NATIVE
+// Real raw failure/shutdown releases the original owner without calling its
+// success callback. Closing the actual file joins workers before freeing data.
+static void nlAbortEntireFileLoadData(void* context)
+{
+    AsyncFileLoadData* data = (AsyncFileLoadData*)context;
+    delete data->file;
+    nlFree(data->alloc_data);
+    delete data;
+}
+
+void nlAbortEntireFileLoad(nlFile* file)
+{
+    mscharged::platform::AbortFileLoadsForFile(file);
+}
+
+void nlShutdownEntireFileLoads()
+{
+    mscharged::platform::ShutdownFileLoads();
+}
+#endif
+
+static void nlLoadEntireFileAsyncCallback(nlFile*, void*, unsigned int, nlFileAsyncParam userParam)
 {
     AsyncFileLoadData* data = (AsyncFileLoadData*)userParam;
+#ifdef MSCHARGED_NATIVE
+    mscharged::platform::FinishFileLoad(data);
+#endif
     data->callback(data->alloc_data, data->datasize, data->user_data);
     delete data->file;
     delete data;
@@ -87,7 +116,29 @@
         CurrentAllocator = AllocatorStack[AllocatorStackDepth - 1];
 
         asyncData = new (nlMalloc(sizeof(AsyncFileLoadData), 8, true)) AsyncFileLoadData(file, alloc_data, datasize, callback, user_data);
-        result = (unsigned int)nlReadAsync(file, alloc_data, datasize, nlLoadEntireFileAsyncCallback, (unsigned long)asyncData, filesize);
+#ifdef MSCHARGED_NATIVE
+        if (asyncData == 0)
+        {
+            delete file;
+            nlFree(alloc_data);
+            throw std::bad_alloc();
+        }
+        mscharged::platform::FileLoadLease* lease = 0;
+        try
+        {
+            lease = mscharged::platform::ReserveFileLoad(asyncData, file, nlAbortEntireFileLoadData);
+            AsyncEntry* read = nlReadAsync(file, alloc_data, datasize, nlLoadEntireFileAsyncCallback, (nlFileAsyncParam)asyncData, filesize);
+            result = mscharged::platform::BindFileLoad(lease, read);
+        }
+        catch (...)
+        {
+            if (lease != 0) mscharged::platform::AbortFileLoad(asyncData);
+            else nlAbortEntireFileLoadData(asyncData);
+            throw;
+        }
+#else
+        result = (unsigned int)nlReadAsync(file, alloc_data, datasize, nlLoadEntireFileAsyncCallback, (nlFileAsyncParam)asyncData, filesize);
+#endif
     }
     else
     {
@@ -99,18 +150,26 @@
 
 bool nlCancelEntireFileLoad(unsigned int handle, void (*callback)(void*, unsigned long, void*, LoadAsyncCallback))
 {
-    if (nlAsyncReadBusy((AsyncEntry*)handle))
+#ifdef MSCHARGED_NATIVE
+    AsyncEntry* read = (AsyncEntry*)mscharged::platform::ResolveFileReadHandle(handle);
+#else
+    AsyncEntry* read = (AsyncEntry*)handle;
+#endif
+    if (nlAsyncReadBusy(read))
         return false;
 
     sCancelFileLoadCallback = callback;
-    nlCancelAsyncRead((AsyncEntry*)handle, nlCancelEntireFileLoadCallback);
+    nlCancelAsyncRead(read, nlCancelEntireFileLoadCallback);
     sCancelFileLoadCallback = 0;
     return true;
 }
 
-void nlCancelEntireFileLoadCallback(nlFile*, void* pBuffer, unsigned int, unsigned long uParam, ReadAsyncCallback)
+void nlCancelEntireFileLoadCallback(nlFile*, void* pBuffer, unsigned int, nlFileAsyncParam uParam, ReadAsyncCallback)
 {
     AsyncFileLoadData* p = (AsyncFileLoadData*)uParam;
+#ifdef MSCHARGED_NATIVE
+    mscharged::platform::FinishFileLoad(p);
+#endif
     if (sCancelFileLoadCallback != 0)
         sCancelFileLoadCallback(p->alloc_data, p->datasize, p->user_data, p->callback);
 
@@ -119,7 +178,7 @@
     delete p;
 }
 
