diff --git a/src/NL/glx/GXBlackTextureAlphaMaterialProgramRender.cpp b/src/NL/glx/GXBlackTextureAlphaMaterialProgramRender.cpp
index 8eea9e5..c0e276f 100644
--- a/src/NL/glx/GXBlackTextureAlphaMaterialProgramRender.cpp
+++ b/src/NL/glx/GXBlackTextureAlphaMaterialProgramRender.cpp
@@ -14,27 +14,36 @@
 #include "NL/glx/glxDisplayList.h"
 #include "NL/nlMath.h"
 #include "Game/SharedStaticStorage.h"
+#if defined(MSCHARGED_AUTOMATIC_PREWARM)
+#include "platform/automatic_pipeline_prewarm.h"
+#endif
 
 bool glx_RenderBlackTextureAlpha = true;
 
 static nlMatrix4 sBlackTextureAlphaViewMatrix;
 static int sBlackTextureAlphaLightCount;
 
+// Shader state is shared by original drawing and native pipeline preparation.
+static void ConfigureBlackTextureAlphaPipelineState()
+{    GXSetVtxDesc(GX_VA_PNMTXIDX, GX_DIRECT);
+    gxSetNumChans(1);
+    gxSetNumTexGens(1);
+    gxSetNumTevStages(1);
+    gxSetTevOrder(GX_TEVSTAGE0, GX_TEXCOORD0, GX_TEXMAP0, GX_COLOR_NULL);
+    gxSetTevColourIn(GX_TEVSTAGE0, GX_CC_ZERO, GX_CC_RASC, GX_CC_TEXC, GX_CC_ZERO);
+    gxSetTevAlphaIn(GX_TEVSTAGE0, GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO, GX_CA_TEXA);
+}
+
 template <>
 void GXMaterialProgramImpl<GXBlackTextureAlphaMaterialProgram>::Activate(GLView* view)
 {
+
     static_cast<GXBlackTextureAlphaMaterialProgram*>(this)->ConfigureVertexFormat(true);
     view->m_Interface->GetViewMatrix(sBlackTextureAlphaViewMatrix);
     sBlackTextureAlphaLightCount = GetGameObjectLightCount(0, 1);
     LoadGameObjectLights(sBlackTextureAlphaLightCount, view, 0);
     SetGameObjectLightingEnabled(1, sBlackTextureAlphaLightCount, 0);
-    GXSetVtxDesc(GX_VA_PNMTXIDX, GX_DIRECT);
-    gxSetNumChans(1);
-    gxSetNumTexGens(1);
-    gxSetNumTevStages(1);
-    gxSetTevOrder(GX_TEVSTAGE0, GX_TEXCOORD0, GX_TEXMAP0, GX_COLOR_NULL);
-    gxSetTevColourIn(GX_TEVSTAGE0, GX_CC_ZERO, GX_CC_RASC, GX_CC_TEXC, GX_CC_ZERO);
-    gxSetTevAlphaIn(GX_TEVSTAGE0, GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO, GX_CA_TEXA);
+    ConfigureBlackTextureAlphaPipelineState();
 }
 
 template <>
@@ -82,3 +91,21 @@ void GXMaterialProgramImpl<GXBlackTextureAlphaMaterialProgram>::Draw(
 
     GXCallDisplayList(packet->displayList->list, packet->displayList->size);
 }
+
+#if defined(MSCHARGED_AUTOMATIC_PREWARM)
+void glxPrepareBlackTextureAlphaPipeline(const glModelPacket& packet)
+{
+    using namespace mscharged::platform;
+    auto* program = static_cast<GXBlackTextureAlphaMaterialProgram*>(static_cast<GLMaterialProgram*>(packet.materialProgram));
+    // The original lighting helper has six supported light masks.
+    for (int lights = 1; lights <= 6; ++lights)
+    {
+        BeginAutomaticMaterialVariant(packet);
+        program->ConfigureVertexFormat(true);
+        SetGameObjectLightingEnabled(true, lights, false);
+        ConfigureBlackTextureAlphaPipelineState();
+        program->BindVertexArrays(&packet);
+        EmitAutomaticMaterialPipeline(packet);
+    }
+}
+#endif
