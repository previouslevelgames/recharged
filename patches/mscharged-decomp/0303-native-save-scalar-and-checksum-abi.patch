Subject: [PATCH] Preserve original Wii32 save scalars and checksum words on native hosts

Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a
Scope: Native compiler/data ABI only; original checksum loops and save record decisions retained.

diff --git a/src/NL/nlMain.cpp b/src/NL/nlMain.cpp
--- a/src/NL/nlMain.cpp
+++ b/src/NL/nlMain.cpp
@@ -1,4 +1,7 @@
 #include "NL/nlMain.h"
+#if defined(MSCHARGED_NATIVE)
+#include <cstdint>
+#endif
 
 // CRC-32 lookup table (256 entries)
 unsigned int crcTable[256]
@@ -7,9 +10,17 @@
 void RunningChecksum::ChecksumData(const void* pData, unsigned long nDataLen)
 {
     const u8* pByte = (const u8*)pData;
+#if defined(MSCHARGED_NATIVE)
+    const u32* p32;
+#else
     const unsigned long* p32;
+#endif
 
+#if defined(MSCHARGED_NATIVE)
+    while ((reinterpret_cast<std::uintptr_t>(pByte) & 3) && nDataLen != 0)
+#else
     while (((u32)pByte & 3) && nDataLen != 0)
+#endif
     {
         u32 temp = m_nChecksum;
         nDataLen--;
@@ -17,7 +28,11 @@
         m_nChecksum = (temp >> 8) ^ crcTable[b ^ (u8)temp];
     }
 
+#if defined(MSCHARGED_NATIVE)
+    p32 = (const u32*)pByte;
+#else
     p32 = (const unsigned long*)pByte;
+#endif
     if (nDataLen >= 4)
     {
         while (nDataLen >= 4)
@@ -53,11 +68,19 @@
 {
     unsigned long index;
     unsigned long tableIndex;
+#if defined(MSCHARGED_NATIVE)
+    u32 crc;
+#else
     unsigned long crc;
+#endif
     const unsigned char* p;
 
     p = (const unsigned char*)data;
+#if defined(MSCHARGED_NATIVE)
+    crc = ~u32(0);
+#else
     crc = ~0UL;
+#endif
