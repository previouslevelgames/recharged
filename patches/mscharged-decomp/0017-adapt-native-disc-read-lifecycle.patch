+#ifdef MSCHARGED_NATIVE
+static void ValidateNativeRead(DolphinFile* file, void* buffer, unsigned int size, unsigned long capacity)
+{
+    if (!s_pAsyncManager) throw std::logic_error("NL file system is not initialized");
+    if (!file || (size && !buffer)) throw std::invalid_argument("Invalid NL read arguments");
+    if (capacity && capacity < size) throw std::length_error("NL read buffer is too small");
+    if (capacity > size && capacity < AlignUp32(size))
+        throw std::length_error("NL padded read buffer is too small");
+    if (file->m_Position > file->mLength || size > file->mLength-file->m_Position)
+        throw std::out_of_range("NL read exceeds the file length");
+    if (!size) return;
+    const unsigned needed = capacity > size || !(size & 31) || size < 32 ? 1 : 2;
+    unsigned available = 0;
+    if (auto* entry = s_pAsyncManager->m_freeEntryList)
+    {
+        auto* start = entry;
+        do { ++available; entry = entry->m_next; } while (entry != start && available < 64);
+    }
+    if (available < needed) throw std::bad_alloc();
+}
+
+void AsyncManager::ReleaseNative(AsyncEntry* entry)
+{
+    entry->m_pFile = 0;
+    nlDLRingAddEnd(&m_freeEntryList, entry);
+}
+
+bool AsyncManager::CancelNative(AsyncEntry* entry, CancelAsyncCallback callback)
+{
+    if (!Contains(entry)) return false;
+    if (entry->Phase == READ_TAIL) entry = entry->m_prev;
+    AsyncEntry* tail = entry->Phase == READ_HEAD && entry->m_next != entry
+        && entry->m_next->Phase == READ_TAIL && entry->m_next->m_pFile == entry->m_pFile
+        ? entry->m_next : 0;
+    // Stop every worker using the destination before a cancellation callback
+    // can release it. The head and tail are one logical request.
+    DVDClose(&entry->mFileInfo);
+    if (tail) DVDClose(&tail->mFileInfo);
+    auto* file = entry->m_pFile;
+    const unsigned int size = entry->m_uSize + (tail ? tail->m_uSize : 0);
+    --file->PendingAsync;
+    nlDLRingRemove(&m_activeEntryList, entry);
+    if (tail)
+    {
+        --file->PendingAsync;
+        nlDLRingRemove(&m_activeEntryList, tail);
+        ReleaseNative(tail);
+    }
+    auto* previous = mCurrent;
+    mCurrent = entry;
+    try
+    {
+        if (callback) callback(file, entry->m_pBuffer, size, entry->m_uParam, entry->m_pFunc);
+    }
+    catch (...) { mCurrent = previous; ReleaseNative(entry); throw; }
+    mCurrent = previous;
+    ReleaseNative(entry);
+    return true;
+}
