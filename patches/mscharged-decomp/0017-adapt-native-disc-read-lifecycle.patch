 void AsyncManager::Service()
 {
+#ifdef MSCHARGED_NATIVE
+    while (m_activeEntryList)
+    {
+        auto* entry = nlDLRingGetStart(m_activeEntryList);
+        auto* tail = entry->Phase == READ_HEAD ? entry->m_next : 0;
+        if (tail && (tail == entry || tail->Phase != READ_TAIL || tail->m_pFile != entry->m_pFile))
+            throw std::logic_error("Incomplete NL read head/tail pair");
+        for (auto* part : {entry, tail})
+        {
+            if (!part) continue;
+            const auto state = FileCommandStatus(part->mFileInfo);
+            if (state == DVD_STATE_BUSY || state == DVD_STATE_WAITING) return;
+            if (state != DVD_STATE_IDLE) throw std::runtime_error("NL asynchronous DVD read failed");
+        }
+        // Close joins any worker callback before reading status/transfer fields
+        // or recycling the command block. Short logical reads are never success.
+        for (auto* part : {entry, tail})
+        {
+            if (!part) continue;
+            DVDClose(&part->mFileInfo);
+            const unsigned long logical = std::min(part->m_uSize,
+                part->m_pFile->mLength-part->m_uPosition);
+            if (part->mFileInfo.cb.transferredSize < logical)
+                throw std::runtime_error("Short NL disc read");
+        }
+        if (tail)
+        {
+            memcpy(tail->m_pBuffer, tail->mTailBuffer, tail->m_uSize);
+            entry->m_uSize += tail->m_uSize;
+            --tail->m_pFile->PendingAsync;
+            nlDLRingRemove(&m_activeEntryList, tail);
+            ReleaseNative(tail);
+        }
+        else if (entry->Phase == READ_TAIL_ONLY)
+            memcpy(entry->m_pBuffer, entry->mTailBuffer, entry->m_uSize);
+        --entry->m_pFile->PendingAsync;
+        nlDLRingRemove(&m_activeEntryList, entry);
+        auto* previous = mCurrent;
+        mCurrent = entry;
+        try
+        {
+            if (entry->m_pFunc) entry->m_pFunc(entry->m_pFile, entry->m_pBuffer, entry->m_uSize, entry->m_uParam);
+        }
+        catch (...) { mCurrent = previous; ReleaseNative(entry); throw; }
+        mCurrent = previous;
+        ReleaseNative(entry);
