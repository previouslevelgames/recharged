Subject: Keep RVL scalar and clock fields at console widths

Upstream-base: 4a9ab8151d9a74e321e52b36c95d1e157d41af60

RVL long typedefs widen on LP64. Use fixed-width 32-bit fields and the
standard pointer-width type. Avoid native POSIX and C++ character-type name
collisions. This does not adapt pointer-bearing SDK structures or Wii services.

diff --git a/libs/RVL_SDK/include/revolution/os/OSTime_fwd.h b/libs/RVL_SDK/include/revolution/os/OSTime_fwd.h
index 515f14a..b404cbd 100644
--- a/libs/RVL_SDK/include/revolution/os/OSTime_fwd.h
+++ b/libs/RVL_SDK/include/revolution/os/OSTime_fwd.h
@@ -1,24 +1,26 @@
 #ifndef REVOLUTION_OS_TIME_FWD_H
 #define REVOLUTION_OS_TIME_FWD_H
 
+#include <stdint.h>
+
 #ifdef __cplusplus
 extern "C" {
 #endif
 
-typedef unsigned long OSTick;
+typedef uint32_t OSTick;
 typedef signed long long OSTime;
 
 typedef struct OSCalendarTime {
-    signed long sec;
-    signed long min;
-    signed long hour;
-    signed long mday;
-    signed long month;
-    signed long year;
-    signed long wday;
-    signed long yday;
-    signed long msec;
-    signed long usec;
+    int32_t sec;
+    int32_t min;
+    int32_t hour;
+    int32_t mday;
+    int32_t month;
+    int32_t year;
+    int32_t wday;
+    int32_t yday;
+    int32_t msec;
+    int32_t usec;
 } OSCalendarTime;
 
 OSTime OSGetTime(void);
