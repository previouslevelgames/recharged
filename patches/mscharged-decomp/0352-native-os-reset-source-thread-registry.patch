-    u8 verMinor;
-    u8 buildMon;
-    u8 buildDay;
-    u16 buildYear;
-} OSIOSRev;
+#include <revolution/os/OSIOSRev.h>
 
 typedef void (*OSExceptionHandler)(u8 type, OSContext* context);
 
diff --git a/libs/RVL_SDK/include/revolution/os/OSIOSRev.h b/libs/RVL_SDK/include/revolution/os/OSIOSRev.h
