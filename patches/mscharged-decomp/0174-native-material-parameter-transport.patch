 void glSetMaterialBufferParameter(glModelPacket* packet, unsigned long hash,
+#if defined(MSCHARGED_NATIVE)
+    glMaterialBufferAddress buffer, unsigned long size)
+#else
     unsigned long buffer, unsigned long size)
+#endif
 {
     const GXMaterialParameter* parameter = FindParameter(packet, hash);
+#if defined(MSCHARGED_NATIVE)
+    unsigned char* data = GetParameterData(packet, parameter);
+    const void* address = (const void*)buffer;
+    u32 byteCount = size;
+    memcpy(data, &address, sizeof(address));
+    memcpy(data + sizeof(address), &byteCount, sizeof(byteCount));
+#else
     unsigned long* data =
         (unsigned long*)GetParameterData(packet, parameter);
     data[0] = buffer;
     data[1] = size;
+#endif
 }
 
