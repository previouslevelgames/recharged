+++ b/src/RVL_SDK/os/OSPlayTime.c
@@ -160,6 +160,16 @@ static void __OSPlayTimeAlarmExpired(OSAlarm* alarm, OSContext* context) {
     if (__OSExpireCallback != NULL) {
         __OSExpireCallback();
     } else {
+#if defined(MSCHARGED_NATIVE)
+        // The host's OSInit never calls __OSInitPlayTime, so no play-time
+        // alarm is set natively; this reboot needs the Wii's thread queue and
+        // physical memory.
+        (void)arenaHi;
+        (void)memSize;
+        (void)thread;
+        (void)stack;
+        OSPanic(__FILE__, __LINE__, "Play-time expiry is not supported natively");
+#else
         for (thread = OS_THREAD_QUEUE.head; thread; thread = thread->nextActive) {
             OSSuspendThread(thread);
         }
@@ -176,6 +186,7 @@ static void __OSPlayTimeAlarmExpired(OSAlarm* alarm, OSContext* context) {
             __OSHotResetForError();
         }
         OSResumeThread(thread);
+#endif
     }
 }
 
