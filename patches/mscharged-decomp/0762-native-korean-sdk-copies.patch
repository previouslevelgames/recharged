@@ -532,10 +532,20 @@ void __OSReturnToMenuForError(void) {
 }
 
 #if defined(VERSION_R4QK01)
+#if defined(MSCHARGED_NATIVE)
+// OS.c and OSExec.c are the host's: a native game always starts from its
+// disc, never from NAND or after OSReboot.
+#define __OSInNandBoot FALSE
+#define __OSInReboot FALSE
+#endif
