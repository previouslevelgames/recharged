         DWC_Printf(DWC_REPORTFLAG_AUTH, " userid = 0x%016llx\n", userid);
+#if defined(MSCHARGED_NATIVE)
+        // The NAS reads ingamesn as big-endian UTF-16, the Wii's memory
+        // order; the native u16 string is measured and sent in that order.
+        {
+            u8 ingamesnBE[26 * sizeof(u16)];
+            u32 len = 0;
+            while (len < 26 && ingamesn[len] != 0)
+            {
+                ingamesnBE[len * 2] = (u8)(ingamesn[len] >> 8);
+                ingamesnBE[len * 2 + 1] = (u8)ingamesn[len];
+                len++;
+            }
+            NHTTPAddPostDataAscii(request, "ingamesn", base64nize_with_len(ingamesnBE, &b64_ptr, len * sizeof(u16)));
+        }
+#else
         NHTTPAddPostDataAscii(request, "ingamesn", base64nize_with_len((void*)ingamesn, &b64_ptr, wcslen(ingamesn) * sizeof(u16)));
+#endif
         break;
 
     case DWCi_AUTH_KIND_SVCLOC:
