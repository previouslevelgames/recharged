From: mscharged-port contributors
Subject: [PATCH] Share original frontend base-handler and loading notification steps
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Share original base timeline, ring and activation contracts with checked native
retained-scene ownership. Preserve the actual empty remove and SceneCreated
bodies and the manager state6 gate. Share loading notification update ordering
and its inclusive authored-clock completion predicate without selecting HOME,
concrete screen handlers or unavailable manager/resource services.

Refreshed for decomp 9046e67a: BaseSceneHandler.cpp, feSceneManager.cpp and
SHLoading.cpp keep their upstream text (the series' later restore patches made
these edits net zero).

diff --git a/include/Game/FE/FrontendHandlerSteps.h b/include/Game/FE/FrontendHandlerSteps.h
new file mode 100644
index 0000000..c1c4986
--- /dev/null
+++ b/include/Game/FE/FrontendHandlerSteps.h
@@ -0,0 +1,43 @@
+#ifndef FRONTEND_HANDLER_STEPS_H
+#define FRONTEND_HANDLER_STEPS_H
+#include "NL/nlDLRing.h"
+
+// Shared original BaseSceneHandler equations, independent of native ownership.
+template<class Handler> void FrontendBaseHandlerUpdate(Handler& handler, float dt)
+{ handler.mFEScene->Update(dt); }
+template<class Handler, class Screen> void FrontendBaseHandlerAdd(Handler& handler, Screen* screen)
+{
+    screen->mFEScene = handler.mFEScene;
+    nlDLRingAddEnd(&handler.mScreenHandlerList, screen);
+}
+template<class Screen> void FrontendBaseHandlerRemove(Screen*) { }
+template<class Handler> void FrontendBaseHandlerActivate(Handler& handler)
+{
+    if (handler.mActiveScreenHandler != 0)
+        handler.mActiveScreenHandler->OnActivate();
+}
+inline void FrontendBaseHandlerSceneCreated() { }
+// Original manager still checks FEScene::mState==6 before this fragment.
+template<class Input, class Handler> void FrontendFocusedHandlerUpdate(Input* input, Handler* handler, float dt)
+{
+    input->EnableInputIfSceneHasFocus(handler);
+    handler->Update(dt);
+}
+// Original BaseLoadingScene::Update: clock before notification completion.
+template<class Component, class Slide>
+void FrontendLoadingNotificationStep(bool& active, Component* component)
+{
+    if (active)
+    {
+        Slide* slide = component->GetActiveSlide();
+        float duration = slide->m_duration;
+        float start = slide->m_start;
+        float time = slide->m_time;
+        if (time >= start + duration)
+        {
+            component->m_bVisible = false;
+            active = false;
+        }
+    }
+}
+#endif
