From: mscharged-port native adaptation
Subject: [PATCH] Preserve original RLG wire vertices and numeric CPU indices
Upstream-base: 0f5a757947b8778b680d4d1ae7e6df1792a514f2

Keep original source allocation, copy size, cache flush and geometry loading
order. Native transport publishes unchanged Wii vertex wire and decodes each
authored u16 index at the original CPU copy boundary.

diff --git a/src/NL/glx/glxLoadModel.cpp b/src/NL/glx/glxLoadModel.cpp
--- a/src/NL/glx/glxLoadModel.cpp
+++ b/src/NL/glx/glxLoadModel.cpp
@@ -19,6 +19,9 @@
 #include "NL/platvmath.h"
 
 #include <string.h>
+#if defined(MSCHARGED_NATIVE)
+#include "platform/rlg_geometry_bytes.h"
+#endif
 
 
 class GLXRLGReader : public RLGReader
@@ -35,14 +38,22 @@
 void GLXRLGReader::LoadVertices(void* data, unsigned long size)
 {
     m_pVertexData = glResourceAlloc(size, GLM_VertexData, m_pResource);
+#if defined(MSCHARGED_NATIVE)
+    mscharged::platform::CopyRLGWireVertices(m_pVertexData, data, size);
+#else
     memcpy(m_pVertexData, data, size);
+#endif
     DCFlushRange(m_pVertexData, size);
 }
 
 void GLXRLGReader::LoadIndices(void* data, unsigned long size)
 {
     m_pIndexData = glResourceAlloc(size, GLM_IndexData, m_pResource);
+#if defined(MSCHARGED_NATIVE)
+    mscharged::platform::CopyRLGNativeIndices(m_pIndexData, data, size);
+#else
     memcpy(m_pIndexData, data, size);
+#endif
     DCFlushRange(m_pIndexData, size);
 }
 
