diff --git a/include/Game/FE/FrontendStackSteps.h b/include/Game/FE/FrontendStackSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendStackSteps.h
@@ -0,0 +1,24 @@
+#ifndef FRONTEND_STACK_STEPS_H
+#define FRONTEND_STACK_STEPS_H
+
+// Original scene-manager ordering and predicates, shared with checked native
+// ownership. The native owner supplies its own explicit readiness predicate;
+// it does not manufacture original FEScene state6.
+inline bool FrontendOriginalSceneReady(int state) { return state == 6; }
+inline bool FrontendSceneVisible(bool ready, bool visible) { return ready && visible; }
+template<class Queue, class Message> void FrontendQueueScene(Queue& queue, Message message)
+{ queue.AddEnd(message); }
+template<class Stack, class Handler> void FrontendPushScene(Stack& stack, Handler handler)
+{ stack.AddStart(handler); }
+template<class Handler, class Presentation> void FrontendInitializeScene(Handler& handler, Presentation presentation)
+{
+    handler.SetPresentation(presentation);
+    handler.SceneCreated();
+    handler.InitializeSubHandlers();
+}
+template<class Scene> void FrontendUnloadScene(Scene& scene)
+{
+    scene.ReleaseResourceHandles();
+    scene.UnloadPackage();
+}
+#endif
