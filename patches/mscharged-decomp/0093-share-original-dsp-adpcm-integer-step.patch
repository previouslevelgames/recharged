From: mscharged-port contributors
Subject: [PATCH] Share original DSP ADPCM integer sample arithmetic
Upstream-base: 11c0bc65ad2ec21431c5d74f1ac4cbc1e3e2e2c3

Share the three identical THPAudio sample equations without selecting its
unchecked container decoder. Native negative sample arithmetic uses defined
64-bit multiplication; console equations and caller stores remain unchanged.

diff --git a/libs/RVL_SDK/include/revolution/thp/THPAdpcmStep.h b/libs/RVL_SDK/include/revolution/thp/THPAdpcmStep.h
new file mode 100644
--- /dev/null
+++ b/libs/RVL_SDK/include/revolution/thp/THPAdpcmStep.h
@@ -0,0 +1,30 @@
+#ifndef REVOLUTION_THP_ADPCM_STEP_H
+#define REVOLUTION_THP_ADPCM_STEP_H
+#include <revolution/types.h>
+// Original THP DSP ADPCM equation. Container/address validation belongs to the
+// caller; SP tables share the codec but are not THP frames.
+static inline s64 THPAdpcmAccumulator(s32 sample, u32 scale, s16 coefficient0,
+                                    s16 coefficient1, s16 history1, s16 history2)
+{
+    s64 yn;
+    yn = coefficient1 * history2;
+    yn += coefficient0 * history1;
+#if defined(MSCHARGED_NATIVE)
+    // Defined multiplication preserves negative signed samples and avoids
+    // signed-left-shift undefined behavior in the original scalar C spelling.
+    yn += (s64)sample * ((s64)1 << scale) * 2048;
+    yn *= 32;
+#else
+    yn += (sample << scale) << 11;
+    yn <<= 5;
+#endif
+    yn += 0x8000;
+    if (yn > 2147483647LL) {
+        yn = 2147483647LL;
+    }
+    if (yn < -2147483648LL) {
+        yn = -2147483648LL;
+    }
+    return yn;
+}
+#endif
