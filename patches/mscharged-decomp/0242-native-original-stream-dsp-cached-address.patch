From: mscharged-port maintainers
Subject: [PATCH] Preserve original stream cached words through native DSP memory
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Original stream state keeps a Wii32 cached address used by unchanged AX nibble
arithmetic. Translate actual native backing through the checked SDK physical
mapping, then use the original cached-region prefix. Keep a null pointer's word
zero and preserve the console assignment. No audio initialization is replaced.

diff --git a/src/Game/Audio/AudioSource.cpp b/src/Game/Audio/AudioSource.cpp
index 1367d51..9ca17b3 100644
--- a/src/Game/Audio/AudioSource.cpp
+++ b/src/Game/Audio/AudioSource.cpp
@@ -557,7 +557,12 @@ void AudioReadState::Initialize(AudioSourceInfo* info)
             DumpAudioMemory();
         channel->m_Voice = AXAcquireVoice(31, AudioStreamChannel::OnVoiceDropped, (unsigned long)channel);
         MIXInitChannel(channel->m_Voice, 0, 0, -960, -960, -960, 64, 127, 0);
+#ifdef MSCHARGED_NATIVE
+        channel->m_BufferAddress = channel->m_Buffer == 0 ? 0u
+            : OSCachedToPhysical(channel->m_Buffer) + ((unsigned int)OS_CACHED_REGION_PREFIX << 16);
+#else
         channel->m_BufferAddress = (unsigned int)channel->m_Buffer;
+#endif
     }
     SetPan(0.0f);
     m_InternalState = AUDIO_SOURCE_IDLE;
