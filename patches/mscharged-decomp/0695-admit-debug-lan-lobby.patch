     case SCENE_ONLINE_MATCHMAKING_DRAFT:
         newHandler = new (nlMalloc(sizeof(SHOnlineMatchmakingDraft), 8, false)) SHOnlineMatchmakingDraft();
         break;
     case SCENE_ONLINE_FRIENDS_DRAFT:
