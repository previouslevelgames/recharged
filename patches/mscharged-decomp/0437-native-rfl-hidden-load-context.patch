Subject: [PATCH] Preserve native RFL hidden-load borrowed context addresses
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Split native hidden-load pointer contexts from unchanged u32 CRC/retry callbacks.
Console preprocessing preserves the literal original declarations and bodies.

diff --git a/libs/RVL_SDK/include/RVLFaceLib/RFLi_HiddenDatabase.h b/libs/RVL_SDK/include/RVLFaceLib/RFLi_HiddenDatabase.h
index 0cd4c38..f862bf3 100644
--- a/libs/RVL_SDK/include/RVLFaceLib/RFLi_HiddenDatabase.h
+++ b/libs/RVL_SDK/include/RVLFaceLib/RFLi_HiddenDatabase.h
@@ -39,8 +39,8 @@ typedef struct RFLiHDBManager {
     s16 formatIndex;              // at 0x1C
     RFLiHiddenCharData* loadDst;  // at 0x20
     void* loadTmp;                // at 0x24
-    u32 loadArg;                  // at 0x28
-    RFLiExCallback loadCb;        // at 0x2C
+    RFLiHiddenLoadArg loadArg;                  // at 0x28
+    RFLiHiddenLoadCallback loadCb;        // at 0x2C
     u16 loadIndex;                // at 0x30
     RFLiHiddenCharData* cachedDB; // at 0x34
     BOOL cached;                  // at 0x38
@@ -49,7 +49,7 @@ typedef struct RFLiHDBManager {
 
 void RFLiInitHiddenDatabase(void);
 RFLErrcode RFLiLoadHiddenDataAsync(RFLiHiddenCharData* data, u16 index,
-                                   RFLiExCallback cb, u32 arg);
+                                   RFLiHiddenLoadCallback cb, RFLiHiddenLoadArg arg);
 RFLErrcode RFLiLoadCachedHiddenData(RFLiHiddenCharData* data, u16 index);
 RFLErrcode RFLiWriteCtrlToHiddenDB(const struct RFLiCtrlBuf* buf, BOOL ch);
 s32 RFLiSearchHiddenData(const RFLCreateID* id);
diff --git a/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h b/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h
index 58094e8..b18fb07 100644
--- a/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h
+++ b/libs/RVL_SDK/include/RVLFaceLib/RFLi_Types.h
@@ -135,6 +135,15 @@ typedef enum {
 typedef void (*RFLiCallback)(void);
 typedef void (*RFLiExCallback)(u32 arg);
 
+#if defined(MSCHARGED_NATIVE)
+// Hidden-load context borrows a real MiddleDB pointer; CRC/retry args stay u32.
+typedef uintptr_t RFLiHiddenLoadArg;
+typedef void (*RFLiHiddenLoadCallback)(RFLiHiddenLoadArg arg);
+#else
+#define RFLiHiddenLoadArg u32
+#define RFLiHiddenLoadCallback RFLiExCallback
+#endif
+
 /**
  * Common structs
  */
