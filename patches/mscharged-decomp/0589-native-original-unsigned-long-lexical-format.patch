Subject: Match original unsigned-long lexical formatting to the native variadic ABI
Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a

The native specialization passes an actual unsigned long to libc formatting.
Use its matching format without narrowing live pointer/scalar callers. The
console format and all original allocation/string decisions remain unchanged.

--- a/include/NL/nlLexicalCast.h
+++ b/include/NL/nlLexicalCast.h
@@ -73,7 +73,11 @@
 inline BasicString<char, Allocator> LexicalCastImpl<BasicString<char, Allocator>, unsigned long>::Do(unsigned long t)
 {
     char s[0x40];
+#if defined(MSCHARGED_NATIVE)
+    nlSNPrintf(s, 0x40, "%lu", t);
+#else
     nlSNPrintf(s, 0x40, "%u", t);
+#endif
     return BasicString<char, Allocator>(s);
 }
 
