diff --git a/include/Game/World/WorldEffectSteps.h b/include/Game/World/WorldEffectSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/World/WorldEffectSteps.h
@@ -0,0 +1,71 @@
+#ifndef GAME_WORLD_WORLD_EFFECT_STEPS_H
+#define GAME_WORLD_WORLD_EFFECT_STEPS_H
+#include "NL/nlMath.h"
+// Shared source scheduling. Real emission/service admission stays with callers.
+template<class Effect> inline void WorldEffectInitializeClock(Effect& e)
+{
+    e.m_bActive = true;
+    if (e.m_nTimingMode == 0)
+    {
+        float fEmissionInterval = e.m_fEmissionInterval;
+        e.m_fEmissionTime = fEmissionInterval + 1.0f;
+    }
+    else e.m_fEmissionTime = 0.0f;
+    e.m_fPreviousEmissionTime = e.m_fEmissionTime;
+    e.m_nRemainingEmissions = e.m_nEmissionCount;
+}
+template<class Effect> inline void WorldEffectResetClock(Effect& e)
+{
+    e.m_fEmissionTime = 0.0f;
+    e.m_nRemainingEmissions = e.m_nEmissionCount;
+    e.m_fPreviousEmissionTime = 0.0f;
+    if (e.m_nTimingMode == 0)
+    {
+        float fEmissionTime = e.m_fEmissionInterval;
+        fEmissionTime = 1.0f + fEmissionTime;
+        e.m_fEmissionTime = fEmissionTime;
+    }
+}
+template<class Effect> inline bool WorldEffectTriggerClock(Effect& e, unsigned long uType)
+{
+    if (uType != (unsigned int)e.m_nTimingMode) return false;
+    e.m_nRemainingEmissions = e.m_nEmissionCount;
+    float fEmissionTime = e.m_fEmissionInterval;
+    fEmissionTime = 1.0f + fEmissionTime;
+    e.m_fEmissionTime = fEmissionTime;
+    return true;
+}
+template<class Effect> inline bool WorldEffectUpdateClock(Effect& e, float fDeltaT, unsigned int* seed)
+{
+    if (fDeltaT != 0.0f && e.m_bActive)
+    {
+        if (e.m_nTimingMode == 0)
+        {
+            if (e.m_nRemainingEmissions > 0 || e.m_nRemainingEmissions == -1)
+            {
+                float fEmissionTime = e.m_fEmissionTime;
+                float fEmissionInterval = e.m_fEmissionInterval;
+                fEmissionTime += fDeltaT;
+                e.m_fEmissionTime = fEmissionTime;
+                if (fEmissionInterval <= fEmissionTime && nlRandom(100, seed) < e.m_uProbability)
+                    return true;
+            }
+        }
+        else if (e.m_nRemainingEmissions > 0 || e.m_nRemainingEmissions == -1)
+        {
+            float fEmissionTime = e.m_fEmissionTime;
+            float fEmissionInterval = e.m_fEmissionInterval;
+            if (fEmissionInterval <= fEmissionTime && nlRandom(100, seed) < e.m_uProbability)
+                return true;
+        }
+    }
+    return false;
+}
+template<class Effect> inline void WorldEffectEmitted(Effect& e)
+{
+    e.m_fPreviousEmissionTime = e.m_fEmissionTime;
+    e.m_fEmissionTime = 0.0f;
+    --e.m_nRemainingEmissions;
+    if (e.m_nRemainingEmissions < -1) e.m_nRemainingEmissions = -1;
+}
+#endif
