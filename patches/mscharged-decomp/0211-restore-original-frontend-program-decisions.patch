 void GXVertexColourTextureMaterialProgram::Initialize()
@@ -50,11 +46,7 @@
     GXClearVtxDesc();
     GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_POS, GX_POS_XYZ, GX_F32, 0);
     GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_CLR0, GX_CLR_RGBA, GX_RGBA8, 0);
-#if defined(MSCHARGED_NATIVE)
-    GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_TEX0, GX_TEX_ST, GX_F32, 0);
-#else
     GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_TEX0, GX_TEX_ST, GX_S16, 10);
-#endif
 
     if (indexed)
     {
@@ -73,12 +65,6 @@
 void GXVertexColourTextureMaterialProgram::BindVertexArrays(const glModelPacket* packet)
 {
     glModelStream* streams = packet->streams;
-#if defined(MSCHARGED_NATIVE)
-    // Static asset adapters retain float UVs; the original procedural mesh
-    // writer retains the Wii signed16 / 1024 stream. Select its actual format.
-    GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_TEX0, GX_TEX_ST,
-        streams[1].stride == 4 ? GX_S16 : GX_F32, streams[1].stride == 4 ? 10 : 0);
-#endif
 #if defined(MSCHARGED_NATIVE)
     GXSetArray(GX_VA_POS, streams[0].address,
         packet->numUniqueVertices * streams[0].stride, streams[0].stride, true);
