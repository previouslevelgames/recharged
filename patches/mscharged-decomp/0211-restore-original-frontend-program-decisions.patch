From: mscharged-port native source preparation
Subject: [PATCH] Restore original frontend material program decisions
Upstream-base: bab83befb5d6a2fdff0b30d2ec4b59f7251a108d
Classification: R02 source-fidelity correction; retire prior native game-side behavior changes.
Preserve original registry Add behavior, constructor order, empty destructors
and fixed signed16 / 1024 VertexColourTexture UV format. Canonical GX/FIFO
hardware transport remains; existing unproven array extents remain explicit HOLD.

--- a/src/NL/gl/glMaterialProgram.cpp
+++ b/src/NL/gl/glMaterialProgram.cpp
@@ -1,7 +1,4 @@
 #include "NL/gl/glMaterialProgram.h"
-#if defined(MSCHARGED_NATIVE)
-#include <stdexcept>
-#endif
 #define NL_AVL_TREE_DEFER_DELETE_ENTRY
 #include "NL/nlAVLTree.h"
 #undef NL_AVL_TREE_DEFER_DELETE_ENTRY
@@ -20,10 +17,6 @@
 
 void glRegisterMaterialProgram(void* program, unsigned long hash)
 {
-#if defined(MSCHARGED_NATIVE)
-    if (!program || !hash || hash > 0xffffffffUL || glGetMaterialProgram(hash))
-        throw std::invalid_argument("Invalid or duplicate material program registration");
-#endif
     sMaterialPrograms.Add(hash, program);
 }
 
--- a/src/NL/glx/GXUnlitTextureMaterialProgram.cpp
+++ b/src/NL/glx/GXUnlitTextureMaterialProgram.cpp
@@ -19,19 +19,15 @@
 
 GXUnlitTextureMaterialProgram::GXUnlitTextureMaterialProgram()
 {
+    Instance = this;
     programHash = 0x21DB4385;
     parameterDataSize = 8;
     parameterCount = 1;
     glRegisterMaterialProgram(this, programHash);
-    Instance = this;
 }
 
 GXUnlitTextureMaterialProgram::~GXUnlitTextureMaterialProgram()
 {
-#if defined(MSCHARGED_NATIVE)
-    Instance = nullptr;
-    Initialized = false;
-#endif
 }
 
 void GXUnlitTextureMaterialProgram::Initialize()
