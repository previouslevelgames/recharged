From: native source fidelity
Subject: [PATCH] restore original game-module character skin render calls

Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Game-module bodies retain original lighting/marker/matrix/display-list decisions.
The existing canonical SDK lowers original hardware operations; preview-only
finite/rigid/matrix restrictions stay outside the original game module.

diff --git a/src/NL/glx/GXCharacterSkinCustomMaterialProgramRender.cpp b/src/NL/glx/GXCharacterSkinCustomMaterialProgramRender.cpp
index 49cf0f6..0fd7aea 100644
--- a/src/NL/glx/GXCharacterSkinCustomMaterialProgramRender.cpp
+++ b/src/NL/glx/GXCharacterSkinCustomMaterialProgramRender.cpp
@@ -1,7 +1,9 @@
 #if defined(MSCHARGED_NATIVE)
 #include <dolphin/gx.h>
+#if !defined(MSCHARGED_GAME_MODULE)
 #include "runtime/material_environment.h"
 #include "runtime/skin_material.h"
+#endif
 #else
 #include <revolution/gx.h>
 #endif
@@ -115,18 +117,19 @@ void GXMaterialProgramImpl<GXCharacterSkinCustomMaterialProgram>::Activate(GLVie
     SetGameObjectShadowModelMatrix(-1);
     sCharacterLightCount = GetGameObjectLightCount(1, 0);
     LoadGameObjectLights(sCharacterLightCount, view, 1);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     sCharacterSkinLightingEnabled = sEnableCharacterSkinLighting && IsGameObjectLightingEnabled();
+    glxConfigureCharacterSkinCustomLighting(sCharacterSkinLightingEnabled);
 #else
     sCharacterSkinLightingEnabled = sEnableCharacterSkinLighting;
+    glxConfigureCharacterSkinCustomLighting(sEnableCharacterSkinLighting);
 #endif
-    glxConfigureCharacterSkinCustomLighting(sCharacterSkinLightingEnabled);
 }
 
 template <>
 void GXMaterialProgramImpl<GXCharacterSkinCustomMaterialProgram>::Deactivate()
 {
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     GXSetCurrentMtx(GX_PNMTX0);
 #else
     gxSetCurrentMtx(0, true);
@@ -170,7 +173,7 @@ void GXMaterialProgramImpl<GXCharacterSkinCustomMaterialProgram>::Draw(
     static_cast<GXCharacterSkinCustomMaterialProgram*>(this)->BindParameters(packet);
 
     bool enabled = static_cast<const GXCharacterSkinCustomParameters*>(packet->materialParameters)->lightingEnabled == 1;
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     enabled = enabled && sEnableCharacterSkinLighting && IsGameObjectLightingEnabled();
 #endif
     if (enabled != sCharacterSkinLightingEnabled)
@@ -206,11 +209,11 @@ void GXMaterialProgramImpl<GXCharacterSkinCustomMaterialProgram>::Draw(
         unsigned int numSkinMatrices;
         const GXCharacterSkinCustomParameters* parameters = static_cast<const GXCharacterSkinCustomParameters*>(packet->materialParameters);
         numSkinMatrices = parameters->skinMatrixBytes / sizeof(*parameters->skinMatrices);
-#if !defined(MSCHARGED_NATIVE)
+#if !defined(MSCHARGED_NATIVE) || defined(MSCHARGED_GAME_MODULE)
         glGetDrawSyncLog()->AddMarker("CharacterSkinCustom - RLXLoadSkinMatrices");
 #endif
         glx_LoadSkinMatrices(parameters->skinMatrices, numSkinMatrices, &modelview, 1);
-#if !defined(MSCHARGED_NATIVE)
+#if !defined(MSCHARGED_NATIVE) || defined(MSCHARGED_GAME_MODULE)
         glGetDrawSyncLog()->AddMarker("CharacterSkinCustom - After RLXLoadSkinMatrices");
 #endif
     }
@@ -227,7 +230,7 @@ void GXMaterialProgramImpl<GXCharacterSkinCustomMaterialProgram>::Draw(
         if (sDrawAlphaDepthPass)
         {
             bool colourUpdate = gxSetColourUpdate(false);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
             mscharged::DrawNativeSkinPacket(*packet);
 #else
             GXCallDisplayList(
@@ -241,7 +244,7 @@ void GXMaterialProgramImpl<GXCharacterSkinCustomMaterialProgram>::Draw(
         gxSetBlendMode(true, GX_BL_SRCALPHA, GX_BL_INVSRCALPHA, false);
         GXSetTevKAlphaSel(GX_TEVSTAGE1, GX_TEV_KASEL_K1_A);
         gxSetTevAlphaIn(GX_TEVSTAGE1, GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO, GX_CA_KONST);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
         mscharged::DrawNativeSkinPacket(*packet);
 #else
         GXCallDisplayList(packet->displayList->list, packet->displayList->size);
@@ -251,7 +254,7 @@ void GXMaterialProgramImpl<GXCharacterSkinCustomMaterialProgram>::Draw(
     }
     else
     {
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
         mscharged::DrawNativeSkinPacket(*packet);
 #else
         GXCallDisplayList(packet->displayList->list, packet->displayList->size);
