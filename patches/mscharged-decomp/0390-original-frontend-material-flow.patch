Subject: [PATCH] Restore original frontend material view, lighting and scrolling decisions
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Game modules use the original GLView interface, stadium clock, integer texture
wrapping, light-texture request and specular cache initialization. Original
PSMTXInvXpose calls use the native SDK provider. Scope earlier preview helpers
to standalone diagnostics; do not change source lighting or render decisions.
Native SDK declarations, parameter layouts and GX transport remain intact.

diff --git a/include/NL/glx/GXMaterialProgramTextureAnimation.h b/include/NL/glx/GXMaterialProgramTextureAnimation.h
index 34fb087..06b19e1 100644
--- a/include/NL/glx/GXMaterialProgramTextureAnimation.h
+++ b/include/NL/glx/GXMaterialProgramTextureAnimation.h
@@ -4,7 +4,9 @@
 #if defined(MSCHARGED_NATIVE)
 #include <dolphin/gx.h>
 #include <dolphin/mtx.h>
+#if !defined(MSCHARGED_GAME_MODULE)
 #include "runtime/material_environment.h"
+#endif
 #include <cmath>
 #else
 #include <revolution/gx.h>
@@ -14,7 +16,7 @@
 
 static inline float glxWrapTextureOffset(float value)
 {
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     return std::trunc(std::fmod(value, 1.0f) * 1024.0f) / 1024.0f;
 #else
     return (float)((int)(value * 1024.0f) % 1024) / 1024.0f;
@@ -23,7 +25,7 @@ static inline float glxWrapTextureOffset(float value)
 
 static inline void glxLoadScrollingTextureMatrix(unsigned int matrix, const nlVector2& speed)
 {
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     float time = mscharged::MaterialPreviewTime();
 #else
     float time = GetStadiumTime();
diff --git a/src/NL/glx/GXMaskedSpecularFresnelMaterialProgramRender.cpp b/src/NL/glx/GXMaskedSpecularFresnelMaterialProgramRender.cpp
