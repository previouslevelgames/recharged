@@ -63,7 +65,7 @@ unsigned long sMaskedSpecularFresnelBoundTexture;
 
 void glxConfigureMaskedSpecularFresnelLighting(int mode)
 {
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     mscharged::RequireMaterialPreview();
 #endif
     sMaskedSpecularFresnelLightingMode = mode;
@@ -153,7 +155,7 @@ void GXMaterialProgramImpl<GXMaskedSpecularFresnelMaterialProgram>::Activate(GLV
 {
     sMaskedSpecularFresnelLightingMode = LIGHTING_UNCONFIGURED;
     static_cast<GXMaskedSpecularFresnelMaterialProgram*>(this)->ConfigureVertexFormat(true);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     sMaskedSpecularFresnelViewMatrix = mscharged::MaterialPreviewView();
 #else
     view->m_Interface->GetViewMatrix(sMaskedSpecularFresnelViewMatrix);
@@ -165,7 +167,7 @@ void GXMaterialProgramImpl<GXMaskedSpecularFresnelMaterialProgram>::Activate(GLV
     sMaskedSpecularFresnelLightCount = GetGameObjectLightCount(0, 1);
     LoadGameObjectLights(sMaskedSpecularFresnelLightCount, view, 0);
 
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     if (ShouldUseGameObjectLightTexture(1))
     {
 #endif
@@ -176,7 +178,7 @@ void GXMaterialProgramImpl<GXMaskedSpecularFresnelMaterialProgram>::Activate(GLV
     texture.SetWrapT(true);
     texture.unknown07 = 0;
     glx_BindTexture(4, &texture);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
     }
 #endif
     GXLoadTexMtxImm(sMaskedSpecularFresnelLookupMatrix, GX_PTTEXMTX1, GX_MTX3x4);
@@ -316,7 +318,7 @@ void GXMaterialProgramImpl<GXMaskedSpecularFresnelMaterialProgram>::Draw(
         glGetMatrix(packet->matrix, model);
         nlMultMatrices(modelview, model, sMaskedSpecularFresnelViewMatrix);
         glxCopyMatrix(modelViewMatrix, modelview);
-#if defined(MSCHARGED_NATIVE)
+#if defined(MSCHARGED_NATIVE) && !defined(MSCHARGED_GAME_MODULE)
         mscharged::MaterialNormalMatrix(modelview, normalMatrix);
 #else
         PSMTXInvXpose(modelViewMatrix, normalMatrix);
