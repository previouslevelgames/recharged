diff --git a/include/Game/FE/FrontendResourceSteps.h b/include/Game/FE/FrontendResourceSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendResourceSteps.h
@@ -0,0 +1,61 @@
+#ifndef FRONTEND_RESOURCE_STEPS_H
+#define FRONTEND_RESOURCE_STEPS_H
+#include "Game/FE/FrontendStackSteps.h"
+
+// Exact FEScene/FEResourceManager order shared with checked native ownership.
+// Callers supply genuine handle validity and resource-pool marks. These steps
+// never infer readiness from decoded assets or a native published frame.
+template<class Scene, class Queue, class Initialize>
+void FrontendScenePackageResources(Scene& scene, Queue queue, Initialize initialize)
+{
+    scene.mState = 5;
+    queue();
+    initialize();
+}
+inline void FrontendSceneResourcesLoadedCallback() { }
+template<class Context> void FrontendCompleteResourceContext(Context* context)
+{
+    context->m_pFESceneContext->mState = 6;
+    context->m_pFESceneContext->AllResourcesLoadedCallback();
+}
+template<class Services, class Context>
+void FrontendIssueResourceContext(Services& services, Context* incoming)
+{
+    auto* current = services.CurrentContext();
+    if (current != 0 && current != incoming && services.PermanentContext() != current)
+        services.CompleteContext(current);
+    incoming->m_glResourceMarker = services.MarkResource(incoming);
+    incoming->m_bValid = true;
+    services.CurrentContext() = incoming;
+}
+template<class Services> void FrontendResourceQueueUpdate(Services& services)
+{
+    bool queueNext = true;
+    while (queueNext)
+    {
+        if (services.CurrentResource() != 0 && !services.CurrentResource()->IsValid())
+            return;
+        if (services.CurrentResource() != 0)
+        {
+            services.RemoveFirst();
+            services.CurrentResource() = 0;
+            if (services.Empty() && services.CurrentContext() != 0)
+            {
+                services.CompleteContext(services.CurrentContext());
+                services.CurrentContext() = 0;
+            }
+        }
+        if (services.Empty())
+            return;
+        queueNext = services.IssueFirstAlreadyLoaded();
+    }
+}
+template<class Range, class Pending>
+bool FrontendAllResourceScenesValid(const Range& scenes, const Pending& pending)
+{
+    for (const auto* scene : scenes)
+        if (!FrontendOriginalSceneReady(scene->mState))
+            return false;
+    return pending.empty();
+}
+#endif
