+// Original frame binding selected separately from resource lifetime/update.
+#include "Game/GL/GLVertexAnim.h"
+#include "Game/GL/glModelBuilder.h"
+#include "NL/gl/glMemory.h"
+#include <string.h>
+#include <cmath>
+#include <stdexcept>
+glModel* GLVertexAnim::GetModel(int frame)
+{
+#if defined(MSCHARGED_NATIVE)
+    if (frame < 0 && (!std::isfinite(m_fFrame) || m_fFrame < 0 || m_fFrame >= m_nNumFrames))
+        throw std::out_of_range("Vertex animation current frame is invalid");
+#endif
+    int actualFrame = (frame < 0) ? (int)m_fFrame : frame;
+#if defined(MSCHARGED_NATIVE)
+    if (!m_pModel || !m_pVertices || actualFrame < 0 || actualFrame >= m_nNumFrames)
+        throw std::out_of_range("Vertex animation frame or retained model is unavailable");
+#endif
+
+    glModel* model = glModelDupNoStreams(m_pModel, false, 0);
+    u8* vertices = m_pVertices
+                 + actualFrame * m_nVertexStride * m_nNumVertices;
+
+    for (glModelPacket* packet = model->packets;
+         packet < model->packets + model->numPackets; packet++)
+    {
+#if defined(MSCHARGED_NATIVE)
+        // cloneNoStreams deliberately shares this array. Animated address
+        // rebinding must belong to this frame clone, not its retained source or
+        // another frame sample. The actual original offset/binding loop follows.
+        auto* descriptors = static_cast<glModelStream*>(
+            glFrameAlloc(packet->numStreams * sizeof(glModelStream), GLM_Header));
+        memcpy(descriptors, packet->streams, packet->numStreams * sizeof(glModelStream));
+        packet->streams = descriptors;
+#endif
+        glModelStream* streams = packet->streams;
+        glModelStream* endVertexData = streams + packet->numStreams;
+        u32 offset = 0;
+        for (int i = 0; streams + i < endVertexData; i++)
+        {
+            for (int j = 0; j < m_nNumAnimatedStreams; j++)
+            {
+                if (m_pAnimatedStreamIDs[j] == streams[i].id)
+                {
+                    glSetStreamAddress(&streams[i],
+                        vertices + offset * packet->numUniqueVertices);
+                    offset += streams[i].stride;
+                    break;
+                }
+            }
+        }
+        vertices += offset * packet->numUniqueVertices;
+    }
+
+    return model;
+}
