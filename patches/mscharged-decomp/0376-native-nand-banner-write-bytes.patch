Subject: [PATCH] Keep original NAND banner writes in Wii byte order
Upstream-base: a353c8f2dfb34eb08fecd725965a46ea629428e3
Scope: native serialized-data transport only. Retain original localization,
       buffer allocation, pixels, write length, reset pause, callbacks and flow.

diff --git a/src/Game/DB/SaveLoad.cpp b/src/Game/DB/SaveLoad.cpp
index e0783db..ab0406b 100644
--- a/src/Game/DB/SaveLoad.cpp
+++ b/src/Game/DB/SaveLoad.cpp
@@ -1,5 +1,6 @@
 #if defined(MSCHARGED_NATIVE)
 #include "platform/native_tpl.h"
+#include "platform/nand_banner.h"
 #endif
 #include "NL/nlSingleton.inl"
 #include "Game/DB/SaveLoad.h"
@@ -155,7 +156,11 @@ static inline void WriteLocalizedBanner(NANDResultCallback callback)
     memcpy(BannerBuffer->subtitle, comment, wcslen((const wchar_t*)comment) * sizeof(unsigned short));
 
     ResetTask::s_resetPaused = true;
+#if defined(MSCHARGED_NATIVE)
+    SaveLoad::HandleNANDResult(mscharged::platform::WriteOriginalNANDBanner(BannerBuffer, NAND_BANNER_SIZE(8), callback));
+#else
     SaveLoad::HandleNANDResult(nlFlashWrite(BannerBuffer, NAND_BANNER_SIZE(8), callback));
+#endif
 }
 
 static inline void RefreshLoadedBanner()
