Subject: Read the native bus clock without absolute-address definitions

Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Upstream now owns the declaration in OSHardware_fwd.h and uses
OS_BUS_CLOCK_SPEED in both original NL time units. The native forward header
exposes the existing 32-bit ChargedGetBusClock bridge; console storage stays
literal. Install read aliases only after each TU's includes, so a macro cannot
expand inside full OSHardware physical declarations or conflict with the later
0162 OS umbrella alias. The existing 0244 extern/OSTime transport still applies.
All original conversion math and clocks remain unchanged.

diff --git a/libs/RVL_SDK/include/revolution/os/OSHardware_fwd.h b/libs/RVL_SDK/include/revolution/os/OSHardware_fwd.h
index acdd78d..cbb205c 100644
--- a/libs/RVL_SDK/include/revolution/os/OSHardware_fwd.h
+++ b/libs/RVL_SDK/include/revolution/os/OSHardware_fwd.h
@@ -2,12 +2,19 @@
 #define REVOLUTION_OS_HARDWARE_FWD_H
 
 #include <decomp.h>
+#ifdef MSCHARGED_NATIVE
+#include <revolution/types.h>
+#endif
 
 #ifdef __cplusplus
 extern "C" {
 #endif
 
+#ifdef MSCHARGED_NATIVE
+u32 ChargedGetBusClock(void);
+#else
 unsigned long OS_BUS_CLOCK_SPEED AT_ADDRESS(0x800000F8);
+#endif
 
 #ifdef __cplusplus
 }
diff --git a/src/NL/nlTicker.cpp b/src/NL/nlTicker.cpp
index 0cb949b..bf28243 100644
--- a/src/NL/nlTicker.cpp
+++ b/src/NL/nlTicker.cpp
@@ -3,6 +3,12 @@
 #include <revolution/os/OSHardware_fwd.h>
 #include <revolution/os/OSTime_fwd.h>
 
+#ifdef MSCHARGED_NATIVE
+// Install the read alias only after declarations have been included.
+#undef OS_BUS_CLOCK_SPEED
+#define OS_BUS_CLOCK_SPEED ChargedGetBusClock()
+#endif
+
 void nlInitTicker()
 {
 }
diff --git a/src/NL/nlTime.cpp b/src/NL/nlTime.cpp
index cc7197b..1984a24 100644
--- a/src/NL/nlTime.cpp
+++ b/src/NL/nlTime.cpp
@@ -1,7 +1,16 @@
 #include <revolution/os/OSTime.h>
+#ifdef MSCHARGED_NATIVE
