Subject: [PATCH] native: lower source shadow view pointers through the owning view carrier
Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a

--- a/src/Game/Render/RenderShadow.cpp
+++ b/src/Game/Render/RenderShadow.cpp
@@ -261,7 +261,11 @@
     quad.m_pos[2] = p[2];
     quad.m_pos[3] = p[3];
     quad.SetColour(colour);
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    glAttachQuad3(static_cast<eGLView>(reinterpret_cast<glViewHandle>(pView)), 1, &quad);
+#else
     glAttachQuad3((eGLView)pView, 1, &quad);
+#endif
 }
 
 void RenderCharacterIntoTexture(const ProjectedShadowParams& params)
@@ -490,7 +494,11 @@
     glSetTextureState(GLTS_DiffuseWrap, 3);
     glSetCurrentTextureState(glHandleizeTextureState());
 
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    quad.Attach(static_cast<eGLView>(reinterpret_cast<glViewHandle>(g_CharacterShadowView)), 0);
+#else
     quad.Attach((eGLView)g_CharacterShadowView, 0);
+#endif
 }
 
 void RenderProjectedShadow(const ProjectedShadowParams& params)
@@ -934,7 +942,11 @@
     quad.m_uv[3].x = 0.0f;
     quad.m_uv[3].y = 0.0f;
     quad.SetColour(0xAA, 0xAA, 0xAA, 0xFF);
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    quad.Attach(static_cast<eGLView>(reinterpret_cast<glViewHandle>(GetLayerView(layer))), 0);
+#else
     quad.Attach((eGLView)GetLayerView(layer), 0);
+#endif
 }
 
