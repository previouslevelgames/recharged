Subject: [PATCH] retain original impostor providers with native pointer ABI

Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Keep all original methods and static construction. Size the original model
pointer array using its actual native element width and transport the existing
GLView pointer through the original enum carrier without truncation.

diff --git a/src/Game/Render/ImpostorCharacter.cpp b/src/Game/Render/ImpostorCharacter.cpp
index 5997f33..f3b12a3 100644
--- a/src/Game/Render/ImpostorCharacter.cpp
+++ b/src/Game/Render/ImpostorCharacter.cpp
@@ -303,7 +303,11 @@ AnimatedImpostorCharacter::AnimatedImpostorCharacter(
     : ImpostorCharacter(name, budget, numAngles, numTextures, params)
 {
     mNumModels = numTextures;
+#if defined(MSCHARGED_NATIVE)
+    mModels = (ImpostorModel**)nlMalloc(numTextures * sizeof(*mModels), 8, false);
+#else
     mModels = (ImpostorModel**)nlMalloc(numTextures * 4, 8, false);
+#endif
     mModels[0] = model;
     for (int i = 1; i < numTextures; ++i)
     {
diff --git a/src/Game/Render/ImpostorCluster.cpp b/src/Game/Render/ImpostorCluster.cpp
index a5c1b34..cc7e3a4 100644
--- a/src/Game/Render/ImpostorCluster.cpp
+++ b/src/Game/Render/ImpostorCluster.cpp
@@ -82,7 +82,11 @@ void ImpostorCluster::Render(GLView* target, int)
         quad.m_colour[i].c[2] = (unsigned char)siBackgroundBlue.mValue;
         quad.m_colour[i].c[3] = 0xFF;
     }
+#if defined(MSCHARGED_NATIVE)
+    quad.Attach(static_cast<eGLView>(reinterpret_cast<glViewHandle>(target)), siBackgroundQuadLayer.mValue);
+#else
     quad.Attach((eGLView)target, siBackgroundQuadLayer.mValue);
+#endif
 }
 
 void ImpostorCluster::PlayAnimation(float, const char*)
