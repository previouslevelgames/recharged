From: mscharged-port
Subject: [PATCH] Preserve original audio script serialized words and callback byte order
Upstream-base: 2c5c51e483b652d178ef06a44b83b07a0f97d2a6

Native module data/ABI compatibility only. Original script selection, VM conditions,
bindings, update and source-owned cleanup remain unchanged. This does not establish
the effect factory, voices, normal AX initialization or complete startup.

diff --git a/include/Game/Audio/AudioScriptInterpreter.inl b/include/Game/Audio/AudioScriptInterpreter.inl
--- a/include/Game/Audio/AudioScriptInterpreter.inl
+++ b/include/Game/Audio/AudioScriptInterpreter.inl
@@ -6,7 +6,12 @@
 inline void AudioScriptInterpreter::DoFunctionCall(unsigned int index)
 {
     u32 value = m_SP[-1];
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    // The source stores the last byte of the preceding big-endian Wii word.
+    m_SP[-1] = (value & 0xFFFFFF00u) | u32(value != 0);
+#else
     ((u8*)m_SP)[-1] = value != 0;
+#endif
     if (m_RunState == 3)
         m_SP[-1] = value;
 }
diff --git a/include/Game/Audio/AudioScriptRuntime.h b/include/Game/Audio/AudioScriptRuntime.h
--- a/include/Game/Audio/AudioScriptRuntime.h
+++ b/include/Game/Audio/AudioScriptRuntime.h
@@ -99,7 +99,11 @@
 struct AudioScriptEntry
 {
     u32 mHash;
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mscharged::platform::VMAddress32<void> mData;
+#else
     void* mData;
+#endif
 
     operator u32() const { return mHash; }
     bool operator==(const u32& key) const { return mHash == key; }
@@ -111,8 +115,17 @@
 
     u16 mCount;
     u16 mUnidentified02;
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mscharged::platform::VMAddress32<u32> mValues;
+#else
     u32* mValues;
+#endif
 };
+
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+static_assert(sizeof(AudioScriptEntry) == 8);
+static_assert(sizeof(AudioScriptBindingList) == 8);
+#endif
 
 struct AudioScriptSelection
 {
