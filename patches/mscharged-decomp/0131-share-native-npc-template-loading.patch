Subject: Share original NPC template resource selection and readiness
Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090

Keep original ordered template selection, resource paths and completion predicate
shared with a checked native owner. Actor constructors and console in-place
loaders remain unchanged and are not selected by this native resource profile.

diff --git a/include/Game/Render/NPCLoadSteps.h b/include/Game/Render/NPCLoadSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/Render/NPCLoadSteps.h
@@ -0,0 +1,45 @@
+#ifndef GAME_RENDER_NPCLOADSTEPS_H
+#define GAME_RENDER_NPCLOADSTEPS_H
+
+// Shared original template-only selection, source paths and wait condition.
+// The caller owns inventory storage, checked native records and async lifetimes.
+template <class Iterator, class Template>
+inline bool SelectPendingNPCFromList(Iterator iterator, Template*& pending)
+{
+    while (iterator.hasNext())
+    {
+        if (!(*iterator)->loaded)
+        {
+            pending = *iterator;
+            return true;
+        }
+        iterator.next();
+    }
+    return false;
+}
+inline const char* NPCAnimationPathFormat() { return "art/animation/%s.sanim.zlib"; }
+inline const char* NPCHierarchyPathFormat() { return "art/animation/%s.shier"; }
+inline const char* NPCTexturesPathFormat() { return "art/characters/npcs/%s/%s.rlt"; }
+inline const char* NPCModelsPathFormat() { return "art/characters/npcs/%s/%s.rlg"; }
+inline bool NPCResourcesFinished(bool animationStarted, bool animationsLoaded,
+    bool hierarchyLoaded, bool texturesLoaded, unsigned long modelID)
+{
+    if (animationStarted && !animationsLoaded)
+    {
+        return false;
+    }
+    if (!hierarchyLoaded)
+    {
+        return false;
+    }
+    if (!texturesLoaded)
+    {
+        return false;
+    }
+    if (modelID == (unsigned long)-1)
+    {
+        return false;
+    }
+    return true;
+}
+#endif
