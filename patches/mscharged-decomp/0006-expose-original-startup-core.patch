Subject: Expose the original initialization prefix for incremental native startup

Upstream-base: 9f985f9aca654d7ec13ff894830f19aeb3f7aefd

Move the existing region/language selection and nlInit call into a callable
startup unit. Full game Initialize calls the same function, preserving order.
Only native builds omit hardware GQR setup. Native animation rotation decoders
are selected separately by patch 0019. This extraction allows early startup
without constructing unrelated game task globals or masking missing dependencies.

--- /dev/null
+++ b/include/Game/Startup.h
@@ -0,0 +1,7 @@
+#ifndef GAME_STARTUP_H
+#define GAME_STARTUP_H
+
+extern volatile int g_Region;
+void InitializeCore();
+
+#endif // GAME_STARTUP_H
--- /dev/null
+++ b/src/Game/Startup.cpp
@@ -0,0 +1,85 @@
+#include "Game/Startup.h"
+#include "Game/main.h"
+#include "NL/nlMain.h"
+
+extern "C" u8 SCGetLanguage();
+
+volatile int g_Region = 3;
+nlLocalization::nlLanguage g_Language;
+
+int GetRegion()
+{
+    int region = 0;
+    if (g_Region != 3)
+    {
+        region = g_Region;
+    }
+    return region;
+}
+
+void InitializeCore()
+{
+    // GQR setup follows the platform OSInitFastCast implementation.
+    // Native decoders will use explicit arithmetic instead of PowerPC GQRs.
+#ifndef MSCHARGED_NATIVE
+    // clang-format off
+    asm {
+        li r3, 4
+        oris r3, r3, 4
+        mtspr 0x392, r3
+        li r3, 5
+        oris r3, r3, 5
+        mtspr 0x393, r3
+        li r3, 6
+        oris r3, r3, 6
+        mtspr 0x394, r3
+        li r3, 7
+        oris r3, r3, 7
+        mtspr 0x395, r3
+    }
+    // clang-format on
+#endif
+
+    switch (GetRegion())
+    {
+    case 0:
+        switch (SCGetLanguage())
+        {
+        case 3:
+            g_Language = nlLocalization::LangNAFrench;
+            break;
+        case 4:
+            g_Language = nlLocalization::LangNASpanish;
+            break;
+        default:
+            g_Language = nlLocalization::LangEnglish;
+            break;
+        }
+        break;
+    case 1:
+        switch (SCGetLanguage())
+        {
+        case 2:
+            g_Language = nlLocalization::LangGerman;
+            break;
+        case 3:
+            g_Language = nlLocalization::LangFrench;
+            break;
+        case 4:
+            g_Language = nlLocalization::LangSpanish;
+            break;
+        case 5:
+            g_Language = nlLocalization::LangItalian;
+            break;
+        default:
+            g_Language = nlLocalization::LangUKEnglish;
+            break;
+        }
+        break;
+    case 2:
+        g_Language = nlLocalization::LangJapanese;
+        break;
+    }
+
+    nlInit();
+}
