diff --git a/src/Game/FE/LidOpenMessage.cpp b/src/Game/FE/LidOpenMessage.cpp
index 934558b..67887c7 100644
--- a/src/Game/FE/LidOpenMessage.cpp
+++ b/src/Game/FE/LidOpenMessage.cpp
@@ -101,6 +101,24 @@ static const DiscMessageImage sDiscMessageImages[][DISC_MESSAGE_COUNT] = {
 #endif
 };
 
+#if defined(MSCHARGED_NATIVE)
+// The host copies the player's original images into the storage of
+// DiscMessageImages.inc before the original entry. Index: the retail table
+// order, language rows of DISC_MESSAGE_COUNT images.
+extern "C" __attribute__((visibility("default"))) unsigned char* charged_disc_message_image(
+    unsigned int index, unsigned long* size, int* width, int* height)
+{
+    const unsigned int count = sizeof(sDiscMessageImages) / sizeof(sDiscMessageImages[0][0]);
+    if (index >= count)
+        return 0;
+    const DiscMessageImage& image = sDiscMessageImages[index / DISC_MESSAGE_COUNT][index % DISC_MESSAGE_COUNT];
+    *size = image.compressedSize;
+    *width = image.width;
+    *height = image.height;
+    return const_cast<unsigned char*>(image.compressedData);
+}
+#endif
+
 static int lastImageWidth;
 static int lastImageHeight;
 static int lastImageSize;
