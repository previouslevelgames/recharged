+// Explicit game allocation pairing avoids native new[] cookies and host
+// delete[] on game-arena memory. Every selected record is trivially destructible.
+template<class T>
+static T* PoseAccumulatorArray(unsigned count)
+{
+    static_assert(std::is_trivially_destructible_v<T>);
+    if (count == 0 || count > 4097) throw std::invalid_argument("Invalid native pose array size");
+    T* result = static_cast<T*>(nlMalloc(sizeof(T) * count, 8, false));
+    if (!result) throw std::bad_alloc();
+    try { std::uninitialized_value_construct_n(result, count); }
+    catch (...) { nlFree(result); throw; }
+    return result;
+}
+static void PoseAccumulatorFreeArrays(cPoseAccumulator* pose)
+{
+    nlFree(pose->m_PrevNodeMatrices); pose->m_PrevNodeMatrices = nullptr;
+    nlFree(pose->m_NodeMatrices); pose->m_NodeMatrices = nullptr;
+    nlFree(pose->m_pQuaternions); pose->m_pQuaternions = nullptr;
+    nlFree(pose->m_rot); pose->m_rot = nullptr;
+    nlFree(pose->m_scale); pose->m_scale = nullptr;
+    nlFree(pose->m_trans); pose->m_trans = nullptr;
+    nlFree(pose->m_cb); pose->m_cb = nullptr;
+}
+#endif
