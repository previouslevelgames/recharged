+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+// Authored GPU vertex streams keep their Wii byte order. These original CPU
+// reads use the numeric twin of the same completed stream; the original
+// offsets, strides and conversions are unchanged.
+static inline const u8* NetMeshStreamData(
+    const glModelPacket* packet, const glModelStream* layout, unsigned cellBytes)
+{
+    return (const u8*)mscharged::platform::ReadRLGNumericStream(layout->address,
+        (unsigned long)packet->numUniqueVertices * layout->stride, cellBytes);
+}
+#endif
