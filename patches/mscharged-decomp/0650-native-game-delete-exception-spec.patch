Subject: Match native global game delete definitions to the standard exception specification
Upstream-base: a353c8f2dfb34eb08fecd725965a46ea629428e3

diff --git a/src/NL/nlMemory.cpp b/src/NL/nlMemory.cpp
index 18ac34f..d42d95e 100644
--- a/src/NL/nlMemory.cpp
+++ b/src/NL/nlMemory.cpp
@@ -49,12 +49,20 @@ static inline void* AllocateMemory(unsigned long size, unsigned int alignment, b
 // Host libraries keep standard global new/delete. Only the isolated original
 // game module restores the source operators and CurrentAllocator requests.
 #if !defined(MSCHARGED_NATIVE) || defined(MSCHARGED_GAME_MODULE)
+#if defined(MSCHARGED_NATIVE)
+void operator delete(void* ptr) noexcept
+#else
 void operator delete(void* ptr)
+#endif
 {
     FreeMemory(ptr);
 }
 
+#if defined(MSCHARGED_NATIVE)
+void operator delete[](void* ptr) noexcept
+#else
 void operator delete[](void* ptr)
+#endif
 {
     FreeMemory(ptr);
 }
