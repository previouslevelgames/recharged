Subject: [PATCH] Route original RFL PS matrix requests to the sole native SDK
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

diff --git a/libs/RVL_SDK/include/revolution/mtx/mtx.h b/libs/RVL_SDK/include/revolution/mtx/mtx.h
index 066ebb9..735cd99 100644
--- a/libs/RVL_SDK/include/revolution/mtx/mtx.h
+++ b/libs/RVL_SDK/include/revolution/mtx/mtx.h
@@ -34,6 +34,38 @@ void C_MTXLightFrustum(Mtx, f32, f32, f32, f32, f32, f32, f32, f32, f32);
 void C_MTXLightPerspective(Mtx, f32, f32, f32, f32, f32, f32);
 void C_MTXLightOrtho(Mtx, f32, f32, f32, f32, f32, f32, f32, f32);
 
+#if defined(MSCHARGED_NATIVE)
+// The sole native SDK supplies the C matrix services behind its PS aliases.
+void C_MTXIdentity(Mtx);
+void C_MTXScaleApply(const Mtx, Mtx, f32, f32, f32);
+void C_MTXRotRad(Mtx, char, f32);
+void C_MTXConcat(const Mtx, const Mtx, Mtx);
+void C_MTXTransApply(const Mtx, Mtx, f32, f32, f32);
+void C_MTXCopy(const Mtx, Mtx);
+u32 C_MTXInvXpose(const Mtx, Mtx);
+#ifndef PSMTXIdentity
+#define PSMTXIdentity C_MTXIdentity
+#endif
+#ifndef PSMTXScaleApply
+#define PSMTXScaleApply C_MTXScaleApply
+#endif
+#ifndef PSMTXRotRad
+#define PSMTXRotRad C_MTXRotRad
+#endif
+#ifndef PSMTXConcat
+#define PSMTXConcat C_MTXConcat
+#endif
+#ifndef PSMTXTransApply
+#define PSMTXTransApply C_MTXTransApply
+#endif
+#ifndef PSMTXCopy
+#define PSMTXCopy C_MTXCopy
+#endif
+#ifndef PSMTXInvXpose
+#define PSMTXInvXpose C_MTXInvXpose
+#endif
+#endif
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/libs/RVL_SDK/include/revolution/mtx/mtxvec.h b/libs/RVL_SDK/include/revolution/mtx/mtxvec.h
index d566a76..6df06c3 100644
--- a/libs/RVL_SDK/include/revolution/mtx/mtxvec.h
+++ b/libs/RVL_SDK/include/revolution/mtx/mtxvec.h
@@ -9,6 +9,14 @@ extern "C" {
 
 void PSMTXMultVec(const Mtx mtx, const Vec* vec, Vec* out);
 
+#if defined(MSCHARGED_NATIVE)
+// The sole native SDK supplies the C matrix services behind its PS aliases.
+void C_MTXMultVec(const Mtx mtx, const Vec* vec, Vec* out);
+#ifndef PSMTXMultVec
+#define PSMTXMultVec C_MTXMultVec
+#endif
+#endif
+
 #ifdef __cplusplus
 }
 #endif
