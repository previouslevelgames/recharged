--- /dev/null
+++ b/include/Game/Effects/EmissionOwnerKey.h
@@ -0,0 +1,15 @@
+#ifndef GAME_EFFECTS_EMISSION_OWNER_KEY_H
+#define GAME_EFFECTS_EMISSION_OWNER_KEY_H
+
+// Original emission keys hold either a borrowed owner address or a numeric word.
+// This changes native CPU transport only; it grants no lifetime or serialization.
+#if defined(MSCHARGED_NATIVE)
+#include <stdint.h>
+#define MSCHARGED_EMISSION_OWNER_KEY uintptr_t
+#define MSCHARGED_EMISSION_OWNER_ADDRESS(pointer) reinterpret_cast<uintptr_t>(pointer)
+#else
+#define MSCHARGED_EMISSION_OWNER_KEY unsigned long
+#define MSCHARGED_EMISSION_OWNER_ADDRESS(pointer) (unsigned long)pointer
+#endif
+
+#endif // GAME_EFFECTS_EMISSION_OWNER_KEY_H
