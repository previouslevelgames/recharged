From: native port preparation
Subject: [PATCH] Preserve original HBM Wii16 text ABI and owned BE16 ingress
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

diff --git a/libs/RVL_SDK/include/revolution/hbm/nw4hbm/ut/TextWriterBase.h b/libs/RVL_SDK/include/revolution/hbm/nw4hbm/ut/TextWriterBase.h
index e799c79..759ff19 100644
--- a/libs/RVL_SDK/include/revolution/hbm/nw4hbm/ut/TextWriterBase.h
+++ b/libs/RVL_SDK/include/revolution/hbm/nw4hbm/ut/TextWriterBase.h
@@ -11,6 +11,12 @@
 #include <string.h>
 #include <wchar.h>
 
+#if defined(MSCHARGED_NATIVE)
+static_assert(sizeof(wchar_t) == 2, "HBM text shares the isolated Wii16 ABI");
+extern "C" size_t ChargedWii_wcslen(const wchar_t*);
+extern "C" int ChargedWii_vswprintf(wchar_t*, size_t, const wchar_t*, va_list);
+#endif
+
 #include "revolution/hbm/nw4hbm/ut/TagProcessorBase.h"
 
 namespace nw4hbm {
@@ -95,11 +101,20 @@ public:
     static T* GetBuffer();
 
     static int VSNPrintf(T* buffer, u32 count, const T* format, va_list arg) {
+#if defined(MSCHARGED_NATIVE)
+        return sizeof(T) == sizeof(char) ? vsnprintf((char*)buffer, count, (const char*)format, arg)
+                                         : ChargedWii_vswprintf((wchar_t*)buffer, count, (const wchar_t*)format, arg);
+#else
         return sizeof(T) == sizeof(char) ? vsnprintf((char*)buffer, count, (const char*)format, arg)
                                          : vswprintf((wchar_t*)buffer, count, (const wchar_t*)format, arg);
+#endif
     }
     static int StrLen(const T* str) {
+#if defined(MSCHARGED_NATIVE)
+        return sizeof(T) == sizeof(char) ? strlen((const char*)str) : ChargedWii_wcslen((const wchar_t*)str);
+#else
         return sizeof(T) == sizeof(char) ? strlen((const char*)str) : wcslen((const wchar_t*)str);
+#endif
     }
 
     f32 CalcLineWidth(const T* str, int length);
