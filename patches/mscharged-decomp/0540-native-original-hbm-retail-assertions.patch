@@ -58,6 +67,25 @@
     return false;
 }
 
+#if defined(MSCHARGED_NATIVE)
+static void ShowStack_(std::uintptr_t sp) {
+    ChargedNativeHBMFrame frames[16];
+    const auto count = ChargedNativeHBMCaptureStack(sp, frames, 16);
+
+    Assertion_Printf_("-------------------------------- TRACE\n");
+    Assertion_Printf_("Address:   Native stack   Return PC\n");
+
+    for (u32 i = 0; i < count; i++) {
+        Assertion_Printf_("%p:  %p ", reinterpret_cast<void*>(frames[i].stack_address),
+                          reinterpret_cast<void*>(frames[i].instruction_address));
+        if (const char* symbol = ChargedNativeHBMStackSymbol(frames[i].instruction_address)) {
+            Assertion_Printf_("%s\n", symbol);
+        } else {
+            Assertion_Printf_("\n");
+        }
+    }
+}
+#else
 static void ShowStack_(register_t sp) {
     u32 i;
     register_t* p;
@@ -89,14 +117,19 @@
         p = reinterpret_cast<register_t*>(*p);
     }
 }
+#endif
 
 // clang-format off
 DECL_WEAK void VPanic(const char* file, int line, const char* fmt, va_list vlist) {
+#if defined(MSCHARGED_NATIVE)
+    const auto stackPointer = reinterpret_cast<std::uintptr_t>(__builtin_frame_address(0));
+#else
     register register_t stackPointer;
 
     asm { mr stackPointer, r1 }
 
     stackPointer = *reinterpret_cast<register_t*>(stackPointer);
+#endif
 
     OSDisableInterrupts();
 
@@ -123,7 +156,11 @@
         OSReport("\n");
     }
 
+#if defined(MSCHARGED_NATIVE)
+    ChargedNativeHBMHalt();
+#else
     PPCHalt();
+#endif
 }
