 namespace nw4hbm {
 namespace db {
 
 static void Assertion_Printf_(char const* fmt, ...);
 static bool ShowMapInfoSubroutine_(u32 address, bool preCRFlag);
+#if defined(MSCHARGED_NATIVE)
+static void ShowStack_(std::uintptr_t sp);
