From: mscharged-port contributors
Subject: [PATCH] Share original retail boot loading setup and phase steps
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Retain original setup, input order, clocks, strap fade and service boundaries
with typed retained-scene adapters and console forwarding to the same bodies.

Refreshed for decomp 9046e67a: SHBootLoading.cpp keeps its upstream text, now
split by game version (patch 0257 restored the original anyway); this patch
only adds FrontendBootLoadingSteps.h, a copy of the USA steps for the native
boot diagnostics.

diff --git a/include/Game/FE/FrontendBootLoadingSteps.h b/include/Game/FE/FrontendBootLoadingSteps.h
new file mode 100644
index 0000000..68400ae
--- /dev/null
+++ b/include/Game/FE/FrontendBootLoadingSteps.h
@@ -0,0 +1,258 @@
+#ifndef FRONTEND_BOOT_LOADING_STEPS_H
+#define FRONTEND_BOOT_LOADING_STEPS_H
+#include "NL/nlLocalization.h"
+// Original retail BootLoadingScene fragments. Services and native ownership are
+// supplied explicitly; no audio/HOME/scene-manager readiness is synthesized.
+template<class Image, class Component, class Presentation, class State, class Wide, class Language, class FindImage, class FindComponent, class Phase>
+void FrontendBootCreated(State& s, int currentLanguage, int language, Wide widescreen, Language systemLanguage,
+                         FindImage findImage, FindComponent findComponent, Phase setPhase)
+{
+    Presentation* presentation = s.mPresentation;
+    if (currentLanguage == nlLocalization::LangJapanese)
+    {
+        if (widescreen())
+        {
+            s.mStrapImage = findImage(presentation, false, "strap",
+                "Layer", "strap_16_9_jp");
+            Image* image = findImage(presentation, true, "strap",
+                "Layer", "strap_jp");
+            image->SetVisible(false);
+            s.mWidescreen = true;
+        }
+        else
+        {
+            s.mStrapImage = findImage(presentation, false, "strap",
+                "Layer", "strap_jp");
+            Image* image = findImage(presentation, true, "strap",
+                "Layer", "strap_16_9_jp");
+            image->SetVisible(false);
+        }
+    }
+    else if (widescreen())
+    {
+        s.mStrapImage = findImage(presentation, false, "strap",
+            "Layer", "strap_16_9_us");
+        Image* image = findImage(presentation, true, "strap",
+            "Layer", "strap_us");
+        image->SetVisible(false);
+        s.mWidescreen = true;
+    }
+    else
+    {
+        s.mStrapImage = findImage(presentation, false, "strap",
+            "Layer", "strap_us");
+        Image* image = findImage(presentation, true, "strap",
+            "Layer", "strap_16_9_us");
+        image->SetVisible(false);
+    }
+    Image* image = 0;
+    switch (language)
+    {
+    case nlLocalization::LangFrench:
+    case nlLocalization::LangNAFrench:
+        if (widescreen())
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_16_9_French");
+        else
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_French");
+        break;
+    case nlLocalization::LangGerman:
+        if (widescreen())
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_16_9_German");
+        else
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_German");
+        break;
+    case nlLocalization::LangSpanish:
+    case nlLocalization::LangNASpanish:
+        if (widescreen())
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_16_9_Spanish");
+        else
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_Spanish");
+        break;
+    case nlLocalization::LangItalian:
+        if (widescreen())
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_16_9_Italian");
+        else
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_Italian");
+        break;
+    }
+    if (systemLanguage() == 6)
+    {
+        if (widescreen())
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_16_9_Dutch");
+        else
+            image = findImage(presentation, false, "art",
+                "Layer", "strap_Dutch");
+    }
+    if (image != 0)
+        s.mStrapImage->SetTextureResource(image->GetTextureResource());
+    setPhase();
+    s.mHomeButtonWarning = findComponent(presentation->m_currentSlide,
+        "Layer", "no home", 0, 0, 0, 0);
+    s.mHomeButtonWarning->SetVisible(false);
+    Component* component;
+    component = findComponent(presentation, "Slide1",
+        "Layer", "no home");
+    component->SetVisible(false);
+    component = findComponent(presentation, "ESRB",
+        "Layer", "no home");
+    component->SetVisible(false);
+    component = findComponent(presentation, "strap",
+        "Layer", "no home");
+    component->SetVisible(false);
+    component = findComponent(presentation, "nunchuk",
+        "Layer", "no home");
+    component->SetVisible(false);
+    component = findComponent(presentation, "NLG",
+        "Layer", "no home");
+    component->SetVisible(false);
+    if (s.mWidescreen)
+        s.mHomeButtonWarning->SetActiveSlide("widescreen", true, false);
+    else
+        s.mHomeButtonWarning->SetActiveSlide("Slide1", true, false);
+}
+template<class Colour, class Slide, class State, class Update, class Region, class Pressed, class Phase, class Unload>
+void FrontendBootUpdate(State& s, float fDeltaT, Update baseUpdate, Region region, Pressed pressed, Phase setPhase, Unload unloadBank)
+{
+    baseUpdate(fDeltaT);
+    if (s.mPhase == 0)
+    {
+        Slide* slide = s.mPresentation->m_currentSlide;
+        if (slide->GetCurrentTime() >= slide->GetStartTime() + slide->GetDuration())
+        {
+            s.mPhase = 3;
+            s.mElapsedTime = 0.0f;
+            setPhase();
+        }
+    }
+    else if (s.mPhase == 1)
+    {
+        if (s.mStrapDismissed)
+        {
+            int fadeRate = 2 * 255;
+            s.mStrapAlpha -= fadeRate * fDeltaT;
+            if (s.mStrapAlpha <= 0.0f)
+                s.mStrapAlpha = 0.0f;
+            Colour colour = { 255, 255, 255, 0 };
+            colour.c[3] = (unsigned char)s.mStrapAlpha;
+            s.mStrapImage->SetAssetColour(colour);
+            if (s.mStrapAlpha <= 0.0f)
+            {
+                s.mElapsedTime = 0.0f;
+                s.mPhase = 2;
+                setPhase();
+            }
+        }
+        else
+        {
+            s.mElapsedTime += fDeltaT;
+            if (s.mElapsedTime >= 1.5f)
+            {
+                if (pressed(8, 0x20, true, 0)
+                    || pressed(8, 0x08, true, 0)
+                    || pressed(8, 0x1E, true, 0)
+                    || pressed(8, 0x1F, true, 0)
+                    || pressed(8, 0x2A, true, 0)
+                    || pressed(8, 0x2B, true, 0)
+                    || pressed(8, 0x28, true, 0)
+                    || pressed(8, 0x29, true, 0))
+                    s.mStrapDismissed = true;
+                if (s.mElapsedTime >= 15.5f)
+                    s.mStrapDismissed = true;
+            }
+        }
+    }
+    else if (s.mPhase == 2)
+    {
+        Slide* slide = s.mPresentation->m_currentSlide;
+        if (slide->GetCurrentTime() >= slide->GetStartTime() + slide->GetDuration())
+        {
+            s.mElapsedTime = 0.0f;
+            if (region() == 0)
+                s.mPhase = 0;
+            else
+                s.mPhase = 3;
+            setPhase();
+        }
+    }
+    else if (s.mPhase == 3)
+    {
+        Slide* slide = s.mPresentation->m_currentSlide;
+        if (slide->GetCurrentTime() >= slide->GetStartTime() + slide->GetDuration())
+        {
+            s.mPhase = 4;
+            s.mElapsedTime = 0.0f;
+            unloadBank(0x17);
+        }
+    }
+    else if (s.mPhase == 4)
+    {
+        if (s.mElapsedTime >= 0.0f)
+        {
+            s.mElapsedTime += fDeltaT;
+            if (s.mElapsedTime >= 0.5f)
+            {
+                setPhase();
+                s.mElapsedTime = -1.0f;
+            }
+        }
+    }
+    if (s.mHomeButtonWarningActive)
+    {
+        Slide* slide = s.mHomeButtonWarning->GetActiveSlide();
+        if (slide->GetCurrentTime() >= slide->GetStartTime() + slide->GetDuration())
+        {
+            s.mHomeButtonWarning->SetVisible(false);
+            s.mHomeButtonWarningActive = false;
+        }
+    }
+}
+template<class Slide, class State, class Play, class FindComponent>
+void FrontendBootSetPhase(State& s, Play playSound, FindComponent findComponent)
+{
+    switch (s.mPhase)
+    {
+    case 0:
+        s.mPresentation->SetActiveSlide("ESRB", true);
+        break;
+    case 1:
+        s.mPresentation->SetActiveSlide("strap", true);
+        break;
+    case 2:
+        s.mPresentation->SetActiveSlide("nunchuk", true);
+        break;
+    case 4:
+        s.mPresentation->SetActiveSlide("Slide1", true);
+        break;
+    case 3:
+        s.mPresentation->SetActiveSlide("NLG", true);
+        playSound(0x17, 0xDE83984E, 0, 0);
+        break;
+    }
+    if (s.mHomeButtonWarning != 0)
+    {
+        float time = s.mHomeButtonWarning->GetActiveSlide()->GetCurrentTime();
+        s.mHomeButtonWarning = findComponent(
+            s.mPresentation->GetActiveSlide(), "Layer", "no home");
+        if (s.mWidescreen)
+            s.mHomeButtonWarning->SetActiveSlide("widescreen", true, false);
+        else
+            s.mHomeButtonWarning->SetActiveSlide("Slide1", true, false);
+        if (s.mHomeButtonWarningActive)
+        {
+            Slide* slide = s.mHomeButtonWarning->GetActiveSlide();
+            if (time < slide->GetStartTime() + slide->GetDuration())
+                s.mHomeButtonWarning->SetVisible(true);
+        }
+        s.mHomeButtonWarning->Update(time);
+    }
+}
+#endif
