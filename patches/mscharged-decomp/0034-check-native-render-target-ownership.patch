 void glDestroyTarget(GLRenderPair* target)
 {
+#if defined(MSCHARGED_NATIVE)
+    if (glNativeViewDispatchActive()) throw std::logic_error("Cannot destroy GL targets during view dispatch");
+    if (!target) throw std::invalid_argument("Null GL target handle");
+    if (!target->hash && !target->target && !target->nativeGeneration) return;
+    glValidateTarget(*target);
+    if (target->target == glplatGetBackBufferTarget()) throw std::invalid_argument("The backbuffer belongs to GL target startup");
+#endif
     unsigned long hash = target->hash;
     TargetTree::Entry* entry = (TargetTree::Entry*)targets.RemoveAVLNode(
         (AVLTreeNode**)&targets.m_Root, &hash);
     if (entry != 0)
+#if defined(MSCHARGED_NATIVE)
+        nlDeleteGameObject(entry);
+#else
         delete entry;
+#endif
 
     target->target->DestroyTexture(target->hash);
     delete target->target;
     target->hash = 0;
     target->target = 0;
+#if defined(MSCHARGED_NATIVE)
+    target->nativeGeneration = 0;
+#endif
 }
 
 unsigned long glGetTargetTexture(GLRenderPair target)
 {
+#if defined(MSCHARGED_NATIVE)
+    glValidateTarget(target);
+    if (target.target == glplatGetBackBufferTarget())
+        throw std::invalid_argument("The backbuffer has no registered texture");
+#endif
     return target.hash;
 }
+
+#if defined(MSCHARGED_NATIVE)
+void glValidateTarget(GLRenderPair target)
+{
+    if (!nativeTargetsLive || !target) throw std::invalid_argument("GL target is not live");
+    auto current = FindTarget(target.hash);
+    if (!current || current.target != target.target || current.nativeGeneration != target.nativeGeneration)
+        throw std::invalid_argument("Stale or foreign GL target handle");
+}
+void gl_TargetShutdown()
+{
+    while (targets.m_Root)
+    {
+        auto target = GLRenderPair(targets.m_Root->key, targets.m_Root->value);
+        if (target.target == glplatGetBackBufferTarget()) targets.Remove(target.hash);
+        else glDestroyTarget(&target);
+    }
+    nativeTargetsLive = false;
+}
+#endif
