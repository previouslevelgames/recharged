+++ b/include/Game/FE/FrontendSelectionSteps.h
@@ -0,0 +1,22 @@
+#ifndef GAME_FE_FRONTEND_SELECTION_STEPS_H
+#define GAME_FE_FRONTEND_SELECTION_STEPS_H
+// Original FEPresentation/TLComponent reset predicates. Selection identity and
+// lookup stay with each caller; component Update(0) follows selection.
+inline void FrontendSelectPresentationTime(float& time, bool resetTime, bool changed)
+{
+    if (resetTime || changed)
+    {
+        time = 0.0f;
+    }
+}
+inline void FrontendSelectComponentTime(float& time, bool forceReset, bool changed, bool preserveTime)
+{
+    if (forceReset || changed)
+    {
+        if (!preserveTime)
+        {
+            time = 0.0f;
+        }
+    }
+}
+#endif
