+#ifndef GAME_FE_FRONTEND_INSTANCE_STEPS_H
+#define GAME_FE_FRONTEND_INSTANCE_STEPS_H
+#include "Game/FE/tlInstance.h"
+
+// Shared original TLInstance setter bodies. The checked native adapter supplies
+// native-owned attributes without constructing a console object graph.
+template<class Instance>
+inline void FrontendSetAssetPosition(Instance& object, float x, float y, float z)
+{
+    object.m_overloadFlags |= 0x1;
+    object.m_overloadedAttributes.v3Position.f.x = x;
+    object.m_overloadedAttributes.v3Position.f.y = y;
+    object.m_overloadedAttributes.v3Position.f.z = z;
+}
+template<class Instance>
+inline void FrontendSetAssetRotation(Instance& object, float x, float y, float z)
+{
+    object.m_overloadFlags |= 0x2;
+    object.m_overloadedAttributes.v3Rotation.f.x = x;
+    object.m_overloadedAttributes.v3Rotation.f.y = y;
+    object.m_overloadedAttributes.v3Rotation.f.z = z;
+}
+template<class Instance>
+inline void FrontendSetAssetScale(Instance& object, float x, float y, float z)
+{
+    object.m_overloadFlags |= 0x4;
+    object.m_overloadedAttributes.v3Scale.f.x = x;
+    object.m_overloadedAttributes.v3Scale.f.y = y;
+    object.m_overloadedAttributes.v3Scale.f.z = z;
+}
+template<class Instance>
+inline void FrontendSetAssetColour(Instance& object, const nlColour& color)
+{
+    object.m_overloadFlags |= 0x10;
+    object.m_overloadedAttributes.colour = color;
+}
+template<class Instance>
+inline void FrontendSetAssetPivot(Instance& object, float x, float y, float z)
+{
+    object.m_overloadFlags |= 0x8;
+    object.m_overloadedAttributes.v3Pivot.f.x = x;
+    object.m_overloadedAttributes.v3Pivot.f.y = y;
+    object.m_overloadedAttributes.v3Pivot.f.z = z;
+}
+template<class Instance>
+inline void FrontendSetAssetUVX(Instance& object, float value)
+{
+    object.m_overloadFlags |= 0x40;
+    object.m_overloadedAttributes.fUVX = value;
+}
+template<class Instance>
+inline void FrontendSetAssetUVY(Instance& object, float value)
+{
+    object.m_overloadFlags |= 0x80;
+    object.m_overloadedAttributes.fUVY = value;
+}
+template<class Instance>
+inline void FrontendSetAssetUVWidth(Instance& object, float value)
+{
+    object.m_overloadFlags |= 0x100;
+    object.m_overloadedAttributes.fUVWidth = value;
+}
+template<class Instance>
+inline void FrontendSetAssetUVHeight(Instance& object, float value)
+{
+    object.m_overloadFlags |= 0x200;
+    object.m_overloadedAttributes.fUVHeight = value;
+}
+template<class Instance>
+inline void FrontendSetAssetVisible(Instance& object, bool visible)
+{
+    nlColour color = object.m_overloadedAttributes.colour;
+    color.c[3] = visible ? 0xFF : 0;
+    object.m_overloadFlags |= 0x10;
+    object.m_overloadedAttributes.colour = color;
+}
+template<class Flags>
+inline void FrontendSetStringIdFlags(Flags& flags) { flags |= 0x8u; }
+template<class Flags>
+inline void FrontendSetUserStringFlags(Flags& flags) { flags &= 0xFFFFFFF7; }
+inline void FrontendSetVisible(bool& target, bool visible) { target = visible; }
+template<class Reference>
+inline void FrontendSetImageResource(Reference& target, const Reference& resource)
+{
+    if (resource != Reference()) target = resource;
+}
+// BaseLoadingScene::SceneCreated up to its real HBMManager dependency.
+// Finder keeps original FindOrDefault on console; the native adapter fails
+// explicitly when a required authored component is absent or has the wrong type.
+template<class Scene, class Viewport, class Finder>
+inline void FrontendLoadingSceneSetupPrefix(Scene& scene, Viewport widescreen, Finder find)
+{
+    scene.mTransitionComponent = find(scene.mPresentation->m_currentSlide, "Layer", "no home");
+    scene.mTransitionComponent->m_bVisible = false;
+    if (widescreen())
+    {
+        scene.mWidescreen = true;
+        scene.mTransitionComponent->SetActiveSlide("widescreen", true, false);
+    }
+}
+// Shared original FEFindInstance control flow. Access maps original pointers or
+// checked file-relative node IDs; ring matching remains first-match in each.
+template<class Access>
+typename Access::Node FrontendFindRecursive(Access&, typename Access::Node, const unsigned long*);
+template<class Access>
+typename Access::Node FrontendFindSlideChildren(Access& access, typename Access::Node top, const unsigned long* levels)
+{
+    if (!top) return typename Access::Node();
+    typename Access::Node child = access.Child(top, levels[0]);
+    if (!child || levels[1] == 0) return child;
+    return FrontendFindRecursive(access, child, levels + 1);
+}
+template<class Access>
+typename Access::Node FrontendFindRecursive(Access& access, typename Access::Node instance, const unsigned long* levels)
+{
+    if (!instance) return typename Access::Node();
+    bool component = access.IsComponent(instance);
+    typename Access::Node child;
+    if (component)
+    {
+        child = access.ComponentSlide(instance, levels[0]);
+        if (!child)
+            return FrontendFindSlideChildren(access, access.ActiveComponentSlide(instance), levels);
+    }
+    else child = access.Child(instance, levels[0]);
+    if (!child || levels[1] == 0) return child;
+    if (component) return FrontendFindSlideChildren(access, child, levels + 1);
+    return FrontendFindRecursive(access, child, levels + 1);
+}
+template<class Access>
+typename Access::Node FrontendFindPresentation(Access& access, const unsigned long* levels)
+{
+    typename Access::Node child = access.PresentationSlide(levels[0]);
+    if (!child) return FrontendFindSlideChildren(access, access.ActivePresentationSlide(), levels);
+    if (levels[1] == 0) return child;
+    return FrontendFindSlideChildren(access, child, levels + 1);
+}
+#endif
