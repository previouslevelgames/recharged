+
+struct FrontendOriginalFinder
+{
+    struct Node
+    {
+        void* pointer;
+        bool slide;
+        Node(void* value = 0, bool isSlide = false) : pointer(value), slide(isSlide) {}
+        operator bool() const { return pointer != 0; }
+    };
+    FEPresentation* presentation;
+    FrontendOriginalFinder(FEPresentation* p = 0) : presentation(p) {}
+    Node Child(Node n, unsigned long hash) const
+    {
+        TLInstance* children = n.slide ? ((TLSlide*)n.pointer)->pChildren : ((TLInstance*)n.pointer)->pChildren;
+        return Node(FindItemByHashID(children, hash));
+    }
+    bool IsComponent(Node n) const { return ((TLInstance*)n.pointer)->m_type == TLAT_COMPONENT; }
+    Node ComponentSlide(Node n, unsigned long hash) const
+    { return Node(FindItemByHashID(((TLComponent*)((TLInstance*)n.pointer)->m_component)->pChildren, hash), true); }
+    Node ActiveComponentSlide(Node n) const
+    { return Node(((TLComponentInstance*)n.pointer)->GetActiveSlide(), true); }
+    Node PresentationSlide(unsigned long hash) const
+    { return Node(FindItemByHashID(presentation->m_slides, hash), true); }
+    Node ActivePresentationSlide() const { return Node(presentation->m_currentSlide, true); }
+};
 
