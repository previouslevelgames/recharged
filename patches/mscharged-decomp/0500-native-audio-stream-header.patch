From: mscharged-port
Subject: [PATCH] Preserve original 96-byte audio stream headers on native hosts
Upstream-base: 11c0bc65ad2ec21431c5d74f1ac4cbc1e3e2e2c3

Keep the six Wii numeric words at32 bits, retaining original pool slot sizes,
header/read strides and every voice/read state decision. Convert completed
header scalar bytes at the original callback data boundary before its reads.
Console declarations and the complete callback algorithm remain original.

--- a/include/Game/Audio/AudioSource.h
+++ b/include/Game/Audio/AudioSource.h
@@ -127,14 +127,38 @@
 
 struct AudioStreamHeader
 {
+#ifdef MSCHARGED_NATIVE
+    u32 num_samples;
+#else
     unsigned long num_samples;
+#endif
+#ifdef MSCHARGED_NATIVE
+    u32 num_adpcm_nibbles;
+#else
     unsigned long num_adpcm_nibbles;
+#endif
+#ifdef MSCHARGED_NATIVE
+    u32 sample_rate;
+#else
     unsigned long sample_rate;
+#endif
     unsigned short loop_flag;
     unsigned short format;
+#ifdef MSCHARGED_NATIVE
+    u32 sa;
+#else
     unsigned long sa;
+#endif
+#ifdef MSCHARGED_NATIVE
+    u32 ea;
+#else
     unsigned long ea;
+#endif
+#ifdef MSCHARGED_NATIVE
+    u32 ca;
+#else
     unsigned long ca;
+#endif
     unsigned short coef[16];
     unsigned short gain;
     unsigned short ps;
--- a/src/Game/Audio/AudioSource.cpp
+++ b/src/Game/Audio/AudioSource.cpp
@@ -1,3 +1,6 @@
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/native_audio_stream.h"
+#endif
 #if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
 #include "platform/native_sp_table.h"
 #endif
@@ -507,6 +510,9 @@
     else
     {
         AudioStreamHeader* header = (AudioStreamHeader*)buffer;
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+        mscharged::platform::PrepareNativeAudioStreamHeader(header);
+#endif
         entry->m_State->m_StreamDataSize = header->num_adpcm_nibbles / 2;
         entry->m_State->m_SampleRateRatio = (float)header->sample_rate / 32000.0f;
         entry->m_Channel->PrepareVoice(header);
