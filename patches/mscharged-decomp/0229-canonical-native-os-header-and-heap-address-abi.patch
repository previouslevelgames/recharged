Subject: [PATCH] share canonical native OS types and heap address width

Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Native compilation uses the actual SDK context/alarm/thread/mutex ABI. Preserve
console declarations and missing Wii services as explicit imports. Heap pointer
arithmetic retains native addresses while original32-bit offsets remain fixed.
No HBM source behavior or successful platform provider is added.

diff --git a/libs/RVL_SDK/include/revolution/mem/heapCommon.h b/libs/RVL_SDK/include/revolution/mem/heapCommon.h
index f660b89..f217b3f 100644
--- a/libs/RVL_SDK/include/revolution/mem/heapCommon.h
+++ b/libs/RVL_SDK/include/revolution/mem/heapCommon.h
@@ -33,7 +33,12 @@ struct MEMiHeapHead {
 typedef MEMiHeapHead* MEMHeapHandle;
 
 #define MEM_HEAP_INVALID_HANDLE 0
+#if defined(MSCHARGED_NATIVE)
+#include <stdint.h>
+typedef uintptr_t UIntPtr;
+#else
 typedef u32 UIntPtr;
+#endif
 
 static inline UIntPtr GetUIntPtr(const void* ptr) {
     return (UIntPtr)ptr;
diff --git a/libs/RVL_SDK/include/revolution/os/OSAlarm.h b/libs/RVL_SDK/include/revolution/os/OSAlarm.h
index 25e2ed1..1846acf 100644
--- a/libs/RVL_SDK/include/revolution/os/OSAlarm.h
+++ b/libs/RVL_SDK/include/revolution/os/OSAlarm.h
@@ -1,6 +1,22 @@
 #ifndef REVOLUTION_OS_ALARM_H
 #define REVOLUTION_OS_ALARM_H
 
+#if defined(MSCHARGED_NATIVE)
+#include <dolphin/os/OSAlarm.h>
+// Wii APIs absent from the current native SDK remain explicit providers.
+#ifdef __cplusplus
+extern "C" {
+#endif
+void __OSInitAlarm(void);
+void OSSetAlarmUserData(OSAlarm* alarm, void* userData);
+void* OSGetAlarmUserData(const OSAlarm* alarm);
+#ifdef __cplusplus
+}
+#endif
+#define OSGetAlarmUserDataAny(type_, alarm_) ((type_)(OSGetAlarmUserData(alarm_)))
+#define OSSetAlarmUserDataAny(alarm_, data_) OSSetAlarmUserData(alarm_, (void*)(data_))
+#else
+
 #include <revolution/os/OSContext.h>
 #include <revolution/types.h>
 
@@ -43,4 +59,6 @@ void* OSGetAlarmUserData(const OSAlarm* alarm);
 }
 #endif
 
+#endif // native SDK / original console declarations
+
 #endif  // REVOLUTION_OS_ALARM_H
diff --git a/libs/RVL_SDK/include/revolution/os/OSContext.h b/libs/RVL_SDK/include/revolution/os/OSContext.h
index 899a385..1057b3b 100644
--- a/libs/RVL_SDK/include/revolution/os/OSContext.h
+++ b/libs/RVL_SDK/include/revolution/os/OSContext.h
@@ -7,7 +7,7 @@
 #ifdef __cplusplus
 extern "C" {
 #endif
-void OSSwitchFiberEx(u32 r3, u32 r4, u32 r5, u32 r6, void* function, void* stack);
+// Native SDK owns the actual fiber declaration/provider ABI.
 void __OSContextInit(void);
 #ifdef __cplusplus
 }
