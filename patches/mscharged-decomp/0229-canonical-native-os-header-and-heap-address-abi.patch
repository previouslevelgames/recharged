diff --git a/libs/RVL_SDK/include/revolution/os/OSThread_fwd.h b/libs/RVL_SDK/include/revolution/os/OSThread_fwd.h
--- a/libs/RVL_SDK/include/revolution/os/OSThread_fwd.h
