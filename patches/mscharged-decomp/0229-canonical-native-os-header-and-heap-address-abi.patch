 #define REVOLUTION_OS_MUTEX_H
+
+#if defined(MSCHARGED_NATIVE)
+#include <dolphin/os/OSMutex.h>
+#else
 
 #include <revolution/os/OSThread.h>
 
@@ -31,4 +35,6 @@
 }
 #endif
 
+#endif // native SDK / original console declarations
+
 #endif  // REVOLUTION_OS_MUTEX_H
diff --git a/libs/RVL_SDK/include/revolution/os/OSThread.h b/libs/RVL_SDK/include/revolution/os/OSThread.h
--- a/libs/RVL_SDK/include/revolution/os/OSThread.h
