+    }
+    else
+    {
+        localMatrix = scalePivotMatrix;
+    }
+
+    if ((flags & 2) == 0)
+    {
+        localMatrix.m41 += tlPosition.f.x;
+        localMatrix.m42 += tlPosition.f.y;
+        localMatrix.m43 += tlPosition.f.z;
+    }
+    localMatrix.m43 *= -1.0f;
+    nlMultMatrices(combinedMatrix, localMatrix, parentMatrix);
