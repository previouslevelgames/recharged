+++ b/include/Game/Drawable/DrawableNetMesh.h
@@ -2,6 +2,9 @@
 #define _DRAWABLENETMESH_H_
 
 #include "types.h"
+#ifdef MSCHARGED_NATIVE
+#include "NL/gl/gl.h"
+#endif
 #include "NL/nlMath.h"
 
 class NetMesh;
@@ -40,6 +43,10 @@
 class GLView;
 
 extern GLView* g_pNetMeshView;
+#ifdef MSCHARGED_NATIVE
+extern glViewHandle g_NetMeshInvisiblePlaneView;
+#else
 extern u32 g_NetMeshInvisiblePlaneView;
+#endif
 
 #endif // _DRAWABLENETMESH_H_
