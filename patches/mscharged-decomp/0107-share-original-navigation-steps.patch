diff --git a/include/Game/FE/FrontendNavigationSteps.h b/include/Game/FE/FrontendNavigationSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendNavigationSteps.h
@@ -0,0 +1,325 @@
+#ifndef GAME_FE_FRONTEND_NAVIGATION_STEPS_H
+#define GAME_FE_FRONTEND_NAVIGATION_STEPS_H
+// Selected original visual/listener kernels. Platform/global services remain caller-owned.
+template<class TLInstance,class TLComponentInstance,template<class,int>class FEFinder,class Scene,class Wide,class Name,class Publish>
+TLComponentInstance* FrontendNavigationCreated(Scene& scene,Wide widescreen,Name namePointer,Publish publishPointer)
+{
+    TLInstance* layer = FEFinder<TLInstance, 1>::FindOrDefault(scene.GetPresentation()->GetActiveSlide(), "Layer");
+
+    for (int index = 0; index < 4; ++index)
+    {
+        char name[64];
+        namePointer(name, sizeof(name), index);
+        scene.mPointerInstances[index] = FEFinder<TLComponentInstance, 4>::Find(layer, name);
+        publishPointer(index, scene.mPointerInstances[index]);
+        scene.mPointerInstances[index]->SetActiveSlide("waiting", true, false);
+    }
+
+    scene.mBackButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "back");
+    scene.mBreadcrumbs = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "breadcrumbs");
+    scene.mPlayButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "Play_Now");
+    scene.mDoneButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "done");
+    scene.mLowerDoneButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "LOWER DONE");
+    scene.mProgressButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "PROGRESS");
+    scene.mTransition = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "transition");
+    scene.mTransition->SetVisible(false);
+    scene.mHomeWarning = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "no home");
+    scene.mHomeWarning->SetVisible(false);
+
+    TLComponentInstance* timer = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "the_timer");
+    if (widescreen())
+    {
+        scene.mPlusButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "+16:9");
+        scene.mMinusButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "-16:9");
+        FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "+")->SetVisible(false);
+        FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "-")->SetVisible(false);
+        timer->SetActiveSlide("16:9", true, false);
+        scene.mIsWidescreen = true;
+        scene.mHomeWarning->SetActiveSlide("widescreen", true, false);
+    }
+    else
+    {
+        scene.mPlusButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "+");
+        scene.mMinusButton = FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "-");
+        FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "+16:9")->SetVisible(false);
+        FEFinder<TLComponentInstance, 4>::FindOrDefault(layer, "-16:9")->SetVisible(false);
+        timer->SetActiveSlide("4:3", true, false);
+    }
+
+    return timer;
+}
+template<class Scene>
+void FrontendNavigationHideButtons(Scene& scene)
+{
+    scene.mPlusButton->m_bVisible = false;
+    scene.mMinusButton->m_bVisible = false;
+    scene.mBackButton->m_bVisible = false;
+    scene.mBreadcrumbs->m_bVisible = false;
+    scene.mPlayButton->m_bVisible = false;
+    scene.mDoneButton->m_bVisible = false;
+    scene.mLowerDoneButton->m_bVisible = false;
+    scene.mProgressButton->m_bVisible = false;
+}
+template<class Scene>
+void FrontendNavigationRestoreButtonVisibility(Scene& scene)
+{
+    scene.mPlusButton->m_bVisible = scene.mVisibleButtons & 1;
+    scene.mMinusButton->m_bVisible = (scene.mVisibleButtons >> 1) & 1;
+    scene.mBackButton->m_bVisible = (scene.mVisibleButtons >> 2) & 1;
+    scene.mBreadcrumbs->m_bVisible = (scene.mVisibleButtons >> 3) & 1;
+    scene.mPlayButton->m_bVisible = (scene.mVisibleButtons >> 4) & 1;
+    scene.mDoneButton->m_bVisible = (scene.mVisibleButtons >> 5) & 1;
+    scene.mLowerDoneButton->m_bVisible = (scene.mVisibleButtons >> 6) & 1;
+    scene.mProgressButton->m_bVisible = (scene.mVisibleButtons >> 7) & 1;
+}
+template<class Scene>
+void FrontendNavigationSetButtonVisibility(Scene& scene,int mask,bool visible)
+{
+    if (visible)
+    {
+        scene.mVisibleButtons |= mask;
+    }
+    else
+    {
+        scene.mVisibleButtons &= ~mask;
+    }
+
+    scene.mPlusButton->m_bVisible = scene.mVisibleButtons & 1;
+    scene.mMinusButton->m_bVisible = (scene.mVisibleButtons >> 1) & 1;
+    scene.mBackButton->m_bVisible = (scene.mVisibleButtons >> 2) & 1;
+    scene.mBreadcrumbs->m_bVisible = (scene.mVisibleButtons >> 3) & 1;
+    scene.mPlayButton->m_bVisible = (scene.mVisibleButtons >> 4) & 1;
+    scene.mDoneButton->m_bVisible = (scene.mVisibleButtons >> 5) & 1;
+    scene.mLowerDoneButton->m_bVisible = (scene.mVisibleButtons >> 6) & 1;
+    scene.mProgressButton->m_bVisible = (scene.mVisibleButtons >> 7) & 1;
+}
+template<class TLComponentInstance,class TLTextInstance,template<class,int>class FEFinder,class Scene>
+void FrontendNavigationResetButtons(Scene& scene,bool enabled)
+{
+    scene.mVisibleButtons = 0;
+
+    TLComponentInstance* component = FEFinder<TLComponentInstance, 4>::FindOrDefault(
+        scene.mBackButton->GetActiveSlide(), "back");
+    component->SetActiveSlide("off", true, false);
+
+    if (enabled)
+    {
+        scene.mPlusButton->SetActiveSlide("off", true, false);
+        scene.mMinusButton->SetActiveSlide("off", true, false);
+    }
+
+    scene.mPlayButton->SetActiveSlide("off", true, false);
+    scene.mDoneButton->SetActiveSlide("off", true, false);
+    scene.mLowerDoneButton->SetActiveSlide("off", true, false);
+    scene.mProgressButton->SetActiveSlide("off", true, false);
+    scene.SetPlayButtonText(0);
+    scene.SetBackButtonText(0);
+    scene.SetDoneButtonText(0);
+}
+template<class TLComponentInstance,class TLTextInstance,template<class,int>class FEFinder,class Scene>
+void FrontendNavigationSetButtons(Scene& scene,int value,bool enabled)
+{
+    scene.ResetButtons(enabled);
+    scene.mVisibleButtons = value;
+    scene.mPlusButton->m_bVisible = scene.mVisibleButtons & 1;
+    scene.mMinusButton->m_bVisible = (scene.mVisibleButtons >> 1) & 1;
+    scene.mBackButton->m_bVisible = (scene.mVisibleButtons >> 2) & 1;
+    scene.mBreadcrumbs->m_bVisible = (scene.mVisibleButtons >> 3) & 1;
+    scene.mPlayButton->m_bVisible = (scene.mVisibleButtons >> 4) & 1;
+    scene.mDoneButton->m_bVisible = (scene.mVisibleButtons >> 5) & 1;
+    scene.mLowerDoneButton->m_bVisible = (scene.mVisibleButtons >> 6) & 1;
+    scene.mProgressButton->m_bVisible = (scene.mVisibleButtons >> 7) & 1;
+    scene.SetPlayButtonText(0);
+    scene.SetBackButtonText(0);
+    scene.SetDoneButtonText(0);
+}
