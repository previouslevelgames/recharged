+template<class Instance,class Position,class Radians>
+void FrontendNavigationPointerPose(Instance* pointer,Position position,unsigned short angle,bool valid,bool sPointerHidden,Radians radians)
+{
+    if (valid)
+    {
+            pointer->SetAssetPosition(position.x, position.y, 0.0f);
+            pointer->SetAssetRotation(
+                0.0f, 0.0f, radians((unsigned short)-angle));
