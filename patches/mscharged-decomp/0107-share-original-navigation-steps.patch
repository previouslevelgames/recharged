+        pointer->m_bVisible = valid && !sPointerHidden;
+}
+template<class TLComponentInstance,class TLSlide,template<class,int>class FEFinder,class Button,class Wide>
+void FrontendBackSetInstance(Button& button,TLComponentInstance* instance,Wide widescreen)
+{
+    if (widescreen())
+    {
+        instance->SetActiveSlide("16:9", true, false);
+    }
+    else
+    {
+        instance->SetActiveSlide("4:3", true, false);
+    }
+
+    button.mButtonPosition = instance->GetAssetPosition();
+    button.mButtonInstance = FEFinder<TLComponentInstance, 2>::template Find<TLSlide>(instance->GetActiveSlide(), "back");
+}
+template<class TLImageInstance,class feVector3,template<class,int>class FEFinder,class Button>
+void FrontendBackBounds(Button* button)
+{    TLImageInstance* over = FEFinder<TLImageInstance, 2>::FindOrDefault(
+        button->mButtonInstance, "over", "list_high_250x60");
+    feVector3 position = button->mButtonInstance->GetAssetPosition();
+    button->SetInstanceBounds(over, true, position.f.x, position.f.y, 1.0f, 1.0f);
+}
+template<class Button,class Play,class Base>
+void FrontendBackEnter(Button& button,int index,void* context,Play play,Base base)
+{
+    if (!button.HasOtherPointerState(1, index))
+    {
+        button.mButtonInstance->SetActiveSlide("over", true, false);
+        play(0xACCDCA48, 0, 0, 1);
+    }
+    button.SetPointerState(1, index);
+    base(index,context);
+}
+template<class Button,class Base>
+void FrontendBackLeave(Button& button,int index,void* context,Base base)
+{
+    if (!button.HasOtherPointerState(1, index))
+    {
+        button.m_padB8 = 0.0f;
+        button.mButtonInstance->SetActiveSlide("off", true, false);
+        button.m_padCE = false;
+    }
+    button.SetPointerState(0, index);
+    base(index,context);
+}
+template<class Button>
+void FrontendBackInside(Button& button,int index)
+{
+    button.mPointerInside[index] = true;
+}
+template<class Button,class Play,class Base>
+void FrontendBackPress(Button& button,int index,void* context,Play play,Base base)
+{
+    base(index,context);
+    play(0x6F6A3A07, 0, 0, 1);
+    button.mPressed = true;
+}
+template<class Button,class Base>
+void FrontendBackRelease(Button& button,int index,void* context,Base base)
+{
+    base(index,context);
+    button.mPressed = false;
+}
+template<int Invalid,class Button,class Push,class Pop>
+bool FrontendBackFinish(Button& button,Push push,Pop pop)
+{    if (button.mPressed && button.mPushBackScene)
+    {
+        if (button.mBackScene != Invalid)
+        {
+            push(button.mBackScene);
+        }
+        button.mPressed = false;
+        return true;
+    }
+
+    if (button.mPressed && !button.mPushBackScene)
+    {
+        if (button.mPopScene)
+        {
+            pop();
+        }
+        button.mPressed = false;
+        return true;
+    }
+
+    return false;
+}
