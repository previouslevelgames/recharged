Subject: Select original dispatch task and base transition hook

Upstream-base: bab83befb5d6a2fdff0b30d2ec4b59f7251a108d

Extract the existing default nlTask::StateTransition from Team.cpp for independent
source selection and retain the original DispatchEventsTask::Run(true) path.
Native initialization uses the checked game-new overload with construction-failure
cleanup. Reset cancels pending payloads before releasing blocks and preserves the
original persistent task; the port supplies explicit final task destruction.
The broader task manager, MoviePlay and original main loop remain unselected.

diff --git a/src/Game/Task/DispatchEventsTask.cpp b/src/Game/Task/DispatchEventsTask.cpp
index 20fe287..38eea4f 100644
--- a/src/Game/Task/DispatchEventsTask.cpp
+++ b/src/Game/Task/DispatchEventsTask.cpp
@@ -7,15 +7,27 @@ DispatchEventsTask* gDispatchEventsTask;
 
 void fn_80115F10()
 {
+#ifdef MSCHARGED_NATIVE
+    CheckNativeEventThread();
+    if (gDispatchEventsTask) throw std::logic_error("Dispatch task is already initialized");
+    gDispatchEventsTask = new (8, false) DispatchEventsTask;
+#else
     gDispatchEventsTask =
         new (nlMalloc(sizeof(DispatchEventsTask), 8, false)) DispatchEventsTask;
+#endif
 }
 
 void fn_80115FB4()
 {
+#ifdef MSCHARGED_NATIVE
+    CheckNativeEventThread();
+    if (!gDispatchEventsTask) throw std::logic_error("Dispatch task is not initialized");
+    gDispatchEventsTask->dispatcher.FreeBlocks(); // Cancels callbacks before freeing blocks; keeps the task alive.
+#else
     gDispatchEventsTask->dispatcher.Clear();
 
     gDispatchEventsTask->dispatcher.FreeBlocks();
+#endif
 }
 
 void DispatchEventsTask::Run(float)
