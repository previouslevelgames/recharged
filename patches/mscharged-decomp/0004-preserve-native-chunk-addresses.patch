Subject: Align chunk addresses without truncating native pointers

Upstream-base: dc238202b310059d80791d0140dee37f27b9a3bf

Native main.cpp includes inline chunk traversal. Keep addresses pointer-sized
while retaining 32-bit file fields. Bounds/endian validation belongs in loaders;
this patch establishes pointer-safe alignment only.

diff --git a/include/NL/nlChunk.h b/include/NL/nlChunk.h
--- a/include/NL/nlChunk.h
+++ b/include/NL/nlChunk.h
@@ -3,6 +3,7 @@
 
 #include "NL/nlMath.h"
 #include "types.h"
+#include <stdint.h>
 
 class nlChunk
 {
@@ -26,7 +27,7 @@
 inline nlChunk* nlChunk::GetNextChunk()
 {
     u8* address = (u8*)GetUnalignedData() + GetSize();
-    unsigned int offset = (unsigned int)address & 3;
+    unsigned int offset = (uintptr_t)address & 3;
     return (nlChunk*)(address + (offset != 0) * (4 - offset));
 }
 
@@ -34,7 +35,7 @@
 {
     unsigned int offset;
     u8* address = (u8*)GetUnalignedData() + GetSize();
-    offset = (unsigned int)address & 3;
+    offset = (uintptr_t)address & 3;
     return (nlChunk*)(address + (offset != 0) * (4 - offset));
 }
 
@@ -66,7 +67,9 @@
         return GetUnalignedData();
     }
 
-    return (void*)nlAlignUp((unsigned int)GetUnalignedData(), GetChunkAlignment());
+    const uintptr_t alignment = GetChunkAlignment();
+    const uintptr_t address = (uintptr_t)GetUnalignedData();
+    return (void*)((address + alignment - 1) & ~(alignment - 1));
 }
 
 inline unsigned int nlChunk::GetChunkAlignment()
