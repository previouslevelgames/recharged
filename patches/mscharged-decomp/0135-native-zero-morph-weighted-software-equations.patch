diff --git a/include/Game/GL/SkinSoftwareSteps.h b/include/Game/GL/SkinSoftwareSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/GL/SkinSoftwareSteps.h
@@ -0,0 +1,34 @@
+#ifndef GAME_GL_SKIN_SOFTWARE_STEPS_H
+#define GAME_GL_SKIN_SOFTWARE_STEPS_H
+#include "NL/nlMath.h"
+#include <cmath>
+
+// Scalar translation of ShaderSkinMesh::SoftwareSkinModel's zero-morph
+// paired-single instructions. Keep each rounded mul, fused madd and add in
+// its original order. In/out storage must not overlap; nearest rounding is
+// required. These equations neither normalize normals nor normalize weights.
+inline void SkinSoftwarePosition(nlVector3& output, const nlVector3& input,
+    const nlMatrix4& matrix, float weight)
+{
+    for (unsigned component = 0; component < 3; ++component)
+    {
+        float value = matrix.e[component] * input.x;
+        value = std::fma(matrix.e[4 + component], input.y, value);
+        value = std::fma(matrix.e[8 + component], input.z, value);
+        value = value + matrix.e[12 + component];
+        output.e[component] = std::fma(value, weight, output.e[component]);
+    }
+}
+
+inline void SkinSoftwareNormal(nlVector3& output, const nlVector3& input,
+    const nlMatrix4& matrix, float weight)
+{
+    for (unsigned component = 0; component < 3; ++component)
+    {
+        float value = matrix.e[component] * input.x;
+        value = std::fma(matrix.e[4 + component], input.y, value);
+        value = std::fma(matrix.e[8 + component], input.z, value);
+        output.e[component] = std::fma(value, weight, output.e[component]);
+    }
+}
+#endif
