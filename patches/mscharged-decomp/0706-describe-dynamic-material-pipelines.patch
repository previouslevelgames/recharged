+void glxCollectCharacterDamagePipelineVariants(const glModelPacket& packet)
+{
+    using namespace mscharged::platform;
+    auto* program = static_cast<GXCharacterDamageMaterialProgram*>(packet.materialProgram);
+    if (!sCharacterDamageEnabled)
+        return;
+    const auto& params = *static_cast<const GXCharacterDamageParameters*>(packet.materialParameters);
+    const bool match = AutomaticGraphicsPreparationForMatch();
+    const bool doubled = ShouldDoubleGameObjectLighting() != 0;
+    const int authoredEnabled = params.lightingEnabled == 1;
+    const int currentDamage = (sCharacterDamageForceDamage1 || params.damage1Enabled != 0)
+        | ((sCharacterDamageForceDamage2 || params.damage2Enabled != 0) << 1);
+    const int currentMega = (sCharacterDamageMegaBlendOverride > 0.0f
+        ? sCharacterDamageMegaBlendOverride : params.megaBlend) != 0.0f;
+    const int stageCount = sCharacterDamageLightingOnly ? 2 : sCharacterDamageStageCount;
+    const int firstLight = match ? 1 : glxAutomaticLightCount(true, true, false);
+    const int lastLight = match ? glxAutomaticLightCount(true, true, true) : firstLight;
+    for (int enabled = match ? 0 : authoredEnabled; enabled <= (match ? 1 : authoredEnabled); ++enabled)
+    for (int lightCount = firstLight; lightCount <= (enabled ? lastLight : firstLight); ++lightCount)
+    // Black-only ignores both damage layers and mega blending: one case, not eight.
+    for (int surface = match ? 0 : (params.blackOnly ? 8 : currentDamage + 4 * currentMega);
+         surface <= (match ? 8 : (params.blackOnly ? 8 : currentDamage + 4 * currentMega)); ++surface)
+    for (int shadow = 0; shadow < (match && sCharacterDamageShadowLightingEnabled ? 4 : 1); ++shadow)
+    {
+        BeginAutomaticMaterialVariant(packet);
+        program->ConfigureVertexFormat(true);
+        program->BindVertexArrays(&packet);
+        ConfigureCharacterDamagePipelineState(enabled != 0, lightCount, doubled,
+            stageCount, sCharacterDamageTexGenCount);
+        const bool damage[2] = { (surface & 1) != 0, (surface & 2) != 0 };
+        ConfigureCharacterDamageSurfacePipeline(surface == 8, (surface & 4) ? 1.0f : 0.0f,
+            damage, stageCount, sCharacterDamageTexGenCount);
+        if (shadow != 0)
+            glxConfigureProjectedShadowPipeline(true, shadow == 3, shadow == 2);
+        EmitAutomaticMaterialPipeline(packet);
+        if (enabled)
+        {
+            const bool colourUpdate = gxSetColourUpdate(false);
+            EmitAutomaticMaterialPipeline(packet);
+            gxSetColourUpdate(colourUpdate);
+            gxSetZMode(true, GX_EQUAL, true);
+            glxConfigureMaterialOpacityColourPass(1);
+            EmitAutomaticMaterialPipeline(packet);
+        }
+    }
+}
+#endif
