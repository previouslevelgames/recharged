+void glxCollectSpecularPipelineVariants(const glModelPacket& packet)
+{
+    using namespace mscharged::platform;
+    auto* program = static_cast<GXSpecularMaterialProgram*>(packet.materialProgram);
+    const auto& params = *static_cast<const GXSpecularParameters*>(packet.materialParameters);
+    const bool match = AutomaticGraphicsPreparationForMatch();
+    const bool doubled = ShouldDoubleGameObjectLighting() != 0;
+    const int authoredEnabled = params.lightingEnabled == 1;
+    const int firstLight = match ? 1 : glxAutomaticLightCount(false, true, false);
+    const int lastLight = match ? glxAutomaticLightCount(false, true, true) : firstLight;
+    for (int enabled = match ? 0 : authoredEnabled; enabled <= (match ? 1 : authoredEnabled); ++enabled)
+    for (int lightCount = firstLight; lightCount <= (enabled ? lastLight : firstLight); ++lightCount)
+    for (int shadow = 0; shadow < (match || IsShadowLookupActive() ? 4 : 1); ++shadow)
+    {
+        BeginAutomaticMaterialVariant(packet);
+        program->ConfigureVertexFormat(true);
+        program->BindVertexArrays(&packet);
+        glxConfigureSpecularPipelineState(enabled != 0, lightCount, doubled);
+        if (shadow != 0)
+            glxConfigureProjectedShadowPipeline(true, shadow == 3, shadow == 2);
+        EmitAutomaticMaterialPipeline(packet);
+        if (sSpecularDefaultLightingEnabled)
+        {
+            if (sSpecularDepthPrepassEnabled)
+            {
+            const bool colourUpdate = gxSetColourUpdate(false);
+            EmitAutomaticMaterialPipeline(packet);
+            gxSetColourUpdate(colourUpdate);
+            gxSetZMode(true, GX_EQUAL, true);
+            }
+            glxConfigureMaterialOpacityColourPass(1);
+            EmitAutomaticMaterialPipeline(packet);
+        }
+    }
+}
+#endif
