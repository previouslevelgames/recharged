+#if defined(MSCHARGED_AUTOMATIC_PREWARM)
+int glxAutomaticLightCount(bool character, bool includeEffects, bool maximum)
+{
+    int count;
+    if (maximum)
+    {
+        // EmissionManager::AddLight admits at most three effects lights.
+        // Camera-relative and ordinary in-game modes share the two base lights;
+        // Shoot-to-Score is represented by the producer's first count (one).
+        count = character && gNumCharacterInGameLights.mValue > gNumInGameLights
+            ? gNumCharacterInGameLights.mValue : gNumInGameLights;
+        if (includeEffects && gEffectsLightsEnabled)
+            count += 3;
+    }
+    else
+    {
+        const int effects = includeEffects && gEffectsLightsEnabled
+            ? glxAutomaticEffectLightCount() : 0;
+        switch (gGameObjectLightingMode)
+        {
+        case OBJECT_LIGHTING_IN_GAME:
+            count = (character ? gNumCharacterInGameLights.mValue : gNumInGameLights) + effects;
+            break;
+        case OBJECT_LIGHTING_CAMERA_RELATIVE:
+            count = gNumInGameLights + effects;
+            break;
+        case OBJECT_LIGHTING_SHOOT_TO_SCORE:
+            count = 1;
+            break;
+        default:
+            count = 2;
+            break;
+        }
+    }
+    // The channel-mask table has six entries. Original light counts in normal
+    // gameplay are one through five; keep debug values inside that API domain.
+    return count < 1 ? 1 : (count > 6 ? 6 : count);
+}
+#endif
