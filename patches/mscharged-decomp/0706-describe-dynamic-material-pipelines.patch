+         diffuse <= (match ? 4 : params.diffuseLightCount); ++diffuse)
+    for (int specular = match ? 0 : params.specularLightCount;
+         specular <= (match ? 4 : params.specularLightCount); ++specular)
+    for (int blend = match ? 0 : (params.blendAmount >= 0.999f);
+         blend <= (match ? 1 : (params.blendAmount >= 0.999f)); ++blend)
+    for (int animateNormal = match ? 0 : (params.animateNormalTexCoords != 0);
+         animateNormal <= (match ? 1 : (params.animateNormalTexCoords != 0)); ++animateNormal)
+    {
+        BeginAutomaticMaterialVariant(packet);
+        program->ConfigureVertexFormat(true);
+        program->BindVertexArrays(&packet);
+        GXSetVtxDesc(GX_VA_PNMTXIDX, GX_DIRECT);
+        glxConfigureSkinnedMultiLightBlend(blend ? 1.0f : 0.0f);
