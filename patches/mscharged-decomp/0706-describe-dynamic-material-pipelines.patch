+        case OBJECT_LIGHTING_CAMERA_RELATIVE:
+            count = gNumInGameLights + effects;
+            break;
+        case OBJECT_LIGHTING_SHOOT_TO_SCORE:
+            count = 1;
+            break;
+        default:
+            count = 2;
+            break;
+        }
+    }
+    // The channel-mask table has six entries. Original light counts in normal
+    // gameplay are one through five; keep debug values inside that API domain.
+    return count < 1 ? 1 : (count > 6 ? 6 : count);
