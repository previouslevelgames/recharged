+#if defined(MSCHARGED_AUTOMATIC_PREWARM)
+void glxCollectDetailModulatePipelineVariants(const glModelPacket& packet)
+{
+    using namespace mscharged::platform;
+    auto* program = static_cast<GXDetailModulateMaterialProgram*>(packet.materialProgram);
+    const auto& params = *static_cast<const GXDetailModulateParameters*>(packet.materialParameters);
+    const bool match = AutomaticGraphicsPreparationForMatch();
+    const bool doubled = ShouldDoubleGameObjectLighting() != 0;
+    const int activeMode = ShouldUseGameObjectLightTexture(0) ? LIGHTING_TEXTURE
+        : (doubled ? LIGHTING_VERTEX_DOUBLE : LIGHTING_VERTEX);
+    const int authoredMode = params.lightingEnabled != 0 && IsGameObjectLightingEnabled()
+        ? activeMode : LIGHTING_NONE;
+    const int modes[] = { LIGHTING_NONE, activeMode };
+    const int firstLight = match ? 1 : glxAutomaticLightCount(false, true, false);
+    const int lastLight = match ? glxAutomaticLightCount(false, true, true) : firstLight;
+    for (int modeIndex = 0; modeIndex < (match ? 2 : 1); ++modeIndex)
+    {
+        const int mode = match ? modes[modeIndex] : authoredMode;
+    for (int lightCount = firstLight; lightCount <= (mode != LIGHTING_NONE ? lastLight : firstLight); ++lightCount)
+    for (int shadow = 0; shadow < (match || (params.shadowEnabled == 1 && IsShadowLookupActive()) ? 2 : 1); ++shadow)
+    {
+        BeginAutomaticMaterialVariant(packet);
+        program->ConfigureVertexFormat(true);
+        program->BindVertexArrays(&packet);
+        gxSetNumChans(1);
+        glxConfigureDetailModulatePipelineState(mode, lightCount, doubled);
+        if (shadow != 0)
+            glxConfigureProjectedShadowPipeline(false, false, false);
+        EmitAutomaticMaterialPipeline(packet);
+    }
+    }
+}
+#endif
