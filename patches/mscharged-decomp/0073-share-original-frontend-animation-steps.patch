Subject: Share original frontend animation sampling and timeline advance

Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Select original Bezier and share FE key/ring/time equations with a checked native
owner. Preserve scalar/vector sentinel and singleton differences, presentation
plus slide advance, strict endpoints and single loop subtraction. Native callers
validate ring ownership, key order, inputs and result casts; no menu handlers.

Refreshed for decomp 9046e67a: feAnimation.cpp, fePresentation.cpp, tlSlide.cpp
and utility.cpp keep their upstream text (the series' later restore patches
made these edits net zero); this patch only adds the shared steps header.

diff --git a/include/Game/FE/FrontendAnimationSteps.h b/include/Game/FE/FrontendAnimationSteps.h
new file mode 100644
index 0000000..c475143
--- /dev/null
+++ b/include/Game/FE/FrontendAnimationSteps.h
@@ -0,0 +1,146 @@
+#ifndef GAME_FE_FRONTEND_ANIMATION_STEPS_H
+#define GAME_FE_FRONTEND_ANIMATION_STEPS_H
+#include "Game/FE/feAnimation.h"
+#include "NL/nlDLRing.h"
+#include "NL/nlMath.h"
+#if defined(MSCHARGED_NATIVE)
+#include <cmath>
+#include <stdexcept>
+#endif
+inline void FrontendCheckAnimationMu(float value)
+{
+#if defined(MSCHARGED_NATIVE)
+    if (!std::isfinite(value) || std::abs(value) > 1e6f)
+        throw std::runtime_error("Frontend interpolation parameter exceeds its finite profile");
+#endif
+}
+inline bool FrontendSampleFloat(fAnimationKeyframe* head,float fCurrentTime,float& fAnimatedResult)
+{
+    fAnimationKeyframe* currentFrame;
+    float fMu;
+
+    currentFrame = nlDLRingGetStart<fAnimationKeyframe>(head);
+    if (currentFrame != currentFrame->m_next)
+    {
+        if (fCurrentTime >= currentFrame->pKeyFrameData.GetTime())
+        {
+            while (fCurrentTime > currentFrame->pKeyFrameData.GetTime())
+            {
+                currentFrame = currentFrame->m_next;
+                if (nlDLRingIsEnd<fAnimationKeyframe>(head, currentFrame))
+                {
+                    break;
+                }
+            }
+
+            if (fCurrentTime == currentFrame->pKeyFrameData.GetTime())
+            {
+                fAnimatedResult = currentFrame->pKeyFrameData.GetPoint();
+            }
+            else if (!(fCurrentTime > currentFrame->pKeyFrameData.GetTime())
+                     || currentFrame->pKeyFrameData.GetControl1() != -1.0f)
+            {
+                float fPrevTime = currentFrame->m_prev->pKeyFrameData.GetTime();
+                fMu = (fCurrentTime - fPrevTime) / (currentFrame->pKeyFrameData.GetTime() - fPrevTime);
+                FrontendCheckAnimationMu(fMu);
+                float controlPoints[4];
+                controlPoints[0] = currentFrame->m_prev->pKeyFrameData.GetPoint();
+                controlPoints[1] = currentFrame->m_prev->pKeyFrameData.GetControl1();
+                controlPoints[2] = currentFrame->m_prev->pKeyFrameData.GetControl2();
+                controlPoints[3] = currentFrame->pKeyFrameData.GetPoint();
+                fAnimatedResult = nlBezier(controlPoints, 3, fMu);
+            }
+            else
+            {
+                fAnimatedResult = currentFrame->pKeyFrameData.GetPoint();
+            }
+
+            return true;
+        }
+    }
+    return false;
+}
+inline void FrontendSampleVector3(v3AnimationKeyframe* head,AnimType type,float fCurrentTime,float (&result)[3])
+{
+    v3AnimationKeyframe* currentFrame;
+    float fMu;
+
+    currentFrame = nlDLRingGetStart<v3AnimationKeyframe>(head);
+    if (fCurrentTime < currentFrame->pKeyFrameDataX.GetTime())
+    {
+        fCurrentTime = currentFrame->pKeyFrameDataX.GetTime();
+    }
+
+    while (fCurrentTime > currentFrame->pKeyFrameDataX.GetTime()
+           && (type != eAnimRotation || -1.0f != currentFrame->pKeyFrameDataX.GetControl1()
+               || -1.0f != currentFrame->pKeyFrameDataX.GetControl2()))
+    {
+        currentFrame = currentFrame->m_next;
+        if (nlDLRingIsEnd<v3AnimationKeyframe>(head, currentFrame))
+        {
+            break;
+        }
+    }
+
+    if (fCurrentTime == currentFrame->pKeyFrameDataX.GetTime())
+    {
+        result[0] = currentFrame->pKeyFrameDataX.GetPoint();
+        result[1] = currentFrame->pKeyFrameDataY.GetPoint();
+        result[2] = currentFrame->pKeyFrameDataZ.GetPoint();
+    }
+    else if (!(fCurrentTime > currentFrame->pKeyFrameDataX.GetTime())
+             || currentFrame->pKeyFrameDataX.GetControl1() != -1.0f)
+    {
+        float prevTime = currentFrame->m_prev->pKeyFrameDataX.GetTime();
+        fMu = (fCurrentTime - prevTime) / (currentFrame->pKeyFrameDataX.GetTime() - prevTime);
+        FrontendCheckAnimationMu(fMu);
+
+        float controlPointsX[4];
+        controlPointsX[0] = currentFrame->m_prev->pKeyFrameDataX.GetPoint();
+        controlPointsX[1] = currentFrame->m_prev->pKeyFrameDataX.GetControl1();
+        controlPointsX[2] = currentFrame->m_prev->pKeyFrameDataX.GetControl2();
+        controlPointsX[3] = currentFrame->pKeyFrameDataX.GetPoint();
+
+        float controlPointsY[4];
+        controlPointsY[0] = currentFrame->m_prev->pKeyFrameDataY.GetPoint();
+        controlPointsY[1] = currentFrame->m_prev->pKeyFrameDataY.GetControl1();
+        controlPointsY[2] = currentFrame->m_prev->pKeyFrameDataY.GetControl2();
+        controlPointsY[3] = currentFrame->pKeyFrameDataY.GetPoint();
+
+        float controlPointsZ[4];
+        controlPointsZ[0] = currentFrame->m_prev->pKeyFrameDataZ.GetPoint();
+        controlPointsZ[1] = currentFrame->m_prev->pKeyFrameDataZ.GetControl1();
+        controlPointsZ[2] = currentFrame->m_prev->pKeyFrameDataZ.GetControl2();
+        controlPointsZ[3] = currentFrame->pKeyFrameDataZ.GetPoint();
+
+        result[0] = nlBezier(controlPointsX, 3, fMu);
+        result[1] = nlBezier(controlPointsY, 3, fMu);
+        result[2] = nlBezier(controlPointsZ, 3, fMu);
+    }
+    else
+    {
+        result[0] = currentFrame->pKeyFrameDataX.GetPoint();
+        result[1] = currentFrame->pKeyFrameDataY.GetPoint();
+        result[2] = currentFrame->pKeyFrameDataZ.GetPoint();
+    }
+
+}
+// Shared original TLSlide/FEPresentation advance. Strict > and one subtraction
+// are intentional. The returned delta preserves frozen-child propagation.
+inline float FrontendAdvanceSlideTime(float& current,float time,float start,float duration,unsigned mode,bool frozen)
+{
+    if (frozen) time = 0.0f;
+    current += time;
+    float end = start + duration;
+    if (current > end)
+    {
+        switch (mode)
+        {
+        case 1: current = current - end; break;
+        case 0: current = end; break;
+        case 2: default: break;
+        }
+    }
+    return time;
+}
+#endif
diff --git a/src/NL/FrontendBezier.cpp b/src/NL/FrontendBezier.cpp
new file mode 100644
index 0000000..4cddb70
--- /dev/null
+++ b/src/NL/FrontendBezier.cpp
@@ -0,0 +1,53 @@
+#include "NL/nlMath.h"
+#include "math.h"
+
+float nlBezier(float* fControlPoints, int nNumPoints, float fMu)
+{
+    int nFactorial;
+    int kFactorial;
+    int nMinusKFactorial;
+    float powVal;
+    float oneMinusMuToNMinusK;
+    float muToK;
+    int i;
+    float result;
+    int k;
+    float blend;
+
+    if (fMu == 1.0f)
+    {
+        return fControlPoints[nNumPoints - 1];
+    }
+
+    nFactorial = 1;
+    kFactorial = 1;
+    powVal = pow(1.0f - fMu, (float)nNumPoints);
+    oneMinusMuToNMinusK = powVal;
+    muToK = 1.0f;
+
+    for (i = 1; i <= nNumPoints; i++)
+    {
+        nFactorial *= i;
+    }
+
+    nMinusKFactorial = nFactorial;
+    result = *fControlPoints * oneMinusMuToNMinusK;
+
+    for (k = 1; k <= nNumPoints; k++)
+    {
+        kFactorial *= k;
+        if (k != nNumPoints)
+        {
+            nMinusKFactorial /= (nNumPoints - k) + 1;
+        }
+
+        oneMinusMuToNMinusK /= 1.0f - fMu;
+        muToK *= fMu;
+        blend = (float)(nFactorial / (kFactorial * nMinusKFactorial));
+        blend *= muToK * oneMinusMuToNMinusK;
+        blend *= fControlPoints[k];
+        result += blend;
+    }
+
+    return result;
+}
