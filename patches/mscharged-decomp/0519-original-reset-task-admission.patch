Subject: [PATCH] admit original reset task at its existing main positions

Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Restore original static construction, file-service reset callback registration
and priority-zero/all-state task registration behind one explicit diagnostic
admission. Preserve all original ResetTask code and choices. Provider closure
and actual power-event shutdown qualification are required before enabling.

diff --git a/src/Game/main.cpp b/src/Game/main.cpp
index 13f2059..76e07c7 100644
--- a/src/Game/main.cpp
+++ b/src/Game/main.cpp
@@ -250,7 +250,11 @@ static EndFrameTask endFrameTask;
 #if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP)
 static TweakerTask tweakerTask;
 static ProfilerTask profilerTask;
+#endif
+#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP) || defined(MSCHARGED_DIAGNOSTIC_FRONTEND_RESET)
 static ResetTask resetTask;
+#endif
+#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP)
 static MemCheckTask memCheckTask;
 static TextWindowTask textWindowTask;
 #endif // unrelated diagnostic task statics remain omitted
@@ -553,6 +557,8 @@ static void Initialize()
     nlRegHandleDVDMessageCB(Function<void(int)>(DisplayDVDMessageSebring));
     nlRegHandleDVDRetryingCB(Function<void(int)>(DisplayDVDMessageSebring));
     nlRegHandleDVDAllClearCB(Function<void(int)>(DVDAllClearSebring));
+#endif
+#if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP) || defined(MSCHARGED_DIAGNOSTIC_FRONTEND_RESET)
     nlRegCheckForResetFromFSCB(Function<FnVoidVoid>(
         Bind<void>(MemFun<ResetTask, void>(&ResetTask::FSCheckForReset),
             &resetTask)));
@@ -802,7 +808,7 @@ static void Initialize()
 #if !defined(MSCHARGED_DIAGNOSTIC_MAIN_BOOTSTRAP) || defined(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE)
 static void AddTasks()
 {
-#if !defined(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE)
+#if !defined(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE) || defined(MSCHARGED_DIAGNOSTIC_FRONTEND_RESET)
     nlTaskManager::AddTask(&resetTask, 0, (u32)-1);
 #endif // unqualified unrelated task registration remains omitted
     nlTaskManager::AddTask(&beginFrameTask, 4, (u32)-1);
