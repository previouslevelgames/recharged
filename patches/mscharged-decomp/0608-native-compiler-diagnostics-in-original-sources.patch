Subject: Express four original source constructs in host-valid C++
Upstream-base: f75ccf1ad20e5bd7585962990db08067c0ae498a

Native-only spellings of original constructs that host compilers reject or
diagnose without a flag. Every value, linkage and call stays the same; the
console branches are unchanged.

- DesireSuperPower: the Waluigi direction tables narrow int sums to unsigned
  short in list-initialization, which Clang rejects (error) and GCC warns
  about. Explicit conversions give the same modulo-65536 angles.
- StadiumLoading: `extern "C" bool x = true;` is the same C-linkage definition
  as the brace form, which GCC accepts without its unconditional warning.
- ODE dCylinder: host <math.h> defines M_SQRT1_2; undefine it so ODE's own
  single-precision constant is used, as the later definition already was.
- depthoffield: the console prototype declares memcpy with a u32 length. On a
  64-bit host that conflicts with the C library's size_t declaration; use
  <string.h> instead. The call is unchanged.

diff --git a/src/Game/AI/DesireSuperPower.cpp b/src/Game/AI/DesireSuperPower.cpp
--- a/src/Game/AI/DesireSuperPower.cpp
+++ b/src/Game/AI/DesireSuperPower.cpp
@@ -1211,7 +1211,13 @@
             nlVector2 direction;
             nlVec2Set(direction, x, 0.0f);
             unsigned short facing = m_pFielder->m_DetChar.m_aActualFacingDirection;
+#if defined(MSCHARGED_NATIVE)
+            // Same modulo-65536 values; host C++ forbids the implicit narrowing.
+            unsigned short angles[4] = { facing, (unsigned short)(facing + 0x4000),
+                (unsigned short)(facing - 0x4000), (unsigned short)(facing + 0x8000) };
+#else
             unsigned short angles[4] = { facing, facing + 0x4000, facing - 0x4000, facing + 0x8000 };
+#endif
             float score = 0.0f;
             unsigned short angle = angles[ChooseRunDirection(m_pFielder, angles, 4, &direction, &score)];
             if (score > 0.0f)
@@ -1383,7 +1389,13 @@
             nlVector2 direction;
             nlVec2Set(direction, x, 0.0f);
             unsigned short facing = fielder.mFielder->m_DetChar.m_aActualFacingDirection;
+#if defined(MSCHARGED_NATIVE)
+            // Same modulo-65536 values; host C++ forbids the implicit narrowing.
+            unsigned short angles[3] = { facing, (unsigned short)(facing + 0x4000),
+                (unsigned short)(facing - 0x4000) };
+#else
             unsigned short angles[3] = { facing, facing + 0x4000, facing - 0x4000 };
+#endif
             float score = 0.0f;
             unsigned short angle = angles[ChooseRunDirection(fielder.mFielder, angles, 3, &direction, &score)];
             if (score == 0.0f && fielder.mFielder->m_pBall != 0 && InOffensiveZone(fielder.mFielder) > 0.0f)
