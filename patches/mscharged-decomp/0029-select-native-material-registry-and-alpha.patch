diff --git a/src/NL/gl/glMaterialAlphaState.cpp b/src/NL/gl/glMaterialAlphaState.cpp
new file mode 100644
--- /dev/null
+++ b/src/NL/gl/glMaterialAlphaState.cpp
@@ -0,0 +1,40 @@
+// Extracted from glMaterialParameters.cpp for the native static material subset.
+#include "NL/gl/glMaterialParameters.h"
+#include "NL/gl/glModel.h"
+#include "NL/gl/glState.h"
+#include "NL/glx/glxTexture.h"
+#include <stdexcept>
+
+void glSetMaterialTextureAlphaState(
+    void*, glModelPacket* packet, unsigned long texture)
+{
+    if (texture == 0xFFFFFFFF)
+    {
+        return;
+    }
+    const PlatTexture* loaded = glx_GetTex(texture);
+    if (!loaded) throw std::runtime_error("Material diffuse texture is absent from the native inventory");
+
+    switch (loaded->m_Bits[3])
+    {
+    case 0:
+        break;
+    case 1:
+    {
+        unsigned int* rasterState = &packet->rasterState;
+        glSetRasterState(*rasterState, GLS_AlphaTest, 1);
+        glSetRasterState(*rasterState, GLS_AlphaTestRef, 0x80);
+        break;
+    }
+    default:
+    {
+        unsigned int* rasterState = &packet->rasterState;
+        glSetRasterState(*rasterState, GLS_AlphaTest, 1);
+        glSetRasterState(*rasterState, GLS_AlphaTestRef, 0);
+        glSetRasterState(*rasterState, GLS_AlphaBlend, 1);
+        glSetRasterState(*rasterState, GLS_DepthWrite, 0);
+        glSetRasterState(*rasterState, GLS_Culling, 0);
+        break;
+    }
+    }
+}
