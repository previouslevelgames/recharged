@@ -0,0 +1,39 @@
+#ifndef GAME_NISPLAYBACKTIMING_H
+#define GAME_NISPLAYBACKTIMING_H
+
+// Shared arithmetic extracted from NisPlayer::Update and Nis::UpdateTriggers.
+// Native owners validate inputs and supply the surrounding game services.
+namespace NisPlaybackTiming
+{
+inline float FrameDelta(float realTimeDelta, float timeDilation, float& cameraOverrun)
+{
+    float deltaT = realTimeDelta * timeDilation;
+    if (deltaT > 0.5f)
+    {
+        deltaT = 0.5f;
+    }
+    deltaT += cameraOverrun;
+    cameraOverrun = 0.0f;
+    return deltaT;
+}
+
+inline void KeepPrimaryOverrun(float overrun, float& cameraOverrun)
+{
+    if (overrun > 0.0f)
+    {
+        cameraOverrun = overrun;
+    }
+}
+
+inline bool Crossed(float oldTime, float newTime, float duration, float frameNumber)
+{
+    if (duration == 0.0f)
+    {
+        return false;
+    }
+    float triggerFrame = (frameNumber / 30.0f) / duration;
+    return (oldTime <= triggerFrame) && (newTime > triggerFrame);
+}
+}
+
+#endif
