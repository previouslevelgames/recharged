From: mscharged-port
Subject: [PATCH] Retain native raw audio pins through original allocation lifetime
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Original Backend allocator/silence requests remain at their source positions.
A pre-reserved native device lease pins each fresh owned RawBytes buffer.
Actual source free/reset/parent retirement releases pins before ring writes,
retaining all source allocation, callback, initialization and readiness decisions.

diff --git a/src/Game/Audio/AudioBackend.cpp b/src/Game/Audio/AudioBackend.cpp
index ea5ec3d..688fc03 100644
--- a/src/Game/Audio/AudioBackend.cpp
+++ b/src/Game/Audio/AudioBackend.cpp
@@ -1,3 +1,6 @@
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/native_audio_memory.h"
+#endif
 #include "revolution/types.h"
 #include "NL/nlDLListContainer.inl"
 #include "Game/Audio/AudioBackend.h"
@@ -61,8 +64,14 @@ AudioBackend::~AudioBackend()
 
 static inline void* CreateSilenceBuffer()
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mscharged::platform::NativeAudioMemoryReservation nativeMemory;
+#endif
     void* buffer = nlMalloc(0x500, 32, false);
     memset(buffer, 0, 0x500);
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    nativeMemory.Commit(buffer, 0x500);
+#endif
     return buffer;
 }
 
@@ -174,12 +183,18 @@ void AudioBackend::Shutdown()
 
 void* AudioBackend::AllocateAudioMemory(unsigned long size)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mscharged::platform::NativeAudioMemoryReservation nativeMemory;
+#endif
     void* pointer = m_AudioAllocator.Allocate(size, 32, false);
     if (pointer == 0)
     {
         DumpAudioBankMemory("BankUsage.txt");
         DumpAudioSystem(g_pAudioSystem, "AudioDump.txt");
     }
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    nativeMemory.Commit(pointer, size);
+#endif
     return pointer;
 }
 
diff --git a/src/NL/MemAlloc.cpp b/src/NL/MemAlloc.cpp
index 0bfb6e6..5fbdf27 100644
--- a/src/NL/MemAlloc.cpp
+++ b/src/NL/MemAlloc.cpp
@@ -386,6 +386,7 @@ void MemoryAllocator::Free(void* p)
             current = current->m_next;
         } while (current != m_free_block_list);
     }
+    mscharged::platform::RetireGameAllocationDevicePins(p);
 #endif
     FreeBlockList* block = (FreeBlockList*)((u8*)p - 4);
     s32 size;
