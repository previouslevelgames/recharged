+#ifndef GAME_AUDIO_OPTIONS_VOLUME_STEPS_H
+#define GAME_AUDIO_OPTIONS_VOLUME_STEPS_H
+// Original UserOptions category table and target/elapsed assignment.
+inline void AudioOptionsApplyVolume(int& level,float& target,float& elapsed,float minimum,float maximum)
+{
+    static const float table[]={-96.0f,-36.0f,-18.0f,-15.0f,-12.0f,-9.0f,-6.0f,-4.5f,-3.0f,-1.5f,0.0f};
+    level=level<0?0:level;
+    level=level>10?10:level;
+    float volume=table[level];
+    if(volume<minimum)target=minimum;
+    else if(volume>maximum)target=maximum;
+    else target=volume;
+    elapsed=0.0f;
+}
+#endif
