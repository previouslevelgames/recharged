+#ifndef GAME_FE_FRONTEND_AUDIO_OPTIONS_STEPS_H
+#define GAME_FE_FRONTEND_AUDIO_OPTIONS_STEPS_H
+// Selected original scene14 visual/listener kernels; services remain explicit.
+template<class TLInstance,class TLComponentInstance,template<class,int>class FEFinder,class Scene,class Name>
+void FrontendAudioOptionsCreated(Scene& scene,Name nameBar)
+{
+    auto* presentation = scene.mPresentation;
+    if (scene.mOverlayMode == 0)
+    {
+        FEFinder<TLInstance, 2>::template Find<>(presentation,
+            "OPTIONS_IN", "Layer", "blackbox")->m_bVisible = false;
+        FEFinder<TLInstance, 2>::template Find<>(presentation,
+            "OPTIONS_OUT", "Layer", "blackbox")->m_bVisible = false;
+    }
+
+    TLComponentInstance* right = FEFinder<TLComponentInstance, 4>::template Find<>(presentation,
+        "OPTIONS_IN", "Layer", "visual_options", "scrollbar_right");
+    TLComponentInstance* left = FEFinder<TLComponentInstance, 4>::template Find<>(presentation,
+        "OPTIONS_IN", "Layer", "visual_options", "scrollbar_left");
+    scene.mButtons[0] = FEFinder<TLComponentInstance, 4>::template Find<>(left->GetActiveSlide(), "down_arrow");
+    scene.mButtons[1] = FEFinder<TLComponentInstance, 4>::template Find<>(right->GetActiveSlide(), "up_arrow");
+    scene.mButtons[2] = FEFinder<TLComponentInstance, 4>::template Find<>(left->GetActiveSlide(), "down_arrow2");
+    scene.mButtons[3] = FEFinder<TLComponentInstance, 4>::template Find<>(right->GetActiveSlide(), "up_arrow2");
+    scene.mButtons[4] = FEFinder<TLComponentInstance, 4>::template Find<>(left->GetActiveSlide(), "down_arrow3");
+    scene.mButtons[5] = FEFinder<TLComponentInstance, 4>::template Find<>(right->GetActiveSlide(), "up_arrow3");
+
+    TLInstance* volume[3];
+    volume[0] = FEFinder<TLInstance, 2>::template Find<>(presentation,
+        "OPTIONS_IN", "Layer", "visual_options", "MUSIC VOLUME");
+    volume[1] = FEFinder<TLInstance, 2>::template Find<>(presentation,
+        "OPTIONS_IN", "Layer", "visual_options", "SFX VOLUME");
+    volume[2] = FEFinder<TLInstance, 2>::template Find<>(presentation,
+        "OPTIONS_IN", "Layer", "visual_options", "VOX VOLUME");
+    for (int i = 0; i < 10; ++i)
+    {
+        char name[12];
+        if (i == 0)
+            nameBar(name, 12, 0);
+        else
+            nameBar(name, 12, i + 1);
+        scene.mVolumeBars[0][i] = FEFinder<TLInstance, 2>::template Find<>(volume[0], name);
+        scene.mVolumeBars[1][i] = FEFinder<TLInstance, 2>::template Find<>(volume[1], name);
+        scene.mVolumeBars[2][i] = FEFinder<TLInstance, 2>::template Find<>(volume[2], name);
+    }
+
+    scene.UpdateVolumeLevelText(0);
+    scene.UpdateVolumeLevelText(1);
+    scene.UpdateVolumeLevelText(2);
+    scene.UpdateVolumeBars(0);
+    scene.UpdateVolumeBars(1);
+    scene.UpdateVolumeBars(2);
+    scene.MarkUnusedVolumeButtons();
+}
+template<class Scene>
+bool FrontendAudioOptionsEnabled(const Scene& scene,unsigned int item)
+{
+        bool enabled;
+        switch (item)
+        {
+        case 0:
+            enabled = scene.mSettings[0] > 0;
+            break;
+        case 1:
+            enabled = scene.mSettings[0] < 10;
+            break;
+        case 2:
+            enabled = scene.mSettings[1] > 0;
+            break;
+        case 3:
+            enabled = scene.mSettings[1] < 10;
+            break;
+        case 4:
+            enabled = scene.mSettings[2] > 0;
+            break;
+        case 5:
+            enabled = scene.mSettings[2] < 10;
+            break;
+        default:
+            enabled = false;
+            break;
+        }
+        return enabled;
+    }
+template<class Scene>
+void FrontendAudioOptionsMarkUnused(Scene& scene)
+{
+    for (int i = 0; i < 6; ++i)
+    {
+        if (!scene.IsVolumeButtonEnabled(i))
+            scene.mButtons[i]->SetActiveSlide("unused", true, false);
+    }
+}
+template<class Colour,class Scene,class SetColour>
+void FrontendAudioOptionsBars(Scene& scene,int setting,SetColour setColour)
+{
+    int volume = 0;
+    Colour selected;
+    Colour unselected;
+    setColour(selected, 0xA9, 0xD0, 0x46, 0xFF);
+    setColour(unselected, 0, 0, 0, 0xFF);
+
+    if (setting == 0)
+    {
+        volume = scene.mSettings[0];
+    }
+    else if (setting == 1)
+    {
+        volume = scene.mSettings[1];
+    }
+    else if (setting == 2)
+    {
+        volume = scene.mSettings[2];
+    }
+
+    for (int i = 0; i < 10; ++i)
+    {
+        if (i < volume)
+        {
+            scene.mVolumeBars[setting][i]->SetAssetColour(selected);
+        }
+        else
+        {
+            scene.mVolumeBars[setting][i]->SetAssetColour(unselected);
+        }
+    }
+}
+template<class Scene,class Play>
+void FrontendAudioOptionsEnter(Scene& scene,int index,unsigned int item,Play play)
+{
+    if (scene.mButtonComponents[item].HasOtherPointerState(2, -1)
+        || !scene.IsVolumeButtonEnabled(item))
+    {
+        return;
+    }
+
+    scene.mButtonComponents[item].PlayHoverFeedback(index);
+    if (!scene.mButtonComponents[item].HasOtherPointerState(1, index))
+    {
+        scene.mButtons[item]->SetActiveSlide("over", true, false);
+        play(0x96DEB5C3, 0, 0, 1);
+    }
+    scene.mButtonComponents[item].SetPointerState(1, index);
+}
+template<class Scene>
+void FrontendAudioOptionsLeave(Scene& scene,int index,unsigned int item)
+{
+    if (scene.mButtonComponents[item].HasOtherPointerState(2, -1)
+        || !scene.IsVolumeButtonEnabled(item))
+    {
+        return;
+    }
+
+    if (!scene.mButtonComponents[item].HasOtherPointerState(1, index))
+    {
+        scene.mButtons[item]->SetActiveSlide("off", true, false);
+    }
+    scene.mButtonComponents[item].SetPointerState(0, index);
+}
+template<class Scene,class Settings,class Play,class PlaySound>
+void FrontendAudioOptionsPress(Scene& scene,int index,unsigned int item,Settings getSettings,Play play,PlaySound playSound)
+{
+    if (scene.mButtonComponents[item].HasOtherPointerState(2, -1)
+        || !scene.IsVolumeButtonEnabled(item))
+        return;
+
+    auto* settings = getSettings();
+    switch (item)
+    {
+    case 0:
+        settings->MusicVolume = --scene.mSettings[0];
+        settings->ApplyMusicVolume();
+        scene.UpdateVolumeBars(0);
+        scene.UpdateVolumeLevelText(0);
+        scene.mButtons[1]->SetActiveSlide("off", true, false);
+        play(0x3021A1EE, 0, 0, 1);
+        break;
+    case 1:
+        settings->MusicVolume = ++scene.mSettings[0];
+        settings->ApplyMusicVolume();
+        scene.UpdateVolumeBars(0);
+        scene.UpdateVolumeLevelText(0);
+        scene.mButtons[0]->SetActiveSlide("off", true, false);
+        play(0x3021A1EE, 0, 0, 1);
+        break;
+    case 2:
+        settings->SFXVolume = --scene.mSettings[1];
+        settings->ApplySFXVolume();
+        scene.UpdateVolumeBars(1);
+        scene.UpdateVolumeLevelText(1);
+        scene.mButtons[3]->SetActiveSlide("off", true, false);
+        play(0x3021A1EE, 0, 0, 1);
+        break;
+    case 3:
+        settings->SFXVolume = ++scene.mSettings[1];
+        settings->ApplySFXVolume();
+        scene.UpdateVolumeBars(1);
+        scene.UpdateVolumeLevelText(1);
+        scene.mButtons[2]->SetActiveSlide("off", true, false);
+        play(0x3021A1EE, 0, 0, 1);
+        break;
+    case 4:
+        settings->VoiceVolume = --scene.mSettings[2];
+        settings->ApplyVoiceVolume();
+        scene.UpdateVolumeBars(2);
+        scene.UpdateVolumeLevelText(2);
+        if (scene.mOverlayMode == 0)
+            play(0x1F824C84, 0, 0, 1);
+        else
+            playSound(1, 0x270203ED, 0, 0);
+        scene.mButtons[5]->SetActiveSlide("off", true, false);
+        break;
+    case 5:
+        settings->VoiceVolume = ++scene.mSettings[2];
+        settings->ApplyVoiceVolume();
+        scene.UpdateVolumeBars(2);
+        scene.UpdateVolumeLevelText(2);
+        if (scene.mOverlayMode == 0)
+            play(0x1F824C84, 0, 0, 1);
+        else
+            playSound(1, 0x270203ED, 0, 0);
+        scene.mButtons[4]->SetActiveSlide("off", true, false);
+        break;
+    }
+
+    if (scene.IsVolumeButtonEnabled(item))
+        scene.mButtons[item]->SetActiveSlide("slide1", true, false);
+    else
+        scene.mButtons[item]->SetActiveSlide("unused", true, false);
+}
+template<class Scene,class FindText,class FormatText>
+void FrontendAudioOptionsText(Scene& scene,int setting,FindText findText,FormatText formatText)
+{
+    if (setting == 0)
+    {
+        auto* text = findText(
+            scene.mPresentation->m_currentSlide, "Layer", "visual_options", "MUSIC SETTING");
+        formatText(text,0,"OPTIONS_AUDIO_MUSIC_LEVEL",scene.mSettings[0]);
+    }
+    else if (setting == 1)
+    {
+        auto* text = findText(
+            scene.mPresentation->m_currentSlide, "Layer", "visual_options", "SFX SETTING2");
+        formatText(text,1,"OPTIONS_AUDIO_SFX_LEVEL",scene.mSettings[1]);
+    }
+    else
+    {
+        auto* text = findText(
+            scene.mPresentation->m_currentSlide, "Layer", "visual_options", "VOX SETTING3");
+        formatText(text,2,"OPTIONS_AUDIO_VOX_LEVEL",scene.mSettings[2]);
+    }
+}
+template<class Scene,class Position>
+void FrontendAudioOptionsBindItem(Scene& scene,int i,const Position& leftPosition,const Position& rightPosition)
+{        if (i == 0 || i == 2 || i == 4)
+            scene.mButtonComponents[i].SetInstanceBounds(scene.mButtons[i], false,
+                leftPosition.f.x, leftPosition.f.y, 1.0f, 1.0f);
+        else
+            scene.mButtonComponents[i].SetInstanceBounds(scene.mButtons[i], false,
+                rightPosition.f.x, rightPosition.f.y, 1.0f, 1.0f);
+}
+template<class TLInstance,class feVector3,template<class,int>class FEFinder,class Scene>
+void FrontendAudioOptionsBind(Scene& scene)
+{    TLInstance* right = FEFinder<TLInstance, 2>::Find(scene.mPresentation,
+        "OPTIONS_IN", "Layer", "visual_options", "scrollbar_right");
+    TLInstance* left = FEFinder<TLInstance, 2>::Find(scene.mPresentation,
+        "OPTIONS_IN", "Layer", "visual_options", "scrollbar_left");
+    feVector3 leftPosition = left->GetAssetPosition();
+    feVector3 rightPosition = right->GetAssetPosition();
+    for(int i=0;i<6;++i) FrontendAudioOptionsBindItem(scene,i,leftPosition,rightPosition);
+}
+template<class Scene,class Navigation,class Wait,class Push,class Overlay>
+bool FrontendAudioOptionsGate(Scene& scene,Navigation getNavigation,Wait waitPointer,Push push,Overlay pushOverlay)
+{    if (scene.mState == 0 || scene.mState == 2 || scene.mState == 3)
+    {
+        auto* slide = scene.mPresentation->m_currentSlide;
+        if (slide->GetCurrentTime() < slide->GetStartTime() + slide->GetDuration())
+        {
+            for (int i = 0; i < 4; ++i)
+                waitPointer(i);
+            return false;
+        }
+
+        if (scene.mState == 0)
+        {
+            auto* navigation = getNavigation();
+            if (navigation != 0)
+            {
+                navigation->SetButtons(0x24, true);
+                navigation->SetDoneButtonText(1);
+            }
+            scene.mState = 1;
+        }
+        else if (scene.mState == 2)
+        {
+            return false;
+        }
+        else if (scene.mState == 3)
+        {
+            if (scene.mOverlayMode == 0)
+                push(13);
+            else
+                pushOverlay(0x50);
+            return false;
+        }
+    }
+
+    return true;
+}
+template<class Scene,class Settings,class Play,class Navigation>
+void FrontendAudioOptionsBack(Scene& scene,Settings getSettings,Play play,Navigation getNavigation)
+{            auto* settings = getSettings();
+            settings->MusicVolume = scene.mBackupSettings[0];
+            settings->SFXVolume = scene.mBackupSettings[1];
+            settings->VoiceVolume = scene.mBackupSettings[2];
+            settings->ApplySettings();
+            play(0x304FDD1E, 0, 0, 1);
+            scene.mState = 3;
+            auto* navigation = getNavigation();
+            if (navigation != 0)
+                navigation->SetButtons(0, true);
+            scene.mPresentation->SetActiveSlide("OPTIONS_OUT", true);
+}
+#endif
