--- /dev/null
+++ b/libs/RVL_SDK/include/revolution/hbm/nw4hbm/snd/TaskNativeStorage.h
@@ -0,0 +1,54 @@
+#ifndef NW4HBM_SND_TASK_NATIVE_STORAGE_H
+#define NW4HBM_SND_TASK_NATIVE_STORAGE_H
+
+#ifdef MSCHARGED_NATIVE
+#include "revolution/hbm/nw4hbm/snd/TaskManager.h"
+#include "revolution/hbm/nw4hbm/snd/SoundArchivePlayer.h"
+#include <algorithm>
+#include <climits>
+#include <cstddef>
+#include <cstdint>
+
+namespace nw4hbm {
+namespace snd {
+namespace detail {
+
+// Reflect the unchanged source task types and the real native MEM records.
+// This supplies the native static-array bound; no task fields or algorithms
+// are duplicated here, and the original logical capacity remains TASK_NUM.
+struct TaskManager::NativeTaskStorage {
+    static constexpr std::size_t Alignment = std::max({
+        alignof(SoundArchivePlayer::SeqLoadTask),
+        alignof(SoundArchivePlayer::StrmHeaderLoadTask),
+        alignof(SoundArchivePlayer::StrmDataLoadTask),
+        alignof(MEMiHeapHead), alignof(MEMiUntHeapHead),
+        alignof(MEMiUntHeapMBlockHead)});
+    static constexpr std::size_t BlockBytes =
+        (std::max({std::size_t(64), sizeof(SoundArchivePlayer::SeqLoadTask),
+            sizeof(SoundArchivePlayer::StrmHeaderLoadTask),
+            sizeof(SoundArchivePlayer::StrmDataLoadTask)}) + Alignment - 1)
+        & ~(Alignment - 1);
+    static constexpr std::size_t HeaderBytes =
+        (sizeof(MEMiHeapHead) + sizeof(MEMiUntHeapHead) + Alignment - 1)
+        & ~(Alignment - 1);
+    static constexpr std::size_t StorageBytes = HeaderBytes + TASK_NUM * BlockBytes;
+    static constexpr std::size_t StaticAlignment = 32;
+
+    static_assert(Alignment != 0 && (Alignment & (Alignment - 1)) == 0,
+        "Native task alignment must fit the original unit-heap rounding");
+    static_assert(StaticAlignment % Alignment == 0,
+        "Original static storage alignment must fit the actual native records");
+    static_assert(sizeof(MEMiHeapHead) % alignof(MEMiUntHeapHead) == 0,
+        "Original unit-heap header placement must remain aligned");
+    static_assert(BlockBytes >= sizeof(MEMiUntHeapMBlockHead),
+        "Native free-list pointer must fit each task block");
+    static_assert(BlockBytes <= UINT32_MAX && StorageBytes <= UINT32_MAX && Alignment <= INT_MAX,
+        "Native task storage must fit the original scalar heap API");
+};
+
+} // namespace detail
+} // namespace snd
+} // namespace nw4hbm
+#endif
+
+#endif
