+void CheckAnimation(const glTextureManager& manager, GLTextureAnim* anim)
+{
+    if (!anim || !anim->m_pAnimTex || anim->m_nNumTextures <= 0 || anim->m_nNumTextures > 4096
+        || static_cast<u32>(anim->m_nNumTextures) != anim->m_NativeFrameCount
+        || anim->m_nFrame < 0 || anim->m_nFrame >= anim->m_nNumTextures
+        || anim->m_ePlayMode < GLAnimMode_Loop || anim->m_ePlayMode >= GLAnimMode_Num
+        || anim->m_nPlayDir < -1 || anim->m_nPlayDir > 1 || anim->m_bPaused > 1
+        || !std::isfinite(anim->m_fTime) || anim->m_fTime < 0)
+        throw std::invalid_argument("Invalid native texture animation state");
+    for (u32 i = 0; i < anim->m_NativeFrameCount; ++i)
+    {
+        const auto& frame = anim->m_pAnimTex[i];
+        if (!std::isfinite(frame.m_fTime) || frame.m_fTime < 0
+            || frame.m_TexHandle >= manager.mCapacity || !manager.mTextures[frame.m_TexHandle]
+            || manager.mNativeAnims[frame.m_TexHandle])
+            throw std::invalid_argument("Texture animation needs a registered static frame");
+    }
+}
+}
+void glTextureManager::ValidateTextureAnim(GLTextureAnim* anim) const
+{
+    CheckAnimation(*this, anim);
+    if (anim->m_textureIndex >= mCapacity || mNativeAnims[anim->m_textureIndex] != anim)
+        throw std::invalid_argument("Texture animation is not registered with this manager");
+}
+void glTextureManager::RegisterTextureAnim(GLTextureAnim* anim)
+{
+    CheckAnimation(*this, anim);
+    if (anim->m_textureIndex != 0xFFFF)
+        throw std::invalid_argument("Texture animation is already registered");
+    unsigned long index = mFreeIndices->RemoveStart();
+    anim->m_textureIndex = index;
+    mNativeAnims[index] = anim;
+    mTextures[index] = GetTextureAtIndex(&anim->GetTexture(-1).m_TexHandle);
+}
+void glTextureManager::RefreshTextureAnim(GLTextureAnim* anim)
+{
+    ValidateTextureAnim(anim);
+    u32 index = anim->m_textureIndex;
+    mTextures[index] = GetTextureAtIndex(&anim->GetTexture(-1).m_TexHandle);
+}
