diff --git a/include/Game/SAnimPoseSteps.h b/include/Game/SAnimPoseSteps.h
new file mode 100644
--- /dev/null
+++ b/include/Game/SAnimPoseSteps.h
@@ -0,0 +1,336 @@
+#ifndef GAME_SANIM_POSE_STEPS_H
+#define GAME_SANIM_POSE_STEPS_H
+#include "Game/SAnim.h"
+#include "Game/SAnimDecode.h"
+#include "Game/SHierarchy.h"
+#if defined(MSCHARGED_NATIVE)
+#include <cmath>
+#include <stdexcept>
+#endif
+
+// Shared original channel equations. Native callers retain validated channel
+// arrays and supply the checked accumulator sink; no PoseNode is fabricated.
+inline void SAnimPoseCheck(float time, float weight, unsigned keys)
+{
+#if defined(MSCHARGED_NATIVE)
+    if (!std::isfinite(time) || time < 0 || time > 1 || !std::isfinite(weight)
+        || weight < 0 || weight > 1 || keys == 0 || keys > 65536)
+        throw std::invalid_argument("Invalid bounded SAnim pose sample");
+#endif
+}
+inline bool SAnimPoseTerminal(float time, unsigned keys)
+{
+#if defined(MSCHARGED_NATIVE)
+    // A singleton has no following key, and float multiplication can round a
+    // sub-terminal time onto the final key. Neither case permits a next read.
+    return keys == 1 || time * (keys - 1) >= keys - 1;
+#else
+    return 1.0f == time;
+#endif
+}
+
+template <typename Accumulator>
+inline void SAnimPoseBlendRot(const cSAnim& animation, int nodeIndex, int remappedNodeIndex, float tNorm,
+    float weight, Accumulator* acc, bool additive)
+{
+    SAnimPoseCheck(tNorm, weight, animation.m_nNumKeys);
+#if defined(MSCHARGED_NATIVE)
+    void* pRawKeys = (unsigned int)remappedNodeIndex < animation.m_nNumNodes ? animation.m_pRotKeys[remappedNodeIndex] : 0;
+#else
+    void* pRawKeys = animation.m_pRotKeys[remappedNodeIndex];
+#endif
+    if (pRawKeys != 0
+        && (unsigned int)remappedNodeIndex < animation.m_nNumNodes)
+    {
+        unsigned int props = animation.m_pNodeProperties[remappedNodeIndex];
+
+        if (props & 0x2)
+        {
+            if (props & 0x1)
+            {
+                acc->BlendRotAroundZ(
+                    nodeIndex, ((unsigned short*)pRawKeys)[0], weight);
+                return;
+            }
+
+            nlQuaternion q;
+            if (props & 0x10)
+            {
+                SAnimDecodeRot16(&q, pRawKeys);
+            }
+            else if (props & 0x20)
+            {
+                SAnimDecodeRot12(&q, pRawKeys);
+            }
+            else
+            {
+                SAnimDecodeRot8(&q, pRawKeys);
+            }
+            acc->BlendRot(nodeIndex, &q, weight, additive);
+            return;
+        }
+
+        if (SAnimPoseTerminal(tNorm, animation.m_nNumKeys))
+        {
+            int lastIndex = animation.m_nNumKeys - 1;
+
+            if (props & 0x1)
+            {
+                acc->BlendRotAroundZ(nodeIndex,
+                    ((unsigned short*)pRawKeys)[lastIndex],
+                    weight);
+                return;
+            }
+
+            nlQuaternion q;
+            if (props & 0x10)
+            {
+                SAnimDecodeRot16(
+                    &q, (unsigned char*)pRawKeys + lastIndex * 8);
+            }
+            else if (props & 0x20)
+            {
+                SAnimDecodeRot12(
+                    &q, (unsigned char*)pRawKeys + lastIndex * 6);
+            }
+            else
+            {
+                SAnimDecodeRot8(
+                    &q, (unsigned char*)pRawKeys + lastIndex * 4);
+            }
+            acc->BlendRot(nodeIndex, &q, weight, additive);
+            return;
+        }
+
+        float fRealIndex = tNorm * (animation.m_nNumKeys - 1);
+        int nKeyIndex = (int)fRealIndex;
+        float fFrac = fRealIndex - nKeyIndex;
+        float fWeight2 = weight * fFrac;
+        float fWeight1 = weight - fWeight2;
+
+        if (props & 0x1)
+        {
+            unsigned short* pKeys = (unsigned short*)pRawKeys;
+            acc->BlendRotAroundZ(
+                nodeIndex, pKeys[nKeyIndex], fWeight1);
+        }
+        else
+        {
+            nlQuaternion q1;
+            if (props & 0x10)
+            {
+                SAnimDecodeRot16(
+                    &q1, (unsigned char*)pRawKeys + nKeyIndex * 8);
+            }
+            else if (props & 0x20)
+            {
+                SAnimDecodeRot12(
+                    &q1, (unsigned char*)pRawKeys + nKeyIndex * 6);
+            }
+            else
+            {
+                SAnimDecodeRot8(
+                    &q1, (unsigned char*)pRawKeys + nKeyIndex * 4);
+            }
+            acc->BlendRot(nodeIndex, &q1, fWeight1, additive);
+        }
+
+        props = animation.m_pNodeProperties[remappedNodeIndex];
+        if (props & 0x1)
+        {
+            unsigned short* pKeys
+                = (unsigned short*)animation.m_pRotKeys[remappedNodeIndex];
+            acc->BlendRotAroundZ(
+                nodeIndex, pKeys[nKeyIndex + 1], fWeight2);
+            return;
+        }
+
+        nlQuaternion q2;
+        if (props & 0x10)
+        {
+            SAnimDecodeRot16(&q2,
+                (unsigned char*)animation.m_pRotKeys[remappedNodeIndex]
+                    + (nKeyIndex + 1) * 8);
+        }
+        else if (props & 0x20)
+        {
+            SAnimDecodeRot12(&q2,
+                (unsigned char*)animation.m_pRotKeys[remappedNodeIndex]
+                    + (nKeyIndex + 1) * 6);
+        }
+        else
+        {
+            SAnimDecodeRot8(&q2,
+                (unsigned char*)animation.m_pRotKeys[remappedNodeIndex]
+                    + (nKeyIndex + 1) * 4);
+        }
+        acc->BlendRot(nodeIndex, &q2, fWeight2, additive);
+        return;
+    }
+
+    acc->BlendRotIdentity(nodeIndex, weight);
+}
+
+template <typename Accumulator>
+inline void SAnimPoseBlendScale(const cSAnim& animation, int nodeIndex, int remappedNodeIndex, float tNorm,
+    float weight, Accumulator* acc, bool additive)
+{
+    SAnimPoseCheck(tNorm, weight, animation.m_nNumKeys);
+#if defined(MSCHARGED_NATIVE)
+    PackedScale* pKeys = (unsigned int)remappedNodeIndex < animation.m_nNumNodes ? animation.m_pScaleKeys[remappedNodeIndex] : 0;
+#else
+    PackedScale* pKeys = animation.m_pScaleKeys[remappedNodeIndex];
+#endif
+    if (pKeys != 0
+        && (unsigned int)remappedNodeIndex < animation.m_nNumNodes)
+    {
+        if (animation.m_pNodeProperties[remappedNodeIndex] & 0x8)
+        {
+            nlVector3 v;
+            SAnimDecodeScale(&v, &pKeys[0]);
+            acc->BlendScale(nodeIndex, &v, weight, additive);
+            return;
+        }
+
+        if (SAnimPoseTerminal(tNorm, animation.m_nNumKeys))
+        {
+            nlVector3 v;
+            SAnimDecodeScale(&v, &pKeys[animation.m_nNumKeys - 1]);
+            acc->BlendScale(nodeIndex, &v, weight, additive);
+            return;
+        }
+
+        float fRealIndex = tNorm * (animation.m_nNumKeys - 1);
+        int nKeyIndex = (int)fRealIndex;
+        float fFrac = fRealIndex - nKeyIndex;
+        float fWeight2 = weight * fFrac;
+        float fWeight1 = weight - fWeight2;
+
+        nlVector3 v1;
+        SAnimDecodeScale(&v1, &pKeys[nKeyIndex]);
+        acc->BlendScale(nodeIndex, &v1, fWeight1, additive);
+
+        nlVector3 v2;
+        SAnimDecodeScale(
+            &v2, &animation.m_pScaleKeys[remappedNodeIndex][nKeyIndex + 1]);
+        acc->BlendScale(nodeIndex, &v2, fWeight2, additive);
+    }
+    else
+    {
+        acc->BlendScaleIdentity(nodeIndex, weight);
+    }
+}
+
+template <typename Accumulator>
+inline void SAnimPoseBlendScaleMultiply(const cSAnim& animation, int accumulatorNode, int animNode, float time,
+    float weight, Accumulator* accumulator)
+{
+    SAnimPoseCheck(time, weight, animation.m_nNumKeys);
+#if defined(MSCHARGED_NATIVE)
+    PackedScale* pKeys = (unsigned int)animNode < animation.m_nNumNodes ? animation.m_pScaleKeys[animNode] : 0;
+#else
+    PackedScale* pKeys = animation.m_pScaleKeys[animNode];
+#endif
+    if (pKeys != 0 && (unsigned int)animNode < animation.m_nNumNodes)
+    {
+        nlVector3 scale;
+        if ((animation.m_pNodeProperties[animNode] & 0x8) || time <= 0.0f)
+        {
+            SAnimDecodeScale(&scale, &pKeys[0]);
+        }
+        else if (time >= 1.0f
+#if defined(MSCHARGED_NATIVE)
+            || SAnimPoseTerminal(time, animation.m_nNumKeys)
+#endif
+        )
+        {
+            SAnimDecodeScale(&scale, &pKeys[animation.m_nNumKeys - 1]);
+        }
+        else
+        {
+            float fRealIndex = time * (animation.m_nNumKeys - 1);
+            int nKeyIndex = (int)fRealIndex;
+            float fFrac = fRealIndex - nKeyIndex;
+
+            nlVector3 scale1;
+            nlVector3 scale2;
+            SAnimDecodeScale(&scale1, &pKeys[nKeyIndex]);
+            SAnimDecodeScale(
+                &scale2, &animation.m_pScaleKeys[animNode][nKeyIndex + 1]);
+
+            scale.x = (1.0f - fFrac) * scale1.x + fFrac * scale2.x;
+            scale.y = (1.0f - fFrac) * scale1.y + fFrac * scale2.y;
+            scale.z = (1.0f - fFrac) * scale1.z + fFrac * scale2.z;
+        }
+
+        accumulator->MultiplyScale(accumulatorNode, &scale, weight);
+    }
+}
+
+template <typename Accumulator>
+inline void SAnimPoseBlendTrans(const cSAnim& animation, int nAccumulatorNode, int nSAnimNode, float fTime,
+    float fWeight, Accumulator* pAccumulator, bool bMirror)
+{
+    SAnimPoseCheck(fTime, fWeight, animation.m_nNumKeys);
+    if (pAccumulator->m_BaseSHierarchy->PreserveBoneLength(nAccumulatorNode))
+    {
+        return;
+    }
+
+#if defined(MSCHARGED_NATIVE)
+    PackedTrans* pKeys = (unsigned int)nSAnimNode < animation.m_nNumNodes ? animation.m_pTransKeys[nSAnimNode] : 0;
+#else
+    PackedTrans* pKeys = animation.m_pTransKeys[nSAnimNode];
+#endif
+    if (pKeys != 0 && (unsigned int)nSAnimNode < animation.m_nNumNodes)
+    {
+        if (animation.m_pNodeProperties[nSAnimNode] & 0x4)
+        {
+            pAccumulator->BlendTrans(nAccumulatorNode,
+                (const nlVector3*)&pKeys[0],
+                fWeight,
+                bMirror);
+            return;
+        }
+
+        if (SAnimPoseTerminal(fTime, animation.m_nNumKeys))
+        {
+            pAccumulator->BlendTrans(nAccumulatorNode,
+                (const nlVector3*)&pKeys[animation.m_nNumKeys - 1],
+                fWeight,
+                bMirror);
+            return;
+        }
+
+        float fRealIndex = fTime * (float)(animation.m_nNumKeys - 1);
+        int nKeyIndex = (int)fRealIndex;
+        float fFrac = fRealIndex - (float)nKeyIndex;
+        float fWeight2 = fWeight * fFrac;
+        float fWeight1 = fWeight - fWeight2;
+
+        pAccumulator->BlendTrans(nAccumulatorNode,
+            (const nlVector3*)&pKeys[nKeyIndex],
+            fWeight1,
+            bMirror);
+        pAccumulator->BlendTrans(nAccumulatorNode,
+            (const nlVector3*)&animation.m_pTransKeys[nSAnimNode][nKeyIndex + 1],
+            fWeight2,
+            bMirror);
+    }
+    else
+    {
+        pAccumulator->BlendTransIdentity(nAccumulatorNode, fWeight);
+    }
+}
+
+// Preserve the source controller's direct translation store separately from
+// accumulation. In particular, the identity bit and accumulated weight survive.
+template <typename Accumulator>
+inline nlVector3& SAnimPoseUnmapped(int node, float weight, Accumulator* accumulator)
+{
+    nlVector3& translationOffset = accumulator->m_BaseSHierarchy->GetTranslationOffset(node);
+    accumulator->BlendRotIdentity(node, weight);
+    accumulator->BlendScaleIdentity(node, weight);
+    return translationOffset;
+}
+#endif
