Subject: [PATCH] Decode original RLG matrix float bits at the native byte boundary
Upstream-base: a8187061af65aa2022bfd8dc2e32163089ea0090

Original LoadMatrices retains its 64-byte size mask, GLM_Matrix request and
reader order. Native CPU GLMatrix reads require numeric BE32 float-bit conversion
from genuinely completed Wii bytes into original-owned storage. Console copy
and all model/material/resource decisions are unchanged.

--- a/src/NL/gl/glLoadModel.cpp
+++ b/src/NL/gl/glLoadModel.cpp
@@ -13,6 +13,7 @@
 #include <string.h>
 #if defined(MSCHARGED_NATIVE)
 #include "platform/rlg_record_abi.h"
+#include "platform/rlg_geometry_bytes.h"
 #include "platform/rlg_material_parameters.h"
 #include "platform/game_allocation_ownership.h"
 #include <stdint.h>
@@ -143,7 +144,11 @@
 {
     size &= ~0x3F;
     m_pMatrices = glResourceAlloc(size, GLM_Matrix, m_pResource);
+#if defined(MSCHARGED_NATIVE)
+    mscharged::platform::CopyRLGNativeMatrices(m_pMatrices, data, size);
+#else
     memcpy(m_pMatrices, data, size);
+#endif
 }
 
 void RLGReader::RegisterModels()
