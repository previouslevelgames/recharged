+++ b/src/NL/gl/glMaterialParameterArray.cpp
@@ -0,0 +1,50 @@
+// Selected original array lookup/copy from glMaterialParameters.cpp.
+#include "NL/gl/glMaterialParameters.h"
+#include "NL/gl/glMaterialProgram.h"
+#include <string.h>
+#include <stdexcept>
+
+namespace
+{
+inline const GXMaterialParameter* FindParameter(
+    const glModelPacket* packet, unsigned long hash)
+{
+    GLMaterialProgram* program = (GLMaterialProgram*)packet->materialProgram;
+    unsigned long count = program->parameterCount;
+    const GXMaterialParameter* parameter = program->GetParameters();
+
+    for (unsigned long i = 0; i < count; ++i, ++parameter)
+    {
+        if (hash == parameter->hash)
+        {
+            return parameter;
+        }
+    }
+
+    return 0;
+}
+
+inline unsigned char* GetParameterData(
+    const glModelPacket* packet, const GXMaterialParameter* parameter)
+{
+    return (unsigned char*)packet->materialParameters + parameter->offset;
+}
+} // namespace
+
+void glSetMaterialParameterArray(glModelPacket* packet, unsigned long hash,
+    const void* value, unsigned long count)
+{
+    if (!packet || !packet->materialProgram || !packet->materialParameters || !value || hash > 0xffffffffUL)
+        throw std::invalid_argument("Invalid native material array arguments");
+    GLMaterialProgram* program = static_cast<GLMaterialProgram*>(packet->materialProgram);
+    const GXMaterialParameter* parameter = FindParameter(packet, hash);
+    // This subset qualifies the original four-float scissorbox, not pointers
+    // or other serialized material parameter kinds.
+    if (!parameter || program->programHash != 0x0027BCF6 || hash != 0xE745DE0E
+        || parameter->metadata != 0x01040181 || count != 4
+        || parameter->offset > program->parameterDataSize
+        || 16 > program->parameterDataSize - parameter->offset)
+        throw std::invalid_argument("Unsupported native material array descriptor");
+    memcpy(GetParameterData(packet, parameter), value,
+        count * sizeof(u32));
+}
