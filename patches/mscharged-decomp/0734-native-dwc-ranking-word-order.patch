From: mscharged-port
Subject: Keep DWC ranking words in their little-endian wire order natively
Upstream-base: a353c8f2dfb34eb08fecd725965a46ea629428e3
Classification: native byte-order compatibility

The DWC ranking protocol carries little-endian words, the DS's order, and
the Wii's ranking and encrypted session units byte-swap every header and
result word with DWCi_RankingByteSwap32. On a little-endian host that
swap turned the request headers big-endian and the server's replies
unreadable: the get2.asp reply's mode 1 became 0x01000000, which
DWCi_RankingSessionVaridateResponse rejects, so the game reported that it
could not get its stats.

Natively the swap keeps each word as it is; a static assertion limits
that to little-endian hosts, as the native save transport does.

diff --git a/src/RVL_SDK/dwc/dwc_encsession.c b/src/RVL_SDK/dwc/dwc_encsession.c
index 65b7601..47b6f24 100644
--- a/src/RVL_SDK/dwc/dwc_encsession.c
+++ b/src/RVL_SDK/dwc/dwc_encsession.c
@@ -48,9 +48,17 @@ static struct
 #endif
 } g_session = { DWCi_ENC_SESSION_STATE_INITIAL };
 
+#if defined(MSCHARGED_NATIVE)
+// The ranking protocol's words are little-endian, the DS's order, which the
+// Wii swaps into; native hosts are little-endian and keep them as they are.
+#define DWCi_RankingByteSwap32(value) ((u32)(value))
+_Static_assert(__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__,
+    "Ranking words keep their little-endian wire order on little-endian hosts only");
+#else
 #define DWCi_RankingByteSwap32(value) \
     ((((u32)(value) << 24) & 0xFF000000) | (((u32)(value) << 8) & 0x00FF0000) \
         | (((u32)(value) >> 8) & 0x0000FF00) | (((u32)(value) >> 24) & 0x000000FF))
+#endif
 
 #if defined(VERSION_R4QK01)
 #define DWCi_ENC_HASH_LENGTH (sizeof(g_session.cachedHash) - 1)
diff --git a/src/RVL_SDK/dwc/dwc_ranksession.c b/src/RVL_SDK/dwc/dwc_ranksession.c
index edfb8c2..2d4472b 100644
--- a/src/RVL_SDK/dwc/dwc_ranksession.c
+++ b/src/RVL_SDK/dwc/dwc_ranksession.c
@@ -23,9 +23,17 @@ typedef struct
 
 static BOOL DWCi_RankingSessionVaridateResponse(u32* buf, int len);
 
+#if defined(MSCHARGED_NATIVE)
+// The ranking protocol's words are little-endian, the DS's order, which the
+// Wii swaps into; native hosts are little-endian and keep them as they are.
+#define DWCi_RankingByteSwap32(value) ((u32)(value))
+_Static_assert(__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__,
+    "Ranking words keep their little-endian wire order on little-endian hosts only");
+#else
 #define DWCi_RankingByteSwap32(value) \
     ((((u32)(value) << 24) & 0xFF000000) | (((u32)(value) << 8) & 0x00FF0000) \
         | (((u32)(value) >> 8) & 0x0000FF00) | (((u32)(value) >> 24) & 0x000000FF))
+#endif
 
 void DWCi_RankingSessionInitialize(BOOL releaseserver, const char* initdata)
 {
