@@ -0,0 +1,41 @@
+#ifndef GAME_DB_SAVE_STATE_STEPS_H
+#define GAME_DB_SAVE_STATE_STEPS_H
+// Selected UserOptions/SaveLoad statements. These do not implement NAND, a
+// save serializer, UI error decisions, or completion of a normal game save.
+template<class Audio> inline void SaveAudioDefaults(Audio& a)
+{
+    a.MusicVolume = 10;
+    a.SFXVolume = 10;
+    a.VoiceVolume = 10;
+    a.DefaultMusicVolume = 10;
+    a.DefaultSFXVolume = 10;
+    a.DefaultVoiceVolume = 10;
+}
+template<class Visual> inline void SaveVisualDefaults(Visual& v)
+{
+    v.mIsAutoZoomCamera = true;
+    v.mCameraZoomLevel = 0.5f;
+}
+const bool SaveStateInitiallyEnabled = true;
+template<class Pending> inline bool SaveStateCanStart(bool enabled, Pending pending) { return enabled && !pending(); }
+template<class Pending> inline bool SaveStateCanLoad(bool enabled, bool loaded, Pending pending)
+{
+    return enabled && !loaded && !pending();
+}
+inline void SaveStateDirectory(unsigned int mode, unsigned int& bannerMode, bool& inOperation)
+{
+    bannerMode = mode;
+    inOperation = true;
+}
+inline void SaveStateCancel(bool& resetPaused, bool& enabled, bool& inOperation)
+{
+    resetPaused = false;
+    enabled = false;
+    inOperation = false;
+}
+inline void SaveStateFinish(bool& inOperation) { inOperation = false; }
+inline bool SaveStateDepartureBlocked(bool enabled, bool inOperation)
+{
+    return enabled && inOperation;
+}
+#endif
