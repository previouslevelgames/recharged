diff --git a/include/Game/FE/FrontendImageState.h b/include/Game/FE/FrontendImageState.h
new file mode 100644
--- /dev/null
+++ b/include/Game/FE/FrontendImageState.h
@@ -0,0 +1,19 @@
+#ifndef GAME_FE_FRONTEND_IMAGE_STATE_H
+#define GAME_FE_FRONTEND_IMAGE_STATE_H
+#include "NL/gl/glState.h"
+
+// Original FERender::RenderImageInstance state, shared by ordinary native images.
+// Dynamic movie/grab producers remain separate services, never placeholders.
+inline void FrontendImageRasterState(bool ordinary, unsigned long blend)
+{
+    glSetDefaultState(false);
+    glSetRasterState(GLS_Culling, 0);
+    if (ordinary)
+    {
+        glSetRasterState(GLS_AlphaBlend, blend);
+        glSetRasterState(GLS_AlphaTest, 1);
+        glSetRasterState(GLS_AlphaTestRef, 0);
+    }
+    glSetCurrentRasterState(glHandleizeRasterState());
+}
+#endif
