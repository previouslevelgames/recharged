Subject: Preserve original HOME GUI member offsets on native hosts
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Use the actual native link-member offsets in the two original GUI list
initializers. Preserve their u16 offset contract, source algorithms and console
literal8 calls. No GUI owner, state or readiness is supplied.

diff --git a/libs/RVL_SDK/include/revolution/hbm/homebutton/HBMGUIManager.hpp b/libs/RVL_SDK/include/revolution/hbm/homebutton/HBMGUIManager.hpp
index 8701f85..02c6c5a 100644
--- a/libs/RVL_SDK/include/revolution/hbm/homebutton/HBMGUIManager.hpp
+++ b/libs/RVL_SDK/include/revolution/hbm/homebutton/HBMGUIManager.hpp
@@ -2,6 +2,9 @@
 #define HOMEBUTTON_GUI_MANAGER_H
 
 #include "decomp.h"
+#if defined(MSCHARGED_NATIVE)
+#include <cstddef>
+#endif
 #include "revolution/hbm/nw4hbm/lyt/pane.h"
 #include "revolution/hbm/nw4hbm/ut/list.h"
 #include "revolution/kpad/KPAD.h"
@@ -128,7 +131,12 @@ public:
             mpEventHandler->setManager(this);
         }
 
+#if defined(MSCHARGED_NATIVE)
+        static_assert(offsetof(IDToComponent, mLink) <= 0xffff);
+        nw4hbm::ut::List_Init(&mIDToComponent, static_cast<u16>(offsetof(IDToComponent, mLink)));
+#else
         nw4hbm::ut::List_Init(&mIDToComponent, 8);
+#endif
     }
 
     /* 0x0C */ virtual void init();
@@ -184,7 +192,12 @@ public:
     PaneManager(EventHandler* pEventHandler, const nw4hbm::lyt::DrawInfo* pDrawInfo, MEMAllocator* pAllocator) :
         Manager(pEventHandler, pAllocator),
         mpDrawInfo(pDrawInfo) {
+#if defined(MSCHARGED_NATIVE)
+        static_assert(offsetof(PaneToComponent, mLink) <= 0xffff);
+        nw4hbm::ut::List_Init(&mPaneToComponent, static_cast<u16>(offsetof(PaneToComponent, mLink)));
+#else
         nw4hbm::ut::List_Init(&mPaneToComponent, 8);
+#endif
     }
 
     /* 0x1C */ virtual ~PaneManager();
