From: mscharged-port
Subject: [PATCH] Adapt original audio bank serialized records and rebasing to native ABI
Upstream-base: 11c0bc65ad2ec21431c5d74f1ac4cbc1e3e2e2c3

Original chunk traversal, list order, group assignment and load-owner creation
remain authoritative. Native data views preserve Wii24/20/24/8-byte records
while real C++ storage uses48/32/40/16. Saved origins are relocation words, not
live memory or device addresses. Normal AX/effect/resource loading remains held.

diff --git a/src/Game/Audio/AudioBankTable.cpp b/src/Game/Audio/AudioBankTable.cpp
--- a/src/Game/Audio/AudioBankTable.cpp
+++ b/src/Game/Audio/AudioBankTable.cpp
@@ -4,32 +4,66 @@
 
 #include "NL/nlChunk.h"
 #include "NL/nlMemory.h"
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+#include "platform/native_audio_bank.h"
+#endif
 
 AudioBankTable* AudioBankTable::ParseChunk(nlChunk* chunk)
 {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    const auto nativeView = mscharged::platform::PrepareNativeAudioBankChunk(chunk);
+#endif
     u32 groupIndex;
     nlChunk* current = chunk->GetFirstChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    AudioBankTable* table = (AudioBankTable*)mscharged::platform::NativeAudioBankData(nativeView, current);
+#else
     AudioBankTable* table = (AudioBankTable*)current->GetData();
+#endif
     AudioResourceSource* oldRecords = table->records_0C;
 
     current = current->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    table->records_04 = (AudioBankGroup*)mscharged::platform::NativeAudioBankData(nativeView, current);
+#else
     table->records_04 = (AudioBankGroup*)current->GetData();
+#endif
     for (groupIndex = 0; groupIndex < table->count_00; ++groupIndex)
     {
         current = current->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+        table->records_04[groupIndex].records_0C = (AudioResourceSource**)mscharged::platform::NativeAudioBankData(nativeView, current);
+#else
         table->records_04[groupIndex].records_0C = (AudioResourceSource**)current->GetData();
+#endif
     }
 
     current = current->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    table->records_0C = (AudioResourceSource*)mscharged::platform::NativeAudioBankData(nativeView, current);
+#else
     table->records_0C = (AudioResourceSource*)current->GetData();
+#endif
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    const auto delta = mscharged::platform::NativeAudioBankDelta(nativeView, oldRecords, table->records_0C, table->count_08);
+#else
     s32 delta = (u8*)oldRecords - (u8*)table->records_0C;
+#endif
 
     current = current->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    table->records_14 = (AudioResourceName*)mscharged::platform::NativeAudioBankData(nativeView, current);
+#else
     table->records_14 = (AudioResourceName*)current->GetData();
+#endif
     for (u32 i = 0; i < table->count_10; ++i)
     {
         current = current->GetNextChunk();
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+        table->records_14[i].name = (const char*)mscharged::platform::NativeAudioBankData(nativeView, current);
+#else
         table->records_14[i].name = (const char*)current->GetData();
+#endif
     }
 
     for (u32 i = 0; i < table->count_00; ++i)
@@ -37,7 +71,11 @@
         AudioBankGroup* group = &table->records_04[i];
         for (u32 j = 0; j < group->count_08; ++j)
         {
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+            group->records_0C[j] = mscharged::platform::RelocateNativeAudioBankRecord(group->records_0C[j], delta);
+#else
             group->records_0C[j] = (AudioResourceSource*)((u8*)group->records_0C[j] - delta);
+#endif
             group->records_0C[j]->field_0C = group;
         }
     }
