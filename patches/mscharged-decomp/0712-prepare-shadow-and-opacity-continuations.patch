@@ -370,15 +376,19 @@ void glxCollectCharacterDamagePipelineVariants(const glModelPacket& packet)
             GXSetTevKAlphaSel(GX_TEVSTAGE0, glxAutomaticInheritedAlphaSelector(inheritedAlpha));
         if (shadow != 0)
             glxConfigureProjectedShadowPipeline(true, shadow == 3, shadow == 2);
-        EmitAutomaticSkinnedMaterialPipeline(packet);
+        EmitAutomaticSkinnedMaterialPipeline(drawPacket);
         if (enabled)
         {
+            gxSaveZMode();
             const bool colourUpdate = gxSetColourUpdate(false);
-            EmitAutomaticSkinnedMaterialPipeline(packet);
+            EmitAutomaticSkinnedMaterialPipeline(drawPacket);
             gxSetColourUpdate(colourUpdate);
             gxSetZMode(true, GX_EQUAL, true);
             glxConfigureMaterialOpacityColourPass(1);
-            EmitAutomaticSkinnedMaterialPipeline(packet);
+            EmitAutomaticSkinnedMaterialPipeline(drawPacket);
+            glxCollectRetainedOpacityPipelineStates(true, [&] {
+                EmitAutomaticSkinnedMaterialPipeline(drawPacket);
+            });
         }
     }
 }
