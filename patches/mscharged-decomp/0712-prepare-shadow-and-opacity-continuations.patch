diff --git a/include/NL/glx/GXPipelinePreparation.h b/include/NL/glx/GXPipelinePreparation.h
index e1e9b50..56381be 100644
--- a/include/NL/glx/GXPipelinePreparation.h
+++ b/include/NL/glx/GXPipelinePreparation.h
@@ -26,3 +26,22 @@ inline void glxConfigureMaterialOpacityColourPass(int stage)
     GXSetTevKAlphaSel(static_cast<GXTevStageID>(stage), GX_TEV_KASEL_K1_A);
     gxSetTevAlphaIn(stage, 7, 7, 7, 6);
 }
+
+#if defined(MSCHARGED_AUTOMATIC_PREWARM)
+template <typename Emit>
+inline void glxCollectRetainedOpacityPipelineStates(bool depthPrepass, Emit emit)
+{
+    // Draw restores blend/depth after its opacity colour pass, but leaves the
+    // stage's K1_A alpha input. A following packet of the same material can use
+    // that retained input in its ordinary draw or its next alpha depth prepass.
+    gxRestoreBlendMode();
+    gxRestoreZMode();
+    emit();
+    if (depthPrepass)
+    {
+        const bool colourUpdate = gxSetColourUpdate(false);
+        emit();
+        gxSetColourUpdate(colourUpdate);
+    }
+}
+#endif
