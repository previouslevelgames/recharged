 #if defined(MSCHARGED_AUTOMATIC_PREWARM)
+namespace {
+struct AutomaticPlanarShadowVisitor
+{
+    void Visit(const unsigned long&, DrawableObject** value)
+    {
+        const DrawableObject* drawable = value ? *value : 0;
+        // PlanarShadowDrawable::Initialize owns this exact source object type.
+        // Its shadow path, DrawablePowerup and DrawableHammer all duplicate
+        // this model before calling DrawPlanarShadow. Do not enumerate every
+        // world/character/UI model as though it could take that path.
+        if (drawable != 0 && drawable->m_uObjectType == 0x1000D && drawable->m_pModel != 0)
+            mscharged::platform::EnumerateAutomaticPlanarShadowModelPipelines(*drawable->m_pModel);
+    }
+};
+}
+
+void mscharged::platform::EnumerateAutomaticPlanarShadowResources()
+{
+    if (pBasicStadiumInstance == 0) return;
+    AutomaticPlanarShadowVisitor visitor;
+    pBasicStadiumInstance->m_registeredDrawables.Walk(&visitor, &AutomaticPlanarShadowVisitor::Visit);
+    pBasicStadiumInstance->m_drawableMap.Walk(&visitor, &AutomaticPlanarShadowVisitor::Visit);
+}
+
 void mscharged::platform::EnumerateAutomaticNumberResources()
 {
     // Invoked only by the completed match-resource census, before gameplay.
