+#ifndef MSCHARGED_NATIVE
 void operator delete(void* ptr)
 {
     FreeMemory(ptr);
@@ -56,6 +80,8 @@ void* operator new[](unsigned long size)
     return AllocateMemory(size, 8, false);
 }
 
+#endif
+
 void* nlMalloc(unsigned long size)
