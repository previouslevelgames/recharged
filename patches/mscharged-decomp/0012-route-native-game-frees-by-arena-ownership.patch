Subject: Route explicit native game frees to their exact recorded allocator
Upstream-base: 11c0bc65ad2ec21431c5d74f1ac4cbc1e3e2e2c3

Replace Wii address-nibble routing with exact live native allocation ownership.
Parent/custom heaps can overlap; their original allocator remains the owner after
its stack entry is popped. The native records are maintained by the original
allocator interfaces in patch0155. Host SDK/CRT global operators remain standard;
ordinary game-TU bindings and production platform setup before game constructors
remain separate integration gates. The source lazy nlInitMemory call is retained.

diff --git a/src/NL/nlMemory.cpp b/src/NL/nlMemory.cpp
--- a/src/NL/nlMemory.cpp
+++ b/src/NL/nlMemory.cpp
@@ -1,6 +1,9 @@
 #include "NL/nlMemory.h"
 
 #include "NL/MemAlloc.h"
+#ifdef MSCHARGED_NATIVE
+#include "platform/game_allocation_ownership.h"
+#endif
 
 MemoryAllocator VirtualAllocator;
 MemoryAllocator* AllocatorStack[16] = { &StandardAllocator };
@@ -10,6 +13,9 @@
 
 static inline void FreeMemory(void* ptr)
 {
+#ifdef MSCHARGED_NATIVE
+    mscharged::platform::FreeGameAllocation(ptr);
+#else
     if (CurrentAllocator != &StandardAllocator && CurrentAllocator != &VirtualAllocator)
     {
         CurrentAllocator->Free(ptr);
@@ -25,6 +31,7 @@
     {
         VirtualAllocator.Free(ptr);
     }
+#endif
 }
 
 static inline void* AllocateMemory(unsigned long size, unsigned int alignment, bool fromEnd)
@@ -36,6 +43,9 @@
     return CurrentAllocator->Allocate(size, alignment, fromEnd);
 }
 
+// Host libraries keep standard global new/delete. Game-specific allocation
+// remains explicit through nlMalloc and the alignment/from-end overloads.
+#ifndef MSCHARGED_NATIVE
 void operator delete(void* ptr)
 {
     FreeMemory(ptr);
@@ -56,6 +66,8 @@
     return AllocateMemory(size, 8, false);
 }
 
+#endif
+
 void* nlMalloc(unsigned long size)
 {
     return AllocateMemory(size, 8, false);
