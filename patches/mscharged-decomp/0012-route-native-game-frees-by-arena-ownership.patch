Subject: Route explicit native game allocations by owned arena

Upstream-base: 2c71062ca827c5d2115ab76f4da80aaa8c515ff8

Compile the original nlMalloc/nlFree layer with allocator ownership checks instead
of console address-nibble tests. Host global new/delete remain standard so SDL,
Aurora, and C++ startup do not recursively enter an uninitialized game heap.
Game-specific ordinary new/class operators and popped custom allocator ownership
are still an integration gate; only explicit game allocation is connected here.

diff --git a/src/NL/nlMemory.cpp b/src/NL/nlMemory.cpp
index 0435be1..32fb999 100644
--- a/src/NL/nlMemory.cpp
+++ b/src/NL/nlMemory.cpp
@@ -1,6 +1,16 @@
 #include "NL/nlMemory.h"
 
 #include "NL/MemAlloc.h"
+#ifdef MSCHARGED_NATIVE
+#include <stdint.h>
+#include <stdexcept>
+static bool OwnsRegion(const MemoryAllocator& allocator, const void* pointer)
+{
+    const uintptr_t base = (uintptr_t)allocator.m_memory;
+    const uintptr_t address = (uintptr_t)pointer;
+    return base != 0 && address >= base && address - base < allocator.m_memory_size;
+}
+#endif
 
 MemoryAllocator VirtualAllocator;
 MemoryAllocator* AllocatorStack[16] = { &StandardAllocator };
@@ -10,6 +20,16 @@ u8 gMemoryInitialized;
 
 static inline void FreeMemory(void* ptr)
 {
+#ifdef MSCHARGED_NATIVE
+    if (ptr == 0) return;
+    // Ownership, not the currently selected allocator, decides where to free.
+    if (OwnsRegion(StandardAllocator, ptr)) { StandardAllocator.Free(ptr); return; }
+    if (OwnsRegion(VirtualAllocator, ptr)) { VirtualAllocator.Free(ptr); return; }
+    if (CurrentAllocator && OwnsRegion(*CurrentAllocator, ptr)) { CurrentAllocator->Free(ptr); return; }
+    for (unsigned int i = 0; i < AllocatorStackDepth && i < 16; ++i)
+        if (AllocatorStack[i] && OwnsRegion(*AllocatorStack[i], ptr)) { AllocatorStack[i]->Free(ptr); return; }
+    throw std::invalid_argument("nlFree pointer has no registered game allocator owner");
+#else
     if (CurrentAllocator != &StandardAllocator && CurrentAllocator != &VirtualAllocator)
     {
         CurrentAllocator->Free(ptr);
@@ -25,6 +45,7 @@ static inline void FreeMemory(void* ptr)
     {
         VirtualAllocator.Free(ptr);
     }
+#endif
 }
 
 static inline void* AllocateMemory(unsigned long size, unsigned int alignment, bool fromEnd)
@@ -36,6 +57,9 @@ static inline void* AllocateMemory(unsigned long size, unsigned int alignment, b
     return CurrentAllocator->Allocate(size, alignment, fromEnd);
 }
 
+// Host libraries keep standard global new/delete. Game-specific allocation
