diff --git a/src/s3_hid.c b/src/s3_hid.c
new file mode 100644
index 0000000..3f1dd28
--- /dev/null
+++ b/src/s3_hid.c
@@ -0,0 +1,219 @@
+// SDL3's HID API: SDL2's on most platforms; the Switch has no HID devices to reach.
+
+#include "s3_internal.h"
+
+#ifdef __SWITCH__
+
+static void S3_HidUnsupported(void)
+{
+    SDL_SetError("HID devices are not supported by sdl3on2 on Switch");
+}
+
+int S3_hid_init(void)
+{
+    S3_HidUnsupported();
+    return -1;
+}
+
+int S3_hid_exit(void)
+{
+    return 0;
+}
+
+Uint32 S3_hid_device_change_count(void)
+{
+    return 0;
+}
+
+S3_hid_device_info* S3_hid_enumerate(unsigned short vendor_id, unsigned short product_id)
+{
+    (void)vendor_id;
+    (void)product_id;
+
+    S3_HidUnsupported();
+
+    return NULL;
+}
+
+void S3_hid_free_enumeration(S3_hid_device_info* devs)
+{
+    (void)devs;
+}
+
+S3_hid_device* S3_hid_open_path(const char* path)
+{
+    (void)path;
+
+    S3_HidUnsupported();
+
+    return NULL;
+}
+
+// No device ever opens, so every handle is invalid.
+static int S3_HidInvalidDevice(void)
+{
+    SDL_SetError("Invalid device");
+    return -1;
+}
+
+int S3_hid_write(S3_hid_device* dev, const unsigned char* data, size_t length)
+{
+    (void)dev;
+    (void)data;
+    (void)length;
+
+    return S3_HidInvalidDevice();
+}
+
+int S3_hid_read_timeout(S3_hid_device* dev, unsigned char* data, size_t length, int milliseconds)
+{
+    (void)dev;
+    (void)data;
+    (void)length;
+    (void)milliseconds;
+
+    return S3_HidInvalidDevice();
+}
+
+int S3_hid_set_nonblocking(S3_hid_device* dev, int nonblock)
+{
+    (void)dev;
+    (void)nonblock;
+
+    return S3_HidInvalidDevice();
+}
+
+int S3_hid_close(S3_hid_device* dev)
+{
+    (void)dev;
+
+    return S3_HidInvalidDevice();
+}
+
+#else
+
+// SDL3's list is SDL2's with a bus type added, so it is copied; the strings stay SDL2's.
+typedef struct S3_HidEnumeration {
+    SDL_hid_device_info* native;
+} S3_HidEnumeration;
+
+static SDL_hid_device* S3_UnwrapHid(S3_hid_device* dev)
+{
+    return (SDL_hid_device*)dev;
+}
+
+int S3_hid_init(void)
+{
+    return SDL_hid_init();
+}
+
+int S3_hid_exit(void)
+{
+    return SDL_hid_exit();
+}
+
+Uint32 S3_hid_device_change_count(void)
+{
+    return SDL_hid_device_change_count();
+}
+
+S3_hid_device_info* S3_hid_enumerate(unsigned short vendor_id, unsigned short product_id)
+{
+    SDL_hid_device_info* native = SDL_hid_enumerate(vendor_id, product_id);
+    const SDL_hid_device_info* device;
+    S3_HidEnumeration* list;
+    S3_hid_device_info* copies;
+    size_t count = 0;
+    size_t index = 0;
+
+    for (device = native; device != NULL; device = device->next) {
+        count++;
+    }
+
+    // SDL3 answers an empty enumeration with NULL as well.
+    if (count == 0) {
+        SDL_hid_free_enumeration(native);
+        return NULL;
+    }
+
+    list = (S3_HidEnumeration*)SDL_malloc(sizeof(*list) + sizeof(*copies) * count);
+    if (list == NULL) {
+        SDL_hid_free_enumeration(native);
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    copies = (S3_hid_device_info*)(list + 1);
+    list->native = native;
+
+    for (device = native; device != NULL; device = device->next, index++) {
+        S3_hid_device_info* copy = &copies[index];
+
+        copy->path = device->path;
+        copy->vendor_id = device->vendor_id;
+        copy->product_id = device->product_id;
+        copy->serial_number = device->serial_number;
+        copy->release_number = device->release_number;
+        copy->manufacturer_string = device->manufacturer_string;
+        copy->product_string = device->product_string;
+        copy->usage_page = device->usage_page;
+        copy->usage = device->usage;
+        copy->interface_number = device->interface_number;
+        copy->interface_class = device->interface_class;
+        copy->interface_subclass = device->interface_subclass;
+        copy->interface_protocol = device->interface_protocol;
+        // SDL2 does not say how a device is connected.
+        copy->bus_type = S3_HID_API_BUS_UNKNOWN;
+        copy->next = index + 1 < count ? &copies[index + 1] : NULL;
+    }
+
+    return copies;
+}
+
+void S3_hid_free_enumeration(S3_hid_device_info* devs)
+{
+    S3_HidEnumeration* list;
+
+    if (devs == NULL) {
+        return;
+    }
+
+    list = (S3_HidEnumeration*)devs - 1;
+    SDL_hid_free_enumeration(list->native);
+    SDL_free(list);
+}
+
+S3_hid_device* S3_hid_open_path(const char* path)
+{
+    return (S3_hid_device*)SDL_hid_open_path(path, 0);
+}
+
+int S3_hid_write(S3_hid_device* dev, const unsigned char* data, size_t length)
+{
+    return SDL_hid_write(S3_UnwrapHid(dev), data, length);
+}
+
+int S3_hid_read_timeout(S3_hid_device* dev, unsigned char* data, size_t length, int milliseconds)
+{
+    return SDL_hid_read_timeout(S3_UnwrapHid(dev), data, length, milliseconds);
+}
+
+int S3_hid_set_nonblocking(S3_hid_device* dev, int nonblock)
+{
+    return SDL_hid_set_nonblocking(S3_UnwrapHid(dev), nonblock);
+}
+
+int S3_hid_close(S3_hid_device* dev)
+{
+    if (dev == NULL) {
+        SDL_SetError("Invalid device");
+        return -1;
+    }
+
+    // SDL2's close returns nothing; SDL3's returns 0 for a valid device.
+    SDL_hid_close(S3_UnwrapHid(dev));
+
+    return 0;
+}
+
+#endif
