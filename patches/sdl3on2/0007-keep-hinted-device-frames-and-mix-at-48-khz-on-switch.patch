+
+// The frame count SDL3's hint asks of a device, or 0; SDL2 reads the hint from the environment too.
+static int S3_HintedSampleFrames(void)
+{
+    const char* hint = SDL_GetHint(S3_HINT_AUDIO_DEVICE_SAMPLE_FRAMES);
+    const int frames = hint != NULL ? SDL_atoi(hint) : 0;
+
+    // SDL2 counts a device's frames in 16 bits.
+    return frames > 0 ? SDL_min(frames, 65535) : 0;
+}
