+// SDL3 returns one allocation: the NULL-terminated pointer array, the locales, then their strings.
+static S3_Locale** S3_CopyLocales(const char* const* languages, const char* const* countries, int count)
+{
+    S3_Locale** result;
+    S3_Locale* locales;
+    char* text;
+    size_t size = sizeof(S3_Locale*) * ((size_t)count + 1) + sizeof(S3_Locale) * (size_t)count;
+    int index;
+
+    for (index = 0; index < count; index++) {
+        size += SDL_strlen(languages[index]) + 1 + (countries[index] != NULL ? SDL_strlen(countries[index]) + 1 : 0);
+    }
+
+    result = (S3_Locale**)SDL_malloc(size);
+    if (result == NULL) {
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    locales = (S3_Locale*)(result + count + 1);
+    text = (char*)(locales + count);
+
+    for (index = 0; index < count; index++) {
+        size_t length = SDL_strlen(languages[index]) + 1;
+
+        SDL_memcpy(text, languages[index], length);
+        locales[index].language = text;
+        text += length;
+
+        locales[index].country = NULL;
+        if (countries[index] != NULL) {
+            length = SDL_strlen(countries[index]) + 1;
+            SDL_memcpy(text, countries[index], length);
+            locales[index].country = text;
+            text += length;
+        }
+
+        result[index] = &locales[index];
+    }
+    result[count] = NULL;
+
+    return result;
+}
+
+S3_Locale** S3_GetPreferredLocales(int* count)
+{
+    const char* languages[32];
+    const char* countries[32];
+    SDL_Locale* native;
+    S3_Locale** result;
+    int total = 0;
+
+    if (count != NULL) {
+        *count = 0;
+    }
+
+#ifdef __SWITCH__
+    // SDL2's Switch build only knows the hint; otherwise the console's language is the one.
+    if (SDL_GetHint(SDL_HINT_PREFERRED_LOCALES) == NULL) {
+        char language[16];
+        char* country;
+
+        if (!S3_SwitchSystemLanguage(language, sizeof(language))) {
+            return NULL;
+        }
+
+        // A code such as "en-US" splits at its dash, as SDL3 splits "en_US".
+        country = SDL_strchr(language, '-');
+        if (country != NULL) {
+            *country++ = '\0';
+        }
+
+        languages[0] = language;
+        countries[0] = country != NULL && *country != '\0' ? country : NULL;
+        result = S3_CopyLocales(languages, countries, 1);
+        if (result != NULL && count != NULL) {
+            *count = 1;
+        }
+        return result;
+    }
+#endif
+
+    native = SDL_GetPreferredLocales();
+    if (native == NULL) {
+        return NULL;
+    }
+
+    while (native[total].language != NULL && total < (int)SDL_arraysize(languages)) {
+        languages[total] = native[total].language;
+        countries[total] = native[total].country;
+        total++;
+    }
+
+    // SDL3 reports no locales as NULL.
+    result = total > 0 ? S3_CopyLocales(languages, countries, total) : NULL;
+    SDL_free(native);
+
+    if (result != NULL && count != NULL) {
+        *count = total;
+    }
+
+    return result;
+}
