+    elapsed = SDL_GetPerformanceCounter() - s3_ticks_counter;
+
+    return s3_ticks_start_ns + elapsed / s3_ticks_frequency * UINT64_C(1000000000)
+        + elapsed % s3_ticks_frequency * UINT64_C(1000000000) / s3_ticks_frequency;
