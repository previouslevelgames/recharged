+    // refuses. So the queue is copied first and put back through the new filter.
+    count = SDL_PeepEvents(NULL, 0, SDL_PEEKEVENT, SDL_FIRSTEVENT, SDL_LASTEVENT);
+    if (count > 0) {
+        queued = (SDL_Event*)SDL_malloc(sizeof(*queued) * (size_t)count);
+        count = queued != NULL ? SDL_PeepEvents(queued, count, SDL_PEEKEVENT, SDL_FIRSTEVENT, SDL_LASTEVENT) : 0;
+    }
+
+    SDL_AtomicLock(&s3_event_filter_lock);
+    s3_event_filter = filter;
+    s3_event_filter_userdata = userdata;
+    SDL_AtomicUnlock(&s3_event_filter_lock);
+
+    SDL_SetEventFilter(filter != NULL ? S3_EventFilterTrampoline : NULL, NULL);
+
+    for (index = 0; index < count; index++) {
+        if (filter == NULL || S3_EventFilterTrampoline(NULL, &queued[index])) {
+            // SDL2 adds peeped-back events without filtering or watching them again.
+            SDL_PeepEvents(&queued[index], 1, SDL_ADDEVENT, SDL_FIRSTEVENT, SDL_LASTEVENT);
+        }
