+// Runs before SDL2 queues an event and before its watches, as SDL3's filter does.
+static int SDLCALL S3_EventFilterTrampoline(void* userdata, SDL_Event* native)
+{
+    char text[S3_TEXT_ARENA_ENTRY_SIZE];
+    S3_EventFilter filter;
+    void* filter_userdata;
+    S3_Event event;
+
+    (void)userdata;
+
+    // Events SDL3 has no counterpart for cannot be shown to the filter, so they pass.
+    if (!S3_CurrentEventFilter(&filter, &filter_userdata) || !S3_TranslateEvent(native, &event, text, sizeof(text))) {
+        return 1;
+    }
