+void S3_DelayPrecise(Uint64 ns)
+{
+    const Uint64 short_sleep = UINT64_C(1000000);
+    Uint64 now = S3_GetTicksNS();
+    const Uint64 target = now + ns;
+    Uint64 longest = short_sleep;
+
+    // As in SDL3: 1 ms sleeps while the longest one seen still fits, then one shorter sleep that
+    // leaves that overshoot as margin, then 1 ms sleeps again, and a spin for the rest.
+    while (now + longest < target) {
+        const Uint64 before = now;
+
+        S3_DelayNS(short_sleep);
+        now = S3_GetTicksNS();
+        if (now - before > longest) {
+            longest = now - before;
+        }
+    }
+
+    if (now < target && target - now > longest - short_sleep) {
+        S3_DelayNS(target - now - (longest - short_sleep));
+        now = S3_GetTicksNS();
+    }
+
+    while (now + short_sleep < target) {
+        S3_DelayNS(short_sleep);
+        now = S3_GetTicksNS();
+    }
+
+    while (now < target) {
+        now = S3_GetTicksNS();
+    }
