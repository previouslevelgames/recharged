+// The console's language code, such as "en-US", from the settings service.
+bool S3_SwitchSystemLanguage(char* language, size_t size)
+{
+    u64 code = 0;
+    Result rc = setInitialize();
+
+    if (R_FAILED(rc)) {
+        SDL_SetError("Could not open the settings service (0x%x)", (unsigned int)rc);
+        return false;
+    }
+
+    rc = setGetSystemLanguage(&code);
+    setExit();
+
+    if (R_FAILED(rc)) {
+        SDL_SetError("Could not read the system language (0x%x)", (unsigned int)rc);
+        return false;
+    }
+
+    // The code is its own NUL-padded string of up to eight characters.
+    SDL_memset(language, 0, size);
+    SDL_memcpy(language, &code, SDL_min(size - 1, sizeof(code)));
+
+    if (language[0] == '\0') {
+        SDL_SetError("The system language is not set");
+        return false;
+    }
+
+    return true;
+}
