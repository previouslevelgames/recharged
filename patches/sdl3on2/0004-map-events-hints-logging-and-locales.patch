+// SDL2's SIMD allocator has a fixed alignment, so the block is over-allocated as SDL3 does it:
+// the original pointer sits just before the aligned one, and the size rounds up to the alignment.
+void* S3_aligned_alloc(size_t alignment, size_t size)
+{
+    const size_t align = alignment < sizeof(void*) ? sizeof(void*) : alignment;
+    const size_t padded = size + (align - size % align) % align;
+    Uint8* original;
+    Uint8* result;
+
+    if (padded < size || padded > SIZE_MAX - align - sizeof(void*)) {
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    original = (Uint8*)SDL_malloc(padded + align + sizeof(void*));
+    if (original == NULL) {
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    result = original + sizeof(void*);
+    result += (align - (size_t)((uintptr_t)result % align)) % align;
+    SDL_memcpy(result - sizeof(void*), &original, sizeof(void*));
+    SDL_memset(result + size, 0, padded - size);
+
+    return result;
+}
+
+void S3_aligned_free(void* mem)
+{
+    void* original;
+
+    if (mem == NULL) {
+        return;
+    }
+
+    SDL_memcpy(&original, (Uint8*)mem - sizeof(void*), sizeof(void*));
+    SDL_free(original);
+}
