+static bool S3_CurrentEventFilter(S3_EventFilter* filter, void** userdata)
+{
+    SDL_AtomicLock(&s3_event_filter_lock);
+    *filter = s3_event_filter;
+    *userdata = s3_event_filter_userdata;
