+// SDL2 counts ticks in milliseconds; SDL3's nanoseconds come from the performance counter,
+// started where SDL2's ticks are so event timestamps stay comparable.
+Uint64 S3_GetTicksNS(void)
+{
+    Uint64 elapsed;
