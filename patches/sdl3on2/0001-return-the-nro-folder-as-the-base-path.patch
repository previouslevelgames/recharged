diff --git a/src/s3_io.c b/src/s3_io.c
index f871562..a5c6dec 100644
--- a/src/s3_io.c
+++ b/src/s3_io.c
@@ -860,12 +860,48 @@ bool S3_RenamePath(const char* oldpath, const char* newpath)
     return true;
 }
 
+#ifdef __SWITCH__
+// libnx keeps the arguments it was started with; the Homebrew Menu passes the .nro's path first.
+extern int __system_argc;
+extern char** __system_argv;
+
+// SDL2's Switch build has no base path, so it is the folder of the running .nro.
+static char* S3_SwitchProgramFolder(void)
+{
+    const char* program = __system_argc > 0 && __system_argv != NULL ? __system_argv[0] : NULL;
+    size_t length;
+    char* folder;
+
+    if (program == NULL || SDL_strncmp(program, "sdmc:/", 6) != 0) {
+        return NULL;
+    }
+
+    // The prefix holds a slash, so there is always one to cut at.
+    length = (size_t)(SDL_strrchr(program, '/') - program) + 1;
+    folder = (char*)SDL_malloc(length + 1);
+    if (folder == NULL) {
+        return NULL;
+    }
+
+    SDL_memcpy(folder, program, length);
+    folder[length] = '\0';
+
+    return folder;
+}
+#endif
+
 const char* S3_GetBasePath(void)
 {
     // SDL3 owns the returned string; SDL2 allocates a new one per call. Only success is cached.
     static char* base_path;
 
     if (base_path == NULL) {
+#ifdef __SWITCH__
+        base_path = S3_SwitchProgramFolder();
+        if (base_path != NULL) {
+            return base_path;
+        }
+#endif
         base_path = SDL_GetBasePath();
     }
 
