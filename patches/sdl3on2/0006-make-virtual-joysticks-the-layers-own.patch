+
+// SDL3's mapping is named after the joystick, without commas and at most 127 characters long.
+static char* S3_VirtualGamepadName(const char* name)
+{
+    char buffer[128];
+    char* spot;
+
+    SDL_strlcpy(buffer, name, sizeof(buffer));
+    for (spot = buffer; *spot != '\0'; spot++) {
+        if (*spot == ',') {
+            *spot = ' ';
+        }
+    }
+
+    return SDL_strdup(buffer);
+}
+
+// SDL3's virtual GUID: bus, name CRC, then vendor and product, or the name when there is no vendor.
+static S3_GUID S3_VirtualGUID(Uint16 vendor, Uint16 product, const char* name, Uint8 type)
+{
+    const Uint16 crc = SDL_crc16(0, name, SDL_strlen(name));
+    S3_GUID guid;
+
+    SDL_zero(guid);
+    guid.data[0] = S3_HARDWARE_BUS_VIRTUAL;
+    guid.data[2] = (Uint8)(crc & 0xFF);
+    guid.data[3] = (Uint8)(crc >> 8);
+    if (vendor != 0) {
+        guid.data[4] = (Uint8)(vendor & 0xFF);
+        guid.data[5] = (Uint8)(vendor >> 8);
+        guid.data[8] = (Uint8)(product & 0xFF);
+        guid.data[9] = (Uint8)(product >> 8);
+    } else {
+        SDL_strlcpy((char*)&guid.data[4], name, sizeof(guid.data) - 6);
+    }
+    guid.data[14] = 'v';
+    guid.data[15] = type;
+
+    return guid;
+}
+
+static Uint16 S3_VirtualVendor(S3_GUID guid)
+{
+    Uint16 vendor = 0;
+
+    S3_GetJoystickGUIDInfo(guid, &vendor, NULL, NULL, NULL);
+
+    return vendor;
+}
+
+static Uint16 S3_VirtualProduct(S3_GUID guid)
+{
+    Uint16 product = 0;
+
+    S3_GetJoystickGUIDInfo(guid, NULL, &product, NULL, NULL);
+
+    return product;
+}
+
+// SDL3's types for Nintendo's and GameCube controllers' ids; SDL3 knows other makers' ids too.
+static S3_GamepadType S3_VirtualGamepadType(S3_GUID guid, const char* name)
+{
+    static const Uint32 gamecube[] = { 0x00791843, 0x00791844, 0x00791846, 0x057E0337, 0x057E2073, 0x09268888, 0x0E6F0185, 0x1A34F705, 0x20D6A711 };
+    Uint16 vendor = 0;
+    Uint16 product = 0;
+    size_t i;
+
+    S3_GetJoystickGUIDInfo(guid, &vendor, &product, NULL, NULL);
+
+    if (vendor == 0 && product == 0) {
+        if (SDL_strcmp(name, "Lic Pro Controller") == 0 || SDL_strcmp(name, "Nintendo Wireless Gamepad") == 0 || SDL_strcmp(name, "Wireless Gamepad") == 0) {
+            return S3_GAMEPAD_TYPE_NINTENDO_SWITCH_PRO;
+        }
+        return S3_GAMEPAD_TYPE_STANDARD;
+    }
+
+    if (vendor == 0x057E) {
+        switch (product) {
+        case 0x2006:
+        case 0x2067:
+            return S3_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_LEFT;
+        case 0x2007:
+        case 0x2066:
+            return SDL_strstr(name, "NES Controller") != NULL ? S3_GAMEPAD_TYPE_STANDARD : S3_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_RIGHT;
+        case 0x200E:
+            return SDL_strstr(name, "(L)") != NULL ? S3_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_LEFT : S3_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_RIGHT;
+        case 0x2008:
+        case 0x2068:
+            return S3_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_PAIR;
+        case 0x2009:
+            return S3_GAMEPAD_TYPE_NINTENDO_SWITCH_PRO;
+        default:
+            break;
+        }
+    }
+
+    for (i = 0; i < SDL_arraysize(gamecube); i++) {
+        if (gamecube[i] == (((Uint32)vendor << 16) | product)) {
+            return S3_GAMEPAD_TYPE_GAMECUBE;
+        }
+    }
+
+    return S3_GAMEPAD_TYPE_STANDARD;
+}
+
+static void S3_VirtualFreeDevice(S3_VirtualDevice* device)
+{
+    S3_VirtualDevice** link;
+
+    // SDL3 hands the descriptor's userdata back first.
+    if (device->desc.Cleanup != NULL) {
+        device->desc.Cleanup(device->desc.userdata);
+    }
+
+    for (link = &s3_virtual_devices; *link != NULL; link = &(*link)->next) {
+        if (*link == device) {
+            *link = device->next;
+            break;
+        }
+    }
+
+    if (device->joystick != NULL) {
+        device->joystick->device = NULL;
+    }
+
+    SDL_free(device->axes);
+    SDL_free(device->buttons);
+    SDL_free(device->hats);
+    SDL_free(device->sensor_types);
+    SDL_free(device->sensor_rates);
+    SDL_free(device->sensor_events);
+    SDL_free(device);
+}
+
+static bool S3_VirtualRumble(S3_VirtualJoystick* joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    const S3_VirtualDevice* device = joystick->device;
+
+    if (device == NULL) {
+        SDL_SetError("Rumble failed, device disconnected");
+        return false;
+    }
+
+    if (device->desc.Rumble == NULL) {
+        return S3_VirtualUnsupported();
+    }
+
+    return device->desc.Rumble(device->desc.userdata, low_frequency_rumble, high_frequency_rumble);
+}
+
+static bool S3_VirtualRumbleJoystick(S3_VirtualJoystick* joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble, Uint32 duration_ms)
+{
+    bool result = true;
+
+    // The same strength only moves the expiry, as in SDL3.
+    if (low_frequency_rumble != joystick->low_frequency_rumble || high_frequency_rumble != joystick->high_frequency_rumble) {
+        result = S3_VirtualRumble(joystick, low_frequency_rumble, high_frequency_rumble);
+        joystick->rumble_resend = 0;
+        if (result) {
+            joystick->rumble_resend = SDL_GetTicks64() + S3_RUMBLE_RESEND_MS;
+        }
+    }
+
+    if (result) {
+        joystick->low_frequency_rumble = low_frequency_rumble;
+        joystick->high_frequency_rumble = high_frequency_rumble;
+
+        if ((low_frequency_rumble != 0 || high_frequency_rumble != 0) && duration_ms != 0) {
+            joystick->rumble_expiration = SDL_GetTicks64() + SDL_min(duration_ms, S3_MAX_RUMBLE_DURATION_MS);
+        } else {
+            joystick->rumble_expiration = 0;
+            joystick->rumble_resend = 0;
+        }
+    }
+
+    return result;
+}
+
+static void S3_VirtualReleaseJoystick(S3_VirtualJoystick* joystick)
+{
+    S3_VirtualJoystick** link;
+
+    if (--joystick->refcount > 0) {
+        return;
+    }
+
+    S3_ReleaseObjectProperties(joystick);
+
+    if (joystick->rumble_expiration != 0) {
+        S3_VirtualRumbleJoystick(joystick, 0, 0, 0);
+    }
+
+    if (joystick->device != NULL) {
+        joystick->device->joystick = NULL;
+        joystick->device = NULL;
+    }
+
+    for (link = &s3_virtual_joysticks; *link != NULL; link = &(*link)->next) {
+        if (*link == joystick) {
+            *link = joystick->next;
+            break;
+        }
+    }
+
+    SDL_free(joystick->axes);
+    SDL_free(joystick->buttons);
+    SDL_free(joystick->hats);
+    SDL_free(joystick->sensors);
+    SDL_free(joystick);
+}
+
+// SDL3's virtual driver update: the app's callback, then whatever changed since.
+static void S3_VirtualUpdateJoystick(S3_VirtualJoystick* joystick)
+{
+    S3_VirtualDevice* device = joystick->device;
+    int i;
+
+    if (device == NULL) {
+        return;
+    }
+
+    if (device->desc.Update != NULL) {
+        device->desc.Update(device->desc.userdata);
+    }
+
+    // A callback may have detached the device, so it is checked after each one.
+    if ((device->changes & S3_VIRTUAL_AXES_CHANGED) != 0) {
+        for (i = 0; i < device->desc.naxes && joystick->device == device; i++) {
+            S3_VirtualSendAxis(joystick, i, device->axes[i]);
+        }
+    }
+
+    if (joystick->device == device && (device->changes & S3_VIRTUAL_BUTTONS_CHANGED) != 0) {
+        for (i = 0; i < device->desc.nbuttons && joystick->device == device; i++) {
+            S3_VirtualSendButton(joystick, i, device->buttons[i]);
+        }
+    }
+
+    if (joystick->device == device && (device->changes & S3_VIRTUAL_HATS_CHANGED) != 0) {
+        for (i = 0; i < device->desc.nhats && joystick->device == device; i++) {
+            S3_VirtualSendHat(joystick, i, device->hats[i]);
+        }
+    }
+
+    if (joystick->device == device && device->num_sensor_events > 0) {
+        if (device->sensors_enabled) {
+            for (i = 0; i < device->num_sensor_events && joystick->device == device; i++) {
+                S3_VirtualSendSensor(joystick, &device->sensor_events[i]);
+            }
+        }
+        if (joystick->device == device) {
+            device->num_sensor_events = 0;
+        }
+    }
+
+    if (joystick->device == device) {
+        device->changes = 0;
+    }
+}
+
+static void S3_VirtualUpdate(void)
+{
+    S3_VirtualJoystick* local[8];
+    S3_VirtualJoystick** list = local;
+    S3_VirtualJoystick* joystick;
+    int count = 0;
+    int i;
+
+    if ((S3_WasInit(S3_INIT_JOYSTICK) & S3_INIT_JOYSTICK) == 0) {
+        return;
+    }
+
+    S3_LockJoysticks();
+
+    for (joystick = s3_virtual_joysticks; joystick != NULL; joystick = joystick->next) {
+        count++;
+    }
+
+    if (count > (int)SDL_arraysize(local)) {
+        list = (S3_VirtualJoystick**)SDL_malloc(sizeof(*list) * (size_t)count);
+        if (list == NULL) {
+            S3_UnlockJoysticks();
+            return;
+        }
+    }
+
+    // Each is held while callbacks run, so one closed meanwhile goes only afterwards.
+    count = 0;
+    for (joystick = s3_virtual_joysticks; joystick != NULL; joystick = joystick->next) {
+        joystick->refcount++;
+        list[count++] = joystick;
+    }
+
+    for (i = 0; i < count; i++) {
+        Uint64 now;
+
+        joystick = list[i];
+        if (!joystick->attached) {
+            continue;
+        }
+
+        S3_VirtualUpdateJoystick(joystick);
+
+        if (joystick->delayed_guide_button && joystick->gamepad != NULL) {
+            S3_VirtualSendGamepadButton(joystick->gamepad, S3_GAMEPAD_BUTTON_GUIDE, false);
+        }
+
+        now = SDL_GetTicks64();
+        if (joystick->rumble_expiration != 0 && now >= joystick->rumble_expiration) {
+            S3_VirtualRumbleJoystick(joystick, 0, 0, 0);
+            joystick->rumble_resend = 0;
+        }
+
+        if (joystick->rumble_resend != 0 && now >= joystick->rumble_resend) {
+            S3_VirtualRumble(joystick, joystick->low_frequency_rumble, joystick->high_frequency_rumble);
+            joystick->rumble_resend = now + S3_RUMBLE_RESEND_MS;
+        }
+    }
+
+    for (i = 0; i < count; i++) {
+        S3_VirtualReleaseJoystick(list[i]);
+    }
+
+    if (list != local) {
+        SDL_free(list);
+    }
+
+    S3_UnlockJoysticks();
+}
+
+void S3_PumpVirtualJoysticks(void)
+{
+    // SDL3 updates joysticks as it pumps events unless the app turned that off.
+    if (s3_virtual_joysticks != NULL && SDL_GetHintBoolean(SDL_HINT_AUTO_UPDATE_JOYSTICKS, SDL_TRUE)) {
+        S3_VirtualUpdate();
+    }
+}
+
+static void S3_VirtualRemoved(S3_JoystickID instance_id, bool was_gamepad)
+{
+    S3_VirtualJoystick* joystick = S3_VirtualJoystickForID(instance_id);
+    int player;
+
+    if (joystick != NULL) {
+        joystick->refcount++;
+        S3_VirtualForceRecentering(joystick);
+        joystick->attached = false;
+    }
+
+    if (was_gamepad && S3_GamepadsStarted()) {
+        if (joystick != NULL && joystick->gamepad != NULL) {
+            S3_VirtualRecenterGamepad(joystick->gamepad);
+        }
+        S3_VirtualPushDevice(SDL_CONTROLLERDEVICEREMOVED, instance_id);
+    }
+
+    S3_VirtualPushDevice(SDL_JOYDEVICEREMOVED, instance_id);
+
+    player = S3_VirtualPlayerIndexForID(instance_id);
+    if (player >= 0) {
+        s3_virtual_players[player] = 0;
+    }
+
+    if (joystick != NULL) {
+        S3_VirtualReleaseJoystick(joystick);
+    }
+}
+
+S3_JoystickID S3_AttachVirtualJoystick(const S3_VirtualJoystickDesc* desc)
+{
+    S3_VirtualDevice* device;
+    S3_VirtualDevice** link;
+    S3_VirtualNames* names;
+    const char* name;
+    int trigger_left = -1;
+    int trigger_right = -1;
+    S3_JoystickID instance_id;
+    int i;
+
+    if (desc == NULL) {
+        SDL_SetError("Parameter 'desc' is invalid");
+        return 0;
+    }
+
+    if (desc->version < sizeof(*desc)) {
+        SDL_SetError("Invalid desc, should be initialized with SDL_INIT_INTERFACE()");
+        return 0;
+    }
+
+    if (desc->ntouchpads > 0 && desc->touchpads == NULL) {
+        SDL_SetError("desc missing touchpad descriptions");
+        return 0;
+    }
+
+    if (desc->nsensors > 0 && desc->sensors == NULL) {
+        SDL_SetError("desc missing sensor descriptions");
+        return 0;
+    }
+
+    device = (S3_VirtualDevice*)SDL_calloc(1, sizeof(*device));
+    names = (S3_VirtualNames*)SDL_calloc(1, sizeof(*names));
+    if (device == NULL || names == NULL) {
+        goto out_of_memory;
+    }
+
+    device->desc = *desc;
+    device->desc.touchpads = NULL;
+    device->desc.sensors = NULL;
+
+    name = desc->name != NULL ? desc->name : S3_VirtualDefaultName(desc->type);
+    names->name = SDL_strdup(name);
+    if (names->name == NULL) {
+        goto out_of_memory;
+    }
+
+    if (desc->type == S3_JOYSTICK_TYPE_GAMEPAD) {
+        int axis = 0;
+
+        if (device->desc.button_mask == 0) {
+            for (i = 0; i < device->desc.nbuttons && i < 32; i++) {
+                device->desc.button_mask |= 1u << i;
+            }
+        }
+
+        if (device->desc.axis_mask == 0) {
+            if (device->desc.naxes >= 2) {
+                device->desc.axis_mask |= (1u << S3_GAMEPAD_AXIS_LEFTX) | (1u << S3_GAMEPAD_AXIS_LEFTY);
+            }
+            if (device->desc.naxes >= 4) {
+                device->desc.axis_mask |= (1u << S3_GAMEPAD_AXIS_RIGHTX) | (1u << S3_GAMEPAD_AXIS_RIGHTY);
+            }
+            if (device->desc.naxes >= 6) {
+                device->desc.axis_mask |= (1u << S3_GAMEPAD_AXIS_LEFT_TRIGGER) | (1u << S3_GAMEPAD_AXIS_RIGHT_TRIGGER);
+            }
+        }
+
+        for (i = 0; axis < device->desc.naxes && i < S3_GAMEPAD_AXIS_COUNT; i++) {
+            if ((device->desc.axis_mask & (1u << i)) != 0) {
+                if (i == S3_GAMEPAD_AXIS_LEFT_TRIGGER) {
+                    trigger_left = axis;
+                }
+                if (i == S3_GAMEPAD_AXIS_RIGHT_TRIGGER) {
+                    trigger_right = axis;
+                }
+                axis++;
+            }
+        }
+
+        names->gamepad_name = S3_VirtualGamepadName(name);
+        if (names->gamepad_name == NULL) {
+            goto out_of_memory;
+        }
+        device->is_gamepad = true;
+    }
+
+    device->guid = S3_VirtualGUID(desc->vendor_id, desc->product_id, name, (Uint8)desc->type);
+
+    if (desc->naxes > 0) {
+        device->axes = (Sint16*)SDL_calloc(desc->naxes, sizeof(*device->axes));
+        if (device->axes == NULL) {
+            goto out_of_memory;
+        }
+        // Triggers rest at the bottom of their range.
+        if (trigger_left >= 0) {
+            device->axes[trigger_left] = SDL_JOYSTICK_AXIS_MIN;
+        }
+        if (trigger_right >= 0) {
+            device->axes[trigger_right] = SDL_JOYSTICK_AXIS_MIN;
+        }
+    }
+
+    if (desc->nbuttons > 0) {
+        device->buttons = (bool*)SDL_calloc(desc->nbuttons, sizeof(*device->buttons));
+        if (device->buttons == NULL) {
+            goto out_of_memory;
+        }
+    }
+
+    if (desc->nhats > 0) {
+        device->hats = (Uint8*)SDL_calloc(desc->nhats, sizeof(*device->hats));
+        if (device->hats == NULL) {
+            goto out_of_memory;
+        }
+    }
+
+    if (desc->nsensors > 0) {
+        device->sensor_types = (S3_SensorType*)SDL_calloc(desc->nsensors, sizeof(*device->sensor_types));
+        device->sensor_rates = (float*)SDL_calloc(desc->nsensors, sizeof(*device->sensor_rates));
+        if (device->sensor_types == NULL || device->sensor_rates == NULL) {
+            goto out_of_memory;
+        }
+        for (i = 0; i < desc->nsensors; i++) {
+            device->sensor_types[i] = desc->sensors[i].type;
+            device->sensor_rates[i] = desc->sensors[i].rate;
+        }
+    }
+
+    S3_LockJoysticks();
+
+    instance_id = s3_next_virtual_id++;
+    device->id = instance_id;
+    names->id = instance_id;
+    names->next = s3_virtual_names;
+    s3_virtual_names = names;
+    device->names = names;
+
+    for (link = &s3_virtual_devices; *link != NULL; link = &(*link)->next) {
+    }
+    *link = device;
+
+    // As in SDL3: a gamepad's player number first, then the joystick's arrival, then the gamepad's.
+    if (device->is_gamepad) {
+        S3_VirtualSetPlayerIndex(S3_VirtualFindFreePlayerIndex(), instance_id);
+    }
+
+    S3_VirtualPushDevice(SDL_JOYDEVICEADDED, instance_id);
+    if (device->is_gamepad && S3_GamepadsStarted()) {
+        S3_VirtualPushDevice(SDL_CONTROLLERDEVICEADDED, instance_id);
+    }
+
+    S3_UnlockJoysticks();
+
+    return instance_id;
+
+out_of_memory:
+    if (device != NULL) {
+        SDL_free(device->axes);
+        SDL_free(device->buttons);
+        SDL_free(device->hats);
+        SDL_free(device->sensor_types);
+        SDL_free(device->sensor_rates);
+        SDL_free(device);
+    }
+    if (names != NULL) {
+        SDL_free(names->name);
+        SDL_free(names->gamepad_name);
+        SDL_free(names);
+    }
+    SDL_SetError("Out of memory");
+
+    return 0;
+}
+
+bool S3_DetachVirtualJoystick(S3_JoystickID instance_id)
+{
+    S3_VirtualDevice* device;
+    bool was_gamepad;
+
+    S3_LockJoysticks();
+
+    device = S3_VirtualDeviceForID(instance_id);
+    if (device == NULL) {
+        S3_UnlockJoysticks();
+        SDL_SetError("Virtual joystick data not found");
+        return false;
+    }
+
+    was_gamepad = device->is_gamepad;
+    S3_VirtualFreeDevice(device);
+    S3_VirtualRemoved(instance_id, was_gamepad);
+
+    S3_UnlockJoysticks();
+
+    return true;
+}
