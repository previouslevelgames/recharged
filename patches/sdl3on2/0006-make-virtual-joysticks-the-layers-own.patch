+bool S3_SendJoystickVirtualSensorData(S3_Joystick* joystick, S3_SensorType type, Uint64 sensor_timestamp, const float* data, int num_values)
+{
+    S3_VirtualJoystick* virt;
+    bool result = false;
+
+    S3_LockJoysticks();
+
+    virt = S3_VirtualJoystickParameter(joystick);
+    if (virt != NULL) {
+        S3_VirtualDevice* device = virt->device;
+
+        if (device == NULL) {
+            SDL_SetError("Invalid joystick");
+        } else if (num_values > 0 && data == NULL) {
+            SDL_SetError("Parameter 'data' is invalid");
+        } else {
+            result = true;
+
+            // Readings wait for the next update, which drops them unless a sensor is enabled.
+            if (device->num_sensor_events == device->max_sensor_events) {
+                const int max_events = device->max_sensor_events > 0 ? device->max_sensor_events * 2 : 4;
+                S3_VirtualSensorEvent* events = (S3_VirtualSensorEvent*)SDL_realloc(device->sensor_events, sizeof(*events) * (size_t)max_events);
+
+                if (events == NULL) {
+                    SDL_SetError("Out of memory");
+                    result = false;
+                } else {
+                    device->sensor_events = events;
+                    device->max_sensor_events = max_events;
+                }
+            }
+
+            if (result) {
+                S3_VirtualSensorEvent* reading = &device->sensor_events[device->num_sensor_events++];
+
+                SDL_zerop(reading);
+                reading->type = type;
+                reading->sensor_timestamp = sensor_timestamp;
+                reading->num_values = SDL_clamp(num_values, 0, (int)SDL_arraysize(reading->data));
+                if (reading->num_values > 0) {
+                    SDL_memcpy(reading->data, data, sizeof(float) * (size_t)reading->num_values);
+                }
+            }
+        }
+    }
+
+    S3_UnlockJoysticks();
+
+    return result;
+}
+
+// SDL_OpenJoystick for a virtual device; the caller holds the lock.
+static S3_VirtualJoystick* S3_VirtualOpenJoystick(S3_VirtualDevice* device)
+{
+    S3_VirtualJoystick* joystick = device->joystick;
+    int i;
+
+    if (joystick != NULL) {
+        joystick->refcount++;
+        return joystick;
+    }
+
+    joystick = (S3_VirtualJoystick*)SDL_calloc(1, sizeof(*joystick));
+    if (joystick == NULL) {
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    joystick->id = device->id;
+    joystick->device = device;
+    joystick->refcount = 1;
+    joystick->attached = true;
+    joystick->guid = device->guid;
+    joystick->naxes = device->desc.naxes;
+    joystick->nbuttons = device->desc.nbuttons;
+    joystick->nhats = device->desc.nhats;
+    joystick->nsensors = device->desc.nsensors;
+    joystick->cap_led = device->desc.SetLED != NULL;
+    joystick->cap_rumble = device->desc.Rumble != NULL;
+    joystick->cap_trigger_rumble = device->desc.RumbleTriggers != NULL;
+    joystick->led_expiration = SDL_GetTicks64();
+
+    joystick->axes = joystick->naxes > 0 ? (S3_VirtualAxis*)SDL_calloc((size_t)joystick->naxes, sizeof(*joystick->axes)) : NULL;
+    joystick->buttons = joystick->nbuttons > 0 ? (bool*)SDL_calloc((size_t)joystick->nbuttons, sizeof(*joystick->buttons)) : NULL;
+    joystick->hats = joystick->nhats > 0 ? (Uint8*)SDL_calloc((size_t)joystick->nhats, sizeof(*joystick->hats)) : NULL;
+    joystick->sensors = joystick->nsensors > 0 ? (S3_VirtualSensor*)SDL_calloc((size_t)joystick->nsensors, sizeof(*joystick->sensors)) : NULL;
+    if ((joystick->naxes > 0 && joystick->axes == NULL) || (joystick->nbuttons > 0 && joystick->buttons == NULL)
+        || (joystick->nhats > 0 && joystick->hats == NULL) || (joystick->nsensors > 0 && joystick->sensors == NULL)) {
+        SDL_free(joystick->axes);
+        SDL_free(joystick->buttons);
+        SDL_free(joystick->hats);
+        SDL_free(joystick->sensors);
+        SDL_free(joystick);
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    for (i = 0; i < joystick->nsensors; i++) {
+        joystick->sensors[i].type = device->sensor_types[i];
+        joystick->sensors[i].rate = device->sensor_rates[i];
+    }
+
+    // SDL3 takes two axes, and two devices' axes, to rest at zero from the start.
+    {
+        const Uint16 vendor = S3_VirtualVendor(device->guid);
+        const Uint16 product = S3_VirtualProduct(device->guid);
+
+        if (joystick->naxes == 2 || (vendor == 0x05A0 && product == 0x3232) || (vendor == 0x0E8F && product == 0x3013)) {
+            for (i = 0; i < joystick->naxes; i++) {
+                joystick->axes[i].has_initial_value = true;
+            }
+        }
+    }
+
+    device->joystick = joystick;
+    joystick->next = s3_virtual_joysticks;
+    s3_virtual_joysticks = joystick;
+
+    // SDL3 updates a joystick as it opens it.
+    joystick->refcount++;
+    S3_VirtualUpdateJoystick(joystick);
+    S3_VirtualReleaseJoystick(joystick);
+
+    return joystick;
+}
+
+static void S3_VirtualCloseGamepad(S3_VirtualGamepad* gamepad)
+{
+    S3_VirtualJoystick* joystick = gamepad->joystick;
+
+    if (--gamepad->refcount > 0) {
+        return;
+    }
+
+    joystick->gamepad = NULL;
+    SDL_free(gamepad);
+    S3_VirtualReleaseJoystick(joystick);
+}
+
+static S3_VirtualGamepad* S3_VirtualOpenGamepad(S3_JoystickID instance_id)
+{
+    S3_VirtualJoystick* joystick = S3_VirtualJoystickForID(instance_id);
+    S3_VirtualDevice* device;
+    S3_VirtualGamepad* gamepad;
+    int input;
+    int i;
+
+    if (joystick != NULL && joystick->gamepad != NULL) {
+        joystick->gamepad->refcount++;
+        return joystick->gamepad;
+    }
+
+    device = S3_VirtualDeviceForID(instance_id);
+    if (device == NULL || !device->is_gamepad) {
+        SDL_SetError("Couldn't find mapping for device (%" SDL_PRIu32 ")", instance_id);
+        return NULL;
+    }
+
+    gamepad = (S3_VirtualGamepad*)SDL_calloc(1, sizeof(*gamepad));
+    if (gamepad == NULL) {
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    joystick = S3_VirtualOpenJoystick(device);
+    if (joystick == NULL) {
+        SDL_free(gamepad);
+        return NULL;
+    }
+
+    gamepad->joystick = joystick;
+    gamepad->refcount = 1;
+    gamepad->name = device->names->gamepad_name;
+    gamepad->type = S3_VirtualGamepadType(device->guid, device->names->name);
+
+    // SDL3's generated mapping binds the descriptor's masked buttons and axes in order.
+    input = 0;
+    for (i = 0; i < S3_GAMEPAD_BUTTON_COUNT; i++) {
+        gamepad->button_input[i] = -1;
+        if (input < device->desc.nbuttons && (device->desc.button_mask & (1u << i)) != 0) {
+            gamepad->button_input[i] = input++;
+        }
+    }
+
+    input = 0;
+    for (i = 0; i < S3_GAMEPAD_AXIS_COUNT; i++) {
+        gamepad->axis_input[i] = -1;
+        if (input < device->desc.naxes && (device->desc.axis_mask & (1u << i)) != 0) {
+            gamepad->axis_input[i] = input++;
+        }
+    }
+
+    // Opening a gamepad sets the triggers' joystick axes to rest, as SDL3 does.
+    for (i = S3_GAMEPAD_AXIS_LEFT_TRIGGER; i <= S3_GAMEPAD_AXIS_RIGHT_TRIGGER; i++) {
+        input = gamepad->axis_input[i];
+        if (input >= 0 && input < joystick->naxes) {
+            joystick->axes[input].value = SDL_JOYSTICK_AXIS_MIN;
+            joystick->axes[input].zero = SDL_JOYSTICK_AXIS_MIN;
+        }
+    }
+
+    joystick->gamepad = gamepad;
+
+    return gamepad;
+}
+
+static void S3_VirtualQuitGamepads(void)
+{
+    S3_VirtualJoystick* joystick;
+
+    S3_LockJoysticks();
+
+    // SDL3 announces the open gamepads gone, then closes them.
+    for (joystick = s3_virtual_joysticks; joystick != NULL; joystick = joystick->next) {
+        if (joystick->gamepad != NULL) {
+            S3_VirtualRecenterGamepad(joystick->gamepad);
+            S3_VirtualPushDevice(SDL_CONTROLLERDEVICEREMOVED, joystick->id);
+        }
+    }
+
+    for (;;) {
+        for (joystick = s3_virtual_joysticks; joystick != NULL && joystick->gamepad == NULL; joystick = joystick->next) {
+        }
+        if (joystick == NULL) {
+            break;
+        }
+        joystick->gamepad->refcount = 1;
+        S3_VirtualCloseGamepad(joystick->gamepad);
+    }
+
+    S3_UnlockJoysticks();
+}
+
+static void S3_VirtualQuitJoysticks(void)
+{
+    S3_VirtualDevice* device;
+
+    S3_LockJoysticks();
+
+    // As SDL3: every device is announced gone, every handle closed, then the devices freed.
+    for (device = s3_virtual_devices; device != NULL; device = device->next) {
+        S3_VirtualRemoved(device->id, device->is_gamepad);
+    }
+
+    while (s3_virtual_joysticks != NULL) {
+        S3_VirtualJoystick* joystick = s3_virtual_joysticks;
+
+        if (joystick->gamepad != NULL) {
+            SDL_free(joystick->gamepad);
+            joystick->gamepad = NULL;
+        }
+        joystick->refcount = 1;
+        S3_VirtualReleaseJoystick(joystick);
+    }
+
+    while (s3_virtual_devices != NULL) {
+        S3_VirtualFreeDevice(s3_virtual_devices);
+    }
+
+    while (s3_virtual_names != NULL) {
+        S3_VirtualNames* names = s3_virtual_names;
+
+        s3_virtual_names = names->next;
+        SDL_free(names->name);
+        SDL_free(names->gamepad_name);
+        SDL_free(names);
+    }
+
+    SDL_free(s3_virtual_players);
+    s3_virtual_players = NULL;
+    s3_virtual_player_count = 0;
+
+    S3_UnlockJoysticks();
+}
+
+void S3_VirtualGamepadsStarted(void)
+{
+    S3_VirtualDevice* device;
+
+    S3_LockJoysticks();
+    for (device = s3_virtual_devices; device != NULL; device = device->next) {
+        if (device->is_gamepad) {
+            S3_VirtualPushDevice(SDL_CONTROLLERDEVICEADDED, device->id);
+        }
+    }
+    S3_UnlockJoysticks();
+}
+
+void S3_VirtualSubsystemsStopped(S3_InitFlags before, S3_InitFlags after)
+{
+    if ((before & S3_INIT_GAMEPAD) != 0 && (after & S3_INIT_GAMEPAD) == 0) {
+        S3_VirtualQuitGamepads();
+    }
+
+    if ((before & S3_INIT_JOYSTICK) != 0 && (after & S3_INIT_JOYSTICK) == 0) {
+        S3_VirtualQuitJoysticks();
+    }
+}
