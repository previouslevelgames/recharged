+bool S3_SetGamepadLED(S3_Gamepad* gamepad, Uint8 red, Uint8 green, Uint8 blue)
+{
+    S3_VirtualGamepad* virt;
+    bool result = true;
+
+    S3_LockJoysticks();
+    virt = S3_VirtualGamepadFrom(gamepad);
+    if (virt != NULL) {
+        S3_VirtualJoystick* joystick = virt->joystick;
+
+        // SDL3 sends a colour again only when it changes or a while after the last time.
+        if (red != joystick->led_red || green != joystick->led_green || blue != joystick->led_blue || SDL_GetTicks64() >= joystick->led_expiration) {
+            if (joystick->device == NULL) {
+                SDL_SetError("SetLED failed, device disconnected");
+                result = false;
+            } else if (joystick->device->desc.SetLED == NULL) {
+                result = S3_VirtualUnsupported();
+            } else {
+                result = joystick->device->desc.SetLED(joystick->device->desc.userdata, red, green, blue);
+            }
+            joystick->led_expiration = SDL_GetTicks64() + S3_LED_MIN_REPEAT_MS;
+        }
+        joystick->led_red = red;
+        joystick->led_green = green;
+        joystick->led_blue = blue;
+        S3_UnlockJoysticks();
+        return result;
+    }
+    S3_UnlockJoysticks();
+
+    return S3_PlatformSetGamepadLED(gamepad, red, green, blue);
+}
+
+bool S3_SendGamepadEffect(S3_Gamepad* gamepad, const void* data, int size)
+{
+    S3_VirtualGamepad* virt;
+    bool result;
+
+    S3_LockJoysticks();
+    virt = S3_VirtualGamepadFrom(gamepad);
+    if (virt != NULL) {
+        const S3_VirtualDevice* device = virt->joystick->device;
+
+        if (device == NULL) {
+            SDL_SetError("SendEffect failed, device disconnected");
+            result = false;
+        } else if (device->desc.SendEffect == NULL) {
+            result = S3_VirtualUnsupported();
+        } else {
+            result = device->desc.SendEffect(device->desc.userdata, data, size);
+        }
+        S3_UnlockJoysticks();
+        return result;
+    }
+    S3_UnlockJoysticks();
+
+    return S3_PlatformSendGamepadEffect(gamepad, data, size);
+}
+
+static S3_VirtualSensor* S3_VirtualFindSensor(S3_VirtualJoystick* joystick, S3_SensorType type)
+{
+    int i;
+
+    for (i = 0; i < joystick->nsensors; i++) {
+        if (joystick->sensors[i].type == type) {
+            return &joystick->sensors[i];
+        }
+    }
+
+    return NULL;
+}
+
+bool S3_GamepadHasSensor(S3_Gamepad* gamepad, S3_SensorType type)
+{
+    S3_VirtualGamepad* virt;
+    bool result;
+
+    S3_LockJoysticks();
+    virt = S3_VirtualGamepadFrom(gamepad);
+    if (virt != NULL) {
+        result = S3_VirtualFindSensor(virt->joystick, type) != NULL;
+        S3_UnlockJoysticks();
+        return result;
+    }
+    S3_UnlockJoysticks();
+
+    return S3_PlatformGamepadHasSensor(gamepad, type);
+}
+
+// The driver's sensor switch, which the joystick flips when its first sensor turns on or last turns off.
+static bool S3_VirtualSetSensorsEnabled(S3_VirtualJoystick* joystick, bool enabled)
+{
+    S3_VirtualDevice* device = joystick->device;
+    bool result = true;
+
+    if (device == NULL) {
+        SDL_SetError("SetSensorsEnabled failed, device disconnected");
+        return false;
+    }
+
+    if (device->desc.SetSensorsEnabled != NULL) {
+        result = device->desc.SetSensorsEnabled(device->desc.userdata, enabled);
+    }
+
+    if (result) {
+        device->sensors_enabled = enabled;
+    }
+
+    return result;
+}
+
+bool S3_SetGamepadSensorEnabled(S3_Gamepad* gamepad, S3_SensorType type, bool enabled)
+{
+    S3_VirtualGamepad* virt;
+    bool result;
+
+    S3_LockJoysticks();
+    virt = S3_VirtualGamepadFrom(gamepad);
+    if (virt != NULL) {
+        S3_VirtualJoystick* joystick = virt->joystick;
+        S3_VirtualSensor* sensor = S3_VirtualFindSensor(joystick, type);
+
+        if (sensor == NULL) {
+            result = S3_VirtualUnsupported();
+        } else if (sensor->enabled == enabled) {
+            result = true;
+        } else if (enabled && joystick->nsensors_enabled == 0 && !S3_VirtualSetSensorsEnabled(joystick, true)) {
+            result = false;
+        } else if (!enabled && joystick->nsensors_enabled == 1 && !S3_VirtualSetSensorsEnabled(joystick, false)) {
+            result = false;
+        } else {
+            joystick->nsensors_enabled += enabled ? 1 : -1;
+            sensor->enabled = enabled;
+            result = true;
+        }
+        S3_UnlockJoysticks();
+        return result;
+    }
+    S3_UnlockJoysticks();
+
+    return S3_PlatformSetGamepadSensorEnabled(gamepad, type, enabled);
+}
+
+bool S3_GetGamepadSensorData(S3_Gamepad* gamepad, S3_SensorType type, float* data, int num_values)
+{
+    S3_VirtualGamepad* virt;
+    bool result;
+
+    S3_LockJoysticks();
+    virt = S3_VirtualGamepadFrom(gamepad);
+    if (virt != NULL) {
+        const S3_VirtualSensor* sensor = S3_VirtualFindSensor(virt->joystick, type);
+
+        if (sensor == NULL) {
+            result = S3_VirtualUnsupported();
+        } else {
+            const int count = SDL_clamp(num_values, 0, (int)SDL_arraysize(sensor->data));
+
+            if (count > 0 && data != NULL) {
+                SDL_memcpy(data, sensor->data, sizeof(float) * (size_t)count);
+            }
+            result = true;
+        }
+        S3_UnlockJoysticks();
+        return result;
+    }
+    S3_UnlockJoysticks();
+
+    return S3_PlatformGetGamepadSensorData(gamepad, type, data, num_values);
+}
