new file mode 100644
index 0000000..e04b157
--- /dev/null
+++ b/src/s3_joystick.c
@@ -0,0 +1,2450 @@
+// Joysticks and gamepads. Virtual joysticks are the layer's own on every platform, made as SDL3's
+// software driver makes them; every other device is the platform's: SDL2's, or on Switch the
+// layer's libnx pads. The platform's joystick lock covers both.
+
+#include <assert.h>
+
+#include "s3_internal.h"
+
+static_assert(S3_GAMEPAD_BUTTON_COUNT <= 32 && S3_GAMEPAD_AXIS_COUNT <= 32, "one mask bit each");
+
+#define S3_VIRTUAL_AXES_CHANGED 0x01u
+#define S3_VIRTUAL_BUTTONS_CHANGED 0x04u
+#define S3_VIRTUAL_HATS_CHANGED 0x08u
+
+// SDL3's pacing for rumble, LEDs and the guide button.
+#define S3_RUMBLE_RESEND_MS 2000u
+#define S3_MAX_RUMBLE_DURATION_MS 0xFFFFu
+#define S3_LED_MIN_REPEAT_MS 5000u
+#define S3_MINIMUM_GUIDE_BUTTON_DELAY_MS 250u
+
+#define S3_HARDWARE_BUS_VIRTUAL 0xFFu
+
+typedef struct S3_VirtualSensorEvent {
+    S3_SensorType type;
+    Uint64 sensor_timestamp;
+    float data[3];
+    int num_values;
+} S3_VirtualSensorEvent;
+
+// A device's names outlive it, as SDL3 keeps them, until the joystick subsystem quits.
+typedef struct S3_VirtualNames {
+    S3_JoystickID id;
+    char* name;
+    char* gamepad_name;
+    struct S3_VirtualNames* next;
+} S3_VirtualNames;
+
+struct S3_VirtualJoystick;
+
+// An attached virtual joystick: the state SDL3's virtual driver keeps for it.
+typedef struct S3_VirtualDevice {
+    S3_JoystickID id;
+    S3_VirtualJoystickDesc desc;
+    const S3_VirtualNames* names;
+    S3_GUID guid;
+    bool is_gamepad;
+    Sint16* axes;
+    bool* buttons;
+    Uint8* hats;
+    S3_SensorType* sensor_types;
+    float* sensor_rates;
+    bool sensors_enabled;
+    Uint32 changes;
+    S3_VirtualSensorEvent* sensor_events;
+    int num_sensor_events;
+    int max_sensor_events;
+    struct S3_VirtualJoystick* joystick;
+    struct S3_VirtualDevice* next;
+} S3_VirtualDevice;
+
+typedef struct S3_VirtualAxis {
+    Sint16 initial_value;
+    Sint16 value;
+    Sint16 zero;
+    bool has_initial_value;
+    bool has_second_value;
+    bool sent_initial_value;
+    bool sending_initial_value;
+} S3_VirtualAxis;
+
+typedef struct S3_VirtualSensor {
+    S3_SensorType type;
+    bool enabled;
+    float rate;
+    float data[3];
+} S3_VirtualSensor;
+
+struct S3_VirtualGamepad;
+
+// An open virtual joystick, SDL3's SDL_Joystick: it outlives its device until it is closed.
+typedef struct S3_VirtualJoystick {
+    S3_JoystickID id;
+    S3_VirtualDevice* device;
+    int refcount;
+    bool attached;
+    S3_GUID guid;
+    int naxes;
+    int nbuttons;
+    int nhats;
+    int nsensors;
+    int nsensors_enabled;
+    S3_VirtualAxis* axes;
+    bool* buttons;
+    Uint8* hats;
+    S3_VirtualSensor* sensors;
+    bool cap_led;
+    bool cap_rumble;
+    bool cap_trigger_rumble;
+    Uint16 low_frequency_rumble;
+    Uint16 high_frequency_rumble;
+    Uint64 rumble_expiration;
+    Uint64 rumble_resend;
+    Uint8 led_red;
+    Uint8 led_green;
+    Uint8 led_blue;
+    Uint64 led_expiration;
+    bool delayed_guide_button;
+    struct S3_VirtualGamepad* gamepad;
+    struct S3_VirtualJoystick* next;
+} S3_VirtualJoystick;
+
+// An open virtual gamepad, bound to its joystick as SDL3's generated mapping binds it.
+typedef struct S3_VirtualGamepad {
+    S3_VirtualJoystick* joystick;
+    int refcount;
+    const char* name;
+    S3_GamepadType type;
+    int button_input[S3_GAMEPAD_BUTTON_COUNT];
+    int axis_input[S3_GAMEPAD_AXIS_COUNT];
+    Uint64 guide_button_down;
+} S3_VirtualGamepad;
+
+// Attached devices in attach order, open joysticks with the latest first, as SDL3 lists them.
+static S3_VirtualDevice* s3_virtual_devices;
+static S3_VirtualJoystick* s3_virtual_joysticks;
+static S3_VirtualNames* s3_virtual_names;
+static S3_JoystickID s3_next_virtual_id = S3_VIRTUAL_JOYSTICK_ID_FIRST;
+
+// Player numbers of virtual devices, indexed by player.
+static S3_JoystickID* s3_virtual_players;
+static int s3_virtual_player_count;
+
+static bool S3_VirtualUnsupported(void)
+{
+    SDL_SetError("That operation is not supported");
+    return false;
+}
+
+static bool S3_GamepadsStarted(void)
+{
+    return (S3_WasInit(S3_INIT_GAMEPAD) & S3_INIT_GAMEPAD) != 0;
+}
+
+static S3_VirtualDevice* S3_VirtualDeviceForID(S3_JoystickID instance_id)
+{
+    S3_VirtualDevice* device;
+
+    for (device = s3_virtual_devices; device != NULL; device = device->next) {
+        if (device->id == instance_id) {
+            return device;
+        }
+    }
+
+    return NULL;
+}
+
+static const S3_VirtualNames* S3_VirtualNamesForID(S3_JoystickID instance_id)
+{
+    const S3_VirtualNames* names;
+
+    for (names = s3_virtual_names; names != NULL; names = names->next) {
+        if (names->id == instance_id) {
+            return names;
+        }
+    }
+
+    return NULL;
+}
+
+static S3_VirtualJoystick* S3_VirtualJoystickForID(S3_JoystickID instance_id)
+{
+    S3_VirtualJoystick* joystick;
+
+    for (joystick = s3_virtual_joysticks; joystick != NULL; joystick = joystick->next) {
+        if (joystick->id == instance_id) {
+            return joystick;
+        }
+    }
+
+    return NULL;
+}
+
+// Handles are compared, never read, so a platform handle is safe to look up.
+static S3_VirtualJoystick* S3_VirtualJoystickFrom(const void* handle)
+{
+    S3_VirtualJoystick* joystick;
+
+    for (joystick = s3_virtual_joysticks; joystick != NULL; joystick = joystick->next) {
+        if ((const void*)joystick == handle) {
+            return joystick;
+        }
+    }
+
+    return NULL;
+}
+
+static S3_VirtualGamepad* S3_VirtualGamepadFrom(const void* handle)
+{
+    S3_VirtualJoystick* joystick;
+
+    for (joystick = s3_virtual_joysticks; joystick != NULL; joystick = joystick->next) {
+        if (joystick->gamepad != NULL && (const void*)joystick->gamepad == handle) {
+            return joystick->gamepad;
+        }
+    }
+
+    return NULL;
+}
+
+// SDL3 drops joystick input while the app is in the background, unless the app allows it.
+static bool S3_VirtualIgnoresInput(void)
+{
+    return !SDL_GetHintBoolean(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, SDL_FALSE) && S3_AppLacksFocus();
+}
+
+static void S3_VirtualPush(SDL_Event* event)
+{
+    if (S3_FilterLayerEvent(event)) {
+        S3_QueueLayerEvent(event);
+    }
+}
+
+static void S3_VirtualPushDevice(Uint32 type, S3_JoystickID instance_id)
+{
+    SDL_Event event;
+
+    // The layer's own devices carry their instance id where SDL2 would put a device index.
+    SDL_zero(event);
+    event.type = type;
+    event.jdevice.which = (SDL_JoystickID)(instance_id - 1u);
+    S3_VirtualPush(&event);
+}
+
+// SDL3 turns a joystick axis into a trigger value in floats, rounding towards zero.
+static Sint16 S3_VirtualTriggerValue(int value)
+{
+    const float normalized = (float)(value - SDL_JOYSTICK_AXIS_MIN) / (float)(SDL_JOYSTICK_AXIS_MAX - SDL_JOYSTICK_AXIS_MIN);
+
+    return (Sint16)(int)(normalized * (float)SDL_JOYSTICK_AXIS_MAX);
+}
+
+static bool S3_IsTrigger(int axis)
+{
+    return axis == S3_GAMEPAD_AXIS_LEFT_TRIGGER || axis == S3_GAMEPAD_AXIS_RIGHT_TRIGGER;
+}
+
+static bool S3_VirtualGamepadButton(const S3_VirtualGamepad* gamepad, int button)
+{
+    const S3_VirtualJoystick* joystick = gamepad->joystick;
+    const int input = button >= 0 && button < S3_GAMEPAD_BUTTON_COUNT ? gamepad->button_input[button] : -1;
+
+    return input >= 0 && input < joystick->nbuttons && joystick->buttons[input];
+}
+
+static Sint16 S3_VirtualGamepadAxis(const S3_VirtualGamepad* gamepad, int axis)
+{
+    const S3_VirtualJoystick* joystick = gamepad->joystick;
+    const int input = axis >= 0 && axis < S3_GAMEPAD_AXIS_COUNT ? gamepad->axis_input[axis] : -1;
+    int value;
+
+    if (input < 0 || input >= joystick->naxes) {
+        return 0;
+    }
+
+    value = joystick->axes[input].value;
+
+    return S3_IsTrigger(axis) ? S3_VirtualTriggerValue(value) : (Sint16)value;
+}
+
+// SDL3 holds back a guide release that follows its press too closely; true if the event goes now.
+static bool S3_VirtualGuideButtonReady(S3_VirtualGamepad* gamepad, bool down)
+{
+    const Uint64 now = SDL_GetTicks64();
+
+    if (down) {
+        gamepad->guide_button_down = now;
+        return !gamepad->joystick->delayed_guide_button;
+    }
+
+    if (now < gamepad->guide_button_down + S3_MINIMUM_GUIDE_BUTTON_DELAY_MS) {
+        gamepad->joystick->delayed_guide_button = true;
+        return false;
+    }
+
+    gamepad->joystick->delayed_guide_button = false;
+
+    return true;
+}
+
+static bool S3_VirtualGamepadButtonEvent(S3_VirtualGamepad* gamepad, int button, bool down, SDL_Event* event)
+{
+    if (button == S3_GAMEPAD_BUTTON_GUIDE && !S3_VirtualGuideButtonReady(gamepad, down)) {
+        return false;
+    }
+
+    SDL_zerop(event);
+    event->type = down ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+    event->cbutton.which = (SDL_JoystickID)(gamepad->joystick->id - 1u);
+    event->cbutton.button = (Uint8)button;
+    event->cbutton.state = down ? SDL_PRESSED : SDL_RELEASED;
+
+    return true;
+}
+
+static void S3_VirtualGamepadAxisEvent(const S3_VirtualGamepad* gamepad, int axis, Sint16 value, SDL_Event* event)
+{
+    SDL_zerop(event);
+    event->type = SDL_CONTROLLERAXISMOTION;
+    event->caxis.which = (SDL_JoystickID)(gamepad->joystick->id - 1u);
+    event->caxis.axis = (Uint8)axis;
+    event->caxis.value = value;
+}
+
+static void S3_VirtualSendGamepadButton(S3_VirtualGamepad* gamepad, int button, bool down)
+{
+    SDL_Event event;
+
+    if (S3_VirtualGamepadButtonEvent(gamepad, button, down, &event)) {
+        S3_VirtualPush(&event);
+    }
+}
+
+// The gamepad event SDL3's gamepad watch makes from a joystick event, if the mapping binds it.
+static bool S3_VirtualGamepadEventFor(S3_VirtualGamepad* gamepad, const SDL_Event* joystick_event, SDL_Event* event)
+{
+    int target;
+
+    if (joystick_event->type == SDL_JOYBUTTONDOWN || joystick_event->type == SDL_JOYBUTTONUP) {
+        for (target = 0; target < S3_GAMEPAD_BUTTON_COUNT; target++) {
+            if (gamepad->button_input[target] == joystick_event->jbutton.button) {
+                return S3_VirtualGamepadButtonEvent(gamepad, target, joystick_event->jbutton.state == SDL_PRESSED, event);
+            }
+        }
+    } else if (joystick_event->type == SDL_JOYAXISMOTION) {
+        for (target = 0; target < S3_GAMEPAD_AXIS_COUNT; target++) {
+            if (gamepad->axis_input[target] == joystick_event->jaxis.axis) {
+                const Sint16 value = joystick_event->jaxis.value;
+
+                S3_VirtualGamepadAxisEvent(gamepad, target, S3_IsTrigger(target) ? S3_VirtualTriggerValue(value) : value, event);
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
+
+// SDL3's gamepad layer watches joystick events, so a gamepad event made from one is queued first,
+// and only if the app's filter let the joystick event through.
+static void S3_VirtualPushInput(S3_VirtualJoystick* joystick, SDL_Event* event)
+{
+    SDL_Event gamepad_event;
+
+    if (!S3_FilterLayerEvent(event)) {
+        return;
+    }
+
+    if (joystick->gamepad != NULL && S3_VirtualGamepadEventFor(joystick->gamepad, event, &gamepad_event)) {
+        S3_VirtualPush(&gamepad_event);
+    }
+
+    S3_QueueLayerEvent(event);
+}
+
+static void S3_VirtualSendAxis(S3_VirtualJoystick* joystick, int axis, Sint16 value)
+{
+    S3_VirtualAxis* info;
+    SDL_Event event;
+
+    if (axis < 0 || axis >= joystick->naxes) {
+        return;
+    }
+
+    // SDL3 takes an axis's first value as its rest position and, for a virtual axis, reports it at once.
+    info = &joystick->axes[axis];
+    if (!info->has_initial_value
+        || (!info->has_second_value && (info->initial_value <= -32767 || info->initial_value == 32767) && SDL_abs(value) < (SDL_JOYSTICK_AXIS_MAX / 4))) {
+        info->initial_value = value;
+        info->value = value;
+        info->zero = value;
+        info->has_initial_value = true;
+    } else if (value == info->value && !info->sending_initial_value) {
+        return;
+    } else {
+        info->has_second_value = true;
+    }
+
+    if (!info->sent_initial_value) {
+        info->sent_initial_value = true;
+        info->sending_initial_value = true;
+        S3_VirtualSendAxis(joystick, axis, info->initial_value);
+        info->sending_initial_value = false;
+    }
+
+    // In the background only moves back towards rest get through.
+    if (S3_VirtualIgnoresInput()
+        && (info->sending_initial_value || (value > info->zero && value >= info->value) || (value < info->zero && value <= info->value))) {
+        return;
+    }
+
+    info->value = value;
+
+    SDL_zero(event);
+    event.type = SDL_JOYAXISMOTION;
+    event.jaxis.which = (SDL_JoystickID)(joystick->id - 1u);
+    event.jaxis.axis = (Uint8)axis;
+    event.jaxis.value = value;
+    S3_VirtualPushInput(joystick, &event);
+}
+
+static void S3_VirtualSendButton(S3_VirtualJoystick* joystick, int button, bool down)
+{
+    SDL_Event event;
+
+    if (button < 0 || button >= joystick->nbuttons || down == joystick->buttons[button]) {
+        return;
+    }
+
+    // In the background only releases get through.
+    if (down && S3_VirtualIgnoresInput()) {
+        return;
+    }
+
+    joystick->buttons[button] = down;
+
+    SDL_zero(event);
+    event.type = down ? SDL_JOYBUTTONDOWN : SDL_JOYBUTTONUP;
+    event.jbutton.which = (SDL_JoystickID)(joystick->id - 1u);
+    event.jbutton.button = (Uint8)button;
+    event.jbutton.state = down ? SDL_PRESSED : SDL_RELEASED;
+    S3_VirtualPushInput(joystick, &event);
+}
+
+static void S3_VirtualSendHat(S3_VirtualJoystick* joystick, int hat, Uint8 value)
+{
+    SDL_Event event;
+
+    if (hat < 0 || hat >= joystick->nhats || value == joystick->hats[hat]) {
+        return;
+    }
+
+    // In the background only centering gets through.
+    if (value != S3_HAT_CENTERED && S3_VirtualIgnoresInput()) {
+        return;
+    }
+
+    joystick->hats[hat] = value;
+
+    SDL_zero(event);
+    event.type = SDL_JOYHATMOTION;
+    event.jhat.which = (SDL_JoystickID)(joystick->id - 1u);
+    event.jhat.hat = (Uint8)hat;
+    event.jhat.value = value;
+    S3_VirtualPushInput(joystick, &event);
+}
+
+static void S3_VirtualSendSensor(S3_VirtualJoystick* joystick, const S3_VirtualSensorEvent* reading)
+{
+    SDL_Event event;
+    int i;
+
+    if (S3_VirtualIgnoresInput()) {
+        return;
+    }
+
+    for (i = 0; i < joystick->nsensors; i++) {
+        S3_VirtualSensor* sensor = &joystick->sensors[i];
+
+        if (sensor->type == reading->type) {
+            if (sensor->enabled) {
+                SDL_memcpy(sensor->data, reading->data, sizeof(float) * (size_t)reading->num_values);
+
+                // SDL3 reports a gamepad sensor reading whether or not a gamepad is open.
+                SDL_zero(event);
+                event.type = SDL_CONTROLLERSENSORUPDATE;
+                event.csensor.which = (SDL_JoystickID)(joystick->id - 1u);
+                event.csensor.sensor = (Sint32)reading->type;
+                SDL_memcpy(event.csensor.data, reading->data, sizeof(float) * (size_t)reading->num_values);
+                event.csensor.timestamp_us = reading->sensor_timestamp;
+                S3_VirtualPush(&event);
+            }
+            break;
+        }
+    }
+}
+
+static void S3_VirtualForceRecentering(S3_VirtualJoystick* joystick)
+{
+    int i;
+
+    for (i = 0; i < joystick->naxes; i++) {
+        if (joystick->axes[i].has_initial_value) {
+            S3_VirtualSendAxis(joystick, i, joystick->axes[i].zero);
+        }
+    }
+
+    for (i = 0; i < joystick->nbuttons; i++) {
+        S3_VirtualSendButton(joystick, i, false);
+    }
+
+    for (i = 0; i < joystick->nhats; i++) {
+        S3_VirtualSendHat(joystick, i, S3_HAT_CENTERED);
+    }
+}
+
+static void S3_VirtualRecenterGamepad(S3_VirtualGamepad* gamepad)
+{
+    SDL_Event event;
+    int i;
+
+    for (i = 0; i < S3_GAMEPAD_BUTTON_COUNT; i++) {
+        if (S3_VirtualGamepadButton(gamepad, i)) {
+            S3_VirtualSendGamepadButton(gamepad, i, false);
+        }
+    }
+
+    for (i = 0; i < S3_GAMEPAD_AXIS_COUNT; i++) {
+        if (S3_VirtualGamepadAxis(gamepad, i) != 0) {
+            S3_VirtualGamepadAxisEvent(gamepad, i, 0, &event);
+            S3_VirtualPush(&event);
+        }
+    }
+}
+
+static int S3_VirtualPlayerIndexForID(S3_JoystickID instance_id)
+{
+    int player;
+
+    for (player = 0; player < s3_virtual_player_count; player++) {
+        if (s3_virtual_players[player] == instance_id) {
+            return player;
+        }
+    }
+
+    return -1;
+}
+
+static bool S3_PlatformPlayerIndexTaken(const int* platform_players, int count, int player)
+{
+    int i;
+
+    for (i = 0; i < count; i++) {
+        if (platform_players[i] == player) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+// SDL3 numbers a gamepad with the lowest free player index, skipping those real controllers hold.
+static int S3_VirtualFindFreePlayerIndex(void)
+{
+    S3_JoystickID* platform_ids;
+    int* platform_players = NULL;
+    int count = 0;
+    int player;
+    int i;
+
+    platform_ids = S3_PlatformGetGamepads(&count);
+    if (platform_ids != NULL && count > 0) {
+        platform_players = (int*)SDL_malloc(sizeof(*platform_players) * (size_t)count);
+        for (i = 0; platform_players != NULL && i < count; i++) {
+            platform_players[i] = S3_PlatformGetGamepadPlayerIndexForID(platform_ids[i]);
+        }
+    }
+    SDL_free(platform_ids);
+
+    for (player = 0;; player++) {
+        if ((player >= s3_virtual_player_count || s3_virtual_players[player] == 0)
+            && (platform_players == NULL || !S3_PlatformPlayerIndexTaken(platform_players, count, player))) {
+            break;
+        }
+    }
+    SDL_free(platform_players);
+
+    return player;
+}
+
+static bool S3_VirtualSetPlayerIndex(int player_index, S3_JoystickID instance_id)
+{
+    const S3_JoystickID existing = player_index >= 0 && player_index < s3_virtual_player_count ? s3_virtual_players[player_index] : 0;
+    const S3_VirtualDevice* device;
+    int previous;
+
+    if (player_index >= s3_virtual_player_count) {
+        S3_JoystickID* players = (S3_JoystickID*)SDL_realloc(s3_virtual_players, sizeof(*players) * ((size_t)player_index + 1));
+
+        if (players == NULL) {
+            SDL_SetError("Out of memory");
+            return false;
+        }
+
+        SDL_memset(&players[s3_virtual_player_count], 0, sizeof(*players) * (size_t)(player_index + 1 - s3_virtual_player_count));
+        s3_virtual_players = players;
+        s3_virtual_player_count = player_index + 1;
+    } else if (player_index >= 0 && s3_virtual_players[player_index] == instance_id) {
+        return true;
+    }
+
+    previous = S3_VirtualPlayerIndexForID(instance_id);
+    if (previous >= 0) {
+        s3_virtual_players[previous] = 0;
+    }
+
+    if (player_index >= 0) {
+        s3_virtual_players[player_index] = instance_id;
+    }
+
+    device = S3_VirtualDeviceForID(instance_id);
+    if (device != NULL && device->desc.SetPlayerIndex != NULL) {
+        device->desc.SetPlayerIndex(device->desc.userdata, player_index);
+    }
+
+    // The device that held the number moves to the next free one.
+    if (existing != 0) {
+        S3_VirtualSetPlayerIndex(S3_VirtualFindFreePlayerIndex(), existing);
+    }
+
+    return true;
+}
