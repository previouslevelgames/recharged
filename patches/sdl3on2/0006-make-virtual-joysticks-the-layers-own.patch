+bool S3_FilterLayerEvent(const SDL_Event* native)
+{
+    return S3_EventFilterTrampoline(NULL, (SDL_Event*)native) != 0;
+}
+
+static void S3_CallEventWatches(const S3_EventWatch* watch, const S3_Event* event)
+{
+    S3_Event copy;
+
+    // SDL2 calls watches in the order they were added; the list starts with the newest.
+    if (watch != NULL) {
+        S3_CallEventWatches(watch->next, event);
+        copy = *event;
+        watch->filter(watch->userdata, &copy);
+    }
+}
+
+void S3_QueueLayerEvent(SDL_Event* native)
+{
+    char text[S3_TEXT_ARENA_ENTRY_SIZE];
+    S3_Event event;
+
+    native->common.timestamp = SDL_GetTicks();
+    if (S3_TranslateEvent(native, &event, text, sizeof(text))) {
+        S3_CallEventWatches(s3_event_watches, &event);
+    }
+
+    // Added straight to the queue, past SDL2's filter and watches, which saw it above.
+    SDL_PeepEvents(native, 1, SDL_ADDEVENT, SDL_FIRSTEVENT, SDL_LASTEVENT);
+}
