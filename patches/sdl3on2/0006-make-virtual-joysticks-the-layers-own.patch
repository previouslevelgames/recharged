+    case S3_JOYSTICK_TYPE_FLIGHT_STICK:
+        return "Virtual Flight Stick";
+    case S3_JOYSTICK_TYPE_DANCE_PAD:
+        return "Virtual Dance Pad";
+    case S3_JOYSTICK_TYPE_GUITAR:
+        return "Virtual Guitar";
