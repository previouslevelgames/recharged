+S3_JoystickID* S3_GetGamepads(int* count)
+{
+    const S3_VirtualDevice* device;
+    S3_JoystickID* platform;
+    S3_JoystickID* ids;
+    int platform_count = 0;
+    int total;
+
+    if (count != NULL) {
+        *count = 0;
+    }
+
+    S3_LockJoysticks();
+
+    platform = S3_PlatformGetGamepads(&platform_count);
+    if (platform == NULL) {
+        S3_UnlockJoysticks();
+        return NULL;
+    }
+
+    // SDL3 lists virtual joysticks after the platform's.
+    total = platform_count;
+    for (device = s3_virtual_devices; device != NULL; device = device->next) {
+        total += device->is_gamepad ? 1 : 0;
+    }
+
+    ids = (S3_JoystickID*)SDL_realloc(platform, sizeof(*ids) * ((size_t)total + 1));
+    if (ids == NULL) {
+        SDL_free(platform);
+        S3_UnlockJoysticks();
+        SDL_SetError("Out of memory");
+        return NULL;
+    }
+
+    total = platform_count;
+    for (device = s3_virtual_devices; device != NULL; device = device->next) {
+        if (device->is_gamepad) {
+            ids[total++] = device->id;
+        }
+    }
+    ids[total] = 0;
+
+    S3_UnlockJoysticks();
+
+    if (count != NULL) {
+        *count = total;
+    }
+
+    return ids;
+}
