+S3_PropertiesID S3_GetGamepadProperties(S3_Gamepad* gamepad)
+{
+    S3_VirtualGamepad* virt;
+    S3_PropertiesID props;
+    bool created;
+
+    S3_LockJoysticks();
+    virt = S3_VirtualGamepadFrom(gamepad);
+    if (virt != NULL) {
+        S3_VirtualJoystick* joystick = virt->joystick;
+
+        // A gamepad shares its joystick's properties, which say what the descriptor can do.
+        props = S3_AcquireObjectProperties(joystick, &created);
+        if (props != 0 && created) {
+            if (joystick->cap_led) {
+                S3_SetBooleanProperty(props, S3_PROP_JOYSTICK_CAP_RGB_LED_BOOLEAN, true);
+            }
+            if (joystick->cap_rumble) {
+                S3_SetBooleanProperty(props, S3_PROP_JOYSTICK_CAP_RUMBLE_BOOLEAN, true);
+            }
+            if (joystick->cap_trigger_rumble) {
+                S3_SetBooleanProperty(props, S3_PROP_JOYSTICK_CAP_TRIGGER_RUMBLE_BOOLEAN, true);
+            }
+        }
+        S3_UnlockJoysticks();
+        return props;
+    }
+    S3_UnlockJoysticks();
+
+    return S3_PlatformGetGamepadProperties(gamepad);
+}
