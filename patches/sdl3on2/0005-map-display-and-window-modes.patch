+bool S3_SetWindowFullscreenMode(S3_Window* window, const S3_DisplayMode* mode)
+{
+    S3_SwitchWindow* state = S3_SwitchWindowFrom(window);
+    const S3_DisplayMode* current;
+
+    if (state == NULL) {
+        return false;
+    }
+
+    if (mode == NULL) {
+        state->has_fullscreen_mode = false;
+        return true;
+    }
+
+    // SDL3 takes only the display's own modes, and the console has the one it outputs.
+    current = S3_GetCurrentDisplayMode(S3_SWITCH_DISPLAY_ID);
