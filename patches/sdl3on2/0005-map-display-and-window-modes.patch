+bool S3_SetWindowAspectRatio(S3_Window* window, float min_aspect, float max_aspect)
+{
+    S3_WindowExtras* extras;
+    int w = 0;
+    int h = 0;
+
+    if (window == NULL) {
+        SDL_SetError("Invalid window");
+        return false;
+    }
+
+    extras = S3_GetWindowExtras(window, true);
+    if (extras == NULL) {
+        return false;
+    }
+
+    extras->min_aspect = min_aspect;
+    extras->max_aspect = max_aspect;
+
+    // As in SDL3 the windowed size follows at once; SDL2 cannot hold the user's resizing to it.
+    if ((SDL_GetWindowFlags(window) & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MAXIMIZED)) == 0) {
