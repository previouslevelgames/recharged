+bool S3_GetClosestFullscreenDisplayMode(S3_DisplayID display_id, int w, int h, float refresh_rate, bool include_high_density_modes, S3_DisplayMode* closest)
+{
+    const int index = S3_DisplayIndex(display_id);
+    const float aspect = h > 0 ? (float)w / (float)h : 1.0f;
+    SDL_DisplayMode best;
+    SDL_DisplayMode native;
+    bool found = false;
+    int count;
+    int mode;
+
+    // SDL2's modes all have a pixel density of 1.
+    (void)include_high_density_modes;
+
+    if (closest == NULL) {
+        SDL_SetError("Parameter 'closest' is invalid");
+        return false;
+    }
+
+    SDL_zerop(closest);
+
+    if (index < 0) {
+        return false;
+    }
+
+    if (refresh_rate <= 0.0f && SDL_GetCurrentDisplayMode(index, &native) == 0) {
+        refresh_rate = (float)native.refresh_rate;
+    }
+
+    // SDL2 lists modes widest first, as SDL3 searches them: the first large enough mode with the
+    // nearest shape, then the nearest refresh rate among equal sizes.
+    SDL_zero(best);
+    count = SDL_GetNumDisplayModes(index);
+    for (mode = 0; mode < count; mode++) {
+        if (SDL_GetDisplayMode(index, mode, &native) != 0) {
+            continue;
+        }
+
+        if (native.w < w) {
+            break;
+        }
+
+        if (native.h < h) {
+            continue;
+        }
+
+        if (found) {
+            const float mode_aspect = (float)native.w / (float)native.h;
+            const float best_aspect = (float)best.w / (float)best.h;
+
+            if (SDL_fabsf(aspect - best_aspect) < SDL_fabsf(aspect - mode_aspect)) {
+                continue;
+            }
+
+            if (native.w == best.w && native.h == best.h
+                && SDL_fabsf((float)best.refresh_rate - refresh_rate) < SDL_fabsf((float)native.refresh_rate - refresh_rate)) {
+                continue;
+            }
+        }
+
+        best = native;
+        found = true;
+    }
+
+    if (!found) {
+        SDL_SetError("Couldn't find any matching video modes");
+        return false;
+    }
+
+    S3_FromSDL2DisplayMode(display_id, &best, closest);
+
+    return true;
+}
