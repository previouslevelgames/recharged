+
+// The display's own mode a requested one names, as SDL3 accepts no other.
+static bool S3_FindDisplayMode(SDL_Window* window, const S3_DisplayMode* mode, SDL_DisplayMode* native)
+{
+    const int index = mode->displayID != 0 ? (int)mode->displayID - 1 : SDL_GetWindowDisplayIndex(window);
+    const int count = index >= 0 ? SDL_GetNumDisplayModes(index) : 0;
+    int candidate;
+
+    for (candidate = 0; candidate < count; candidate++) {
+        if (SDL_GetDisplayMode(index, candidate, native) == 0 && native->w == mode->w && native->h == mode->h
+            && (mode->refresh_rate <= 0.0f || native->refresh_rate == (int)SDL_roundf(mode->refresh_rate))
+            && (mode->format == S3_PIXELFORMAT_UNKNOWN || native->format == (Uint32)mode->format)) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+bool S3_SetWindowFullscreenMode(S3_Window* window, const S3_DisplayMode* mode)
+{
+    S3_WindowExtras* extras;
+    SDL_DisplayMode native;
+
+    if (window == NULL) {
+        SDL_SetError("Invalid window");
+        return false;
+    }
+
+    extras = S3_GetWindowExtras(window, true);
+    if (extras == NULL) {
+        return false;
+    }
+
+    if (mode != NULL) {
+        if (!S3_FindDisplayMode(window, mode, &native)) {
+            SDL_SetError("Invalid fullscreen display mode");
+            return false;
+        }
+
+        if (SDL_SetWindowDisplayMode(window, &native) != 0) {
+            return false;
+        }
+
+        extras->fullscreen_mode = *mode;
+        extras->has_fullscreen_mode = true;
+    } else {
+        extras->has_fullscreen_mode = false;
+    }
+
