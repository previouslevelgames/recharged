+// What SDL3 keeps for a window that SDL2 has no place for.
+typedef struct S3_WindowExtras {
+    S3_DisplayMode fullscreen_mode;
+    bool has_fullscreen_mode;
+    float min_aspect;
+    float max_aspect;
+} S3_WindowExtras;
+
+#define S3_WINDOW_EXTRAS "sdl3on2.window"
+
+static S3_WindowExtras* S3_GetWindowExtras(SDL_Window* window, bool create)
+{
+    S3_WindowExtras* extras = (S3_WindowExtras*)SDL_GetWindowData(window, S3_WINDOW_EXTRAS);
+
+    if (extras == NULL && create) {
+        extras = (S3_WindowExtras*)SDL_calloc(1, sizeof(*extras));
+        if (extras == NULL) {
+            SDL_SetError("Out of memory");
+            return NULL;
+        }
+        SDL_SetWindowData(window, S3_WINDOW_EXTRAS, extras);
+    }
+
+    return extras;
+}
+
+// SDL3 fits a size it sets to the window's aspect limits.
+static void S3_ApplyAspectLimits(SDL_Window* window, int* w, int* h)
+{
+    const S3_WindowExtras* extras = S3_GetWindowExtras(window, false);
+    float aspect;
+
+    if (extras == NULL || *h <= 0) {
+        return;
+    }
+
+    aspect = (float)*w / (float)*h;
+    if (extras->max_aspect > 0.0f && aspect > extras->max_aspect) {
+        *w = (int)SDL_roundf((float)*h * extras->max_aspect);
+    } else if (extras->min_aspect > 0.0f && aspect < extras->min_aspect) {
+        *h = (int)SDL_roundf((float)*w / extras->min_aspect);
+    }
+}
