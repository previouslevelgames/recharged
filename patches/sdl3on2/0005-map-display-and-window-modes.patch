+bool S3_SetWindowAspectRatio(S3_Window* window, float min_aspect, float max_aspect)
+{
+    const S3_SwitchWindow* state = S3_SwitchWindowFrom(window);
+    float aspect;
+
+    if (state == NULL) {
+        return false;
+    }
+
+    // The console window cannot change shape, so limits only hold if its own shape meets them.
+    aspect = (float)state->w / (float)state->h;
+    if ((max_aspect > 0.0f && aspect > max_aspect + 0.001f) || (min_aspect > 0.0f && aspect < min_aspect - 0.001f)) {
