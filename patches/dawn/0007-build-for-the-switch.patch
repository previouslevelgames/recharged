diff --git a/src/dawn/platform/WorkerThread.cpp b/src/dawn/platform/WorkerThread.cpp
index ed31457..19a02de 100644
--- a/src/dawn/platform/WorkerThread.cpp
+++ b/src/dawn/platform/WorkerThread.cpp
@@ -33,9 +33,30 @@
 
 #include "src/utils/assert.h"
 
+#if defined(__SWITCH__)
+#include <switch.h>
+#endif
+
 namespace dawn::platform {
 
 namespace {
+#if defined(__SWITCH__)
+// Cores 0-2 belong to applications; core 3 is reserved for the system.
+constexpr uint32_t kSwitchApplicationCoreMask = 0x7;
+
+void SetSwitchWorkerThreadAffinity() {
+    uint64_t processMask = 0;
+    uint32_t allowedMask = kSwitchApplicationCoreMask;
+    if (R_SUCCEEDED(svcGetInfo(&processMask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0))) {
+        allowedMask = static_cast<uint32_t>(processMask) & kSwitchApplicationCoreMask;
+        if (allowedMask == 0) {
+            allowedMask = 1u;
+        }
+    }
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, -1, allowedMask);
+}
+#endif
+
