diff --git a/lib/dolphin/gx/debug_light_log.hpp b/lib/dolphin/gx/debug_light_log.hpp
new file mode 100644
index 0000000..425fe4b
--- /dev/null
+++ b/lib/dolphin/gx/debug_light_log.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+// AURORA_DEBUG_LIGHT_LOG=1 prints every distinct lighting-related GX setting
+// the game makes (lights, channel colours/control, TEV colours) once, to
+// compare platforms. Off unless the environment variable is set.
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+
+#include <fmt/format.h>
+
+namespace aurora::gx::debug {
+inline bool light_log_enabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("AURORA_DEBUG_LIGHT_LOG");
+    return value && *value && *value != '0';
+  }();
+  return enabled;
+}
+
+template <typename... Args>
+void light_log(fmt::format_string<Args...> format, Args&&... args) {
+  if (!light_log_enabled()) return;
+  static std::mutex mutex;
+  static std::unordered_set<std::string> seen;
+  std::string line = fmt::format(format, std::forward<Args>(args)...);
+  std::lock_guard lock(mutex);
+  if (seen.size() >= 4000 || !seen.insert(line).second) return;
+  std::fprintf(stderr, "[light-log] %s\n", line.c_str());
+}
+} // namespace aurora::gx::debug
