From: mscharged-port contributors
Subject: [PATCH] VILockAspectRatio for an auto-sized framebuffer
Upstream-base: d664382f57002fbff143911c81b06b7e7a4b3ab4
Classification: host presentation (internal resolution). Apply after 0085.

vi.h declared VILockAspectRatio/VIUnlockAspectRatio without an
implementation. They now lock the shape of the auto-sized framebuffer
(scale 0) to the displayed aspect, so the EFB gets one pixel per window
pixel of a 4:3 or 16:9 picture instead of the EFB's own 640:448 shape,
and never fewer pixels than the EFB. Fixed scales keep the EFB shape.

diff --git a/lib/dolphin/vi/vi.cpp b/lib/dolphin/vi/vi.cpp
index 9ab1c6e..56e2926 100644
--- a/lib/dolphin/vi/vi.cpp
+++ b/lib/dolphin/vi/vi.cpp
@@ -590,6 +590,10 @@ void VISetWindowSize(uint32_t width, uint32_t height) { aurora::window::set_wind
 void VISetWindowPosition(uint32_t x, uint32_t y) { aurora::window::set_window_position(x, y); }
 void VICenterWindow() { aurora::window::center_window(); }
 void VISetFrameBufferScale(float scale) { aurora::window::set_frame_buffer_scale(scale); }
+void VILockAspectRatio(int width, int height) {
+  aurora::window::set_frame_buffer_locked_aspect(width > 0 && height > 0 ? static_cast<float>(width) / height : 0.f);
+}
+void VIUnlockAspectRatio() { aurora::window::set_frame_buffer_locked_aspect(0.f); }
 }
 
 #else
@@ -656,6 +660,10 @@ void VISetWindowSize(uint32_t width, uint32_t height) { aurora::window::set_wind
 void VISetWindowPosition(uint32_t x, uint32_t y) { aurora::window::set_window_position(x, y); }
 void VICenterWindow() { aurora::window::center_window(); }
 void VISetFrameBufferScale(float scale) { aurora::window::set_frame_buffer_scale(scale); }
+void VILockAspectRatio(int width, int height) {
+  aurora::window::set_frame_buffer_locked_aspect(width > 0 && height > 0 ? static_cast<float>(width) / height : 0.f);
+}
+void VIUnlockAspectRatio() { aurora::window::set_frame_buffer_locked_aspect(0.f); }
 }
 
 extern "C" {
diff --git a/lib/window.cpp b/lib/window.cpp
index 376789d..f5c85a2 100644
--- a/lib/window.cpp
+++ b/lib/window.cpp
@@ -51,6 +51,8 @@ std::atomic<uint64_t> g_windowIncarnation{};
 SDL_Renderer* g_renderer;
 float g_frameBufferScale = 0.f;
 bool g_frameBufferAspectFit = false;
+// VILockAspectRatio: shape of the auto-sized (scale 0) framebuffer, 0 = the EFB's own.
+float g_frameBufferLockedAspect = 0.f;
 AuroraWindowSize g_windowSize;
 std::vector<AuroraEvent> g_events;
 std::deque<std::string> g_eventStrings;
@@ -500,10 +502,18 @@ AuroraWindowSize get_window_size() {
   if (g_frameBufferAspectFit) {
     const auto [baseW, baseH] = vi::configured_fb_size();
     if (baseW > 0 && baseH > 0) {
-      const auto [fitW, fitH] =
-          fit_frame_buffer_to_aspect(fb_w, fb_h, static_cast<float>(baseW) / static_cast<float>(baseH));
+      // An auto-sized framebuffer locked to the displayed aspect (4:3, 16:9)
+      // gets one framebuffer pixel per window pixel of the picture, never
+      // fewer pixels than the EFB itself.
+      const bool locked = g_frameBufferScale == 0.f && g_frameBufferLockedAspect > 0.f;
+      const float aspect = locked ? g_frameBufferLockedAspect : static_cast<float>(baseW) / static_cast<float>(baseH);
+      const auto [fitW, fitH] = fit_frame_buffer_to_aspect(fb_w, fb_h, aspect);
       fb_w = fitW;
       fb_h = fitH;
+      if (locked) {
+        fb_w = std::max(fb_w, static_cast<int>(baseW));
+        fb_h = std::max(fb_h, static_cast<int>(baseH));
+      }
     }
   }
 
@@ -616,6 +626,17 @@ void set_frame_buffer_scale(float scale) {
   request_frame_buffer_resize();
 }
 
+void set_frame_buffer_locked_aspect(float aspect) {
+  if (!(aspect > 0.f)) {
+    aspect = 0.f;
+  }
+  if (g_frameBufferLockedAspect == aspect) {
+    return;
+  }
+  g_frameBufferLockedAspect = aspect;
+  request_frame_buffer_resize();
+}
+
 void set_frame_buffer_aspect_fit(bool fit) {
   if (g_frameBufferAspectFit == fit) {
     return;
diff --git a/lib/window.hpp b/lib/window.hpp
index af322d1..6683fbe 100644
--- a/lib/window.hpp
+++ b/lib/window.hpp
@@ -55,5 +55,7 @@ void request_frame_buffer_resize();
 void resize_swapchain() noexcept;
 void set_frame_buffer_scale(float scale);
 void set_frame_buffer_aspect_fit(bool fit);
+// Aspect (width / height) of the auto-sized framebuffer; 0 restores the EFB's.
+void set_frame_buffer_locked_aspect(float aspect);
 void set_background_input(bool value);
 }; // namespace aurora::window
