-typedef struct { bool widescreen; } AuroraVIOutputConfig;
+// The desktop picture is host presentation, not Wii hardware. SIGNAL
+// stretches the VI's active signal into the window like a TV; SMOOTH and
+// SHARP draw the XFB into the window in one pass (SHARP keeps each source
+// pixel flat and blends only across its edges) and skip the display copy's
+// vertical flicker filter.
+typedef enum {
+  AURORA_DESKTOP_SIGNAL = 0,
+  AURORA_DESKTOP_SMOOTH = 1,
+  AURORA_DESKTOP_SHARP = 2,
+} AuroraDesktopPicture;
+typedef struct {
+  bool widescreen;
+  uint8_t desktop_picture; // AuroraDesktopPicture
+} AuroraVIOutputConfig;
