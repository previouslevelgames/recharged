+void canonicalize_identity_texgens(ShaderConfig& config) noexcept {
+  for (size_t i = 0; i < config.tcgs.size(); ++i) {
+    auto& tcg = config.tcgs[i];
+    // A TEXn source is vec4(uv, 1, 1). With both identity selectors and no
+    // normalization, q stays 1 through the vertex shader (line/point offsets
+    // change only x/y), so the 3x4 fragment projection is redundant. A per-
+    // vertex matrix index overrides GX_IDENTITY and must remain distinct.
+    if (tcg.type == GX_TG_MTX3x4 && tcg.src >= GX_TG_TEX0 && tcg.src <= GX_TG_TEX7 &&
+        tcg.mtx == GX_IDENTITY && tcg.postMtx == GX_PTIDENTITY && !tcg.normalize &&
+        config.attrs[GX_VA_TEX0MTXIDX + i].attrType == GX_NONE) {
+      tcg.type = GX_TG_MTX2x4;
+    }
+  }
+}
