From: mscharged-port contributors
Subject: [PATCH] Fog in the lighting log and a no-fog switch
Upstream-base: d664382f57002fbff143911c81b06b7e7a4b3ab4
Classification: host diagnostics, off by default. Apply after 0079.

On macOS the lit field is still darker than Vulkan and Dolphin during live
play but not in replays, so camera-dependent fog is a candidate.
AURORA_DEBUG_LIGHT_LOG=1 now also prints every distinct GXSetFog call, and
AURORA_DEBUG_NO_FOG=1 builds pipelines without fog. Neither changes anything
when unset.

diff --git a/lib/dolphin/gx/GXPixel.cpp b/lib/dolphin/gx/GXPixel.cpp
index 952c56b..13b8d36 100644
--- a/lib/dolphin/gx/GXPixel.cpp
+++ b/lib/dolphin/gx/GXPixel.cpp
@@ -1,10 +1,13 @@
 #include "gx.hpp"
 #include "__gx.h"
+#include "debug_light_log.hpp"
 
 #include <cmath>
 
 extern "C" {
 void GXSetFog(GXFogType type, float startZ, float endZ, float nearZ, float farZ, GXColor color) {
+  aurora::gx::debug::light_log("fog type {} start {:.4g} end {:.4g} near {:.4g} far {:.4g} color {:02X}{:02X}{:02X}{:02X}",
+                               static_cast<int>(type), startZ, endZ, nearZ, farZ, color.r, color.g, color.b, color.a);
   const bool orthographic = (type & 0x08) != 0;
   f32 a;
   f32 c;
diff --git a/lib/gx/gx.cpp b/lib/gx/gx.cpp
index ecfb576..63af354 100644
--- a/lib/gx/gx.cpp
+++ b/lib/gx/gx.cpp
@@ -1,3 +1,4 @@
+#include <cstdlib>
 #include "gx.hpp"
 
 #include "pipeline.hpp"
@@ -389,7 +390,12 @@ void populate_pipeline_config(PipelineConfig& config, GXPrimitive primitive, GXV
 
   const auto& vtxFmt = g_gxState.vtxFmts[fmt];
   config.shaderConfig = {};
-  config.shaderConfig.fogType = g_gxState.fog.type;
+  // AURORA_DEBUG_NO_FOG=1 renders without fog (platform comparison only).
+  static const bool noFog = [] {
+    const char* value = std::getenv("AURORA_DEBUG_NO_FOG");
+    return value && *value && *value != '0';
+  }();
+  config.shaderConfig.fogType = noFog ? static_cast<u8>(GX_FOG_NONE) : g_gxState.fog.type;
   config.shaderConfig.fogRangeEnabled = g_gxState.fog.rangeEnabled;
   u8 vtxOffset = 0;
   for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
