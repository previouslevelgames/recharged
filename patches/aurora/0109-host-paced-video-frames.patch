+void aurora_paced_video_swap() {
+  auto& state = State();
+  AuroraVIOutputDevice output{};
+  AuroraVIScanout scanout{};
+  bool present, attached;
+  Nanoseconds interval, field;
+  {
+    std::lock_guard lock(state.mutex); RequireOwner(state);
+    if (state.active || state.callback_active)
+      throw std::logic_error("The paced video swap cannot run inside a VI interrupt callback");
+    if (!state.host_paced) throw std::logic_error("The paced video swap requires host video pacing");
+    UpdateClock(state, Clock::now());
+    // What the next retrace latches. A flush that also changes the TV mode or
+    // pan keeps the genuine retrace boundary for its whole commit.
+    present = state.flush && !state.shadow_change_mode && !(state.shadow_dirty & (Mode | Pan));
+    if (present) scanout = Scanout(state, PendingRegisters(state, true), state.retraces);
+    output = state.output_device; attached = state.output_attached;
+    interval = Nanoseconds{static_cast<int64_t>(state.pacing_interval_ns)};
+    field = FieldOffset(1, state.timing);
+  }
+  // Present outside the VI lock and any source IRQ context. A copy whose GPU
+  // work has not completed is left to the retrace, which latches this flush.
+  if (present && attached && output.prepare(output.context, &scanout)) output.commit(output.context, &scanout);
+  InterruptMask mask;
+  OSEnableInterrupts(); aurora_service_hardware(); OSDisableInterrupts();
+  // A window that presents nothing would otherwise run as fast as it can.
+  if (!aurora::window::is_presentable()) interval = std::max(interval, field);
+  if (interval.count() <= 0) {
+    std::lock_guard lock(state.mutex); state.next_frame_slot = {};
+  } else {
+    const auto now = Clock::now();
+    Clock::time_point slot;
+    {
+      std::lock_guard lock(state.mutex);
+      slot = state.next_frame_slot == Clock::time_point{} ? now + interval : state.next_frame_slot + interval;
+      // A late frame starts the cadence again from now instead of rushing to catch up.
+      if (slot < now) slot = now;
+      state.next_frame_slot = slot;
+    }
+    // Sleep in short steps that keep hardware interrupts (audio, alarms, VI)
+    // on time, as VIWaitForRetrace does; the last moment is a yield loop
+    // because a sleep can overshoot it (by up to a millisecond on Windows).
+#if defined(_WIN32)
+    constexpr auto finalSpin = std::chrono::microseconds{1500};
+#else
+    constexpr auto finalSpin = std::chrono::microseconds{250};
+#endif
+    for (auto current = Clock::now(); current < slot; current = Clock::now()) {
+      OSEnableInterrupts(); aurora_service_hardware_interrupts();
+      if (slot - Clock::now() > finalSpin)
+        std::this_thread::sleep_until(std::min(slot - finalSpin, Clock::now() + std::chrono::milliseconds{1}));
+      else std::this_thread::yield();
+      OSDisableInterrupts();
+    }
+    // A retrace that came due during the wait may hold a newer commit.
+    OSEnableInterrupts(); aurora_service_hardware(); OSDisableInterrupts();
+  }
+#ifdef AURORA_ENABLE_GX
+  aurora::gx::fifo::rebase_if_caught_up();
+#endif
+}
