index 0cc93ec..b8458b0 100644
--- a/include/aurora/gfx.h
+++ b/include/aurora/gfx.h
@@ -31,6 +31,35 @@ typedef struct {
 const AuroraStats* aurora_get_stats();
 float aurora_get_fps();
 
+// Host timings of the native GX pipeline for frame logs: totals since the
+// start, counted only while enabled (off by default). Times in nanoseconds.
+typedef struct {
+  uint64_t ownerSendNs;        // game thread: drawing its views (until the draw-done after its display copy)
+  uint64_t ownerUpdateNs;      // game thread: the rest of its frame (until the next draw-done)
+  uint64_t ownerPriorWaitNs;   // game thread: a draw-done waiting for earlier frames to finish on the GPU
+  uint64_t ownerParseWaitNs;   // game thread: a draw-done waiting for the FIFO processor to read its frame
+  uint64_t ownerDoneWaitNs;    // game thread: GXWaitDrawDone
+  uint64_t ownerRetraceWaitNs; // game thread: VIWaitForRetrace
+  uint64_t fifoParseNs;        // FIFO processor: reading GX commands (wall time)
+  uint64_t fifoParseCpuNs;     // FIFO processor: its thread's CPU time meanwhile (0 where unknown)
+  uint64_t fifoLatchNs;        // FIFO processor at a draw-done: until that frame finished on the GPU
+  uint64_t renderNs;           // render worker: all its work items, the waits below included (wall time)
+  uint64_t renderCpuNs;        // render worker: its thread's CPU time meanwhile (0 where unknown)
+  uint64_t submitNs;           // draw-done frames: finishing the command buffer and submitting it
+  uint64_t gpuWaitNs;          // draw-done frames: waiting for the GPU to finish them
+  uint64_t acquireNs;          // presents: waiting for the next window image
+  uint64_t presentNs;          // presents: the whole present work item
+  uint64_t drawDoneFrames;     // frames submitted and waited for at a draw-done
+  uint64_t emptyDrawDoneFrames; // of those, frames without a draw
+  uint64_t presents;           // window presents
+  uint64_t ownerCores[8];      // samples of the CPU core each thread ran on (cores 0-7)
+  uint64_t fifoCores[8];
+  uint64_t renderCores[8];
+} AuroraGXPhaseTimes;
+
+void aurora_set_gx_phase_timing(bool enabled);
+void aurora_get_gx_phase_times(AuroraGXPhaseTimes* times);
+
 void aurora_enable_vsync(bool enabled);
 
 // Arm actual native GX FIFO execution before reconstructed module/statics.
