diff --git a/lib/gfx/phase_times.hpp b/lib/gfx/phase_times.hpp
new file mode 100644
index 0000000..5dc197f
--- /dev/null
+++ b/lib/gfx/phase_times.hpp
@@ -0,0 +1,148 @@
+#pragma once
+
+// Host timings of the native GX pipeline's phases, for frame logs. Off by
+// default: until the host enables them each hook costs one relaxed load.
+
+#include <aurora/gfx.h>
+
+#include "../thread.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace aurora::gfx::phase_times {
+enum Counter : uint32_t {
+  OwnerSend,
+  OwnerUpdate,
+  OwnerPriorWait,
+  OwnerParseWait,
+  OwnerDoneWait,
+  OwnerRetraceWait,
+  FifoParse,
+  FifoParseCpu,
+  FifoLatch,
+  Render,
+  RenderCpu,
+  Submit,
+  GpuWait,
+  Acquire,
+  Present,
+  DrawDoneFrames,
+  EmptyDrawDoneFrames,
+  Presents,
+  CounterCount,
+};
+enum Thread : uint32_t { OwnerThread, FifoThread, RenderThread, ThreadCount };
+inline constexpr uint32_t CoreSlots = 8;
+
+inline std::atomic_bool g_enabled{false};
+inline std::atomic<uint64_t> g_counters[CounterCount]{};
+inline std::atomic<uint64_t> g_cores[ThreadCount][CoreSlots]{};
+
+inline bool enabled() noexcept { return g_enabled.load(std::memory_order_relaxed); }
+
+inline uint64_t now_ns() noexcept {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+inline void add(Counter counter, uint64_t value) noexcept {
+  g_counters[counter].fetch_add(value, std::memory_order_relaxed);
+}
+
+inline void count(Counter counter) noexcept {
+  if (enabled()) add(counter, 1);
+}
+
+inline void sample_core(Thread thread) noexcept {
+  if (!enabled()) return;
+  const int core = aurora::thread::current_core();
+  if (core >= 0 && static_cast<uint32_t>(core) < CoreSlots)
+    g_cores[thread][core].fetch_add(1, std::memory_order_relaxed);
+}
+
+// Wall time of a scope.
+class Span {
+public:
+  explicit Span(Counter counter) noexcept : m_counter(counter), m_start(enabled() ? now_ns() : 0) {}
+  ~Span() {
+    if (m_start != 0) add(m_counter, now_ns() - m_start);
+  }
+  Span(const Span&) = delete;
+  Span& operator=(const Span&) = delete;
+
+private:
+  Counter m_counter;
+  uint64_t m_start;
+};
+
+// Wall and thread CPU time of a scope; more wall than CPU time means the
+// thread waited, for a lock or for a CPU core.
+class WorkSpan {
+public:
+  WorkSpan(Counter wall, Counter cpu) noexcept : m_wall(wall), m_cpu(cpu) {
+    if (!enabled()) return;
+    m_start = now_ns();
+    m_cpuStart = aurora::thread::current_cpu_time_ns();
+  }
+  ~WorkSpan() {
+    if (m_start == 0) return;
+    add(m_wall, now_ns() - m_start);
+    const uint64_t cpu = aurora::thread::current_cpu_time_ns();
+    if (cpu > m_cpuStart && m_cpuStart != 0) add(m_cpu, cpu - m_cpuStart);
+  }
+  WorkSpan(const WorkSpan&) = delete;
+  WorkSpan& operator=(const WorkSpan&) = delete;
+
+private:
+  Counter m_wall;
+  Counter m_cpu;
+  uint64_t m_start = 0;
+  uint64_t m_cpuStart = 0;
+};
+
+// The game (GX owner) thread's own phases, between the ends of its draw-dones:
+// one ends at the draw-done after the frame's display copy (the original
+// swap_Pre), when it has drawn its views (glplatSendFrame); the other at the
+// draw-done before them (swap_Post), after the rest of its frame. The waits
+// measured in between are counted on their own, not in these phases. Owner
+// thread only.
+inline uint64_t g_ownerMark = 0;
+inline bool g_ownerCopiedDisplay = false;
+inline uint64_t g_ownerWaited = 0;
+
+inline void owner_copy_display() noexcept { g_ownerCopiedDisplay = true; }
+
+inline void owner_draw_done_begin() noexcept {
+  if (!enabled() || g_ownerMark == 0) return;
+  const uint64_t elapsed = now_ns() - g_ownerMark;
+  add(g_ownerCopiedDisplay ? OwnerSend : OwnerUpdate, elapsed > g_ownerWaited ? elapsed - g_ownerWaited : 0);
+  sample_core(OwnerThread);
+}
+
+inline void owner_mark() noexcept {
+  g_ownerMark = enabled() ? now_ns() : 0;
+  g_ownerCopiedDisplay = false;
+  g_ownerWaited = 0;
+}
+
+// A wait of the owner thread, kept out of its phases.
+class OwnerWait {
+public:
+  explicit OwnerWait(Counter counter) noexcept : m_counter(counter), m_start(enabled() ? now_ns() : 0) {}
+  ~OwnerWait() {
+    if (m_start == 0) return;
+    const uint64_t waited = now_ns() - m_start;
+    add(m_counter, waited);
+    g_ownerWaited += waited;
+  }
+  OwnerWait(const OwnerWait&) = delete;
+  OwnerWait& operator=(const OwnerWait&) = delete;
+
+private:
+  Counter m_counter;
+  uint64_t m_start;
+};
+} // namespace aurora::gfx::phase_times
