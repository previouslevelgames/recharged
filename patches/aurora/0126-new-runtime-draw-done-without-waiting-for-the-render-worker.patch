--- a/lib/gfx/frame.hpp
+++ b/lib/gfx/frame.hpp
@@ -41,8 +41,9 @@ void submit_hardware_frame_and_wait();
 // the original path (a GPU wait at every draw-done token, staging copies
 // before every pass); otherwise the new runtime runs.
 bool new_runtime() noexcept;
-// New runtime: hands the packet to the GPU without waiting for it, then waits
-// for the previous packet with GPU work (at most one frame queued behind).
+// New runtime: queues the packet on the render worker and returns; the worker
+// submits it, then waits for the previous packet with GPU work (at most one
+// frame queued behind the CPU; the two frame slots bound the recording side).
 void submit_hardware_frame();
 void end_frame(EndFrameCallback callback);
 uint32_t current_frame() noexcept;
