@@ -826,7 +826,10 @@ void submit_hardware_frame() {
     }
     g_lastWorkSubmission = std::move(submission);
   });
-  render_worker::synchronize();
+  // The game continues once the packet is queued: the render worker records
+  // and submits it before any later work, including a VI present of one of
+  // its display copies, which the VI may select only from now on.
+  xfb::publish_recorded();
 }
 
