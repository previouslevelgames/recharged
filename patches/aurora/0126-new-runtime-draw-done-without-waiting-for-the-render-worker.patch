index 044a91b..b3d705b 100644
--- a/lib/gfx/xfb.cpp
+++ b/lib/gfx/xfb.cpp
@@ -13,6 +13,7 @@
 #include <atomic>
 #include <mutex>
 #include <unordered_map>
+#include <vector>
 
 namespace aurora::gfx::xfb {
 namespace {
@@ -25,6 +26,8 @@ std::unordered_map<uint32_t, std::shared_ptr<Snapshot>> g_snapshots;
 // Newest copy per destination whose GPU work has completed. A later copy into
 // a buffer the VI is still scanning stays pending until its own completion.
 std::unordered_map<uint32_t, std::shared_ptr<Snapshot>> g_completed;
+// New runtime: copies recorded in the packet not yet queued for the GPU.
+std::vector<std::shared_ptr<Snapshot>> g_recorded;
 uint64_t g_revision = 0;
 
 struct alignas(16) CopyUniforms {
@@ -200,6 +203,7 @@ void initialize() {
 
 void shutdown() {
   std::lock_guard lock{g_mutex};
+  g_recorded.clear();
   g_completed.clear();
   for (const auto& [physical, snapshot] : g_snapshots) {
     AURORA_ASSERT(snapshot.use_count() == 1, "XFB {} still retained during graphics shutdown", physical);
@@ -265,6 +269,7 @@ void copy_from_bp(uint32_t flags) {
     std::lock_guard lock{g_mutex};
     snapshot->revision = ++g_revision;
     g_snapshots.insert_or_assign(physical, snapshot);
+    if (new_runtime()) g_recorded.push_back(snapshot);
   }
   // A scaled EFB keeps its detail for desktop pictures: copy the same source
   // rectangle at its physical size first; the original YUYV copy below still
@@ -312,6 +317,16 @@ void encode(const wgpu::CommandEncoder& encoder, wgpu::TextureView source,
   pass.End();
 }
 
+void publish_recorded() {
+  std::lock_guard lock{g_mutex};
+  for (auto& snapshot : g_recorded) {
+    snapshot->gpuComplete.store(true, std::memory_order_release);
+    auto& completed = g_completed[snapshot->physical];
+    if (!completed || completed->revision < snapshot->revision) completed = snapshot;
+  }
+  g_recorded.clear();
+}
+
 std::shared_ptr<const Snapshot> find(const void* originalDestination) {
   const uint32_t physical = OSCachedToPhysical(const_cast<void*>(originalDestination));
   std::lock_guard lock{g_mutex};
