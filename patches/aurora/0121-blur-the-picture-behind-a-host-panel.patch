+// The blurred picture behind a host panel (aurora_set_video_output_blur): the
+// desktop picture reduced to about 270 rows (each pixel the average of the
+// block it covers), then a separable Gaussian across and down. The window
+// draws the result scaled up with bilinear filtering; screenshots stay sharp.
+struct alignas(16) BlurUniforms {
+  std::array<float, 4> extent;    // output width, height; taps per axis (reduce)
+  std::array<float, 4> direction; // one texel across or down (blur); sigma, radius
+};
+static_assert(sizeof(BlurUniforms) == 32);
+constexpr uint32_t BlurRows = 270;
+constexpr float BlurSigma = 5.0f;
+constexpr auto BlurShader = R"(
+struct Blur { extent: vec4f, direction: vec4f, };
+@group(0) @binding(0) var picture: texture_2d<f32>;
+@group(0) @binding(1) var bilinear: sampler;
+@group(0) @binding(2) var<uniform> blur: Blur;
+@vertex fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
+  switch index {
+    case 0u: { return vec4f(-1.0,-1.0,0.0,1.0); }
+    case 1u: { return vec4f(3.0,-1.0,0.0,1.0); }
+    default: { return vec4f(-1.0,3.0,0.0,1.0); }
+  }
+}
+@fragment fn fragment_reduce(@builtin(position) position: vec4f) -> @location(0) vec4f {
+  // The block of the picture this pixel covers, sampled by taps x taps
+  // bilinear taps (each averages about 2x2 pixels).
+  let source = vec2f(textureDimensions(picture));
+  let block = source / blur.extent.xy;
+  let corner = floor(position.xy) * block;
+  let taps = max(i32(blur.extent.z), 1);
+  var sum = vec3f(0.0);
+  for (var y = 0; y < taps; y++) {
+    for (var x = 0; x < taps; x++) {
+      let at = corner + (vec2f(f32(x), f32(y)) + vec2f(0.5)) * block / f32(taps);
+      sum += textureSampleLevel(picture, bilinear, at / source, 0.0).rgb;
+    }
+  }
+  return vec4f(sum / f32(taps * taps), 1.0);
+}
+@fragment fn fragment_blur(@builtin(position) position: vec4f) -> @location(0) vec4f {
+  let uv = position.xy / vec2f(textureDimensions(picture));
+  let sigma = blur.direction.z;
+  let radius = i32(blur.direction.w);
+  var sum = vec3f(0.0);
+  var weights = 0.0;
+  for (var i = -radius; i <= radius; i++) {
+    let weight = exp(-f32(i * i) / (2.0 * sigma * sigma));
+    sum += weight * textureSampleLevel(picture, bilinear, uv + f32(i) * blur.direction.xy, 0.0).rgb;
+    weights += weight;
+  }
+  return vec4f(sum / weights, 1.0);
+}
+)";
