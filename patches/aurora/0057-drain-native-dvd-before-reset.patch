+    if (!m_lock.owns_lock() || s_mediaLifecycleActive) {
+      throw std::logic_error("DVD media lifecycle overlaps an existing request");
+    }
+    s_mediaLifecycleActive = true;
+  }
+  ~MediaLifecycle() { s_mediaLifecycleActive = false; }
