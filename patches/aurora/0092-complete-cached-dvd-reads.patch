+          if (read >= 0) {
+            m_driveState = DVD_STATE_END;
+            // cbForReadAsync is empty for this exact null application callback.
+            // No application callback changes thread, order or service cadence.
+            finishCommand(block, static_cast<s32>(read), static_cast<u32>(read));
+            return true; // The ready consumer may now retire block; do not read it.
+          }
+        }
       }
       if (!m_running || m_shutdown) {
