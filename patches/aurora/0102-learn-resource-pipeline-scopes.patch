+static bool seal_pipeline_generation_impl(std::optional<uint64_t> resourceScope) {
+  std::vector<HashType> generated;
+  uint64_t generation;
+  {
+    std::lock_guard lock{g_pipelineMutex};
+    if (!g_config.automaticPipelinePreparation || !g_pipelineCacheInitialized ||
+        g_pipelineDiscoveryOpen || g_pipelineCacheScheduling || g_pipelineThreadEnd) return false;
+    if (g_pipelineScope && !g_pipelineGenerationOpen) return g_pipelineResourceScope == resourceScope;
+    if (!g_pipelineGenerationOpen || !g_scopeCensusOpen) return false;
+    generated.assign(g_scopeGeneratedConfigs.begin(), g_scopeGeneratedConfigs.end());
+    generation = g_pipelineGeneration;
+    g_pipelineCacheScheduling = true;
+  }
+  try {
+    const auto scope = fingerprint_pipeline_scope(generated, resourceScope);
+    auto learned = load_scope_pipelines(scope);
+    const auto scene = scene_render_target_layout();
+    auto offscreen = scene;
+    offscreen.colorAttachmentCount = 1;
+    offscreen.sampleCount = 1;
+    detail::finalize_render_target_layout(offscreen);
+    for (const auto& pipeline : learned) {
+      std::visit([&](const auto& config) {
+        remember_pipeline_config(pipeline.type, config, current_frame(), true);
+        resolve_pipeline(pipeline.type, config, scene, PipelinePriority::Background);
+        if (offscreen.key != scene.key)
+          resolve_pipeline(pipeline.type, config, offscreen, PipelinePriority::Background);
+      }, pipeline.config);
+    }
+    std::vector<PipelineCacheWrite> writes;
+    {
+      std::lock_guard lock{g_pipelineMutex};
+      // Demands arriving during the lookup/queueing phase are included here.
+      for (const auto hash : g_scopeObservedConfigs) {
+        const auto it = g_knownPipelines.find(hash);
+        if (it != g_knownPipelines.end()) writes.push_back(make_scope_write(scope, hash, it->second));
+      }
+      // Queue before sealing: an allocation failure can retry this generation;
+      // duplicate association records are harmless. Writer never takes this lock.
+      if (g_scopePersistenceAvailable)
+        for (auto& write : writes) enqueue_pipeline_cache_write(std::move(write));
+      g_pipelineScope = scope;
+      g_pipelineResourceScope = resourceScope;
+      g_scopeCensusOpen = false;
+      g_pipelineGenerationOpen = false;
+      g_pipelineCacheScheduling = false;
+    }
+    try { if (g_pipelineTraceEnabled) {
+      std::string scopeText;
+      for (const auto byte : scope) scopeText += fmt::format("{:02x}", byte);
+      pipeline_trace("event=scope-seal generation={} frame={} scope={} identity={} resource={} generated={} learned={} observed={}",
+                     generation, current_frame(), scopeText, resourceScope ? "resources" : "generated",
+                     resourceScope.value_or(0), generated.size(), learned.size(), writes.size());
+    } } catch (...) {} // diagnostics cannot turn a successful seal into failure
+    finish_pipeline_cache_prune();
+    return true;
+  } catch (...) {
+    std::lock_guard lock{g_pipelineMutex};
+    g_pipelineCacheScheduling = false;
+    return false;
+  }
+}
+
+bool seal_pipeline_generation() {
+  return seal_pipeline_generation_impl(std::nullopt);
+}
+
+bool seal_pipeline_generation_for_resources(uint64_t resourceScope) {
+  return seal_pipeline_generation_impl(resourceScope);
 }
 
