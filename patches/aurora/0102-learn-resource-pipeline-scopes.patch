+static PipelineScope fingerprint_pipeline_scope(std::vector<HashType>& keys,
+                                                std::optional<uint64_t> resourceScope) {
+  std::ranges::sort(keys);
+  // Canonical bytes, independent of backend, AA and host integer byte order.
+  // A stable resource-ID identity also excludes inherited producer render state.
+  // Sorted generated keys remain a fallback for deterministic producers/tests.
+  std::vector<uint8_t> bytes;
+  const auto append = [&](uint64_t value) {
+    for (unsigned shift = 0; shift < 64; shift += 8) bytes.push_back(static_cast<uint8_t>(value >> shift));
+  };
+  append(0x41555253434f5045ull); // AURSCOPE
+  append(2); // scope fingerprint recipe version
+  append(gx::GXPipelineConfigVersion);
+  append(clear::ClearPipelineConfigVersion);
+  append(resourceScope.has_value() ? 1 : 0); // independent identity domains
+  if (resourceScope) {
+    append(*resourceScope);
+  } else {
+    append(keys.size());
+    for (const auto key : keys) append(key);
+  }
+  XXH128_canonical_t canonical;
+  XXH128_canonicalFromHash(&canonical, XXH3_128bits(bytes.data(), bytes.size()));
+  PipelineScope result;
+  std::memcpy(result.data(), canonical.digest, result.size());
+  return result;
+}
+
+static std::vector<KnownPipeline> load_scope_pipelines(const PipelineScope& scope) {
+  std::vector<KnownPipeline> result;
+  if (!g_scopePersistenceAvailable || g_pipelineCacheBroken) return result;
+  // The writer owns its connection after initialization. A separate read-only
+  // WAL snapshot avoids sharing statements or transactions with that thread.
+  struct ReadDb {
+    sqlite3* db = nullptr;
+    sqlite3_stmt* stmt = nullptr;
+    ~ReadDb() { if (stmt) sqlite3_finalize(stmt); if (db) sqlite3_close(db); }
+  } read;
+  const auto path = io::fs_path_to_string(io::fs_path_from_string(g_config.cachePath) / "pipeline_cache.db");
+  auto ret = sqlite3_open_v2(path.c_str(), &read.db, SQLITE_OPEN_READONLY | SQLITE_OPEN_PRIVATECACHE, nullptr);
+  if (ret == SQLITE_OK) ret = sqlite3_prepare_v2(read.db,
+      "SELECT type,config_version,config_hash FROM pipeline_scope_config WHERE scope=?", -1, &read.stmt, nullptr);
+  if (ret == SQLITE_OK) ret = sqlite3_bind_blob(read.stmt, 1, scope.data(), scope.size(), SQLITE_TRANSIENT);
+  if (ret != SQLITE_OK) {
+    Log.warn("Cannot read learned pipeline scope: {}", read.db ? sqlite3_errmsg(read.db) : "open failed");
+    return result;
+  }
+  while ((ret = sqlite3_step(read.stmt)) == SQLITE_ROW) {
+    const auto type = sqlite3_column_int(read.stmt, 0);
+    const auto version = sqlite3_column_int64(read.stmt, 1);
+    const auto hash = static_cast<HashType>(sqlite3_column_int64(read.stmt, 2));
+    std::lock_guard lock{g_pipelineMutex};
+    const auto it = g_knownPipelines.find(hash);
+    if (it != g_knownPipelines.end() && static_cast<int>(it->second.type) == type &&
+        std::visit([&](const auto& config) { return config.version == version; }, it->second.config)) {
+      result.push_back(it->second); // validated, value-only description
+    }
+  }
+  if (ret != SQLITE_DONE) {
+    Log.warn("Incomplete learned pipeline scope read: {}", sqlite3_errmsg(read.db));
+    result.clear();
+  }
+  return result;
+}
