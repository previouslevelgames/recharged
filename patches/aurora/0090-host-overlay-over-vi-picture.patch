       ~Finished() { std::lock_guard lock(state.mutex); state.servicing = false; }
@@ -487,6 +489,10 @@ void service(void*) {
         surfacePass.SetViewport(viewport.left, viewport.top, viewport.width, viewport.height, 0.0, 1.0);
         surfacePass.Draw(3);
