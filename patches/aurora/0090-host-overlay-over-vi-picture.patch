         shot = encode_screenshot(encoder, target.GetFormat(), viewport, state.copy_group, effective.black, screenshot);
diff --git a/lib/imgui.cpp b/lib/imgui.cpp
index 77f65fd..785c8de 100644
--- a/lib/imgui.cpp
+++ b/lib/imgui.cpp
@@ -1,9 +1,12 @@
 #include "imgui.hpp"
 
+#include <algorithm>
+#include <chrono>
 #include <cstddef>
 #include <cmath>
 #include <cstring>
 #include <memory>
+#include <mutex>
 #include <string>
 #include <utility>
 #include <vector>
@@ -78,6 +81,55 @@ void enqueue_texture_upload(wgpu::Buffer buffer, wgpu::TexelCopyTextureInfo dst,
 input::LayerId g_inputLayer = input::kInvalidLayerId;
 bool g_cursorManaged = false;
 
+// Host overlay: the owner thread publishes it, scanout reads it per present.
+std::mutex g_overlayMutex;
+std::shared_ptr<const Overlay> g_overlay;
+uint32_t g_overlayWidth = 0;
+uint32_t g_overlayHeight = 0;
+bool g_overlayFontsReady = false;
+std::chrono::steady_clock::time_point g_overlayFrameTime{};
+
+void set_overlay(std::shared_ptr<const Overlay> next) noexcept {
+  std::lock_guard lock(g_overlayMutex);
+  g_overlay = std::move(next);
+}
+
+void update_overlay_fonts() noexcept {
+  set_overlay(nullptr);
+  if (!g_useSdlRenderer) {
+    // Queued presentations may still draw the previous overlay with the old
+    // font texture. The renderer's device objects are rebuilt on the render
+    // worker, which owns the drawing.
+    gfx::render_worker::synchronize();
+    gfx::render_worker::enqueue_work([] { ImGui_ImplWGPU_CreateDeviceObjects(); });
+    gfx::render_worker::synchronize();
+  }
+  g_overlayFontsReady = true;
+}
+
+void begin_overlay(uint32_t width, uint32_t height) noexcept {
+  if (!g_overlayFontsReady) {
+    update_overlay_fonts();
+  }
+  ImGuiIO& io = ImGui::GetIO();
+  // Draws only: no input (the overlay never captures the game's keyboard or
+  // mouse), no settings file, and no platform backend frame, which would
+  // change the OS cursor, capture the mouse while dragging and open gamepads.
+  io.ConfigFlags |= ImGuiConfigFlags_NoMouse | ImGuiConfigFlags_NoKeyboard | ImGuiConfigFlags_NoMouseCursorChange;
+  io.IniFilename = nullptr;
+  const auto now = std::chrono::steady_clock::now();
+  const float elapsed = g_overlayFrameTime == std::chrono::steady_clock::time_point{}
+                            ? 1.0f / 60.0f
+                            : std::chrono::duration<float>(now - g_overlayFrameTime).count();
+  g_overlayFrameTime = now;
+  io.DeltaTime = std::max(elapsed, 1.0f / 1000.0f);
+  io.DisplaySize = {static_cast<float>(width), static_cast<float>(height)};
+  io.DisplayFramebufferScale = {1.0f, 1.0f};
+  g_overlayWidth = width;
+  g_overlayHeight = height;
+  ImGui::NewFrame();
+}
+
 input::EventResult input_layer_event(const input::InputEvent& event, void*) {
   using Kind = input::InputSource::Kind;
   const Kind kind = event.source.kind;
@@ -154,6 +206,8 @@ void initialize() noexcept {
 
 void shutdown() noexcept {
   ZoneScoped;
+  set_overlay(nullptr);
+  g_overlayFontsReady = false;
   input::unregister_layer(g_inputLayer);
   g_inputLayer = input::kInvalidLayerId;
   if (g_useSdlRenderer) {
@@ -280,6 +334,17 @@ void render(const wgpu::RenderPassEncoder& pass, const DrawData& drawData) noexc
   }
 }
 
+std::shared_ptr<const Overlay> overlay() noexcept {
+  std::lock_guard lock(g_overlayMutex);
+  return g_overlay;
+}
+
+namespace {
+void end_overlay() noexcept {
+  set_overlay(std::make_shared<const Overlay>(Overlay{freeze(), g_overlayWidth, g_overlayHeight}));
+}
+} // namespace
+
 ImTextureID add_texture(uint32_t width, uint32_t height, const uint8_t* data) noexcept {
   if (SDL_Renderer* renderer = window::get_sdl_renderer()) {
     SDL_Texture* texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_STATIC, width, height);
@@ -333,4 +398,10 @@ extern "C" {
 ImTextureID aurora_imgui_add_texture(uint32_t width, uint32_t height, const void* rgba8) {
   return aurora::imgui::add_texture(width, height, static_cast<const uint8_t*>(rgba8));
 }
+void aurora_imgui_begin_overlay(uint32_t surface_width, uint32_t surface_height) {
+  aurora::imgui::begin_overlay(surface_width, surface_height);
+}
+void aurora_imgui_end_overlay(void) { aurora::imgui::end_overlay(); }
+void aurora_imgui_clear_overlay(void) { aurora::imgui::set_overlay(nullptr); }
+void aurora_imgui_update_overlay_fonts(void) { aurora::imgui::update_overlay_fonts(); }
 }
