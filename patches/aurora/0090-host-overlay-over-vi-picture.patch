index a40f297..a474d1f 100644
--- a/lib/imgui.hpp
+++ b/lib/imgui.hpp
@@ -2,6 +2,7 @@
 
 #include <aurora/event.h>
 
+#include <cstdint>
 #include <memory>
 #include <utility>
 
@@ -36,4 +37,13 @@ void set_cursor_managed(bool managed) noexcept;
 void new_frame(const AuroraWindowSize& size) noexcept;
 DrawData freeze() noexcept;
 void render(const wgpu::RenderPassEncoder& pass, const DrawData& drawData) noexcept;
+
+// The host overlay drawn over the native VI desktop picture, for a surface of
+// exactly width x height pixels (see aurora_imgui_begin_overlay).
+struct Overlay {
+  DrawData drawData;
+  uint32_t width = 0;
+  uint32_t height = 0;
+};
+std::shared_ptr<const Overlay> overlay() noexcept;
 } // namespace aurora::imgui
