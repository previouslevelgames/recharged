-    enabled = state.config.interrupts_enabled();
-    output = state.output_device; output_attached = state.output_attached;
-  }
-  struct Active { Device& state; ~Active() { std::lock_guard lock(state.mutex); state.active = false; } } active{state};
-  // Hardware cause latches while the CPU or source line is masked. A failed
-  // exclusion, higher-priority selection or masked line never consumes it.
-  device.set_pending(device.context, pending);
-  if (pending && enabled) device.service(device.context);
-  // Actual GPU/window services run after source pre/post and mask restoration.
-  if (output_attached) output.service(output.context);
+    if (state.output_active || !state.output_attached) return;
+    state.output_active = true; output = state.output_device;
+  }
+  struct OutputActive {
+    Device& state;
+    ~OutputActive() { std::lock_guard lock(state.mutex); state.output_active = false; }
