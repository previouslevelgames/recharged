   { std::lock_guard lock(state.mutex); post = state.post; }
   if (post) post(count);
 }
+bool ServiceVideoInterrupts() {
+  auto& state = State();
+  AuroraVIInterruptDevice device;
+  bool pending, enabled;
+  {
+    std::lock_guard lock(state.mutex);
+    UpdateClock(state, Clock::now());
+    if (!state.initialized || state.active || state.callback_active || state.owner != std::this_thread::get_id()) return false;
+    state.active = true; device = state.interrupt_device; pending = state.interrupt;
+    enabled = state.config.interrupts_enabled();
+  }
+  struct Active { Device& state; ~Active() { std::lock_guard lock(state.mutex); state.active = false; } } active{state};
+  // Hardware cause latches while the CPU or source line is masked. A failed
+  // exclusion, higher-priority selection or masked line never consumes it.
+  device.set_pending(device.context, pending);
+  if (pending && enabled) device.service(device.context);
+  return true;
+}
 } // namespace
 
