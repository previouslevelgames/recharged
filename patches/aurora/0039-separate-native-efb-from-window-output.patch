--- a/lib/gx/fifo.cpp
+++ b/lib/gx/fifo.cpp
@@ -203,6 +203,19 @@
 
 bool native_recording_configured() noexcept { return sNativeRecording.load(std::memory_order_acquire); }
 
+void prepare_native_efb_resize() {
+  if (!native_recording_configured()) return;
+  require_owner();
+  // drain() joins the actual FIFO watermark. The owner then has exclusive
+  // access to the paused recorder until the next source command is published.
+  drain();
+  if (sHardwareFrameActive) {
+    gfx::submit_hardware_frame_and_wait();
+    sHardwareFrameActive = false;
+    clear_draw_cache(false);
+  }
+}
+
 void require_owner() {
   AURORA_ASSERT(sOwner == std::this_thread::get_id() && detail::sBufferData,
       "Native GX PE register/aperture access requires its initialized SDK owner");
