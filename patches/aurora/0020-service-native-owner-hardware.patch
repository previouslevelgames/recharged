@@ -0,0 +1,20 @@
+#ifndef AURORA_HARDWARE_H
+#define AURORA_HARDWARE_H
+
+#include <stdbool.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Optional native host hardware service. Register before original source
+// construction; unregister the exact endpoint before retiring borrowed storage.
+// The endpoint enforces owner/exclusion and retains masked or foreign input.
+typedef void (*AuroraHardwareService)(void);
+bool aurora_register_hardware_service(AuroraHardwareService service);
+bool aurora_unregister_hardware_service(AuroraHardwareService service);
+void aurora_service_hardware(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
