+extern "C" bool aurora_register_hardware_service(AuroraHardwareService service) {
+  if (!service) return false;
+  AuroraHardwareService expected = nullptr;
+  return s_hardwareService.compare_exchange_strong(expected, service, std::memory_order_acq_rel);
+}
+
+extern "C" bool aurora_unregister_hardware_service(AuroraHardwareService service) {
+  if (!service) return false;
+  return s_hardwareService.compare_exchange_strong(service, nullptr, std::memory_order_acq_rel);
+}
+
+extern "C" void aurora_service_hardware() {
+  // Optional host endpoint owns thread, exclusion and borrowed-data lifetime.
+  // Worker time queries never change ordinary clock behavior or run game code.
+  if (const auto service = s_hardwareService.load(std::memory_order_acquire)) service();
+}
