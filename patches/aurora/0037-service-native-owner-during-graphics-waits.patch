 bool aurora_unregister_hardware_service(AuroraHardwareService service);
+// Owner endpoint only: native GPU waits must not reenter VI/output rendering.
+// The registered endpoint retains its owner, mask and reentrancy policy.
+void aurora_service_hardware_owner(void);
 void aurora_service_hardware(void);
 
