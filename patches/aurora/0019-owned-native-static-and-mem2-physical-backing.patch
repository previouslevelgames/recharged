+#pragma once
+#include <dolphin/types.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+// The owner is a retained native module/resource, not an address token. Its
+// callbacks must retain/release the actual backing and must not throw. Strings
+// are copied. The caller must register before source arena capture, and drain
+// CPU/device accesses before release; this API does not schedule game code.
+typedef struct OSNativeStaticMemoryOwner {
+    const char* module_identity;
+    const char* resource_identity;
+    const void* address;
+    u32 bytes;
+    BOOL writable;
+    void* context;
+    BOOL (*retain)(void* context);
+    void (*release)(void* context);
+} OSNativeStaticMemoryOwner;
+typedef struct OSNativeStaticMemory {
+    u64 identity;
+    u32 physical_address;
+    u32 bytes;
+} OSNativeStaticMemory;
+OSNativeStaticMemory OSNativeRegisterStaticMemory(const OSNativeStaticMemoryOwner* owner);
+void OSNativeReleaseStaticMemory(OSNativeStaticMemory memory);
+// Validate the exact bank/registered extent and retain a static mapping during
+// device ownership. Zero is returned only for real SDK MEM1/MEM2 bank backing.
+u64 OSNativePinAddress(const void* address, u32 bytes, BOOL writable, u32* physical_address);
+void OSNativeUnpinAddress(u64 identity);
+#ifdef __cplusplus
+}
+#endif
