+// Host screenshot, not a Wii hardware feature. Any thread may request one; the
+// next successful Present copies its desktop signal exactly as drawn into the
+// window viewport and encodes the PNG away from presentation.
+std::mutex sScreenshotMutex;
+std::string sScreenshotPath; // UTF-8; empty while no request is pending
+std::string take_screenshot_request() {
+  std::lock_guard lock(sScreenshotMutex);
+  return std::exchange(sScreenshotPath, std::string{});
+}
+void restore_screenshot_request(const std::string& path) {
+  std::lock_guard lock(sScreenshotMutex);
+  if (sScreenshotPath.empty()) sScreenshotPath = path;
+}
+struct Screenshot {
+  std::string path;
+  wgpu::Buffer buffer;
+  uint32_t width{}, height{}, bytesPerRow{};
+  bool bgra{};
+};
+std::optional<Screenshot> encode_screenshot(const wgpu::CommandEncoder& encoder, wgpu::TextureFormat format,
+    const webgpu::Viewport& viewport, const wgpu::BindGroup& group, bool black, const std::string& path) {
+  bool bgra = false;
+  switch (format) {
+  case wgpu::TextureFormat::RGBA8Unorm: case wgpu::TextureFormat::RGBA8UnormSrgb: break;
+  case wgpu::TextureFormat::BGRA8Unorm: case wgpu::TextureFormat::BGRA8UnormSrgb: bgra = true; break;
+  default:
+    Log.warn("Screenshot skipped: unsupported surface format {}", static_cast<uint32_t>(format));
+    return std::nullopt;
+  }
+  const auto width = static_cast<uint32_t>(std::max(1L, std::lround(viewport.width)));
+  const auto height = static_cast<uint32_t>(std::max(1L, std::lround(viewport.height)));
+  const wgpu::TextureDescriptor textureDesc{.label = "Host screenshot",
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::CopySrc,
+      .dimension = wgpu::TextureDimension::e2D, .size = {width, height, 1}, .format = format, .mipLevelCount = 1,
+      .sampleCount = 1};
+  const auto texture = webgpu::g_device.CreateTexture(&textureDesc);
+  const wgpu::RenderPassColorAttachment attachment{.view = texture.CreateView(), .loadOp = wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store, .clearValue = {0.0, 0.0, 0.0, 1.0}};
+  const wgpu::RenderPassDescriptor passDesc{.label = "Host screenshot", .colorAttachmentCount = 1,
+      .colorAttachments = &attachment};
+  const auto pass = encoder.BeginRenderPass(&passDesc);
+  // Same pipeline and bound desktop signal as the surface pass, without its
+  // window placement: the image is the presented viewport only.
+  if (!black && group) {
+    pass.SetPipeline(webgpu::g_CopyPipeline); pass.SetBindGroup(0, group);
+    pass.SetViewport(0.0f, 0.0f, static_cast<float>(width), static_cast<float>(height), 0.0f, 1.0f);
+    pass.Draw(3);
+  }
+  pass.End();
+  const uint32_t bytesPerRow = (width * 4u + 255u) & ~255u;
+  const wgpu::BufferDescriptor bufferDesc{.label = "Host screenshot readback",
+      .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+      .size = static_cast<uint64_t>(bytesPerRow) * height};
+  Screenshot shot{path, webgpu::g_device.CreateBuffer(&bufferDesc), width, height, bytesPerRow, bgra};
+  const wgpu::TexelCopyTextureInfo source{.texture = texture};
+  const wgpu::TexelCopyBufferInfo destination{.layout = {.bytesPerRow = bytesPerRow, .rowsPerImage = height},
+      .buffer = shot.buffer};
+  const wgpu::Extent3D size{width, height, 1};
+  encoder.CopyTextureToBuffer(&source, &destination, &size);
+  return shot;
+}
+// Called after the frame's commands were submitted and presented.
+void finish_screenshot(const Screenshot& shot) {
+  const uint64_t size = static_cast<uint64_t>(shot.bytesPerRow) * shot.height;
+  shot.buffer.MapAsync(wgpu::MapMode::Read, 0, size, wgpu::CallbackMode::AllowSpontaneous,
+      [shot, size](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        if (status != wgpu::MapAsyncStatus::Success) {
+          Log.warn("Screenshot readback failed: {}", shot.path);
+          return;
+        }
+        const auto* mapped = static_cast<const uint8_t*>(shot.buffer.GetConstMappedRange(0, size));
+        std::vector<uint8_t> rgb(static_cast<size_t>(shot.width) * shot.height * 3);
+        for (uint32_t y = 0; y < shot.height; ++y) {
+          const uint8_t* src = mapped + static_cast<size_t>(y) * shot.bytesPerRow;
+          uint8_t* dst = rgb.data() + static_cast<size_t>(y) * shot.width * 3;
+          for (uint32_t x = 0; x < shot.width; ++x, src += 4, dst += 3) {
+            dst[0] = src[shot.bgra ? 2 : 0];
+            dst[1] = src[1];
+            dst[2] = src[shot.bgra ? 0 : 2];
+          }
+        }
+        shot.buffer.Unmap();
+        std::thread([path = shot.path, width = shot.width, height = shot.height, rgb = std::move(rgb)] {
+          const std::filesystem::path file{std::u8string(path.begin(), path.end())};
+          if (png::write_png_rgb8(file, width, height, rgb.data())) {
+            Log.info("Screenshot saved: {}", path);
+          } else {
+            Log.warn("Screenshot could not be written: {}", path);
+          }
+        }).detach();
+      });
+}
