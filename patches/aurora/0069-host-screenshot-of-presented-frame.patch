+namespace {
+// libpng reports errors with longjmp; keep this frame free of objects with
+// destructors between setjmp and the libpng calls.
+bool encode_rgb8(std::FILE* file, uint32_t width, uint32_t height, png_bytep* rows) noexcept {
+  png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+  if (png == nullptr) {
+    return false;
+  }
+  png_infop info = png_create_info_struct(png);
+  if (info == nullptr || setjmp(png_jmpbuf(png))) {
+    png_destroy_write_struct(&png, &info);
+    return false;
+  }
+  png_init_io(png, file);
+  png_set_IHDR(png, info, width, height, 8, PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT,
+               PNG_FILTER_TYPE_DEFAULT);
+  png_write_info(png, info);
+  png_write_image(png, rows);
+  png_write_end(png, nullptr);
+  png_destroy_write_struct(&png, &info);
+  return true;
+}
+} // namespace
+
+bool write_png_rgb8(const std::filesystem::path& path, uint32_t width, uint32_t height, const uint8_t* rgb) noexcept {
+  if (width == 0 || height == 0 || rgb == nullptr) {
+    return false;
+  }
+  std::vector<png_bytep> rows(height);
+  for (uint32_t y = 0; y < height; ++y) {
+    rows[y] = const_cast<png_bytep>(rgb + static_cast<size_t>(y) * width * 3);
+  }
+  auto partial = path;
+  partial += ".partial";
+#ifdef _WIN32
+  std::FILE* file = _wfopen(partial.c_str(), L"wb");
+#else
+  std::FILE* file = std::fopen(partial.c_str(), "wb");
+#endif
+  if (file == nullptr) {
+    Log.error("failed to create file: {}", io::fs_path_to_string(partial));
+    return false;
+  }
+  const bool encoded = encode_rgb8(file, width, height, rows.data());
+  const bool closed = std::fclose(file) == 0;
+  std::error_code error;
+  if (encoded && closed) {
+    std::filesystem::rename(partial, path, error);
+    if (!error) {
+      return true;
+    }
+  }
+  Log.error("failed to write PNG: {}", io::fs_path_to_string(path));
+  std::filesystem::remove(partial, error);
+  return false;
+}
