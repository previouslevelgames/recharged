+bool aurora_request_video_screenshot(const char* path) {
+  if (path == nullptr || *path == '\0') return false;
+  std::lock_guard lock(aurora::gfx::scanout::sScreenshotMutex);
+  if (!aurora::gfx::scanout::sScreenshotPath.empty()) return false;
+  aurora::gfx::scanout::sScreenshotPath = path;
+  return true;
+}
