+      uniform = webgpu::g_device.CreateBuffer(&desc); webgpu::g_queue.WriteBuffer(uniform, 0, &values, sizeof(values));
+      const std::array entries{wgpu::BindGroupEntry{.binding = 0, .textureView = snapshot->packedYuyv->sampleTextureView},
+          wgpu::BindGroupEntry{.binding = 1, .buffer = uniform, .size = sizeof(values)}};
+      const wgpu::BindGroupDescriptor groupDesc{.layout = layout, .entryCount = entries.size(), .entries = entries.data()};
