+  const AuroraVIOutputDevice endpoint{nullptr, prepare, commit, service, shutdown};
+  aurora_attach_video_output_device(&endpoint);
+  state.layout = layout; state.pipeline = pipeline; state.configured = true; state.widescreen = config->widescreen;
+  state.owner = std::this_thread::get_id(); state.pending = false; state.presentations = 0;
+}
+} // namespace
+TextureHandle rendered_signal() { auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state); return state.signal; }
+} // namespace aurora::gfx::scanout
+extern "C" {
+void aurora_configure_video_output_hardware(const AuroraVIOutputConfig* config) { aurora::gfx::scanout::configure(config); }
+bool aurora_get_video_output_state(AuroraVIOutputState* result) {
+  if (!result) return false; auto& state = aurora::gfx::scanout::State(); std::lock_guard lock(state.mutex);
+  if (!state.configured) return false;
+  *result = {state.committed.framebuffer, state.committed_snapshot ? state.committed_snapshot->revision : 0,
+      state.presentations, state.committed.retrace_count, state.committed.field, state.committed.black, state.pending};
+  return true;
+}
+}
