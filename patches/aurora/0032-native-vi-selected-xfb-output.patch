+constexpr Module Log{"aurora::vi::scanout"};
+struct alignas(16) Uniforms {
+  std::array<uint32_t, 4> signal; // active width/height, display origin
+  std::array<uint32_t, 4> display; // display size, source pan origin
+  std::array<uint32_t, 4> sample; // source pan size, physical field, interlace
+};
+static_assert(sizeof(Uniforms) == 48);
+constexpr auto Shader = R"(
+struct Uniforms { signal: vec4u, display: vec4u, source_geometry: vec4u, };
+@group(0) @binding(0) var xfb: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> vi: Uniforms;
+@vertex fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
+  switch index {
+    case 0u: { return vec4f(-1.0,-1.0,0.0,1.0); }
+    case 1u: { return vec4f(3.0,-1.0,0.0,1.0); }
+    default: { return vec4f(-1.0,3.0,0.0,1.0); }
+  }
+}
+@fragment fn fragment(@builtin(position) position: vec4f) -> @location(0) vec4f {
+  let at=vec2u(position.xy);
+  // The other physical field retains its previously scanned rows.
+  if vi.source_geometry.w!=0u && at.y%2u!=vi.source_geometry.z { discard; }
+  if any(at<vi.signal.zw) || any(at>=vi.signal.zw+vi.display.xy) {
+    return vec4f(0.0,0.0,0.0,1.0);
+  }
+  let source=(at-vi.signal.zw)*vi.source_geometry.xy/vi.display.xy+vi.display.zw;
+  let bytes=vec4i(floor(textureLoad(xfb,vec2i(i32(source.x/2u),i32(source.y)),0)*255.0+0.5));
+  let y=select(bytes.x,bytes.z,source.x%2u!=0u)-16;
+  let u=bytes.y-128; let v=bytes.w-128;
+  let rgb=vec3i(298*y+409*v,298*y-100*u-208*v,298*y+516*u);
+  return vec4f(vec3f(clamp((rgb+vec3i(128))/vec3i(256),vec3i(0),vec3i(255)))/255.0,1.0);
+}
+)";
+struct Output {
+  std::mutex mutex;
+  std::thread::id owner;
+  bool configured{}, widescreen{}, pending{}, servicing{};
+  AuroraVIScanout prepared{}, committed{};
+  std::shared_ptr<const xfb::Snapshot> prepared_snapshot, committed_snapshot;
+  uint64_t presentations{};
+  TextureHandle signal;
+  wgpu::BindGroupLayout layout;
+  wgpu::RenderPipeline pipeline;
+};
+Output& State() { static Output state; return state; }
+void RequireOwner(const Output& state) {
+  if (!state.configured || state.owner != std::this_thread::get_id())
+    throw std::logic_error("Native VI output requires its configured source owner");
+}
+void complete_gpu() {
+  struct Done { wgpu::QueueWorkDoneStatus status = wgpu::QueueWorkDoneStatus::Error; };
+  auto done = std::make_shared<Done>();
+  const auto future = webgpu::g_queue.OnSubmittedWorkDone(wgpu::CallbackMode::WaitAnyOnly,
+      [done](wgpu::QueueWorkDoneStatus status, wgpu::StringView) { done->status = status; });
+  AURORA_ASSERT(webgpu::g_instance.WaitAny(future, 5'000'000'000) == wgpu::WaitStatus::Success &&
+      done->status == wgpu::QueueWorkDoneStatus::Success, "Native VI signal GPU submission did not complete");
+  AURORA_ASSERT(webgpu::g_instance.WaitAny(webgpu::g_device.GetLostFuture(), 0) == wgpu::WaitStatus::TimedOut,
+      "Native VI signal completed on a lost device");
+}
+TextureHandle new_signal(uint32_t width, uint32_t height) {
+  const wgpu::Extent3D size{width, height, 1};
+  const wgpu::TextureDescriptor desc{.label = "Source VI active signal",
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::TextureBinding | wgpu::TextureUsage::CopySrc,
+      .dimension = wgpu::TextureDimension::e2D, .size = size, .format = wgpu::TextureFormat::RGBA8Unorm, .mipLevelCount = 1, .sampleCount = 1};
+  auto texture = webgpu::g_device.CreateTexture(&desc); auto view = texture.CreateView();
+  return std::make_shared<TextureRef>(std::move(texture), view, view, size, wgpu::TextureFormat::RGBA8Unorm, 1, GX_TF_RGBA8);
+}
+bool prepare(void*, const AuroraVIScanout* scanout) {
+  auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state);
+  state.prepared_snapshot.reset();
+  if (!scanout || !scanout->active_width || !scanout->active_height) return false;
+  if (!scanout->black) {
+    if (!scanout->framebuffer || (scanout->tv_mode & 3u) == VI_NON_INTERLACE ||
+        !scanout->vi_width || !scanout->vi_height || !scanout->pan_width || !scanout->pan_height ||
+        scanout->x_origin + scanout->vi_width > scanout->active_width ||
+        scanout->y_origin + scanout->vi_height > scanout->active_height || scanout->xfb_mode > 1) return false;
+    auto resource = xfb::find(scanout->framebuffer);
+    if (!resource || !resource->gpuComplete.load(std::memory_order_acquire) ||
+        resource->width != scanout->fb_width || resource->stride != ((scanout->fb_width + 15u) / 16u) * 32u ||
+        scanout->pan_x + scanout->pan_width > resource->width ||
+        scanout->pan_y + scanout->pan_height > resource->height) return false;
+    state.prepared_snapshot = std::move(resource);
+  }
+  state.prepared = *scanout; return true;
+}
+void commit(void*, const AuroraVIScanout* scanout) {
+  auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state);
+  AURORA_ASSERT(scanout && scanout->retrace_count == state.prepared.retrace_count &&
+      scanout->framebuffer == state.prepared.framebuffer && scanout->black == state.prepared.black,
+      "Native VI output commit does not match its actual prepared source state");
+  state.committed = *scanout; state.committed_snapshot = std::move(state.prepared_snapshot); state.pending = true;
+}
+void service(void*) {
+  auto& state = State(); AuroraVIScanout scanout;
+  std::shared_ptr<const xfb::Snapshot> snapshot; TextureHandle signal;
