+    const auto encoder = webgpu::g_device.CreateCommandEncoder();
+    const wgpu::RenderPassColorAttachment color{.view = signal->attachmentTextureView,
+        .loadOp = scanout.black ? wgpu::LoadOp::Clear : wgpu::LoadOp::Load, .storeOp = wgpu::StoreOp::Store,
+        .clearValue = {0.0, 0.0, 0.0, 1.0}};
+    const wgpu::RenderPassDescriptor passDesc{.label = "Source selected VI field",
+        .colorAttachmentCount = 1, .colorAttachments = &color};
