+    state.servicing = true; state.pending = false; scanout = state.committed;
+    snapshot = state.committed_snapshot; widescreen = state.widescreen;
+    layout = state.layout; pipeline = state.pipeline; signal = state.signal;
+    if (!signal || signal->size.width != scanout.active_width || signal->size.height != scanout.active_height)
