+
+static u32 __GXGetNumXfbLines(u32 efbHt, u32 iScale)
+{
+    u32 count;
+    u32 realHt;
+    u32 iScaleD;
+
+    count = (efbHt - 1) * 0x100;
+    realHt = (count / iScale) + 1;
+
+    iScaleD = iScale;
+
+    if (iScaleD > 0x80 && iScaleD < 0x100)
+    {
+        while (iScaleD % 2 == 0)
+        {
+            iScaleD /= 2;
+        }
+
+        if (efbHt % iScaleD == 0)
+        {
+            realHt++;
+        }
+    }
+
+    if (realHt > 0x400)
+    {
+        realHt = 0x400;
+    }
+
+    return realHt;
+}
+
+u32 GXSetDispCopyYScale(f32 vscale)
+{
+    u8 enable;
+    u32 iScale;
+    u32 ht;
+    u32 reg;
+
+    if (!std::isfinite(vscale) || vscale <= 0.f || 256.f / vscale >= 4294967296.f)
+        Log.fatal("GX display-copy scale has no native hardware word");
+    iScale = (u32)(256.0f / vscale) & 0x1FF;
+    if (iScale == 0) Log.fatal("GX display-copy scale has a zero hardware divisor");
+    enable = (iScale != 256);
+
+    reg = 0;
+    set_display_copy_field(reg, 9, 0, iScale);
+    set_display_copy_field(reg, 8, 24, 0x4E);
+    GX_WRITE_RAS_REG(reg);
+    __gx->bpSent = 1;
+    set_display_copy_field(__gx->cpDisp, 1, 10, enable);
+    ht = (u32)GET_REG_FIELD(__gx->cpDispSize, 10, 10) + 1;
+    return __GXGetNumXfbLines(ht, iScale);
+}
 
