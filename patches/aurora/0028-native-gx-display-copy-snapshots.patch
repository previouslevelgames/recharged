@@ -0,0 +1,35 @@
+#pragma once
+
+#include "texture.hpp"
+
+#include <atomic>
+#include <memory>
+
+namespace aurora::gfx::xfb {
+// Private renderer tag; it is never a GX register or a game texture format.
+inline constexpr GXTexFmt ResolveFormat = static_cast<GXTexFmt>(0x100);
+
+struct Snapshot {
+  TextureHandle packedYuyv;
+  uint32_t physical = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t stride = 0;
+  uint32_t bytes = 0;
+  uint64_t revision = 0;
+  uint64_t backingPin = 0;
+  std::atomic_bool gpuComplete = false;
+
+  ~Snapshot();
+};
+
+void initialize();
+void shutdown();
+// Called on the FIFO consumer at the original BP display-copy trigger.
+void copy_from_bp(uint32_t flags);
+void encode(const wgpu::CommandEncoder& encoder, wgpu::TextureView source,
+            Range uniforms, const TextureHandle& destination);
+// The result describes the requested destination, never the latest EFB.
+// Callers must release references before graphics/OS shutdown.
+std::shared_ptr<const Snapshot> find(const void* originalDestination);
+} // namespace aurora::gfx::xfb
diff --git a/lib/gfx/xfb.cpp b/lib/gfx/xfb.cpp
new file mode 100644
--- /dev/null
+++ b/lib/gfx/xfb.cpp
@@ -0,0 +1,294 @@
+#include "xfb.hpp"
+
+#include "recording.hpp"
+#include "resources.hpp"
+#include "../gx/gx.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <dolphin/os.h>
+#include <dolphin/os/OSNativeMemory.h>
+
+#include <array>
+#include <mutex>
+#include <unordered_map>
+
+namespace aurora::gfx::xfb {
+namespace {
+constexpr Module Log{"aurora::gx::xfb"};
+wgpu::BindGroupLayout g_layout;
+wgpu::RenderPipeline g_pipeline;
+std::mutex g_mutex;
+std::unordered_map<uint32_t, std::shared_ptr<Snapshot>> g_snapshots;
+uint64_t g_revision = 0;
+
+struct alignas(16) CopyUniforms {
+  // Native EFB origin and size of one original logical EFB pixel.
+  std::array<float, 4> source;
+  std::array<uint32_t, 4> geometry; // width, height, top clamp, bottom clamp
+  std::array<uint32_t, 4> filter;   // preceding/current/following row, EFB format
+};
+static_assert(sizeof(CopyUniforms) == 48);
+
+// Independent WGSL implementation of the display-copy hardware arithmetic.
+// The captured BP fields remain authoritative. This initial seam supports
+// progressive copies with unity Y scale, ordinary sample positions and gamma
+// 1.0; other modes fail explicitly before creating a resource.
+constexpr auto Shader = R"(
+struct CopyUniforms {
+  source: vec4f,
+  geometry: vec4u,
+  weights: vec4u,
+};
+@group(0) @binding(0) var efb: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> copy: CopyUniforms;
+
+@vertex fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
+  switch index {
+    case 0u: { return vec4f(-1.0, -1.0, 0.0, 1.0); }
+    case 1u: { return vec4f(3.0, -1.0, 0.0, 1.0); }
+    default: { return vec4f(-1.0, 3.0, 0.0, 1.0); }
+  }
+}
+
+fn read_row(x: i32, requested_y: i32) -> vec3u {
+  var y = requested_y;
+  if copy.geometry.z != 0u { y = max(y, 0); }
+  if copy.geometry.w != 0u { y = min(y, i32(copy.geometry.y) - 1); }
+  let pixel = vec2i(floor(copy.source.xy +
+      (vec2f(f32(x), f32(y)) + vec2f(0.5)) * copy.source.zw));
+  let bounded = clamp(pixel, vec2i(0), vec2i(textureDimensions(efb)) - vec2i(1));
+  let rgb = textureLoad(efb, bounded, 0).rgb;
+  let value = vec3u(floor(clamp(rgb, vec3f(0.0), vec3f(1.0)) * 255.0 + 0.5));
+  switch copy.weights.w {
+    case 1u: { return (value / vec3u(4u)) * vec3u(4u) + value / vec3u(64u); }
+    case 2u: {
+      return (value / vec3u(8u, 4u, 8u)) * vec3u(8u, 4u, 8u) +
+          value / vec3u(32u, 64u, 32u);
+    }
+    default: { return value; }
+  }
+}
+
+fn filtered(x: i32, y: i32) -> vec3i {
+  let total = read_row(x, y - 1) * copy.weights.x +
+      read_row(x, y) * copy.weights.y + read_row(x, y + 1) * copy.weights.z;
+  // The hardware accumulator divides by 64 and keeps a nine-bit result
+  // before saturating it to the eight-bit color written to XFB.
+  return vec3i(min((total / vec3u(64u)) % vec3u(512u), vec3u(255u)));
+}
+
+fn luma(rgb: vec3i) -> i32 {
+  return (66 * rgb.r + 129 * rgb.g + 25 * rgb.b + 4096 + 128) / 256;
+}
+
+@fragment fn fragment(@builtin(position) position: vec4f) -> @location(0) vec4f {
+  let pair = i32(position.x);
+  let row = i32(position.y);
+  let a = filtered(pair * 2, row);
+  let b = filtered(pair * 2 + 1, row);
+  let sum = a + b;
+  let u = (-38 * sum.r - 74 * sum.g + 112 * sum.b + 65536 + 256) / 512;
+  let v = (112 * sum.r - 94 * sum.g - 18 * sum.b + 65536 + 256) / 512;
+  return vec4f(f32(luma(a)), f32(u), f32(luma(b)), f32(v)) / 255.0;
+}
+)";
+
+uint32_t field(uint32_t word, uint32_t shift, uint32_t bits) {
+  return (word >> shift) & ((1u << bits) - 1u);
+}
+
+TextureHandle new_packed_texture(uint32_t pairs, uint32_t height) {
+  const wgpu::Extent3D size{pairs, height, 1};
+  const wgpu::TextureDescriptor descriptor{
+      .label = "Original GX display-copy YUYV snapshot",
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::TextureBinding |
+          wgpu::TextureUsage::CopySrc,
+      .dimension = wgpu::TextureDimension::e2D,
+      .size = size,
+      .format = wgpu::TextureFormat::RGBA8Unorm,
+      .mipLevelCount = 1,
+      .sampleCount = 1,
+  };
+  auto texture = webgpu::g_device.CreateTexture(&descriptor);
+  auto view = texture.CreateView();
+  return std::make_shared<TextureRef>(std::move(texture), view, view, size,
+      wgpu::TextureFormat::RGBA8Unorm, 1, ResolveFormat);
+}
+
+void complete(const std::shared_ptr<Snapshot>& snapshot) {
+  // This runs strictly after the submission containing the captured copy.
+  struct Completion { wgpu::QueueWorkDoneStatus status = wgpu::QueueWorkDoneStatus::Error; };
+  auto completion = std::make_shared<Completion>();
+  const auto future = webgpu::g_queue.OnSubmittedWorkDone(wgpu::CallbackMode::WaitAnyOnly,
+      [completion](wgpu::QueueWorkDoneStatus status, wgpu::StringView) { completion->status = status; });
+  const auto waited = webgpu::g_instance.WaitAny(future, 5'000'000'000);
+  AURORA_ASSERT(waited == wgpu::WaitStatus::Success &&
+      completion->status == wgpu::QueueWorkDoneStatus::Success,
+      "Original GX XFB GPU copy did not complete");
+  AURORA_ASSERT(webgpu::g_instance.WaitAny(webgpu::g_device.GetLostFuture(), 0) == wgpu::WaitStatus::TimedOut,
+      "Original GX XFB completed on a lost device");
+  snapshot->gpuComplete.store(true, std::memory_order_release);
+}
+} // namespace
+
+Snapshot::~Snapshot() {
+  if (backingPin != 0) OSNativeUnpinAddress(backingPin);
+}
+
+void initialize() {
+  const std::array entries{
+      wgpu::BindGroupLayoutEntry{
+          .binding = 0,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture = wgpu::TextureBindingLayout{
+              .sampleType = wgpu::TextureSampleType::UnfilterableFloat,
+              .viewDimension = wgpu::TextureViewDimension::e2D,
+          },
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 1,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .buffer = wgpu::BufferBindingLayout{.type = wgpu::BufferBindingType::Uniform},
+      },
+  };
+  const wgpu::BindGroupLayoutDescriptor layoutDescriptor{
+      .label = "Original GX display-copy layout",
+      .entryCount = entries.size(),
+      .entries = entries.data(),
+  };
+  g_layout = webgpu::g_device.CreateBindGroupLayout(&layoutDescriptor);
+  const wgpu::ShaderSourceWGSL wgsl{wgpu::ShaderSourceWGSL::Init{.code = Shader}};
+  const wgpu::ShaderModuleDescriptor shaderDescriptor{
+      .nextInChain = &wgsl,
+      .label = "Original GX display-copy hardware",
+  };
+  const auto module = webgpu::g_device.CreateShaderModule(&shaderDescriptor);
+  const wgpu::PipelineLayoutDescriptor pipelineLayoutDescriptor{
+      .bindGroupLayoutCount = 1,
+      .bindGroupLayouts = &g_layout,
+  };
+  const auto pipelineLayout = webgpu::g_device.CreatePipelineLayout(&pipelineLayoutDescriptor);
+  const wgpu::ColorTargetState color{.format = wgpu::TextureFormat::RGBA8Unorm};
+  const wgpu::FragmentState fragment{
+      .module = module,
+      .entryPoint = "fragment",
+      .targetCount = 1,
+      .targets = &color,
+  };
+  const wgpu::RenderPipelineDescriptor pipelineDescriptor{
+      .label = "Original GX display-copy YUYV",
+      .layout = pipelineLayout,
+      .vertex = wgpu::VertexState{.module = module, .entryPoint = "vertex"},
+      .primitive = wgpu::PrimitiveState{.topology = wgpu::PrimitiveTopology::TriangleList},
+      .fragment = &fragment,
+  };
+  g_pipeline = webgpu::g_device.CreateRenderPipeline(&pipelineDescriptor);
+}
+
+void shutdown() {
+  std::lock_guard lock{g_mutex};
+  for (const auto& [physical, snapshot] : g_snapshots) {
+    AURORA_ASSERT(snapshot.use_count() == 1, "XFB {} still retained during graphics shutdown", physical);
+  }
+  g_snapshots.clear();
+  g_revision = 0;
+  g_pipeline = {};
+  g_layout = {};
+}
+
+void copy_from_bp(uint32_t flags) {
+  const auto& state = gx::g_gxState;
+  const auto& registers = state.bpRegCache;
+  const uint32_t width = field(registers[0x4a], 0, 10) + 1;
+  const uint32_t height = field(registers[0x4a], 10, 10) + 1;
+  const uint32_t stride = field(registers[0x4d], 0, 10) * 32;
+  const uint32_t physical = field(registers[0x4b], 0, 24) << 5;
+  const uint32_t scale = field(registers[0x4e], 0, 9);
+  AURORA_ASSERT(scale == 256 && field(flags, 10, 1) == 0,
+      "Native XFB Y scaling remains unqualified");
+  AURORA_ASSERT(field(flags, 12, 2) == 0, "Native field-separated GX copies remain unqualified");
+  AURORA_ASSERT(field(flags, 7, 2) == 0, "Native XFB gamma other than 1.0 remains unqualified");
+  for (uint32_t reg = 1; reg <= 4; ++reg) {
+    AURORA_ASSERT(field(registers[reg], 0, 24) == 0x666666, "Native AA display-copy sample positions remain unqualified");
+  }
+  AURORA_ASSERT(width % 2 == 0 && stride >= width * 2,
+      "Native XFB odd/overlapping destination rows remain unqualified");
+  AURORA_ASSERT(state.pixelFmt == GX_PF_RGB8_Z24 || state.pixelFmt == GX_PF_RGBA6_Z24 ||
+      state.pixelFmt == GX_PF_RGB565_Z16, "Native XFB source pixel format remains unqualified");
+  const ClipRect logical{
+      .x = static_cast<int32_t>(field(registers[0x49], 0, 10)),
+      .y = static_cast<int32_t>(field(registers[0x49], 10, 10)),
+      .width = static_cast<int32_t>(width),
+      .height = static_cast<int32_t>(height),
+  };
+  const auto [fbWidth, fbHeight] = gx::logical_fb_size();
+  AURORA_ASSERT(logical.x + width <= fbWidth && logical.y + height <= fbHeight,
+      "GX display-copy source extends outside the original EFB");
+  const auto rect = gx::map_logical_scissor(logical);
+  auto snapshot = std::make_shared<Snapshot>();
+  snapshot->physical = physical;
+  snapshot->width = width;
+  snapshot->height = height;
+  snapshot->stride = stride;
+  snapshot->bytes = stride * (height - 1) + width * 2;
+  uint32_t checkedPhysical = 0;
+  snapshot->backingPin = OSNativePinAddress(OSPhysicalToCached(physical), snapshot->bytes, TRUE, &checkedPhysical);
+  AURORA_ASSERT(checkedPhysical == physical, "GX XFB physical span changed during native pinning");
+  snapshot->packedYuyv = new_packed_texture(width / 2, height);
+  const auto coeff = [&](uint32_t index) {
+    return field(registers[index < 4 ? 0x53 : 0x54], (index < 4 ? index : index - 4) * 6, 6);
+  };
+  const CopyUniforms uniforms{
+      .source = {static_cast<float>(rect.x), static_cast<float>(rect.y),
+          static_cast<float>(rect.width) / width, static_cast<float>(rect.height) / height},
+      .geometry = {width, height, field(flags, 0, 1), field(flags, 1, 1)},
+      .filter = {coeff(0) + coeff(1), coeff(2) + coeff(3) + coeff(4), coeff(5) + coeff(6),
+          static_cast<uint32_t>(state.pixelFmt)},
+  };
+  {
+    std::lock_guard lock{g_mutex};
+    snapshot->revision = ++g_revision;
+    g_snapshots.insert_or_assign(physical, snapshot);
+  }
+  const bool clear = field(flags, 11, 1) != 0;
+  resolve_pass_into_with_uniforms(snapshot->packedYuyv, rect,
+      clear && state.colorUpdate, clear && state.alphaUpdate && gx::efb_has_alpha(state.pixelFmt),
+      clear && state.depthUpdate, state.clearColor, gx::clear_depth_value(), ResolveFormat,
+      state.pixelFmt, &uniforms, sizeof(uniforms), [snapshot] { complete(snapshot); });
+}
+
+void encode(const wgpu::CommandEncoder& encoder, wgpu::TextureView source,
+            Range uniforms, const TextureHandle& destination) {
+  const std::array entries{
+      wgpu::BindGroupEntry{.binding = 0, .textureView = std::move(source)},
+      wgpu::BindGroupEntry{.binding = 1, .buffer = detail::resources().uniformBuffer,
+          .offset = uniforms.offset, .size = uniforms.size},
+  };
+  const wgpu::BindGroupDescriptor groupDescriptor{
+      .layout = g_layout, .entryCount = entries.size(), .entries = entries.data(),
+  };
+  const auto group = webgpu::g_device.CreateBindGroup(&groupDescriptor);
+  const wgpu::RenderPassColorAttachment color{
+      .view = destination->attachmentTextureView,
+      .loadOp = wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store,
+  };
+  const wgpu::RenderPassDescriptor passDescriptor{
+      .label = "Original GX XFB snapshot",
+      .colorAttachmentCount = 1,
+      .colorAttachments = &color,
+  };
+  const auto pass = encoder.BeginRenderPass(&passDescriptor);
+  pass.SetPipeline(g_pipeline);
+  pass.SetBindGroup(0, group);
+  pass.Draw(3);
+  pass.End();
+}
+
+std::shared_ptr<const Snapshot> find(const void* originalDestination) {
+  const uint32_t physical = OSCachedToPhysical(const_cast<void*>(originalDestination));
+  std::lock_guard lock{g_mutex};
+  const auto it = g_snapshots.find(physical);
+  return it == g_snapshots.end() ? nullptr : it->second;
+}
+} // namespace aurora::gfx::xfb
