+
+void GXCopyDisp(void* dest, GXBool clear)
+{
+    u32 reg;
+    u32 tempPeCtrl;
+    u32 phyAddr;
+    u8 changePeCtrl;
+
+    if (clear)
+    {
+        reg = __gx->zmode;
+        set_display_copy_field(reg, 1, 0, 1);
+        set_display_copy_field(reg, 3, 1, 7);
+        GX_WRITE_RAS_REG(reg);
+
+        reg = __gx->cmode0;
+        set_display_copy_field(reg, 1, 0, 0);
+        set_display_copy_field(reg, 1, 1, 0);
+        GX_WRITE_RAS_REG(reg);
+    }
+
+    changePeCtrl = FALSE;
+
+    if ((clear || (u32)GET_REG_FIELD(__gx->peCtrl, 3, 0) == 3) && (u32)GET_REG_FIELD(__gx->peCtrl, 1, 6) == 1)
+    {
+        changePeCtrl = TRUE;
+        tempPeCtrl = __gx->peCtrl;
+        set_display_copy_field(tempPeCtrl, 1, 6, 0);
+        GX_WRITE_RAS_REG(tempPeCtrl);
+    }
+
+    GX_WRITE_RAS_REG(__gx->cpDispSrc);
+    GX_WRITE_RAS_REG(__gx->cpDispSize);
+    GX_WRITE_RAS_REG(__gx->cpDispStride);
+
+    // Carry the original BP physical word through the canonical live native
+    // MEM1/MEM2/static mapping. The consumer validates its full write span.
+    phyAddr = OSCachedToPhysical(dest);
+    if ((phyAddr & 31u) != 0) throw std::invalid_argument("GX display-copy destination is not 32-byte aligned");
+    reg = 0;
+    set_display_copy_field(reg, 24, 0, phyAddr >> 5);
+    set_display_copy_field(reg, 8, 24, 0x4B);
+    GX_WRITE_RAS_REG(reg);
+
+    set_display_copy_field(__gx->cpDisp, 1, 11, clear);
+    set_display_copy_field(__gx->cpDisp, 1, 14, 1);
+    set_display_copy_field(__gx->cpDisp, 8, 24, 0x52);
+    GX_WRITE_RAS_REG(__gx->cpDisp);
+
+    if (clear)
+    {
+        GX_WRITE_RAS_REG(__gx->zmode);
+        GX_WRITE_RAS_REG(__gx->cmode0);
+    }
+
+    if (changePeCtrl)
+    {
+        GX_WRITE_RAS_REG(__gx->peCtrl);
+    }
+
+    __gx->bpSent = 1;
+}
 
