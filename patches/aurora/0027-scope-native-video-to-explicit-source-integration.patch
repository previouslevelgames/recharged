Subject: [PATCH] scope native video hardware to explicit source integration
Upstream-base: d664382f57002fbff143911c81b06b7e7a4b3ab4

Require an explicit native video build option and real boot configuration for
original-source startup. Preserve the earlier incomplete diagnostic VI provider
while standalone probes are migrated; it does not establish source startup or
XFB output. Disabled native hardware rejects configuration and reports inactive.

--- a/lib/dolphin/vi/vi.cpp
+++ b/lib/dolphin/vi/vi.cpp
@@ -1,3 +1,6 @@
+// Real source video hardware is opt-in while historical probes are migrated.
+// Original game boot must enable it and install explicit pre-entry settings.
+#if defined(AURORA_NATIVE_VIDEO)
 #include <dolphin/vi.h>
 #include <dolphin/os.h>
 #include <dolphin/os/OSContext.h>
@@ -336,3 +339,72 @@
 void VICenterWindow() { aurora::window::center_window(); }
 void VISetFrameBufferScale(float scale) { aurora::window::set_frame_buffer_scale(scale); }
 }
+
+#else
+#include <aurora/video.h>
+#include <stdexcept>
+#include <dolphin/vi.h>
+
+#include "../../window.hpp"
+#include "aurora/math.hpp"
+#include "vi_internal.hpp"
+
+#include <optional>
+
+namespace aurora::vi {
+std::optional<GXRenderModeObj> g_renderMode;
+
+Vec2<uint32_t> render_mode_size() noexcept {
+  if (!g_renderMode) {
+    return {640, 480};
+  }
+  return {g_renderMode->fbWidth, g_renderMode->efbHeight};
+}
+
+void configure(const GXRenderModeObj* rm) noexcept {
+  const auto oldSize = render_mode_size();
+  if (rm == nullptr) {
+    g_renderMode.reset();
+  } else {
+    g_renderMode = *rm;
+  }
+  if (render_mode_size() != oldSize) {
+    window::request_frame_buffer_resize();
+  }
+}
+
+Vec2<uint32_t> configured_fb_size() noexcept {
+  return render_mode_size();
+}
+} // namespace aurora::vi
+
+extern "C" {
+void VIInit() {}
+void VIConfigure(const GXRenderModeObj* rm) { aurora::vi::configure(rm); }
+void VIConfigurePan(u16 xOrg, u16 yOrg, u16 width, u16 height) {
+  (void)xOrg;
+  (void)yOrg;
+  (void)width;
+  (void)height;
+}
+u32 VIGetTvFormat() { return 0; }
+void VIFlush() {}
+
+void VISetWindowTitle(const char* title) { aurora::window::set_title(title); }
+void VISetWindowFullscreen(bool fullscreen) { aurora::window::set_fullscreen(fullscreen); }
+bool VIGetWindowFullscreen() { return aurora::window::get_fullscreen(); }
+void VISetWindowSize(uint32_t width, uint32_t height) { aurora::window::set_window_size(width, height); }
+void VISetWindowPosition(uint32_t x, uint32_t y) { aurora::window::set_window_position(x, y); }
+void VICenterWindow() { aurora::window::center_window(); }
+void VISetFrameBufferScale(float scale) { aurora::window::set_frame_buffer_scale(scale); }
+}
+
+extern "C" {
+void aurora_configure_video_hardware(const AuroraVIBootConfig*) {
+  throw std::logic_error("Native VI hardware is disabled in this diagnostic build");
+}
+void aurora_service_video_hardware() {}
+void aurora_shutdown_video_hardware() {}
+bool aurora_get_video_hardware_state(AuroraVIHardwareState*) { return false; }
+}
+#endif
--- a/cmake/aurora_vi.cmake
+++ b/cmake/aurora_vi.cmake
@@ -5,3 +5,8 @@
 set_target_properties(aurora_vi PROPERTIES FOLDER "aurora")
 
 target_link_libraries(aurora_vi PUBLIC aurora::core aurora::os)
+
+option(AURORA_ENABLE_NATIVE_VIDEO "Enable native VI clock and IRQ hardware (XFB output pending)" OFF)
+if(AURORA_ENABLE_NATIVE_VIDEO)
+    target_compile_definitions(aurora_vi PUBLIC AURORA_NATIVE_VIDEO=1)
+endif()
