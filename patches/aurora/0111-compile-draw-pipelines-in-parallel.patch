+// A recorded draw whose pipeline is not compiled. The draw no longer waits for
+// the compile (the encoder does), so the miss is reported when the pipeline is
+// published, with the time since the draw asked for it.
+struct DemandRequest {
+  ShaderType type;
+  uint32_t configVersion;
+  HashType configKey;
+  const void* config;
+  uint32_t configSize;
+  uint32_t frame;
+  bool learned;
+};
+struct DemandReport {
+  ShaderType type;
+  uint32_t configVersion;
+  HashType configKey;
+  std::vector<uint8_t> config;
+  uint32_t frame;
+  bool learned;
+  bool prequeued;
+  uint64_t generation;
+  uint64_t layoutKey;
+  std::chrono::steady_clock::time_point start;
+};
+static absl::flat_hash_map<PipelineRef, DemandReport> g_demandReports; // protected by g_pipelineMutex
+
+static std::optional<DemandReport> take_demand_report(PipelineRef runtimeKey) {
+  std::lock_guard lock{g_pipelineMutex};
+  const auto it = g_demandReports.find(runtimeKey);
+  if (it == g_demandReports.end()) {
+    return std::nullopt;
+  }
+  auto report = std::move(it->second);
+  g_demandReports.erase(it);
+  return report;
+}
+
+// Trace and host report of a missed draw's now compiled pipeline. The host
+// callback runs under its own lock, never g_pipelineMutex.
+static void finish_demand_report(PipelineRef runtimeKey, const DemandReport& report) {
+  const auto elapsed = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - report.start).count());
+  pipeline_trace("event=demand-miss generation={} frame={} type={} version={} config={:016x} runtime={:016x} "
+                 "layout={:016x} prequeued={} wait_ns={}", report.generation, report.frame,
+                 static_cast<uint32_t>(report.type), report.configVersion, report.configKey, runtimeKey,
+                 report.layoutKey, report.prequeued, elapsed);
+  std::lock_guard lock{g_demandMissCallbackMutex};
+  if (!g_demandMissCallback) {
+    return;
+  }
+  const AuroraPipelineDemandMiss miss{
+      .shaderType = static_cast<uint32_t>(report.type),
+      .configVersion = report.configVersion,
+      .configKey = report.configKey,
+      .config = report.config.data(),
+      .configSize = static_cast<uint32_t>(report.config.size()),
+      .frame = report.frame,
+      .compileNanoseconds = elapsed,
+      .newConfiguration = report.learned,
+  };
+  g_demandMissCallback(&miss, g_demandMissUserData);
+}
