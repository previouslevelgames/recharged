+void VIFlush() {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state);
+  if (state.dirty & Mode) state.shadow.mode = state.requested.mode;
+  if (state.dirty & Pan) {
+    state.shadow.pan_x = state.requested.pan_x; state.shadow.pan_y = state.requested.pan_y;
+    state.shadow.pan_width = state.requested.pan_width; state.shadow.pan_height = state.requested.pan_height;
+  }
+  if (state.dirty & Black) state.shadow.black = state.requested.black;
+  if (state.dirty & Buffer) state.shadow.framebuffer = state.requested.framebuffer;
+  state.shadow_dirty |= state.dirty; state.dirty = 0;
+  state.shadow_change_mode |= state.change_mode; state.change_mode = false;
+  state.next_buffer = state.requested.framebuffer; state.flush = true;
+}
+void VIWaitForRetrace() {
+  auto& state = State();
+  { std::lock_guard lock(state.mutex); RequireOwner(state);
+    if (state.active) throw std::logic_error("VIWaitForRetrace cannot sleep inside a VI interrupt callback"); }
+  InterruptMask mask;
+  const u32 count = VIGetRetraceCount();
+  do {
+    OSEnableInterrupts(); aurora_service_hardware();
+    if (count == VIGetRetraceCount()) {
+      Clock::time_point deadline;
+      { std::lock_guard lock(state.mutex); UpdateClock(state, Clock::now());
+        deadline = state.anchor + FieldOffset(state.fields + 1, state.timing); }
+      std::this_thread::sleep_until(std::min(deadline, Clock::now() + std::chrono::milliseconds{1}));
+      aurora_service_hardware();
+    }
+    OSDisableInterrupts();
+  } while (count == VIGetRetraceCount());
+}
+u32 VIGetRetraceCount() { auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state); return state.retraces; }
+u32 VIGetNextField() {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state); UpdateClock(state, Clock::now());
+  const auto mode = uint32_t(state.requested.mode.viTVmode);
+  const uint16_t display_y = (mode & 3) == VI_NON_INTERLACE ? uint16_t(state.requested.mode.viYOrigin * 2) : state.requested.mode.viYOrigin;
+  return uint32_t(!CurrentFieldFirst(state)) ^ (display_y & 1);
+}
+u32 VIGetTvFormat() {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state); return state.source_tv_mode >> 2;
+}
+u32 VIGetDTVStatus() {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state); return state.config.dtv_cable;
+}
+void* VIGetCurrentFrameBuffer() { auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state); return state.current_buffer; }
+void* VIGetNextFrameBuffer() { auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state); return state.next_buffer; }
+void VISetNextFrameBuffer(void* fb) {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state);
+  state.requested.framebuffer = fb; state.framebuffer_set = true; state.dirty |= Buffer;
+}
+void VISetBlack(bool black) {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state); state.requested.black = black; state.dirty |= Black;
+}
+VIRetraceCallback VISetPreRetraceCallback(VIRetraceCallback cb) {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state); const auto prior = state.pre; state.pre = cb; return prior;
+}
+VIRetraceCallback VISetPostRetraceCallback(VIRetraceCallback cb) {
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state); const auto prior = state.post; state.post = cb; return prior;
+}
