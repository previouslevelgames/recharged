+namespace {
+using Clock = std::chrono::steady_clock;
+using Nanoseconds = std::chrono::nanoseconds;
+// Pinned RVL VI timing[]. 27/54 MHz hardware clocks, two clocks/sample.
+struct Timing { uint16_t half_lines, half_width, active_lines; uint32_t clock_hz; };
+Timing GetTiming(uint32_t mode) {
+  switch (mode) {
+  case VI_TVMODE_NTSC_INT: case VI_TVMODE_MPAL_INT: case VI_TVMODE_EURGB60_INT:
+    return {525, 429, 240, 27000000};
+  case VI_TVMODE_NTSC_DS: case VI_TVMODE_MPAL_DS: case VI_TVMODE_EURGB60_DS:
+    return {526, 429, 240, 27000000};
+  case VI_TVMODE_PAL_INT: return {625, 432, 287, 27000000};
+  case VI_TVMODE_PAL_DS: return {624, 432, 287, 27000000};
+  case VI_TVMODE_NTSC_PROG: case VI_TVMODE_EURGB60_PROG: case VI_TVMODE(VI_MPAL, VI_PROGRESSIVE):
+    return {1050, 429, 480, 54000000};
+  default: throw std::runtime_error("Native VI timing is not implemented for this exact TV mode");
+  }
+}
+uint64_t FieldClocks(const Timing& timing) {
+  return uint64_t{timing.half_lines} * timing.half_width * 2;
+}
+Nanoseconds FieldOffset(uint64_t fields, const Timing& timing) {
+  const auto clocks = fields * FieldClocks(timing);
+  return Nanoseconds{static_cast<int64_t>((clocks / timing.clock_hz) * 1000000000ull +
+    ((clocks % timing.clock_hz) * 1000000000ull + timing.clock_hz - 1) / timing.clock_hz)};
+}
+enum Dirty : unsigned { Mode = 1, Pan = 2, Black = 4, Buffer = 8 };
+struct Registers {
+  GXRenderModeObj mode{};
+  uint16_t pan_x{}, pan_y{}, pan_width{}, pan_height{};
+  bool black{true};
+  void* framebuffer{};
+};
+struct Device {
+  std::mutex mutex;
+  AuroraVIBootConfig config{};
+  std::thread::id owner;
+  bool configured{}, initialized{}, active{}, interrupt{}, flush{}, change_mode{}, shadow_change_mode{};
+  bool framebuffer_set{}, second_field_seed{};
+  Registers requested{}, shadow{}, hardware{};
+  unsigned dirty{}, shadow_dirty{};
+  uint32_t source_tv_mode{}, retraces{};
+  void* next_buffer{};
+  void* current_buffer{};
+  VIRetraceCallback pre{}, post{};
+  Clock::time_point anchor{};
+  uint64_t fields{}, previous_fields{}, elapsed_base{}, clocks{};
+  Timing timing{}, source_timing{};
+};
+Device& State() { static Device state; return state; }
+void RequireOwner(const Device& state) {
+  if (!state.initialized || state.owner != std::this_thread::get_id())
+    throw std::logic_error("Native VI operation requires its initialized source owner");
+}
+void UpdateClock(Device& state, Clock::time_point now) {
+  if (!state.initialized) return;
+  const auto elapsed = std::chrono::duration_cast<Nanoseconds>(now - state.anchor).count();
+  state.clocks = uint64_t(elapsed / 1000000000ll) * state.timing.clock_hz +
+    uint64_t(elapsed % 1000000000ll) * state.timing.clock_hz / 1000000000ull;
+  state.fields = state.clocks / FieldClocks(state.timing);
+  if (state.fields > state.previous_fields) {
+    // Actual interrupt bits latch; missed fields never queue a fabricated
+    // sequence of source callbacks after the native exclusion is released.
+    state.interrupt = true;
+    state.previous_fields = state.fields;
+  }
+}
+bool CurrentFieldFirst(const Device& state) {
+  const auto within = state.clocks % FieldClocks(state.timing);
+  uint64_t half_line = within / (uint64_t{state.timing.half_width} * 2);
+  if ((uint32_t(state.hardware.mode.viTVmode) & 3) == VI_INTERLACE && ((state.fields + state.second_field_seed) & 1))
+    half_line += state.timing.half_lines;
+  // Source metadata can differ from flushed hardware timing after a further
+  // unflushed Configure. Original getCurrentFieldEvenOdd uses CurrTiming.
+  return half_line < state.source_timing.half_lines;
+}
+struct InterruptMask {
+  BOOL prior = OSDisableInterrupts();
+  ~InterruptMask() { OSRestoreInterrupts(prior); }
+};
+void Retrace(void*) {
+  auto& state = State();
+  VIRetraceCallback pre;
+  uint32_t count;
+  {
+    std::lock_guard lock(state.mutex);
+    UpdateClock(state, Clock::now());
+    if (!state.interrupt) return;
+    state.interrupt = false;
+    count = ++state.retraces;
+    pre = state.pre;
+  }
+  if (pre) pre(count);
+  {
+    std::lock_guard lock(state.mutex);
+    UpdateClock(state, Clock::now());
+    if (state.flush && !(state.shadow_change_mode && !CurrentFieldFirst(state))) {
+      // Blank register/clock startup is supported. Never publish nonblack
+      // readiness until actual native GX-to-XFB output/scanout is implemented.
+      if (!state.shadow.black)
+        throw std::runtime_error("Native VI nonblack XFB scanout is not implemented");
+      if (state.shadow_dirty & Mode) {
+        const auto old_mode = uint32_t(state.hardware.mode.viTVmode);
+        const auto new_mode = uint32_t(state.shadow.mode.viTVmode);
+        if (old_mode != new_mode) {
+          const auto boundary = state.anchor + FieldOffset(state.fields, state.timing);
+          const auto first = CurrentFieldFirst(state);
+          state.elapsed_base += state.fields;
+          state.timing = GetTiming(new_mode);
+          state.anchor = boundary;
+          state.fields = state.previous_fields = 0;
+          state.second_field_seed = (new_mode & 3) == VI_INTERLACE && !first;
+        }
+        state.hardware.mode = state.shadow.mode;
+      }
+      if (state.shadow_dirty & Pan) {
+        state.hardware.pan_x = state.shadow.pan_x; state.hardware.pan_y = state.shadow.pan_y;
+        state.hardware.pan_width = state.shadow.pan_width; state.hardware.pan_height = state.shadow.pan_height;
+      }
+      if (state.shadow_dirty & Black) state.hardware.black = state.shadow.black;
+      if (state.shadow_dirty & Buffer) state.hardware.framebuffer = state.shadow.framebuffer;
+      // VISetRegs uses latest HorVer metadata but commits flushed registers.
+      // Preserve this source configure-after-flush quirk instead of repairing it.
+      state.source_tv_mode = uint32_t(state.requested.mode.viTVmode);
+      state.source_timing = GetTiming(state.source_tv_mode);
+      state.current_buffer = state.next_buffer;
+      state.shadow_dirty = 0; state.shadow_change_mode = false; state.flush = false;
+      UpdateClock(state, Clock::now());
+      aurora::vi::configure(&state.hardware.mode);
+    }
+  }
+  // The original driver clears the temporary context between pre and post.
+  OSClearContext(OSGetCurrentContext());
+  VIRetraceCallback post;
+  { std::lock_guard lock(state.mutex); post = state.post; }
+  if (post) post(count);
+}
