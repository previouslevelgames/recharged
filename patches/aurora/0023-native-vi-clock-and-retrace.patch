+void aurora_configure_video_hardware(const AuroraVIBootConfig* config) {
+  if (!config || !config->interrupts_enabled || !config->dispatch_interrupt)
+    throw std::invalid_argument("Native VI requires explicit system preferences and IRQ/context providers");
+  GetTiming(config->boot_tv_mode);
+  auto& state = State();
+  std::lock_guard lock(state.mutex);
+  if (state.configured) throw std::logic_error("Native VI hardware is already configured");
+  state.config = *config; state.owner = std::this_thread::get_id(); state.configured = true;
+}
+void aurora_service_video_hardware() {
+  auto& state = State();
+  bool (*dispatch)(void (*)(void*), void*);
+  {
+    std::lock_guard lock(state.mutex);
+    UpdateClock(state, Clock::now());
+    if (!state.initialized || !state.interrupt || state.active ||
+        state.owner != std::this_thread::get_id() || !state.config.interrupts_enabled()) return;
+    state.active = true; dispatch = state.config.dispatch_interrupt;
+  }
+  struct Active { Device& state; ~Active() { std::lock_guard lock(state.mutex); state.active = false; } } active{state};
+  // Failed exclusion or masked dispatch retains the native latched IRQ.
+  dispatch(Retrace, nullptr);
+}
+void aurora_shutdown_video_hardware() {
+  auto& state = State();
+  std::lock_guard lock(state.mutex);
+  if (!state.configured) return;
+  if (state.owner != std::this_thread::get_id() || state.active)
+    throw std::logic_error("Cannot retire foreign or active native VI callbacks");
+  state.initialized = state.configured = state.interrupt = state.flush = false;
+  state.config = {}; state.owner = {}; state.pre = state.post = nullptr;
+  state.current_buffer = state.next_buffer = nullptr;
+  aurora::vi::configure(nullptr);
+}
+bool aurora_get_video_hardware_state(AuroraVIHardwareState* result) {
+  if (!result) return false;
+  auto& state = State();
+  std::lock_guard lock(state.mutex);
+  if (!state.initialized) return false;
+  UpdateClock(state, Clock::now());
+  *result = {uint32_t(state.hardware.mode.viTVmode), state.source_tv_mode, state.retraces,
+    state.elapsed_base + state.fields, state.hardware.black, state.interrupt, state.flush,
+    state.current_buffer, state.next_buffer};
+  return true;
+}
+void VIInit() {
+  auto& state = State();
+  std::lock_guard lock(state.mutex);
+  if (!state.configured || state.owner != std::this_thread::get_id())
+    throw std::logic_error("Original VIInit requires pre-entry native video hardware configuration");
+  if (state.initialized) return;
+  state.timing = state.source_timing = GetTiming(state.config.boot_tv_mode);
+  Registers boot{};
+  boot.mode.viTVmode = VITVMode(state.config.boot_tv_mode);
+  boot.mode.fbWidth = boot.mode.viWidth = 640;
+  boot.mode.efbHeight = boot.mode.xfbHeight = boot.mode.viHeight = state.timing.active_lines * 2;
+  boot.mode.viXOrigin = 40; boot.mode.xFBmode = VI_XFBMODE_SF;
+  boot.pan_width = 640; boot.pan_height = boot.mode.xfbHeight;
+  state.requested = state.shadow = state.hardware = boot;
+  state.dirty = state.shadow_dirty = 0;
+  state.change_mode = state.shadow_change_mode = state.framebuffer_set = state.second_field_seed = false;
+  state.source_tv_mode = state.config.boot_tv_mode; state.retraces = 0;
+  state.fields = state.previous_fields = state.elapsed_base = state.clocks = 0;
+  state.interrupt = state.flush = false; state.current_buffer = state.next_buffer = nullptr;
+  state.pre = state.post = nullptr; state.anchor = Clock::now(); state.initialized = true;
+  aurora::vi::configure(&boot.mode);
+}
+void VIConfigure(const GXRenderModeObj* rm) {
+  if (!rm) throw std::invalid_argument("Original VIConfigure requires a real mode");
+  auto& state = State(); InterruptMask mask;
+  std::lock_guard lock(state.mutex); RequireOwner(state);
+  auto mode = *rm;
+  const uint32_t boot = state.config.boot_tv_mode >> 2, requested = uint32_t(mode.viTVmode) >> 2;
+  const bool compatible = ((boot == VI_NTSC || boot == VI_MPAL) && (requested == VI_NTSC || requested == VI_MPAL)) ||
+    ((boot == VI_PAL || boot == VI_EURGB60) && (requested == VI_PAL || requested == VI_EURGB60));
+  if (!compatible) throw std::runtime_error("VIConfigure requested a forbidden boot-region TV mode transition");
+  if (requested == VI_NTSC || requested == VI_MPAL) mode.viTVmode = VITVMode(VI_TVMODE(boot, uint32_t(mode.viTVmode) & 3));
+  GetTiming(uint32_t(mode.viTVmode));
+  if ((uint32_t(state.requested.mode.viTVmode) & 3) != (uint32_t(mode.viTVmode) & 3)) state.change_mode = true;
+  state.requested.mode = mode;
+  state.requested.pan_x = state.requested.pan_y = 0;
+  state.requested.pan_width = mode.fbWidth; state.requested.pan_height = mode.xfbHeight;
+  state.dirty |= Mode | Pan | Black;
+  if (state.framebuffer_set) state.dirty |= Buffer;
