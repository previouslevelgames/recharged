+
+// Explicit forensic opt-in: AURORA_PIPELINE_TRACE is a UTF-8 output file path.
+// Text contains keys/metadata only; full config values remain in pipeline_cache.db.
+// The independent trace lock never encloses pipeline-cache or driver operations.
+static std::atomic_bool g_pipelineTraceEnabled = false;
+static std::mutex g_pipelineTraceMutex;
+static std::ofstream g_pipelineTraceFile;
+
+template <typename... Args>
+static void pipeline_trace(fmt::format_string<Args...> format, Args&&... args) noexcept {
+  if (!g_pipelineTraceEnabled.load(std::memory_order_relaxed)) return;
+  try {
+    std::lock_guard lock{g_pipelineTraceMutex};
+    g_pipelineTraceFile << fmt::format(format, std::forward<Args>(args)...) << '\n';
+    g_pipelineTraceFile.flush(); // preserve evidence if a child exits abnormally
+    if (!g_pipelineTraceFile) g_pipelineTraceEnabled = false;
+  } catch (...) {
+    g_pipelineTraceEnabled = false; // diagnostics must never change game behavior
+  }
+}
+
+static void initialize_pipeline_trace() noexcept {
+  const char* path = std::getenv("AURORA_PIPELINE_TRACE");
+  if (!path || !*path) return;
+  try {
+    std::lock_guard lock{g_pipelineTraceMutex};
+    g_pipelineTraceFile.clear();
+    g_pipelineTraceFile.open(io::fs_path_from_string(path), std::ios::out | std::ios::app);
+    g_pipelineTraceEnabled = static_cast<bool>(g_pipelineTraceFile);
+  } catch (...) {
+    g_pipelineTraceEnabled = false;
+  }
+  if (!g_pipelineTraceEnabled) {
+    Log.warn("Cannot open requested pipeline trace file '{}'; tracing disabled", path);
+  }
+  pipeline_trace("event=session backend={} automatic={}", static_cast<uint32_t>(webgpu::g_backendType),
+                 g_config.automaticPipelinePreparation);
+}
+
+static void shutdown_pipeline_trace() noexcept {
+  g_pipelineTraceEnabled = false;
+  try {
+    std::lock_guard lock{g_pipelineTraceMutex};
+    g_pipelineTraceFile.close();
+  } catch (...) {}
+}
+
+struct PipelineTraceIdentity {
+  ShaderType type;
+  HashType configKey;
+  uint32_t version;
+  uint64_t layoutKey;
+};
 
