+namespace texture {
+std::string debug_describe_texture(u32 index) {
+  if (index >= MaxTextures) {
+    return "invalid";
+  }
+  const GXTexObj_& obj = g_gxState.loadedTextures[index];
+  const auto& bind = g_gxState.textures[index];
+  std::string out = fmt::format("map {} data {} {}x{} fmt {} mips {} id {} ver {} tlut {} wrap {}/{} filt {}/{}", index,
+                                obj.data, obj.width(), obj.height(), obj.format(), obj.mip_count(), obj.texObjId,
+                                obj.texDataVersion, static_cast<int>(obj.tlut), static_cast<int>(obj.wrap_s()),
+                                static_cast<int>(obj.wrap_t()), static_cast<int>(obj.min_filter()),
+                                static_cast<int>(obj.mag_filter()));
+  if (bind.ref) {
+    out += fmt::format(" | bound {} {}x{} wgpu {} gx {}", static_cast<const void*>(bind.ref.get()),
+                       bind.ref->size.width, bind.ref->size.height, static_cast<int>(bind.ref->format),
+                       bind.ref->gxFormat);
+  } else {
+    out += " | bound none";
+  }
+  if (const auto copyIt = g_gxState.copyTextures.find(obj.data); copyIt != g_gxState.copyTextures.end()) {
+    out += fmt::format(" | efb-copy {} rev {}", static_cast<const void*>(copyIt->second.handle.get()),
+                       copyIt->second.revision);
+    return out;
+  }
+  if (!obj.has_data() || texture_source_size(obj.format(), obj.width(), obj.height(), obj.mip_count()) == 0) {
+    return out + " | no data";
+  }
+  const GXTlutObj_* tlut = nullptr;
+  if (is_palette_format(obj.format())) {
+    const auto tlutIdx = static_cast<size_t>(obj.tlut);
+    if (tlutIdx >= g_gxState.loadedTluts.size() || g_gxState.loadedTluts[tlutIdx].data == nullptr) {
+      return out + " | palette without tlut";
+    }
+    tlut = &g_gxState.loadedTluts[tlutIdx];
+  }
+  const auto keys = hash_texture_source(obj, tlut, false);
+  const auto cached = s_contentCache.find(keys.contentKey);
+  const char* status = cached == s_contentCache.end()   ? "RAM-CHANGED(not cached)"
+                       : cached->second.handle == bind.ref ? "fresh"
+                                                           : "RAM-CHANGED(other handle)";
+  out += fmt::format(" | ram {:016x} {}", keys.contentKey.textureHash.low64, status);
+
+  const size_t sourceBytes = texture_source_size(obj.format(), obj.width(), obj.height(), 1);
+  const ArrayRef<uint8_t> source{static_cast<const uint8_t*>(obj.data), sourceBytes};
+  gfx::ConvertedTexture converted;
+  if (tlut != nullptr) {
+    converted = gfx::convert_texture_palette(obj.format(), obj.width(), obj.height(), 1, source, tlut->format,
+                                             tlut->numEntries,
+                                             {static_cast<const uint8_t*>(tlut->data), tlut_source_size(tlut->numEntries)});
+  } else {
+    converted = gfx::convert_texture(obj.format(), obj.width(), obj.height(), 1, source);
+  }
+  const size_t texels = static_cast<size_t>(obj.width()) * obj.height();
+  if (converted.format == wgpu::TextureFormat::RGBA8Unorm && texels != 0 && converted.data.size() >= texels * 4) {
+    std::array<uint64_t, 4> sum{};
+    std::array<uint8_t, 4> lo{255, 255, 255, 255};
+    std::array<uint8_t, 4> hi{};
+    for (size_t t = 0; t < texels; ++t) {
+      for (size_t c = 0; c < 4; ++c) {
+        const uint8_t v = converted.data.data()[t * 4 + c];
+        sum[c] += v;
+        lo[c] = std::min(lo[c], v);
+        hi[c] = std::max(hi[c], v);
+      }
+    }
+    out += fmt::format(" | avg {} {} {} {} min {} {} {} {} max {} {} {} {}", sum[0] / texels, sum[1] / texels,
+                       sum[2] / texels, sum[3] / texels, lo[0], lo[1], lo[2], lo[3], hi[0], hi[1], hi[2], hi[3]);
+  }
+  return out;
+}
+} // namespace texture
 } // namespace aurora::gx
