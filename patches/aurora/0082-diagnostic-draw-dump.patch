diff --git a/lib/gx/draw_dump.cpp b/lib/gx/draw_dump.cpp
new file mode 100644
index 0000000..8e8496a
--- /dev/null
+++ b/lib/gx/draw_dump.cpp
@@ -0,0 +1,157 @@
+#include "draw_dump.hpp"
+
+#include "../gfx/recording.hpp"
+#include "pipeline.hpp"
+#include "shader_info.hpp"
+#include "texture.hpp"
+
+#include <fmt/format.h>
+
+#include <atomic>
+#include <cstdio>
+#include <mutex>
+#include <string>
+
+// Diagnostic: aurora_debug_request_draw_dump(path) writes the complete GX state
+// of every draw (and every EFB copy) between the next two display copies to a
+// text file, to compare one frame between runs and platforms.
+namespace aurora::gx::debug {
+namespace {
+std::mutex s_requestMutex;
+std::string s_requestPath;
+std::atomic<bool> s_requested{false};
+std::FILE* s_file = nullptr;
+uint32_t s_drawIndex = 0;
+
+std::string vec4(const Vec4<float>& v) { return fmt::format("{:.4f} {:.4f} {:.4f} {:.4f}", v[0], v[1], v[2], v[3]); }
+std::string vec3(const Vec4<float>& v) { return fmt::format("{:.6g} {:.6g} {:.6g}", v[0], v[1], v[2]); }
+} // namespace
+
+bool draw_dump_active() noexcept { return s_file != nullptr; }
+
+void draw_dump_display_copy() noexcept {
+  if (s_file != nullptr) {
+    std::fprintf(s_file, "== display copy: end of dumped frame (%u draws)\n", s_drawIndex);
+    std::fclose(s_file);
+    s_file = nullptr;
+    std::fprintf(stderr, "Draw dump written.\n");
+    return;
+  }
+  if (!s_requested.exchange(false)) {
+    return;
+  }
+  std::string path;
+  {
+    std::lock_guard lock{s_requestMutex};
+    path = s_requestPath;
+  }
+  s_file = std::fopen(path.c_str(), "w");
+  if (s_file == nullptr) {
+    std::fprintf(stderr, "Draw dump: cannot open %s\n", path.c_str());
+    return;
+  }
+  s_drawIndex = 0;
+  std::fprintf(s_file, "== draw dump, frame after display copy\n");
+}
+
+void draw_dump_copy(const void* dest, bool clear) noexcept {
+  if (s_file == nullptr) {
+    return;
+  }
+  const auto& s = g_gxState;
+  std::fprintf(s_file, "-- efb copy to %p src %d,%d %dx%d dst %ux%u fmt %d clear %d colorUpd %d alphaUpd %d pixFmt %d clr %s\n",
+               dest, s.texCopySrc.x, s.texCopySrc.y, s.texCopySrc.width, s.texCopySrc.height, s.texCopyDstWidth,
+               s.texCopyDstHeight, static_cast<int>(s.texCopyFmt), clear, s.colorUpdate, s.alphaUpdate,
+               static_cast<int>(s.pixelFmt), vec4(s.clearColor).c_str());
+}
+
+void draw_dump_draw(GXPrimitive prim, u16 vtxCount, const PipelineConfig& config, const ShaderInfo& info) noexcept {
+  if (s_file == nullptr) {
+    return;
+  }
+  const auto& s = g_gxState;
+  const auto& sc = config.shaderConfig;
+  const auto target = gfx::get_render_target_size();
+  std::string out = fmt::format(
+      "## draw {} prim {} vtx {} target {}x{} | blend {} {} {} op {} | z cmp {} upd {} func {} | upd c {} a {} dstA {} "
+      "| cull {} | pixFmt {} | tev {} chans {} texgens {} ind {} fog {} coplanar {}\n",
+      s_drawIndex++, static_cast<int>(prim), vtxCount, target.x, target.y, static_cast<int>(config.blendMode),
+      static_cast<int>(config.blendFacSrc), static_cast<int>(config.blendFacDst), static_cast<int>(config.blendOp),
+      config.depthCompare, config.depthUpdate, static_cast<int>(config.depthFunc), config.colorUpdate,
+      config.alphaUpdate, config.dstAlpha, static_cast<int>(config.cullMode), static_cast<int>(s.pixelFmt),
+      sc.tevStageCount, s.numChans, s.numTexGens, sc.numIndStages, static_cast<int>(sc.fogType),
+      static_cast<int>(sc.coPlanar));
+  for (u32 i = 0; i < sc.tevStageCount; ++i) {
+    const auto& t = sc.tevStages[i];
+    out += fmt::format(
+        "  tev{} c {} {} {} {} op {} bias {} scale {} clamp {} -> {} | a {} {} {} {} op {} bias {} scale {} clamp {} -> "
+        "{} | ksel {} {} | tc {} map {} chan {} swap {} {} | ind stage {} mtx {}\n",
+        i, static_cast<int>(t.colorPass.a), static_cast<int>(t.colorPass.b), static_cast<int>(t.colorPass.c),
+        static_cast<int>(t.colorPass.d), static_cast<int>(t.colorOp.op), static_cast<int>(t.colorOp.bias),
+        static_cast<int>(t.colorOp.scale), t.colorOp.clamp, static_cast<int>(t.colorOp.outReg),
+        static_cast<int>(t.alphaPass.a), static_cast<int>(t.alphaPass.b), static_cast<int>(t.alphaPass.c),
+        static_cast<int>(t.alphaPass.d), static_cast<int>(t.alphaOp.op), static_cast<int>(t.alphaOp.bias),
+        static_cast<int>(t.alphaOp.scale), t.alphaOp.clamp, static_cast<int>(t.alphaOp.outReg),
+        static_cast<int>(t.kcSel), static_cast<int>(t.kaSel), static_cast<int>(t.texCoordId),
+        static_cast<int>(t.texMapId), static_cast<int>(t.channelId), static_cast<int>(t.tevSwapRas),
+        static_cast<int>(t.tevSwapTex), static_cast<int>(t.indTexStage), static_cast<int>(t.indTexMtxId));
+  }
+  GX::LightMask usedLights;
+  for (u32 i = 0; i < sc.colorChannels.size(); ++i) {
+    const auto& cc = sc.colorChannels[i];
+    const auto& cs = s.colorChannelState[i];
+    out += fmt::format("  chan{} light {} mat {} amb {} diff {} attn {} mask {:02x} | mat {} | amb {}\n", i,
+                       cc.lightingEnabled, static_cast<int>(cc.matSrc), static_cast<int>(cc.ambSrc),
+                       static_cast<int>(cc.diffFn), static_cast<int>(cc.attnFn), cs.lightMask.to_ulong(),
+                       vec4(cs.matColor), vec4(cs.ambColor));
+    if (cc.lightingEnabled) {
+      usedLights |= cs.lightMask;
+    }
+  }
+  for (u32 i = 0; i < GX::MaxLights; ++i) {
+    if (!usedLights.test(i)) {
+      continue;
+    }
+    const auto& l = s.lights[i];
+    out += fmt::format("  light{} color {} | pos {} | dir {} | cos {} | dist {}\n", i, vec4(l.color), vec3(l.pos),
+                       vec3(l.dir), vec3(l.cosAtt), vec3(l.distAtt));
+  }
+  for (u32 i = 0; i < info.loadsTevReg.size(); ++i) {
+    if (info.loadsTevReg.test(i)) {
+      out += fmt::format("  reg{} {}\n", i, vec4(s.colorRegs[i]));
+    }
+  }
+  for (u32 i = 0; i < info.sampledKColors.size(); ++i) {
+    if (info.sampledKColors.test(i)) {
+      out += fmt::format("  k{} {}\n", i, vec4(s.kcolors[i]));
+    }
+  }
+  for (u32 i = 0; i < sc.tcgs.size(); ++i) {
+    const auto& tcg = sc.tcgs[i];
+    if (tcg.src == GX_MAX_TEXGENSRC) {
+      continue;
+    }
+    out += fmt::format("  tcg{} type {} src {} mtx {} post {} norm {}\n", i, static_cast<int>(tcg.type),
+                       static_cast<int>(tcg.src), static_cast<int>(tcg.mtx), static_cast<int>(tcg.postMtx),
+                       tcg.normalize);
+  }
+  for (u32 i = 0; i < info.sampledTextures.size(); ++i) {
+    if (info.sampledTextures.test(i)) {
+      out += "  tex " + texture::debug_describe_texture(i) + "\n";
+    }
+  }
+  std::fputs(out.c_str(), s_file);
+}
+} // namespace aurora::gx::debug
+
+extern "C" bool aurora_debug_request_draw_dump(const char* path) {
+  if (path == nullptr || *path == '\0') {
+    return false;
+  }
+  {
+    std::lock_guard lock{aurora::gx::debug::s_requestMutex};
+    aurora::gx::debug::s_requestPath = path;
+  }
+  aurora::gx::debug::s_requested = true;
+  return true;
+}
