+#ifndef AURORA_PIPELINE_CACHE_H
+#define AURORA_PIPELINE_CACHE_H
+
+#ifdef __cplusplus
+#include <cstdint>
+extern "C" {
+#else
+#include <stdbool.h>
+#include <stdint.h>
+#endif
+
+/** Pipeline preparation snapshot. Counts are runtime pipeline configurations (a
+ * configuration may produce multiple native pipelines), not draw calls.
+ * pendingPipelines includes queued/in-flight configurations until publication.
+ * compilingPipelines also covers final publication/cache maintenance, so a full
+ * progress bar alone does not mean ready. Counters reset at initialization.
+ */
+typedef struct {
+  uint64_t knownConfigs;
+  uint64_t totalPipelines;
+  uint64_t readyPipelines;
+  uint64_t pendingPipelines;
+  uint64_t compilingPipelines;
+  uint64_t failedPipelines;
+  uint64_t demandHits;
+  uint64_t demandMisses;
+  uint64_t demandWaitNanoseconds;
+  bool ready;
+} AuroraPipelineWarmupStatus;
+
+/** Schedule known configurations for the current scene/offscreen layouts.
+ * Call on the host thread after graphics settings are applied, before starting
+ * source gameplay; do not call concurrently with frame recording or settings
+ * changes. Initialization already starts the first preparation pass.
+ * Draws still compile and wait for previously unknown configurations normally.
+ */
+void aurora_prepare_pipelines();
+/** Thread-safe, nonblocking snapshot. Native Vulkan/D3D12/Metal preparation runs
+ * on the existing worker. WebGPU's synchronous fallback requires regular frame
+ * pumping. Empty caches are ready; failedPipelines is a startup failure. Closing
+ * uses normal aurora_shutdown: abandon queued work and join the current compile.
+ */
+AuroraPipelineWarmupStatus aurora_pipeline_warmup_status();
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
