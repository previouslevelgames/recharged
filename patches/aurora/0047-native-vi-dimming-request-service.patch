--- a/include/dolphin/vi.h
+++ b/include/dolphin/vi.h
@@ -20,6 +20,11 @@
 u32 VIGetRetraceCount(void);
 u32 VIGetNextField(void);
 u32 VIGetDTVStatus(void);
+
+// Retail Wii request values. The SDK ABI uses a signed 32-bit word; retain
+// the original game's int declaration and its unknown-value/default branch.
+typedef enum { VI_DM_DEFAULT = 0, VI_DM_10M = 1, VI_DM_15M = 2 } VITimeToDIM;
+int VISetTimeToDimming(int time);
 
 void* VIGetCurrentFrameBuffer(void);
