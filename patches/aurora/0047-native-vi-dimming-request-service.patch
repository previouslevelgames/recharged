--- a/include/aurora/video.h
+++ b/include/aurora/video.h
@@ -103,6 +103,16 @@
   void* next_framebuffer;
 } AuroraVIHardwareState;
 bool aurora_get_video_hardware_state(AuroraVIHardwareState* state);
+// Request metadata only, independent of idle detection or visual dimming.
+// VISetTimeToDimming selects the pending retail field threshold and returns
+// the previous request. Active idle/dimming/OS force requests are not supplied
+// by this observer and remain a separate hardware service.
+typedef struct {
+  int32_t time;
+  uint32_t pending_field_threshold;
+  uint32_t threshold_tv_format;
+} AuroraVIDimmingRequestState;
+bool aurora_get_video_dimming_request_state(AuroraVIDimmingRequestState* state);
 #ifdef __cplusplus
 }
