+namespace {
+struct Collection {
+  __GXData_struct sdk;
+  GXState baseline;
+  GXState state;
+  CoPlanarState coplanar;
+  std::vector<u8> bytes = std::vector<u8>(64 * 1024);
+  std::vector<PipelineConfig> configs;
+  std::thread::id owner = std::this_thread::get_id();
+  bool failed = false;
+};
+std::unique_ptr<Collection> sCollection;
+thread_local bool sDecoding = false;
+
+class Reader {
+  std::span<const u8> mBytes;
+public:
+  explicit Reader(std::span<const u8> bytes) : mBytes(bytes) {}
+  bool empty() const { return mBytes.empty(); }
+  std::span<const u8> take(size_t size) {
+    if (size > mBytes.size()) throw std::runtime_error("Truncated collection command");
+    auto result = mBytes.first(size);
+    mBytes = mBytes.subspan(size);
+    return result;
+  }
+  template<class T> T read() {
+    T value;
+    const auto bytes = take(sizeof(T));
+    std::memcpy(&value, bytes.data(), sizeof(T));
+    if constexpr (sizeof(T) > 1) return bswap(value);
+    return value;
+  }
+};
+
+// Only the owner invokes this after drain(), with all SDK publication redirected
+// to the private sink. The FIFO worker has no commands to process while swapped.
+// No decoder called here can submit draws or touch resource lifetime state.
+class DecodeScope {
+  Collection& mCollection;
+public:
+  explicit DecodeScope(Collection& collection) : mCollection(collection) {
+    std::swap(g_gxState, mCollection.state);
+    std::swap(g_coPlanarState, mCollection.coplanar);
+    sDecoding = true;
+  }
+  ~DecodeScope() {
+    sDecoding = false;
+    std::swap(g_coPlanarState, mCollection.coplanar);
+    std::swap(g_gxState, mCollection.state);
+  }
+};
+
+void decode_extension(Reader& reader) {
+  const auto command = reader.read<u16>();
+  if (command >= GX_AURORA_LOAD_ARRAYBASE && command <= (GX_AURORA_LOAD_ARRAYBASE | 15)) {
+    auto& array = g_gxState.arrays[command - GX_AURORA_LOAD_ARRAYBASE + GX_VA_POS];
+    array.data = reinterpret_cast<void*>(reader.read<u64>());
+    array.size = reader.read<u32>();
+    array.le = reader.read<u8>() == 1;
+    array.cachedRange = {};
+  } else if (command == GX2_SET_POLYGON_OFFSET) {
+    g_gxState.frontOffset = reader.read<f32>();
+    g_gxState.frontScale = reader.read<f32>();
+    g_gxState.backOffset = reader.read<f32>();
+    g_gxState.backScale = reader.read<f32>();
+    g_gxState.clamp = reader.read<f32>();
+  } else if (command == GX_AURORA_LOAD_VIEWPORT_RENDER) {
+    // Viewport values are uniforms, not pipeline-key fields. Do not record them.
+    reader.take(6 * sizeof(f32));
+  } else if (command == GX_AURORA_LOAD_SCISSOR_RENDER) {
+    reader.take(4 * sizeof(u32));
+  } else if (command == GX_AURORA_LOAD_PROJECTION_FULL) {
+    reader.take(16 * sizeof(f32));
+  } else if (command == GX_AURORA_LOAD_TEXOBJ) {
+    // Bind metadata has no PipelineConfig fields; no upload or cache mutation.
+    reader.take(1 + 8 + 4 + 4 + 4 + 4 + 1 + 4 + 4);
+  } else if (command == GX_AURORA_LOAD_TLUT) {
+    reader.take(1 + 8 + 4 + 2 + 4 + 4);
+  } else if (command == GX_AURORA_DEBUG_GROUP_PUSH || command == GX_AURORA_DEBUG_MARKER_INSERT) {
+    reader.take(reader.read<u16>());
+  } else if (command == GX_AURORA_DEBUG_GROUP_POP) {
+    // Debug scopes never reach the actual recorder during collection.
+  } else {
+    throw std::runtime_error("Unsupported command in state-only pipeline collection");
+  }
+}
+
+void decode_commands(std::span<const u8> bytes) {
+  Reader reader(bytes);
+  while (!reader.empty()) {
+    const auto command = reader.read<u8>();
+    switch (command) {
+    case GX_NOP: break;
+    case GX_LOAD_CP_REG: {
+      const auto address = reader.read<u8>();
+      fifo::handle_cp(address, reader.read<u32>());
+      break;
+    }
+    case GX_LOAD_XF_REG: {
+      const auto header = reader.read<u32>();
+      const auto count = (header >> 16) + 1;
+      const auto address = static_cast<u16>(header);
+      const auto payload = reader.take(count * sizeof(u32));
+      // Matrix/light memory affects uniforms only; skip it without array reads.
+      if (address >= 0x1000) fifo::handle_xf(address, payload);
+      break;
+    }
+    case GX_LOAD_INDX_A:
+    case GX_LOAD_INDX_B:
+    case GX_LOAD_INDX_C:
+    case GX_LOAD_INDX_D:
+      // Original indexed matrix loads cannot change pipeline-key fields.
+      reader.take(4);
+      break;
+    case GX_LOAD_BP_REG: {
+      const auto value = reader.read<u32>();
+      const auto reg = value >> 24;
+      if (reg == 0x52 || reg == GX_BP_REG_DRAWDONE || reg == 0x47 || reg == 0x48) {
+        throw std::runtime_error("Hardware operation in state-only pipeline collection");
+      }
+      fifo::handle_bp(value);
+      break;
+    }
+    case GX_CMD_INVL_VC: break;
+    case GX_AURORA: decode_extension(reader); break;
+    default: throw std::runtime_error("Draw or unknown opcode in state-only pipeline collection");
+    }
+  }
+}
+
+bool valid_primitive(uint32_t value) {
+  switch (value) {
+  case GX_QUADS: case GX_TRIANGLES: case GX_TRIANGLESTRIP: case GX_TRIANGLEFAN:
+  case GX_LINES: case GX_LINESTRIP: case GX_POINTS: return true;
+  default: return false;
+  }
+}
+bool owner() { return sCollection && sCollection->owner == std::this_thread::get_id(); }
+}
+
+bool pipeline_collection_active() noexcept { return fifo::detail::sCollectionSink; }
+bool pipeline_collection_decoding() noexcept { return sDecoding; }
+void fail_pipeline_collection() noexcept { if (sCollection) sCollection->failed = true; }
+
+bool begin_pipeline_collection() {
+  if (!fifo::is_owner() || sCollection || fifo::in_display_list() || sdk_primitive_open() || !__gx) return false;
+  if (!gfx::begin_pipeline_discovery()) return false;
+  try {
+    // Flush only already-written commands. Preserve pending SDK dirty state;
+    // emit flushes that into the private sink, and end restores it unchanged.
+    fifo::drain();
+    auto collection = std::make_unique<Collection>();
+    collection->sdk = *__gx;
+    collection->baseline = g_gxState;
+    collection->state = collection->baseline;
+    collection->coplanar = g_coPlanarState;
+    fifo::begin_display_list(collection->bytes.data(), static_cast<u32>(collection->bytes.size()));
+    fifo::detail::sCollectionOverflow = false;
+    fifo::detail::sCollectionSink = true;
+    sCollection = std::move(collection);
+    return true;
+  } catch (...) {
+    gfx::end_pipeline_discovery();
+    return false;
+  }
+}
+
+bool reset_pipeline_collection() {
+  if (!owner() || sCollection->failed) return false;
+  try {
+    sCollection->state = sCollection->baseline;
+    *__gx = sCollection->sdk;
+    fifo::detail::sDlWritePos = 0;
+    fifo::detail::sCollectionOverflow = false;
+    return true;
+  } catch (...) {
+    sCollection->failed = true;
+    return false;
+  }
+}
+
+bool collect_pipeline(uint32_t primitive, uint32_t vertexFormat, bool coPlanar) {
+  if (!owner()) return false;
+  if (sCollection->failed || !valid_primitive(primitive) || vertexFormat >= GX_MAX_VTXFMT) {
+    sCollection->failed = true;
+    return false;
+  }
+  try {
+    if (__gx->dirtyState) __GXSetDirtyState();
+    if (fifo::detail::sCollectionOverflow) throw std::runtime_error("Pipeline state collection overflow");
+    DecodeScope scope(*sCollection);
+    decode_commands(std::span{sCollection->bytes}.first(fifo::detail::sDlWritePos));
+    fifo::detail::sDlWritePos = 0;
+    PipelineConfig config{};
+    const char* debugNoFog = std::getenv("AURORA_DEBUG_NO_FOG");
+    const bool noFog = debugNoFog && *debugNoFog && *debugNoFog != '0';
+    populate_pipeline_config(config, g_gxState, coPlanar, noFog,
+                             static_cast<GXPrimitive>(primitive), static_cast<GXVtxFmt>(vertexFormat));
+    sCollection->configs.push_back(config);
+    return true;
+  } catch (...) {
+    sCollection->failed = true;
+    return false;
+  }
+}
+
+bool end_pipeline_collection(bool submit) {
+  if (!owner()) return false;
+  auto collection = std::move(sCollection);
+  const bool valid = !collection->failed && !fifo::detail::sCollectionOverflow;
+  // Discard all captured bytes, including trailing state or an aborted draw.
+  // Do not call GXEndDisplayList: it flushes and modifies SDK bookkeeping.
+  fifo::detail::sInDisplayList = false;
+  fifo::detail::sDlBuffer = nullptr;
+  fifo::detail::sDlSize = fifo::detail::sDlWritePos = 0;
+  fifo::detail::sCollectionSink = fifo::detail::sCollectionOverflow = false;
+  *__gx = collection->sdk;
+  try {
+    if (submit && valid) gfx::prepare_pipeline_configs(collection->configs);
+  } catch (...) {
+    gfx::end_pipeline_discovery();
+    return false;
+  }
+  gfx::end_pipeline_discovery();
+  return valid;
+}
