+// This is the automatic-discovery enqueue point. It never resolves a draw
+// with Blocking priority and therefore does not manufacture demand statistics.
+void prepare_pipeline_configs(std::span<const gx::PipelineConfig> configs) {
+  {
+    std::lock_guard lock{g_pipelineMutex};
+    AURORA_ASSERT(g_pipelineCacheInitialized && !g_pipelineThreadEnd,
+                  "Pipeline preparation requires a live initialized cache");
+    AURORA_ASSERT(!g_pipelineCacheScheduling, "Concurrent pipeline preparation is not supported");
+    g_pipelineCacheScheduling = true;
+  }
+  const auto finishScheduling = [] {
+    {
+      std::lock_guard lock{g_pipelineMutex};
+      g_pipelineCacheScheduling = false;
+    }
+    finish_pipeline_cache_prune();
+  };
+  try {
+    const auto scene = scene_render_target_layout();
+    auto offscreen = scene;
+    offscreen.colorAttachmentCount = 1;
+    offscreen.sampleCount = 1;
+    detail::finalize_render_target_layout(offscreen);
+    for (const auto& config : configs) {
+      // The producer invokes the normal key builder; no imported binary ABI.
+      AURORA_ASSERT(config.version == gx::GXPipelineConfigVersion,
+                    "Automatic preparation received an obsolete GX configuration");
+      remember_pipeline_config(ShaderType::GX, config, current_frame(), true);
+      resolve_pipeline(ShaderType::GX, config, scene, PipelinePriority::Background);
+      if (offscreen.key != scene.key) {
+        resolve_pipeline(ShaderType::GX, config, offscreen, PipelinePriority::Background);
+      }
+    }
+  } catch (...) {
+    finishScheduling();
+    throw;
+  }
+  finishScheduling();
+}
+
+bool begin_pipeline_discovery() {
+  std::lock_guard lock{g_pipelineMutex};
+  if (!g_pipelineCacheInitialized || g_pipelineDiscoveryOpen || g_pipelineThreadEnd) return false;
+  g_pipelineDiscoveryOpen = true;
+  return true;
+}
+void end_pipeline_discovery() {
+  std::lock_guard lock{g_pipelineMutex};
+  g_pipelineDiscoveryOpen = false;
+}
