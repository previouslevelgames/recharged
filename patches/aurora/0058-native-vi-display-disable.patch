+void aurora_disable_video_display() {
+  auto& state = State();
+  AuroraVIOutputDevice output;
+  AuroraVIScanout scanout;
+  bool attached;
+  {
+    std::lock_guard lock(state.mutex); RequireOwner(state);
+    if (state.active || state.callback_active || state.output_active || state.display_control_active)
+      throw std::logic_error("Cannot disable native VI display inside active callbacks or output service");
+    if (!state.hardware.display_enabled && state.display_disable_completed) return;
+    output = state.output_device; attached = state.output_attached;
+    if (attached && !output.set_display_enabled)
+      throw std::runtime_error("Native VI output has no immediate display-disable operation");
+    UpdateClock(state, Clock::now());
+    state.hardware.display_enabled = false;
+    state.display_control_active = true;
+    scanout = Scanout(state, state.hardware, state.retraces);
+  }
+  struct Active {
+    Device& state;
+    ~Active() { std::lock_guard lock(state.mutex); state.display_control_active = false; }
+  } active{state};
+  // The output callback owns its actual worker/surface boundary. No source
+  // callbacks, counts, black requests or framebuffer leases are retired here.
+  if (attached) output.set_display_enabled(output.context, false, &scanout);
+  std::lock_guard lock(state.mutex); state.display_disable_completed = true;
+}
+bool aurora_get_video_display_enabled(bool* enabled) {
+  if (!enabled) return false;
+  *enabled = false;
+  auto& state = State(); std::lock_guard lock(state.mutex);
+  if (!state.initialized) return false;
+  *enabled = state.hardware.display_enabled;
+  return true;
+}
