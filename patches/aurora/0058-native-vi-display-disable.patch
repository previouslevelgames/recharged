+void set_display_enabled(void*, bool enabled, const AuroraVIScanout* scanout) {
+  auto& state = State();
+  if (!scanout || !scanout->active_width || !scanout->active_height || (!enabled && !scanout->black))
+    throw std::invalid_argument("Native VI display control requires its actual register scanout");
+  if (enabled) {
+    // Cached ENB=1 is written by the original retrace Mode flush. This does
+    // not acquire a desktop gate or wait/present inside that source IRQ.
+    std::lock_guard lock(state.mutex); RequireOwner(state);
+    state.display_enabled = true;
+    return;
+  }
+  uint64_t previousPresentations;
+  {
+    // Exclude only an already-started actual Present while latching DCR=0.
+    // Normal source commits retain their existing brief output mutex scope.
+    std::lock_guard gate(state.display_gate);
+    std::lock_guard lock(state.mutex); RequireOwner(state);
+    previousPresentations = state.presentations;
+    state.display_enabled = false;
+    state.disabled_scanout = *scanout; state.pending = true;
+  }
+  // Keep source/XFB/IRQ owners and snapshot leases live. Drain any older
+  // queued item after latching its output gate, then perform the real black
+  // output before returning to the original terminal STM ioctl.
+  render_worker::synchronize();
+  service(nullptr);
+  render_worker::synchronize();
+  const bool presentable = window::is_presentable();
+  std::lock_guard lock(state.mutex);
+  if (presentable && (state.presentations == previousPresentations || !state.presented.black))
+    throw std::runtime_error("Native VI display is disabled but its actual black Present failed");
+}
