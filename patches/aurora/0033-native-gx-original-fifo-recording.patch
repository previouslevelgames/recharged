+void submit_hardware_frame_and_wait() {
+  // Actual original finish opcode retires bounded native storage. The next
+  // hardware packet Loads EFB; this boundary adds no game frame or VI present.
+  finish();
+  end_frame([](wgpu::CommandEncoder& encoder, std::vector<AfterSubmitCallback> callbacks) {
+    webgpu::gpu_prof::frame_end(encoder);
+    const wgpu::CommandBufferDescriptor descriptor{.label = "Original GX native submission"};
+    const auto commands = encoder.Finish(&descriptor);
+    g_queue.Submit(1, &commands);
+    webgpu::gpu_prof::after_submit();
+    for (auto& callback : callbacks) if (callback) callback();
+    after_submit();
+    struct Completion { wgpu::QueueWorkDoneStatus status = wgpu::QueueWorkDoneStatus::Error; };
+    auto completion = std::make_shared<Completion>();
+    const auto future = g_queue.OnSubmittedWorkDone(wgpu::CallbackMode::WaitAnyOnly,
+        [completion](wgpu::QueueWorkDoneStatus status, wgpu::StringView) { completion->status = status; });
+    const auto waited = g_instance.WaitAny(future, 5'000'000'000);
+    AURORA_ASSERT(waited == wgpu::WaitStatus::Success &&
+        completion->status == wgpu::QueueWorkDoneStatus::Success,
+        "Original GX native submission failed to complete on the GPU");
+    AURORA_ASSERT(g_instance.WaitAny(g_device.GetLostFuture(), 0) == wgpu::WaitStatus::TimedOut,
+        "Original GX native submission completed on a lost GPU device");
+  });
+  render_worker::synchronize();
+}
 
