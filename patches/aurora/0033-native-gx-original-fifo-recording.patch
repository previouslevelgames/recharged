+
+void configure_native_recording() {
+  AURORA_ASSERT(sOwner == std::this_thread::get_id() && !sFrameActive &&
+      !sNativeRecording.load(std::memory_order_acquire) && detail::sBufferSize == 0 &&
+      sPublished.load(std::memory_order_acquire) == sProcessed.load(std::memory_order_acquire),
+      "Native GX hardware requires its initialized idle owner before source commands");
+  AURORA_ASSERT(gfx::current_frame() != UINT32_MAX, "Native GX hardware has no initialized graphics foundation");
+  sNativeRecording.store(true, std::memory_order_release);
+}
+
