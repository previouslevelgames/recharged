+std::shared_ptr<const xfb::Snapshot> presented_snapshot(AuroraVIPresentedState& presented) {
+  auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state);
+  presented = {state.presented.framebuffer, state.presented_snapshot ? state.presented_snapshot->revision : 0,
+      state.presentations, state.presented.retrace_count, state.presented.field, state.presented.black};
+  return state.presented_snapshot;
+}
 TextureHandle rendered_signal() { auto& state = State(); std::lock_guard lock(state.mutex); RequireOwner(state); return state.signal; }
