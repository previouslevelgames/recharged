 extern "C" {
+bool aurora_get_presented_video_output_state(AuroraVIPresentedState* result) {
+  if (!result) return false; auto& state = aurora::gfx::scanout::State(); std::lock_guard lock(state.mutex);
+  if (!state.configured) return false;
+  *result = {state.presented.framebuffer, state.presented_snapshot ? state.presented_snapshot->revision : 0,
+      state.presentations, state.presented.retrace_count, state.presented.field, state.presented.black};
+  return true;
+}
