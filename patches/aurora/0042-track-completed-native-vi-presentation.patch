+// Successful actual surface Present only. Committed/pending requests retain
+// their existing separate semantics above; no acquisition, submission, resize,
+// black request or failed/minimized Present can advance this completion record.
+typedef struct {
+  const void* framebuffer;
+  uint64_t copy_revision, presentation_sequence;
+  uint32_t retrace_count, field;
+  bool black;
+} AuroraVIPresentedState;
+bool aurora_get_presented_video_output_state(AuroraVIPresentedState* state);
 // Register/clock state, independent of GX completion/surface presentation.
