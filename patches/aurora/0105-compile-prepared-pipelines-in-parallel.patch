+// Dawn runs asynchronous pipeline creation on its platform's worker pool; the
+// default pool has two threads. This one uses the available processors.
+class WorkerTaskPool final : public dawn::platform::WorkerTaskPool {
+public:
+  explicit WorkerTaskPool(unsigned threads) {
+    for (unsigned i = 0; i < threads; ++i) {
+      mThreads.emplace_back([this] { Run(); });
+    }
+  }
+  ~WorkerTaskPool() override {
+    {
+      std::lock_guard lock{mMutex};
+      mStop = true;
+    }
+    mCv.notify_all();
+    for (auto& thread : mThreads) {
+      thread.join();
+    }
+  }
+
+  std::unique_ptr<dawn::platform::WaitableEvent> PostWorkerTask(dawn::platform::PostWorkerTaskCallback callback,
+                                                                void* userdata) override {
+    auto state = std::make_shared<WorkerEvent::State>();
+    {
+      std::lock_guard lock{mMutex};
+      mTasks.push_back({callback, userdata, state});
+    }
+    mCv.notify_one();
+    return std::make_unique<WorkerEvent>(std::move(state));
+  }
+
+private:
+  struct Task {
+    dawn::platform::PostWorkerTaskCallback callback = nullptr;
+    void* userdata = nullptr;
+    std::shared_ptr<WorkerEvent::State> state;
+  };
+
+  void Run() {
+    for (;;) {
+      Task task;
+      {
+        std::unique_lock lock{mMutex};
+        mCv.wait(lock, [this] { return mStop || !mTasks.empty(); });
+        if (mTasks.empty()) {
+          return;
+        }
+        task = std::move(mTasks.front());
+        mTasks.pop_front();
+      }
+      task.callback(task.userdata);
+      {
+        std::lock_guard lock{task.state->mutex};
+        task.state->done = true;
+      }
+      task.state->cv.notify_all();
+    }
+  }
+
+  std::mutex mMutex;
+  std::condition_variable mCv;
+  std::deque<Task> mTasks;
+  bool mStop = false;
+  std::vector<std::thread> mThreads;
+};
