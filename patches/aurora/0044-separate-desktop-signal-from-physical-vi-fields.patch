+void encode_signal(const wgpu::CommandEncoder& encoder, const TextureHandle& destination,
+    const AuroraVIScanout& scanout, const std::shared_ptr<const xfb::Snapshot>& snapshot,
+    const wgpu::BindGroupLayout& layout, const wgpu::RenderPipeline& pipeline, bool physicalField) {
+    const wgpu::RenderPassColorAttachment color{.view = destination->attachmentTextureView,
+        .loadOp = scanout.black || !physicalField ? wgpu::LoadOp::Clear : wgpu::LoadOp::Load, .storeOp = wgpu::StoreOp::Store,
+        .clearValue = {0.0, 0.0, 0.0, 1.0}};
+    const wgpu::RenderPassDescriptor passDesc{.label = "Source selected VI field",
+        .colorAttachmentCount = 1, .colorAttachments = &color};
+    const auto pass = encoder.BeginRenderPass(&passDesc); wgpu::Buffer uniform;
+    if (!scanout.black) {
+      AURORA_ASSERT(snapshot && snapshot->gpuComplete.load(std::memory_order_acquire), "VI selected a noncompleted GX XFB");
+      const Uniforms values{{scanout.active_width, scanout.active_height, scanout.x_origin, scanout.y_origin},
+          {scanout.vi_width, scanout.vi_height, scanout.pan_x, scanout.pan_y},
+          {scanout.pan_width, scanout.pan_height, scanout.field, physicalField && (scanout.tv_mode & 3u) == VI_INTERLACE}};
+      const wgpu::BufferDescriptor desc{.label = "Original VI field geometry",
+          .usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst, .size = sizeof(values)};
+      uniform = webgpu::g_device.CreateBuffer(&desc); webgpu::g_queue.WriteBuffer(uniform, 0, &values, sizeof(values));
+      const std::array entries{wgpu::BindGroupEntry{.binding = 0, .textureView = snapshot->packedYuyv->sampleTextureView},
+          wgpu::BindGroupEntry{.binding = 1, .buffer = uniform, .size = sizeof(values)}};
+      const wgpu::BindGroupDescriptor groupDesc{.layout = layout, .entryCount = entries.size(), .entries = entries.data()};
+      const auto group = webgpu::g_device.CreateBindGroup(&groupDesc);
+      pass.SetPipeline(pipeline); pass.SetBindGroup(0, group); pass.Draw(3);
+    }
+    pass.End();
 }
