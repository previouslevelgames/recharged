--- /dev/null
+++ b/lib/gfx/scanout_geometry.hpp
@@ -0,0 +1,28 @@
+#pragma once
+#include <aurora/video.h>
+#include <cmath>
+
+namespace aurora::gfx::scanout::detail {
+// Read-only metadata assembly used only after the actual successful Present.
+inline AuroraVIPresentedGeometry describe_presented_geometry(
+    const AuroraVIPresentedState& completion, const AuroraVIScanout& scanout,
+    uint64_t incarnation, uint32_t windowId, uint32_t logicalWidth,
+    uint32_t logicalHeight, uint32_t surfaceWidth, uint32_t surfaceHeight,
+    float x, float y, float width, float height) noexcept {
+  return {completion, incarnation, windowId, logicalWidth, logicalHeight,
+      surfaceWidth, surfaceHeight, x, y, width, height, scanout};
+}
+inline bool geometry_is_live(const AuroraVIPresentedGeometry& geometry,
+    uint64_t liveIncarnation) noexcept {
+  return geometry.completion.presentation_sequence != 0 && liveIncarnation != 0 &&
+      geometry.window_incarnation == liveIncarnation && geometry.window_id != 0 &&
+      geometry.logical_width != 0 && geometry.logical_height != 0 &&
+      geometry.surface_width != 0 && geometry.surface_height != 0 &&
+      std::isfinite(geometry.viewport_x) && std::isfinite(geometry.viewport_y) &&
+      std::isfinite(geometry.viewport_width) && std::isfinite(geometry.viewport_height) &&
+      geometry.viewport_x >= 0 && geometry.viewport_y >= 0 &&
+      geometry.viewport_width > 0 && geometry.viewport_height > 0 &&
+      geometry.viewport_x + geometry.viewport_width <= geometry.surface_width &&
+      geometry.viewport_y + geometry.viewport_height <= geometry.surface_height;
+}
+} // namespace aurora::gfx::scanout::detail
