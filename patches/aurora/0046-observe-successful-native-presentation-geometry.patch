+// Geometry of that exact successful Present, never a pending/current VI request.
+// Logical sizes are SDL event coordinates; surface/viewport sizes are pixels.
+// The getter performs no SDL/GPU calls, waits, resize or presentation. False
+// means no successful Present or retired output/window; the result is cleared.
+// A black Present is reported truthfully and must not calibrate pointing.
+// Consumers must match the current SDL window id and logical/pixel dimensions:
+// after resize the last-presented record remains historical until a new Present.
+typedef struct {
+  AuroraVIPresentedState completion;
+  uint64_t window_incarnation;
+  uint32_t window_id, logical_width, logical_height;
+  uint32_t surface_width, surface_height;
+  float viewport_x, viewport_y, viewport_width, viewport_height;
+  AuroraVIScanout scanout;
+} AuroraVIPresentedGeometry;
+bool aurora_get_presented_video_geometry(AuroraVIPresentedGeometry* state);
 // Register/clock state, independent of GX completion/surface presentation.
 // Output requires a separately configured, real native graphics endpoint.
 typedef struct {
