+bool aurora_get_presented_video_geometry(AuroraVIPresentedGeometry* result) {
+  if (!result) return false;
+  *result = {};
+  auto& state = aurora::gfx::scanout::State(); std::lock_guard lock(state.mutex);
+  if (!state.configured || !aurora::gfx::scanout::detail::geometry_is_live(
