@@ -699,6 +699,23 @@ gfx::TextureHandle resolve_static_palette_texture(const GXTexObj_& obj, const GX
   return handle;
 }
 
+gfx::TextureHandle find_replacement(const GXTexObj_& obj, const GXTlutObj_* tlut) noexcept {
+  gfx::TextureHandle handle;
+  uint64_t replacementId = 0;
+  if (use_replacement(gfx::texture_replacement::find_pointer_replacement(obj), handle, replacementId)) {
+    return handle;
+  }
+  if (!obj.has_data() || texture_source_size(obj.format(), obj.width(), obj.height(), obj.mip_count()) == 0 ||
+      !gfx::texture_replacement::should_build_source_key()) {
+    return {};
+  }
+  const auto keys = hash_texture_source(obj, tlut, true);
+  if (keys.sourceKey.has_value()) {
+    use_replacement(gfx::texture_replacement::find_source_replacement(obj, *keys.sourceKey), handle, replacementId);
+  }
+  return handle;
+}
+
 void end_frame() noexcept {
   const auto streamingStats = gfx::texture_replacement::process_streaming();
   s_stats.pendingLoads = streamingStats.pendingLoads;
