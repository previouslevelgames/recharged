@@ -12,6 +12,13 @@ extern "C" {
 #endif
 
 ImTextureID aurora_imgui_add_texture(uint32_t width, uint32_t height, const void* rgba8);
+// A texture pack's replacement of a game texture, as an ImGui texture: `tex_obj` is the game's GXTexObj of it and
+// `tlut_obj` its GXTlutObj when it is paletted (else null), so the replacement is the one the game's own draws of
+// that texture show. Its size goes to `width` and `height` (when not null); 0 when no pack replaces the texture. A
+// streamed replacement may first come as a small thumbnail and the full image a little later (another texture), so
+// ask again while it shows. The texture stays valid until shutdown. Owner thread only.
+ImTextureID aurora_imgui_texture_replacement(const void* tex_obj, const void* tlut_obj, uint32_t* width,
+                                             uint32_t* height);
 
