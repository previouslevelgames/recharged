+
+ImTextureID texture_replacement(const void* texObj, const void* tlutObj, uint32_t* width, uint32_t* height) noexcept {
+  // The SDL renderer (no GPU device) draws only its own textures.
+  if (texObj == nullptr || window::get_sdl_renderer() != nullptr) {
+    return 0;
+  }
+  auto texture = gx::texture::find_replacement(*static_cast<const GXTexObj_*>(texObj),
+                                               static_cast<const GXTlutObj_*>(tlutObj));
+  if (!texture || !texture->sampleTextureView) {
+    return 0;
+  }
+  if (width != nullptr) {
+    *width = texture->size.width;
+  }
+  if (height != nullptr) {
+    *height = texture->size.height;
+  }
+  for (const auto& known : g_replacementViews) {
+    if (known.texture == texture) {
+      return reinterpret_cast<ImTextureID>(known.view);
+    }
+  }
+  wgpu::TextureView view = texture->sampleTextureView;
+  g_replacementViews.push_back({std::move(texture), view.MoveToCHandle()});
+  return reinterpret_cast<ImTextureID>(g_replacementViews.back().view);
+}
 } // namespace aurora::imgui
 
 // C bindings
