From: mscharged-port contributors
Subject: [PATCH] Reject polygons drawn under GX_CULL_ALL
Upstream-base: d664382f57002fbff143911c81b06b7e7a4b3ab4
Classification: native GX rasterization contract.

GX_CULL_ALL makes the Wii rasterizer discard every triangle, quad, strip and
fan. Points and lines are never culled. The original game selects it through
its packet raster culling field (glxSend.cpp gx_Culling[3]). WebGPU has no
equivalent cull mode, and building the pipeline aborted the process the first
time a match restarted play after a goal.

Polygon draws under GX_CULL_ALL now consume their vertex and index data from
the command stream without encoding a draw. Line and point draws keep their
existing GX_CULL_NONE pipelines. The pipeline cache persists a configuration
before the worker builds it, so a configuration recorded by an earlier
crashing build is accepted as a no-cull pipeline that no draw selects.

--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -210,6 +210,12 @@
     return 0;
   }
 }
+
+// GX_CULL_ALL rejects every polygon before rasterization; points and lines are
+// never culled. The vertices are still consumed from the command stream.
+bool polygons_culled(GXPrimitive prim) noexcept {
+  return g_gxState.cullMode == GX_CULL_ALL && line_mode_for_prim(prim) == 0;
+}
 } // namespace
 
 static void handle_draw(u8 cmd, ByteReader& reader) noexcept;
@@ -503,6 +509,12 @@
   if (totalVtxBytes > reader.remaining())
     UNLIKELY { handle_draw_overrun(totalVtxBytes, reader); }
 
+  if (polygons_culled(prim))
+    UNLIKELY {
+      static_cast<void>(reader.take(totalVtxBytes));
+      return;
+    }
+
   const bool cleanState = g_gxState.dirty == 0 && fmt == sDrawCache.lastDrawFmt && sDrawCache.lineMode == 0 &&
                           prim != GX_LINES && prim != GX_LINESTRIP && prim != GX_POINTS;
   auto* lastDraw = cleanState ? gfx::get_last_draw_command<DrawData>() : nullptr;
@@ -747,7 +759,6 @@
     const size_t idxBytes = static_cast<size_t>(indexCount) * sizeof(u16);
     // Index data is always host-endian; push it to the GPU buffer as-is
     const auto indexData = reader.take(idxBytes);
-    const gfx::Range idxRange = gfx::push_indices(indexData.data(), indexData.size(), 4);
     u32 vtxSize;
     if (g_gxState.lastVtxFmt == fmt) {
       vtxSize = g_gxState.lastVtxSize;
@@ -756,9 +767,12 @@
     }
     const u32 totalVtxBytes = vtxCount * vtxSize;
     const auto vertexData = reader.take(totalVtxBytes);
-    const gfx::Range vertRange = gfx::push_verts(vertexData.data(), vertexData.size(), 4);
-    if (indexCount != 0) {
-      push_gx_draw(prim, fmt, vtxCount, vertRange, idxRange, indexCount);
+    if (!polygons_culled(prim)) {
+      const gfx::Range idxRange = gfx::push_indices(indexData.data(), indexData.size(), 4);
+      const gfx::Range vertRange = gfx::push_verts(vertexData.data(), vertexData.size(), 4);
+      if (indexCount != 0) {
+        push_gx_draw(prim, fmt, vtxCount, vertRange, idxRange, indexCount);
+      }
     }
   } else if (subCmd == GX_AURORA_DEBUG_GROUP_PUSH) {
     auto label = reader.read_string();
--- a/lib/gx/gx.cpp
+++ b/lib/gx/gx.cpp
@@ -213,6 +213,10 @@
     break;
   case GX_CULL_NONE:
     break;
+  case GX_CULL_ALL:
+    // Draws reject GX_CULL_ALL polygons before selecting a pipeline. Only a
