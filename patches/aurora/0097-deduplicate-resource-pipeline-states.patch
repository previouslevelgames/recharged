+void flush_commands(Collection& collection) {
+  if (__gx->dirtyState) __GXSetDirtyState();
+  if (fifo::detail::sCollectionOverflow) throw std::runtime_error("Pipeline state collection overflow");
+  DecodeScope scope(collection);
+  decode_commands(std::span{collection.bytes}.first(fifo::detail::sDlWritePos));
+  fifo::detail::sDlWritePos = 0;
+}
+
+void append_unique_config(Collection& collection, const PipelineConfig& config) {
+  // The production key uses canonical, uniquely represented config bytes. Keep
+  // exact equality within each hash bucket so a hash collision cannot omit work.
+  auto& indices = collection.configBuckets[xxh3_hash(config)];
+  for (const auto index : indices) {
+    if (std::memcmp(&collection.configs[index], &config, sizeof(config)) == 0) return;
+  }
+  indices.push_back(collection.configs.size());
+  collection.configs.push_back(config);
+}
