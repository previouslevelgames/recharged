+void* OSGetMEM2ArenaLo() { return MEM2ArenaLow; }
+void* OSGetMEM2ArenaHi() { return MEM2ArenaHigh; }
+
+void OSSetMEM2ArenaLo(void* lo) {
+  const auto address = reinterpret_cast<uintptr_t>(lo);
+  if (MEM2Start == nullptr || address < reinterpret_cast<uintptr_t>(MEM2Start)
+      || address > reinterpret_cast<uintptr_t>(MEM2ArenaHigh))
+    throw std::out_of_range("MEM2 arena low lies outside its available memory");
+  MEM2ArenaLow = lo;
+}
+
+void OSSetMEM2ArenaHi(void* hi) {
+  const auto address = reinterpret_cast<uintptr_t>(hi);
+  if (MEM2Start == nullptr || address < reinterpret_cast<uintptr_t>(MEM2ArenaLow)
+      || address > reinterpret_cast<uintptr_t>(MEM2End))
+    throw std::out_of_range("MEM2 arena high lies outside its available memory");
+  MEM2ArenaHigh = hi;
+}
+
+void* OSAllocFromMEM2ArenaLo(u32 size, u32 align) {
+  if (MEM2ArenaLow == nullptr || align == 0 || (align & (align - 1)) != 0) return nullptr;
+  const auto low = reinterpret_cast<uintptr_t>(MEM2ArenaLow);
+  const auto high = reinterpret_cast<uintptr_t>(MEM2ArenaHigh);
+  const auto mask = static_cast<uintptr_t>(align) - 1;
+  // Subtractions bound each addition, including its alignment padding.
+  if (mask > high - low) return nullptr;
+  const auto start = (low + mask) & ~mask;
+  if (size > high - start) return nullptr;
+  const auto end = start + size;
+  if (((-end) & mask) > high - end) return nullptr;
+  MEM2ArenaLow = reinterpret_cast<void*>((end + mask) & ~mask);
+  return reinterpret_cast<void*>(start);
+}
+
+void AuroraResetArena() {
+  ArenaLow = ArenaHigh = MEM2ArenaLow = MEM2ArenaHigh = nullptr;
+}
