 #include "__gx.h"
 #include "gx.hpp"
@@ -44,6 +46,31 @@
   if (height != nullptr) {
     *height = windowSize.fb_height;
   }
+}
+
+namespace {
+std::atomic<u64> nextDrawReceipt{1};
+thread_local bool drawReceiptActive = false;
+}
+u64 AuroraGXBeginDrawReceipt() {
+  if (drawReceiptActive || aurora::gx::fifo::detail::sInDisplayList) return 0;
+  u64 tag = nextDrawReceipt.load(std::memory_order_relaxed);
+  do {
+    if (tag == std::numeric_limits<u64>::max()) return 0;
+  } while (!nextDrawReceipt.compare_exchange_weak(tag, tag + 1, std::memory_order_relaxed));
+  drawReceiptActive = true;
+  GX_WRITE_AURORA(GX_AURORA_DRAW_RECEIPT_TAG);
+  GX_WRITE_U64(tag);
+  return tag;
+}
+void AuroraGXEndDrawReceipt() {
+  if (!drawReceiptActive) return;
+  GX_WRITE_AURORA(GX_AURORA_DRAW_RECEIPT_TAG);
+  GX_WRITE_U64(0);
+  drawReceiptActive = false;
+}
+bool AuroraGXWasDrawEncoded(u64 tag) {
+  return tag != 0 && aurora::gx::lastEncodedDrawReceipt.load(std::memory_order_acquire) == tag;
 }
 
 void AuroraGXSync() {
