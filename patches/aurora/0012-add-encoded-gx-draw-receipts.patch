 #define GX_AURORA_DEBUG_MARKER_INSERT 0x0022
+// FIFO-ordered non-rendering draw receipt tag, followed by u64 (0 clears).
+#define GX_AURORA_DRAW_RECEIPT_TAG 0x0023
 
 #define GX_AURORA_LOAD_TEXOBJ 0x0030
 
@@ -142,6 +144,18 @@
 void AuroraGXSync(void);
 
 /**
+ * Single FIFO producer only. Begin returns a never-reused nonzero tag, or zero
+ * for nested/display-list capture or exhaustion. End clears the tag. All draws
+ * in the span retain the tag; distinct tagged/untagged spans never merge.
+ * WasEncoded proves that tag reached actual pass.Draw/DrawIndexed after shader
+ * availability, not GPU completion or surface presentation. Synchronize render
+ * work and separately verify successful presentation before using a receipt.
+ */
+u64 AuroraGXBeginDrawReceipt(void);
+void AuroraGXEndDrawReceipt(void);
+bool AuroraGXWasDrawEncoded(u64 tag);
+
+/**
  * Sets the actual render viewport in native framebuffer coordinates.
  * Overrides the automatically scaled values set by the logical GXSetViewport.
  */
diff --git a/lib/dolphin/gx/GXAurora.cpp b/lib/dolphin/gx/GXAurora.cpp
--- a/lib/dolphin/gx/GXAurora.cpp
+++ b/lib/dolphin/gx/GXAurora.cpp
@@ -1,6 +1,8 @@
 #include "dolphin/gx/GXAurora.h"
 
 #include <limits>
