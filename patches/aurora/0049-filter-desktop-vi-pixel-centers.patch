From: mscharged-port contributors
Subject: [PATCH] Filter independent desktop VI signal at source pixel centers
Upstream-base: d664382f57002fbff143911c81b06b7e7a4b3ab4

Preserve the physical field shader/history and original selected XFB/VI geometry.
Decode RGB pixels before continuous desktop-only reconstruction, avoiding the
intermediate nearest-neighbor640-to680 expansion. Final aspect-fit copy remains
linear, and source/internal GX resolution is unchanged.

--- a/lib/gfx/scanout.cpp
+++ b/lib/gfx/scanout.cpp
@@ -47,6 +47,49 @@
   return vec4f(vec3f(clamp((rgb+vec3i(128))/vec3i(256),vec3i(0),vec3i(255)))/255.0,1.0);
 }
 )";
+constexpr auto DesktopShader = R"(
+struct Uniforms { signal: vec4u, display: vec4u, source_geometry: vec4u, };
+@group(0) @binding(0) var xfb: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> vi: Uniforms;
+@vertex fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
+  switch index {
+    case 0u: { return vec4f(-1.0,-1.0,0.0,1.0); }
+    case 1u: { return vec4f(3.0,-1.0,0.0,1.0); }
+    default: { return vec4f(-1.0,3.0,0.0,1.0); }
+  }
+}
+
+// The desktop signal is independent of the exact physical field history.
+// Decode individual YUYV pixels before interpolating; packed Y/U/Y/V channels
+// cannot themselves be sampled as an ordinary RGB texture.
+fn desktop_rgb(source: vec2i) -> vec3f {
+  let bytes=vec4i(floor(textureLoad(xfb,vec2i(source.x/2,source.y),0)*255.0+0.5));
+  let y=select(bytes.x,bytes.z,source.x%2!=0)-16;
+  let u=bytes.y-128; let v=bytes.w-128;
+  let rgb=vec3i(298*y+409*v,298*y-100*u-208*v,298*y+516*u);
+  return vec3f(clamp((rgb+vec3i(128))/vec3i(256),vec3i(0),vec3i(255)))/255.0;
+}
+@fragment fn fragment_desktop(@builtin(position) position: vec4f) -> @location(0) vec4f {
+  let at=vec2u(position.xy);
+  if any(at<vi.signal.zw) || any(at>=vi.signal.zw+vi.display.xy) {
+    return vec4f(0.0,0.0,0.0,1.0);
+  }
+  // position contains the destination pixel center. Subtract half a source
+  // pixel after mapping to its center-based texel coordinates.
+  let source=(position.xy-vec2f(vi.signal.zw))*vec2f(vi.source_geometry.xy)/
+      vec2f(vi.display.xy)+vec2f(vi.display.zw)-vec2f(0.5);
+  let first=vec2i(floor(source));
+  let last=first+vec2i(1);
+  let minimum=vec2i(vi.display.zw);
+  let maximum=minimum+vec2i(vi.source_geometry.xy)-vec2i(1);
+  let weight=fract(source);
+  let upper=mix(desktop_rgb(clamp(first,minimum,maximum)),
+      desktop_rgb(clamp(vec2i(last.x,first.y),minimum,maximum)),weight.x);
+  let lower=mix(desktop_rgb(clamp(vec2i(first.x,last.y),minimum,maximum)),
+      desktop_rgb(clamp(last,minimum,maximum)),weight.x);
+  return vec4f(mix(upper,lower,weight.y),1.0);
+}
+)";
