+// The lists of prepare_idx_buffer(.., vtxStart 0, ..), written in place (the
+// same values in the same order; the count keeps its 16-bit wrap).
+u32 index_list_count(GXPrimitive prim, u16 n) noexcept {
+  switch (prim) {
+  case GX_QUADS:
+    return (u32(n) + 3) / 4 * 6;
+  case GX_TRIANGLEFAN:
+  case GX_TRIANGLESTRIP:
+    return n < 3 ? n : 3 + (u32(n) - 3) * 3;
+  default: // GX_LINES, GX_LINESTRIP, GX_POINTS
+    return 6;
+  }
+}
+
+void write_index_list(u16* out, GXPrimitive prim, u16 n) noexcept {
+  if (prim == GX_QUADS) {
+    for (u32 v = 0; v < n; v += 4) {
+      out[0] = u16(v);
+      out[1] = u16(v + 1);
+      out[2] = u16(v + 2);
+      out[3] = u16(v + 2);
+      out[4] = u16(v + 3);
+      out[5] = u16(v);
+      out += 6;
+    }
+  } else if (prim == GX_TRIANGLEFAN || prim == GX_TRIANGLESTRIP) {
+    for (u32 v = 0; v < n && v < 3; ++v) *out++ = u16(v);
+    for (u32 v = 3; v < n; ++v) {
+      if (prim == GX_TRIANGLEFAN) {
+        out[0] = 0;
+        out[1] = u16(v - 1);
+      } else if ((v & 1) == 0) {
+        out[0] = u16(v - 2);
+        out[1] = u16(v - 1);
+      } else {
+        out[0] = u16(v - 1);
+        out[1] = u16(v - 2);
+      }
+      out[2] = u16(v);
+      out += 3;
+    }
+  } else {
+    static constexpr u16 Expansion[6] = {0, 1, 3, 3, 2, 0};
+    std::memcpy(out, Expansion, sizeof Expansion);
+  }
+}
