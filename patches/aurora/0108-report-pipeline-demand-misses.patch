+void set_pipeline_demand_miss_callback(AuroraPipelineDemandMissCallback callback, void* userData) {
+  std::lock_guard lock{g_demandMissCallbackMutex};
+  g_demandMissCallback = callback;
+  g_demandMissUserData = userData;
+}
+
+template <typename Config>
+static void report_demand_miss(ShaderType type, const Config& config, HashType configKey, uint32_t frame,
+                               bool learned, uint64_t waitNanoseconds) {
+  std::lock_guard lock{g_demandMissCallbackMutex};
+  if (!g_demandMissCallback) return;
+  const AuroraPipelineDemandMiss miss{
+      .shaderType = static_cast<uint32_t>(type),
+      .configVersion = config.version,
+      .configKey = configKey,
+      .config = &config,
+      .configSize = static_cast<uint32_t>(sizeof(Config)),
+      .frame = frame,
+      .waitNanoseconds = waitNanoseconds,
+      .newConfiguration = learned,
+  };
+  g_demandMissCallback(&miss, g_demandMissUserData);
+}
