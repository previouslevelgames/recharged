         g_surface.GetCurrentTexture(&surfaceTexture);
@@ -392,7 +392,7 @@
         Log.warn("Surface present failed");
         webgpu::release_surface();
       }
-    } else if (g_surface) {
+    } else if (present && g_surface) {
