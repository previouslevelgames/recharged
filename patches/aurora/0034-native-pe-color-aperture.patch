@@ -0,0 +1,12 @@
+#pragma once
+#include <array>
+#include <cstdint>
+namespace aurora::gx::poke {
+using Registers = std::array<uint16_t, 5>;
+void reset() noexcept;
+uint16_t read_register(uint32_t index);
+void write_register(uint32_t index, uint32_t value);
+void store_color(uint32_t aperture, uint32_t argb);
+// FIFO-worker order, against the real EFB and this exact captured PE state.
+void execute_color(uint32_t aperture, uint32_t argb, const Registers& registers);
+}
diff --git a/lib/gx/poke.cpp b/lib/gx/poke.cpp
new file mode 100644
--- /dev/null
+++ b/lib/gx/poke.cpp
@@ -0,0 +1,65 @@
+#include "poke.hpp"
+#include "fifo.hpp"
+#include "gx.hpp"
+#include "../gfx/recording.hpp"
+#include <dolphin/gx/GXAurora.h>
+#include <dolphin/gx/GXEnum.h>
+
+namespace aurora::gx::poke {
+namespace {
+constexpr Module Log{"aurora::gx::poke"};
+Registers sRegisters{}; // Physical PE0-4, independent of BP draw registers.
+}
+void reset() noexcept { sRegisters = {}; }
+uint16_t read_register(uint32_t index) {
+  fifo::require_owner();
+  AURORA_ASSERT(index < sRegisters.size(), "Invalid PE register {}", index);
+  return sRegisters[index];
+}
+void write_register(uint32_t index, uint32_t value) {
+  fifo::require_owner();
+  AURORA_ASSERT(index < sRegisters.size(), "Invalid PE register {}", index);
+  sRegisters[index] = static_cast<uint16_t>(value); // Actual 16-bit MMIO width.
+}
+void store_color(uint32_t aperture, uint32_t argb) {
+  fifo::require_owner();
+  AURORA_ASSERT(!fifo::in_display_list(), "PE aperture is not a display-list FIFO command");
+  fifo::write_u8(GX_AURORA);
+  fifo::write_u16(GX_AURORA_POKE_ARGB);
+  fifo::write_u32(aperture);
+  fifo::write_u32(argb);
+  for (const auto value : sRegisters) fifo::write_u16(value);
+}
+void execute_color(uint32_t aperture, uint32_t argb, const Registers& registers) {
+  AURORA_ASSERT((aperture & 0xFFC00003u) == 0xC8000000u,
+      "Native PE color aperture {:08x} is outside its physical word domain", aperture);
+  // Color and depth use distinct physical aperture selectors. Other PE0
+  // effects are not qualified: retain the exact source GXInit loading mode.
+  AURORA_ASSERT(registers[0] == 0x1Fu,
+      "Native PE color depth mode outside source GXInit ALWAYS remains unqualified");
+  // Setter state is transported faithfully. Unsupported execution is explicit,
+  // rather than aliasing it to convenient ordinary draw/blend state.
+  AURORA_ASSERT((registers[1] & 0x0807u) == 0,
+      "Native PE color blend/logic/subtract/dither mode remains unqualified");
+  AURORA_ASSERT(((registers[3] >> 8) & 7u) == GX_ALWAYS,
+      "Native PE color alpha comparison remains unqualified");
+  AURORA_ASSERT((registers[2] & 0x100u) == 0,
+      "Native PE destination alpha replacement remains unqualified");
+  const auto format = g_gxState.pixelFmt;
+  AURORA_ASSERT(format == GX_PF_RGB8_Z24 || format == GX_PF_RGBA6_Z24,
+      "Native PE color aperture pixel format remains unqualified");
+  if (format == GX_PF_RGBA6_Z24) {
+    // The actual loading bitmap writes only 00/FF components. Other Wii6-bit
+    // storage rounding is a separate physical precision qualification.
+    for (unsigned shift = 0; shift < 32; shift += 8) {
+      const auto component = (argb >> shift) & 255u;
+      AURORA_ASSERT(component == 0 || component == 255,
+          "Native PE RGBA6 intermediate component precision remains unqualified");
+    }
+  }
+  const auto x = static_cast<uint16_t>((aperture >> 2) & 1023u);
+  const auto y = static_cast<uint16_t>((aperture >> 12) & 1023u);
+  gfx::queue_efb_poke(x, y, argb, (registers[1] & 8u) != 0,
+      (registers[1] & 16u) != 0 && format == GX_PF_RGBA6_Z24);
+}
+}
