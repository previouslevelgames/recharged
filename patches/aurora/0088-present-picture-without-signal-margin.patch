diff --git a/lib/gfx/scanout.cpp b/lib/gfx/scanout.cpp
index e1a8784..b1aa7bf 100644
--- a/lib/gfx/scanout.cpp
+++ b/lib/gfx/scanout.cpp
@@ -279,6 +279,17 @@ void require_live_device() {
   AURORA_ASSERT(webgpu::g_instance.WaitAny(webgpu::g_device.GetLostFuture(), 0) == wgpu::WaitStatus::TimedOut,
       "Native VI presentation found a lost device");
 }
+// Clean and sharp desktop pictures show the game's VI picture alone: its
+// rectangle becomes the whole desktop signal, without the blank margins the
+// TV signal has around it. The physical signal is unchanged.
+AuroraVIScanout desktop_view(AuroraVIScanout scanout, uint8_t picture) {
+  if (picture != AURORA_DESKTOP_SIGNAL && scanout.vi_width && scanout.vi_height) {
+    scanout.active_width = scanout.vi_width;
+    scanout.active_height = scanout.vi_height;
+    scanout.x_origin = scanout.y_origin = 0;
+  }
+  return scanout;
+}
 TextureHandle new_signal(uint32_t width, uint32_t height) {
   const wgpu::Extent3D size{width, height, 1};
   const wgpu::TextureDescriptor desc{.label = "Source VI active signal",
@@ -390,8 +401,15 @@ void service(void*) {
   } active{state};
   // Owner refresh/presentation runs outside the source VI IRQ and its locks.
   if (window::is_presentable() && !webgpu::g_surface) webgpu::refresh_surface(true);
+  // The displayed aspect covers the whole active signal; the desktop view's
+  // shape is its share of that signal (the full signal for SIGNAL pictures).
+  const auto view = desktop_view(scanout, picture);
+  const uint32_t aspectWidth = widescreen ? 16u : 4u, aspectHeight = widescreen ? 9u : 3u;
+  const bool shaped = scanout.active_width && scanout.active_height;
   const auto viewport = webgpu::calculate_present_viewport(webgpu::g_graphicsConfig.surfaceConfiguration.width,
-      webgpu::g_graphicsConfig.surfaceConfiguration.height, widescreen ? 16u : 4u, widescreen ? 9u : 3u);
+      webgpu::g_graphicsConfig.surfaceConfiguration.height,
+      shaped ? aspectWidth * view.active_width * scanout.active_height : aspectWidth,
+      shaped ? aspectHeight * view.active_height * scanout.active_width : aspectHeight);
   if (picture != AURORA_DESKTOP_SIGNAL) {
     // Smooth and sharp pictures are drawn at the window viewport's own size.
     const auto width = std::max(1u, static_cast<uint32_t>(viewport.width));
@@ -424,7 +442,8 @@ void service(void*) {
     const auto encoder = webgpu::g_device.CreateCommandEncoder();
     // Preserve the exact physical field history independently from desktop output.
     encode_signal(encoder, signal, effective, snapshot, layout, pipeline, true);
-    encode_signal(encoder, desktop, effective, snapshot, layout, desktopPipeline, false, picture, &scaledPipeline);
+    encode_signal(encoder, desktop, desktop_view(effective, picture), snapshot, layout, desktopPipeline, false, picture,
+        &scaledPipeline);
     wgpu::Texture target; auto status = wgpu::SurfaceGetCurrentTextureStatus::Error;
     {
       window::SurfaceLock lock;
@@ -486,7 +505,8 @@ void service(void*) {
         const AuroraVIPresentedState completion{effective.framebuffer,
             state.presented_snapshot ? state.presented_snapshot->revision : 0,
             state.presentations, effective.retrace_count, effective.field, effective.black};
-        state.presented_geometry = detail::describe_presented_geometry(completion, effective,
+        // Pointer mapping follows the presented desktop view.
+        state.presented_geometry = detail::describe_presented_geometry(completion, desktop_view(effective, picture),
             windowIncarnation, windowId, windowSize.width, windowSize.height,
             target.GetWidth(), target.GetHeight(), viewport.left, viewport.top, viewport.width, viewport.height);
       } else { Log.warn("Native VI surface presentation failed"); }
