 bool g_frameBufferAspectFit = false;
-// VILockAspectRatio: shape of the auto-sized (scale 0) framebuffer, 0 = the EFB's own.
-float g_frameBufferLockedAspect = 0.f;
+// VILockAspectRatio: display aspect of the VI signal for the auto-sized (scale
+// 0) framebuffer, 0:0 = the EFB's own shape.
+int g_frameBufferLockedWidth = 0;
+int g_frameBufferLockedHeight = 0;
 AuroraWindowSize g_windowSize;
