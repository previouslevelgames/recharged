 std::deque<std::string> g_eventStrings;
@@ -503,13 +505,24 @@ AuroraWindowSize get_window_size() {
     const auto [baseW, baseH] = vi::configured_fb_size();
     if (baseW > 0 && baseH > 0) {
       // An auto-sized framebuffer locked to the displayed aspect (4:3, 16:9)
-      // gets one framebuffer pixel per window pixel of the picture, never
-      // fewer pixels than the EFB itself.
-      const bool locked = g_frameBufferScale == 0.f && g_frameBufferLockedAspect > 0.f;
-      const float aspect = locked ? g_frameBufferLockedAspect : static_cast<float>(baseW) / static_cast<float>(baseH);
-      const auto [fitW, fitH] = fit_frame_buffer_to_aspect(fb_w, fb_h, aspect);
-      fb_w = fitW;
-      fb_h = fitH;
+      // gets one framebuffer pixel per window pixel of the game's picture:
+      // the same viewport the desktop picture is presented in (the picture
+      // without the blank TV-signal margin around it), never fewer pixels
+      // than the EFB itself.
+      const bool locked = g_frameBufferScale == 0.f && g_frameBufferLockedWidth > 0 && g_frameBufferLockedHeight > 0;
+      if (locked) {
+        const auto shape = vi::picture_shape();
+        const auto picture = webgpu::calculate_present_viewport(static_cast<uint32_t>(fb_w),
+            static_cast<uint32_t>(fb_h), static_cast<uint32_t>(g_frameBufferLockedWidth) * shape.x,
+            static_cast<uint32_t>(g_frameBufferLockedHeight) * shape.y);
+        fb_w = std::max(1, static_cast<int>(picture.width));
+        fb_h = std::max(1, static_cast<int>(picture.height));
+      } else {
+        const auto [fitW, fitH] =
+            fit_frame_buffer_to_aspect(fb_w, fb_h, static_cast<float>(baseW) / static_cast<float>(baseH));
+        fb_w = fitW;
+        fb_h = fitH;
+      }
       if (locked) {
         fb_w = std::max(fb_w, static_cast<int>(baseW));
         fb_h = std::max(fb_h, static_cast<int>(baseH));
@@ -626,14 +639,15 @@ void set_frame_buffer_scale(float scale) {
   request_frame_buffer_resize();
 }
 
-void set_frame_buffer_locked_aspect(float aspect) {
-  if (!(aspect > 0.f)) {
-    aspect = 0.f;
+void set_frame_buffer_locked_aspect(int width, int height) {
+  if (width <= 0 || height <= 0) {
+    width = height = 0;
   }
-  if (g_frameBufferLockedAspect == aspect) {
+  if (g_frameBufferLockedWidth == width && g_frameBufferLockedHeight == height) {
     return;
   }
-  g_frameBufferLockedAspect = aspect;
+  g_frameBufferLockedWidth = width;
+  g_frameBufferLockedHeight = height;
   request_frame_buffer_resize();
 }
 
