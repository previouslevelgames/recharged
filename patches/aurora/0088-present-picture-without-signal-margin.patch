From: mscharged-port contributors
Subject: [PATCH] Present the game's picture without the TV-signal margin
Upstream-base: d664382f57002fbff143911c81b06b7e7a4b3ab4
Classification: host presentation (desktop output only). Apply after 0087.

The clean and sharp desktop pictures showed the whole 720-wide active VI
signal, so the blank margin around the game's picture (680x448 of 720x480
for Charged) became black bars inside the window, and the auto-sized EFB,
locked to the signal's 16:9 or 4:3, was shrunk by about 6% into the
smaller picture.

These pictures now present the game's VI picture rectangle alone: its share
of the displayed aspect is fitted to the window, the desktop shader treats
that rectangle as the whole signal, and the presented geometry describes it
for pointer mapping. VILockAspectRatio keeps the display aspect of the full
signal, and the auto-sized EFB takes the shape and the exact pixel size of
that picture viewport, so one EFB pixel lands on one window pixel.

The physical VI signal, the TV-like signal picture and the game's own
coordinates are unchanged.
diff --git a/lib/dolphin/vi/vi.cpp b/lib/dolphin/vi/vi.cpp
index 56e2926..32df98b 100644
--- a/lib/dolphin/vi/vi.cpp
+++ b/lib/dolphin/vi/vi.cpp
@@ -27,6 +27,7 @@ Vec2<uint32_t> render_mode_size() noexcept {
 }
 void configure(const GXRenderModeObj* rm) noexcept {
   const auto oldSize = render_mode_size();
+  const auto oldShape = picture_shape();
 #if defined(AURORA_ENABLE_GX)
   const Vec2<uint32_t> nextSize = rm ? Vec2<uint32_t>{rm->fbWidth, rm->efbHeight} : Vec2<uint32_t>{640, 480};
   // Retire old-size FIFO work before changing its address/viewport metadata.
@@ -35,7 +36,7 @@ void configure(const GXRenderModeObj* rm) noexcept {
 #endif
   if (rm) g_renderMode = *rm;
   else g_renderMode.reset();
-  if (render_mode_size() != oldSize) window::request_frame_buffer_resize();
+  if (render_mode_size() != oldSize || picture_shape() != oldShape) window::request_frame_buffer_resize();
 }
 Vec2<uint32_t> configured_fb_size() noexcept { return render_mode_size(); }
 } // namespace aurora::vi
@@ -58,6 +59,21 @@ Timing GetTiming(uint32_t mode) {
   default: throw std::runtime_error("Native VI timing is not implemented for this exact TV mode");
   }
 }
+} // namespace
+
+namespace aurora::vi {
+Vec2<uint32_t> picture_shape() noexcept {
+  if (!g_renderMode || !g_renderMode->viWidth || !g_renderMode->viHeight) return {1, 1};
+  try {
+    const uint32_t activeHeight = GetTiming(uint32_t(g_renderMode->viTVmode)).active_lines * 2u;
+    return {uint32_t(g_renderMode->viWidth) * activeHeight, uint32_t(g_renderMode->viHeight) * 720u};
+  } catch (const std::runtime_error&) {
+    return {1, 1};
+  }
+}
+} // namespace aurora::vi
+
+namespace {
 uint64_t FieldClocks(const Timing& timing) {
   return uint64_t{timing.half_lines} * timing.half_width * 2;
 }
@@ -591,9 +607,9 @@ void VISetWindowPosition(uint32_t x, uint32_t y) { aurora::window::set_window_po
 void VICenterWindow() { aurora::window::center_window(); }
 void VISetFrameBufferScale(float scale) { aurora::window::set_frame_buffer_scale(scale); }
 void VILockAspectRatio(int width, int height) {
-  aurora::window::set_frame_buffer_locked_aspect(width > 0 && height > 0 ? static_cast<float>(width) / height : 0.f);
+  aurora::window::set_frame_buffer_locked_aspect(width, height);
 }
-void VIUnlockAspectRatio() { aurora::window::set_frame_buffer_locked_aspect(0.f); }
+void VIUnlockAspectRatio() { aurora::window::set_frame_buffer_locked_aspect(0, 0); }
 }
 
 #else
@@ -632,6 +648,7 @@ void configure(const GXRenderModeObj* rm) noexcept {
 Vec2<uint32_t> configured_fb_size() noexcept {
   return render_mode_size();
 }
+Vec2<uint32_t> picture_shape() noexcept { return {1, 1}; }
 } // namespace aurora::vi
 
 extern "C" {
@@ -661,9 +678,9 @@ void VISetWindowPosition(uint32_t x, uint32_t y) { aurora::window::set_window_po
 void VICenterWindow() { aurora::window::center_window(); }
 void VISetFrameBufferScale(float scale) { aurora::window::set_frame_buffer_scale(scale); }
 void VILockAspectRatio(int width, int height) {
-  aurora::window::set_frame_buffer_locked_aspect(width > 0 && height > 0 ? static_cast<float>(width) / height : 0.f);
+  aurora::window::set_frame_buffer_locked_aspect(width, height);
 }
-void VIUnlockAspectRatio() { aurora::window::set_frame_buffer_locked_aspect(0.f); }
+void VIUnlockAspectRatio() { aurora::window::set_frame_buffer_locked_aspect(0, 0); }
