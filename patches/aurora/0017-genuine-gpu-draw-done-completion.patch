+std::optional<RecordedFrame> split_recording_for_draw_done() {
+  if (!g_recorder.active()) {
+    return std::nullopt;
+  }
+  auto& frame = g_recorder.frame();
+  if (g_recorder.currentRenderPass != UINT32_MAX) {
+    // Preserve a continuation for EFB, offscreen and public color passes. All
+    // prior writes must survive this native submission boundary, even when the
+    // final caller-requested store operation will eventually discard them.
+    auto& pass = frame.renderPasses[g_recorder.currentRenderPass];
+    RenderPass continuation = pass;
+    continuation.commands.clear();
+    continuation.paletteConvs.clear();
+    continuation.resolveTarget = {};
+    continuation.snapshotColorDst = {};
+    continuation.snapshotDepthDst = {};
+    continuation.snapshotNormalDst = {};
+    continuation.captureDepthSnapshot = false;
+    continuation.hasDraws = false;
+    continuation.discardable = false;
+    continuation.sealed = false;
+    for (uint32_t i = 0; i < pass.colorAttachmentCount; ++i) {
+      pass.colorAttachments[i].storeOp = wgpu::StoreOp::Store;
+      continuation.colorAttachments[i].loadOp = wgpu::LoadOp::Load;
+      continuation.colorAttachments[i].clear = false;
+    }
+    if (pass.hasDepth) {
+      pass.depthStoreOp = wgpu::StoreOp::Store;
+      continuation.depthLoadOp = wgpu::LoadOp::Load;
+    }
+    if (pass.hasStencil) {
+      pass.stencilStoreOp = wgpu::StoreOp::Store;
+      continuation.stencilLoadOp = wgpu::LoadOp::Load;
+    }
+    continuation.clearDepth = false;
+    frame.uniforms.append_zeroes(gx::MaxUniformSize);
+    pass.captureDepthSnapshot = !g_recorder.inOffscreen;
+    enqueue_pass(frame, g_recorder.currentRenderPass);
+    g_recorder.currentRenderPass = static_cast<uint32_t>(frame.renderPasses.size());
+    frame.renderPasses.emplace_back(std::move(continuation));
+    push_command(CommandType::SetViewport, Command::Data{.setViewport = g_recorder.cachedViewport});
+    push_command(CommandType::SetScissor, Command::Data{.setScissor = g_recorder.cachedScissor});
+  }
+  // Preserve source array ranges, all byte offsets and accumulated frame stats.
+  // FIFO processing waits for the segment before further recording, so no
+  // recorder/packet is concurrently reused while mapped storage is absent.
+  return RecordedFrame{.packet = g_recorder.packet, .frameSlot = g_recorder.frameSlot};
+}
