+void submit_draw_done_and_wait() {
+  // This method is called by the FIFO worker at the exact finish opcode. Native
+  // recording stays paused until the GPU prefix and staging remap both finish.
+  const auto recorded = split_recording_for_draw_done();
+  std::optional<size_t> frameSlot;
+  if (recorded) frameSlot = recorded->frameSlot;
+  render_worker::enqueue_work([frameSlot] {
+    FramePacket* packet = frameSlot ? &g_framePackets[*frameSlot] : nullptr;
+    struct Prefix {
+      size_t logicalSize = 0;
+      std::vector<uint8_t> bytes;
+    };
+    std::array<Prefix, 5> prefixes;
+    if (packet) {
+      const std::array<ByteBuffer*, 5> buffers{
+          &packet->verts, &packet->uniforms, &packet->indices,
+          &packet->storage, &packet->textureUpload};
+      for (size_t i = 0; i < buffers.size(); ++i) {
+        prefixes[i].logicalSize = buffers[i]->size();
+        const size_t rounded = AURORA_ALIGN(buffers[i]->size(), 4);
+        if (rounded != 0) {
+          const auto* data = buffers[i]->data();
+          prefixes[i].bytes.assign(data, data + rounded);
+        }
+      }
+      g_stagingBuffers[packet->stagingBuffer].Unmap();
+      g_mappingStates[packet->stagingBuffer].store(BufferMapState::Unmapped, std::memory_order_release);
+    }
+    const wgpu::CommandEncoderDescriptor descriptor{.label = "GX finish encoder"};
+    auto encoder = packet ? std::move(packet->encoder) : g_device.CreateCommandEncoder(&descriptor);
+    if (packet) webgpu::gpu_prof::frame_end(encoder);
+    const wgpu::CommandBufferDescriptor bufferDescriptor{.label = "GX finish GPU prefix"};
+    const auto commands = encoder.Finish(&bufferDescriptor);
+    g_queue.Submit(1, &commands);
+    if (packet) {
+      webgpu::gpu_prof::after_submit();
+      auto callbacks = std::move(packet->afterSubmitCallbacks);
+      packet->afterSubmitCallbacks.clear();
+      for (auto& callback : callbacks) if (callback) callback();
+      after_submit();
+    }
+    // A parser acknowledgement or render-worker drain is never this fence.
+    // The future is registered strictly AFTER the corresponding Queue Submit.
+    struct Completion { wgpu::QueueWorkDoneStatus status = wgpu::QueueWorkDoneStatus::Error; };
+    auto completion = std::make_shared<Completion>();
+    const auto future = g_queue.OnSubmittedWorkDone(wgpu::CallbackMode::WaitAnyOnly,
+        [completion](wgpu::QueueWorkDoneStatus status, wgpu::StringView) { completion->status = status; });
+    const auto waited = g_instance.WaitAny(future, 5'000'000'000);
+    AURORA_ASSERT(waited == wgpu::WaitStatus::Success,
+                  "GX submitted GPU work wait failed: {}", magic_enum::enum_name(waited));
+    AURORA_ASSERT(completion->status == wgpu::QueueWorkDoneStatus::Success,
+                  "GX submitted GPU work failed: {}", magic_enum::enum_name(completion->status));
+    // Dawn deliberately reports QueueWorkDone Success after device loss too.
+    // Its actual lost future is a separate required failure gate; queue status
+    // alone cannot establish that this physical GPU prefix executed.
+    AURORA_ASSERT(g_instance.WaitAny(g_device.GetLostFuture(), 0) == wgpu::WaitStatus::TimedOut,
+                  "GX submitted work completed on a lost GPU device");
+    if (packet) {
+      // Remap the same actual staging slot only after its GPU readers finish.
+      // Restore rounded prefixes because a later unaligned CopyBufferToBuffer
+      // may start before its logical high-water mark. Keep original offsets and
+      // array cached ranges; do not begin another frame or replay old operations.
+      const size_t slot = packet->stagingBuffer;
+      const auto mapped = g_stagingBuffers[slot].MapAsync(
+          wgpu::MapMode::Write, 0, StagingBufferSize, wgpu::CallbackMode::WaitAnyOnly,
+          [](wgpu::MapAsyncStatus status, wgpu::StringView) {
+            AURORA_ASSERT(status == wgpu::MapAsyncStatus::Success,
+                          "GX continuation staging map failed: {}", magic_enum::enum_name(status));
+          });
+      AURORA_ASSERT(g_instance.WaitAny(mapped, 5'000'000'000) == wgpu::WaitStatus::Success,
+                    "GX continuation staging map wait failed");
+      g_mappingStates[slot].store(BufferMapState::Mapped, std::memory_order_release);
+      const std::array<ByteBuffer*, 5> buffers{
+          &packet->verts, &packet->uniforms, &packet->indices,
+          &packet->storage, &packet->textureUpload};
+      const std::array<uint64_t, 5> capacities{
+          VertexBufferSize, UniformBufferSize, IndexBufferSize,
+          StorageBufferSize, UseTextureBuffer ? TextureUploadSize : 0};
+      size_t offset = 0;
+      for (size_t i = 0; i < buffers.size(); ++i) {
+        if (capacities[i] == 0) continue;
+        auto* data = static_cast<uint8_t*>(g_stagingBuffers[slot].GetMappedRange(offset, capacities[i]));
+        *buffers[i] = ByteBuffer{data, static_cast<size_t>(capacities[i])};
+        if (prefixes[i].logicalSize != 0)
+          buffers[i]->append(prefixes[i].bytes.data(), prefixes[i].logicalSize);
+        if (!prefixes[i].bytes.empty())
+          std::memcpy(data, prefixes[i].bytes.data(), prefixes[i].bytes.size());
+        offset += capacities[i];
+      }
+      packet->encoder = g_device.CreateCommandEncoder(&descriptor);
+      webgpu::gpu_prof::frame_begin(packet->encoder);
+    }
+    process_events();
+  });
+  render_worker::synchronize();
+}
