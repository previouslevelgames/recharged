+void reset_draw_done() noexcept {
+  AURORA_ASSERT(sOwner == std::this_thread::get_id(), "GXSetDrawDone requires the GX owner thread");
+  sDrawDone = false;
+}
+
+void publish_draw_done() noexcept {
+  if (detail::sInDisplayList) return;
+  const uint64_t target = sStreamBase + detail::sBufferSize;
+  sPendingDraws = 0;
+  sPublished.store(target, std::memory_order_release);
+  if (kProcessingMode == ProcessingMode::Thread) wake_worker();
+  else process_to(target, std::memory_order_relaxed);
+}
+
+bool service_draw_done() {
+  // A background SDK yield never dispatches game callbacks on that worker.
+  if (sOwner != std::this_thread::get_id()) return false;
+  const BOOL enabled = OSDisableInterrupts();
+  struct Mask { BOOL enabled; ~Mask() { OSRestoreInterrupts(enabled); } } mask{enabled};
+  if (!enabled || !sGpuFinishPending.exchange(false, std::memory_order_acq_rel)) return false;
+  sDrawDone = true;
+  if (const auto callback = sDrawDoneCallback.load(std::memory_order_acquire)) {
+    OSContext temporary{};
+    OSContext* previous = OSGetCurrentContext();
+    struct Context { OSContext* prior; OSContext* temporary;
+      ~Context() { OSClearContext(temporary); OSSetCurrentContext(prior); }
+    } context{previous, &temporary};
+    OSClearContext(&temporary);
+    OSSetCurrentContext(&temporary);
+    callback();
+  }
+  return true;
+}
+
+void wait_draw_done() {
+  AURORA_ASSERT(sOwner == std::this_thread::get_id(), "GXWaitDrawDone requires the GX owner thread");
+  const BOOL enabled = OSDisableInterrupts();
+  struct Mask { BOOL enabled; ~Mask() { OSRestoreInterrupts(enabled); } } mask{enabled};
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{10};
+  while (!sDrawDone) {
+    // Native equivalent of source OSSleepThread: allow the genuine latched
+    // interrupt while the source owner sleeps, then reenter its critical section.
+    OSEnableInterrupts();
+    service_draw_done();
+    std::this_thread::yield();
+    OSDisableInterrupts();
+    AURORA_ASSERT(sDrawDone || std::chrono::steady_clock::now() < deadline,
+                  "GXWaitDrawDone timed out without a genuine GPU finish interrupt");
+  }
+}
