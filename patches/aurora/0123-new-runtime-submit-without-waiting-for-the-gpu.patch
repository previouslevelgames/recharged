+
+void submit_hardware_frame() {
+  // The finish opcode only hands the packet to the GPU here. The parser has
+  // copied all source data it reads, and later GPU work (the next frame, the
+  // VI present of its XFB copy) runs after it on the same queue.
+  finish();
+  const bool hasWork = recording_has_gpu_work();
+  end_frame([hasWork](wgpu::CommandEncoder& encoder, std::vector<AfterSubmitCallback> callbacks) {
+    webgpu::gpu_prof::frame_end(encoder);
+    const wgpu::CommandBufferDescriptor descriptor{.label = "Original GX native submission"};
+    const auto commands = encoder.Finish(&descriptor);
+    g_queue.Submit(1, &commands);
+    webgpu::gpu_prof::after_submit();
+    for (auto& callback : callbacks) if (callback) callback();
+    after_submit();
+    if (!hasWork) {
+      return;
+    }
+    // At most one frame queued behind the CPU: with this one keeping the GPU
+    // busy, wait for the previous frame.
+    auto submission = track_submission();
+    if (g_lastWorkSubmission) {
+      wait_submission(*g_lastWorkSubmission);
+    }
+    g_lastWorkSubmission = std::move(submission);
   });
   render_worker::synchronize();
 }
