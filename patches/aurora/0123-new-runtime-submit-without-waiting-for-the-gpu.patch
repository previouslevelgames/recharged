+// New runtime, render worker only: GPU completion of the last submitted
+// native packet with GPU work, waited for once the next one is submitted.
+struct PendingSubmission {
+  wgpu::Future future;
+  std::shared_ptr<wgpu::QueueWorkDoneStatus> status;
+};
+std::optional<PendingSubmission> g_lastWorkSubmission;
+
+PendingSubmission track_submission() {
+  auto status = std::make_shared<wgpu::QueueWorkDoneStatus>(wgpu::QueueWorkDoneStatus::Error);
+  const auto future = g_queue.OnSubmittedWorkDone(
+      wgpu::CallbackMode::WaitAnyOnly, [status](wgpu::QueueWorkDoneStatus result, wgpu::StringView) { *status = result; });
+  return {future, std::move(status)};
+}
+
+void wait_submission(const PendingSubmission& submission) {
+  ZoneScopedN("Wait for previous GPU frame");
+  const auto waited = g_instance.WaitAny(submission.future, 5'000'000'000);
+  AURORA_ASSERT(waited == wgpu::WaitStatus::Success && *submission.status == wgpu::QueueWorkDoneStatus::Success,
+                "Original GX native submission failed to complete on the GPU");
+  AURORA_ASSERT(g_instance.WaitAny(g_device.GetLostFuture(), 0) == wgpu::WaitStatus::TimedOut,
+                "Original GX native submission completed on a lost GPU device");
+}
