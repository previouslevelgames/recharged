 #include <dolphin/types.h>
+#include <stddef.h>
 
 #ifdef __cplusplus
 extern "C" {
@@ -11,6 +12,15 @@
 s32 THPVideoDecode(const void* file, void* tileY, void* tileU, void* tileV, void* work /* unused */);
 u32 THPAudioDecode(s16* audioBuffer, const u8* audioFrame, s32 flag);
 
+// Additive native bounds. Planes use GX I8 tile layout. Audio preserves the SDK
+// interleaved R,L (flag0) or planar R then L (flag1) channel order. Zero audio
+// return means invalid/truncated input. Output may be partially written on a
+// video decode error; callers publish only after successful completion.
+s32 AuroraTHPVideoDecodeBounded(const void* file, size_t fileSize,
+                               void* tileY, size_t sizeY, void* tileU, size_t sizeU, void* tileV, size_t sizeV,
+                               u32 width, u32 height);
+u32 AuroraTHPAudioDecodeBounded(s16* output, size_t outputSamples, const u8* frame, size_t frameSize, s32 flag);
+
 #ifdef __cplusplus
 }
 #endif
