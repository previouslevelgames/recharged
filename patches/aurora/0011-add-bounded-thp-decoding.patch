diff --git a/lib/dolphin/thp/THPAudio.cpp b/lib/dolphin/thp/THPAudio.cpp
--- a/lib/dolphin/thp/THPAudio.cpp
+++ b/lib/dolphin/thp/THPAudio.cpp
@@ -117,4 +117,18 @@
   }
   return header.sampleCount;
 }
+
+// Bounded native admission; the actual sample equations and SDK R,L output
+// order remain shared with THPAudioDecode above.
+u32 AuroraTHPAudioDecodeBounded(s16* output, size_t outputSamples, const u8* frame, size_t frameSize, s32 flag) {
+  if (output == nullptr || frame == nullptr || frameSize < kHeaderSize || (flag != 0 && flag != 1)) return 0;
+  const AudioHeader header = read_header(frame);
+  if (header.sampleCount == 0 || header.sampleCount > outputSamples / 2) return 0;
+  const uint64_t channelSize = ((uint64_t{header.sampleCount} + 13) / 14) * 8;
+  if (channelSize > frameSize - kHeaderSize) return 0;
+  if (header.nextChannelOffset != 0 &&
+      (header.nextChannelOffset < channelSize || header.nextChannelOffset > frameSize - kHeaderSize ||
+       channelSize > frameSize - kHeaderSize - header.nextChannelOffset)) return 0;
+  return THPAudioDecode(output, frame, flag);
 }
+}
