+// Set up the last selected polygon's depth plane before CULL_ALL rejects rasterization.
+// Finite positive-W side-offscreen vertices define the same window-depth plane.
+// Unsupported setup remains invalid rather than supplying a default depth.
+bool co_planar_position(GXVtxFmt fmt, std::span<const u8> vertex, Vec4<float>& clip) noexcept {
+  u32 offset = 0;
+  for (int attr = GX_VA_PNMTXIDX; attr <= GX_VA_TEX7MTXIDX; ++attr) {
+    if (g_gxState.vtxDesc[attr] == GX_DIRECT) ++offset;
+  }
+  const auto& format = g_gxState.vtxFmts[fmt].attrs[GX_VA_POS];
+  const u32 componentBytes = comp_type_size(GX_VA_POS, format.type);
+  const u32 components = comp_cnt_count(GX_VA_POS, format.cnt);
+  if (components < 2 || components > 3 || componentBytes == 0) return false;
+  const u32 bytes = componentBytes * components;
+  const u8* data = nullptr;
+  bool littleEndian = false;
+  const auto descriptor = g_gxState.vtxDesc[GX_VA_POS];
+  if (descriptor == GX_DIRECT) {
+    if (offset > vertex.size() || bytes > vertex.size() - offset) return false;
+    data = vertex.data() + offset;
+  } else if (descriptor == GX_INDEX8 || descriptor == GX_INDEX16) {
+    const u32 indexBytes = descriptor == GX_INDEX8 ? 1 : 2;
+    if (offset > vertex.size() || indexBytes > vertex.size() - offset) return false;
+    const u32 index = indexBytes == 1 ? vertex[offset] : (u32(vertex[offset]) << 8) | vertex[offset + 1];
+    const auto& array = g_gxState.arrays[GX_VA_POS];
+    const u64 start = u64(index) * array.stride;
+    if (!array.data || start > array.size || bytes > array.size - start) return false;
+    data = static_cast<const u8*>(array.data) + start;
+    littleEndian = array.le;
+  } else {
+    return false;
+  }
+  const auto word = [littleEndian](const u8* p, u32 count) {
+    u32 value = 0;
+    for (u32 i = 0; i < count; ++i) {
+      const u32 shift = littleEndian ? i * 8 : (count - 1 - i) * 8;
+      value |= u32(p[i]) << shift;
+    }
+    return value;
+  };
+  const float scale = format.type == GX_F32 ? 1.f : std::ldexp(1.f, -int(format.frac));
+  float position[3]{};
+  for (u32 i = 0; i < components; ++i) {
+    const u32 value = word(data + i * componentBytes, componentBytes);
+    switch (format.type) {
+    case GX_U8: case GX_U16: position[i] = float(value) * scale; break;
+    case GX_S8: position[i] = float(std::bit_cast<s8>(u8(value))) * scale; break;
+    case GX_S16: position[i] = float(std::bit_cast<s16>(u16(value))) * scale; break;
+    case GX_F32: position[i] = std::bit_cast<float>(value); break;
+    default: return false;
+    }
+    if (!std::isfinite(position[i])) return false;
+  }
+  u32 matrix = g_gxState.currentPnMtx;
+  if (g_gxState.vtxDesc[GX_VA_PNMTXIDX] == GX_DIRECT) {
+    if (vertex.empty()) return false;
+    matrix = vertex.front() / 3;
+  }
+  if (matrix >= MaxPnMtx + MaxTexMtx) return false;
+  const auto& model = matrix < MaxPnMtx ? g_gxState.pnMtx[matrix].pos : g_gxState.texMtxs[matrix - MaxPnMtx];
+  const auto row = [&](const Vec4<float>& r) {
+    return r[0] * position[0] + r[1] * position[1] + r[2] * position[2] + r[3];
+  };
+  const Vec4<float> eye{row(model.m0), row(model.m1), row(model.m2), 1.f};
+  const auto projection = effective_projection();
+  const auto project = [&](const Vec4<float>& r) {
+    return r[0] * eye[0] + r[1] * eye[1] + r[2] * eye[2] + r[3] * eye[3];
+  };
+  clip = {project(projection.m0), project(projection.m1), project(projection.m2), project(projection.m3)};
+  return std::isfinite(clip[0]) && std::isfinite(clip[1]) && std::isfinite(clip[2]) && std::isfinite(clip[3]);
+}
+
+void capture_co_planar_reference(GXPrimitive primitive, GXVtxFmt fmt, std::span<const u8> vertices,
+                                 u16 vertexCount, u32 vertexStride, std::span<const u8> indices = {},
+                                 bool indexed = false) noexcept {
+  auto& reference = g_coPlanarState;
+  if (reference.enabled || vertexCount == 0 || (indexed && indices.empty())) return;
+  reference.valid = false;
+  std::array<u32, 3> last{};
+  if (indexed) {
+    if (primitive != GX_TRIANGLES || indices.size() % (3 * sizeof(u16)) != 0) return;
+    for (u32 i = 0; i < 3; ++i) {
+      u16 index;
+      std::memcpy(&index, indices.data() + indices.size() - (3 - i) * sizeof(u16), sizeof(index));
+      if (index >= vertexCount) return;
+      last[i] = index;
+    }
+  } else if (primitive == GX_TRIANGLES && vertexCount >= 3 && vertexCount % 3 == 0) {
+    last = {u32(vertexCount) - 3, u32(vertexCount) - 2, u32(vertexCount) - 1};
+  } else if (primitive == GX_QUADS && vertexCount >= 4 && vertexCount % 4 == 0) {
+    // Same final triangle order as prepare_idx_buffer, not the last three records.
+    last = {u32(vertexCount) - 2, u32(vertexCount) - 1, u32(vertexCount) - 4};
+  } else if (primitive == GX_TRIANGLEFAN && vertexCount >= 3) {
+    last = {0, u32(vertexCount) - 2, u32(vertexCount) - 1};
+  } else if (primitive == GX_TRIANGLESTRIP && vertexCount >= 3) {
+    last = {u32(vertexCount) - 3, u32(vertexCount) - 2, u32(vertexCount) - 1};
+  } else {
+    return;
+  }
+  const auto& viewport = g_gxState.renderViewport;
+  if (!(viewport.width > 0.f && viewport.height > 0.f)) return;
+  const float nearDepth = UseReversedZ ? 1.f - viewport.zfar : viewport.znear;
+  const float farDepth = UseReversedZ ? 1.f - viewport.znear : viewport.zfar;
+  float window[3][3];
+  for (u32 i = 0; i < 3; ++i) {
+    const size_t start = size_t(last[i]) * vertexStride;
+    if (start > vertices.size() || vertexStride > vertices.size() - start) return;
+    Vec4<float> clip;
+    if (!co_planar_position(fmt, vertices.subspan(start, vertexStride), clip)) return;
+    // Side clipping/scissor do not change a finite planar setup equation.
+    // Near/far-clipped and behind-eye reference setup are not implemented.
+    if (!(clip[3] > 0.f) || clip[2] < 0.f || clip[2] > clip[3]) return;
+    window[i][0] = viewport.left + (clip[0] / clip[3] + 1.f) * .5f * viewport.width;
+    window[i][1] = viewport.top + (1.f - clip[1] / clip[3]) * .5f * viewport.height;
+    window[i][2] = nearDepth + clip[2] / clip[3] * (farDepth - nearDepth);
+  }
+  const float x1 = window[1][0] - window[0][0], y1 = window[1][1] - window[0][1];
+  const float z1 = window[1][2] - window[0][2];
+  const float x2 = window[2][0] - window[0][0], y2 = window[2][1] - window[0][1];
+  const float z2 = window[2][2] - window[0][2];
+  const float determinant = x1 * y2 - x2 * y1;
+  if (determinant == 0.f || !std::isfinite(determinant)) return;
+  const float a = (z1 * y2 - z2 * y1) / determinant;
+  const float b = (x1 * z2 - x2 * z1) / determinant;
+  const float c = window[0][2] - a * window[0][0] - b * window[0][1];
+  if (!std::isfinite(a) || !std::isfinite(b) || !std::isfinite(c)) return;
+  reference.plane = {a, b, c, 0.f};
+  reference.viewport = viewport;
+  reference.valid = true;
+  ++reference.generation;
+}
+
+void require_co_planar_reference(GXPrimitive primitive) noexcept {
+  const auto& reference = g_coPlanarState;
+  if (!reference.enabled) return;
+  AURORA_ASSERT(line_mode_for_prim(primitive) == 0,
+                "GX co-planar: depth freeze for lines/points is not implemented");
+  AURORA_ASSERT(reference.valid, "GX co-planar: reference plane is absent, unsupported or degenerate");
+  const auto& a = reference.viewport;
+  const auto& b = g_gxState.renderViewport;
+  AURORA_ASSERT(a.left == b.left && a.top == b.top && a.width == b.width && a.height == b.height &&
+                a.znear == b.znear && a.zfar == b.zfar,
+                "GX co-planar: viewport changes while depth is frozen are not implemented");
 }
 
