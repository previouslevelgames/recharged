From: mscharged-port contributors
Subject: [PATCH] Full-detail desktop picture of a scaled EFB
Upstream-base: d664382f57002fbff143911c81b06b7e7a4b3ab4
Classification: host presentation (internal resolution). Apply after 0084.

The display copy writes the original 640 x 448 YUYV XFB, so a scaled EFB
lost its detail before the desktop scanout. When the EFB is larger than
the copy, the copy now first keeps the same source rectangle at its
physical size as RGB (the original YUYV copy still clears the EFB), and the
Clean/Sharp desktop pictures sample that full-detail copy with the same
signal geometry. The TV picture and every 1x path are unchanged.

diff --git a/lib/gfx/scanout.cpp b/lib/gfx/scanout.cpp
index e1a1ca2..e1a8784 100644
--- a/lib/gfx/scanout.cpp
+++ b/lib/gfx/scanout.cpp
@@ -109,6 +109,52 @@ fn desktop_rgb(source: vec2i) -> vec3f {
   return vec4f(mix(upper,lower,weight.y),1.0);
 }
 )";
+// Desktop picture from a scaled EFB's full-detail XFB copy (internal
+// resolution above 1x). Same signal geometry as DesktopShader; detail.xy is
+// the copy's pixels per XFB pixel.
+struct alignas(16) ScaledUniforms {
+  Uniforms base;
+  std::array<float, 4> detail;
+};
+static_assert(sizeof(ScaledUniforms) == 80);
+constexpr auto ScaledShader = R"(
+struct Uniforms { signal: vec4u, display: vec4u, source_geometry: vec4u, output: vec4f, detail: vec4f, };
+@group(0) @binding(0) var copy: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> vi: Uniforms;
+@vertex fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
+  switch index {
+    case 0u: { return vec4f(-1.0,-1.0,0.0,1.0); }
+    case 1u: { return vec4f(3.0,-1.0,0.0,1.0); }
+    default: { return vec4f(-1.0,3.0,0.0,1.0); }
+  }
+}
+@fragment fn fragment_scaled(@builtin(position) position: vec4f) -> @location(0) vec4f {
+  let signal_position=position.xy*vi.output.xy;
+  let at=vec2u(signal_position);
+  if any(at<vi.signal.zw) || any(at>=vi.signal.zw+vi.display.xy) {
+    return vec4f(0.0,0.0,0.0,1.0);
+  }
+  // XFB position of this pixel, then the full-detail copy's texel centres.
+  let xfb_position=(signal_position-vec2f(vi.signal.zw))*vec2f(vi.source_geometry.xy)/
+      vec2f(vi.display.xy)+vec2f(vi.display.zw);
+  let source=xfb_position*vi.detail.xy-vec2f(0.5);
+  let first=vec2i(floor(source));
+  let last=first+vec2i(1);
+  let minimum=vec2i(floor(vec2f(vi.display.zw)*vi.detail.xy));
+  let maximum=min(minimum+vec2i(floor(vec2f(vi.source_geometry.xy)*vi.detail.xy))-vec2i(1),
+      vec2i(textureDimensions(copy))-vec2i(1));
+  var weight=fract(source);
+  // Sharp: flat copy pixels blended only over about one desktop pixel.
+  if vi.output.z>0.0 {
+    weight=clamp((weight-vec2f(0.5))*vi.output.zw/vi.detail.xy+vec2f(0.5),vec2f(0.0),vec2f(1.0));
+  }
+  let upper=mix(textureLoad(copy,clamp(first,minimum,maximum),0).rgb,
+      textureLoad(copy,clamp(vec2i(last.x,first.y),minimum,maximum),0).rgb,weight.x);
+  let lower=mix(textureLoad(copy,clamp(vec2i(first.x,last.y),minimum,maximum),0).rgb,
+      textureLoad(copy,clamp(last,minimum,maximum),0).rgb,weight.x);
+  return vec4f(mix(upper,lower,weight.y),1.0);
+}
+)";
 struct Output {
   std::mutex mutex;
   std::mutex display_gate;
