+      // Desktop pictures of a scaled EFB use its full-detail copy.
+      const bool detail = !physicalField && picture != AURORA_DESKTOP_SIGNAL && scaledPipeline &&
+          snapshot->scaled && snapshot->width && snapshot->height;
+      const ScaledUniforms scaledValues{values,
+          {detail ? static_cast<float>(snapshot->scaled->size.width) / static_cast<float>(snapshot->width) : 1.0f,
+           detail ? static_cast<float>(snapshot->scaled->size.height) / static_cast<float>(snapshot->height) : 1.0f,
+           0.0f, 0.0f}};
+      const auto bytes = detail ? sizeof(scaledValues) : sizeof(values);
       const wgpu::BufferDescriptor desc{.label = "Original VI field geometry",
-          .usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst, .size = sizeof(values)};
-      uniform = webgpu::g_device.CreateBuffer(&desc); webgpu::g_queue.WriteBuffer(uniform, 0, &values, sizeof(values));
-      const std::array entries{wgpu::BindGroupEntry{.binding = 0, .textureView = snapshot->packedYuyv->sampleTextureView},
-          wgpu::BindGroupEntry{.binding = 1, .buffer = uniform, .size = sizeof(values)}};
+          .usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst, .size = bytes};
+      uniform = webgpu::g_device.CreateBuffer(&desc);
+      if (detail) webgpu::g_queue.WriteBuffer(uniform, 0, &scaledValues, bytes);
+      else webgpu::g_queue.WriteBuffer(uniform, 0, &values, bytes);
+      const std::array entries{wgpu::BindGroupEntry{.binding = 0,
+              .textureView = detail ? snapshot->scaled->sampleTextureView : snapshot->packedYuyv->sampleTextureView},
+          wgpu::BindGroupEntry{.binding = 1, .buffer = uniform, .size = bytes}};
       const wgpu::BindGroupDescriptor groupDesc{.layout = layout, .entryCount = entries.size(), .entries = entries.data()};
       const auto group = webgpu::g_device.CreateBindGroup(&groupDesc);
-      pass.SetPipeline(pipeline); pass.SetBindGroup(0, group); pass.Draw(3);
+      pass.SetPipeline(detail ? *scaledPipeline : pipeline); pass.SetBindGroup(0, group); pass.Draw(3);
     }
     pass.End();
 }
