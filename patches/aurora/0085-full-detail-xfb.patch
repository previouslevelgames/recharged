         .clearValue = {0.0, 0.0, 0.0, 1.0}};
@@ -266,14 +312,25 @@ void encode_signal(const wgpu::CommandEncoder& encoder, const TextureHandle& des
           {scanout.vi_width, scanout.vi_height, scanout.pan_x, scanout.pan_y},
           {scanout.pan_width, scanout.pan_height, scanout.field, physicalField && (scanout.tv_mode & 3u) == VI_INTERLACE},
