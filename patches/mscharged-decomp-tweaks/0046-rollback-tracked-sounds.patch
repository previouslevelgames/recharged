+// What the audio did of the tracked sounds the match wants
+// (mscharged_rollback_audio.h): here, among the audio's globals, which no
+// rollback restores, as the sound they describe goes on.
+static MschargedTrackedSounds sAppliedTrackedSounds;
+// The reconciliation's own calls leave both tables alone, and so do the
+// system's pause and resume (PauseAllAudio, ResumeAllAudio): those are not
+// the match's.
+static bool sReconcilingTrackedSounds;
+static bool sPausingAllAudio;
+static char sReconciledCue[] = "Reconciled cue";
+
+// Raises a guard above for a scope, on every way out of it.
+struct AudioGuardScope
+{
+    bool& guard;
+    bool was;
+
+    explicit AudioGuardScope(bool& guard) : guard(guard), was(guard) { guard = true; }
+    ~AudioGuardScope() { guard = was; }
+};
+
+static int FindTrackedSound(MschargedTrackedSounds* soundTable, unsigned long cueId, void* context, bool add)
+{
+    MschargedTrackedSound* sounds = soundTable->sounds;
+    for (int i = 0; i < soundTable->used; i++)
+    {
+        if (sounds[i].cueId == cueId && sounds[i].context == context)
+        {
+            return i;
+        }
+    }
+    if (!add || soundTable->used == MSCHARGED_TRACKED_SOUNDS)
+    {
+        return -1;
+    }
+    MschargedTrackedSound& sound = sounds[soundTable->used];
+    sound.slotId = 0;
+    sound.cueId = cueId;
+    sound.context = context;
+    sound.resumable = false;
+    sound.state = MSCHARGED_TRACKED_SOUND_STOPPED;
+    sound.generation = 0;
+    return soundTable->used++;
+}
+
+// A stopped sound leaves its table; the last one takes its place.
+static void RemoveTrackedSound(MschargedTrackedSounds* soundTable, int index)
+{
+    soundTable->sounds[index] = soundTable->sounds[--soundTable->used];
+}
+
+// Whether a call is the match's, for the tables: under the rollback, not the
+// reconciliation's nor the system pause's, and for a cue and a context a later
+// call can find (no cue is 0xFFFFFFFF; without a context the audio keeps no
+// handle).
+static bool IsMatchTrackedSound(unsigned long cueId, void* context)
+{
+    return mscharged_rollback_active() && !sReconcilingTrackedSounds && !sPausingAllAudio
+        && cueId != 0xFFFFFFFF && context != 0;
+}
+
+// The match wants a tracked sound playing: a new start, in replays too, as
+// its table is among the globals a rollback restores. A full table leaves the
+// sound to the audio as before.
+static void WantTrackedSoundPlaying(int slotId, unsigned long cueId, void* context, bool resumable)
+{
+    if (!IsMatchTrackedSound(cueId, context))
+    {
+        return;
+    }
+    const int index = FindTrackedSound(&gMschargedWantedTrackedSounds, cueId, context, true);
+    if (index < 0)
+    {
+        return;
+    }
+    MschargedTrackedSound& sound = gMschargedWantedTrackedSounds.sounds[index];
+    sound.slotId = slotId;
+    sound.resumable = resumable;
+    sound.state = MSCHARGED_TRACKED_SOUND_PLAYING;
+    ++sound.generation;
+}
+
+// The match wants it stopped: it leaves the table. A sound the table does not
+// hold (one with a handle but not tracked, or never started) is left alone.
+static void WantTrackedSoundStopped(unsigned long cueId, void* context)
+{
+    if (!IsMatchTrackedSound(cueId, context))
+    {
+        return;
+    }
+    const int index = FindTrackedSound(&gMschargedWantedTrackedSounds, cueId, context, false);
+    if (index < 0)
+    {
+        return;
+    }
+    RemoveTrackedSound(&gMschargedWantedTrackedSounds, index);
+}
+
+// The match wants it paused or playing again: only a playing sound pauses and
+// only a paused one resumes, as the audio does.
+static void WantTrackedSoundPaused(unsigned long cueId, void* context, bool paused)
+{
+    if (!IsMatchTrackedSound(cueId, context))
+    {
+        return;
+    }
+    const int index = FindTrackedSound(&gMschargedWantedTrackedSounds, cueId, context, false);
+    if (index < 0)
+    {
+        return;
+    }
+    MschargedTrackedSound& sound = gMschargedWantedTrackedSounds.sounds[index];
+    const MschargedTrackedSoundState from = paused ? MSCHARGED_TRACKED_SOUND_PLAYING : MSCHARGED_TRACKED_SOUND_PAUSED;
+    if (sound.state != from)
+    {
+        return;
+    }
+    sound.state = paused ? MSCHARGED_TRACKED_SOUND_PAUSED : MSCHARGED_TRACKED_SOUND_PLAYING;
+}
+
+// After the audio did the match's call (outside replays, on every way out of
+// the call): what it applied of that sound is what the match wants. A pause or
+// a resume under the system's pause does not apply yet (ResumeSound waits for
+// the system's resume, which resumes what the system paused): the
+// reconciliation applies it after a rollback outside the system's pause.
+struct AppliedTrackedSoundScope
+{
+    unsigned long cueId;
+    void* context;
+    bool pauseOrResume;
+
+    ~AppliedTrackedSoundScope()
+    {
+        if (!IsMatchTrackedSound(cueId, context) || (pauseOrResume && sAudioPauseDepth > 1))
+        {
+            return;
+        }
+        const int wanted = FindTrackedSound(&gMschargedWantedTrackedSounds, cueId, context, false);
+        const int applied = FindTrackedSound(&sAppliedTrackedSounds, cueId, context, wanted >= 0);
+        if (applied < 0)
+        {
+            return;
+        }
+        if (wanted < 0)
+        {
+            RemoveTrackedSound(&sAppliedTrackedSounds, applied);
+            return;
+        }
+        sAppliedTrackedSounds.sounds[applied] = gMschargedWantedTrackedSounds.sounds[wanted];
+    }
+};
+#endif
 
