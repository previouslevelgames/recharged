+#if defined(MSCHARGED_TWEAKS)
+extern "C" void mscharged_rollback_audio_reconcile_tracked_sounds(void)
+{
+    if (mscharged_rollback_resimulating() || sReconcilingTrackedSounds)
+    {
+        return;
+    }
+    MSCHARGED_AUDIO_SCOPE();
+    AudioGuardScope reconciling(sReconcilingTrackedSounds);
+    MschargedTrackedSounds* wanted = &gMschargedWantedTrackedSounds;
+    MschargedTrackedSounds* applied = &sAppliedTrackedSounds;
+    // Those the match no longer wants: stopped in a replay, or started in a
+    // timeline a rollback took back.
+    for (int i = applied->used - 1; i >= 0; --i)
+    {
+        const MschargedTrackedSound& sound = applied->sounds[i];
+        if (FindTrackedSound(wanted, sound.cueId, sound.context, false) < 0)
+        {
+            StopSound(sound.cueId, sound.context);
+            RemoveTrackedSound(applied, i);
+        }
+    }
+    // Then those it wants. Another start than the audio's (started in a
+    // replay, or again) ends the audio's and plays from the start; a sound that
+    // ended by itself keeps its start and is left alone. Pauses and resumes
+    // wait for the end of the system's pause, which holds them back.
+    for (int i = 0; i < wanted->used; ++i)
+    {
+        const MschargedTrackedSound& want = wanted->sounds[i];
+        const int index = FindTrackedSound(applied, want.cueId, want.context, true);
+        if (index < 0)
+        {
+            continue;
+        }
+        MschargedTrackedSound& sound = applied->sounds[index];
+        if (sound.generation != want.generation)
+        {
+            StopSound(want.cueId, want.context);
+            PlayTrackedOwnedSound(want.slotId, want.cueId, 0, sReconciledCue, want.context, want.resumable);
+            sound = want;
+            sound.state = MSCHARGED_TRACKED_SOUND_PLAYING;
+        }
+        if (sound.state != want.state && sAudioPauseDepth == 1)
+        {
+            if (want.state == MSCHARGED_TRACKED_SOUND_PAUSED)
+            {
+                PauseSound(want.cueId, want.context);
+            }
+            else
+            {
+                ResumeSound(want.cueId, want.context);
+            }
+            sound.state = want.state;
+        }
+    }
+}
+
+// Whether a tracked sound the tables say plays ended by itself: its handle
+// stopped, or there is none. A paused sound that cannot resume has no handle
+// until it resumes, so only playing ones are asked about.
+static bool TrackedSoundEnded(const MschargedTrackedSound& sound)
+{
+    if (sound.state != MSCHARGED_TRACKED_SOUND_PLAYING)
+    {
+        return false;
+    }
+    XSoundHandle* handle = FindSoundHandle(sound.cueId, sound.context);
+    const int state = handle != 0 ? handle->m_State : SOUND_HANDLE_STOPPED;
+    return state == SOUND_HANDLE_STOPPED || state == SOUND_HANDLE_RELEASED || state == SOUND_HANDLE_FAILED;
+}
+
+extern "C" void mscharged_rollback_audio_tracking_start(void)
+{
+    MSCHARGED_AUDIO_SCOPE();
+    MschargedTrackedSounds* tables[2] = { &gMschargedWantedTrackedSounds, &sAppliedTrackedSounds };
+    for (int t = 0; t < 2; ++t)
+    {
+        for (int i = tables[t]->used - 1; i >= 0; --i)
+        {
+            if (TrackedSoundEnded(tables[t]->sounds[i]))
+            {
+                RemoveTrackedSound(tables[t], i);
+            }
+        }
+    }
+}
+#endif
+
