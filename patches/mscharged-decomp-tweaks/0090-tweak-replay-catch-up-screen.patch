@@ -52,6 +52,11 @@ bool mscharged_tweak_replay_tick_over(void);
 // Whether a live replay catches up as fast as the computer can now: it
 // starts no sound but the tracked ones meanwhile, its sound being off.
 bool mscharged_tweak_replay_turbo(void);
+// Whether a step records no frame for the goal replays (tweak patch 0090):
+// while a live replay catches up behind the catch-up screen, until its last
+// 10 s. Nothing in the match reads them, only the goal replays and the
+// drawing, which the screen hides.
+bool mscharged_tweak_replay_skips_snapshot(void);
 // How many times faster the wipes around cutscenes run: more than 1 while a
 // live replay catches up.
 float mscharged_tweak_replay_wipe_speed(void);
