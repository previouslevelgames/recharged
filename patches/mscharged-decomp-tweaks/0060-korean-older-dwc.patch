--- /dev/null
+++ b/libs/RVL_SDK/include/dwc/mscharged_older_dwc_begin.h
@@ -0,0 +1,16 @@
+#if defined(MSCHARGED_TWEAKS)
+// The Korean game builds the DWC and GameSpy of the American and Japanese
+// releases (tweak patch 0060): before each of their release branches, and
+// before the game's calls that take the Korean DWC's arguments, this header
+// hides the Korean release and shows the Japanese one;
+// mscharged_older_dwc_end.h, after the branch, shows the Korean release
+// again. Only those branches see it, and they include no header of the rest
+// of the SDK but the C library's, so NHTTP, NET, NAND and the others keep the
+// Korean layouts everywhere. No include guard: it opens every branch.
+#if defined(VERSION_R4QK01) && !defined(MSCHARGED_OLDER_DWC)
+#pragma push_macro("VERSION_R4QK01")
+#undef VERSION_R4QK01
+#define VERSION_R4QJ01 1
+#define MSCHARGED_OLDER_DWC 1
+#endif
+#endif
