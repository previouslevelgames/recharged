+#if defined(MSCHARGED_TWEAKS)
+// Port: GameCube controls (DetInput.cpp). Charged turned two of Super Mario
+// Strikers' button actions into shakes. A GameCube player presses SMS's
+// buttons for them again, through the GameCube table (gGameCubeButtonRemap):
+// action 22 cycles the item (Z) and action 24 is the big hit (Y), which SMS
+// gives only to a player without the ball (with it, Y dekes).
+static bool GameCubeShake(DetInput* input, int action, bool withoutBall)
+{
+    if (withoutBall)
+    {
+        cPlayer* owner = g_pBall != 0 ? g_pBall->GetOwner() : 0;
+        if (owner != 0 && owner->GetGlobalPad() == input)
+            return false;
+    }
+    return input->JustPressed(action, true);
+}
+#endif
+
 bool cAIPad::DetectLeftShake(u16* direction)
 {
+#if defined(MSCHARGED_TWEAKS)
+    if (m_pGlobalPad != 0 && m_pGlobalPad->GetControllerType() == DET_CONTROLLER_GAMECUBE)
+    {
+        *direction = 0;
+        return GameCubeShake(m_pGlobalPad, 22, false);
+    }
+#endif
