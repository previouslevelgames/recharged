+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "Feder's fair ball contests": every step updates the defending
+// team's players first, each team in an order shuffled without bias. Online
+// matches always play with it, so that both machines update the players in
+// the same order.
+static bool FairBallContests()
+{
+    return mscharged_tweak_enabled(MSCHARGED_TWEAK_FAIR_BALL_CONTESTS) || GameInfoManager::Instance()->IsOnline();
+}
+
+// The per-step shuffles draw from their own seed, set at each kickoff from the
+// match's seed without advancing it, so the match's other random events stay
+// those of the original.
+static unsigned int sUpdateOrderSeed;
+
+static void ReshuffleUpdateOrder(cPlayer** players)
+{
+    for (int i = 0; i < 9; i++)
+    {
+        int j = i + (int)nlRandom(10 - i, &sUpdateOrderSeed);
+        cPlayer* temp = players[i];
+        players[i] = players[j];
+        players[j] = temp;
+    }
+}
+
+cPlayer* const* cGame::FairBallContestsOrder() const
+{
+    if (!FairBallContests())
+    {
+        return NULL;
+    }
+    for (int i = 0; i < 10; i++)
+    {
+        if (m_pRandomPlayersArray[i] == NULL)
+        {
+            return NULL;
+        }
+    }
+    return m_pRandomPlayersArray;
+}
+#endif
