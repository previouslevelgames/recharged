 TLComponentInstance* gFEPointerInstances[4];
 nlVector2 gFEPointerPositions[4];
@@ -167,3 +178,220 @@ bool IsFreeStylePad(int index)
     int type = device->GetClassID();
     return type == gWiiFreestylePadClassID;
 }
+
+#if defined(MSCHARGED_TWEAKS)
+// Port: controller menus. The game's menus are pointer-only; for a gamepad
+// player the D-pad and the sticks move between their buttons instead
+// (src/platform/controller_menus.cpp decides where). This hook runs as the
+// channel's remote is read (PlatPadManager::UpdateChannel): it gathers the
+// menu's live buttons, then puts the pointer where the navigation asks, adds
+// its presses to the remote's buttons and hides or shows the hand.
+static const int kMenuCapacity = 64;
+
+// A hidden hand: its instances' colour overrides from before, to put back.
+struct HiddenHand
+{
+    TLInstance* hand;
+    int count;
+    TLInstance* instances[kMenuCapacity];
+    u32 flags[kMenuCapacity];
+    nlColour colours[kMenuCapacity];
+};
+static HiddenHand sHiddenHands[4];
+
+static void CollectHandInstances(TLInstance* instance, TLInstance** out, int& count)
+{
+    for (int guard = 0; instance != 0 && guard < kMenuCapacity && count < kMenuCapacity; ++guard)
+    {
+        for (int i = 0; i < count; ++i)
+        {
+            if (out[i] == instance)
+                return;
+        }
+        out[count++] = instance;
+        CollectHandInstances(instance->pChildren, out, count);
+        instance = instance->m_next;
+    }
+}
+
+// Scenes show the hand again every frame but leave its colour alone, so the
+// hand and its child graphics hide behind a transparent colour override.
+static void SetHandVisible(int channel, bool visible)
+{
+    HiddenHand& hidden = sHiddenHands[channel];
+    TLInstance* hand = gFEPointerInstances[channel];
+    if (hand != hidden.hand)
+    {
+        // Another scene's hand: the old one's instances may be gone.
+        hidden.hand = hand;
+        hidden.count = 0;
+    }
+    if (hand == 0)
+        return;
+    if (visible)
+    {
+        for (int i = 0; i < hidden.count; ++i)
+        {
+            hidden.instances[i]->m_overloadFlags = hidden.flags[i];
+            hidden.instances[i]->m_overloadedAttributes.colour = hidden.colours[i];
+        }
+        hidden.count = 0;
+        return;
+    }
+    TLInstance* tree[kMenuCapacity];
+    int count = 0;
+    tree[count++] = hand;
+    CollectHandInstances(hand->pChildren, tree, count);
+    for (int t = 0; t < count; ++t)
+    {
+        TLInstance* instance = tree[t];
+        bool saved = false;
+        for (int i = 0; i < hidden.count && !saved; ++i)
+            saved = hidden.instances[i] == instance;
+        if (!saved)
+        {
+            if (hidden.count == kMenuCapacity)
+                continue;
+            hidden.instances[hidden.count] = instance;
+            hidden.flags[hidden.count] = instance->m_overloadFlags;
+            hidden.colours[hidden.count] = instance->m_overloadedAttributes.colour;
+            ++hidden.count;
+        }
+        nlColour colour = instance->GetColour();
+        colour.c[3] = 0;
+        instance->m_overloadFlags |= 0x10;
+        instance->m_overloadedAttributes.colour = colour;
+    }
+}
+
+// The pointer buttons of a character grid while its scene hides the grid: the
+// scene keeps them live underneath.
+static void HiddenGrid(BaseSceneHandler* scene, int type, const void*& from, const void*& to)
+{
+    from = to = 0;
+    if (scene == 0)
+        return;
+    if (type == SCENE_CHOOSE_CAPTAINS_DOMINATION || type == SCENE_CHOOSE_CAPTAINS_STRIKER_CUP)
+    {
+        ChooseCaptainsSceneV2* captains = static_cast<ChooseCaptainsSceneV2*>(scene);
+        if (!captains->mCaptainsShown)
+        {
+            from = &captains->mCaptainButtons[0];
+            to = &captains->mCaptainButtons[12];
+        }
+    }
+    else if (type == SCENE_CHOOSE_SIDEKICKS_DOMINATION || type == SCENE_CHOOSE_SIDEKICKS_STRIKER_CUP)
+    {
+        ChooseSidekicksSceneV2* sidekicks = static_cast<ChooseSidekicksSceneV2*>(scene);
+        if (!sidekicks->mSidekicksShown)
+        {
+            from = &sidekicks->mSidekickButtons[0];
+            to = &sidekicks->mSidekickButtons[8];
+        }
+    }
+}
+
+void FENavigateMenus(int channel, WPADFSStatus* wpad, KPADStatus* kpad)
+{
+    if (channel < 0 || channel >= 4)
+        return;
+    // The HOME Button Menu points with this same reading; the menu below it
+    // keeps its selection for when it closes.
+    nlTaskManager* tasks = nlTaskManager::m_pInstance;
+    const bool home = tasks != 0
+        && (tasks->mCurrentState == TASK_HOME_BUTTON_MENU || tasks->mPendingState == TASK_HOME_BUTTON_MENU);
+    if (home || !mscharged_tweak_controller_menus(channel) || g_pFEPointerManager == 0)
+    {
+        SetHandVisible(channel, true);
+        return;
+    }
+
+    mscharged_menu_frame frame;
+    frame.scene = 0;
+    frame.scene_type = SCENE_INVALID;
+    GameSceneManager* manager = GameSceneManager::Instance();
+    BaseSceneHandler* scene = manager != 0 ? manager->GetCurrentScene() : 0;
+    if (scene != 0)
+    {
+        frame.scene = scene;
+        frame.scene_type = manager->m_sceneStack[manager->mCurrentStackDepth - 1];
+    }
+    frame.overlay = 0;
+    frame.overlay_type = SCENE_INVALID;
+    BaseSceneHandler* overlay = g_pOverlayManager != 0 ? g_pOverlayManager->GetCurrentScene() : 0;
+    if (overlay != 0)
+    {
+        frame.overlay = overlay;
+        frame.overlay_type = g_pOverlayManager->m_sceneStack[g_pOverlayManager->mCurrentStackDepth - 1];
+    }
+    gl_ScreenInfo* screenInfo = glGetScreenInfo();
+    frame.half_width = (IsWidescreen() ? 854 : screenInfo->ScreenWidth) * 0.5f;
+    frame.half_height = screenInfo->ScreenHeight * 0.5f;
+    const nlVector2 at = gFEPointerPositions[channel];
+    frame.pointer_x = at.x;
+    frame.pointer_y = at.y;
+    frame.buttons = wpad->button;
+    frame.stick_x = kpad->ex_status.fs.stick.x;
+    frame.stick_y = kpad->ex_status.fs.stick.y;
+
+    // The live buttons. Scenes pass pointer events only to their own buttons,
+    // so a button of a screen that is registered but not shown never sees one:
+    // a button is live only if its last event for this channel is at the
+    // pointer's current position.
+    mscharged_menu_button buttons[kMenuCapacity];
+    int count = 0;
+    const void* hiddenFrom;
+    const void* hiddenTo;
+    HiddenGrid(scene, frame.scene_type, hiddenFrom, hiddenTo);
+    const bool locked = g_pFEInput != 0 && g_pFEInput->m_InputLockDepth != 0;
+    for (ListEntry<FEPointerListener*>* entry = g_pFEPointerManager->mListeners.m_Head;
+         entry != 0 && count < kMenuCapacity; entry = entry->next)
+    {
+        FEPointerListener* listener = entry->entry;
+        const void* address = listener;
+        if (listener == 0 || (address >= hiddenFrom && address < hiddenTo))
+            continue;
+        if (listener->mDisabled || (locked && !listener->mIgnoreInputLock))
+            continue;
+        const FEPointerEvent& last = listener->mPreviousEvents[channel];
+        if (last.mIndex != channel || fabs(last.mPosition.x - at.x) > 1.0f
+            || fabs(last.mPosition.y - at.y) > 1.0f)
+            continue;
+        // FEPointerRegion is the only listener that tests a point.
+        const FEPointerRegion* region = static_cast<const FEPointerRegion*>(listener);
+        mscharged_menu_button& button = buttons[count];
+        button.min_x = region->GetMinX();
+        button.max_x = region->GetMaxX();
+        button.min_y = region->GetMinY();
+        button.max_y = region->GetMaxY();
+        // Regions as large as the screen catch presses anywhere: no buttons.
+        if (!(button.max_x > button.min_x && button.max_y > button.min_y) || button.max_x - button.min_x > 600.0f
+            || button.max_y - button.min_y > 420.0f)
+            continue;
+        button.rotation = region->GetRotation();
+        const nlVector2 pivot = region->GetPivot();
+        button.pivot_x = pivot.x;
+        button.pivot_y = pivot.y;
+        button.back = FEIsBackButton(listener);
+        button.pointed = region->ContainsPoint(at);
+        button.id = listener;
+        ++count;
+    }
+    frame.regions = buttons;
+    frame.count = count;
+
+    mscharged_menu_result result;
+    mscharged_tweak_navigate_menu(channel, &frame, &result);
+    SetHandVisible(channel, !result.hide_hand);
+    if (!result.menu)
+        return;
+    // GetPointerPosition's mapping, the other way round.
+    const float x = result.pointer_x / frame.half_width;
+    const float y = -result.pointer_y / frame.half_height;
+    kpad->pos.x = x < -1.0f ? -1.0f : x > 1.0f ? 1.0f : x;
+    kpad->pos.y = y < -1.0f ? -1.0f : y > 1.0f ? 1.0f : y;
+    kpad->dpd_valid_fg = 2;
+    wpad->button |= result.press;
+    kpad->hold |= result.press;
+}
+#endif
