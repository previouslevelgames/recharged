+#if defined(MSCHARGED_TWEAKS)
+// Port: the live back buttons (FEIsBackButton). Screens keep a few; one past
+// the last slot stays unknown, and B then has no back button to press.
+static const FEBackButton* sBackButtons[64];
+
+bool FEIsBackButton(const FEPointerListener* listener)
+{
+    for (int i = 0; i < 64; ++i)
+    {
+        if (sBackButtons[i] != 0 && static_cast<const FEPointerListener*>(sBackButtons[i]) == listener)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void TrackBackButton(const FEBackButton* added, const FEBackButton* removed)
+{
+    for (int i = 0; i < 64; ++i)
+    {
+        if (sBackButtons[i] == removed)
+        {
+            sBackButtons[i] = added;
+            return;
+        }
+    }
+}
+#endif
+
