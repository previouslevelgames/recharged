diff --git a/src/Game/FE/feDPD.cpp b/src/Game/FE/feDPD.cpp
index 2aabf51..93cd883 100644
--- a/src/Game/FE/feDPD.cpp
+++ b/src/Game/FE/feDPD.cpp
@@ -20,6 +20,17 @@
 #include "NL/plat/DPDData.h"
 #include "decomp.h"
 #include "Game/SharedStaticStorage.h"
+#if defined(MSCHARGED_TWEAKS)
+#include "mscharged_tweaks.h"
+#include <math.h>
+#include "Game/FE/feBackButton.h"
+#include "Game/FE/fePointer.h"
+#include "Game/FE/tlComponentInstance.h"
+#include "Game/GameSceneManager.h"
+#include "Game/Task/GameTaskState.h"
