Subject: Declare the port's opt-in tweak hooks
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

Opt-in game tweaks are the first changes of the port's mod phase: the player
turns them on in [gameplay] of mscharged.ini, and each is off by default. This
series is separate from the faithful series and applied after it. Its hooks
are compiled only into the game module built with MSCHARGED_TWEAKS; there,
every hook takes the original path unless its tweak is enabled. Other targets
that build the same sources keep the original code unchanged.

Add include/mscharged_tweaks.h, the hooks' interface to the port
(src/platform/game_tweaks.cpp in the game module).

diff --git a/include/mscharged_tweaks.h b/include/mscharged_tweaks.h
new file mode 100644
index 0000000..7908691
--- /dev/null
+++ b/include/mscharged_tweaks.h
@@ -0,0 +1,119 @@
+#ifndef MSCHARGED_TWEAKS_H
+#define MSCHARGED_TWEAKS_H
+
+// Opt-in game tweaks of the native port ([gameplay] in mscharged.ini). They
+// are not part of the original game. Their hooks exist only in builds with
+// MSCHARGED_TWEAKS, and each keeps the original behaviour unless the player
+// enabled its tweak. The functions are the port's src/platform/game_tweaks.cpp.
+#if defined(MSCHARGED_TWEAKS)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Bits of the enabled set (mscharged::GameTweak).
+enum
+{
+    MSCHARGED_TWEAK_SKIP_INTRO = 0,
+    MSCHARGED_TWEAK_FAST_MENUS = 1,
+    MSCHARGED_TWEAK_NO_MEGA_STRIKES = 2,
+    MSCHARGED_TWEAK_UNLOCK_ALL = 3,
+    MSCHARGED_TWEAK_CPU_VS_CPU = 4,
+    MSCHARGED_TWEAK_FAST_TERRAIN = 5,
+    MSCHARGED_TWEAK_MIRROR_MATCH = 6,
+    MSCHARGED_TWEAK_THUNDER_ISLAND_WALLS = 7,
+    MSCHARGED_TWEAK_BLUE_PEACH = 8,
+};
+
+bool mscharged_tweak_enabled(int tweak);
+
+// Mirror match: away kits made where the game has none: Mario's, Luigi's,
+// Wario's and Waluigi's whole kit, Peach's menu pictures and Mega Strike hand.
+// The colour (0xRRGGBB) of a captain's made kit and its kit texture, 0 when
+// he has none (the texture also when the game has his field kit); the two
+// teams whose textures and pictures tell the team-coloured texels apart;
+// turning texture `source` of a loaded bundle into the away kit in place,
+// renamed `target` (team textures compare with texture `texture0`/`texture1`
+// of the reference teams' bundles); recolouring one texture in place (its
+// 32-byte header and levels, as bundles store them): a kit texture, a team
+// texture compared with the same texture of the reference teams, or a painted
+// picture of the captain; and whether the game's photos of him (the newspaper
+// after a match) recolour cleanly.
+unsigned mscharged_tweak_away_kit_colour(const char* captain);
+unsigned mscharged_tweak_away_kit_source(const char* captain);
+const char* mscharged_tweak_away_kit_reference(const char* captain, int index);
+bool mscharged_tweak_make_away_kit(const char* captain, bool team, void* bundle, unsigned long size, unsigned source,
+    unsigned target, const void* reference0, unsigned long size0, unsigned texture0, const void* reference1,
+    unsigned long size1, unsigned texture1);
+enum
+{
+    MSCHARGED_AWAY_KIT_TEXTURE = 0,
+    MSCHARGED_AWAY_TEAM_TEXTURE = 1,
+    MSCHARGED_AWAY_PICTURE = 2,
+};
+bool mscharged_tweak_recolour_away_texture(const char* captain, int kind, void* texture, unsigned long size,
+    const void* reference0, unsigned long size0, const void* reference1, unsigned long size1);
+bool mscharged_tweak_away_kit_photos(const char* captain);
+
+// Skip intro: whether the title screen still has to be passed this launch,
+// and taking that single press of A.
+bool mscharged_tweak_title_pending(void);
+bool mscharged_tweak_take_title_press(void);
+
+// Fast menus. Once a frame the front end reports whether its menus are up
+// (outside matches and the boot screens) and whether its presentation runs a
+// transition script.
+void mscharged_tweak_frontend_frame(bool menus, bool transition);
+bool mscharged_tweak_fast_menus(void);
+bool mscharged_tweak_fast_transition(void);
+// Time dilation of a task during a transition: only the camera task runs on
+// transition time; every other task (effects, audio, pads) keeps real time.
+void mscharged_tweak_set_transition_task(const void* task);
+float mscharged_tweak_task_dilation(const void* task);
+// A time step back on real time: in the camera task during a transition the
+// step without its transition dilation, anywhere else the step itself.
+float mscharged_tweak_real_time(float deltaTime);
+// Slides reset (Update(0)) this frame keep their first frame.
+void mscharged_tweak_note_slide_reset(const void* slide);
+bool mscharged_tweak_slide_reset_this_frame(const void* slide);
+
+// Frame rate above the original ([display] frame_rate). The host then
+// presents every frame as the game swaps and paces the next one itself
+// (glxSwap.cpp); VI retraces keep their real rate for what counts them.
+// The swap mode no original state uses: the host's swap.
+enum
+{
+    MSCHARGED_SWAP_HOST = 16,
+};
+bool mscharged_tweak_host_frames(void);
+// The swap mode a task state draws with; the original's mode also tells the
+// original frame (two VI fields in mode 2, else one).
+int mscharged_tweak_swap_mode(unsigned taskState, int swapMode);
+void mscharged_tweak_host_swap(void);
+// Once a frame, at its start: the frame's real duration. Steps the original
+// makes once per frame keep its pace through these: the frame's length in
+// original frames (1 at the original rate, 0.5 at twice it), whether this
+// frame starts a new original frame (about as many a second as the original
+// drew), and the number of original frames so far for a rendered frame count.
+// Without a raised frame rate they are 1, true and the rendered count.
+void mscharged_tweak_begin_frame(float realSeconds);
+float mscharged_tweak_original_frames(void);
+bool mscharged_tweak_original_frame(void);
+unsigned long mscharged_tweak_frame_number(unsigned long renderedFrame);
+
+// Performance mode ([display] performance_mode, a host display setting outside
+// the tweak mask): lighter matches. The first is the setting itself (for match
+// loading); the second is true while a match runs with it on, so menus keep
+// every effect. The hooks only skip decorative work: no gameplay state and no
+// random number the game or the network shares depends on what they skip.
+bool mscharged_tweak_performance_mode(void);
+bool mscharged_tweak_performance_match(void);
+// The stadium of the match being rendered (frame recordings).
+void mscharged_tweak_report_stadium(int stadium);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // MSCHARGED_TWEAKS
+#endif // MSCHARGED_TWEAKS_H
