Subject: Volume of each group of sounds
Upstream-base: 9046e67aa2077a7eb4ed6e28c9df3c1d3b368f84

The launcher's sound levels are a host audio setting, independent of the
[gameplay] tweak mask (issue #59). Every sound's volume passes through
SoundPlaybackEvent::UpdatePlaybackParameters, the only caller of the sources'
SetInputVolume besides a stream's silent start. There the player's level of the
sound's group becomes the MIX fader of the sound's voices, set by MIXSetInput;
the game itself never moves a fader (every voice starts at 0). The fader lowers
what the sound plays on the PC, its main mix and aux sends. The level the game
set stays, and with it the share of the sound the Wii Remote speaker plays
(input and MIXRmtSetFader), which follows the Remote's own speaker volume
(issue #60). The group follows the sound's mix category and its sound bank
(src/platform/game_tweaks.cpp). Movie audio is mixed by THPSimple apart from
these sounds; its samples are scaled by the movie level. With every group at
100 % nothing changes. The guarded hooks exist only in the opt-in native game
module.

diff --git a/src/Game/Audio/AudioSequenceEvent.cpp b/src/Game/Audio/AudioSequenceEvent.cpp
index 7b6412e..7a076d3 100644
--- a/src/Game/Audio/AudioSequenceEvent.cpp
+++ b/src/Game/Audio/AudioSequenceEvent.cpp
@@ -15,6 +15,10 @@
 #include "Game/Audio/AudioSequenceEvent.h"
 #include "Game/Audio/AudioBankSelectionSteps.h"
 #include "Game/Audio/AudioBankLoader.h"
+#include "mscharged_tweaks.h"
+#if defined(MSCHARGED_TWEAKS)
+#include "Game/Audio/AudioBankTable.h"
+#endif
 
 SlotPool<SoundPlaybackEvent> sSoundPlaybackEventPool(32, 16);
 SlotPool<HitMarkerEvent> sHitMarkerEventPool(32, 16);
@@ -239,11 +243,28 @@ void SoundPlaybackEvent::UpdatePlaybackParameters(bool force)
     float currentVolume = volume + (instanceVolume + playbackVolume);
     currentVolume = currentVolume >= -96.0f ? currentVolume : -96.0f;
     currentVolume = currentVolume <= 6.0f ? currentVolume : 6.0f;
+#if defined(MSCHARGED_TWEAKS)
+    // Sound group volumes: the player's level of this sound's group (by its
+    // mix category and sound bank) lowers what the sound plays on the PC.
+    // MIXSetInput makes it the fader of the sound's voices, which the game
+    // never moves; the level the game set stays, and so does the share the
+    // Wii Remote speaker plays.
+    {
+        AudioResourceLoadOwner* resource = (AudioResourceLoadOwner*)owner->soundInstance->owner->m_Slot;
+        const char* bank = resource != 0 && resource->m_Source != 0 && resource->m_Source->resource != 0
+            ? resource->m_Source->resource->name
+            : 0;
+        mscharged_tweak_set_sound_level(bank, owner->soundInstance->definition->sliderIndex);
+    }
+#endif
     if (force || this->currentVolume != currentVolume)
     {
         this->currentVolume = currentVolume;
         source->SetInputVolume(this->currentVolume);
     }
+#if defined(MSCHARGED_TWEAKS)
+    mscharged_tweak_clear_sound_level();
+#endif
 
     float instancePitch = owner->soundInstance->GetPitch();
     float pitchModifier = this->pitchModifier;
diff --git a/src/RVL_SDK/mix/mix.c b/src/RVL_SDK/mix/mix.c
index c409b43..4dafa87 100644
--- a/src/RVL_SDK/mix/mix.c
+++ b/src/RVL_SDK/mix/mix.c
@@ -1,4 +1,5 @@
 #include <revolution/mix/MIXPrivate.h>
+#include "mscharged_tweaks.h"
 #include <revolution/os/OSInterrupt.h>
 #include <string.h>
 
@@ -485,6 +486,16 @@ void MIXSetInput(AXVPB* p, int dB)
     MIXChannel* channel = &__MIXChannel[p->index];
     channel->input = dB;
     channel->mode |= 0x10000000;
+#if defined(MSCHARGED_TWEAKS)
+    // Sound group volumes: the PC level of the sound being set
+    // (SoundPlaybackEvent) becomes this voice's fader. It lowers the voice's
+    // main mix and aux sends, not its Wii Remote speaker mix.
+    if (channel->fader != mscharged_tweak_sound_fader())
+    {
+        channel->fader = mscharged_tweak_sound_fader();
+        channel->mode |= 0x40000000;
+    }
+#endif
 }
 
 void MIXSetAuxA(AXVPB* p, int dB)
