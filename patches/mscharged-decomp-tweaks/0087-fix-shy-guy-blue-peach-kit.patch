 bool mscharged_tweak_title_pending(void);
diff --git a/src/Game/CharacterLoader.cpp b/src/Game/CharacterLoader.cpp
index 9c5e7cb..764fffb 100644
--- a/src/Game/CharacterLoader.cpp
+++ b/src/Game/CharacterLoader.cpp
@@ -204,6 +204,43 @@ static bool BluePeachTeam(eCharacterClass captain0, eCharacterClass captain1, in
 }
 #endif
 
+#if defined(MSCHARGED_TWEAKS)
+// Port fix (issue #176): the disc's blue Peach kit of Shy Guy
+// (shyguy_peach_alt) was never finished: red and yellow, with Petey's emblem.
+// The retail game never shows Peach's blue kit, Blue Peach and Mirror match do.
+// When a sidekick bundle holds it as the disc has it, it is made from his pink
+// Peach kit in the colours of her other sidekicks' blue kits, compared with
+// two other teams' versions of it (src/platform/away_kits.cpp).
+static void FinishUnfinishedKit(void* data, unsigned long size)
+{
+    const char* szFiles[3];
+    if (!mscharged_tweak_unfinished_kit(data, size, szFiles))
+    {
+        return;
+    }
+    void* files[3] = { 0, 0, 0 };
+    unsigned long sizes[3] = { 0, 0, 0 };
+    for (int i = 0; i < 3; i++)
+    {
+        if (nlFileExists(szFiles[i]))
+        {
+            files[i] = nlLoadEntireFile(szFiles[i], &sizes[i], 32, AllocateStart, 0, 0, 0);
+        }
+    }
+    if (!mscharged_tweak_finish_unfinished_kit(data, size, files[0], sizes[0], files[1], sizes[1], files[2], sizes[2]))
+    {
+        nlPrintf("Unfinished kit: the disc's version stays (not made from %s)\n", szFiles[0]);
+    }
+    for (int i = 0; i < 3; i++)
+    {
+        if (files[i] != 0)
+        {
+            nlFree(files[i]);
+        }
+    }
+}
+#endif
+
 #if defined(MSCHARGED_TWEAKS)
 // Port tweak "Robot goalies": both goalies wear the robot goalie skin of the
 // Super Team from Super Mario Strikers. The disc still has its texture, unused
@@ -1213,6 +1250,11 @@ bool CharacterLoader::FinalizeLoadingSidekickSwapTexture()
     }
 #endif
 
+#if defined(MSCHARGED_TWEAKS)
+    // Port fix (issue #176): an unfinished team kit is made anew.
+    FinishUnfinishedKit(mSidekickTextureData, mSidekickTextureSize);
+#endif
+
     glEndLoadTextureBundle(mSidekickTextureData, mSidekickTextureSize, glGetCurrentResourcePool(), false);
     nlFree(mSidekickTextureData);
     mSidekickTextureData = 0;
