@@ -168,6 +169,11 @@ void GameInfoManager::SetStadium(int stadium)
 bool ThunderIslandWalls()
 {
     GameInfoManager* info = GameInfoManager::Instance();
+#if defined(MSCHARGED_TWEAKS)
+    // Competitive play: a match's rules may fence the sides online too.
+    if (info->GetStadium() == STAD_THUNDER_ISLAND && mscharged_competitive_tweak(MSCHARGED_TWEAK_THUNDER_ISLAND_WALLS))
+        return true;
+#endif
     return info->GetStadium() == STAD_THUNDER_ISLAND && !info->IsOnline()
         && mscharged_tweak_enabled(MSCHARGED_TWEAK_THUNDER_ISLAND_WALLS);
 }
@@ -437,6 +443,24 @@ void GameInfoManager::SetupGameFromConfig()
     }
 #endif
 
+#if defined(MSCHARGED_TWEAKS)
+    // Competitive play: a RANKED match against the opponent of the player's
+    // accepted competitive match plays by that match's rules instead of the
+    // ranked defaults (mDefaultSettings), its whole series long. Without one
+    // RANKED stays retail.
+    if (const MschargedCompetitiveSettings* competitive = mscharged_competitive_begin()) {
+        mCurGameGameplayOptions.SkillLevel = (GameplaySettings::eSkillLevel)competitive->skill;
+        mCurGameGameplayOptions.GameLimitType = (eGameLimitType)competitive->limit;
+        mCurGameGameplayOptions.GameTime = competitive->time;
+        mCurGameGameplayOptions.GoalLimit = competitive->goals;
+        mCurGameGameplayOptions.NumGames = competitive->games;
+        if (mscharged_competitive_tweak(MSCHARGED_TWEAK_NO_MEGA_STRIKES)) {
+            mCurGameGameplayOptions.mHomeMegastrikeEnabled = false;
+            mCurGameGameplayOptions.mAwayMegastrikeEnabled = false;
+        }
+    }
+#endif
+
     if (GetTweakBool("User/skipfe", false)) {
         mCurGameGameplayOptions.NumGames = 11;
     }
