     u32 seed = message->mRandomSeed;
     SetNetworkRandomSeed(seed);
+#if defined(MSCHARGED_TWEAKS)
+    // Recharged's tournaments (tweak patch 0078): the set's players take the
+    // home side in turn. RANKED puts the draft's first team at home; when
+    // both machines' draft entries ask for the sides the other way round,
+    // every machine swaps the draft's two teams and the lineups in this
