+    {
+        int asked[2];
+        for (int machine = 0; machine < 2; ++machine)
+        {
+            const u8 profile = draftMessage.mEntries[machine].mSimProfile;
+            asked[machine] = (profile & MSCHARGED_SIM_SET_HOME) ? 0 : (profile & MSCHARGED_SIM_SET_AWAY) ? 1 : -1;
+        }
+        // Machine 0's side as below.
+        const int first = NetworkDraft::Instance()->GetDraftTeam(0)->mPlayers[0].mPeerIndex != 0;
+        if (asked[0] >= 0 && asked[1] >= 0 && asked[0] != asked[1] && asked[0] != first)
