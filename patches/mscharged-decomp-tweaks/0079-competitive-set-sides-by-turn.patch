index 669a4b9..2f8a5a9 100644
--- a/include/mscharged_competitive.h
+++ b/include/mscharged_competitive.h
@@ -127,6 +127,15 @@ bool mscharged_competitive_draft_mirror(void);
 int mscharged_competitive_mirror_dressed_side(void);
 #endif
 
+#if defined(MSCHARGED_TWEAKS)
+// A set's game (tweak patch 0079): this machine's side by the set's turn, 0
+// home or 1 away, -1 for the game's own (the draft host's side decides the
+// swap for every machine); and the game swapped its sides (this machine's
+// side now).
+int mscharged_competitive_set_side(void);
+void mscharged_competitive_sides_swapped(int side);
+#endif
+
 #ifdef __cplusplus
 }
 #endif
