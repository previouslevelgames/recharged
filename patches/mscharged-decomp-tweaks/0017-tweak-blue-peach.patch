+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "Blue Peach": Peach's team (captain, goalie and sidekicks) wears
+// her blue kit, the one the game would load against a captain of her colours.
+static bool BluePeachTeam(eCharacterClass captain0, eCharacterClass captain1, int team)
+{
+    const CharacterInfo& info0 = GetCharacterInfo(captain0);
+    const CharacterInfo& info1 = GetCharacterInfo(captain1);
+    return team == 0 ? BluePeachKit(info0, info1) : BluePeachKit(info1, info0);
+}
+#endif
