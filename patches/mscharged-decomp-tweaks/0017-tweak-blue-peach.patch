diff --git a/src/Game/DB/BasicGameInfo.cpp b/src/Game/DB/BasicGameInfo.cpp
index 1be0f14..de4d3bd 100644
--- a/src/Game/DB/BasicGameInfo.cpp
+++ b/src/Game/DB/BasicGameInfo.cpp
@@ -293,3 +293,13 @@ nlColour GetAwayKitColour(const CharacterInfo& team)
     return rgba;
 }
 #endif
+
+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "Blue Peach". The game dresses Peach in her blue kit only
+// against a captain of her colours, and no other captain is pink.
+bool BluePeachKit(const CharacterInfo& team, const CharacterInfo& opponent)
+{
+    return team.mCaptainId == TEAM_PEACH && opponent.mIndex != team.mIndex
+        && mscharged_tweak_enabled(MSCHARGED_TWEAK_BLUE_PEACH);
+}
+#endif
