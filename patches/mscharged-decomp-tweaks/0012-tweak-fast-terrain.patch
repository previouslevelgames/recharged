@@ -5,6 +5,7 @@
 #include "Game/TweakFileLoader.h"
 #include "Game/SharedStaticStorage.h"
 #include "Game/DB/StadiumInfo.h"
+#include "mscharged_tweaks.h"
 #include "NL/nlConfig.h"
 #include "NL/nlMemory.h"
 #include "NL/nlString.h"
@@ -24,6 +25,15 @@ void InitializeGameTweaks(GameTweaksManager* state)
 
     int stadium = GameInfoManager::Instance()->GetStadium();
     int terrain = GetStadiumUnknown0x08(stadium);
+#if defined(MSCHARGED_TWEAKS)
+    // Port tweak "Fast terrain": every stadium gets the dry terrain profile
+    // (ini/Terrain/DryTerrain.ini, as in Bowser Stadium): its field speed,
+    // slide, ball friction and bounce. Online matches keep the stadium's own.
+    if (mscharged_tweak_enabled(MSCHARGED_TWEAK_FAST_TERRAIN) && !GameInfoManager::Instance()->IsOnline())
+    {
+        terrain = 0;
+    }
+#endif
     state->mTerrainType = terrain;
 
     char terrainName[100];
