 static nlFloatColour s_currentAssetColour;
 static const nlVector3 s_quadPositions[4] = {
@@ -30,6 +31,35 @@ RenderImageCallback g_pfnRenderImage;
 static const unsigned long grabTex = nlStringLowerHash("target/grab_texture");
 static const unsigned long movieTex = nlStringLowerHash("movie");
 
+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "No HUD" (issue #58): while it hides the match's HUD, these
+// in-game overlays (their files in BaseGameSceneManager's scene table) are
+// not drawn: the scoreboard with clock, items and ability meter, the REPLAY
+// caption, the goal's lower third and the captain's super ability card. They
+// still update as in the original.
+static bool NoHudHidesScene(const FEScene* scene)
+{
+    static const unsigned long hidden[4] = {
+        nlStringLowerHash("art/fe/hud_2.fen"),
+        nlStringLowerHash("art/fe/ingame_text.fen"),
+        nlStringLowerHash("art/fe/goal_overlay.fen"),
+        nlStringLowerHash("art/fe/SUPER_ABILITY_PRESENTATION.fen"),
+    };
+    if (!mscharged_tweak_hud_hidden())
+    {
+        return false;
+    }
+    for (int i = 0; i < 4; i++)
+    {
+        if (scene->m_uHashID == hidden[i])
+        {
+            return true;
+        }
+    }
+    return false;
+}
+#endif
+
 void FERender::CalculateCurrentAssetColour(const TLInstance* instance)
 {
     for (unsigned long i = 0; i < 4; i++)
@@ -206,6 +236,12 @@ void FERender::RenderScene(FEScene* scene)
     {
         return;
     }
+#if defined(MSCHARGED_TWEAKS)
+    if (NoHudHidesScene(scene))
+    {
+        return;
+    }
+#endif
 
     m_pRenderScene = scene;
     s_currentAssetColour.c[0] = 1.0f;
