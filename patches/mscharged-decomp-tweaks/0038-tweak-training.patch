+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "Training": the launcher's Start training goes from the title
+// straight into an offline Domination match, as the demo match does, with the
+// pad that passed the title on the home side and the save's match settings.
+// Both captains field the sidekicks of their lineups in the save; the away
+// team, which nobody plays, vanishes (cTeam::ResetCharacters). The match
+// waits for the save, which the main menu reads otherwise: sTrainingPad is
+// the pad that asked for it, -1 for none.
+static int sTrainingPad = -1;
+static int sTrainingCaptain;
+static int sTrainingStadium;
+
+static void StartTrainingMatch(int pad, int captain, int stadium)
+{
+    GameInfoManager* gameInfo = GameInfoManager::Instance();
+    gameInfo->mUserInfo.mGameplayOptions.OnSettingsUpdated();
+    gameInfo->mUserInfo.mCheatOptions.OnSettingsUpdated();
+    gameInfo->SetMode(GameInfoManager::GM_FRIENDLY, false);
+    g_bTrainingMatch = true;
+    const int away = captain == TEAM_BOWSER ? TEAM_MARIO : TEAM_BOWSER;
+    gameInfo->SetStadium(stadium);
+    gameInfo->SetTeam(0, captain);
+    gameInfo->SetTeam(1, away);
+    for (int slot = 0; slot < 3; slot++)
+    {
+        gameInfo->SetSidekick(0, gameInfo->mRulesTable[captain].mValues[slot], slot);
+        gameInfo->SetSidekick(1, gameInfo->mRulesTable[away].mValues[slot], slot);
+    }
+    gameInfo->ResetPlayingSides();
+    gameInfo->SetPlayingSide((unsigned short)pad, 0);
+    GameSceneManager::Instance()->PushLoadingScene(true);
+}
+#endif
