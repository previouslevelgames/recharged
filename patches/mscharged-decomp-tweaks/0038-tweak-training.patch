+#if defined(MSCHARGED_TWEAKS)
+bool g_bTrainingMatch;
+
+int GetTrainingSide()
+{
+    GameInfoManager* info = GameInfoManager::Instance();
+    if (!g_bTrainingMatch || info->IsOnline() || info->mCurrentMode != GameInfoManager::GM_FRIENDLY)
+    {
+        return -1;
+    }
+    bool played[2] = { false, false };
+    for (int pad = 0; pad < 16; pad++)
+    {
+        const short side = info->GetPlayingSide(pad);
+        if (side == 0 || side == 1)
+        {
+            played[side] = true;
+        }
+    }
+    return played[0] == played[1] ? -1 : played[0] ? 0 : 1;
+}
+#endif
