@@ -0,0 +1,60 @@
+#ifndef MSCHARGED_REPLAY_H
+#define MSCHARGED_REPLAY_H
+
+// Port tweak "Match replays" (tweak patch 0071): the original game's own
+// input recorder (NetworkInputRecording) writes every offline match through
+// the port, which keeps it in a replay file, and plays such a file back: the
+// title goes straight into the match, with its setup and seed, and the router
+// takes every step's inputs from the file (ProcessPlaybackFrame). The
+// functions are the port's src/platform/match_replay.cpp.
+#if defined(MSCHARGED_TWEAKS)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Whether the port records matches; read once, when the recorder is made.
+bool mscharged_tweak_replay_record_enabled(void);
+// A match begins (StartNetworkInputRecording, once the loading has its setup):
+// whether the port records it. Online and the game's challenges are not.
+bool mscharged_tweak_replay_begin(int localMachine, int machineCount, unsigned int seed, const void* config,
+                                  int configSize);
+// What the recorder writes for each step, in its order: each machine's packet
+// header, its deterministic events and network data, its players' records.
+void mscharged_tweak_replay_packet(int machine, unsigned short remap, unsigned int checksum, unsigned int frame,
+                                   unsigned int seed, unsigned int events, unsigned int dataSize);
+void mscharged_tweak_replay_event(const void* data, int size);
+void mscharged_tweak_replay_data(const void* data, int size);
+void mscharged_tweak_replay_input(int player, const void* record, unsigned char connected);
+// The recorder resets: the match it recorded, or the replay it played, is over.
+void mscharged_tweak_replay_end(void);
+
+// Whether a replay plays: the recorder reads from the port.
+bool mscharged_tweak_replay_playing(void);
+// The recorded header: seed, machines, their players and the game's config.
+bool mscharged_tweak_replay_read_start(unsigned int* seed, int* localMachine, int* machineCount, int* playerCounts,
+                                       void* config, int configSize);
+// The next packet of `machine`; the port compares the game's own checksum,
+// frame and seed with the recorded ones. False at the replay's end.
+bool mscharged_tweak_replay_read_packet(int machine, unsigned int checksum, unsigned int frame, unsigned int seed,
+                                        unsigned short* remap, unsigned int* events, unsigned int* dataSize);
+bool mscharged_tweak_replay_read_event(unsigned char* size, void* data);
+bool mscharged_tweak_replay_read_data(int size, void* data);
+bool mscharged_tweak_replay_read_input(int player, void* record, unsigned char* connected);
+// Each fixed step while a replay plays: the steps its speed adds to the one
+// the router runs (-1 while it is paused: the step then runs none).
+int mscharged_tweak_replay_extra_updates(void);
+// The title (passed as by Skip intro): whether it starts the replay's match
+// instead of going to the main menu, once; then, from its update, the start.
+bool mscharged_tweak_take_replay_start(void);
+void mscharged_tweak_replay_start_match(void);
+// After the loading chose the difficulty: a recorded match notes it, a replay
+// sets the recorded one again.
+void mscharged_tweak_replay_difficulty(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // MSCHARGED_TWEAKS
+#endif // MSCHARGED_REPLAY_H
