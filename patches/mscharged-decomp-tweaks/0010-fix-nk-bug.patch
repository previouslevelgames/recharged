--- a/src/Game/Player.cpp
+++ b/src/Game/Player.cpp
@@ -824,6 +824,21 @@ void cPlayer::ReleaseBall(int nParam)
     {
         g_pBall->m_bVisible = true;
     }
+#if defined(MSCHARGED_TWEAKS)
+    // Port fix, always on (issue #38, the NK bug): a fielder who turns
+    // intangible while carrying the ball switches off the ball's player and
+    // goalie collisions too (cFielder::SetTangible), and only switches them
+    // back on if he still carries it when he turns tangible again. A fielder
+    // who loses the ball while intangible (his own goalie taking it from a
