+                && g_pBall->GetOwnerFielder()->mbTangible
+#endif
+                )
             {
                 StealBall(g_pBall->m_pOwner);
                 PickupBall(g_pBall);
@@ -7604,6 +7610,13 @@ bool Goalie::IsTeammateHoardingBall()
         cBall* pBall;
         cFielder* pOwner = g_pBall->GetOwnerFielder();
         if (pOwner != 0 && !pOwner->IsYoshiSuperPowerActive()
+#if defined(MSCHARGED_TWEAKS)
+            // Port fix, always on (issue #38, the NK bug): not from a teammate
+            // who is intangible (a Boo or teleport deke), whom the goalie
+            // cannot touch either. Taking the ball from him left it unable to
+            // hit either goalie (see cPlayer::ReleaseBall).
+            && pOwner->mbTangible
+#endif
             && IsOnSameTeam(pOwner))
         {
             float ownerX;
diff --git a/src/Game/Player.cpp b/src/Game/Player.cpp
