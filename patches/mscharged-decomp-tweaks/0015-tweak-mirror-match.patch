+
+// Reads front-end texture `source` (its header and levels) from the bundle the
+// front end loads it from: the permanent one, or in matches the on-demand one.
+// Into `buffer` when it fits, else into a new allocation; 0 when the texture
+// is in neither.
+static void* MirrorMatchReadTexture(unsigned long source, void* buffer, unsigned long capacity, unsigned long* size)
+{
+    FEResourceManager* manager = FEResourceManager::Instance();
+    const char* bundles[2] = { manager->m_szPermanentBundleFileName, manager->m_szOnDemandBundleFileName };
+    for (int i = 0; i < 2; i++)
+    {
+        BundleFile bundle;
+        if (!MirrorMatchBundleName(bundles[i]) || !bundle.Open(bundles[i], false))
+        {
+            continue;
+        }
+        u32 index = bundle.FindHashIndex(source, false);
+        BundleFileDirectoryEntry entry;
+        if (index == -1U || !bundle.GetFileInfoByIndex(index, &entry))
+        {
+            bundle.Close();
+            continue;
+        }
+        void* data = buffer;
+        if (entry.m_length > capacity)
+        {
+            AllocatorStack[AllocatorStackDepth++] = &VirtualAllocator;
+            CurrentAllocator = &VirtualAllocator;
+            data = nlMalloc(entry.m_length, 0x20, true);
+            --AllocatorStackDepth;
+            AllocatorStack[AllocatorStackDepth] = 0;
+            CurrentAllocator = AllocatorStack[AllocatorStackDepth - 1];
+        }
+        if (data != 0)
+        {
+            bundle.ReadFileByIndex(index, data, entry.m_length);
+            *size = entry.m_length;
+        }
+        bundle.Close();
+        return data;
+    }
+    return 0;
+}
+
+// The copy is added above the current scene's mark in the front end's pool,
+// so it goes when that scene does. Its name follows from the original's: a
+// scene makes each copy once.
+unsigned long MirrorMatchAwayPicture(unsigned long source, const char* captain)
+{
+    char szName[32];
+    nlSNPrintf(szName, sizeof(szName), "mirrormatch/%08lx", source);
+    unsigned long texture = nlStringHash(szName);
+    if (glTextureLoad(texture))
+    {
+        return texture;
+    }
+    GLResourcePool* pool = FEResourceManager::Instance()->GetResourcePool();
+    unsigned long size = 0;
+    void* data = pool != 0 ? MirrorMatchReadTexture(source, 0, 0, &size) : 0;
+    if (data == 0)
+    {
+        return 0;
+    }
+    const char* szPool;
+    unsigned long poolSize;
+    unsigned long freeHeaders = 0;
+    unsigned long freeData = 0;
+    unsigned long peak;
+    bool made = pool->GetPoolMemoryInfo(0, &szPool, &poolSize, &freeHeaders, &peak, 0)
+        && pool->GetPoolMemoryInfo(1, &szPool, &poolSize, &freeData, &peak, 0) && freeHeaders >= 0x400
+        && freeData >= size + 0x400
+        && mscharged_tweak_recolour_away_texture(captain, MSCHARGED_AWAY_PICTURE, data, size, 0, 0, 0, 0);
+    if (made)
+    {
+        glTextureAdd(texture, data, size, pool);
+    }
+    nlFree(data);
+    return made ? texture : 0;
+}
+
+bool MirrorMatchMakePicture(unsigned long source, const char* captain, void* home, void* away, unsigned long capacity,
+    unsigned long* size)
+{
+    unsigned long length = 0;
+    void* data = MirrorMatchReadTexture(source, home, capacity, &length);
+    if (data == 0)
+    {
+        return false;
+    }
+    if (data != home)
+    {
+        nlFree(data);
+        return false;
+    }
+    memcpy(away, home, length);
+    *size = length;
+    return mscharged_tweak_recolour_away_texture(captain, MSCHARGED_AWAY_PICTURE, away, length, 0, 0, 0, 0);
+}
+#endif
