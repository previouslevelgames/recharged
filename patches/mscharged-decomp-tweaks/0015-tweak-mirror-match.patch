diff --git a/src/Game/DB/BasicGameInfo.cpp b/src/Game/DB/BasicGameInfo.cpp
index 39355a5..fc01ecd 100644
--- a/src/Game/DB/BasicGameInfo.cpp
+++ b/src/Game/DB/BasicGameInfo.cpp
@@ -5,6 +5,7 @@
 #include "NL/nlString.h"
 #include "types.h"
 #include "NL/nlstring_tmpl.h"
+#include "mscharged_tweaks.h"
 
 enum
 {
@@ -252,3 +253,46 @@ bool CaptainsNeedAlternateColour(int captain, int opponentCaptain)
 
     return false;
 }
+
+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "Mirror match". The game has an away kit for a captain if it
+// dresses him in it against another captain of his colours: only those kits
+// come with everything a team wears (sidekicks, goalie, sidekick portraits,
+// Mega Strike hand). Peach's blue kit has no portraits or hand.
+static bool HasAwayKit(const CharacterInfo& captain)
+{
+    for (int i = 0; i < NUM_CHARACTERS; i++) {
+        if (NeedsAlternateColour(captain, sCharacterInfo[i])) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool MirrorMatchAwayKit(int side, const CharacterInfo& team, const CharacterInfo& opponent)
+{
+    return side == 1 && team.mIndex == opponent.mIndex && mscharged_tweak_enabled(MSCHARGED_TWEAK_MIRROR_MATCH)
+        && HasAwayKit(team);
+}
+
+bool MirrorMatchCaptainsAwayKit(int side, int captain, int opponentCaptain)
+{
+    return MirrorMatchAwayKit(side, GetCharacterInfo(GetCharacterIndexFromCaptain(captain)),
+        GetCharacterInfo(GetCharacterIndexFromCaptain(opponentCaptain)));
+}
+
+nlColour GetAwayKitColour(const CharacterInfo& team)
+{
+    nlColour rgba;
+    rgba.c[0] = (u8)((team.mAlternateColour >> 16) & 0xFF);
+    rgba.c[1] = (u8)((team.mAlternateColour >> 8) & 0xFF);
+    rgba.c[2] = (u8)(team.mAlternateColour & 0xFF);
+    rgba.c[3] = 0xFF;
+    return rgba;
+}
+
+bool MirrorMatchKeepsHomeKit(const CharacterInfo& captain)
+{
+    return mscharged_tweak_enabled(MSCHARGED_TWEAK_MIRROR_MATCH) && !HasAwayKit(captain);
+}
+#endif
