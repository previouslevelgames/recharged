+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "Mirror match": in a match of one captain against himself the
+// away team (team 1) wears the captain's away kit. The game has one for most
+// captains (<captain>_alt.rlt, with the goalie's and sidekicks' textures to
+// go with it). For Mario, Luigi, Wario and Waluigi the port makes one from
+// the home kit's textures as they load (src/platform/away_kits.cpp).
+enum MirrorMatchTexture
+{
+    MIRROR_MATCH_KIT,
+    MIRROR_MATCH_SIDEKICK,
+    MIRROR_MATCH_GOALIE,
+};
+
+static bool MirrorMatchMakesAwayKit(eCharacterClass captain0, eCharacterClass captain1, int team)
+{
+    if (captain0 != captain1 || team != 1 || !mscharged_tweak_enabled(MSCHARGED_TWEAK_MIRROR_MATCH))
+    {
+        return false;
+    }
+    const char* szOwnKit = GetCharacterTemplateInfo(captain0)->szAlternateTextureFilename;
+    if (szOwnKit != 0 && nlFileExists(szOwnKit))
+    {
+        return false;
+    }
+    return mscharged_tweak_away_kit_source(GetCharacterInfo(captain0).mName) != 0;
+}
+
+// Turns texture `source` of a loaded home bundle into the away kit, renamed
+// `target`. Sidekick and goalie team textures are compared with the same
+// texture of two other teams, read from the disc.
+static void MirrorMatchMakeAwayKit(eCharacterClass captain, MirrorMatchTexture kind, const char* szFolder,
+    const char* szTexture, void* data, unsigned long size, unsigned long source, unsigned long target)
+{
+    const char* szCaptain = GetCharacterInfo(captain).mName;
+    void* references[2] = { 0, 0 };
+    unsigned long sizes[2] = { 0, 0 };
+    unsigned long textures[2] = { 0, 0 };
+    for (int i = 0; i < 2 && kind != MIRROR_MATCH_KIT; i++)
+    {
+        const char* szTeam = mscharged_tweak_away_kit_reference(szCaptain, i);
+        char szPath[64];
+        char szName[64];
+        if (kind == MIRROR_MATCH_SIDEKICK)
+        {
+            nlSNPrintf(szPath, 64, "art/characters/%s/%s_%s.rlt", szFolder, szTexture, szTeam);
+            nlSNPrintf(szName, 64, "%s_%s/%s_%s", szTexture, szTeam, szTexture, szTeam);
+        }
+        else
+        {
+            nlSNPrintf(szPath, 64, "art/characters/%sgoalie/%sgoalie.rlt", szTeam, szTeam);
+            nlSNPrintf(szName, 64, "%sgoalie/%sgoalie", szTeam, szTeam);
+        }
+        textures[i] = glGetTexture(szName);
+        if (nlFileExists(szPath))
+        {
+            references[i] = nlLoadEntireFile(szPath, &sizes[i], 32, AllocateStart, 0, 0, 0);
+        }
+    }
+    if (!mscharged_tweak_make_away_kit(szCaptain, kind != MIRROR_MATCH_KIT, data, size, source, target, references[0],
+            sizes[0], textures[0], references[1], sizes[1], textures[1]))
+    {
+        nlPrintf("Mirror match: the %s away kit keeps the home colours (texture %08lx)\n", szCaptain, source);
+    }
+    for (int i = 0; i < 2; i++)
+    {
+        if (references[i] != 0)
+        {
+            nlFree(references[i]);
+        }
+    }
+}
+#endif
+
 CharacterLoader::~CharacterLoader()
 {
 }
