+// Port tweak "Mirror match". Whether a bundle name of the resource manager
+// was set (the on-demand one is set when the first match loads).
+static bool MirrorMatchBundleName(const char* name)
+{
+    for (int i = 0; i < 0x20; i++)
+    {
+        if (name[i] == 0)
+        {
+            return i != 0;
+        }
+    }
+    return false;
