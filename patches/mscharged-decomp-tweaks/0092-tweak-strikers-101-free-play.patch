+
+#if defined(MSCHARGED_TWEAKS)
+// Port tweak "Training": Strikers 101's FREE PLAY. The navigation's PLAY
+// button (the Cup's PLAY NOW, at the bottom right) shows beside the BACK with
+// the host's text, and goes into a training match through Domination's own
+// screens: its captains, sidekicks, sides and stadium (its gameplay options
+// are left out: training plays its own match). The captains share the
+// lessons' camera (fechoosecaptains), so they come straight after the list's
+// out slide.
+static const unsigned short sFreePlayDefault[] = { 'F', 'R', 'E', 'E', ' ', 'P', 'L', 'A', 'Y', 0 };
+
+void ChallengeSelectScene::InitializeFreePlay()
+{
+    SHNavigation* navigation = GetNavigationScene();
+    navigation->SetButtons(NAVIGATION_BUTTON_BACK | NAVIGATION_BUTTON_PLAY, true);
+    mFreePlayInstance = navigation->GetButton(NAVIGATION_BUTTON_PLAY);
+    const unsigned short* text = mscharged_tweak_training_free_play_text();
+    if (text == NULL || text[0] == 0)
+    {
+        text = sFreePlayDefault;
+    }
+    static const char* const slides[3] = { "off", "over", "down" };
+    for (int i = 0; i < 3; ++i)
+    {
+        FEFinder<TLTextInstance, 3>::FindOrDefault(mFreePlayInstance, slides[i], "Group", "playnow")->SetString(text);
+    }
+    mFreePlayShown = true;
+
+    typedef Detail::MemFunImpl<void, void (ChallengeSelectScene::*)(int, void*)> PointerMethod;
+    typedef BindExp3<void, PointerMethod, ChallengeSelectScene*, Placeholder<0>, Placeholder<1> > PointerBinding;
+    FEPointerListener::Callback onEnter(
+        PointerBinding(MemFun(&ChallengeSelectScene::OnFreePlayEnter), this, Placeholder<0>(), Placeholder<1>()));
+    FEPointerListener::Callback onLeave(
+        PointerBinding(MemFun(&ChallengeSelectScene::OnFreePlayLeave), this, Placeholder<0>(), Placeholder<1>()));
+    FEPointerListener::Callback onPressed(
+        PointerBinding(MemFun(&ChallengeSelectScene::OnFreePlayPressed), this, Placeholder<0>(), Placeholder<1>()));
+    SetPlayButtonBounds(&mFreePlayButton, mFreePlayInstance);
+    mFreePlayButton.SetPointerEnterCallback(onEnter);
+    mFreePlayButton.SetPointerLeaveCallback(onLeave);
+    mFreePlayButton.SetPointerPressCallback(onPressed);
+}
+
+void ChallengeSelectScene::OnFreePlayEnter(int pointerIndex, void*)
+{
+    ++mPointerInsideCount;
+    if (!mFreePlayButton.HasOtherPointerState(POINTER_BUTTON_HOVER, pointerIndex))
+    {
+        mFreePlayInstance->SetActiveSlide("over", true, false);
+        FEAudio::PlayAnimAudioEvent(0xAA73EF34, 0, 0, 1);
+    }
+    mFreePlayButton.SetPointerState(POINTER_BUTTON_HOVER, pointerIndex);
+}
+
+void ChallengeSelectScene::OnFreePlayLeave(int pointerIndex, void*)
+{
+    --mPointerInsideCount;
+    mFreePlayButton.SetPointerState(POINTER_BUTTON_NORMAL, pointerIndex);
+    if (!mFreePlayButton.HasOtherPointerState(POINTER_BUTTON_HOVER, pointerIndex))
+    {
+        mFreePlayInstance->SetActiveSlide("off", true, false);
+    }
+}
+
+void ChallengeSelectScene::OnFreePlayPressed(int, void*)
+{
+    FEAudio::PlayAnimAudioEvent(0xF0AFD586, 0, 0, 1);
+    mFreePlayChosen = true;
+    mState = CHALLENGE_SELECT_TRANSITIONING;
+    GetNavigationScene()->HideButtons();
+    mPresentation->SetActiveSlide("out", true);
+}
+
+void ChallengeSelectScene::StartFreePlay()
+{
+    // As the main menu's Domination (SHMainMenu::ApplyItem), then marked as
+    // training's match (SetMode clears the mark): the list stays where it was
+    // for the way back.
+    GameInfoManager* gameInfo = GameInfoManager::Instance();
+    gameInfo->SetMode(GameInfoManager::GM_FRIENDLY, 0);
+    g_bTrainingMatch = true;
+    g_bFreePlayMatch = true;
+    gameInfo->SetTeam(0, 0);
+    gameInfo->SetTeam(1, 0);
+    gameInfo->ResetPlayingSides();
+    g_pStrikerChallenge->mChallengeOffset = mChallengeOffset;
+    FEMusic::StartStreamIfDifferent(1);
+    GameSceneManager::Instance()->Push(SCENE_CHOOSE_CAPTAINS_DOMINATION, SCREEN_FORWARD, true);
+}
+#endif
