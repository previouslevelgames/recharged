+#if defined(MSCHARGED_TWEAKS)
+#ifndef MSCHARGED_ONLINE_RELEASES_H
+#define MSCHARGED_ONLINE_RELEASES_H
+
+// Online play between the releases (tweak patch 0058). The original version
+// word (GetNetworkVersionWord: the region and build number) keeps the
+// releases apart in matchmaking (its AP key and filter), in the socket's
+// packets and in friends' status. Online, the port's games of every release
+// speak one protocol instead, this word; the online draft then picks the
+// simulation profile they play by (include/mscharged_sim_profile.h). LAN
+// keeps the original word. Raise the low half whenever the port's network
+// protocol or a simulation profile changes, so games that would go out of
+// sync never meet. It cannot be an original word (0x1B?3xxxx).
+#define MSCHARGED_ONLINE_VERSION_WORD 0x52430001u
+
+#endif
+#endif
