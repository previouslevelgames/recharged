+#if defined(MSCHARGED_TWEAKS)
+// The host picks a network match's simulation profile from its machines'
+// own (their draft entries) and sends it with the draft.
+static void ChooseDraftSimProfile(NetMessageDraft* message)
+{
+    unsigned char natives[8];
+    int count = message->mMachineCount;
+    if (count < 0)
+        count = 0;
+    if (count > 8)
+        count = 8;
+    for (int i = 0; i < count; ++i)
+    {
+        natives[i] = message->mEntries[i].mSimProfile;
+    }
+    message->mSimProfile = (u8)mscharged_sim_resolve(natives, count);
+}
+
+#endif
