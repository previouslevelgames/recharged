From: mscharged-port
Subject: Recharged's tournaments: the ceremony's panel says the host's texts
Upstream-base: 8b9d92dd88b4c727cc6359ee4cd5ba128cced7b8

The game that wins one of Recharged's tournaments ends with the tournament
trophy's ceremony (0076), whose NIS shows the "cup" panel. The cut online
tournament's came to GoalOverlay::DoCupWinOverlay with no cup and outside
cup mode, where nothing named the cup or its winners: the panel read an
uninitialised cup name and winning team (the Fire Cup's title came up, and
a missing string under it). A new hook,
mscharged_tweak_tournament_trophy_texts, gives that panel the host's title
(the tournament won) and the text for the winner instead, with the winning
team's lower third as usual.

diff --git a/include/mscharged_tweaks.h b/include/mscharged_tweaks.h
index c1f2356..d8160c6 100644
--- a/include/mscharged_tweaks.h
+++ b/include/mscharged_tweaks.h
@@ -287,6 +287,10 @@ const unsigned short* mscharged_tweak_take_online_lock_message(void);
 // whose model the matches of a set that may end the tournament load, or -1.
 int mscharged_tweak_tournament_trophy(int winner_side);
 int mscharged_tweak_tournament_trophy_template(void);
+// That game's "cup" panel: its title, and the text under it for the winner
+// (`winner_side`), the host's (false: the game's own texts).
+bool mscharged_tweak_tournament_trophy_texts(int winner_side, const unsigned short** title,
+                                             const unsigned short** description);
 
 #ifdef __cplusplus
 }
diff --git a/src/Game/FE/Overlay/OverlayHandlerGoal.cpp b/src/Game/FE/Overlay/OverlayHandlerGoal.cpp
index 63b6a67..9d86fc2 100644
--- a/src/Game/FE/Overlay/OverlayHandlerGoal.cpp
+++ b/src/Game/FE/Overlay/OverlayHandlerGoal.cpp
@@ -614,6 +614,41 @@ void GoalOverlay::DoCupWinOverlay(int cup)
 {
     const char* cupName;
     eTeamID winners;
+#if defined(MSCHARGED_TWEAKS)
+    // Recharged's tournaments (tweak patch 0076): the ceremony of the game
+    // that wins one says the host's texts. (The cut online tournament's came
+    // here with no cup and outside cup mode, where nothing named its cup or
+    // its winners.)
+    if (cup == -1 && !GameInfoManager::Instance()->IsInCupMode())
+    {
+        const int winnerSide = NisPlayer::Instance()->mWinnerSide[NIS_GAME_WINNER];
+        const unsigned short* title = NULL;
+        const unsigned short* description = NULL;
+        if (mscharged_tweak_tournament_trophy_texts(winnerSide, &title, &description))
+        {
+            int at = 0;
+            for (; title[at] != 0 && at < 127; ++at)
+                mScoresBuffer[at] = title[at];
+            mScoresBuffer[at] = 0;
+            for (at = 0; description[at] != 0 && at < 127; ++at)
+                mDescriptionBuffer[at] = description[at];
+            mDescriptionBuffer[at] = 0;
+            TLSlide* slide = mPresentation->GetActiveSlide();
+            TLTextInstance* pText = FEFinder<TLTextInstance, 3>::Find<TLSlide>(slide, "Layer", "Name");
+            pText->SetString(mScoresBuffer);
+            pText = FEFinder<TLTextInstance, 3>::Find<TLSlide>(slide, "Layer", "Description");
+            MakeTextBoxReallyWide(*pText);
+            pText->SetString(mDescriptionBuffer);
+            pText = FEFinder<TLTextInstance, 3>::Find<TLSlide>(slide, "Layer", "Time");
+            pText->m_bVisible = false;
+            winners = (eTeamID)GameInfoManager::Instance()->GetTeam((short)winnerSide);
+            TLComponentInstance* component = FEFinder<TLComponentInstance, 4>::Find<TLSlide>(slide, "Layer", "lowerthirdgraphic");
+            if (component != NULL)
+                component->SetActiveSlide(GetTeamName(winners), true, false);
+            return;
+        }
+    }
+#endif
     if (cup != -1)
     {
         NisPlayer* nisPlayer = NisPlayer::Instance();
