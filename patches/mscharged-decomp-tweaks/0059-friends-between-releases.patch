diff --git a/src/RVL_SDK/dwc/dwc_account.c b/src/RVL_SDK/dwc/dwc_account.c
index 142c9f9..4a6e90e 100644
--- a/src/RVL_SDK/dwc/dwc_account.c
+++ b/src/RVL_SDK/dwc/dwc_account.c
@@ -10,6 +10,9 @@
 #endif
 #include <nitro/math/rand.h>
 #include <revolution/os/OSTime.h>
+#if defined(MSCHARGED_TWEAKS)
+#include <revolution/net/NETDigest.h>
+#endif
 #include <stdio.h>
 #include <string.h>
 
@@ -302,8 +305,76 @@ u64 DWC_Acc_CreateFriendKey(int gs_profile_id,
 }
 #endif
 
+#if defined(MSCHARGED_TWEAKS)
+// Friends between the releases (tweak patch 0059): a friend code is a
+// profile id under 7 bits of a hash over that id and the game code of the
+// release that made it, which need not be this game's. Each release makes
+// its codes as DWC_CreateFriendKey does there: CRC-8, the Korean one MD5.
+// Making codes stays as it was, so every player keeps the code they see.
+// The Korean game builds the other releases' DWC (tweak patch 0060) and
+// makes CRC-8 codes too; its MD5 codes stay valid for friends saved before.
+static const u32 sMschargedFriendKeyCrcReleases[] = {
+    0x52345145, // R4QE
+    0x52345150, // R4QP
+    0x5234514A, // R4QJ
+    0x5234514B, // R4QK
+};
+
+static const u32 sMschargedFriendKeyMd5Release = 0x5234514B; // R4QK
+
+static BOOL DWCi_Acc_MschargedIsReleaseFriendKey(u64 friendkey)
+{
+    u32 code[2];
+    u32 reversed[2];
+    u32 hash = (u32)(friendkey >> 32);
+    u32 i;
+
+    // The original checks refuse negative profile ids; every release's
+    // hash has 7 bits.
+    if ((friendkey & 0x80000000) || (u32)friendkey == 0 || hash > 0x7f)
+    {
+        return FALSE;
+    }
+
+    code[0] = (u32)friendkey;
+    for (i = 0; i < sizeof(sMschargedFriendKeyCrcReleases) / sizeof(sMschargedFriendKeyCrcReleases[0]); ++i)
+    {
+        MATHCRC8Table table;
+
+        code[1] = sMschargedFriendKeyCrcReleases[i];
+        MATH_CRC8InitTable(&table);
+        DWCi_Np_ToLE(code, reversed, sizeof(code));
+        if ((MATH_CalcCRC8(&table, reversed, sizeof(reversed)) & 0x7f) == hash)
+        {
+            return TRUE;
+        }
+    }
+
+    {
+        NETMD5Context context;
+        u8 digest[16];
+
+        code[1] = sMschargedFriendKeyMd5Release;
+        DWCi_Np_ToLE(code, reversed, sizeof(code));
+        NETMD5Init(&context);
+        NETMD5Update(&context, reversed, sizeof(reversed));
+        NETMD5GetDigest(&context, digest);
+        return (u32)(digest[0] >> 1) == hash;
+    }
+}
+#endif
+
 BOOL DWC_CheckFriendKey(const DWCAccUserData* userdata, u64 friendkey)
 {
+#if defined(MSCHARGED_TWEAKS)
+    // A code of another release names its profile as well: DWC then asks
+    // the server for it (addbuddy) and keeps it as any friend code until
+    // the friendship is mutual.
+    if (DWCi_Acc_MschargedIsReleaseFriendKey(friendkey))
+    {
+        return TRUE;
+    }
+#endif
 #if defined(VERSION_R4QK01)
     return DWC_Acc_CheckFriendKey(friendkey, userdata->gamecode, DWCi_FRIENDKEY_GENERATOR_MD5);
 #else
@@ -356,6 +424,12 @@ BOOL DWC_Acc_CheckFriendKey(u64 friendkey,
 int DWC_Acc_FriendKeyToGsProfileId(u64 friendkey,
     u32 gamecode)
 {
+#if defined(MSCHARGED_TWEAKS)
+    if (DWCi_Acc_MschargedIsReleaseFriendKey(friendkey))
+    {
+        return (int)(friendkey & 0xffffffff);
+    }
+#endif
 #if defined(VERSION_R4QK01)
     int i;
 
@@ -643,6 +717,12 @@ int DWC_GetGsProfileId(const DWCAccUserData* userdata,
     {
         u64 friend_key = DWCi_Acc_GetFriendKey(&frienddata->friend_key);
 
+#if defined(MSCHARGED_TWEAKS)
+        if (DWCi_Acc_MschargedIsReleaseFriendKey(friend_key))
+        {
+            return (int)(friend_key & 0xffffffff);
+        }
+#endif
 #if defined(VERSION_R4QK01)
         return DWC_Acc_FriendKeyToGsProfileId(friend_key, userdata->gamecode);
 #else
