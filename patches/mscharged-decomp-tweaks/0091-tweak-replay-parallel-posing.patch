 #include "Game/Ball.h"
@@ -837,6 +840,13 @@ void cCharacter::PostPhysicsUpdate()
 
     CreateWorldMatrix();
 
+#if defined(MSCHARGED_TWEAKS)
+    // A replay: the pose's evaluation ran beside the physics step (when it
+    // still holds); the bone matrices follow here, in the characters' order.
+    if (mscharged_tweak_pose_take(m_pPoseAccumulator, m_pPoseTree))
+        m_pPoseAccumulator->BuildNodeMatrices(m_m4WorldMatrix);
+    else
+#endif
     m_pPoseAccumulator->Pose(*m_pPoseTree, m_m4WorldMatrix);
     m_pPhysicsCharacter->UpdatePose(
         m_pPoseAccumulator, m_DetChar.m_v3Position.z, false);
