--- a/src/Game/SH/SHOnlineMatchmakingDraft.cpp
+++ b/src/Game/SH/SHOnlineMatchmakingDraft.cpp
@@ -406,14 +406,17 @@
     }
 
 #if defined(MSCHARGED_TWEAKS)
-    // Competitive play: a set called off while its game searches leaves the
-    // search as the player's Back would, so no stranger is met.
+    // Competitive play: a set called off while its game searches (the
+    // opponent left or withdrew) leaves the search, so no stranger is met,
+    // and the online menus, as the online menu's LOG OUT does: back to the
+    // main menu.
     if (CanCancelOnlineMatchmaking() && mscharged_competitive_leave_search())
     {
-        GameSceneManager::Instance()->Push(SCENE_ONLINE_RANKED, SCREEN_BACK, true);
         CancelOnlineMatchmaking();
-        FEMusic::StartStreamIfDifferent(8);
         FEAudio::StopAnimAudioEvent(0x89B1FC93, (void*)0x2A);
