diff --git a/include/mscharged_sim_profile.h b/include/mscharged_sim_profile.h
new file mode 100644
index 0000000..aae2b2b
--- /dev/null
+++ b/include/mscharged_sim_profile.h
@@ -0,0 +1,86 @@
+#if defined(MSCHARGED_TWEAKS)
+#ifndef MSCHARGED_SIM_PROFILE_H
+#define MSCHARGED_SIM_PROFILE_H
+
+// Simulation profiles (tweak patch 0057): the rules a match is simulated by,
+// named by the releases whose code has them. The releases' game code differs
+// in its simulation (ball physics, goalies, items, stadium hazards), so two
+// machines of different releases go out of sync unless both simulate by the
+// same rules. Each game module runs its own release's rules and those of the
+// canonical profile, the European revision 2 (whose module therefore runs one
+// profile only); the online draft picks the profile of each network match
+// (tweak patch 0058), and every other game keeps the module's own. The
+// functions are the port's src/platform/sim_profile.cpp.
+//
+// In a module of two profiles (MSCHARGED_SIM_RUNTIME), every site of the
+// original code where its simulation and the canonical one differ gets a
+// block that asks MSCHARGED_SIM_IS with the releases of the original's #if.
+// The European revision 1 disc plays with the revision 2 code (tweak patch
+// 0019): its profile is revision 2's.
+
+// The releases, as bits of a profile mask.
+#define MSCHARGED_SIM_R4QE01 0x01u
+#define MSCHARGED_SIM_R4QP01_REV1 0x02u
+#define MSCHARGED_SIM_R4QP01_REV2 0x04u
+#define MSCHARGED_SIM_R4QJ01 0x08u
+#define MSCHARGED_SIM_R4QK01 0x10u
+// The groups the original's conditions name most.
+#define MSCHARGED_SIM_USA_JAPAN_KOREA (MSCHARGED_SIM_R4QE01 | MSCHARGED_SIM_R4QJ01 | MSCHARGED_SIM_R4QK01)
+#define MSCHARGED_SIM_EUROPE (MSCHARGED_SIM_R4QP01_REV1 | MSCHARGED_SIM_R4QP01_REV2)
+
+// The profile every network match falls back to when its machines' own
+// profiles differ.
+#define MSCHARGED_SIM_CANONICAL MSCHARGED_SIM_R4QP01_REV2
+
+// This module's own profile (the decomp's default release without one).
+#if defined(VERSION_R4QP01_REV2)
+#define MSCHARGED_SIM_NATIVE MSCHARGED_SIM_R4QP01_REV2
+#elif defined(VERSION_R4QP01_REV1)
+#define MSCHARGED_SIM_NATIVE MSCHARGED_SIM_R4QP01_REV1
+#elif defined(VERSION_R4QJ01)
+#define MSCHARGED_SIM_NATIVE MSCHARGED_SIM_R4QJ01
+#elif defined(VERSION_R4QK01)
+#define MSCHARGED_SIM_NATIVE MSCHARGED_SIM_R4QK01
+#else
+#define MSCHARGED_SIM_NATIVE MSCHARGED_SIM_R4QE01
+#endif
+
+// The profiles this module can simulate.
+#define MSCHARGED_SIM_SUPPORTED (MSCHARGED_SIM_NATIVE | MSCHARGED_SIM_CANONICAL)
+
+// The modules of the USA, Japan and Korea also run the European code.
+#if (MSCHARGED_SIM_NATIVE & MSCHARGED_SIM_USA_JAPAN_KOREA) != 0
+#define MSCHARGED_SIM_RUNTIME 1
+#endif
+
+// The Korean game also differs from every other release on its own: its
+// goalie's AI and the ball's collisions with the players. In its module the
+// sites of those differences ask MSCHARGED_SIM_IS(MSCHARGED_SIM_R4QK01) and
+// run the other releases' code on another profile.
+#if MSCHARGED_SIM_NATIVE == MSCHARGED_SIM_R4QK01
+#define MSCHARGED_SIM_KOREA_RUNTIME 1
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+// The profile of the match under way, or this module's own.
+unsigned int mscharged_sim_profile(void);
+// The draft's choice of a network match's profile (tweak patch 0058), from
+// the profiles of all its machines (zero for a machine that did not say):
+// the game's own RANKED (`ranked`) plays by the canonical one; any other,
+// by their own profile when all share it, else by the canonical one.
+unsigned int mscharged_sim_resolve(const unsigned char* natives, int count, int ranked);
+// Simulate by `profile` from now on. A profile this module cannot simulate
+// is refused: it keeps its own, and the match goes out of sync.
+void mscharged_sim_set_profile(unsigned int profile);
+// Back to this module's own profile: outside network matches.
+void mscharged_sim_reset_profile(void);
+#ifdef __cplusplus
+}
+#endif
+
+#define MSCHARGED_SIM_IS(releases) ((mscharged_sim_profile() & (releases)) != 0)
+
+#endif
+#endif
diff --git a/src/Game/AI/AiUtil.cpp b/src/Game/AI/AiUtil.cpp
index fd317c3..a0245b3 100644
--- a/src/Game/AI/AiUtil.cpp
+++ b/src/Game/AI/AiUtil.cpp
@@ -1,4 +1,7 @@
 #include "Game/AI/AiUtil.h"
+#if defined(MSCHARGED_TWEAKS)
+#include "mscharged_sim_profile.h"
+#endif
 
 #if defined(MSCHARGED_NATIVE)
 #include <cstdlib>
@@ -76,6 +79,45 @@ void MakePerpendicularPlane(const nlVector3& v3Position, const nlVector3& v3Norm
 
 bool IsPointInCone(const nlVector3& v3Point, const nlVector3& v3Pivot, const nlVector3& v3Plane1, const nlVector3& v3Plane2)
 {
+#if defined(MSCHARGED_TWEAKS) && defined(MSCHARGED_SIM_RUNTIME)
+    // Every release but the Korean one tests the cone so: a Korean
+    // module on another profile does as they do.
+    if (!MSCHARGED_SIM_IS(MSCHARGED_SIM_R4QK01))
+    {
+        float distSqA = nlVec3DistanceSquared2D(v3Plane1, v3Pivot);
+        float distSqP = nlVec3DistanceSquared2D(v3Plane1, v3Point);
+
+        if (distSqP < distSqA)
+        {
+            nlVector3 v3Direction;
+            float dirY = v3Pivot.y - v3Point.y;
+            float dirZ = v3Pivot.z - v3Point.z;
+            float dirX = v3Pivot.x - v3Point.x;
+            nlVec3Set(v3Direction, dirX, dirY, dirZ);
+
+            nlVector3 v3Normal;
+            nlVec3Set(v3Normal, -v3Direction.y, v3Direction.x, 0.0f);
+            float invLen = nlRecipSqrt(v3Normal.GetLengthSq3D(), true);
+
+            nlVector4 v4Plane;
+            v4Plane.x = invLen * v3Normal.x;
+            v4Plane.y = invLen * v3Normal.y;
+            v4Plane.z = invLen * v3Normal.z;
+            float zeroVal = 0.0f;
+            v4Plane.w = (v3Pivot.x * v4Plane.x + v3Pivot.y * v4Plane.y + v3Pivot.z * v4Plane.z) + zeroVal;
+
+            f32 sideLeft = nlPlaneSide(v3Plane1, v4Plane);
+            f32 sideRight = nlPlaneSide(v3Plane2, v4Plane);
+
+            if (sideLeft * sideRight < zeroVal)
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+#endif
 #if defined(VERSION_R4QK01)
     nlVector3 v3Direction;
     float dirY = v3Pivot.y - v3Point.y;
