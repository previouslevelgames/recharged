--- a/src/Game/FE/tlSlide.cpp
+++ b/src/Game/FE/tlSlide.cpp
@@ -5,6 +5,7 @@
 #include "NL/nlDLRing.h"
 #include "NL/nlString.h"
 #include "NL/nlstring_tmpl.h"
+#include "mscharged_tweaks.h"
 
 /**
  * Offset/Address/Size: 0x0 | 0x802FFAFC | size: 0x1D8
@@ -41,6 +42,24 @@ void TLSlide::Update(float deltaTime)
     {
         deltaTime = 0.0f;
     }
+#if defined(MSCHARGED_TWEAKS)
+    // Port tweak "Fast menus": a one-shot slide no longer than a transition
+    // goes straight to its end. Update(0) is a reset (SetActiveSlide): a slide
+    // reset this frame keeps its first frame, as scenes holding one rely on it.
+    // Longer slides are content (credits) and looping ones idle animation.
+    if (mscharged_tweak_fast_menus() && !m_bPaused)
+    {
+        if (deltaTime == 0.0f)
+        {
+            mscharged_tweak_note_slide_reset(this);
+        }
+        else if (deltaTime > 0.0f && m_uPlayMode != TLPM_LOOPING && GetDuration() <= 3.0f
+                 && !mscharged_tweak_slide_reset_this_frame(this))
+        {
+            m_time = GetStartTime() + GetDuration() - deltaTime;
+        }
+    }
+#endif
 
     m_time += deltaTime;
     float end = GetStartTime() + GetDuration();
