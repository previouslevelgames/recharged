+// Recharged's tournaments (tweak patch 0081): the set's player at home in
+// this game (0079) drafts first. The draft sorts its teams by the players'
+// RANKED records, so the host, this machine `local`, names the machine
+// whose team goes first, and every machine puts it there.
+static void ChooseDraftFirstMachine(NetMessageDraft* message, int local)
+{
+    message->mFirstMachine = -1;
+    if (!IsOnlineRankedMatch() || message->mMachineCount != 2 || !mscharged_competitive_set_draft(message))
+        return;
+    const int wanted = mscharged_competitive_set_side();
+    if (wanted >= 0 && (local == 0 || local == 1))
+        message->mFirstMachine = (s8)(wanted == 0 ? local : 1 - local);
+}
+
 #endif
 
