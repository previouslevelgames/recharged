--- a/src/Game/Drawable/DrawableCharacter.cpp
+++ b/src/Game/Drawable/DrawableCharacter.cpp
@@ -28,6 +28,9 @@
 #include "NL/gl/glMaterialParameters.h"
 #include "NL/glx/GXCharacterDamageMaterialProgram.h"
 #include "NL/glx/glxTexture.h"
+#if defined(MSCHARGED_TWEAKS)
+#include "mscharged_rollback.h"
+#endif
 #include "NL/nlMemory.h"
 #include "NL/nlString.h"
 #include "NL/nlTask.h"
@@ -607,6 +610,18 @@ void DrawableCharacter::Blend(const float* blendFactors, DrawableCharacter& lhs,
     {
         poseAccumulator = new (nlMalloc(sizeof(cPoseAccumulator), 8, false)) cPoseAccumulator(lhs.poseAccumulator->m_BaseSHierarchy, false);
     }
+#if defined(MSCHARGED_TWEAKS)
+    // A rollback's replay draws nothing (GameRenderTask::Run): the pose, which
+    // the drawing reads, keeps the last drawing's. The positions above blend
+    // as ever: the cameras and the ball read them. An effect that follows the
+    // character's joints (Waluigi's wall) marks the pose each frame it reads
+    // it (EmissionController::SetPoseAccumulator): that pose blends in
+    // replays too, or the effect would emit from where the joints were.
+    const bool readByEffect = poseAccumulator->m_Padding[0] != 0;
+    poseAccumulator->m_Padding[0] = 0;
+    if (mscharged_rollback_resimulating() && !readByEffect)
+        return;
+#endif
 
     poseAccumulator->m_Scale = scale;
     poseAccumulator->InitAccumulators();
