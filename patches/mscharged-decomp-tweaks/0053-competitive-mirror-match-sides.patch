 static void MirrorMatchMakeAwayHand(eCharacterClass captain)
 {
     static const char* const sHands[2][2] = { { "mega_hand", "mega_hand_alt" }, { "mega_hand1", "mega_hand_alt1" } };
     const char* szCaptain = GetCharacterInfo(captain).mName;
     char szPath[128];
     nlStrNCpy(szPath, GetCharacterTemplateInfo(captain)->szTextureFilename, sizeof(szPath));
     char* pEnd = &szPath[nlStrLen(szPath) - 1];
     while (pEnd > szPath && *pEnd != '/')
     {
         pEnd--;
     }
     *pEnd = '\0';
     nlStrNCat(szPath, szPath, "/ExtraTextures.rlt", sizeof(szPath));
     unsigned long size = 0;
     void* data = nlLoadEntireFile(szPath, &size, 32, AllocateStart, 0, 0, 0);
     if (data == 0)
     {
         return;
     }
     for (int i = 0; i < 2; i++)
     {
         char szHome[64];
         char szAway[64];
         nlSNPrintf(szHome, 64, "%s/%s", szCaptain, sHands[i][0]);
         nlSNPrintf(szAway, 64, "%s/%s", szCaptain, sHands[i][1]);
         if (!mscharged_tweak_make_away_kit(szCaptain, false, data, size, nlStringLowerHash(szHome),
                 nlStringLowerHash(szAway), 0, 0, 0, 0, 0, 0))
         {
             nlPrintf("Mirror match: the %s away hand keeps the home colours (%s)\n", szCaptain, szHome);
         }
     }
     glEndLoadTextureBundle(data, size, glGetCurrentResourcePool(), true);
     nlFree(data);
 }
 #endif
 
