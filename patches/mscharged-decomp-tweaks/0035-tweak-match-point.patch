diff --git a/src/Game/FE/Overlay/OverlayHandlerHUD.cpp b/src/Game/FE/Overlay/OverlayHandlerHUD.cpp
index d1598da..cdcd9e6 100644
--- a/src/Game/FE/Overlay/OverlayHandlerHUD.cpp
+++ b/src/Game/FE/Overlay/OverlayHandlerHUD.cpp
@@ -97,6 +97,20 @@ void HUDOverlay::Update(float fDeltaT)
     {
         mClock.Update(fDeltaT);
     }
+#if defined(MSCHARGED_TWEAKS)
+    // Port tweak "Match point": with both teams one goal from winning, the
+    // clock's place shows overtime's SUDDEN DEATH instead of "First to".
+    else if (g_pGame != NULL)
+    {
+        const bool suddenDeath = g_pGame->MatchPoint(0) && g_pGame->MatchPoint(1);
+        if (suddenDeath != mClock.mSuddenDeath[0]->m_bVisible)
+        {
+            mClock.mSuddenDeath[0]->m_bVisible = suddenDeath;
+            mClock.mSuddenDeath[1]->m_bVisible = suddenDeath;
+            mClock.m_pTextInstanceGameType->m_bVisible = !suddenDeath;
+        }
+    }
+#endif
 }
 
