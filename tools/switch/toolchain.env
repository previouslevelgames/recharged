# The Nintendo Switch toolchain: devkitPro's devkitA64 image (Debian 12,
# devkitA64 r29.2 with GCC 15.2.0 and binutils 2.45.1, newlib 4.6.0,
# libnx 4.12.0, the switch portlibs, CMake 3.31, Ninja, Python 3.11),
# pinned by digest. Change it only together with a full Switch build check.
DEVKITPRO_IMAGE=devkitpro/devkita64@sha256:1fc388c3a0d34bd2045a6dadcb1020e069d5f876a187fd705de14b4440c00282
# The NVK driver's build image (tools/switch/build-nvk.sh), with the versions
# new-coke's Strikers port builds mesa-switch with.
MESA_RUST_TOOLCHAIN=1.99.1
MESA_PY_TOOLS="meson==1.12.1 mako==1.4.3"
MESA_CARGO_TOOLS="bindgen-cli@0.73.2 cbindgen@0.29.4"
