# Copy this file to recharged.ini and set your disc image path.
# Paths are relative to this INI file. Absolute paths also work.
# ISO, RVZ and WBFS are read directly; no extraction or conversion is needed.
[game]
# The image Play starts (the one chosen on the launcher's Game page).
disc = game/R4QE01.rvz

# Game folder: the launcher lists the Mario Strikers Charged images in it;
# clicking one sets disc above. folder_subfolders also lists the images in its
# subfolders.
folder = game
folder_subfolders = true

# Game text: auto, or a language of the disc: english, french or spanish
# (USA); english, german, french, spanish or italian (Europe). Automatic takes
# the computer's language when the disc has it, else English.
language = auto

# Folder for the game's Wii saves. Empty: data/nand next to the program.
# A different folder starts without saves.
save_folder = ""

# Super Mario Strikers (GameCube) image, for the Super Team tweak (its robots
# come from that disc). Empty: the launcher fills in one it finds in the game
# folder.
gamecube_disc = ""

[display]
# Resolution in a window: its size; the game keeps the size and place you
# leave the window at (remember_window = false turns that off). position: where
# it was, X,Y on the desktop, empty to centre it; Wayland desktops place windows
# themselves.
width = 1280
height = 720
remember_window = true
position =
fullscreen = false
# Resolution in fullscreen: desktop keeps the display's own; a mode of the
# display (1280x720) switches the display to it while the game runs.
fullscreen_resolution = desktop
vsync = true
# Frame rate: original (the console's 60 FPS), display (your display's refresh
# rate), unlimited, or a cap from 30 to 1000 FPS. Higher rates draw more frames
# for smoother motion; the game keeps its own speed. VSync holds any rate to
# the display's.
frame_rate = original
# Windows: vulkan or d3d12. macOS: metal. Linux: vulkan.
# auto preserves the platform default (Vulkan on Windows/Linux, Metal on macOS);
# on Windows it switches to DirectX 12 when Vulkan cannot start.
backend = auto
# Graphics card (Windows and Linux): auto (the fastest) or a card's PCI ID,
# such as 10de:1f99 (Advanced -> Graphics card lists the PC's cards). A card
# the graphics API does not offer falls back to auto.
gpu = auto
# Aspect ratio: 16:9 (the game's widescreen layout) or 4:3, both keeping their
# shape (a window keeps it when resized; other displays show bars), stretch
# (fills the window or display with the 16:9 layout, or 4:3 on screens closer
# to that shape) or auto (16:9 or 4:3 by the screen's shape, keeping it).
# wider_view: with 16:9, a screen of another shape shows more of the stadium
# in matches instead of bars, the HUD in the 16:9 middle; menus keep 16:9.
aspect = 16:9
wider_view = false
# Picture: sharp or clean (Modern: the game's picture drawn straight into the
# window; a 3D resolution other than window reaches the screen's size with
# square pixels or smoothly), or soft (Original TV: the Wii's flicker filter and
# a TV's softness). tv_border: soft shows the empty border a Wii sends around
# its picture, which a TV hides.
picture = sharp
tv_border = false
# Performance mode (gear menu on the Play button): lighter matches without
# antialiasing, the crowd, background NPCs, ambient stadium effects, bloom,
# heat distortion, depth of field and stadium shadows. The 3D render size,
# gameplay, hazards and weather effects are unchanged.
performance_mode = false
# Antialiasing: off; fxaa (smooths the finished picture, nearly free); 4x
# (multisampling, the edges of 3D shapes); 4x_fxaa (both); or 4x_ssaa
# (supersampling, also the edges inside textures; the most GPU time).
antialiasing = 4x
# 3D render size: window (Full in the launcher: one pixel per pixel of the
# picture on the screen, default), native (the Wii's 640x448) or 2x, 3x, 4x of
# it. The game's view stays the same. The 3D resolution hotkeys change it while
# playing.
resolution = window
# Performance overlay: FPS | GPU % | CPU % | LAT N/A, also in fullscreen.
# GPU/CPU are total system usage; unavailable driver counters show N/A.
fps_overlay = false
# Corner of that counter: top-left, top-right, bottom-left or bottom-right.
fps_overlay_corner = top-right
# Display the game window opens on: 0 = default, 1 = first display, 2 = second...
monitor = 0

[audio]
# Host speaker volume (0-100) and mute.
master_volume = 100
# Sound levels (0-100) of each kind of the game's sounds: music, sound
# effects, character voices, the crowd, menu and on-screen display sounds,
# cutscenes (captain introductions, goal celebrations, Mega Strikes) and
# movies. The music, sound effect and voice settings in the game's own Options
# menu still apply on top.
music_volume = 100
effects_volume = 100
voice_volume = 100
crowd_volume = 100
menu_volume = 100
cutscene_volume = 100
movie_volume = 100
mute = false

[controls]
# Who plays: keyboard (keyboard & mouse), remote1-remote4 (the Wii Remote in
# that DolphinBar slot), remote-<Bluetooth address> (a Wii Remote paired over
# Bluetooth, e.g. remote-9ce635c69076; the launcher lists connected ones),
# gamepad1-gamepad4 (the n-th connected Xbox, PlayStation or other standard
# gamepad, played as Wii Remote + Nunchuk) or off. Players fill in order and
# each device plays once. Controllers missing when the game starts are left
# out and the others close up in order.
player1 = keyboard
player2 = off
player3 = off
player4 = off
# When player 1 is a Wii Remote or gamepad and plays alone, the mouse also
# points for it (left click A, right click B); the controller keeps working.
mouse_pointer = true
# Windows, continuous scanning: connect a Wii Remote over Bluetooth when you
# press 1+2 on it, while the launcher's Controls page is open and during a game
# while a player's Remote has dropped out. (Sync on the Controls page pairs a
# Remote for good: it then connects with any button.)
bluetooth_search = true
# Rumble on Wii Remotes and gamepads; how strongly gamepads rumble (0-100).
rumble = true
rumble_strength = 100
# Where the sensor bar or DolphinBar sits: bottom or top of the screen.
sensor_bar = bottom
# The Wii's sensor bar sensitivity (1-5) and Wii Remote speaker volume
# (0-100, 0 = no sound on the Remotes).
ir_sensitivity = 3
speaker_volume = 70
# Button profile of each gamepad: Default (built in; each controller family
# gets its own layout) or the name of a [gamepad_profileN] below. A missing
# profile plays as Default.
gamepad1_profile = Default
gamepad2_profile = Default
gamepad3_profile = Default
gamepad4_profile = Default

[keyboard]
# Keys of the keyboard & mouse Wii Remote: one or two SDL key names per
# action, separated by |; Mouse Middle, Mouse 4 and Mouse 5 (the side
# buttons) can take a key's place. Change them on the launcher's Controls page.
a = Return | Space
b = Escape | Backspace
one = Z
two = X
plus = Tab
minus = -
home = Home
up = Up
down = Down
left = Left
right = Right
stick_up = W
stick_left = A
stick_down = S
stick_right = D
c = C
z = V
shake_remote = E
shake_nunchuk = Q

[hotkeys]
# Keys of the game window, whoever plays: one SDL key name each, after the
# Ctrl+, Shift+ and Alt+ it is pressed with (Ctrl+Shift+F12), or none to leave
# it unused. A hotkey's key never reaches the game, so a key pressed alone
# cannot also be a [keyboard] key. The Windows and Command keys stay the
# system's.
# screenshot: saves the picture in the screenshots folder.
# hud: shows or hides the scoreboard, player markers and captions in a match.
# stretch: stretches the picture over the window, or gives it back its 16:9 or
# 4:3 shape; resolution_up and resolution_down: a higher or lower 3D
# resolution; fullscreen: fullscreen or a window (Alt+Return; Option+Return on
# a Mac). These four last for the run.
# show_hud = false: matches start with them hidden, for clean recordings; the
# Mega Strike meter and its defence stay.
screenshot = P
hud = H
stretch = F
resolution_up = PageUp
resolution_down = PageDown
fullscreen = Alt+Return
show_hud = true

# Gamepad profiles ([gamepad_profile1] to [gamepad_profile16]), made on the
# launcher's Controls page: a unique name (not Default) and one or two SDL
# gamepad inputs per action, separated by |: a, b, x, y (bottom, right, left,
# top face button), start, back, guide, leftshoulder, rightshoulder,
# leftstick, rightstick, dpup, dpdown, dpleft, dpright, lefttrigger,
# righttrigger, a stick pushed one way (leftstick_up, leftstick_down,
# leftstick_left, leftstick_right, rightstick_up ... rightstick_right; past
# half its travel), or none for no button. Actions left out keep the Default
# (Xbox) input. swap_sticks = true
# moves the Nunchuk stick to the right stick and the pointer to the left.
# inner_deadzone (0-30 %) and outer_deadzone (70-100 %): both sticks rest up to
# the inner one and are pushed all the way from the outer one on; the defaults,
# 15 and 71, play like a Nunchuk on the Wii. trigger_press (10-90 %, default
# 50): a trigger presses its button past this much of its travel.
# gyro_pointer = true: a controller with a gyro points by turning it instead of
# with the stick; gyro_speed (25-300 %, default 100: about 25 degrees across
# the picture). recenter_pointer: the input that centres the gyro pointer.
# controller: the controllers the profile is made for, xbox (Xbox and
# PlayStation, whose buttons sit in the same places), nintendo or gamecube;
# the launcher offers a gamepad the profiles of its kind.
# [gamepad_profile1]
# name = Southpaw
# a = a
# b = b
# one = x
# two = y
# plus = start
# minus = back
# home = guide
# up = dpup
# down = dpdown
# left = dpleft
# right = dpright
# c = leftshoulder
# z = lefttrigger
# shake_remote = righttrigger
# shake_nunchuk = rightshoulder
# recenter_pointer = rightstick
# swap_sticks = true
# inner_deadzone = 15
# outer_deadzone = 71
# trigger_press = 50
# gyro_pointer = false
# gyro_speed = 100
# controller = xbox

[gameplay]
# Optional tweaks that change the original game. All off plays it unchanged;
# --no-tweaks turns them off for one run. Off unless set, except
# fair_ball_contests, recommended to every player and on unless set to false.
# skip_intro: start at the main menu (no notices, logo, intro or title screen).
# fast_menus: skip menu transitions, also in the pause menu and on the
# screens after a match (matches, movies and credits unchanged).
# no_mega_strikes: Mega Strikes off for both teams; Skillshots stay (Strikers
# 101 lessons keep their own rules).
# unlock_all: all characters, stadiums and cheats; the save is not changed.
# cpu_vs_cpu: in Domination, Done on Choose Sides also works with no side
# picked; the CPU then plays both teams (from the pause menu too).
# fast_terrain: every stadium plays like Bowser Stadium's fast, dry field
# (speed, ball roll and bounce; no sliding, no slow sand in the Sand Tomb);
# looks and hazards stay, online matches unchanged.
# mirror_match: both teams can pick the same captain in Domination; the away
# team wears an away kit in the menus and on the field (made from the home kit
# for Mario, Luigi, Wario and Waluigi). Online matches unchanged.
# thunder_island_walls: Thunder Island's open sides get the (invisible)
# electric fence of every other stadium: the ball and items bounce off, and
# knocked players are electrocuted instead of falling off. Online unchanged.
# blue_peach: Peach's team wears her unused blue kit on the field (Peach,
# sidekicks, goalie); menus, Mega Strike hand, banners and crowd stay pink.
# robot_goalies: both goalies wear the Super Team's robot goalie skin from
# Super Mario Strikers, which the disc still holds unused. Only the look.
# super_team: the captain and sidekicks of super_team_side (away, home or both)
# become the robots of the Super Team from Super Mario Strikers, fitted to each
# character. Needs [game] gamecube_disc. Bowser, Petey and Boo keep their look.
# fair_ball_contests: when players of both teams reach a loose ball at once,
# neither team wins it more often (the game's player order slightly favours
# the home team, and one-timers, first-time shots off rebounds and pass
# receptions always favour it). On by default; online matches always play
# with it.
skip_intro = false
fast_menus = false
no_mega_strikes = false
unlock_all = false
cpu_vs_cpu = false
fast_terrain = false
mirror_match = false
thunder_island_walls = false
blue_peach = false
robot_goalies = false
super_team = false
super_team_side = away
fair_ball_contests = true

[mods]
# Texture packs made for Dolphin (folders or .zip files with tex1_*.png or
# .dds images) replace the game's textures. They change only how it looks.
texture_packs = true
# The folder holding the packs; a relative path counts from this file.
texture_folder = "texture_packs"
# Pack names (file or folder names), first to last: where two packs replace
# the same texture, the earlier one wins. Packs not listed follow by name.
texture_pack_order =
# Packs that stay unused, separated by |.
texture_packs_off =
# For pack makers: save each texture no pack replaces to data/texture_dumps.
dump_textures = false

[advanced]
# Backend graphics debug layers (slower; turn on for bug reports). WebGPU
# validation and robust buffer access stay enabled in both modes.
# Log detail: error, warning, info or debug.
# Verbose console: also print development traces and the game's own debug
# output (bug reports). Off keeps settings, devices, warnings and errors.
graphics_validation = false
log_level = info
verbose_console = false
# Record frame times to a new CSV and summary in the logs folder each session.
frame_logging = false
# Windows and macOS: show the log in a separate window (Terminal on macOS)
# while the program runs. Closing it does not stop the game.
log_window = false

[launcher]
# Launcher interface size: auto, or a percentage from 75 to 200.
ui_scale = auto
# Look for a newer build on GitHub each time the launcher starts.
check_updates = true
# Open the launcher again when you close a game started from it.
reopen_after_game = false
# Which builds to update to: release (official releases), test (also test
# builds of open pull requests) or auto (releases, or test builds for a test build).
update_channel = auto
# Test channel: the pull request whose test builds to follow (Test on the
# Play page chooses it when several are open); 0 for this test build's own.
test_build = 0

[discord]
# Show the menu or match you are in as your Discord status, while the Discord
# app runs on this computer.
rich_presence = true
# For testing only: the Discord application to show it under instead of this
# build's own (its ID from the Discord Developer Portal; public, not a secret).
# application_id =

[online]
# Network matches with rollback (on by default). A step whose inputs have not
# arrived from the other machine runs with predicted ones and goes back when
# they arrive and differ, instead of waiting for them. Every machine in the
# match needs it on; the input delay adapts to the latency by itself.
# rollback_log names a log file; its counts go to <file>.summary.
# rollback_test = true instead rolls every match back while it is played,
# offline too, and checks that the replays agree (to test the rollback).
# rollback = true
# rollback_test = false
# rollback_log =
