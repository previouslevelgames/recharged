# Copy this file to recharged.ini and set your disc image path.
# Paths are relative to this INI file. Absolute paths also work.
# ISO, RVZ and WBFS are read directly; no extraction or conversion is needed.
[game]
# The image Play starts (the one chosen on the launcher's Game page).
disc = game/R4QE01.rvz

# Game folder: the launcher lists the Mario Strikers Charged images in it;
# clicking one sets disc above. folder_subfolders also lists the images in its
# subfolders.
folder = game
folder_subfolders = true

# Game text: auto, or a language of the disc: english, french or spanish
# (USA); english, german, french, spanish or italian (Europe). Automatic takes
# the computer's language when the disc has it, else English.
language = auto

# Folder for the game's Wii saves. Empty: data/nand next to the program.
# A different folder starts without saves.
save_folder = ""

[display]
width = 1280
height = 720
fullscreen = false
vsync = true
# Frame rate: original (the console's 60 FPS), display (your display's refresh
# rate), unlimited, or a cap from 30 to 1000 FPS. Higher rates draw more frames
# for smoother motion; the game keeps its own speed. VSync holds any rate to
# the display's.
frame_rate = original
# Windows: vulkan or d3d12. macOS: metal. Linux: vulkan.
# auto preserves the platform default (Vulkan on Windows/Linux, Metal on macOS).
backend = auto
# Game layout: auto (by window shape), 4:3 or 16:9.
aspect = 16:9
# Picture: soft (the original TV signal, with its empty border), clean (the
# game's picture drawn straight into the window, without the TV flicker filter
# and the border) or sharp (clean with square pixels).
picture = sharp
# Performance mode (gear menu on the Play button): lighter matches without 4x
# antialiasing, the crowd, background NPCs, ambient stadium effects, bloom,
# heat distortion, depth of field and stadium shadows. The 3D render size,
# gameplay, hazards and weather effects are unchanged.
performance_mode = false
# Antialiasing of the game's 3D edges: off or 4x (more GPU time).
antialiasing = 4x
# 3D render size: window (one pixel per window pixel, default), native (the
# Wii's 640x448) or 2x, 3x, 4x of it. The game's view stays the same.
resolution = window
# Performance overlay: FPS | GPU % | CPU % | LAT N/A, also in fullscreen.
# GPU/CPU are total system usage; unavailable driver counters show N/A.
fps_overlay = false
# Corner of that counter: top-left, top-right, bottom-left or bottom-right.
fps_overlay_corner = top-right
# Display the game window opens on: 0 = default, 1 = first display, 2 = second...
monitor = 0

[audio]
# Host speaker volume (0-100) and mute.
master_volume = 100
# Sound levels (0-100) of each kind of the game's sounds: music, sound
# effects, character voices, the crowd, menu and on-screen display sounds,
# cutscenes (captain introductions, goal celebrations, Mega Strikes) and
# movies. The music, sound effect and voice settings in the game's own Options
# menu still apply on top.
music_volume = 100
effects_volume = 100
voice_volume = 100
crowd_volume = 100
menu_volume = 100
cutscene_volume = 100
movie_volume = 100
mute = false

[controls]
# Who plays: keyboard (keyboard & mouse), remote1-remote4 (the Wii Remote in
# that DolphinBar slot), remote-<Bluetooth address> (a Wii Remote paired over
# Bluetooth, e.g. remote-9ce635c69076; the launcher lists connected ones),
# gamepad1-gamepad4 (the n-th connected Xbox, PlayStation or other standard
# gamepad, played as Wii Remote + Nunchuk) or off. Players fill in order and
# each device plays once. Controllers missing when the game starts are left
# out and the others close up in order.
player1 = keyboard
player2 = off
player3 = off
player4 = off
# When player 1 is a Wii Remote or gamepad and plays alone, the mouse also
# points for it (left click A, right click B); the controller keeps working.
mouse_pointer = true
# Windows: while the launcher's Controls page is open it connects Wii Remotes
# over Bluetooth when you press 1+2 or the SYNC button on them.
bluetooth_search = true
deadzone = 15
rumble = true
# Where the sensor bar or DolphinBar sits: bottom or top of the screen.
sensor_bar = bottom
# Button profile of each gamepad: Default (built in; each controller family
# gets its own layout) or the name of a [gamepad_profileN] below. A missing
# profile plays as Default.
gamepad1_profile = Default
gamepad2_profile = Default
gamepad3_profile = Default
gamepad4_profile = Default

[keyboard]
# Keys of the keyboard & mouse Wii Remote: one or two SDL key names per
# action, separated by |. Change them on the launcher's Controls page.
a = Return | Space
b = Escape | Backspace
one = Z
two = X
plus = Tab
minus = -
home = Home
up = Up
down = Down
left = Left
right = Right
stick_up = W
stick_left = A
stick_down = S
stick_right = D
c = C
z = V
shake_remote = E
shake_nunchuk = Q

# Gamepad profiles ([gamepad_profile1] to [gamepad_profile16]), made on the
# launcher's Controls page: a unique name (not Default) and one or two SDL
# gamepad inputs per action, separated by |: a, b, x, y (bottom, right, left,
# top face button), start, back, guide, leftshoulder, rightshoulder,
# leftstick, rightstick, dpup, dpdown, dpleft, dpright, lefttrigger,
# righttrigger, or none for no button. Actions left out keep the Default
# (Xbox) input. swap_sticks = true
# moves the Nunchuk stick to the right stick and the pointer to the left.
# controller: the controllers the profile is made for, xbox (Xbox and
# PlayStation, whose buttons sit in the same places), nintendo or gamecube;
# the launcher offers a gamepad the profiles of its kind.
# [gamepad_profile1]
# name = Southpaw
# a = a
# b = b
# one = x
# two = y
# plus = start
# minus = back
# home = guide
# up = dpup
# down = dpdown
# left = dpleft
# right = dpright
# c = leftshoulder
# z = lefttrigger
# shake_remote = righttrigger
# shake_nunchuk = rightshoulder
# swap_sticks = true
# controller = xbox

[gameplay]
# Optional tweaks that change the original game. All off plays it unchanged;
# --no-tweaks turns them off for one run.
# skip_intro: start at the main menu (no notices, logo, intro or title screen).
# fast_menus: skip menu transitions, also in the pause menu and on the
# screens after a match (matches, movies and credits unchanged).
# no_mega_strikes: Mega Strikes off for both teams; Skillshots stay (Strikers
# 101 lessons keep their own rules).
# unlock_all: all characters, stadiums and cheats; the save is not changed.
# cpu_vs_cpu: in Domination, Done on Choose Sides also works with no side
# picked; the CPU then plays both teams (from the pause menu too).
# fast_terrain: every stadium plays like Bowser Stadium's fast, dry field
# (speed, ball roll and bounce; no sliding, no slow sand in the Sand Tomb);
# looks and hazards stay, online matches unchanged.
# mirror_match: both teams can pick the same captain in Domination; the away
# team wears an away kit in the menus and on the field (made from the home kit
# for Mario, Luigi, Wario and Waluigi). Online matches unchanged.
# thunder_island_walls: Thunder Island's open sides get the (invisible)
# electric fence of every other stadium: the ball and items bounce off, and
# knocked players are electrocuted instead of falling off. Online unchanged.
# blue_peach: Peach's team wears her unused blue kit on the field (Peach,
# sidekicks, goalie); menus, Mega Strike hand, banners and crowd stay pink.
# no_hud: matches start without the scoreboard, player markers and captions
# (H shows or hides them in a match); the Mega Strike meter and its defence
# stay.
skip_intro = false
fast_menus = false
no_mega_strikes = false
unlock_all = false
cpu_vs_cpu = false
fast_terrain = false
mirror_match = false
thunder_island_walls = false
blue_peach = false
no_hud = false

[advanced]
# Backend graphics debug layers (slower; turn on for bug reports). WebGPU
# validation and robust buffer access stay enabled in both modes.
# Log detail: error, warning, info or debug.
# Verbose console: also print development traces and the game's own debug
# output (bug reports). Off keeps settings, devices, warnings and errors.
graphics_validation = false
log_level = info
verbose_console = false
# Record frame times to a new CSV and summary in the logs folder each session.
frame_logging = false
# Windows and macOS: show the log in a separate window (Terminal on macOS)
# while the program runs. Closing it does not stop the game.
log_window = false

[launcher]
# Launcher interface size: auto, or a percentage from 75 to 200.
ui_scale = auto
# Look for a newer build on GitHub each time the launcher starts.
check_updates = true
# Which builds to update to: release (official releases), test (also test
# builds of open pull requests) or auto (releases, or test builds for a test build).
update_channel = auto
