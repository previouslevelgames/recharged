{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "MSCHARGED_BUILD_LAUNCHER": true,
        "MSCHARGED_BUILD_AURORA_HOST": false,
        "MSCHARGED_BUILD_GAME_STARTUP": false,
        "MSCHARGED_BUILD_GX_CHECK": false,
        "MSCHARGED_BUILD_SCENE_PREVIEW": false,
        "MSCHARGED_BUILD_ORIGINAL_CREDITS_DIAGNOSTIC": false,
        "MSCHARGED_BUILD_ORIGINAL_FRONTEND_DIAGNOSTIC": false,
        "MSCHARGED_BUILD_ORIGINAL_LOADING_DIAGNOSTIC": false
      }
    },
    {
      "name": "optimized",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "frontend-runtime",
      "hidden": true,
      "inherits": "optimized",
      "cacheVariables": {
        "MSCHARGED_BUILD_GX_CHECK": true,
        "MSCHARGED_BUILD_LAUNCHER": true,
        "MSCHARGED_BUILD_ORIGINAL_CREDITS_DIAGNOSTIC": true,
        "MSCHARGED_BUILD_ORIGINAL_FRONTEND_DIAGNOSTIC": true,
        "MSCHARGED_BUILD_ORIGINAL_LOADING_DIAGNOSTIC": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_TITLE": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_CAMERAS": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_FLASH": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_SAVE_OWNERS": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_HBM": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_MATERIALS": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_SH_MENUS": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_NIS_OWNER": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_AUDIO": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_BOOT_SCRIPT": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_BOOT_TO_FE": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_CLEAN_BOOT": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_WORLD": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_WORLD_DRAW": true,
        "MSCHARGED_DIAGNOSTIC_MAIN_NETWORK_OWNER": true,
        "MSCHARGED_DIAGNOSTIC_MAIN_PRESENTATION_OWNER": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_MII_RESOURCES": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_FINALIZE": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_MENU_ENTRY": true,
        "MSCHARGED_DIAGNOSTIC_GAME_AUDIO_OWNER": true,
        "MSCHARGED_DIAGNOSTIC_GAME_AUDIO_INITIALIZE": true,
        "MSCHARGED_DIAGNOSTIC_GAME_AUDIO_TASK": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_FIXED_INPUT": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_PLAT_PAD_TASK": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_MAIN_MENU": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_HALL_OF_FAME": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_DOMINATION": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_CHALLENGES": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_FE_MODELS": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_CREDITS": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_RESET": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_DVD_MESSAGES": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_DVD_ERRORS": true,
        "MSCHARGED_DIAGNOSTIC_FRONTEND_INITIAL_LOADING_MESSAGE": true
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Development build (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "frontend-runtime",
      "displayName": "Original frontend runtime (Release, incomplete game)"
    },
    {
      "name": "launcher",
      "inherits": "optimized",
      "displayName": "Launcher and foundation only (Release)"
    },
    {
      "name": "aurora",
      "inherits": "debug",
      "displayName": "Aurora host integration (Debug, GX pending)",
      "cacheVariables": {
        "MSCHARGED_BUILD_AURORA_HOST": true
      }
    },
    {
      "name": "startup",
      "inherits": "aurora",
      "displayName": "Original game startup prototype (Debug, not playable)",
      "cacheVariables": {
        "MSCHARGED_BUILD_GAME_STARTUP": true
      }
    },
    {
      "name": "graphics",
      "inherits": "optimized",
      "displayName": "Standalone GX/Vulkan diagnostic (Release, no game)",
      "cacheVariables": {
        "MSCHARGED_BUILD_GX_CHECK": true,
        "MSCHARGED_BUILD_LAUNCHER": false
      }
    },
    {
      "name": "frontend",
      "inherits": "frontend-runtime",
      "displayName": "Original frontend sequence (Release, incomplete startup)",
      "binaryDir": "${sourceDir}/build/graphics"
    },
    {
      "name": "scene",
      "inherits": "graphics",
      "displayName": "Experimental static Wii asset preview (Release, not playable)",
      "cacheVariables": {
        "MSCHARGED_BUILD_SCENE_PREVIEW": true,
        "MSCHARGED_BUILD_LAUNCHER": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "frontend",
      "configurePreset": "frontend",
      "targets": [
        "mscharged"
      ]
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "mscharged"
      ]
    },
    {
      "name": "launcher",
      "configurePreset": "launcher"
    },
    {
      "name": "aurora",
      "configurePreset": "aurora"
    },
    {
      "name": "startup",
      "configurePreset": "startup"
    },
    {
      "name": "graphics",
      "configurePreset": "graphics"
    },
    {
      "name": "scene",
      "configurePreset": "scene"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "launcher",
      "configurePreset": "launcher",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "aurora",
      "configurePreset": "aurora",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "startup",
      "configurePreset": "startup",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "graphics",
      "configurePreset": "graphics",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "scene",
      "configurePreset": "scene",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "frontend",
      "steps": [
        {
          "type": "configure",
          "name": "frontend"
        },
        {
          "type": "build",
          "name": "frontend"
        }
      ]
    },
    {
      "name": "debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        }
      ]
    },
    {
      "name": "launcher",
      "steps": [
        {
          "type": "configure",
          "name": "launcher"
        },
        {
          "type": "build",
          "name": "launcher"
        },
        {
          "type": "test",
          "name": "launcher"
        }
      ]
    },
    {
      "name": "aurora",
      "steps": [
        {
          "type": "configure",
          "name": "aurora"
        },
        {
          "type": "build",
          "name": "aurora"
        },
        {
          "type": "test",
          "name": "aurora"
        }
      ]
    },
    {
      "name": "startup",
      "steps": [
        {
          "type": "configure",
          "name": "startup"
        },
        {
          "type": "build",
          "name": "startup"
        },
        {
          "type": "test",
          "name": "startup"
        }
      ]
    },
    {
      "name": "graphics",
      "steps": [
        {
          "type": "configure",
          "name": "graphics"
        },
        {
          "type": "build",
          "name": "graphics"
        },
        {
          "type": "test",
          "name": "graphics"
        }
      ]
    },
    {
      "name": "scene",
      "steps": [
        {
          "type": "configure",
          "name": "scene"
        },
        {
          "type": "build",
          "name": "scene"
