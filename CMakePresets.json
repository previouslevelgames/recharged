{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "MSCHARGED_BUILD_LAUNCHER": true,
        "MSCHARGED_BUILD_AURORA_HOST": false,
        "MSCHARGED_BUILD_GAME_STARTUP": false,
        "MSCHARGED_BUILD_GX_CHECK": false,
        "MSCHARGED_BUILD_SCENE_PREVIEW": false
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Development build (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Development build (Release)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "aurora",
      "inherits": "debug",
      "displayName": "Aurora host integration (Debug, GX pending)",
      "cacheVariables": {
        "MSCHARGED_BUILD_AURORA_HOST": true
      }
    },
    {
      "name": "startup",
      "inherits": "aurora",
      "displayName": "Original game startup prototype (Debug, not playable)",
      "cacheVariables": {
        "MSCHARGED_BUILD_GAME_STARTUP": true
      }
    },
    {
      "name": "graphics",
      "inherits": "release",
      "displayName": "Standalone GX/Vulkan diagnostic (Release, no game)",
      "cacheVariables": {
        "MSCHARGED_BUILD_GX_CHECK": true,
        "MSCHARGED_BUILD_LAUNCHER": false
      }
    },
    {
      "name": "scene",
      "inherits": "graphics",
      "displayName": "Experimental static Wii asset preview (Release, not playable)",
      "cacheVariables": {
        "MSCHARGED_BUILD_SCENE_PREVIEW": true,
        "MSCHARGED_BUILD_LAUNCHER": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "aurora",
      "configurePreset": "aurora"
    },
    {
      "name": "startup",
      "configurePreset": "startup"
    },
    {
      "name": "graphics",
      "configurePreset": "graphics"
    },
    {
      "name": "scene",
      "configurePreset": "scene"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "aurora",
      "configurePreset": "aurora",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "startup",
      "configurePreset": "startup",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "graphics",
      "configurePreset": "graphics",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "scene",
      "configurePreset": "scene",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "aurora",
      "steps": [
        {
          "type": "configure",
          "name": "aurora"
        },
        {
          "type": "build",
          "name": "aurora"
        },
        {
          "type": "test",
          "name": "aurora"
        }
      ]
    },
    {
      "name": "startup",
      "steps": [
        {
          "type": "configure",
          "name": "startup"
        },
        {
          "type": "build",
          "name": "startup"
        },
        {
          "type": "test",
          "name": "startup"
        }
      ]
    },
    {
      "name": "graphics",
      "steps": [
        {
          "type": "configure",
          "name": "graphics"
        },
        {
          "type": "build",
          "name": "graphics"
        },
        {
          "type": "test",
          "name": "graphics"
        }
      ]
    },
    {
      "name": "scene",
      "steps": [
        {
          "type": "configure",
          "name": "scene"
        },
        {
          "type": "build",
          "name": "scene"
        },
        {
          "type": "test",
          "name": "scene"
        }
      ]
    }
  ]
}
