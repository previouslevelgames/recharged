include_guard(GLOBAL)
include(cmake/FrontendCameras.cmake)
include(cmake/FrontendStack.cmake)
include(cmake/Interpreter.cmake)
add_library(charged_frontend_transition STATIC src/runtime/frontend_transition.cpp)
add_dependencies(charged_frontend_transition verify_prepared)
target_link_libraries(charged_frontend_transition PUBLIC charged_frontend_cameras charged_frontend_stack charged_interpreter)
target_compile_features(charged_frontend_transition PUBLIC cxx_std_20)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND NOT MSVC)
    target_compile_options(charged_frontend_transition PRIVATE -ffp-contract=off)
endif()
if(BUILD_TESTING)
    add_executable(frontend_transition_tests tests/frontend_transition.cpp)
    target_link_libraries(frontend_transition_tests PRIVATE charged_frontend_transition aurora::dvd aurora::core)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND NOT MSVC)
        target_compile_options(frontend_transition_tests PRIVATE -ffp-contract=off)
    endif()
    if(NOT MSCHARGED_BUILD_SCENE_PREVIEW)
        add_test(NAME frontend_transition COMMAND "${Python3_EXECUTABLE}" -B
            "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_frontend_transition.py" "$<TARGET_FILE:frontend_transition_tests>")
        set_tests_properties(frontend_transition PROPERTIES TIMEOUT 120
            ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_RENDER_DRIVER=software;SDL_AUDIODRIVER=dummy")
    endif()
endif()
