include(cmake/OriginalFrontendMenuEntryDiagnostic.cmake)
include(cmake/OriginalFrontendFixedInputDiagnostic.cmake)
include(cmake/OriginalFrontendPlatformPadTaskDiagnostic.cmake)
include(cmake/OriginalFrontendMainMenuDiagnostic.cmake)
include(cmake/OriginalFrontendHallOfFameDiagnostic.cmake)
include(cmake/OriginalFrontendDominationDiagnostic.cmake)
include(cmake/NativeAXModuleMemory.cmake)

function(mscharged_add_original_frontend_diagnostic)
    get_target_property(_sources mscharged_original_main_credits_module SOURCES)
    add_library(mscharged_original_frontend_module MODULE ${_sources})
    add_dependencies(mscharged_original_frontend_module verify_prepared)
    foreach(_property IN ITEMS
            COMPILE_FEATURES COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES
            LINK_LIBRARIES LINK_OPTIONS LINK_DEPENDS)
        get_target_property(_value mscharged_original_main_credits_module ${_property})
        if(_value)
            set_property(TARGET mscharged_original_frontend_module PROPERTY ${_property} "${_value}")
        endif()
    endforeach()
    set_target_properties(mscharged_original_frontend_module PROPERTIES
        PREFIX "" POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden
        VISIBILITY_INLINES_HIDDEN ON)
    # Flow omissions are scoped to this diagnostic module only.
    set(MSCHARGED_DIAGNOSTIC_FRONTEND_SEQUENCE ON)
    set(MSCHARGED_DIAGNOSTIC_FRONTEND_TASK_CADENCE ON)
    mscharged_select_original_frontend_sequence(mscharged_original_frontend_module)
    mscharged_select_original_frontend_task_cadence(mscharged_original_frontend_module)
    mscharged_select_original_frontend_title(mscharged_original_frontend_module)
    mscharged_select_original_frontend_cameras(mscharged_original_frontend_module)
    mscharged_select_original_frontend_flash(mscharged_original_frontend_module)
    mscharged_select_original_frontend_save_owners(mscharged_original_frontend_module)
    mscharged_select_original_frontend_hbm(mscharged_original_frontend_module)
    mscharged_select_original_frontend_materials(mscharged_original_frontend_module)
    mscharged_select_original_sh_menus(mscharged_original_frontend_module)
    mscharged_select_original_game_audio_owner(mscharged_original_frontend_module)
    mscharged_add_native_ax_module_memory(mscharged_original_frontend_module)
    mscharged_select_original_game_audio_initialize(mscharged_original_frontend_module)
    mscharged_select_original_game_audio_task(mscharged_original_frontend_module)
    mscharged_select_original_frontend_nis_owner(mscharged_original_frontend_module)
    mscharged_select_original_frontend_audio(mscharged_original_frontend_module)
    mscharged_select_original_frontend_boot_script(mscharged_original_frontend_module)
    mscharged_select_original_frontend_boot_to_fe(mscharged_original_frontend_module)
    mscharged_select_original_frontend_clean_boot(mscharged_original_frontend_module)
    mscharged_select_original_frontend_world(mscharged_original_frontend_module)
    mscharged_select_original_frontend_world_draw(mscharged_original_frontend_module)
    mscharged_add_original_frontend_network_owner_diagnostic(mscharged_original_frontend_module)
    mscharged_add_original_frontend_presentation_owner_diagnostic(mscharged_original_frontend_module)
    mscharged_select_original_frontend_mii_resources(mscharged_original_frontend_module)
    mscharged_select_original_frontend_finalize(mscharged_original_frontend_module)
    mscharged_select_original_frontend_menu_entry(mscharged_original_frontend_module)
    mscharged_add_original_frontend_fixed_input_diagnostic(mscharged_original_frontend_module)
    mscharged_add_original_frontend_platform_pad_task_diagnostic(mscharged_original_frontend_module)
    mscharged_select_original_frontend_main_menu(mscharged_original_frontend_module)
    mscharged_select_original_frontend_hall_of_fame(mscharged_original_frontend_module)
    mscharged_select_original_frontend_domination(mscharged_original_frontend_module)
    add_dependencies(charged_original_main_credits_host mscharged_original_frontend_module)
    target_compile_definitions(charged_original_main_credits_host PRIVATE
        MSCHARGED_ORIGINAL_FRONTEND_MODULE_FILENAME="$<TARGET_FILE_NAME:mscharged_original_frontend_module>")
    if(TARGET mscharged)
        add_dependencies(mscharged mscharged_original_frontend_module)
        target_compile_definitions(mscharged PRIVATE MSCHARGED_HAS_ORIGINAL_FRONTEND=1)
    endif()
endfunction()

mscharged_add_original_frontend_diagnostic()
