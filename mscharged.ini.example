# Copy this file to mscharged.ini and set your disc image path.
# Paths are relative to this INI file. Absolute paths also work.
# ISO and RVZ are read directly; no extraction or conversion is needed.
[game]
disc = game/R4QE01.rvz

# Game text for the supported USA disc: auto, english, french, or spanish.
# Automatic currently uses English. The original game selects localized resources.
language = auto

[display]
width = 1280
height = 720
fullscreen = false
vsync = true
backend = auto
# Game layout: auto (by window shape), 4:3 or 16:9.
aspect = 16:9
# Frames per second in the game window title.
show_fps = true
# Display the game window opens on: 0 = default, 1 = first display, 2 = second...
monitor = 0

[audio]
# Host speaker volume (0-100) and mute. Music, effects and voice levels are in
# the game's own Options menu.
master_volume = 100
music_volume = 100
effects_volume = 100
mute = false

[controls]
# Who plays: auto = Wii Remotes first, then keyboard & mouse; controller = Wii
# Remotes (keyboard & mouse only while none is connected); keyboard = keyboard
# & mouse only.
input = auto
deadzone = 15
rumble = true
# Where the sensor bar or DolphinBar sits: bottom or top of the screen.
sensor_bar = bottom

[advanced]
# Backend graphics debug layers (slower; useful for bug reports). WebGPU
# validation and robust buffer access stay enabled in both modes.
# Log detail: error, warning, info or debug.
graphics_validation = true
log_level = info

[launcher]
# Launcher interface size: auto, or a percentage from 75 to 200.
ui_scale = auto
