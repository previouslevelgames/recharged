# Copy this file to mscharged.ini and set your disc image path.
# Paths are relative to this INI file. Absolute paths also work.
# ISO and RVZ are read directly; no extraction or conversion is needed.
[game]
disc = game/R4QE01.rvz

# Game text for the supported USA disc: auto, english, french, or spanish.
# Automatic currently uses English. The original game selects localized resources.
language = auto

[display]
width = 1280
height = 720
fullscreen = false
vsync = true
backend = auto
aspect = 16:9

[audio]
master_volume = 100
music_volume = 100
effects_volume = 100
mute = false

[controls]
input = auto
deadzone = 15
rumble = true
